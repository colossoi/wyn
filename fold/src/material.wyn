-- Plastic material, studio lighting, tone mapping, and grading, all authored in Wyn.
module Camera = import "camera"
module Settings = import "settings"
open f32
def mix3(a:vec3f32,b:vec3f32,t:f32) vec3f32 = a*(1.0-t)+b*t
def clamp3(v:vec3f32,lo:f32,hi:f32) vec3f32 = @[clamp(v.x,lo,hi),clamp(v.y,lo,hi),clamp(v.z,lo,hi)]
def fract3(v:vec3f32) vec3f32 = @[fract(v.x),fract(v.y),fract(v.z)]
def abs3(v:vec3f32) vec3f32 = @[abs(v.x),abs(v.y),abs(v.z)]
def pigment(birth:f32,tint:f32) vec3f32 =
 let hue = birth*0.065+0.05 in
 let rainbow = clamp3(abs3(fract3(hue+@[0.0,2.0/3.0,1.0/3.0])*6.0-3.0)-1.0,0.0,1.0) in
 let smooth = rainbow*rainbow*(3.0-2.0*rainbow) in
 mix3(@[1.0,1.0,1.0],@[0.025,0.025,0.025]+smooth*(0.7-0.025),tint)
def environment(direction:vec3f32,roughness:f32) vec3f32 =
 let d = normalize(direction) in
 let base = mix3(@[0.38,0.34,0.48],@[0.73,0.81,0.89],smoothstep(-0.6,0.7,d.y)) in
 let spread = 160.0*(1.0-roughness*roughness)+3.0*roughness*roughness in
 base+@[1.0,0.66,0.48]*pow(max(dot(d,normalize(@[-1.0,0.5,0.7])),0.0),spread)*2.4
     +@[0.50,0.82,1.0]*pow(max(dot(d,normalize(@[1.0,0.6,-0.3])),0.0),spread)*2.0
     +@[1.0,0.62,0.80]*pow(max(dot(d,normalize(@[0.1,0.7,1.0])),0.0),spread)*1.8
def fresnel(c:f32,f0:vec3f32) vec3f32 = f0+(1.0-f0)*pow(1.0-clamp(c,0.0,1.0),5.0)
def brdf(n:vec3f32,v:vec3f32,l:vec3f32,color:vec3f32,rough:f32,f0:vec3f32) vec3f32 =
 let h = normalize(v+l) in let nl = max(dot(n,l),0.0) in let nv = max(dot(n,v),0.0001) in
 let nh = max(dot(n,h),0.0) in let vh = max(dot(v,h),0.0) in
 let a = max(rough*rough,0.002) in let a2 = a*a in let denominator = nh*nh*(a2-1.0)+1.0 in
 let distribution = a2/(pi*denominator*denominator) in
 let gv = nl*sqrt(nv*nv*(1.0-a2)+a2) in let gl = nv*sqrt(nl*nl*(1.0-a2)+a2) in
 let visibility = 0.5/max(gv+gl,0.00001) in let f = fresnel(vh,f0) in
 ((1.0-f)*color/pi+f*distribution*visibility)*nl
def lighting(position:vec3f32,normal:vec3f32,color:vec3f32,transmitted:vec3f32,transmission:f32,s:Settings.settings) vec3f32 =
 let n = normalize(normal) in let v = normalize(Camera.eye-position) in let reflection = -v+n*(2.0*dot(v,n)) in
 let f0 = pow((s.ior-1.0)/(s.ior+1.0),2.0) in
 let phase = 4.0*pi*1.3*300.0*sqrt(max(0.0,1.0-(1.0-dot(n,v)*dot(n,v))/(1.3*1.3))) in
 let film = 0.5+0.5*@[cos(phase/650.0),cos(phase/510.0),cos(phase/475.0)] in
 let specular = @[f0,f0,f0]*(0.88+0.12*(0.6+film*0.8)) in
 let f = fresnel(abs(dot(n,v)),specular) in
 let diffuse = color*mix3(@[0.40,0.39,0.36],@[0.65,0.67,0.71],n.y*0.5+0.5)*0.6 in
 let base = diffuse*(1.0-transmission)+transmitted*transmission+environment(reflection,s.roughness)*f*0.9 in
 let opaque = color*(1.0-transmission) in
 let lit = base+brdf(n,v,normalize(@[-3.0,7.0,5.0]-position),opaque,s.roughness,specular)*@[1.0,0.93,0.82]*1.8
   +brdf(n,v,normalize(@[5.0,4.0,-3.0]-position),opaque,s.roughness,specular)*@[0.58,0.76,1.0]*0.8 in
 let coat = fresnel(abs(dot(n,v)),@[0.04,0.04,0.04]) in
 let coated = lit*(1.0-coat*0.15)+environment(reflection,0.075)*coat*0.15 in
 mix3(coated,@[0.815,0.791,0.723],smoothstep(18.0,45.0,magnitude(Camera.view(position))))
def floor_color(position:vec3f32) vec3f32 =
 mix3(@[0.70,0.67,0.61],@[0.815,0.791,0.723],smoothstep(4.0,30.0,magnitude(Camera.view(position))))
def aces(color:vec3f32,exposure:f32) vec3f32 =
 let input:mat3f32 = @[[0.59719,0.076,0.0284],[0.35458,0.90834,0.13383],[0.04823,0.01566,0.83777]] in
 let output:mat3f32 = @[[1.60475,-0.10208,-0.00327],[-0.53108,1.10813,-0.07276],[-0.07367,-0.00605,1.07602]] in
 let v = input*(color*0.9*exp2(exposure)/0.6) in
 let a = v*(v+0.0245786)-0.000090537 in let b = v*(0.983729*v+0.432951)+0.238081 in
 clamp3(output*(a/b),0.0,1.0)
def srgb(x:f32) f32 = if x > 0.0031308 then 1.055*pow(x,1.0/2.4)-0.055 else x*12.92
def grade(color:vec3f32,s:Settings.settings) vec3f32 =
 let mapped = aces(color,s.exposure) in let display = @[srgb(mapped.x),srgb(mapped.y),srgb(mapped.z)] in
 let balanced = display*@[exp2(0.22*s.temperature),1.0,exp2(-0.22*s.temperature)] in
 let l = dot(balanced,@[0.2126,0.7152,0.0722]) in
 clamp3((mix3(@[l,l,l],balanced,s.saturation)-0.5)*s.contrast+0.5,0.0,1.0)
