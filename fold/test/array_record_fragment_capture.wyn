-- Reproducer: a record containing an array and nested scalar settings is used
-- by vertex/fragment callbacks. Passing s.settings to color leaves an unbound
-- TLC symbol during source import (master 3beb084e); compilation should succeed.
type settings = {x:f32}
def color(s:settings) vec4f32 = @[s.x,0.0,0.0,1.0]
entry repro(x:f32,screen:render_target<vec4f32>) render_target<vec4f32> =
 let s = {p=replicate(3,@[x,0.0,0.0,1.0]),settings={x=x}} in
 let triangles = rasterize_triangles(direct_draw(3u32,1u32),|i,_,_| vertex_output(s.p[i32.u32(i)],0.0)) in
 shade(screen,triangles,|_,_,_,_,_| color(s.settings))
