-- Replacement writes must not enable blending on an R32Float target.
entry reproduce(target: render_target<f32>) render_target<f32> =
  let triangles = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32|
      let positions = [@[-1.0, -1.0, 0.0, 1.0],
                       @[ 3.0, -1.0, 0.0, 1.0],
                       @[-1.0,  3.0, 0.0, 1.0]] in
      vertex_output(positions[i32(index)], 0.0)) in
  shade_with({ depth_test = #disabled, depth_write = false,
               blend = #replace, color_write = true },
             target, triangles, |_, _, _, _, _| 0.5)
