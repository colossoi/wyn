-- Storage, computed, and virtual arrays share a length, not a representation.
entry pairs(xs: [4]i32) [4]i32 =
  map(|(x,i)| x+i, zip(map(|x| x+1, xs), 0..<4))

entry triples(xs: [4]i32) [4]i32 =
  map(|(x,y,i)| x+y+i, zip3(xs, map(|x| x+1, xs), 0..<4))

entry quads(xs: [4]i32) [4]i32 =
  map(|(x,y,i,z)| x+y+i+z, zip4(xs, map(|x| x+1, xs), 0..<4, xs))

entry quints(xs: [4]i32) [4]i32 =
  map(|(x,y,i,z,w)| x+y+i+z+w, zip5(xs, map(|x| x+1, xs), 0..<4, xs, xs))
