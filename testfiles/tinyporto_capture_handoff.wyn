-- A serial helper observes the shared tuple after its parallel consumers.
def finish(capture: (i32, [4]i32)) i32 =
  let (state, last) = capture in if state > 0 then state else 0

entry repro(events: []i32) ([]i32, []i32, [1]i32) =
  let capture =
    loop (state, last) = (0, [0, 0, 0, 0]) for k < 32 do
      if events[k] > 0 then
        (state + events[k], last with [k % 4] = events[k])
      else (state, last) in
  (map(|i| capture.1[i % 4], iota(64)),
   map(|i| i + capture.0, iota(128)),
   [finish(capture)])
