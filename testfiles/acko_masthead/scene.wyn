-- Lit ribbons with animated arrowheads and beveled ends, based on Acko.net.
import "geometry"
import "mesh"
open f32

-- Camera basis and distance match the masthead's initial orbit, with a 1.5x
-- distance scale for a standalone viewport. Vertical FOV is 30 degrees.
def camera_right: vec3f32 = @[0.8021, 0.0, 0.5972]
def camera_up: vec3f32 = @[0.1592, 0.9636, -0.2140]
def camera_back: vec3f32 = @[-0.5754, 0.2667, 0.7731]
def focal_length: f32 = 3.7320508

def view_direction(direction: vec3f32) vec3f32 =
  @[dot(camera_right, direction), dot(camera_up, direction), dot(camera_back, direction)]

def view_position(world: vec3f32, height: f32) vec3f32 =
  let distance = (1200.0 + (1.866 * height - 1200.0) * 0.2) * 1.5 in
  let camera = camera_back * distance + @[140.0, 0.0, 0.0] in
  view_direction(world + @[0.0, -10.0, 200.0] - camera)

def project(view: vec3f32, aspect: f32) vec4f32 =
  let near = 2.0 in
  let far = 17000.0 in
  let depth = far * (-view.z - near) / (far - near) in
  @[focal_length * view.x / aspect, focal_length * view.y, depth, -view.z]

type track_varying = {
  normal: vec3f32,
  color: vec3f32,
  ao: f32,
  view_position: vec3f32,
}

def project_track(surface: track_surface, color: vec3f32,
                 resolution: vec3f32) vertex<track_varying> =
  let view = view_position(surface.position, resolution.y) in
  vertex_output(project(view, resolution.x / resolution.y), {
    normal = view_direction(surface.normal),
    color = color,
    ao = surface.ao,
    view_position = view,
  })

def saturate(value: f32) f32 = clamp(value, 0.0, 1.0)

-- The sun vector intentionally keeps its original magnitude. Interpolated
-- normal length drives silhouette shading before normalization for specular.
def sun: vec3f32 = @[0.7034, 0.2912, 0.3380]
def zenith: vec3f32 = @[0.0, 0.9636, 0.2667]

def light_track(value: track_varying) vec4f32 =
  let normal = normalize(value.normal) in
  let sunlight = saturate(dot(normal, sun)) in
  let skylight = saturate(dot(value.normal, zenith)) in
  let diffuse = (sunlight * @[1.5, 1.0, 0.7] + skylight * @[0.1, 0.4, 0.5]) * 0.5
              + @[0.5, 0.5, 0.5] in
  let outline = saturate(3.0 - dot(value.normal, value.normal) * 3.0) in
  let half_vector = normalize(sun - normalize(value.view_position)) in
  let specular = pow(saturate(dot(normal, half_vector)), 4.0) in
  let luminance = dot(diffuse, @[0.299, 0.587, 0.114]) in
  let dark_ao = (value.ao * value.ao + value.ao) * 0.5 in
  let bright_ao = value.ao * luminance in
  let occlusion = value.color * (dark_ao * (1.0 - luminance))
                + @[bright_ao, bright_ao, bright_ao] in
  let lit = occlusion * (diffuse * value.color * (1.0 + outline * 0.35)
                      + specular * vec.sqrt(value.color) * 0.15) in
  let fog = saturate(exp(-(magnitude(value.view_position) - 2200.0) * 0.00022)) in
  let color = vec.sqrt(@[1.0 - fog, 1.0 - fog, 1.0 - fog] + lit * fog) in
  @[color..., 1.0]

def track_fragment_state: fragment_state = {
  depth_test = #less,
  depth_write = true,
  blend = #replace,
  color_write = true,
}

entry acko_masthead(position: []vec4f32,
                    normal: []vec4f32,
                    vertex_color: []vec4f32,
                    vert_s: []f32,
                    track_meta: []vec4f32,
                    track_vertex: []u32,
                    track_ranges: []vec4u32,
                    track_shapes: []vec4f32,
                    indices: []u32,
                    resolution: vec3f32,
                    time: f32,
                    screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    indexed_draw_from(indices, masthead_index_count, 1u32, 0u32, 0i32, 0u32),
    |vertex_index, _instance_index, _draw_index|
      let i = i32(vertex_index) in
      let tag = track_vertex[i] in
      let track = i32(tag % 16u32) in
      let surface = deform_track(i, position, normal, vert_s, track_meta[i], tag,
                                 track_ranges[track], track_shapes[track * 2],
                                 track_shapes[track * 2 + 1], time) in
      project_track(surface, vertex_color[i].xyz, resolution)) in
  shade_with(track_fragment_state, screen, covered,
    |value, _position, _front_facing, _primitive_index, _sample_index| light_track(value))
