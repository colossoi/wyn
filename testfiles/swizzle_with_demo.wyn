-- End-to-end demo of swizzle-with: build a direction vector,
-- apply four chained rotations to mixed (yz, xz) planes, and use
-- the result to color the output. Mirrors the canonical GLSL
-- pattern that motivated the construct:
--
--   vec3 dir = normalize(vec3(uv*.8, 1.));
--   dir.yz *= rot(mouse.y);
--   dir.xz *= rot(mouse.x);
--   dir.yz *= rotview2;
--   dir.xz *= rotview1;

open f32

def rot(a: f32) mat2f32 =
  let c = cos(a)
  let s = sin(a) in
  @[[c, s], [0.0f32 - s, c]]

def verts: [3]vec4f32 =
  [@[-1.0f32, -1.0f32, 0.0f32, 1.0f32],
   @[3.0f32, -1.0f32, 0.0f32, 1.0f32],
   @[-1.0f32, 3.0f32, 0.0f32, 1.0f32]]

def vertex_main(vertex: vertex_invocation) vertex<vec2f32> =
  vertex_output(verts[i32(vertex.vertex_index)], @[0.0, 0.0])

-- Four chained swizzle-with rotations on a `vec3`. Each step
-- updates two slots in place; the third stays unchanged. The
-- AST→TLC lowering rebuilds the vec each time, but with the
-- target bound to a fresh let so it evaluates only once per arm.
def transform(dir0: vec3f32, mx: f32, my: f32, rotview1: mat2f32, rotview2: mat2f32) vec3f32 =
  let d1 = dir0 with .yz *= rot(my)
  let d2 = d1 with .xz *= rot(mx)
  let d3 = d2 with .yz *= rotview2 in
  d3 with .xz *= rotview1

def fragment_main(resolution: vec3f32, time: f32,
                  fragment: fragment_invocation<vec2f32>) vec4f32 =
  let frag_coord = fragment.position
  let coord = @[frag_coord.x, resolution.y - frag_coord.y]
  let uv = @[coord.x / resolution.x - 0.5f32, coord.y / resolution.y - 0.5f32]
  let dir0 = @[uv.x * 0.8f32, uv.y * 0.8f32, 1.0f32]

  let view1 = rot(time * 0.3f32)
  let view2 = rot(time * 0.5f32)
  let mx = time * 0.1f32
  let my = time * 0.07f32

  let d = transform(dir0, mx, my, view1, view2) in
  @[d.x * 0.5f32 + 0.5f32, d.y * 0.5f32 + 0.5f32, d.z * 0.5f32 + 0.5f32, 1.0f32]

entry swizzle_demo(
    resolution: vec3f32,
    time: f32,
    screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered,
    fragment_main(resolution, time, _))
