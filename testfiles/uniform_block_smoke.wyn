-- [SPEC: Resources and Views] Record-typed uniform block.
-- One record parameter groups the values that vary per frame. Its
-- members are laid out together and published to the
-- descriptor as {name, offset, size} so hosts fill them by name.
--
-- A compute pass paints a disc of radius `c.radius` tinted `c.tint`
-- centered at `c.center` (normalized coords); the fragment displays it.
--
-- Run (from the repo root):
--   cargo run --release --bin wyn -- compile testfiles/uniform_block_smoke.wyn -o /tmp/ubs.spv
--   cd extra/viz && cargo run --release -- pipeline /tmp/ubs.spv \
--       --uniform c.radius:f32=0.3 --uniform c.tint:f32x2=0.9,0.2 \
--       --uniform c.center:f32x2=0.5,0.5 \
--       --max-frames 30 --dump-texture img:/tmp/ubs.png

type block = {
  radius: f32,
  tint: vec2f32,
  center: vec2f32,
}

def vertex_main(vertex: vertex_invocation) vertex<vec2f32> =
  let vid = i32(vertex.vertex_index) in
  let verts = [@[-1.0, -1.0, 0.0, 1.0],
               @[3.0, -1.0, 0.0, 1.0],
               @[-1.0, 3.0, 0.0, 1.0]] in
  vertex_output(verts[vid], @[0.0, 0.0])

def fragment_main(c: block, resolution: vec3f32, pos: vec4f32) vec4f32 =
  let uv = @[pos.x / resolution.x, pos.y / resolution.y] in
  let d = magnitude(uv - c.center) in
  if d < c.radius
  then @[c.tint.x, c.tint.y, 0.25f32, 1.0f32]
  else @[0.08f32, 0.08f32, 0.10f32, 1.0f32]

entry uniform_block_smoke(
    c: block,
    resolution: vec3f32,
    screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered,
    |fragment| fragment_main(c, resolution, fragment.position))
