-- Match on a bool with literal arms. Both true and false present
-- makes coverage exhaustive without a wildcard.

def verts: [3]vec4f32 =
  [@[-1.0f32, -1.0f32, 0.0f32, 1.0f32],
   @[3.0f32, -1.0f32, 0.0f32, 1.0f32],
   @[-1.0f32, 3.0f32, 0.0f32, 1.0f32]]

def vertex_main(vertex: vertex_invocation) vertex<vec2f32> =
  vertex_output(verts[i32(vertex.vertex_index)], @[0.0, 0.0])

def to_f(b: bool) f32 =
  match b
  case true  -> 1.0f32
  case false -> 0.0f32

def fragment_main(_position: vec4f32) vec4f32 =
  @[to_f(true), to_f(false), 0.5f32, 1.0f32]

entry match_literal_bool(screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered, |fragment| fragment_main(fragment.position))
