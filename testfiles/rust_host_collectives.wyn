entry total(xs: []i32) i32 = reduce(|a:i32,b:i32|a+b, 0, xs)
entry prefixes(xs: []i32) []i32 = scan(|a:i32,b:i32|a+b, 0, xs)
entry survivors(xs: []i32) (i32, i32) =
  let ys = filter(|x:i32|x>0, xs) in
  (length(ys), reduce(|a:i32,b:i32|a+b, 0, ys))
entry scoped(xs: []i32) []i32 =
  map(|x:i32| loop a=0 for i<7 do
    a+(if x==0 then i else 120/x+i), xs)
entry nested(xs: []i32) []i32 =
  map(|x:i32| loop a=0 for i<4 do
    a+(loop b=0 for j<3 do b+x*i+j), xs)

-- Invocation-local fusion must apply the predicate without reading the
-- filtered array back from the collective that is currently being emitted.
entry local_filtered(input: []i32) [4]i32 =
  let xs=input[0..4] in
  map(|p| let ys=filter(|x|x<p,xs) in
    10*reduce(|a,b|a+b,0,ys)+length(ys), xs)

-- Two retained arrays follow two totals in the fused result list, but occupy
-- array output buffers zero and one.
entry local_mixed(input: []i32) [4]i32 =
  let xs=input[0..4] in
  map(|p| let ys=map(|x|x+p,xs)
    let zs=map(|x|x-p,xs) in
    reduce(|a,b|a+b,0,ys)+2*reduce(|a,b|a+b,0,zs)+ys[0]+2*zs[3], xs)
