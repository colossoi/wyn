-- Minimal render-target smoke test using a vertex callback and a fragment
-- callback joined by one raster value.
def vertex_main(vertex_index: u32, instance_index: u32, draw_index: u32) vertex<vec2f32> =
  let vid = i32(vertex_index) in
  let verts = [@[-1.0, -1.0, 0.0, 1.0],
               @[3.0, -1.0, 0.0, 1.0],
               @[-1.0, 3.0, 0.0, 1.0]] in
  vertex_output(verts[vid], @[0.0, 0.0])

def fragment_main(pos: vec4f32) vec4f32 =
  @[pos.x / 1024.0, pos.y / 1024.0, 0.0, 1.0]

entry storage_image_roundtrip(
    screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered,
    |fragment_value, fragment_position, fragment_front_facing, fragment_primitive_index, fragment_sample_index| fragment_main(fragment_position))
