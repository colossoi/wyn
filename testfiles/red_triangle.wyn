-- Simple red triangle test

def vertex_main(vertex: vertex_invocation) vertex<vec3f32> =
  let vertex_index = vertex.vertex_index
  let position: vec4f32 =
    if vertex_index == 0u32 then @[-0.5, -0.5, 0.0, 1.0]
    else if vertex_index == 1u32 then @[0.5, -0.5, 0.0, 1.0]
    else @[0.0, 0.5, 0.0, 1.0]
  let color: vec3f32 = @[1.0, 0.0, 0.0] in
  vertex_output(position, color)

def fragment_main(fragment: fragment_invocation<vec3f32>) vec4f32 =
  let color = fragment.value in
  @[color.x, color.y, color.z, 1.0]

entry red_triangle(
    screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered, fragment_main)
