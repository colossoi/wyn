-- A minimal boids-style particle simulator expressed as one root operation.
--
-- sim returns the next particle array. The fragment callback captures that
-- value directly and tests whether the current pixel contains a particle.
-- The root returns the array for optional use as the next frame's input.
--
-- Exercises filter piped into a size-polymorphic helper and same-frame
-- array flow from ordinary computation into fragment processing.
---- The initial particle state is generated in Wyn. Each particle index seeds
-- an independent random-access stream from `wyn/rng`; frame zero maps those
-- draws into a starting position + velocity. Later frames consume the
-- previous position buffer supplied by viz's feedback pair.
--
-- Run (the explicit config path is needed because this example writes the
-- compiled shader to a different directory than its sidecar):
--
--   wyn build testfiles\playground\particles.wyn ^
--     -o C:\Users\<you>\AppData\Local\Temp\p.spv
--   extra\viz\target\release\viz.exe pipeline ^
--     C:\Users\<you>\AppData\Local\Temp\p.spv ^
--     --config testfiles\playground\particles.viz.json ^
--     --size 512x512

import "pkg:rng"

def N:i32 = 512
def CLUMPF:f32 = 0.1
def CLUMPR:f32 = 100.0
def UPDFACTOR:f32 = 1.0
def ALIGNF:f32 = 0.3
def ALIGNR:f32 = 50.0
def RES:i32 = 512

-- Draw reproducible values in `[0, 1)` and map four of them into a starting
-- particle: position spans the full `[0, RES)²` framebuffer and velocity spans
-- `[-1, 1)²`.
def rand01(key: u32, pos: u32) f32 =
  f32(fasthash.at_u32(key, pos) >> 8u32) * (1.0 / 16777216.0)

def spawn(r: vec4f32) vec4f32 =
  @[f32(RES) * r.x, f32(RES) * r.y, 2.0 * r.z - 1.0, 2.0 * r.w - 1.0]

def initial_particle(i: i32) vec4f32 =
  let key = fasthash.seed(u32(i) * 2654435761u32 + 11u32) in
  spawn(@[rand01(key, 0u32), rand01(key, 1u32),
          rand01(key, 2u32), rand01(key, 3u32)])

def sum<[n]>(arr:[n]vec4f32) vec2f32 = reduce(|a,b| a+b, @[0.0,0.0,0.0,0.0], arr).xy
def center(arr:[]vec4f32) vec2f32 = sum(arr)/f32(length(arr))
def clump(pos:vec4f32, arr:[]vec4f32) vec2f32 =
  let filt = filter(|x| magnitude(pos.xy-x.xy)<CLUMPR, arr) in
  let dist = (center(filt) - pos.xy) in
    CLUMPF * dist
def align(pos:vec4f32, arr:[]vec4f32) vec2f32 = ALIGNF*((reduce(|a,b| a+b, @[0.0,0.0], map(|elem| elem.zw, arr)) / f32(N)) - pos.zw)

def SEPR:f32 = 20.0
def SEPF:f32 = 5.0
def separation(pos:vec4f32, arr:[]vec4f32) vec2f32 =
  let diffs = map(|x| pos.xy - x.xy, arr)
  let local_diffs = filter(|d| magnitude(d)<SEPR, diffs)
  let contribs = map(|d| let mag = magnitude(d) in if mag < 0.001 then @[0.0,0.0] else d/(mag**2.0), local_diffs)
  let reduced = reduce(|a,b| a+b, @[0.0,0.0], contribs) * SEPF in
  reduced

-- Toroidal wrap of one axis of the particle position: integrate
-- `vel` into `coord` and fold the result into `[0, RES)`.
def wrap(coord: f32, vel: f32) f32 = (coord + UPDFACTOR * vel + f32(RES)) % f32(RES)

-- Flatten `(p.x, p.y)` (a particle position or a fragment coordinate,
-- both `vec4f32`) into a row-major framebuffer index.
def pixel_index(p: vec4f32) i32 = i32(p.y) * RES + i32(p.x)

def sim(prev_pos: []vec4f32, frame: u32) []vec4f32 =
  let new_pos =
    if frame < 2u32 then
      map(initial_particle, 0i32..<N)
    else
      let previous_positions = prev_pos[0..N] in
      let accelerated =
        map(|elem:vec4f32|
              let deltav = clump(elem, previous_positions) + align(elem, previous_positions) + separation(elem, previous_positions) in
              @[elem.x, elem.y, elem.z + deltav.x, elem.w + deltav.y],
            previous_positions)
      in
      map(|upd:vec4f32| @[wrap(upd.x, upd.z), wrap(upd.y, upd.w), upd.z, upd.w],
          accelerated) in
  new_pos

def vertex_main(vertex: vertex_invocation) vertex<vec2f32> =
  let vid = i32(vertex.vertex_index) in
  let x = if vid == 0 then -1.0 else if vid == 1 then 3.0 else -1.0 in
  let y = if vid == 0 then -1.0 else if vid == 1 then -1.0 else 3.0 in
  vertex_output(@[x, y, 0.0, 1.0], @[0.0, 0.0])

def main_image(positions: []vec4f32, frag_coord: vec4f32) vec4f32 =
  let target = pixel_index(frag_coord) in
  let hits = map(
    |p: vec4f32| if pixel_index(p) == target then 1.0 else 0.0,
    positions[0..N]) in
  let lit = reduce(|a: f32, b: f32| max(a, b), 0.0, hits) in
  @[lit, lit, lit, 1.0]

entry particles(
    prev_pos: []vec4f32,
    frame: u32,
    screen: render_target<vec4f32>)
    ([]vec4f32, render_target<vec4f32>) =
  let next = sim(prev_pos, frame) in
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  let screen' = shade(
    screen,
    covered,
    |fragment| main_image(next, fragment.position)) in
  (next, screen')
