-- A complete graphics operation expressed as one source entry.

def triangle_position(vertex_index: u32) vec4f32 =
  if vertex_index == 0u32 then @[-0.5, -0.5, 0.0, 1.0]
  else if vertex_index == 1u32 then @[0.5, -0.5, 0.0, 1.0]
  else @[0.0, 0.5, 0.0, 1.0]

entry triangle(screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    |vertex_index, instance_index, draw_index| vertex_output(
      triangle_position(vertex_index),
      @[1.0, 0.0, 0.0])) in
  shade(screen, covered,
    |fragment_value, fragment_position, fragment_front_facing, fragment_primitive_index, fragment_sample_index|
      @[fragment_value..., 1.0])
