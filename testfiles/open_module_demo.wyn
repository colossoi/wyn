-- Demonstrates `open M` name resolution: bare `cos`, `sin`, `tanh`,
-- `radians` resolve to their `f32.*` counterparts because `open f32`
-- is in scope. `min` and `max` stay polymorphic via INTRINSIC_RENAMES,
-- so they keep working with both scalar and vector args.

open f32

def vertex_main(vertex: vertex_invocation) vertex<vec2f32> =
  let vid = vertex.vertex_index in
  let position = if vid == 0u32 then @[-1.0, -1.0, 0.0, 1.0]
    else if vid == 1u32 then @[3.0, -1.0, 0.0, 1.0]
    else @[-1.0, 3.0, 0.0, 1.0] in
  vertex_output(position, @[0.0, 0.0])

def fragment_main(_position: vec4f32) vec4f32 =
  let a = radians(45.0)
  let r = cos(a)
  let g = sin(a)
  let b = tanh(a)
  let lo = min(r, g)
  let hi = max(r, g) in
  @[lo, hi, b, 1.0]

entry open_module_demo(screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered, |fragment| fragment_main(fragment.position))
