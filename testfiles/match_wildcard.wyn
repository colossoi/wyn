-- Match arm with wildcard catch-all. Exercises non-exhaustive sum
-- arms followed by `_` to cover the remaining variants.

def verts: [3]vec4f32 =
  [@[-1.0f32, -1.0f32, 0.0f32, 1.0f32],
   @[3.0f32, -1.0f32, 0.0f32, 1.0f32],
   @[-1.0f32, 3.0f32, 0.0f32, 1.0f32]]

def vertex_main(vertex_index: u32, instance_index: u32, draw_index: u32) vertex<vec2f32> =
  vertex_output(verts[i32(vertex_index)], @[0.0, 0.0])

def channel(c: #red | #green | #blue) f32 =
  match c
  case #red -> 1.0f32
  case _    -> 0.0f32

def fragment_main(_position: vec4f32) vec4f32 =
  @[channel(#red), channel(#green), channel(#blue), 1.0f32]

entry match_wildcard(screen: render_target<vec4f32>) render_target<vec4f32> =
  let covered = rasterize_triangles(
    direct_draw(3u32, 1u32),
    vertex_main) in
  shade(screen, covered, |fragment_value, fragment_position, fragment_front_facing, fragment_primitive_index, fragment_sample_index| fragment_main(fragment_position))
