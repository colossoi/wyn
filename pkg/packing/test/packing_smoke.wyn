import "../src/lib"

entry packing_smoke() [6]f32 =
  let (n, pad) = packing.fit(2.0f32, 11.0f32, 1.0f32, 0.5f32) in
  let (m, lo, hi) = packing.fit_ends(2.0f32, 12.0f32, 1.0f32,
                                      0.5f32, 1.5f32) in
  [f32.i32(n), pad, packing.run_length(n, 2.0f32, 1.0f32),
   f32.i32(m), lo, hi]
