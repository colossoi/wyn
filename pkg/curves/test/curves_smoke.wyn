import "../src/lib"

entry curves_smoke() [8]f32 =
  let p0: vec2f32 = @[0.0f32, 0.0f32] in
  let p1: vec2f32 = @[1.0f32, 0.0f32] in
  let p2: vec2f32 = @[2.0f32, 1.0f32] in
  let p3: vec2f32 = @[3.0f32, 1.0f32] in
  let point = curves.catmull_rom(p0, p1, p2, p3, 0.5f32) in
  let tangent = curves.catmull_rom_tangent(p0, p1, p2, p3, 0.5f32) in
  let (ribbon, side) = curves.ribbon_vertex(
    p0, p1, p2, p3, 0.0f32, 0.5f32, 0.2f32, 0i32) in
  let (emit, _, _, _, _, _) = curves.reumann_witkam_advance(
    p0, @[1.0f32, 0.0f32], p1, true, p2, 0.1f32, 1.0f32) in
  [point.x, point.y, tangent.x, tangent.y,
   ribbon.x, ribbon.y, side, if emit then 1.0f32 else 0.0f32]
