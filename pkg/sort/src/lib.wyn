-- Stable LSD radix pass over two bits. Scan four bucket counts together;
-- each key/index pair scatters once to its bucket's offset plus local rank.
def radix_digit<[n]>(pairs: [n]vec2u32, bit: u32) [n]vec2u32 =
  let flags = map(|p|
    let digit = (p.x >> bit) & 3u32 in
    @[if digit == 0u32 then 1i32 else 0i32,
      if digit == 1u32 then 1i32 else 0i32,
      if digit == 2u32 then 1i32 else 0i32,
      if digit == 3u32 then 1i32 else 0i32],pairs) in
  let prefix = scan(|a,b| a+b,@[0i32,0i32,0i32,0i32],flags) in
  let total = prefix[length(pairs)-1] in
  let destinations = map(|(p,rank)|
    let digit = (p.x >> bit) & 3u32 in
    if digit == 0u32 then rank.x-1
    else if digit == 1u32 then total.x+rank.y-1
    else if digit == 2u32 then total.x+total.y+rank.z-1
    else total.x+total.y+total.z+rank.w-1,zip(pairs,prefix)) in
  scatter(replicate(length(pairs),@[0u32,0u32]),destinations,pairs)

-- Fifteen stable four-bucket passes cover 30-bit unsigned keys in pairs.x.
-- pairs.y is carried unchanged; equal keys retain their input order.
-- Requires nonempty pairs. ids is retained for compatibility with callers.
-- Explicit passes keep scans parallel until host dispatch loops are supported.
def radix_sort<[n]>(pairs: [n]vec2u32, _ids: [n]i32) [n]vec2u32 =
  let p1 = radix_digit(pairs,0u32) in
  let p2 = radix_digit(p1,2u32) in
  let p3 = radix_digit(p2,4u32) in
  let p4 = radix_digit(p3,6u32) in
  let p5 = radix_digit(p4,8u32) in
  let p6 = radix_digit(p5,10u32) in
  let p7 = radix_digit(p6,12u32) in
  let p8 = radix_digit(p7,14u32) in
  let p9 = radix_digit(p8,16u32) in
  let p10 = radix_digit(p9,18u32) in
  let p11 = radix_digit(p10,20u32) in
  let p12 = radix_digit(p11,22u32) in
  let p13 = radix_digit(p12,24u32) in
  let p14 = radix_digit(p13,26u32) in
  radix_digit(p14,28u32)
