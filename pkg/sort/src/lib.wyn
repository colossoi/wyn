-- Stable LSD radix pass: scan zeros, then scatter each key/index exactly once.
def radix_bit<[n]>(pairs: [n]vec2u32, ids: [n]i32, bit: u32) [n]vec2u32 =
  let zero = map(|p| if ((p.x >> bit) & 1u32) == 0u32 then 1i32 else 0i32,pairs) in
  let prefix = scan(|a,b| a+b,0i32,zero) in
  let total = prefix[length(pairs)-1] in
  let destinations = map(|i| if zero[i] == 1 then prefix[i]-1 else total+i-prefix[i],ids) in
  scatter(replicate(length(pairs),@[0u32,0u32]),destinations,pairs)

-- Thirty stable binary passes cover 30-bit unsigned keys in pairs.x.
-- pairs.y is carried unchanged; equal keys retain their input order.
-- Requires nonempty pairs and ids = 0i32..<length(pairs).
def radix_sort<[n]>(pairs: [n]vec2u32, ids: [n]i32) [n]vec2u32 =
  let p1 = radix_bit(pairs,ids,0u32) in
  let p2 = radix_bit(p1,ids,1u32) in
  let p3 = radix_bit(p2,ids,2u32) in
  let p4 = radix_bit(p3,ids,3u32) in
  let p5 = radix_bit(p4,ids,4u32) in
  let p6 = radix_bit(p5,ids,5u32) in
  let p7 = radix_bit(p6,ids,6u32) in
  let p8 = radix_bit(p7,ids,7u32) in
  let p9 = radix_bit(p8,ids,8u32) in
  let p10 = radix_bit(p9,ids,9u32) in
  let p11 = radix_bit(p10,ids,10u32) in
  let p12 = radix_bit(p11,ids,11u32) in
  let p13 = radix_bit(p12,ids,12u32) in
  let p14 = radix_bit(p13,ids,13u32) in
  let p15 = radix_bit(p14,ids,14u32) in
  let p16 = radix_bit(p15,ids,15u32) in
  let p17 = radix_bit(p16,ids,16u32) in
  let p18 = radix_bit(p17,ids,17u32) in
  let p19 = radix_bit(p18,ids,18u32) in
  let p20 = radix_bit(p19,ids,19u32) in
  let p21 = radix_bit(p20,ids,20u32) in
  let p22 = radix_bit(p21,ids,21u32) in
  let p23 = radix_bit(p22,ids,22u32) in
  let p24 = radix_bit(p23,ids,23u32) in
  let p25 = radix_bit(p24,ids,24u32) in
  let p26 = radix_bit(p25,ids,25u32) in
  let p27 = radix_bit(p26,ids,26u32) in
  let p28 = radix_bit(p27,ids,27u32) in
  let p29 = radix_bit(p28,ids,28u32) in
  let p30 = radix_bit(p29,ids,29u32) in
  p30
