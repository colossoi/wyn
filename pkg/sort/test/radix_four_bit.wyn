-- Regression: stable full-width key/value sorting through eight four-bit passes.
-- Expected keys 0,1,1,0xffffffff and payloads 3,1,2,0. Former failures:
-- missing loop-counter type on module import; inferred scan-row layout missing.
module Sort = import "../src/four_bit"
entry main() [4]vec2u32 =
  Sort.radix_sort(32,|i,p| u32.get_bit(i,p.x),[@[4294967295u32,0u32],@[1u32,1u32],@[1u32,2u32],@[0u32,3u32]])
