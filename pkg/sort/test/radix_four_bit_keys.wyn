-- Expected payloads 20,40,10,30 for signed keys; negative equal-key float
-- encodings remain stable, followed by zero and positive one.
module R = import "../src/four_bit"
entry main() ([4]i32,[4]u32) =
  let records = [(2,10),(-1,20),(2,30),(0,40)] in
  let signed = R.radix_sort_int_by_key(|(key,_)| key,32,i32.get_bit,records) in
  let floats = R.radix_sort_float_by_key(|x| f32.from_bits(x & 0xffffff00u32),
    32,f32.get_bit,[0xbf800001u32,0x3f800002u32,0xbf800003u32,4u32]) in
  (map(|(_,value)| value,signed),floats)
