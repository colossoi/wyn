-- Regression: zero-length and singleton inputs must survive all eight passes.
-- Expected (0, [@[0xffffffff,42]]); watch for zero-sized allocations or dispatches.
module Sort = import "../src/four_bit"
entry main() (i32,[1]vec2u32) =
  let empty = Sort.radix_sort(32,|i,p| u32.get_bit(i,p.x),map(|i| @[u32(i),u32(i)],iota(0))) in
  let one = Sort.radix_sort(32,|i,p| u32.get_bit(i,p.x),[@[4294967295u32,42u32]]) in
  (length(empty),one)
