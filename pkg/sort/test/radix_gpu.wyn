module R = import "../src/radix_sort"

entry unsigned(xs: []i32) []i32 = R.radix_sort(32, i32.get_bit, xs)
entry signed(xs: []i32) []i32 = R.radix_sort_int(32, i32.get_bit, xs)
entry floats(xs: []f32) []f32 = R.radix_sort_float(32, f32.get_bit, xs)

-- The low bits distinguish payloads whose high-bit keys are equal.
entry unsigned_key(xs: []i32) []i32 =
  R.radix_sort_by_key(|x| x >> 8, 32, i32.get_bit, xs)
entry signed_key(xs: []i32) []i32 =
  R.radix_sort_int_by_key(|x| x >> 8, 32, i32.get_bit, xs)
entry float_key(xs: []u32) []u32 =
  R.radix_sort_float_by_key(|x| f32.from_bits(x & 0xffffff00u32), 32, f32.get_bit, xs)

entry odd_bits(xs: []i32) []i32 = R.radix_sort(5, i32.get_bit, xs)
entry zero_bits(xs: []i32) []i32 = R.radix_sort(0, i32.get_bit, xs)
entry fixed(xs: [8]i32) [8]i32 = R.radix_sort_int(32, i32.get_bit, xs)
