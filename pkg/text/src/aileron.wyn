    { advance = 0.981f32, plane = @[-0.056166667f32, -0.635416667f32, 1.027166667f32, 0.114583333f32], uv = @[0.06879845f32, 0.822674419f32, 0.169573643f32, 0.89244186f32] },
    { advance = 0.585f32, plane = @[-0.04175f32, -0.927083333f32, 0.64575f32, 0.114583333f32], uv = @[0.704457364f32, 0.000968992f32, 0.768410853f32, 0.097868217f32] },
