    { advance = 0.247f32, plane = @[-0.069583333f32, -0.822916667f32, 0.284583333f32, -0.385416667f32], uv = @[0.276162791f32, 0.958333333f32, 0.309108527f32, 0.999031008f32] },
    { advance = 0.417f32, plane = @[-0.035916667f32, -0.822916667f32, 0.484916667f32, -0.385416667f32], uv = @[0.134689922f32, 0.958333333f32, 0.183139535f32, 0.999031008f32] },
