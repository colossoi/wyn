    { advance = 0.581f32, plane = @[-0.069f32, -0.927083333f32, 0.681f32, 0.09375f32], uv = @[0.502906977f32, 0.113372093f32, 0.572674419f32, 0.208333333f32] },
    { advance = 0.5f32, plane = @[-0.020833333f32, -0.40625f32, 0.520833333f32, -0.177083333f32], uv = @[0.506782946f32, 0.894379845f32, 0.557170543f32, 0.915697674f32] },
