-- | Distance-field text primitives. Texture ownership, shaping and draw state
-- belong to the caller. Font-specific metrics are an optional separate import.
module text = {
  -- | All coordinates are top-down. Plane bounds are em offsets from the
  -- baseline; UV bounds are normalized atlas coordinates. Bounds = L,T,R,B.
  type glyph = { advance: f32, plane: vec4f32, uv: vec4f32 }

  def empty_glyph(advance: f32) glyph = {
    advance = advance,
    plane = @[0.0f32, 0.0f32, 0.0f32, 0.0f32],
    uv = @[0.0f32, 0.0f32, 0.0f32, 0.0f32],
  }

  module sdf = {
    -- | A single normalized channel, e.g. R of an SDF or A of an MTSDF.
    def distance(channel: f32) f32 = channel - 0.5f32
  }

  module msdf = {
    -- | Median reconstruction; zero at the glyph edge, positive inside.
    def distance(rgb: vec3f32) f32 =
      f32.max(f32.min(rgb.x, rgb.y), f32.min(f32.max(rgb.x, rgb.y), rgb.z)) - 0.5f32
  }

  -- | Unit distance range = full encoded distance range / atlas dimensions.
  def unit_range(px_range: f32, atlas_size: vec2f32) vec2f32 =
    @[px_range / atlas_size.x, px_range / atlas_size.y]

  -- | LOD-0 bilinear sampling with clamp-to-edge, independent of host sampler
  -- defaults. Dimensions must match the texture. Prefer texture_sample with
  -- a linear sampler when the host can provide one (one fetch versus four).
  -- Interpolate all channels BEFORE MSDF median reconstruction.
  def sample_bilinear(atlas: texture2d, dimensions: vec2i32, uv: vec2f32) vec4f32 =
    let p = uv * @[f32(dimensions.x), f32(dimensions.y)] - 0.5f32 in
    let x = i32(f32.floor(p.x)) in
    let y = i32(f32.floor(p.y)) in
    let x0 = i32.min(i32.max(x, 0), dimensions.x - 1) in
    let x1 = i32.min(i32.max(x + 1, 0), dimensions.x - 1) in
    let y0 = i32.min(i32.max(y, 0), dimensions.y - 1) in
    let y1 = i32.min(i32.max(y + 1, 0), dimensions.y - 1) in
    let a = texture_load(atlas, @[x0, y0], 0) in
    let b = texture_load(atlas, @[x1, y0], 0) in
    let c = texture_load(atlas, @[x0, y1], 0) in
    let d = texture_load(atlas, @[x1, y1], 0) in
    mix(mix(a, b, f32.fract(p.x)), mix(c, d, f32.fract(p.x)), f32.fract(p.y))

  -- | For axis-aligned, uniformly scaled text. Both sizes are pixels per em.
  def screen_range_2d(px_range: f32, font_size: f32, atlas_em_size: f32) f32 =
    f32.max(px_range * font_size / atlas_em_size, 1.0f32)

  -- | Pure derivative form; usable with analytic gradients in any stage.
  -- All atlas sizes/ranges must be positive and inputs finite.
  def screen_range(unit: vec2f32, uv_dx: vec2f32, uv_dy: vec2f32) f32 =
    let footprint = @[f32.max(magnitude(@[uv_dx.x, uv_dy.x]), 1e-12f32),
                      f32.max(magnitude(@[uv_dx.y, uv_dy.y]), 1e-12f32)] in
    f32.max(0.5f32 * (unit.x / footprint.x + unit.y / footprint.y), 1.0f32)

  -- | Fragment-only; evaluate in uniform control flow before per-pixel branches.
  def screen_range_fragment(unit: vec2f32, uv: vec2f32) f32 =
    screen_range(unit, @[f32.d_fdx(uv.x), f32.d_fdx(uv.y)],
                      @[f32.d_fdy(uv.x), f32.d_fdy(uv.y)])

  -- | Linear one-screen-pixel antialiasing ramp. Distance is in screen pixels.
  def coverage(distance_px: f32) f32 =
    f32.min(f32.max(distance_px + 0.5f32, 0.0f32), 1.0f32)

  -- | Positive weight expands the glyph; weight is in screen pixels.
  def fill(distance: f32, screen_px_range: f32, weight_px: f32) f32 =
    coverage(distance * screen_px_range + weight_px)

  -- | Exterior-only outline. Width must be nonnegative. Use MSDF for mitered
  -- corners, true SDF for rounded distance effects. Stay within atlas padding.
  def outline(distance: f32, screen_px_range: f32, width_px: f32) f32 =
    let d = distance * screen_px_range in
    coverage(d + width_px) - coverage(d)

  -- | Straight-alpha output for Wyn's #source_over / WGPU ALPHA_BLENDING.
  def straight(color: vec4f32, opacity: f32) vec4f32 =
    @[color.x, color.y, color.z, color.w * opacity]

  -- | Straight input color -> premultiplied output, with coverage applied once.
  def premultiply(color: vec4f32, opacity: f32) vec4f32 =
    let a = color.w * opacity in
    @[color.x * a, color.y * a, color.z * a, a]

  -- | Premultiplied source-over composition (both operands premultiplied).
  def over(foreground: vec4f32, background: vec4f32) vec4f32 =
    foreground + background * (1.0f32 - foreground.w)

  -- | Six vertices per glyph, in triangle-list order. vertex_index in [0,6).
  -- Returned position is in top-down pixels and UV matches unflipped PNG rows.
  def quad_vertex(g: glyph, baseline: vec2f32, font_size: f32,
                  vertex_index: u32) (vec2f32, vec2f32) =
    let right = vertex_index == 1u32 || vertex_index == 4u32 || vertex_index == 5u32 in
    let bottom = vertex_index == 2u32 || vertex_index == 3u32 || vertex_index == 5u32 in
    let plane = @[if right then g.plane.z else g.plane.x,
                  if bottom then g.plane.w else g.plane.y] in
    let uv = @[if right then g.uv.z else g.uv.x,
               if bottom then g.uv.w else g.uv.y] in
    (baseline + plane * font_size, uv)

  -- | WebGPU/Vulkan NDC, top-left pixel origin. Depth must be in [0,1].
  def pixel_to_clip(position: vec2f32, viewport: vec2f32, depth: f32) vec4f32 =
    @[2.0f32 * position.x / viewport.x - 1.0f32,
      1.0f32 - 2.0f32 * position.y / viewport.y, depth, 1.0f32]

  -- | One layout step per glyph. Advances and line height are in em units.
  -- A line break resets X to zero and advances Y, ignoring that step's advance.
  type layout_step = { advance: f32, line_break: bool }
  type pen_transform = { x: f32, y: f32, reset: bool }

  -- | Associative composition for the segmented prefix scan.
  def compose_pen(a: pen_transform, b: pen_transform) pen_transform = {
    x = if b.reset then b.x else a.x + b.x,
    y = a.y + b.y,
    reset = a.reset || b.reset,
  }

  -- | Exclusive baseline positions, one per step, starting at (0,0).
  -- Callers may include kerning or shaped advances in layout_step.advance.
  def layout<[n]>(steps: [n]layout_step, font_size: f32,
                  line_height: f32) [n]vec2f32 =
    let transforms = map(|s: layout_step| {
      x = if s.line_break then 0.0f32 else s.advance * font_size,
      y = if s.line_break then line_height * font_size else 0.0f32,
      reset = s.line_break,
    }, steps) in
    let pens = scan(compose_pen, {x = 0.0f32, y = 0.0f32, reset = false}, transforms) in
    map(|i: i32| if i == 0 then @[0.0f32, 0.0f32]
                 else @[pens[i - 1].x, pens[i - 1].y], iota(length(steps)))
}
