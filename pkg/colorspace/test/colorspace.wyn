import "../src/lib"

-- Runtime arrays keep the checks on the GPU, including negative/HDR branches.
entry transfer(xs: []f32) []vec4f32 =
  map(|x| @[colorspace.srgb.to_linear_channel(x), colorspace.srgb.from_linear_channel(x),
            colorspace.gamma.decode_channel(x, 2.2f32), colorspace.gamma.encode_channel(x, 2.2f32)], xs)

entry to_linear(xs: []vec3f32) []vec3f32 = map(colorspace.srgb.to_linear, xs)
entry from_linear(xs: []vec3f32) []vec3f32 = map(colorspace.srgb.from_linear, xs)
entry to_linear_rgba(xs: []vec4f32) []vec4f32 = map(colorspace.srgb.to_linear_rgba, xs)
entry from_linear_rgba(xs: []vec4f32) []vec4f32 = map(colorspace.srgb.from_linear_rgba, xs)
entry xyz(xs: []vec3f32) []vec3f32 = map(colorspace.linear_srgb.to_xyz_d65, xs)
entry rgb(xs: []vec3f32) []vec3f32 = map(colorspace.linear_srgb.from_xyz_d65, xs)
entry luminance(xs: []vec3f32) []f32 = map(colorspace.linear_srgb.luminance, xs)
-- Per-element parameters exercise shader math rather than host constant hoisting.
entry gamma_decode(xs: []vec4f32) []vec3f32 =
  map(|rgb| colorspace.gamma.decode(rgb.xyz, rgb.w), xs)
entry gamma_encode(xs: []vec4f32) []vec3f32 =
  map(|rgb| colorspace.gamma.encode(rgb.xyz, rgb.w), xs)
entry expose(xs: []vec4f32) []vec3f32 =
  map(|rgb| colorspace.hdr.expose(rgb.xyz, rgb.w), xs)
entry to_nits(xs: []vec4f32) []vec3f32 =
  map(|rgb| colorspace.hdr.relative_to_nits(rgb.xyz, rgb.w), xs)
entry from_nits(xs: []vec4f32) []vec3f32 =
  map(|rgb| colorspace.hdr.nits_to_relative(rgb.xyz, rgb.w), xs)
