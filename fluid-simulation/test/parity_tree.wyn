-- Expected: eight root octants after subdivision; maintenance merges back
-- to one root. Both overflow flags are false. Regression: a projected
-- loop-carried tree must retain its logical length during compiler lowering.
module Tree = import "../packages/spatial/src/octree"
entry tree() ([]u32,bool,[]u32,bool) =
  let slots=iota(17) in
  let root=map(|i| if i == 0 then 0u32 else Tree.sentinel,slots) in
  let (split,e1)=Tree.build([0u32,268435456u32,536870912u32,805306368u32],root,slots,2) in
  let (merged,e2)=Tree.build_mode([0u32],split,slots,2,true) in
  (split,e1,merged,e2)
