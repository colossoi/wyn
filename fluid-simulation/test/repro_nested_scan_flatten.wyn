-- Regression: constructing rows with nested maps, scanning each row, then flattening
-- by indexed reads previously failed with "allocation has no selected element representation".
-- The updated compiler passes compilation and GPU checks on WGSL and SPIR-V (2026-10-27).
-- Expected: compile successfully; [1,2,3,4] should produce [1,3,3,7].
entry main(xs: [4]i32) [4]i32 =
  let rows = map(|b| map(|j| xs[b*2+j], iota(2)), iota(2)) in
  let prefixes = map(|row| scan((+), 0i32, row), rows) in
  map(|i| prefixes[i/2][i%2], iota(4))
