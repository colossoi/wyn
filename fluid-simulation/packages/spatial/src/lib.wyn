module Hilbert = import "hilbert"
module Sort = import "pkg:sort"
module Octree = import "octree"
module Neighbors = import "neighbors"
module Linked = import "linked_tree"

-- Flat 32-particle tiled layout used by upstream DFSPH shaders.
def neighbor_address(i: i32, ordinal: i32) i32 =
  (i/32)*96*32 + ordinal*32 + i%32

-- Sort, retain/refine the cornerstone tree, build broad and narrow phases.
-- leaf_slots includes the sentinel slot; neighbor_tiles includes padded tiles.
def prepare<[n],[m],[k]>(positions: [n]vec4f32, velocities: [n]vec4f32,
      ids: [n]i32, previous_tree: [m]u32, leaf_slots: [m]i32,
      neighbor_tiles: [k]i32, world_size: f32, radius: f32, ncrit: i32)
    ([n]vec4f32,[n]vec4f32,[m]u32,[k*96*32]i32,[n]i32,bool) =
  let keys_by_id = map(|p| Hilbert.encode(p.xyz,world_size),positions) in
  let order = Sort.FourBit.radix_sort(32,|bit,i| u32.get_bit(bit,keys_by_id[i]),ids) in
  let keys = map(|i| keys_by_id[i],order) in
  let p = map(|i| positions[i],order) in
  let v = map(|i| velocities[i],order) in
  let (tree,tree_overflow) = Octree.build(keys,previous_tree,leaf_slots,ncrit) in
  let offsets = map(|key| Octree.lower_bound(keys,key),tree) in
  let node_slots = iota(((length(leaf_slots)-2)/7)*8+1) in
  let (children,boxes,ranges,node_count) = Linked.build(tree,offsets,node_slots,world_size) in
  let leaves = map(|i| Neighbors.linked_leaf_neighbors(i,p,offsets,children,boxes,ranges,node_count,radius),iota(Octree.lower_bound(tree,Octree.sentinel))) in
  let parts: ([k][32][96]i32,[k]([32]i32,[32]bool)) =
    unzip(map(|tile|
      let split: ([32][96]i32,[32](i32,bool)) = unzip(map(|lane|
        let slot = 32*tile+lane in
        if slot < length(ids) then
          let i = ids[slot] in
          let leaf = Octree.lower_bound(tree,keys[i]+1u32)-1 in
          let (row,count,overflow) = Neighbors.linked_particle_neighbor_row(i,p,ranges,leaves[leaf],radius) in
          (row,(count,overflow))
        else (replicate(96,-1i32),(0i32,false)),iota(32))) in
      let (rows,metadata) = split in (rows,unzip(metadata)),neighbor_tiles)) in
  let (rows,metadata) = parts in
  let (tile_counts,tile_overflow) = unzip(metadata) in
  let tiled = flatten(flatten(map(|tile| transpose(tile),rows))) in
  let padded_counts = flatten(tile_counts) in
  let counts: [n]i32 = padded_counts[0..length(ids)] in
  let overflow = tree_overflow || reduce(|a,b| a || b,false,flatten(tile_overflow)) in
  (p,v,tree,tiled,counts,overflow)
