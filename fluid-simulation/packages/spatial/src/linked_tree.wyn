module Tree = import "octree"
module Hilbert = import "hilbert"

-- Integer first-bit-high, used by upstream's Warren-Salmon node keys.
def high_bit(x: u32) i32 =
  let (x,a) = if x >= 65536u32 then (x >> 16u32,16i32) else (x,0i32) in
  let (x,b) = if x >= 256u32 then (x >> 8u32,8i32) else (x,0i32) in
  let (x,c) = if x >= 16u32 then (x >> 4u32,4i32) else (x,0i32) in
  let (x,d) = if x >= 4u32 then (x >> 2u32,2i32) else (x,0i32) in
  a+b+c+d+(if x >= 2u32 then 1i32 else 0i32)

def placeholder(key: u32, level: i32) u32 =
  (1u32 << u32(3*level)) | (key >> u32(30-3*level))

-- Node bounds are decoded once, rather than during every leaf traversal.
def bounds(key: u32, world_size: f32) vec4f32 =
  let level = high_bit(key)/3 in
  let path = key ^ (1u32 << u32(3*level)) in
  let p = Hilbert.decode(path << u32(3*(10-level))) in
  let side = 1u32 << u32(10-level) in
  let lo = @[f32((p.x/side)*side),f32((p.y/side)*side),f32((p.z/side)*side)]*(world_size/1024.0) in
  @[lo.x,lo.y,lo.z,f32(side)*(world_size/1024.0)]

-- Within a depth, Hilbert boundary order is already placeholder-key order.
-- Each boundary emits a leaf and may emit its ancestor at the gap between
-- octants 3 and 4. Their depths differ, so they can share one vector prefix.
def node_depths<[m]>(corners: [m]u32, i: i32) vec2i32 =
  if i+1 >= length(corners) || corners[i] >= Tree.sentinel then @[-1i32,-1i32] else
  let key = corners[i] in let next = corners[i+1] in
  let leaf = 10-high_bit(next-key)/3 in
  let divergence = 29-high_bit(key ^ next) in
  let internal = if next < Tree.sentinel && divergence % 3 == 0 then divergence/3 else -1i32 in
  @[leaf,internal]

def depth_destination(rank: [11]i32, ends: [11]i32, depth: i32) i32 =
  if depth < 0 then -1i32 else
  let start = if depth == 0 then 0i32 else ends[depth-1] in
  start+rank[depth]-1

-- slots must hold at least 8*(leaves-1)/7+1 nodes.
-- Returns first-child links, physical bounds, particle ranges, and node count.
def build<[m],[k]>(corners: [m]u32, offsets: [m]i32, slots: [k]i32, world_size: f32)
    ([k]i32,[k]vec4f32,[k]vec2i32,i32) =
  let depths = map(|i| node_depths(corners,i),iota(length(corners))) in
  let flags = map(|depth| map(|d| i32.bool(depth.x == d || depth.y == d),iota(11)),depths) in
  let ranks = scan(|a,b| map2((+),a,b),replicate(11,0i32),flags) in
  let ends = scan((+),0i32,ranks[length(corners)-1]) in
  let count = ends[10] in
  let destinations = flatten(map2(|depth,rank|
    [depth_destination(rank,ends,depth.x),depth_destination(rank,ends,depth.y)],depths,ranks)) in
  -- Even IDs stand for leaves and odd IDs for internal nodes. Only the live
  -- prefix is read, and each live rank writes its own scalar destination.
  let order = scatter(#[scratch] replicate(length(slots),0i32),destinations,iota(length(destinations))) in
  let keys = map(|i|
    if i >= count then 0u32 else
    let code = order[i] in
    let source = code/2 in
    let depth = depths[source] in
    placeholder(corners[source],if code%2 == 0 then depth.x else depth.y),iota(length(slots))) in
  let children = map(|i|
    if i >= count || order[i]%2 == 0 then 0i32 else
    let depth = high_bit(keys[i])/3 in
    let child_key = keys[i] << 3u32 in
    let last = ends[depth+1] in
    let child = Tree.lower_bound_between(keys,child_key,ends[depth],last) in
    if child < last && keys[child] == child_key then child else 0i32,slots) in
  let boxes = map(|i| if i < count then bounds(keys[i],world_size) else @[0.0,0.0,0.0,0.0],slots) in
  let ranges = map(|i|
    if i >= count || order[i]%2 != 0 then @[0i32,0i32] else
    let leaf = order[i]/2 in
    @[offsets[leaf],offsets[leaf+1]-offsets[leaf]],slots) in
  (children,boxes,ranges,count)
