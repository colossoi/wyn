; Publish an output where all its computed inputs are already available. Limit
; attachment to values available to lane zero in the entry's own scope; other
; outputs keep their finish kernel. References is the ordinary dependency summary.
(relation EpilogueValue (StageKey ValueKey))
(function OutputAvailable (StageKey ValueKey) bool :merge (or old new))
(function OutputBlocked (i64 StageKey) bool :merge (or old new))
(function OutputWriter (i64) RootKey :no-merge)
(relation FinishEntry (i64))
(relation FinishDependency (i64 StageKey))
(function OutputAttached (i64) bool :merge (or old new))
(ruleset output-candidates)
(ruleset output-blockers)
(ruleset output-select)
(ruleset output-fallback)
; Track returned lengths before choosing an output writer. Copying a projected
; compacted component reads the parent's stored count as well as its elements.
(rule ((ReturnArray output array))
      ((LengthReference array array)) :ruleset residency)
(rule ((Produces stage value) (PhaseDomain stage (Fixed 1) 1))
      ((EpilogueValue stage value)) :ruleset output-candidates)
; Compaction publishes its count in lane zero. Its element output is written
; by other lanes and cannot be read here without storage synchronization.
(rule ((= (Plan op) (Compact)) (Produces (Stage op "compact") (Result op 1)))
      ((EpilogueValue (Stage op "compact") (Result op 1))) :ruleset output-candidates)
(rule ((CopyOutput output)) ((set (OutputAttached output) false)) :ruleset output-candidates)
(rule ((= blocked (OutputBlocked output stage)) (PlannedOutput output owner e) (References e (Contents value)))
      ((set (OutputAvailable stage value) false)) :ruleset output-candidates)
(rule ((= blocked (OutputBlocked output stage)) (EpilogueValue stage value))
      ((set (OutputAvailable stage value) true)) :ruleset output-candidates)
(rule ((= blocked (OutputBlocked output stage)) (PlannedOutput output owner e) (References e (Contents (Source source))))
      ((set (OutputAvailable stage (Source source)) true)) :ruleset output-candidates)
(rule ((= blocked (OutputBlocked output stage)) (PlannedOutput output owner e) (References e (Contents value))
       (= (OutputAvailable stage value) false))
      ((set (OutputBlocked output stage) true)) :ruleset output-blockers)
; Do not move an old-content read across an authored update, even when the
; allocation is shared. Descriptor-only length uses do not read those contents.
(rule ((= blocked (OutputBlocked output stage)) (PlannedOutput output owner e) (References e (Contents value))
       (Clobbers writer value))
      ((set (OutputBlocked output stage) true)) :ruleset output-blockers)
(rule ((= (OutputBlocked output stage) false))
      ((set (OutputWriter output) (KernelRoot stage)) (set (OutputAttached output) true)
       (Produces stage (Output output))) :ruleset output-select)
(rule ((CopyOutput output) (PlannedOutput output entry e) (= (OutputAttached output) false))
      ((set (OutputWriter output) (EntryRoot entry))) :ruleset output-fallback)
(rule ((= (OutputWriter output) (KernelRoot stage)) (PlannedOutput output owner e))
      ((Demand (InStage stage) e)) :ruleset residency)
(rule ((= (OutputWriter output) (EntryRoot entry)) (HostRoot entry region))
      ((FinishEntry entry)) :ruleset residency)
(rule ((= (OutputWriter output) (EntryRoot entry)) (PlannedOutput output owner e)
       (References e (Contents value)) (Produces stage value))
      ((FinishDependency entry stage)) :ruleset residency)
