; Publish an output where all its computed inputs are already available. Limit
; attachment to one invocation in the entry's own scope; other outputs keep
; their finish kernel. References is the ordinary dependency summary.
(relation OutputExpression (i64 ExprKey))
(relation OutputCandidate (i64 StageKey))
(function OutputAvailable (StageKey ValueKey) bool :merge (or old new))
(function OutputBlocked (i64 StageKey) bool :merge (or old new))
(relation OutputWriter (i64 RootKey))
(function OutputAttached (i64) bool :merge (or old new))
(ruleset output-candidates)
(ruleset output-blockers)
(ruleset output-select)
(ruleset output-fallback)
(rule ((CopyOutput output)) ((set (OutputAttached output) false)) :ruleset output-candidates)
(rule ((CopyOutput output) (OutputExpression output e) (References e (Contents value))
       (Produces stage value) (PhaseDomain stage (Fixed 1) 1)
       (= stage (Stage (OperationId op) name)) (= (CpuBlocked (EvalOperation op)) true)
       (Phase stage r) (OutputOwner output entry) (SourceEntry entry r true))
      ((OutputCandidate output stage) (set (OutputBlocked output stage) false)) :ruleset output-candidates)
(rule ((OutputCandidate output stage) (OutputExpression output e) (References e (Contents value)))
      ((set (OutputAvailable stage value) false)) :ruleset output-candidates)
(rule ((OutputCandidate output stage) (Produces stage value))
      ((set (OutputAvailable stage value) true)) :ruleset output-candidates)
(rule ((OutputCandidate output stage) (OutputExpression output e) (References e (Contents (Source source))))
      ((set (OutputAvailable stage (Source source)) true)) :ruleset output-candidates)
(rule ((OutputCandidate output stage) (OutputExpression output e) (References e (Contents value))
       (= (OutputAvailable stage value) false))
      ((set (OutputBlocked output stage) true)) :ruleset output-blockers)
; Do not move an old-content read across an authored update, even when the
; allocation is shared. Descriptor-only length uses do not read those contents.
(rule ((OutputCandidate output stage) (OutputExpression output e) (References e (Contents value))
       (Clobbers writer value))
      ((set (OutputBlocked output stage) true)) :ruleset output-blockers)
(rule ((OutputCandidate output stage) (= (OutputBlocked output stage) false))
      ((OutputWriter output (KernelRoot stage)) (set (OutputAttached output) true)
       (Produces stage (Output output))) :ruleset output-select)
(rule ((CopyOutput output) (OutputOwner output entry) (= (OutputAttached output) false))
      ((OutputWriter output (EntryRoot entry)) (AbiCopyEntry entry)) :ruleset output-fallback)
(rule ((OutputWriter output (KernelRoot stage)) (OutputExpression output e))
      ((Demand (InStage stage) e)) :ruleset residency)
(rule ((OutputWriter output (KernelRoot stage)) (OutputExpression output e) (References e (Contents value)))
      ((AbiRootNeed (KernelRoot stage) (AbiResource value))) :ruleset abi)
(rule ((OutputWriter output (KernelRoot stage)) (OutputExpression output e) (References e (Descriptor (ExprId source))))
      ((AbiRootNeed (KernelRoot stage) (AbiExpr source))) :ruleset abi)
(rule ((OutputWriter output root) (OutputBacking output value) (AbiBufferBinding value binding))
      ((set (AbiAccess root binding) 2)) :ruleset abi-final)
