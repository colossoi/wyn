; Structural values remain e-graph terms. Executions and their dependencies are
; relations: no total-order operation list participates in matching or extraction.
(ruleset dependencies)
(datatype OperandRole (Input) (Capture) (Neutral) (Argument))
(relation ExprChild (Expr Expr))
(relation ExprItem (Exprs Expr))
(relation ArrayItem (Arrays Array))
(relation ArrayOperand (Array Expr))
(relation BodyCapture (SoacBody Expr))
(relation BodyRegion (SoacBody RegionKey))
(relation BodyIn (Collectives SoacBody))
(relation NeutralIn (Collectives Expr))
(relation Operand (Action OperandRole Expr))
(relation ActionRegion (Action RegionKey))
(relation ValueDependency (Expr OperationKey))
(relation RegionDependency (RegionKey OperationKey))
(relation AncestorRegion (RegionKey RegionKey))
(sort OperationSet (Set OperationKey))
(function Members (RegionKey) OperationSet :merge (set-union old new))
(function ArrayDependencies (Array) OperationSet :merge (set-union old new))

(rule ((Region r)) ((set (Members r) (set-empty))) :ruleset dependencies)
(rule ((Operation r op t a)) ((set (Members r) (set-of op))) :ruleset dependencies)
(rule ((ParentRegion child parent)) ((AncestorRegion child parent)) :ruleset dependencies)
(rule ((ParentRegion child parent) (AncestorRegion parent ancestor))
      ((AncestorRegion child ancestor)) :ruleset dependencies)

; Positional lists are still useful for arguments and logical tuple fields.
(rule ((= xs (ExprsCons x tail))) ((ExprItem xs x)) :ruleset dependencies)
(rule ((= xs (ExprsCons x tail)) (ExprItem tail y)) ((ExprItem xs y)) :ruleset dependencies)
(rule ((= xs (ArraysCons x tail))) ((ArrayItem xs x)) :ruleset dependencies)
(rule ((= xs (ArraysCons x tail)) (ArrayItem tail y)) ((ArrayItem xs y)) :ruleset dependencies)
(rule ((= a (ArrayInput e))) ((ArrayOperand a e)) :ruleset dependencies)
(rule ((= a (Zip xs)) (ArrayItem xs b) (ArrayOperand b e)) ((ArrayOperand a e)) :ruleset dependencies)
(rule ((= a (ArrayLiteral xs)) (ExprItem xs e)) ((ArrayOperand a e)) :ruleset dependencies)
(rule ((= a (Range start len step))) ((ArrayOperand a start) (ArrayOperand a len)) :ruleset dependencies)
(rule ((= a (Range start len (SomeExpr step)))) ((ArrayOperand a step)) :ruleset dependencies)
(rule ((ArrayItem arrays a)) ((set (ArrayDependencies a) (set-empty))) :ruleset dependencies)
(rule ((ArrayOperand a e) (ValueDependency e p)) ((set (ArrayDependencies a) (set-of p))) :ruleset dependencies)

(rule ((= e (Typed t x))) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (PureApp f args))) ((ExprChild e f)) :ruleset dependencies)
(rule ((= e (PureApp f args)) (ExprItem args x)) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (Closure f n captures)) (ExprItem captures x)) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (Coerce x))) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (If c a b))) ((ExprChild e c) (ExprChild e a) (ExprChild e b)) :ruleset dependencies)
(rule ((= e (ArrayValue a)) (ArrayOperand a x)) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (Tuple xs)) (ExprItem xs x)) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (Vector xs)) (ExprItem xs x)) ((ExprChild e x)) :ruleset dependencies)
(rule ((= e (Project x i))) ((ExprChild e x)) :ruleset dependencies)
; Stop at an execution's result: dependency edges are direct, not flattened.
(rule ((= e (OperationResult op))) ((ValueDependency e op)) :ruleset dependencies)
(rule ((ExprChild e x) (ValueDependency x op)) ((ValueDependency e op)) :ruleset dependencies)
(rule ((= e (LambdaValue r)) (RegionDependency r op)) ((ValueDependency e op)) :ruleset dependencies)

(rule ((= b (ApplyBody r ps rs cs)) (ExprItem cs e)) ((BodyCapture b e)) :ruleset dependencies)
(rule ((= b (ApplyBody r ps rs cs))) ((BodyRegion b r)) :ruleset dependencies)
(rule ((= b (ComposeBody a c)) (BodyCapture a e)) ((BodyCapture b e)) :ruleset dependencies)
(rule ((= b (ComposeBody a c)) (BodyCapture c e)) ((BodyCapture b e)) :ruleset dependencies)
(rule ((= b (ComposeBody a c)) (BodyRegion a r)) ((BodyRegion b r)) :ruleset dependencies)
(rule ((= b (ComposeBody a c)) (BodyRegion c r)) ((BodyRegion b r)) :ruleset dependencies)
(rule ((= b (ParallelBody a c)) (BodyCapture a e)) ((BodyCapture b e)) :ruleset dependencies)
(rule ((= b (ParallelBody a c)) (BodyCapture c e)) ((BodyCapture b e)) :ruleset dependencies)
(rule ((= b (ParallelBody a c)) (BodyRegion a r)) ((BodyRegion b r)) :ruleset dependencies)
(rule ((= b (ParallelBody a c)) (BodyRegion c r)) ((BodyRegion b r)) :ruleset dependencies)
(rule ((= xs (CollectivesCons (Scan b ne) tail))) ((BodyIn xs b)) :ruleset dependencies)
(rule ((= xs (CollectivesCons x tail)) (BodyIn tail b)) ((BodyIn xs b)) :ruleset dependencies)
(rule ((= xs (CollectivesCons (Scan b ne) tail)) (ExprItem ne e)) ((NeutralIn xs e)) :ruleset dependencies)
(rule ((= xs (CollectivesCons x tail)) (NeutralIn tail e)) ((NeutralIn xs e)) :ruleset dependencies)
(rule ((= xs (CollectivesCons (Reduction b ne comm) tail))) ((BodyIn xs b)) :ruleset dependencies)
(rule ((= xs (CollectivesCons (Reduction b ne comm) tail)) (ExprItem ne e)) ((NeutralIn xs e)) :ruleset dependencies)

; Captures and neutral values are distinct from streamed inputs. A producer in
; a capture cannot be absorbed as an input lane.
(relation ActionBody (Action SoacBody))
(rule ((= a (Call f args))) ((Operand a (Argument) f)) :ruleset dependencies)
(rule ((= a (Call f args)) (ExprItem args e)) ((Operand a (Argument) e)) :ruleset dependencies)
(rule ((= a (Choose c yes no))) ((Operand a (Argument) c) (ActionRegion a yes) (ActionRegion a no)) :ruleset dependencies)
(rule ((= a (Loop init header kind body)))
      ((Operand a (Argument) init) (ActionRegion a header) (ActionRegion a body)) :ruleset dependencies)
(rule ((= a (Loop init header (For n) body))) ((Operand a (Argument) n)) :ruleset dependencies)
(rule ((= a (Loop init header (ForRange n) body))) ((Operand a (Argument) n)) :ruleset dependencies)
(rule ((= a (Index array index))) ((Operand a (Argument) array) (Operand a (Argument) index)) :ruleset dependencies)
(rule ((= a (ScremaApp form inputs ownership)) (ArrayItem inputs input) (ArrayOperand input e))
      ((Operand a (Input) e)) :ruleset dependencies)
(rule ((= a (ScremaApp (Screma pre scans reductions post) inputs ownership)))
      ((ActionBody a pre) (ActionBody a post)) :ruleset dependencies)
(rule ((= a (ScremaApp (Screma pre scans reductions post) inputs ownership)) (BodyIn scans b))
      ((ActionBody a b)) :ruleset dependencies)
(rule ((= a (ScremaApp (Screma pre scans reductions post) inputs ownership)) (BodyIn reductions b))
      ((ActionBody a b)) :ruleset dependencies)
(rule ((= a (ScremaApp (Screma pre scans reductions post) inputs ownership)) (NeutralIn scans e))
      ((Operand a (Neutral) e)) :ruleset dependencies)
(rule ((= a (ScremaApp (Screma pre scans reductions post) inputs ownership)) (NeutralIn reductions e))
      ((Operand a (Neutral) e)) :ruleset dependencies)
(rule ((= a (Filter b input ownership))) ((ActionBody a b)) :ruleset dependencies)
(rule ((= a (Filter b input ownership)) (ArrayOperand input e)) ((Operand a (Input) e)) :ruleset dependencies)
(rule ((= a (Scatter (Place dest t) b inputs))) ((Operand a (Argument) dest) (ActionBody a b)) :ruleset dependencies)
(rule ((= a (Scatter dest b inputs)) (ArrayItem inputs input) (ArrayOperand input e)) ((Operand a (Input) e)) :ruleset dependencies)
(rule ((= a (BucketScatter (Place dest t) b inputs shape))) ((Operand a (Argument) dest) (ActionBody a b)) :ruleset dependencies)
(rule ((= a (BucketScatter dest b inputs shape)) (ArrayItem inputs input) (ArrayOperand input e)) ((Operand a (Input) e)) :ruleset dependencies)
(rule ((= a (ReduceByIndex (Place dest t) b neutral indices values)))
      ((Operand a (Argument) dest) (Operand a (Neutral) neutral) (ActionBody a b)) :ruleset dependencies)
(rule ((= a (ReduceByIndex dest b neutral indices values)) (ArrayOperand indices e)) ((Operand a (Input) e)) :ruleset dependencies)
(rule ((= a (ReduceByIndex dest b neutral indices values)) (ArrayOperand values e)) ((Operand a (Input) e)) :ruleset dependencies)
(rule ((ActionBody a b) (BodyCapture b e)) ((Operand a (Capture) e)) :ruleset dependencies)
(rule ((ActionBody a b) (BodyRegion b r)) ((ActionRegion a r)) :ruleset dependencies)

(rule ((Operation r consumer t a) (Operand a role e) (ValueDependency e producer))
      ((DependsOn consumer producer)) :ruleset dependencies)
(rule ((Operation r consumer t a) (ActionRegion a child) (RegionDependency child producer)
       (Operation pr producer pt pa) (AncestorRegion r pr))
      ((DependsOn consumer producer)) :ruleset dependencies)
; Captures from this same region must also precede the enclosing operation.
(rule ((Operation r consumer t a) (ActionRegion a child) (RegionDependency child producer)
       (Operation r producer pt pa))
      ((DependsOn consumer producer)) :ruleset dependencies)
(rule ((RegionResult r i e) (ValueDependency e producer)) ((ResultDependsOn r producer)) :ruleset dependencies)
; Nested regions expose only dependencies on enclosing executions. Local work
; stays inside its branch, loop, or lambda; it is never hoisted by this analysis.
(rule ((Operation r consumer t a) (DependsOn consumer producer)
       (Operation pr producer pt pa) (AncestorRegion r pr))
      ((RegionDependency r producer)) :ruleset dependencies)
(rule ((ResultDependsOn r producer) (Operation pr producer pt pa) (AncestorRegion r pr))
      ((RegionDependency r producer)) :ruleset dependencies)
