; Direct producer/consumer edges suffice: do not materialize transitive closure.
(rule ((Crossing a b value) (Phase a r) (Phase b r)) ((Before a b)) :ruleset dispatch)
; An authored update may share backing, but readers of the old value must finish
; first. Join on that particular value version, never on all pairs of stages.
; Length-only needs do not observe the old contents and must not reverse a
; producer/consumer dependency through an in-place update.
(rule ((Clobbers writer old) (Requires (InStage reader) old) (Phase writer r) (Phase reader r) (!= reader writer))
      ((Before reader writer)) :ruleset dispatch)
(rule ((Clobbers writer old) (Needs (Stage op "scalar") old)
       (Phase writer r) (Phase (Stage op "scalar") r) (!= (Stage op "scalar") writer))
      ((Before (Stage op "scalar") writer)) :ruleset dispatch)

; An operation has separate start/end boundaries so its internal phases remain
; ordered without a cycle through one source-operation node.
(rule ((FirstPhase op stage)) ((OrderEdge (Start op) (At stage))) :ruleset dispatch)
(rule ((LastPhase op stage)) ((OrderEdge (At stage) (End op))) :ruleset dispatch)
(rule ((ScalarSite op)) ((OrderEdge (Start op) (End op))) :ruleset dispatch)
(rule ((Before a b)) ((OrderEdge (At a) (At b))) :ruleset dispatch)
(rule ((EffectInput gate op)) ((OrderEdge (End op) (Gate gate))) :ruleset dispatch)
; A proven scalar join executes at its leader, whose incoming gates remain.
; Its original gate may include the independent work it has moved ahead of.
(rule ((EffectWait op gate) (= (ScalarJoined op) false))
      ((OrderEdge (Gate gate) (Start op))) :ruleset dispatch)
; Preserve direct dependencies through scalar/control boundaries;
; SOAC-to-SOAC flow uses the actual component writer.
(rule ((SourceDependency after before) (ScalarSite after) (Site after r) (Site before r))
      ((OrderEdge (End before) (Start after))) :ruleset dispatch)
(rule ((SourceDependency after before) (ScalarSite before) (Site after r) (Site before r))
      ((OrderEdge (End before) (Start after))) :ruleset dispatch)
(rule ((Requires (InOperation op) value) (Produces stage value) (Site op r) (Phase stage r))
      ((OrderEdge (At stage) (Start op))) :ruleset dispatch)

; Read out immediate dispatch predecessors, traversing only non-launch nodes.
; Stop at a launch, so a chain remains linear instead of becoming its closure.
(rule ((Phase stage r) (OrderEdge before (At stage))) ((Waits stage before)) :ruleset dispatch)
(rule ((Waits after (Start op)) (OrderEdge before (Start op))) ((Waits after before)) :ruleset dispatch)
(rule ((Waits after (End op)) (OrderEdge before (End op))) ((Waits after before)) :ruleset dispatch)
(rule ((Waits after (Gate gate)) (OrderEdge before (Gate gate))) ((Waits after before)) :ruleset dispatch)
(rule ((Waits after (At before)) (Phase before r) (Phase after r) (!= before after))
      ((DispatchDependency before after)) :ruleset dispatch)

; Host legality is decided from source execution boundaries, before blocks exist.
(rule ((Site op r)) ((set (AbiHasLaunch r) false)) :ruleset abi)
(rule ((SourceEntry entry r compute)) ((set (AbiHasLaunch r) false)) :ruleset abi)
(rule ((Phase stage r)) ((set (AbiHasLaunch r) true)) :ruleset abi)
(rule ((Site op r) (Enters op child) (HostRegion child) (= (AbiHasLaunch child) true))
      ((set (AbiHasLaunch r) true)) :ruleset abi)
(rule ((SourceEntry entry r true) (= (AbiHasLaunch r) true)
       (OwnedRegion entry scope) (HostRegion scope) (Site op scope) (SourceControl op) (= (ScalarBoundary op) false))
      ((AbiInvalidHost entry)) :ruleset abi)
(rule ((SourceEntry entry r true) (= (AbiHasLaunch r) true)
       (OwnedRegion entry scope) (HostRegion scope) (Site op scope) (SourceCall op)
       (= (ScalarBoundary op) false))
      ((AbiInvalidHost entry)) :ruleset abi)
(rule ((PhaseOwner stage entry) (Waits stage (End op)) (HostEvaluation op)
       (= (ScalarBoundary op) false)) ((AbiInvalidHost entry)) :ruleset abi)

(rule ((SourceEntry entry r false)) ((AbiRoot (EntryRoot entry) entry 1 1 1 true)) :ruleset abi-final)
(rule ((SourceEntry entry r true) (= (AbiHasLaunch r) false))
      ((AbiRoot (EntryRoot entry) entry 1 1 1 true)) :ruleset abi-final)
(rule ((SourceEntry entry r true) (AbiCopyEntry entry))
      ((AbiRoot (EntryRoot entry) entry 1 1 1 true)) :ruleset abi-final)
(rule ((PhaseOwner stage entry) (PhaseDomain stage n width))
      ((AbiRoot (KernelRoot stage) entry width 1 1 false)) :ruleset abi-final)
; Cooperative combines still require exactly one workgroup. Authored grids
; apply only to phases whose ownership supports multiple independent groups.
(function FixedPhaseGrid (StageKey) bool :merge (or old new))
(rule ((Phase stage r)) ((set (FixedPhaseGrid stage) false)) :ruleset abi)
(rule ((PhaseDomain stage n 1)) ((set (FixedPhaseGrid stage) true)) :ruleset abi)
(rule ((Phase (Stage op "combine") r)) ((set (FixedPhaseGrid (Stage op "combine")) true)) :ruleset abi)
(rule ((SourceEntry entry r compute)) ((set (HasSourceGrid entry) false)) :ruleset abi)
(rule ((SourceGrid entry x y z)) ((set (HasSourceGrid entry) true)) :ruleset abi)
(rule ((Phase stage r) (PhaseDomain stage n width)) ((AbiExtent n)) :ruleset abi)
(rule ((PhaseOwner stage entry) (= (HasSourceGrid entry) false) (PhaseDomain stage n width))
      ((AbiLaunchDomain stage n width)) :ruleset abi-final)
(rule ((PhaseOwner stage entry) (PhaseDomain stage n width) (= (FixedPhaseGrid stage) true))
      ((AbiLaunchDomain stage n width)) :ruleset abi-final)
; ceil(ceil(n / chunk) / width) = ceil(n / (chunk * width)). Keep
; this division in the launch policy, independently of scratch capacity.
; Classify extents in abi before abi-final tests the completed predicate.
(function ChunkedExtent (Extent) bool :merge (or old new))
(rule ((= v (AbiExtent n))) ((set (ChunkedExtent n) false)) :ruleset abi)
(rule ((= n (ChunkCount domain chunk))) ((set (ChunkedExtent n) true)) :ruleset abi)
(rule ((AbiLaunchDomain stage (ChunkCount n chunk) width) (> chunk 0)
       (<= width (/ 4294967295 chunk)))
      ((AbiLaunchDomain stage n (* width chunk))) :ruleset abi-final)
(rule ((AbiLaunchDomain stage n width) (= (ChunkedExtent n) false))
      ((AbiGridDomain stage (AbiExtent n) width)) :ruleset abi-final)
(rule ((PhaseOwner stage entry) (SourceGrid entry x y z) (PhaseDomain stage n width) (= (FixedPhaseGrid stage) false))
      ((set (RootLaunch (KernelRoot stage)) (FixedLaunch x y z))) :ruleset abi-final)
(rule ((AbiGridDomain stage n width) (> width 0) (= count (AbiBoundConstant n)))
      ((set (RootLaunch (KernelRoot stage)) (FixedLaunch (min 65535 (max 1 (+ (/ count width) (min 1 (% count width))))) 1 1))) :ruleset abi-final)
(rule ((AbiGridDomain stage n width) (= (AbiBoundKnown n) false) (AbiBoundInput n binding stride))
      ((set (RootLaunch (KernelRoot stage)) (InputLaunch binding stride width))) :ruleset abi-final)
(rule ((AbiGridDomain stage n width) (= (AbiBoundKnown n) false) (AbiParameterCount n offset))
      ((set (RootLaunch (KernelRoot stage)) (ParameterLaunch offset width))) :ruleset abi-final)
; A parallel grid-stride kernel may launch from an allocation covering its
; domain, including a caller-sized output. Keep this separate from AbiBoundInput:
; using an output as its own allocation bound would make its capacity circular.
(rule ((AbiGridDomain stage n width) (= (FixedPhaseGrid stage) false)
       (AbiCapacity buffer n stride) (AbiBufferBinding buffer binding)
       (= access (AbiAccess (KernelRoot stage) binding)))
      ((AbiGridCapacity (KernelRoot stage) binding stride width)) :ruleset abi-final)
; Preserve unresolved status for host-sized domains. ABI readout can select a
; published capacity as the launch bound without reading uniform data back.
(rule ((AbiGridDomain stage n width)) ((AbiGridNeed stage n)) :ruleset abi-final)
(rule ((AbiGridNeed stage n) (AbiChild n child)) ((AbiGridNeed stage child)) :ruleset abi-final)
(rule ((AbiGridDomain stage n width)) ((set (AbiGridResolved stage) false)) :ruleset abi-final)
(rule ((= launch (RootLaunch (KernelRoot stage)))) ((set (AbiGridResolved stage) true)) :ruleset abi-final)
(rule ((AbiGridNeed stage n) (AbiHostInput n input) (= (AbiGridResolved stage) false))
      ((set (RootLaunch (KernelRoot stage)) (HostLaunch))) :ruleset readout)
(rule ((SourceGrid entry x y z) (SourceEntry entry r true) (= (AbiHasLaunch r) false)
       (AbiRoot (EntryRoot entry) entry wx wy wz finish))
      ((set (RootLaunch (EntryRoot entry)) (FixedLaunch x y z))) :ruleset abi-final)
; A generated publication copy executes once, independently of the source grid.
(rule ((SourceEntry entry r true) (= (AbiHasLaunch r) true) (AbiCopyEntry entry))
      ((set (RootLaunch (EntryRoot entry)) (FixedLaunch 1 1 1))) :ruleset abi-final)
(rule ((SourceEntry entry r compute)) ((set (AbiHasImage entry) false)) :ruleset abi-final)
(rule ((= (RootLaunch (EntryRoot entry)) (ImageLaunch binding))) ((set (AbiHasImage entry) true)) :ruleset abi-final)
(rule ((SourceEntry entry r true) (AbiRoot (EntryRoot entry) entry wx wy wz finish)
       (= (HasSourceGrid entry) false) (= (AbiHasImage entry) false))
      ((set (RootLaunch (EntryRoot entry)) (FixedLaunch 1 1 1))) :ruleset readout)
(rule ((SourceEntry entry r true) (AbiRoot (EntryRoot entry) entry wx wy wz finish)
       (= (AbiHasLaunch r) false)
       (AbiRootNeed (EntryRoot entry) value) (AbiImage value binding) (= (HasSourceGrid entry) false))
      ((set (RootLaunch (EntryRoot entry)) (ImageLaunch binding))) :ruleset abi-final)

; Copy kernels publish after every launch belonging to their source entry.
(rule ((AbiCopyEntry entry) (PhaseOwner before entry))
      ((AbiRootDependency (KernelRoot before) (EntryRoot entry))) :ruleset abi-final)
(rule ((DispatchDependency before after))
      ((AbiRootDependency (KernelRoot before) (KernelRoot after))) :ruleset abi-final)
; Merge accesses before assigning physical bindings.
(rule ((AbiRootStorage root binding)) ((set (AbiAccess root binding) 1)) :ruleset abi-final)
(rule ((= flags (Access stage value)) (AbiBufferBinding value binding))
      ((set (AbiAccess (KernelRoot stage) binding) flags)) :ruleset abi-final)
; Root environments use source values already present in the planning graph.
(rule ((Phase stage r) (= stage (Stage op name)) (Operand op role (ExprId e)))
      ((AbiRootNeed (KernelRoot stage) (AbiExpr e))) :ruleset abi)
(rule ((ScalarGroup op leader) (Phase (Stage leader "scalar") r) (Operand op role (ExprId e)))
      ((AbiRootNeed (KernelRoot (Stage leader "scalar")) (AbiExpr e))) :ruleset abi)

(rule ((Phase stage r) (= stage (Stage op name)) (Enters op child))
      ((AbiInvokes (KernelRoot stage) child)) :ruleset abi)
(rule ((ScalarGroup op leader) (Phase (Stage leader "scalar") r) (Enters op child))
      ((AbiInvokes (KernelRoot (Stage leader "scalar")) child)) :ruleset abi)
(rule ((Phase stage r) (= stage (Stage op name)) (Callback op child))
      ((AbiInvokes (KernelRoot stage) child)) :ruleset abi)
(rule ((AbiInvokes root r) (Site op r) (Operand op role (ExprId e)))
      ((AbiRootNeed root (AbiExpr e))) :ruleset abi)
(rule ((AbiInvokes root r) (ExitValue r (ExprId e)))
      ((AbiRootNeed root (AbiExpr e))) :ruleset abi)
(rule ((AbiInvokes root r) (Site op r) (Enters op child)) ((AbiInvokes root child)) :ruleset abi)
(rule ((AbiInvokes root r) (Site op r) (Callback op child)) ((AbiInvokes root child)) :ruleset abi)
(rule ((SourceEntry entry r compute) (DeviceRegion r)) ((AbiInvokes (EntryRoot entry) r)) :ruleset abi)
