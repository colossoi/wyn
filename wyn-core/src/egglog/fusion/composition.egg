; Immutable operator composition, routing, and result signatures. Scalar bodies
; stay in their source scopes; these nodes describe how invocations connect.
(datatype ResultTree
  (NoResults)
  (OneResult SourceValue TypeKey)
  (CountResult FusionPlan TypeKey)
  (JoinResults ResultTree ResultTree))
(function PlanTotals (FusionPlan) ResultTree :no-merge)
(function PlanArrays (FusionPlan) ResultTree :no-merge)
(function PlanScans (FusionPlan) ResultTree :no-merge)
(function PlanDomain (FusionPlan) OperationKey :no-merge)
(relation PlanMember (FusionPlan OperationKey))
(function PlanRoute (FusionPlan OperationKey i64) SourceValue :no-merge)
(function PlanInputCount (FusionPlan OperationKey) i64 :no-merge)
(function PlanCallback (FusionPlan OperationKey) RegionKey :no-merge)
(function PlanMapping (FusionPlan OperationKey) bool :no-merge)
(function PlanCallee (SourceValue) RegionKey :no-merge)
(function PlanCallArgument (SourceValue i64) SourceValue :no-merge)
(relation PlanCallIndex (SourceValue i64))
(relation PlanJoin (FusionPlan i64 FusionPlan FusionPlan bool))

(rule ((SourceOperation op region kind))
      ((PlanMember (FusionSource op) op)) :ruleset source-fusion)
(rule ((= value (SourceInput op i))) ((set (PlanRoute (FusionSource op) op i) value)) :ruleset source-fusion)
(rule ((= count (SourceInputCount op))) ((set (PlanInputCount (FusionSource op) op) count)) :ruleset source-fusion)
(rule ((= body (SourceOperatorBody op))) ((set (PlanCallback (FusionSource op) op) body)) :ruleset source-fusion)
(rule ((SourceOperation op r "map")) ((set (PlanMapping (FusionSource op) op) true)) :ruleset source-fusion)
(rule ((SourceOperation op r kind) (!= kind "map")) ((set (PlanMapping (FusionSource op) op) false)) :ruleset source-fusion)
(rule ((= value (SourceInvocation scope function args))) ((PlanCallIndex value 0)) :ruleset source-fusion)
(rule ((= value (SourceInvocation scope function args)) (SourceCallable function callee))
      ((set (PlanCallee value) callee)) :ruleset source-fusion)
(rule ((PlanCallIndex value i) (= value (SourceInvocation scope function args)) (< i (vec-length args)))
      ((set (PlanCallArgument value i) (vec-get args i)) (PlanCallIndex value (+ i 1))) :ruleset source-fusion)
(rule ((= rank (SourceDomainRank op))) ((set (PlanDomain (FusionSource op)) op)) :ruleset source-fusion)
(rule ((SourceOperation op r "reduce") (= value (SourceOperationValue op)) (= ty (SourceType value)))
      ((set (PlanTotals (FusionSource op)) (OneResult value ty))) :ruleset source-fusion)
(rule ((SourceOperation op r kind) (!= kind "reduce"))
      ((set (PlanTotals (FusionSource op)) (NoResults))) :ruleset source-fusion)
(rule ((SourceArrayProducer op) (= value (SourceOperationValue op)) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (PlanArrays (FusionSource op)) (OneResult value element))) :ruleset source-fusion)
(rule ((SourceOperation op r kind) (!= kind "map") (!= kind "scan") (!= kind "filter"))
      ((set (PlanArrays (FusionSource op)) (NoResults))) :ruleset source-fusion)
(rule ((SourceOperation op r "scan") (= neutral (SourceNeutral op)) (= value (SourceOperationValue op)) (= ty (SourceType neutral)))
      ((set (PlanScans (FusionSource op)) (OneResult value ty))) :ruleset source-fusion)
(rule ((SourceOperation op r kind) (!= kind "scan")) ((set (PlanScans (FusionSource op)) (NoResults))) :ruleset source-fusion)

(rule ((NewPlan round p c a b next) (Chosen round family p c) (= retained (Retained round p c))
       (= domain (PlanDomain a)))
      ((PlanJoin next family a b retained)
       (set (PlanDomain next) domain)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (PlanMember a op)) ((PlanMember next op)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (PlanMember b op)) ((PlanMember next op)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= value (PlanRoute a op i))) ((set (PlanRoute next op i) value)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= value (PlanRoute b op i))) ((set (PlanRoute next op i) value)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= n (PlanInputCount a op))) ((set (PlanInputCount next op) n)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= n (PlanInputCount b op))) ((set (PlanInputCount next op) n)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= body (PlanCallback a op))) ((set (PlanCallback next op) body)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= body (PlanCallback b op))) ((set (PlanCallback next op) body)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= mapping (PlanMapping a op))) ((set (PlanMapping next op) mapping)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= mapping (PlanMapping b op))) ((set (PlanMapping next op) mapping)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (!= family 3) (!= family 5) (= x (PlanTotals a)) (= y (PlanTotals b)))
      ((set (PlanTotals next) (JoinResults x y))) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (= x (PlanScans a)) (= y (PlanScans b)))
      ((set (PlanScans next) (JoinResults x y))) :ruleset fusion-commit)
(rule ((PlanJoin next 1 a b retained) (= x (PlanArrays a)) (= y (PlanArrays b)))
      ((set (PlanArrays next) (JoinResults x y))) :ruleset fusion-commit)
(rule ((PlanJoin next 0 a b true) (= x (PlanArrays a)) (= y (PlanArrays b)))
      ((set (PlanArrays next) (JoinResults x y))) :ruleset fusion-commit)
(rule ((PlanJoin next 0 a b false) (= y (PlanArrays b))) ((set (PlanArrays next) y)) :ruleset fusion-commit)
(rule ((PlanJoin next 2 a b retained) (= y (PlanArrays b))) ((set (PlanArrays next) y)) :ruleset fusion-commit)
(rule ((PlanJoin next 6 a b retained) (= y (PlanArrays b))) ((set (PlanArrays next) y)) :ruleset fusion-commit)

; Expand result trees only for surviving plans, preserving sharing in the plan.
(ruleset fusion-signatures)
(function SelectedPlan (OperationKey) FusionPlan :no-merge)
(rule ((Current group plan) (PlanMember plan op)) ((set (SelectedPlan op) plan)) :ruleset fusion-signatures)
(function ResultCount (ResultTree) i64 :no-merge)
; Counts are needed while choosing fusion; result slots still expand only once.
(ruleset fusion-counts)
(rule ((= tree (NoResults))) ((set (ResultCount tree) 0)) :ruleset fusion-counts)
(rule ((= tree (OneResult value ty))) ((set (ResultCount tree) 1)) :ruleset fusion-counts)
(rule ((= tree (JoinResults left right)) (= a (ResultCount left)) (= b (ResultCount right)))
      ((set (ResultCount tree) (+ a b))) :ruleset fusion-counts)
(rule ((= tree (PlanArrays plan)) (= count (ResultCount tree)))
      ((set (ArrayOutputs plan) count)) :ruleset fusion-counts)
(relation ResultWalk (FusionPlan String ResultTree i64))
(relation PlanResult (FusionPlan String i64 SourceValue TypeKey))
(rule ((Current group plan) (= tree (PlanTotals plan))) ((ResultWalk plan "total" tree 0)) :ruleset fusion-signatures)
(rule ((Current group plan) (= tree (PlanArrays plan)) (= totals (PlanTotals plan)) (= n (ResultCount totals))) ((ResultWalk plan "array" tree n)) :ruleset fusion-signatures)
(rule ((Current group plan) (= tree (PlanScans plan))) ((ResultWalk plan "scan" tree 0)) :ruleset fusion-signatures)
(rule ((ResultWalk plan role (JoinResults left right) offset) (= n (ResultCount left)))
      ((ResultWalk plan role left offset) (ResultWalk plan role right (+ offset n))) :ruleset fusion-signatures)
(rule ((ResultWalk plan role (OneResult value ty) offset)) ((PlanResult plan role offset value ty)) :ruleset fusion-signatures)
(function PlanInternal (FusionPlan SourceValue) bool :merge (or old new))
(rule ((Current group plan) (= value (PlanRoute plan op i))) ((set (PlanInternal plan value) false)) :ruleset fusion-signatures)
(rule ((Current group plan) (= value (PlanRoute plan op i)) (SourceOrigin value producer) (PlanMember plan producer))
      ((set (PlanInternal plan value) true)) :ruleset fusion-signatures)
(rule ((Current group plan) (PlanMember plan op) (SourceOperand op child)) ((set (PlanInternal plan child) false)) :ruleset fusion-signatures)
(rule ((Current group plan) (PlanMember plan op) (SourceOperand op child) (SourceOrigin child producer) (PlanMember plan producer)) ((set (PlanInternal plan child) true)) :ruleset fusion-signatures)

; Masked reductions replace length invocations with one shared count slot.
(relation PlanCountObserver (FusionPlan OperationKey))
(rule ((NewPlan round p c a b next) (Chosen round family p c) (>= family 3) (<= family 5)
       (HasLengthObservers round false) (= totals (PlanTotals b)))
      ((set (PlanTotals next) totals)) :ruleset fusion-commit)
(rule ((NewPlan round p c a b next) (Chosen round family p c) (>= family 3) (<= family 5)
       (GroupUseFact p (To length (LengthUse))) (!= p length) (Current length observer)
       (= op (Owner observer)) (= value (SourceOperationValue op)) (= ty (SourceType value))
       (= totals (PlanTotals b)))
      ((set (PlanTotals next) (JoinResults totals (CountResult next ty)))
       (PlanCountObserver next op) (PlanMember next op)) :ruleset fusion-commit)
(rule ((PlanJoin next family a b retained) (>= family 3) (<= family 5))
      ((set (PlanArrays next) (NoResults))) :ruleset fusion-commit)
(rule ((= tree (CountResult owner ty))) ((set (ResultCount tree) 1)) :ruleset fusion-counts)
(relation PlanCountSlot (FusionPlan FusionPlan i64 TypeKey))
(rule ((ResultWalk plan "total" (CountResult owner ty) offset)) ((PlanCountSlot plan owner offset ty)) :ruleset fusion-signatures)
