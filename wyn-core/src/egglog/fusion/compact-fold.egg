; Discarded lanes contribute the supplied reduction identity. The consumer
; callback stays inside the predicate, preserving its traps and effects.
(function CompactMaskPattern (StatementId Params i64) Pattern :no-merge)
(function CompactMaskResults (StatementId i64) Results :no-merge)
(function CompactNeutralResults (Atoms i64) Results :no-merge)
(relation CompactMaskCompatible (Function ParallelBody Params i64))
(rule ((PreparedCompactConsumer program function first second next)
       (= next (ParallelBlock statements (vec-of (Fold (Total) (Reduction order neutral combine) values))))
       (= combine (FunctionBody params returns body))
       (= second (Let sid bindings certificates expression))
       (= (vec-length neutral) (vec-length values)) (= (vec-length neutral) (vec-length returns)))
      ((set (CompactMaskPattern sid params 0) (vec-of))
       (set (CompactMaskResults sid 0) (vec-of))
       (set (CompactNeutralResults neutral 0) (vec-of))
       (CompactMaskCompatible function next params 0)) :ruleset fusion-select)
(rule ((= pattern (CompactMaskPattern sid params i)) (= results (CompactMaskResults sid i))
       (< i (vec-length params)) (= (vec-get params i) (Parameter (BindValue state info) diet)))
      ((set (CompactMaskPattern sid params (+ i 1))
          (vec-push pattern (BindValue (ScheduleValue sid 91 i) info)))
       (set (CompactMaskResults sid (+ i 1))
          (vec-push results (Yield (vec-of) (ValueOperand (Var (ScheduleValue sid 91 i))))))) :ruleset fusion-select)
(rule ((= results (CompactNeutralResults neutral i)) (< i (vec-length neutral)))
      ((set (CompactNeutralResults neutral (+ i 1))
          (vec-push results (Yield (vec-of) (ValueOperand (vec-get neutral i)))))) :ruleset fusion-select)
; Scalar slots avoid conditional backing reconciliation for array-valued state.
(rule ((CompactMaskCompatible function next params i)
       (= next (ParallelBlock statements (vec-of (Fold (Total) (Reduction order neutral combine) values))))
       (< i (vec-length neutral)) (= (vec-get params i) (Parameter (BindValue state info) diet))
       (= slot (ValueSlot info)) (= slot (ScalarSlot element))
       (= bytes (ElementBytes element)) (> bytes (bigint 0))
       (= (vec-get values i) (Yield proofs operand)) (= slot (OperandSlot function operand)))
      ((CompactMaskCompatible function next params (+ i 1))) :ruleset fusion-select)

(rule ((PreparedCompactConsumer program function first second next)
       (= first (Let a pa ca (Parallel execution domain producer)))
       (= producer (ParallelBlock before (vec-of (Compact predicate payload))))
       (= second (Let b pb cb (Parallel execution consumer original)))
       (= next (ParallelBlock after (vec-of (Fold (Total) (Reduction order neutral combine) values))))
       (= combine (FunctionBody params returns reducer-body))
       (= size (vec-length neutral)) (CompactMaskCompatible function next params size)
       (= mask-pattern (CompactMaskPattern b params size))
       (= masked (CompactMaskResults b size)) (= fallback (CompactNeutralResults neutral size))
       (= free (set-diff (NamesParallelBody next) (BindersParallelBody next)))
       (= (set-intersect free (BindersDomain consumer)) (set-empty))
       (= (set-intersect (BindersPattern pa) (set-union free (NamesCertificates cb))) (set-empty))
       (CheckStatement context a pa (Parallel execution domain producer) available)
       (= allowed (set-union available (set-union (BindersDomain domain) (BindersParallelBody producer))))
       (= (set-diff (set-union free (NamesCertificates cb)) allowed) (set-empty)))
      ((let statement (Let (ScheduleStatement b 91 0) mask-pattern (vec-of)
          (If predicate returns (Block after values) (Block (vec-of) fallback))))
       (let fused (ParallelBlock (vec-of statement)
          (vec-of (Fold (Total) (Reduction order neutral combine) masked))))
       (RenamedPair program function first second fused)
       (set (HasForwardedLoads first fused domain) true)) :ruleset fusion-select)
