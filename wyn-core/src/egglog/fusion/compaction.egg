; One contraction replaces actual statements, including their memory bindings.
; Adjacency preserves intervening effects. Scheduling may expose further pairs.
; A total pointwise map can run before packing. A packed ordinal cannot.
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStms (FunctionRoot function) statements) (AdjacentStatements statements first next)
       (= first (Let id (vec-of (BindValue array info)) certs
          (Parallel execution domain (ParallelBlock body (vec-of (Compact predicate values)))))))
      ((CompactConsumerPath program function statements first next)) :ruleset fusion-index)
(rule ((CompactConsumerPath program function statements first middle)
       (= middle (Let mid pattern proofs expression))
       (TotalScalarForm expression)
       (= (EffectsStm function middle) (set-empty))
       (AdjacentStatements statements middle next))
      ((CompactConsumerPath program function statements first next)) :ruleset fusion-index)
(rule ((CompactConsumerPath program function sequence first second)
       (= first (Let id (vec-of (BindValue array info)) certs
          (Parallel execution domain (ParallelBlock body (vec-of (Compact predicate values))))))
       (= second (Let sid pattern proofs (Parallel execution consumer
          (ParallelBlock statements clauses))))
       (= (vec-length clauses) 1)
       (= consumer (IterationSpace flat (vec-of (DenseAxis index count))))
       (CountLength function count array))
      ((CompactConsumerPair program function first second)
       (set (CompactConsumerReads first (ParallelBlock statements clauses)) (set-empty))) :ruleset fusion-forward)
(rule ((CompactConsumerPair program function first second)
       (= first (Let id (vec-of (BindValue array info)) certs
          (Parallel execution domain (ParallelBlock body
              (vec-of (Compact predicate (vec-of (Yield proofs value))))))))
       (= second (Let sid pattern certificates (Parallel execution consumer next)))
       (= consumer (IterationSpace flat (vec-of (DenseAxis index count))))
       (ContainsStm (ParallelRoot next) (Let load output checks (Index array (vec-of (Var index))))))
      ((set (CompactConsumerReads first next) (set-of
          (ReplaceStatement load (Let load output (vec-append checks proofs) (Use value)))))) :ruleset fusion-forward)
(rule ((CompactConsumerPair program function first second)
       (= second (Let id pattern certs (Parallel execution domain body)))
       (= edits (CompactConsumerReads first body)))
      ((ReplacementMapDemand edits)) :ruleset fusion-select)
(rule ((CompactConsumerPair program function first second)
       (= second (Let id pattern certs (Parallel execution domain body)))
       (= edits (CompactConsumerReads first body)) (= map (ReplacementMap edits)))
      ((RenameParallelBodyDemand (Rename (map-empty) (map-empty) (map-empty) (map-empty) map) body)) :ruleset fusion-select)
(rule ((CompactConsumerPair program function first second)
       (= second (Let id pattern certs (Parallel execution domain body)))
       (= edits (CompactConsumerReads first body)) (= map (ReplacementMap edits))
       (= next (RenameParallelBody (Rename (map-empty) (map-empty) (map-empty) (map-empty) map) body)))
      ((PreparedCompactConsumer program function first second next)
       (EffectsStmDemand function (Let id pattern certs (Parallel execution domain next)))) :ruleset fusion-select)
(rule ((PreparedCompactConsumer program function first second next)
       (= first (Let a pa ca (Parallel execution domain producer)))
       (= producer (ParallelBlock before (vec-of (Compact predicate values))))
       (= second (Let b pb cb (Parallel execution consumer original)))
       (= next (ParallelBlock after (vec-of (Collect results))))
       (= free (set-diff (NamesParallelBody next) (BindersParallelBody next)))
       (= (set-intersect free (BindersDomain consumer)) (set-empty))
       (= (set-intersect (BindersPattern pa) (set-union free (NamesCertificates cb))) (set-empty))
       (CheckStatement context a pa (Parallel execution domain producer) available)
       (= allowed (set-union available (set-union (BindersDomain domain) (BindersParallelBody producer))))
       (= (set-diff (set-union free (NamesCertificates cb)) allowed) (set-empty))
       (= (EffectsStm function (Let b pb cb (Parallel execution consumer next))) (set-empty)))
      ((set (PendingRewrite "fusion" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert (map-empty) a (vec-of
                  (Let a (vec-append pa pb) (vec-append ca cb)
                      (Parallel execution domain (ParallelBlock (vec-append before after)
                          (vec-of (Compact predicate values) (Compact predicate results))))))) b (vec-of)))))
       (RewriteDemand "fusion" program)) :ruleset fusion-candidates)
