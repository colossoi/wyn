; Mutable fusion groups are distinct from immutable operation and plan IDs.
; Union redirects direct graph edges and use sets together.
(datatype FusionGroup (Group OperationKey))
; Each planning round selects one contraction, giving its immutable plan an ID.
(datatype FusionPlan (FusionSource OperationKey) (Joined i64))
; Captures and neutrals are ordinary uses; lengths carry additional proofs
; that fusion must distinguish from input streams.
(datatype OperandRole (Input) (Other) (LengthUse))
(datatype GroupUse (To FusionGroup OperandRole) (Returned))
(datatype OriginalUse (UseAt OperationKey OperandRole) (Observed))
(sort GroupUses (Set OriginalUse))
(function GroupInternalUseMask (FusionGroup) GroupUses :merge (set-union old new))
(function InputUses (FusionGroup) GroupUses :merge (set-union old new))
(datatype InputSite (Direct OperationKey) (External i64))
(sort InputSites (Set InputSite))
(sort Domain)
(constructor SourceDomain (OperationKey) Domain)
(relation Current (FusionGroup FusionPlan))
(function Owner (FusionPlan) OperationKey :no-merge)
(function PlanScope (FusionPlan) RegionKey :no-merge)
; Eligibility uses output presence and counts; composition records result slots.
(function HasScans (FusionPlan) bool :no-merge)
(function HasReductions (FusionPlan) bool :no-merge)
(function ArrayOutputs (FusionPlan) i64 :no-merge)
(function PrePure (FusionPlan) bool :merge (and old new))
(function PostPure (FusionPlan) bool :merge (and old new))
(function IterationDomain (FusionPlan) Domain :no-merge)
(relation ScremaPlan (FusionPlan))
(relation FilterPlan (FusionPlan))
(relation ElementPlan (FusionPlan))
(relation SafePlan (FusionPlan))
(relation ReadOnlyScremaPlan (FusionPlan))
(relation ReadOnlyFilterPlan (FusionPlan))
(relation FilterPostMapCompatible (i64 FusionGroup FusionGroup))
(relation Member (FusionGroup OperationKey))
(function DirectInputs (FusionGroup) InputSites :merge (set-union old new))
(relation GroupBefore (FusionGroup FusionGroup))
(relation GroupEdge (FusionGroup FusionGroup))
(relation PlanningRound (i64))
(function GroupPath (i64 FusionGroup FusionGroup) bool :merge (or old new))
(function OrderIntermediate (i64 FusionGroup FusionGroup) bool :merge (or old new))
(relation GroupReach (i64 FusionGroup FusionGroup))
(relation OrderWalk (i64 FusionGroup FusionGroup FusionGroup bool))
(function GroupUsesOf (FusionGroup) GroupUses :merge (set-union old new))
(function GroupLengths (FusionGroup) GroupUses :merge (set-union old new))
(function GroupDirectLengthUses (FusionGroup) GroupUses :merge (set-union old new))
(function GroupInputs (FusionGroup) InputSites :merge (set-union old new))
(function InternalInputs (FusionGroup) InputSites :merge (set-union old new))
(relation InputFact (FusionGroup InputSite))
(function StreamBlocked (FusionGroup FusionGroup) bool :merge (or old new))
(relation WholeStreamUse (FusionGroup FusionGroup))
(function BarrierBlocked (FusionGroup FusionGroup) bool :merge (or old new))
(relation SourceScanDependency (OperationKey OperationKey))
(relation GroupUseFact (FusionGroup GroupUse))
(constructor DomainValue (i64) Domain)
(constructor FixedDomain (i64) Domain)
(relation RelevantPair (FusionGroup FusionGroup))
; Only dependencies of the accumulators execute before the output phase.
(function PlanEarly (FusionPlan OperationKey) bool :merge (or old new))
(function LateFusionBlocked (FusionPlan FusionPlan) bool :merge (or old new))
(relation PlanLateTotals (FusionPlan))
(relation PlanMember (FusionPlan OperationKey))

; Selection priority is policy; transformations themselves are typed operations.
(datatype FusionMode (StreamFuse) (ZipFuse) (OutputFuse) (MaskFuse) (CountFuse) (PackFuse))
(function FusionPriority (FusionMode) i64 :no-merge)
(function FusionStrategy (i64) FusionMode :no-merge)
(relation StandardFusion (FusionMode))
(relation MaskedFusion (FusionMode))
(set (FusionPriority (StreamFuse)) 0) (set (FusionStrategy 0) (StreamFuse))
(set (FusionPriority (ZipFuse)) 1) (set (FusionStrategy 1) (ZipFuse))
(set (FusionPriority (OutputFuse)) 2) (set (FusionStrategy 2) (OutputFuse))
(set (FusionPriority (MaskFuse)) 3) (set (FusionStrategy 3) (MaskFuse))
(set (FusionPriority (CountFuse)) 5) (set (FusionStrategy 5) (CountFuse))
(set (FusionPriority (PackFuse)) 6) (set (FusionStrategy 6) (PackFuse))
(StandardFusion (StreamFuse))
(StandardFusion (ZipFuse))
(StandardFusion (OutputFuse))
(MaskedFusion (MaskFuse))
(MaskedFusion (CountFuse))
