; All analyses are keyed by immutable syntax. Only the program root changes.
(relation FusionPair (Program Function Stm Stm))
(relation MatchDomainAt (Domain Domain i64 ValueNameRenaming))
(function DomainRenaming (Domain Domain) Renaming :no-merge)
(function ForwardedPrefix (ParallelResults i64) Results :no-merge)
(function ForwardedResults (ParallelResults) Results :no-merge)
(relation ForwardAt (Pattern Results ParallelBody Indices i64))
(function ForwardLoads (Pattern Results ParallelBody Indices) StatementEdits :merge (set-union old new))
(relation FusedBodies (Function Stm Stm ParallelBody ParallelBody))
(ruleset fusion-index)
(ruleset fusion-domains)
(ruleset fusion-forward)
(ruleset fusion-candidates)
(ruleset fusion-select)
(function PointwiseResults (ParallelResults) bool :merge (and old new))
(function FusionLoads (Stm ParallelBody Domain) StatementEdits :no-merge)
(relation RenamedPair (Program Function Stm Stm ParallelBody))
(relation PreparedPair (Program Function Stm Stm Stm))
(relation FusionRegion (Exp))
(relation AccumulatorFusion (Program Function Stm Stm))
(ruleset fusion-scopes)
(relation ScopeFusion (Program Function Stm Stm Renaming))
