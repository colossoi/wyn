; Mutable fusion groups are distinct from immutable operation and plan IDs.
; Union redirects graph edges, use sets, and dependency closure together.
(datatype FusionGroup (Group OperationKey))
; Each planning round selects one contraction, giving its immutable plan an ID.
(datatype FusionPlan (Source OperationKey) (Joined i64))
(sort OperationSet (Set OperationKey))
; Captures and neutrals are ordinary uses; indexed arguments and lengths carry
; additional proofs that fusion must distinguish from input streams.
(datatype OperandRole (Input) (Other) (Argument) (Length))
(datatype GroupUse (To FusionGroup OperandRole) (Outside OperationKey OperandRole) (Returned))
(datatype OriginalUse (At OperationKey OperandRole) (Observed))
(sort GroupUses (Set OriginalUse))
(function SelfUses (FusionGroup) GroupUses :merge (set-union old new))
(function InputUses (FusionGroup) GroupUses :merge (set-union old new))
(datatype InputSite (Direct OperationKey) (Indirect OperationKey i64) (External i64))
(sort InputSites (Set InputSite))
(sort Numbers (Set i64))
(datatype SliceChain (WholeInput) (InputSlice i64 i64 SliceChain))
(sort SliceChains (Set SliceChain))
(sort Domain)
(constructor SourceDomain (OperationKey) Domain)
(relation Current (FusionGroup FusionPlan))
(function Owner (FusionPlan) OperationKey :no-merge)
(function Scope (FusionPlan) RegionKey :no-merge)
; Eligibility depends on presence; result slots remain in the Rust sidecar.
(function HasScans (FusionPlan) bool :no-merge)
(function HasReductions (FusionPlan) bool :no-merge)
(function HasArrayOutputs (FusionPlan) bool :no-merge)
(function ArrayOutputs (FusionPlan) i64 :no-merge)
(function PrePure (FusionPlan) bool :no-merge)
(function PostPure (FusionPlan) bool :no-merge)
(function PredicatePure (FusionPlan) bool :no-merge)
(function IterationDomain (FusionPlan) Domain :no-merge)
(function DemandLimit (FusionPlan) i64 :no-merge)
(relation ScremaPlan (FusionPlan))
(relation FilterPlan (FusionPlan))
(relation ElementPlan (FusionPlan))
(relation SafePlan (FusionPlan))
(relation MovablePlan (FusionPlan))
; Scalar helper purity is proved from local region/call edges. It authorizes
; post-map attachment without changing the general motion/effect classification.
(sort ScalarRegions (Set RegionKey))
(function ScalarRegionMembers (RegionKey) OperationSet :no-merge)
(function PureRegionMembers (RegionKey) OperationSet :merge (set-union old new))
(function ScalarCallees (OperationKey) ScalarRegions :no-merge)
(function PureCallees (OperationKey) ScalarRegions :merge (set-union old new))
(relation ScalarMember (RegionKey OperationKey))
(relation ScalarCall (OperationKey RegionKey))
(relation PureScalarRegion (RegionKey))
(relation PureScalarOperation (OperationKey))
(relation PostMapPlan (FusionPlan))
(relation Member (FusionGroup OperationKey))
(function Members (FusionGroup) OperationSet :merge (set-union old new))
(function DirectInputs (FusionGroup) InputSites :merge (set-union old new))
(relation OriginalUseFact (FusionGroup OperationKey OperandRole))
(relation GroupBefore (FusionGroup FusionGroup))
(relation DataBefore (FusionGroup FusionGroup))
(relation GroupEdge (FusionGroup FusionGroup))
(function GroupUsesOf (FusionGroup) GroupUses :merge (set-union old new))
(function GroupLengths (FusionGroup) GroupUses :merge (set-union old new))
(function ValidLengths (FusionGroup) GroupUses :merge (set-union old new))
(function LengthTypes (FusionGroup) Numbers :merge (set-union old new))
(function GroupInputs (FusionGroup) InputSites :merge (set-union old new))
(function InternalInputs (FusionGroup) InputSites :merge (set-union old new))
(relation InputFact (FusionGroup InputSite))
(function StreamBlocked (FusionGroup FusionGroup) bool :merge (or old new))
(function StreamSlices (FusionGroup FusionGroup) SliceChains :merge (set-union old new))
(function MemoryBlocked (FusionGroup FusionGroup) bool :merge (or old new))
(function BarrierBlocked (FusionGroup FusionGroup) bool :merge (or old new))
(relation ScanFeeds (OperationKey OperationKey))
(function HasGroupPath (FusionGroup FusionGroup) bool :merge (or old new))
(function GroupBetween (FusionGroup FusionGroup) OperationSet :merge (set-union old new))
(function IndexedUses (FusionGroup) GroupUses :merge (set-union old new))
(function IndexAddressUses (FusionGroup) GroupUses :merge (set-union old new))
(relation GroupUseFact (FusionGroup GroupUse))

; Local source metadata is inserted once; joins derive compatibility.
(sort DomainValues (Vec i64))
(sort DomainList (Vec Domain))
(constructor DomainValue (i64) Domain)
(constructor DomainLiteral (DomainValues) Domain)
(constructor DomainRange (i64 i64 i64) Domain)
(constructor DomainZip (DomainList) Domain)
(constructor FixedDomain (i64) Domain)
(relation ReadResource (FusionGroup i64))
(relation WriteResource (FusionGroup i64))
(relation EffectMember (i64 FusionGroup))
(relation EffectWait (FusionGroup i64))
(relation RelevantPair (FusionGroup FusionGroup))

; Field-sensitive dependency structure, without executable scalar expressions.
(sort Dependency)
(sort DependencyList)
(constructor NoDependency () Dependency)
(constructor ScanDependency (OperationKey) Dependency)
(constructor OutputDependency (OperationKey i64) Dependency)
(constructor TupleDependency (DependencyList) Dependency)
(constructor AllDependencies (DependencyList) Dependency)
(constructor FieldDependency (Dependency i64) Dependency)
(constructor ChoiceDependency (Dependency Dependency Dependency) Dependency)
(constructor DependencyAt (DependencyList i64) Dependency)
(constructor NoDependencies () DependencyList)
(constructor MoreDependencies (Dependency DependencyList) DependencyList)
(relation DependencyScan (Dependency OperationKey))
(relation DependencyListScan (DependencyList OperationKey))
(relation CollectiveDependency (OperationKey Dependency))
