; All analyses are keyed by immutable syntax. Only the program root changes.
(relation FusionPair (Program Function Stm Stm))
(relation CompactConsumerPath (Program Function Stms Stm Stm))
(relation CompactConsumerPair (Program Function Stm Stm))
(function CompactConsumerReads (Stm ParallelBody) StatementEdits :merge (set-union old new))
(relation PreparedCompactConsumer (Program Function Stm Stm ParallelBody))
(function NestedParallelBody (ParallelBody) bool :merge (or old new))
(function CollectiveParallelBody (ParallelBody) bool :merge (or old new))
(relation MatchDomainAt (Function Domain Domain i64 ValueNameRenaming))
(relation MatchingExtent (Function IndexExp IndexExp))
(function DomainRenaming (Function Domain Domain) Renaming :no-merge)
(function ForwardedPrefix (ParallelResults i64) Results :no-merge)
(function ForwardedResults (ParallelResults) Results :no-merge)
(relation FusedBodies (Function Stm Stm ParallelBody ParallelBody))
(ruleset fusion-index)
(ruleset fusion-domains)
(ruleset fusion-forward)
(ruleset fusion-candidates)
(ruleset fusion-select)
(function FusionIndices (Stm ParallelBody Domain) StatementEdits :merge (set-union old new))
(function HasForwardedLoads (Stm ParallelBody Domain) bool :merge (or old new))
(relation RenamedPair (Program Function Stm Stm ParallelBody))
(relation PreparedPair (Program Function Stm Stm Stm))
(relation FusionCommutes (Function Stm Stm))
(relation FusionRegion (Exp))
(relation AccumulatorFusion (Program Function Stm Stm))
(ruleset fusion-scopes)
(relation ScopeFusion (Program Function Stm Stm Renaming))
(relation ScopeFusionPath (Program Function Stms Stm Stm))
