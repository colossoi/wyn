; One contraction replaces actual statements, including their memory bindings.
; Adjacency preserves intervening effects. Scheduling may expose further pairs.
(rule ((= expression (Parallel execution domain body))) ((FusionRegion expression)) :ruleset fusion-index)
(rule ((= expression (WithAcc inputs body))) ((FusionRegion expression)) :ruleset fusion-index)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStms (FunctionRoot function) statements) (AdjacentStatements statements first second)
       (= first (Let a pa ca (Parallel execution da ba)))
       (= second (Let b pb cb (Parallel execution db bb))))
      ((FusionPair program function first second) (EffectContext function)) :ruleset fusion-index)
(rule ((FusionPair program function first second)
       (= first (Let a pa ca (Parallel execution da ba)))
       (= second (Let b pb cb (Parallel execution db bb))) (= env (DomainRenaming da db)))
      ((RenameParallelBodyDemand env bb)) :ruleset fusion-domains)
(rule ((FusionPair program function first second)
       (= first (Let a pa ca (Parallel execution da ba)))
       (= second (Let b pb cb (Parallel execution db bb))) (= env (DomainRenaming da db))
       (= body (RenameParallelBody env bb)))
      ((RenamedPair program function first second body)) :ruleset fusion-domains)
(rule ((= body (ParallelBlock statements results)))
      ((set (PointwiseResults results) true)) :ruleset fusion-forward)
(rule ((WalkParallelResults results i) (< i (vec-length results)) (= (vec-get results i) (Fold kind reducer values)))
      ((set (PointwiseResults results) false)) :ruleset fusion-forward)
(rule ((RenamedPair program function first second body)
       (= first (Let a pattern certs (Parallel execution domain (ParallelBlock statements results))))
       (= values (ForwardedResults results)) (= indices (DomainIndices domain)))
      ((ForwardAt pattern values body indices 0)) :ruleset fusion-forward)
(rule ((RenamedPair program function first second body)
       (= first (Let a pattern certs (Parallel execution domain (ParallelBlock statements results))))
       (= (PointwiseResults results) false))
      ((set (FusionLoads first body domain) (set-empty))) :ruleset fusion-select)
(rule ((RenamedPair program function first second body)
       (= first (Let a pattern certs (Parallel execution domain (ParallelBlock statements results))))
       (= values (ForwardedResults results)) (= indices (DomainIndices domain))
       (= replacements (ForwardLoads pattern values body indices)))
      ((set (FusionLoads first body domain) replacements)) :ruleset fusion-select)
(rule ((RenamedPair program function first second body)
       (= first (Let a pa ca (Parallel execution domain ba)))
       (= loads (FusionLoads first body domain)))
      ((ReplacementMapDemand loads)) :ruleset fusion-select)
(rule ((RenamedPair program function first second body)
       (= first (Let a pa ca (Parallel execution domain ba)))
       (= loads (FusionLoads first body domain)) (= edits (ReplacementMap loads)))
      ((RenameParallelBodyDemand (Rename (map-empty) (map-empty) (map-empty) (map-empty) edits) body)) :ruleset fusion-select)
(rule ((RenamedPair program function first second body)
       (= first (Let a pa ca (Parallel execution domain ba)))
       (= second (Let b pb cb (Parallel execution db bb)))
       (= loads (FusionLoads first body domain)) (= edits (ReplacementMap loads))
       (= next (RenameParallelBody (Rename (map-empty) (map-empty) (map-empty) (map-empty) edits) body)))
      ((PreparedPair program function first second (Let b pb cb (Parallel execution domain next)))) :ruleset fusion-select)
(rule ((PreparedPair program function first second rewritten))
      ((EffectsStmDemand function rewritten)) :ruleset memory-effects)
(rule ((PreparedPair program function first second rewritten)
       (= a (EffectsStm function first)) (= b (EffectsStm function rewritten)))
      ((CompareEffects a b)) :ruleset memory-effects)

; Elimination of indexed reads must leave no uses of unfinished array/reduction
; results. This also rejects non-pointwise dependencies and total-to-lane edges.
(rule ((PreparedPair program function first second rewritten)
       (= first (Let a pa ca (Parallel execution domain (ParallelBlock sa ra))))
       (= rewritten (Let b pb cb (Parallel execution domain body)))
       (= body (ParallelBlock sb rb))
       (= free (set-diff (NamesParallelBody body) (BindersParallelBody body)))
       (= (set-intersect (BindersPattern pa) (set-union free (NamesCertificates cb))) (set-empty))
       (= ea (EffectsStm function first)) (= eb (EffectsStm function rewritten)) (= (Commutes ea eb) true))
      ((set (PendingRewrite "fusion" program) (set-of
         (Rename (map-empty) (map-empty) (map-empty) (map-empty)
           (map-insert (map-insert (map-empty) a
               (vec-of (Let a (vec-append pa pb) (vec-append ca cb)
                 (Parallel execution domain (ParallelBlock (vec-append sa sb) (vec-append ra rb))))))
             b (vec-of))))) (RewriteDemand "fusion" program)) :ruleset fusion-candidates)
(rule ((WalkParallelResults results i) (< i (vec-length results)) (= (vec-get results i) (Concatenate mode source)))
      ((set (PointwiseResults results) false)) :ruleset fusion-forward)

; Merge independent capability scopes before fusing their ordinary bodies.
; Token-only exits need no permutation of existential value-result witnesses.
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStms (FunctionRoot function) statements) (AdjacentStatements statements first second)
       (= first (Let a pa ca (WithAcc ia (FunctionBody xa ta ba))))
       (= second (Let b pb cb (WithAcc ib (FunctionBody xb tb bb))))
       (= (vec-length xa) (vec-length ia)) (= (vec-length ta) (vec-length ia))
       (= (vec-length xb) (vec-length ib)) (= (vec-length tb) (vec-length ib))
       (= (set-intersect (BindersPattern pa) (NamesStm second)) (set-empty))
       (= ea (EffectsLambda function (FunctionBody xa ta ba)))
       (= eb (EffectsLambda function (FunctionBody xb tb bb))))
      ((AccumulatorFusion program function first second)
       (CompareEffects (set-remove ea (OrderedEffect)) (set-remove eb (OrderedEffect)))) :ruleset memory-effects)
(rule ((AccumulatorFusion program function first second)
       (= first (Let a pa ca (WithAcc ia (FunctionBody xa ta (Block sa ra)))))
       (= second (Let b pb cb (WithAcc ib (FunctionBody xb tb (Block sb rb)))))
       (= ea (EffectsLambda function (FunctionBody xa ta (Block sa ra))))
       (= eb (EffectsLambda function (FunctionBody xb tb (Block sb rb))))
       (= (Commutes (set-remove ea (OrderedEffect)) (set-remove eb (OrderedEffect))) true))
      ((set (PendingRewrite "fusion" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert (map-empty) a (vec-of
                  (Let a (vec-append pa pb) (vec-append ca cb)
                      (WithAcc (vec-append ia ib) (FunctionBody (vec-append xa xb) (vec-append ta tb)
                          (Block (vec-append sa sb) (vec-append ra rb))))))) b (vec-of)))))
       (RewriteDemand "fusion" program)) :ruleset fusion-candidates)

; Move an unshared producer into an accumulator scope before fusing its body.
; The producer still runs once, before traversal, including an empty traversal.
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStms (FunctionRoot function) statements) (AdjacentStatements statements first second)
       (= first (Let a pa ca (Parallel execution domain producer)))
       (= second (Let b pb cb (WithAcc inputs (FunctionBody params returns body))))
       (= effects (EffectsStm function first)) (ReadOnlyEffects effects)
       (= boundary (set-union (NamesAccInputs inputs) (set-union (NamesParams params)
           (set-union (NamesReturnInfos returns) (set-union (NamesPattern pb) (NamesCertificates cb))))))
       (= (set-intersect (BindersPattern pa) boundary) (set-empty)))
      ((let outside (Rename (map-empty) (map-empty) (map-empty) (map-empty)
          (map-insert (map-insert (map-empty) a (vec-of)) b (vec-of))))
       (ScopeFusion program function first second outside) (RenameFunctionDemand outside function)) :ruleset fusion-scopes)
(rule ((ScopeFusion program function first second outside) (CurrentProgram program)
       (= first (Let a pa ca expression))
       (= second (Let b pb cb (WithAcc inputs (FunctionBody params returns (Block statements results)))))
       (= rest (RenameFunction outside function))
       (= (set-intersect (BindersPattern pa) (NamesFunction rest)) (set-empty)))
      ((set (PendingRewrite "fusion" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert (map-empty) a (vec-of)) b (vec-of
                  (Let b pb cb (WithAcc inputs (FunctionBody params returns
                      (Block (vec-append (vec-of first) statements) results)))))))))
       (RewriteDemand "fusion" program)) :ruleset fusion-candidates)
