; Greedy fusion on the use graph of immutable parallel bodies.
; Speculation is proved over phase dependencies before selecting a contraction.
(ruleset fusion-dependencies)
(rule ((PlanMember plan op)) ((set (PlanEarly plan op) false)) :ruleset fusion-dependencies)
(rule ((PlanMember plan op) (= (SourceOperation op) (OperationInfo r kind))
       (!= kind "map") (!= kind "scatter"))
      ((set (PlanEarly plan op) true)) :ruleset fusion-dependencies)
(rule ((= (PlanEarly plan after) true) (SourceDepends after before role) (PlanMember plan before))
      ((set (PlanEarly plan before) true)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (RelevantPair p c))
      ((set (LateFusionBlocked a b) false)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (PlanMember a before) (PlanMember b after)
       (SourceDepends after before role) (= (PlanEarly b after) true))
      ((set (LateFusionBlocked a b) true)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (PlanMember a before) (PlanMember b after)
       (SourceDepends after before role) (= (SourceOperation before) (OperationInfo r kind))
       (!= kind "reduce"))
      ((set (LateFusionBlocked a b) true)) :ruleset fusion-dependencies)
(rule ((SafePlan plan)) ((ReadOnlyPlan plan)) :ruleset fusion-dependencies)
; Initialize only connected operations or operations sharing an iteration domain.
(rule ((GroupUseFact p (To c role))) ((RelevantPair p c) (RelevantPair c p)) :ruleset fusion-dependencies)
(rule ((GroupEdge p c)) ((RelevantPair p c) (RelevantPair c p)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (= (PlanScope a) (PlanScope b)) (= (IterationDomain a) (IterationDomain b)))
      ((RelevantPair p c)) :ruleset fusion-dependencies)
(rule ((RelevantPair p c))
      ((set (StreamBlocked p c) false)
       (set (BarrierBlocked p c) false)) :ruleset fusion-dependencies)
; Aggregate stable original identities; only relation keys are merged groups.
; Subtract current membership when asking which uses remain external.
(rule ((Member g op))
      ((set (InputUses g) (set-of (UseAt op (Input))))
       (set (DirectInputs g) (set-of (Direct op)))
       (set (GroupInternalUseMask g) (set-of (UseAt op (Input)) (UseAt op (Other)) (UseAt op (LengthUse))))) :ruleset fusion-dependencies)
(rule ((GroupUseFact g (Returned)))
      ((set (GroupUsesOf g) (set-of (Observed)))) :ruleset fusion-dependencies)
(rule ((GroupUseFact p (To c role))
       (!= role (Input)))
      ((set (StreamBlocked p c) true)) :ruleset fusion-dependencies)
(rule ((InputFact g site))
      ((set (GroupInputs g) (set-of site))) :ruleset fusion-dependencies)
(rule ((InputFact g (Direct op)) (Member g op))
      ((set (InternalInputs g) (set-of (Direct op)))) :ruleset fusion-dependencies)
(rule ((GroupEdge a b)) ((GroupBefore a b)) :ruleset fusion-dependencies)
(rule ((Member p scan)
       (Member c collective)
       (SourceScanDependency scan collective))
      ((set (BarrierBlocked p c) true)) :ruleset fusion-dependencies)

; Each round reads the current quotient graph. Candidate facts carry the round
; because absence of another use/path is not a monotone property of a plan.
(ruleset fusion-candidates)
(rule ((PlanMember plan before) (PlanMember plan after) (SourceDepends after before role)
       (= (SourceOperation before) (OperationInfo r "reduce")) (= (PlanEarly plan after) false))
      ((PlanLateTotals plan)) :ruleset fusion-candidates)

(relation JoinCandidate (i64 i64 FusionGroup FusionGroup bool))
(relation JoinedCandidate (i64 i64 FusionGroup FusionGroup bool DomainShape ResultTree ResultTree ResultTree ResultTree OutputAction))
(relation MaskCandidate (i64 i64 FusionGroup FusionGroup))
(relation PlanCandidate (i64 i64 FusionGroup FusionGroup Replacement))
(ruleset fusion-replacements)
(function MaskBindings (i64 FusionGroup) ResultBindings :merge (set-union old new))
(function MaskTotals (i64 FusionGroup) ResultTree :no-merge)

; Lexicographic minimum, without comparing every pair of candidates.
(function BestPriority (i64) i64 :merge (min old new))
(function BestRegion (i64 i64) i64 :merge (min old new))
(function BestProducer (i64 i64 i64) i64 :merge (min old new))
(function BestConsumer (i64 i64 i64 i64) i64 :merge (min old new))
(ruleset fusion-select)
(rule ((PlanCandidate n priority producer consumer replacement)
       (Current producer a) (Current consumer b)
       (= (PlanScope a) (RegionId r))
       (= (Owner a) (OperationId p)) (= (Owner b) (OperationId c)))
      ((set (BestPriority n) priority)
       (set (BestRegion n priority) r)
       (set (BestProducer n priority r) p)
       (set (BestConsumer n priority r p) c)) :ruleset fusion-select)
(relation Chosen (i64 FusionGroup FusionGroup Replacement))
(ruleset fusion-choose)
(rule ((PlanningRound n)
       (= priority (BestPriority n)) (= r (BestRegion n priority))
       (= p (BestProducer n priority r)) (= c (BestConsumer n priority r p))
       (PlanCandidate n priority (Group (OperationId p)) (Group (OperationId c)) replacement))
      ((Chosen n (Group (OperationId p)) (Group (OperationId c)) replacement)) :ruleset fusion-choose)
(relation Pair (i64 FusionGroup FusionPlan FusionGroup FusionPlan))
(rule ((PlanningRound n)
       (RelevantPair p c)
       (Current p a)
       (Current c b)
       (!= p c)
       (= (PlanScope a) (PlanScope b)))
      ((Pair n p a c b)) :ruleset fusion-candidates)
(rule ((Pair n p a c b) (FilterPlan a) (SafePlan b) (ScremaPlan b))
      ((FilterPostMapCompatible n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b) (FilterPlan a) (ReadOnlyPlan a) (ScremaPlan b) (ReadOnlyPlan b))
      ((FilterPostMapCompatible n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b) (FilterPlan a) (ReadOnlyPlan a) (FilterPlan b) (ReadOnlyPlan b) (= (HasScans a) false)
       (= (set-diff (GroupLengths p) (GroupInternalUseMask p)) (set-empty)))
      ((FilterPostMapCompatible n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b) (FilterPlan a) (SafePlan a) (ElementPlan b) (= (HasScans a) false)
       (= (ArrayOutputs b) 0) (= (set-diff (GroupLengths p) (GroupInternalUseMask p)) (set-empty)))
      ((FilterPostMapCompatible n p c)) :ruleset fusion-candidates)
; Every consumed stream comes from the producer; only direct length observers
; may remain outside the contraction. This proof is shared by all guarded uses.
(relation ExclusiveStream (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b)
       (> (set-length (set-diff (GroupInputs c) (InternalInputs c))) 0)
       (= (set-diff (set-diff (GroupInputs c) (InternalInputs c)) (DirectInputs p)) (set-empty))
       (= (set-diff (set-diff (GroupUsesOf p) (GroupInternalUseMask p)) (set-union (GroupLengths p) (InputUses c))) (set-empty))
       (= (OrderIntermediate n p c) false))
      ((ExclusiveStream n p c)) :ruleset fusion-candidates)
(relation ClearStream (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b)
       (= (StreamBlocked p c) false)
       (WholeStreamUse p c)
       (= (OrderIntermediate n p c) false))
      ((ClearStream n p c)) :ruleset fusion-candidates)
(function Retained (i64 FusionGroup FusionGroup) bool :no-merge)
(rule ((PlanningRound n)
       (Current p a))
      ((set (Retained n p p) false)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= v0 (GroupUsesOf p))
       (= v1 (GroupInternalUseMask p))
       (= v2 (GroupInternalUseMask c)))
      ((set (Retained n p c) (bool-> (set-length (set-diff v0 (set-union v1 v2))) 0))) :ruleset fusion-candidates)
(relation BarrierAllowed (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b)
       (= (HasScans a) false))
      ((BarrierAllowed n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= (HasScans b) false)
       (= (HasReductions b) false))
      ((BarrierAllowed n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= (BarrierBlocked p c) false)
       (= (PostPure a) true)
       (= (PrePure b) true))
      ((BarrierAllowed n p c)) :ruleset fusion-candidates)

; Stream compatible array outputs; scalar reductions remain visible outputs.
; Whole-domain streaming runs both callbacks once. Read-only callbacks may
; contain local collectives; ClearStream and BarrierAllowed preserve effect order.
(rule ((Pair n p a c b) (ScremaPlan a) (ScremaPlan b) (ReadOnlyPlan a) (ReadOnlyPlan b)
       (ClearStream n p c) (BarrierAllowed n p c) (= keep (Retained n p c)))
      ((JoinCandidate n 0 p c keep)) :ruleset fusion-candidates)
; Independent operations over one domain share a traversal. Ignore obsolete
; endpoint ordering after an in-place update becomes fresh; retain intervening barriers.
(rule ((Pair n p a c b)
       (ScremaPlan a)
       (ScremaPlan b)
       (SafePlan a)
       (SafePlan b)
       (= (IterationDomain a) (IterationDomain b))
       (= (GroupPath n p c) false) (= (GroupPath n c p) false)
       (= (OrderIntermediate n p c) false) (= (OrderIntermediate n c p) false))
      ((JoinCandidate n 1 p c true)) :ruleset fusion-candidates)
(relation ElementFusion (FusionPlan FusionPlan))
; A completed total may feed a scan's output callback. It must not feed its
; input, neutral, or combiner, nor cross an intervening operation/effect.
(rule ((Pair n p a c b) (ScremaPlan a) (ScremaPlan b) (ReadOnlyPlan a) (ReadOnlyPlan b)
       (= (HasScans a) false) (= (HasReductions a) true) (= (HasScans b) true)
       (= (IterationDomain a) (IterationDomain b)) (= (LateFusionBlocked a b) false)
       (= (GroupPath n c p) false)
       (= (OrderIntermediate n p c) false) (= (OrderIntermediate n c p) false))
      ((JoinCandidate n 1 p c true)) :ruleset fusion-candidates)
(relation OutputActionPlan (FusionPlan))
(rule ((Current p a) (= (HasScans a) true)) ((OutputActionPlan a)) :ruleset fusion-candidates)
(rule ((Current p a) (= (HasReductions a) false)) ((OutputActionPlan a)) :ruleset fusion-candidates)
(rule ((Pair n p a c b) (ElementPlan b) (= (HasScans a) false))
      ((ElementFusion a b)) :ruleset fusion-candidates)
(rule ((Pair n p a c b) (= (HasScans a) true)
       (= op (Owner b)) (= (SourceOperation op) (OperationInfo r "scatter"))
       (= destination (SourceDestination op)) (= (SourceScratchValue destination) true))
      ((ElementFusion a b)) :ruleset fusion-candidates)
; Completed reductions may be captured by the output callback, but array
; producers still require whole-stream inputs and early consumers cannot use totals.
(function OutputStreamBlocked (FusionPlan FusionPlan) bool :merge (or old new))
(rule ((Current p a) (Current c b) (RelevantPair p c)) ((set (OutputStreamBlocked a b) false)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (RelevantPair p c) (PlanMember a before) (PlanMember b after)
       (SourceDepends after before role) (!= role (Input))
       (= (SourceOperation before) (OperationInfo r kind)) (!= kind "reduce"))
      ((set (OutputStreamBlocked a b) true)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (RelevantPair p c) (PlanMember a before) (PlanMember b after)
       (SourceDepends after before role) (!= role (Input)) (= (PlanEarly b after) true))
      ((set (OutputStreamBlocked a b) true)) :ruleset fusion-dependencies)
(relation ClearOutputStream (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b) (= (OutputStreamBlocked a b) false)
       (WholeStreamUse p c) (= (OrderIntermediate n p c) false))
      ((ClearOutputStream n p c)) :ruleset fusion-candidates)
; An unobserved prefix can feed a fresh scatter destination in its output phase.
(rule ((Pair n p a c b) (ScremaPlan a) (ElementPlan b) (ReadOnlyPlan a)
       (ElementFusion a b) (OutputActionPlan a)
       (ClearOutputStream n p c)
       (= (set-diff (set-diff (GroupUsesOf p) (GroupInternalUseMask p)) (GroupInternalUseMask c)) (set-empty)))
      ((JoinCandidate n 2 p c false)) :ruleset fusion-candidates)

(relation MaskablePlan (i64 FusionGroup))
(rule ((PlanningRound n)
       (Current p a)
       (FilterPlan a) (= (HasScans a) false)
       (SafePlan a)
       (= (PrePure a) true)
       (= (PostPure a) true)
       (= (set-diff (GroupLengths p) (GroupInternalUseMask p)) (set-diff (GroupDirectLengthUses p) (GroupInternalUseMask p))))
      ((MaskablePlan n p)) :ruleset fusion-candidates)
; Mask reductions and share one count among all direct length observers.
(rule ((Pair n p a c b)
       (MaskablePlan n p)
       (ScremaPlan b)
       (SafePlan b)
       (= (HasScans b) false)
       (= (HasReductions b) true)
       (= (ArrayOutputs b) 0)
       (= (PrePure b) true)
       (ExclusiveStream n p c))
      ((MaskCandidate n 3 p c)) :ruleset fusion-candidates)
; A filter observed only through lengths becomes a count reduction.
(rule ((MaskablePlan n p)
       (> (set-length (set-diff (GroupLengths p) (GroupInternalUseMask p))) 0)
       (= (set-diff (GroupUsesOf p) (GroupInternalUseMask p)) (set-diff (GroupLengths p) (GroupInternalUseMask p))))
      ((MaskCandidate n 5 p p)) :ruleset fusion-candidates)
; Compose a guarded stream with a map, another selection, or an update.
; Reading callbacks retain their effect-order proof; updating consumers require
; a speculatable producer and no surviving compaction length.
(rule ((Pair n p a c b)
       (FilterPlan a)
       (FilterPostMapCompatible n p c)
       (= (HasReductions b) false)
       (<= (ArrayOutputs b) 1)
       (ClearStream n p c)
       (= (set-diff (GroupLengths p) (GroupInternalUseMask p)) (set-diff (GroupDirectLengthUses p) (GroupInternalUseMask p)))
       (ExclusiveStream n p c))
      ((JoinCandidate n 6 p c false)) :ruleset fusion-candidates)

(ruleset fusion-commit)
(relation NewPlan (i64 FusionGroup FusionGroup FusionPlan FusionPlan FusionPlan))
(rule ((Chosen n p c replacement)
       (Current p a)
       (Current c b))
      ((NewPlan n p c a b (Joined n))) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (= v0 (Owner b))
       (= v1 (PlanScope b)))
      ((set (Owner next) v0)
       (set (PlanScope next) v1)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next) (ElementPlan b) (= (HasScans a) false)
       (= action (PlanAction b)) (= (PlanBody next) (ParallelLoop domain totals scans arrays action)))
      ((ElementPlan next)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next) (ElementPlan a) (SafePlan b) (ScremaPlan b) (= (HasScans next) false)
       (= action (PlanAction a)) (= action (Pack op input))
       (= (PlanBody next) (ParallelLoop domain totals scans arrays action)))
      ((ElementPlan next)) :ruleset fusion-commit)

(rule ((NewPlan n p c a b next)
       (SafePlan a)
       (SafePlan b))
      ((SafePlan next)) :ruleset fusion-commit)

; Apply only after the new plan and its composition records exist.
(ruleset fusion-union)
(rule ((NewPlan n p c a b next))
      ((delete (Current p a))
       (delete (Current c b))
       (Current c next)
       (union p c)) :ruleset fusion-union)
(rule ((Chosen n p c (ReplaceBody body bindings)) (set-contains bindings (BindResult old value))
       (= op (SourceValueOperation old)) (Current group plan) (= (Owner plan) op) (!= group p) (!= group c))
      ((delete (Current group plan)) (union group c)) :ruleset fusion-union)

; Discard round-local proofs before evaluating the changed quotient graph.
(ruleset fusion-clear)
(rule ((Chosen n p c replacement))
      ((delete (PlanningRound n)) (PlanningRound (+ n 1))) :ruleset fusion-clear)
(rule ((Chosen n p c replacement))
      ((delete (Chosen n p c replacement))) :ruleset fusion-clear)
(rule ((NewPlan n p c a b next))
      ((delete (NewPlan n p c a b next))) :ruleset fusion-clear)
(ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (Pair n p a c b))
      ((delete (Pair n p a c b))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (PlanCandidate n priority p c candidate))
      ((delete (PlanCandidate n priority p c candidate))) :ruleset fusion-clear-candidates)
(rule ((Chosen n producer consumer replacement) (JoinCandidate n priority p c keep))
      ((delete (JoinCandidate n priority p c keep))) :ruleset fusion-clear-candidates)
(rule ((Chosen n producer consumer replacement) (JoinedCandidate n priority p c keep domain totals scans aa ba action))
      ((delete (JoinedCandidate n priority p c keep domain totals scans aa ba action))) :ruleset fusion-clear-candidates)
(rule ((Chosen n producer consumer replacement) (MaskCandidate n priority p c))
      ((delete (MaskCandidate n priority p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n producer consumer replacement) (= bindings (MaskBindings n p)))
      ((delete (MaskBindings n p))) :ruleset fusion-clear-candidates)
(rule ((Chosen n producer consumer replacement) (= totals (MaskTotals n p)))
      ((delete (MaskTotals n p))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (= v (Retained n p c)))
      ((delete (Retained n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n producer consumer replacement) (ExclusiveStream n p c))
      ((delete (ExclusiveStream n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (ClearStream n p c))
      ((delete (ClearStream n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (FilterPostMapCompatible n p c))
      ((delete (FilterPostMapCompatible n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (BarrierAllowed n p c))
      ((delete (BarrierAllowed n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-producer chosen-consumer replacement) (MaskablePlan n p))
      ((delete (MaskablePlan n p))) :ruleset fusion-clear-candidates)

(ruleset fusion-clear-paths)
(rule ((Chosen n p c replacement) (GroupReach n from to)) ((delete (GroupReach n from to))) :ruleset fusion-clear-paths)
(rule ((Chosen n p c replacement) (OrderWalk n from to node external)) ((delete (OrderWalk n from to node external))) :ruleset fusion-clear-paths)
(rule ((Chosen n p c replacement) (= result (GroupPath n from to))) ((delete (GroupPath n from to))) :ruleset fusion-clear-paths)
(rule ((Chosen n p c replacement) (= result (OrderIntermediate n from to))) ((delete (OrderIntermediate n from to))) :ruleset fusion-clear-paths)

; Demand-limited paths settle before testing absence and clear before union.
(ruleset fusion-paths)
(rule ((PlanningRound n) (RelevantPair from to))
      ((GroupReach n from from) (OrderWalk n from to from false)
       (set (GroupPath n from to) false) (set (OrderIntermediate n from to) false)) :ruleset fusion-paths)
(rule ((GroupReach n from node) (GroupEdge node next))
      ((GroupReach n from next)) :ruleset fusion-paths)
(rule ((PlanningRound n) (RelevantPair from to) (GroupReach n from to))
      ((set (GroupPath n from to) true)) :ruleset fusion-paths)
(rule ((OrderWalk n from to node external) (GroupBefore node from))
      ((OrderWalk n from to from external)) :ruleset fusion-paths)
(rule ((OrderWalk n from to node external) (GroupBefore node to))
      ((OrderWalk n from to to external)) :ruleset fusion-paths)
(rule ((OrderWalk n from to node external) (GroupBefore node next) (!= next from) (!= next to))
      ((OrderWalk n from to next true)) :ruleset fusion-paths)
(rule ((OrderWalk n from to to true))
      ((set (OrderIntermediate n from to) true)) :ruleset fusion-paths)

(rule ((NewPlan n p c a b next) (= domain (IterationDomain a)))
      ((set (IterationDomain next) domain)) :ruleset fusion-commit)
