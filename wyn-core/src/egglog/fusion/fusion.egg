; Greedy fusion planning on a persistent quotient graph. Scalar bodies remain
; in the immutable sidecar until every contraction has been selected.
;
; Current constraints: bucket scatter is rank 1 only; equal fixed extents
; permit horizontal fusion of distinct inputs; memory checks remain conservative;
; scan projection requires pure callbacks; indexed demands stay in one region.
; Indexed expansion follows all contractions, then Rust constructs the bodies.
(ruleset fusion-dependencies)
; Initialize only connected operations or operations sharing an iteration domain.
(rule ((GroupUseFact p (To c role))) ((RelevantPair p c) (RelevantPair c p)) :ruleset fusion-dependencies)
(rule ((GroupEdge p c)) ((RelevantPair p c) (RelevantPair c p)) :ruleset fusion-dependencies)
(rule ((Current p a) (Current c b) (= (Scope a) (Scope b)) (= (IterationDomain a) (IterationDomain b)))
      ((RelevantPair p c)) :ruleset fusion-dependencies)
(rule ((RelevantPair p c))
      ((set (StreamProblems p c) 0) (set (MemoryProblems p c) 0)
       (set (BarrierProblems p c) 0) (set (GroupNonInput p c) 0)
       (set (GroupPath p c) (set-empty)) (set (GroupBetween p c) (set-empty))
       (set (StreamSlices p c) (set-empty))) :ruleset fusion-dependencies)
(rule ((ReadResource p resource) (WriteResource c resource))
      ((set (MemoryProblems p c) 1)) :ruleset fusion-dependencies)
(rule ((EffectMember gate p) (EffectWait c gate))
      ((GroupBefore p c)) :ruleset fusion-dependencies)

; Resolve component routing before propagating scan dependencies.
(rewrite (FieldDependency (TupleDependency fields) i) (DependencyAt fields i) :ruleset fusion-dependencies)
(rewrite (DependencyAt (MoreDependencies value tail) 0) value :ruleset fusion-dependencies)
(rewrite (DependencyAt (MoreDependencies value tail) i) (DependencyAt tail (- i 1)) :when ((> i 0)) :ruleset fusion-dependencies)
(rewrite (FieldDependency (ChoiceDependency condition yes no) i)
         (ChoiceDependency condition (FieldDependency yes i) (FieldDependency no i)) :ruleset fusion-dependencies)
(rewrite (FieldDependency (AllDependencies values) i) (AllDependencies values) :ruleset fusion-dependencies)
(rewrite (FieldDependency (ScanDependency scan) i) (ScanDependency scan) :ruleset fusion-dependencies)
(rewrite (FieldDependency (NoDependency) i) (NoDependency) :ruleset fusion-dependencies)
(rule ((= dep (ScanDependency scan))) ((DependencyScan dep scan)) :ruleset fusion-dependencies)
(rule ((= values (MoreDependencies head tail)) (DependencyScan head scan)) ((DependencyListScan values scan)) :ruleset fusion-dependencies)
(rule ((= values (MoreDependencies head tail)) (DependencyListScan tail scan)) ((DependencyListScan values scan)) :ruleset fusion-dependencies)
(rule ((= dep (TupleDependency values)) (DependencyListScan values scan)) ((DependencyScan dep scan)) :ruleset fusion-dependencies)
(rule ((= dep (AllDependencies values)) (DependencyListScan values scan)) ((DependencyScan dep scan)) :ruleset fusion-dependencies)
(rule ((= dep (ChoiceDependency condition yes no)) (DependencyScan condition scan)) ((DependencyScan dep scan)) :ruleset fusion-dependencies)
(rule ((= dep (ChoiceDependency condition yes no)) (DependencyScan yes scan)) ((DependencyScan dep scan)) :ruleset fusion-dependencies)
(rule ((= dep (ChoiceDependency condition yes no)) (DependencyScan no scan)) ((DependencyScan dep scan)) :ruleset fusion-dependencies)
(rule ((CollectiveDependency consumer dep) (DependencyScan dep scan)) ((ScanFeeds scan consumer)) :ruleset fusion-dependencies)
; Aggregate stable original identities; only relation keys are merged groups.
; Subtract current membership when asking which uses remain external.
(rule ((Member g op))
      ((set (Members g) (set-of op))
       (set (InputUses g) (set-of (At op (Input))))
       (set (DirectInputs g) (set-of (Direct op)))
       (set (SelfUses g) (set-of (At op (Input)) (At op (Capture)) (At op (Neutral)) (At op (Argument)) (At op (Length))))) :ruleset fusion-dependencies)
(rule ((OriginalUseFact g op role))
      ((set (GroupUsesOf g) (set-of (At op role)))) :ruleset fusion-dependencies)
(rule ((GroupUseFact g (Returned)))
      ((set (GroupUsesOf g) (set-of (Observed)))) :ruleset fusion-dependencies)
(rule ((OriginalUseFact g op (Length)))
      ((set (GroupLengths g) (set-of (At op (Length))))) :ruleset fusion-dependencies)
(rule ((GroupUseFact p (To c role))
       (!= role (Input)))
      ((set (GroupNonInput p c) 1)) :ruleset fusion-dependencies)
(rule ((InputFact g site))
      ((set (GroupInputs g) (set-of site))) :ruleset fusion-dependencies)
(rule ((InputFact g (Direct op)) (Member g op))
      ((set (InternalInputs g) (set-of (Direct op)))) :ruleset fusion-dependencies)
(rule ((InputFact g (Indirect op n)) (Member g op))
      ((set (InternalInputs g) (set-of (Indirect op n)))) :ruleset fusion-dependencies)
(rule ((GroupEdge a b))
      ((GroupBefore a b) (DataBefore a b)) :ruleset fusion-dependencies)
(rule ((DataBefore a b) (DataBefore b c))
      ((DataBefore a c)) :ruleset fusion-dependencies)
(rule ((GroupBefore a b)
       (GroupBefore b c))
      ((GroupBefore a c)) :ruleset fusion-dependencies)
(rule ((DataBefore a b) (Member b op))
      ((set (GroupPath a b) (set-of op))) :ruleset fusion-dependencies)
(rule ((GroupBefore p m)
       (GroupBefore m c) (Member m op))
      ((set (GroupBetween p c) (set-of op))) :ruleset fusion-dependencies)
(rule ((Member p scan)
       (Member c collective)
       (ScanFeeds scan collective))
      ((set (BarrierProblems p c) 1)) :ruleset fusion-dependencies)

; Each round reads the current quotient graph. Candidate facts carry the round
; because absence of another use/path is not a monotone property of a plan.
(ruleset fusion-candidates)
(relation PlanningRound (i64))
(relation PlanCandidate (i64 i64 FusionGroup FusionGroup))
; Lexicographic minimum, without comparing every pair of candidates.
(function BestFamily (i64) i64 :merge (min old new))
(function BestRegion (i64 i64) i64 :merge (min old new))
(function BestProducer (i64 i64 i64) i64 :merge (min old new))
(function BestConsumer (i64 i64 i64 i64) i64 :merge (min old new))
(ruleset fusion-select)
(rule ((PlanCandidate n f producer consumer)
       (Current producer a) (Current consumer b)
       (= (Scope a) (RegionId r))
       (= (Owner a) (OperationId p)) (= (Owner b) (OperationId c)))
      ((set (BestFamily n) f)
       (set (BestRegion n f) r)
       (set (BestProducer n f r) p)
       (set (BestConsumer n f r p) c)) :ruleset fusion-select)
(relation Chosen (i64 i64 FusionGroup FusionGroup))
(ruleset fusion-choose)
(rule ((PlanningRound n)
       (= f (BestFamily n)) (= r (BestRegion n f))
       (= p (BestProducer n f r)) (= c (BestConsumer n f r p)))
      ((Chosen n f (Group (OperationId p)) (Group (OperationId c)))) :ruleset fusion-choose)
(relation Pair (i64 FusionGroup FusionPlan FusionGroup FusionPlan))
(rule ((PlanningRound n)
       (RelevantPair p c)
       (Current p a)
       (Current c b)
       (!= p c)
       (= (Scope a) (Scope b)))
      ((Pair n p a c b)) :ruleset fusion-candidates)
(relation ClearStream (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b)
       (GroupStream p c)
       (= 0 (StreamProblems p c))
       (= 1 (set-length (StreamSlices p c)))
       (= 0 (GroupNonInput p c))
       (= 0 (set-length (set-diff (GroupBetween p c) (set-union (Members p) (Members c))))))
      ((ClearStream n p c)) :ruleset fusion-candidates)
(function Retained (i64 FusionGroup FusionGroup) bool :no-merge)
(rule ((PlanningRound n)
       (Current p a))
      ((set (Retained n p p) false)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= v0 (GroupUsesOf p))
       (= v1 (SelfUses p))
       (= v2 (SelfUses c)))
      ((set (Retained n p c) (bool-> (set-length (set-diff v0 (set-union v1 v2))) 0))) :ruleset fusion-candidates)
; This relation must also be round-specific: merging introduces new slice uses.
(relation NoSlice (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b)
       (= (StreamSlices p c) (set-of (WholeInput))))
      ((NoSlice n p c)) :ruleset fusion-candidates)
(relation SliceAllowed (i64 FusionGroup FusionGroup))
(rule ((NoSlice n p c))
      ((SliceAllowed n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= (Scans a) 0)
       (= (Reductions a) 0)
       (= (Retained n p c) false))
      ((SliceAllowed n p c)) :ruleset fusion-candidates)
(relation BarrierAllowed (i64 FusionGroup FusionGroup))
(rule ((Pair n p a c b)
       (= (Scans a) 0))
      ((BarrierAllowed n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= (+ (Scans b) (Reductions b)) 0))
      ((BarrierAllowed n p c)) :ruleset fusion-candidates)
(rule ((Pair n p a c b)
       (= (BarrierProblems p c) 0)
       (= (PostPure a) true)
       (= (PrePure b) true))
      ((BarrierAllowed n p c)) :ruleset fusion-candidates)

; Stream compatible array outputs; scalar reductions remain visible outputs.
(rule ((Pair n p a c b)
       (ScremaPlan a)
       (ScremaPlan b)
       (MovablePlan a)
       (SafePlan b)
       (ClearStream n p c)
       (SliceAllowed n p c)
       (BarrierAllowed n p c))
      ((PlanCandidate n 0 p c)) :ruleset fusion-candidates)
; Independent operations over one domain share a traversal. Ignore obsolete
; endpoint ordering after an in-place update becomes fresh; retain intervening barriers.
(rule ((Pair n p a c b)
       (ScremaPlan a)
       (ScremaPlan b)
       (MovablePlan a)
       (MovablePlan b)
       (= (IterationDomain a) (IterationDomain b))
       (= 0 (set-length (GroupPath p c)))
       (= 0 (set-length (GroupPath c p)))
       (= 0 (set-length (set-diff (set-union (GroupBetween p c) (GroupBetween c p)) (set-union (Members p) (Members c))))))
      ((PlanCandidate n 1 p c)) :ruleset fusion-candidates)
; A map may feed an element consumer only when it has no other observers.
(rule ((Pair n p a c b)
       (ScremaPlan a)
       (ElementPlan b)
       (MovablePlan a)
       (= (Scans a) 0)
       (= (Reductions a) 0)
       (ClearStream n p c)
       (NoSlice n p c)
       (= (MemoryProblems p c) 0)
       (= (set-diff (set-diff (GroupUsesOf p) (SelfUses p)) (InputUses c)) (set-empty)))
      ((PlanCandidate n 2 p c)) :ruleset fusion-candidates)

(relation MaskablePlan (i64 FusionGroup))
(rule ((PlanningRound n)
       (Current p a)
       (FilterPlan a)
       (MovablePlan a)
       (= (PrePure a) true)
       (= (PredicatePure a) true)
       (= (set-diff (GroupLengths p) (SelfUses p)) (set-diff (ValidLengths p) (SelfUses p)))
       (<= (set-length (LengthTypes p)) 1))
      ((MaskablePlan n p)) :ruleset fusion-candidates)
; Mask reductions and share one count among all direct length observers.
(rule ((Pair n p a c b)
       (MaskablePlan n p)
       (ScremaPlan b)
       (SafePlan b)
       (= (Scans b) 0)
       (> (Reductions b) 0)
       (= (ArrayOutputs b) 0)
       (= (PrePure b) true)
       (> (set-length (set-diff (GroupInputs c) (InternalInputs c))) 0) (= (set-diff (set-diff (GroupInputs c) (InternalInputs c)) (DirectInputs p)) (set-empty))
       (= (set-diff (set-diff (GroupUsesOf p) (SelfUses p)) (set-union (GroupLengths p) (InputUses c))) (set-empty))
       (= 0 (set-length (set-diff (GroupBetween p c) (set-union (Members p) (Members c))))))
      ((PlanCandidate n 3 p c)) :ruleset fusion-candidates)
; A filter observed only through lengths becomes a count reduction.
(rule ((MaskablePlan n p)
       (> (set-length (set-diff (GroupLengths p) (SelfUses p))) 0)
       (= (set-diff (GroupUsesOf p) (SelfUses p)) (set-diff (GroupLengths p) (SelfUses p))))
      ((PlanCandidate n 5 p p)) :ruleset fusion-candidates)

; Indexed expansion is terminal: plan all contractions before making helpers.
(relation IndexedCandidate (FusionGroup))
(function IndexedBarriers (FusionGroup) GroupUses :merge (set-union old new))
(ruleset fusion-indexed-analysis)
(rule ((Current p a))
      ((set (IndexedBarriers p) (set-empty))) :ruleset fusion-indexed-analysis)
(rule ((GroupUseFact p (To c role))
       (!= p c)
       (Member c original)
       (> (set-length (set-diff (GroupBetween p c) (set-union (Members p) (Members c)))) 0))
      ((set (IndexedBarriers p) (set-of (At original role)))) :ruleset fusion-indexed-analysis)
(ruleset fusion-indexed)
(rule ((Current p a)
       (ScremaPlan a)
       (MovablePlan a)
       (= (Scans a) 0)
       (= (Reductions a) 0)
       (= uses (set-diff (GroupUsesOf p) (SelfUses p)))
       (> (set-length uses) 0)
       (<= (set-length uses) (DemandLimit a))
       (= (IndexedBarriers p) (set-empty))
       (= uses (set-diff (IndexedUses p) (set-union (SelfUses p) (IndexAddressUses p)))))
      ((IndexedCandidate p)) :ruleset fusion-indexed)
; Snapshot uses before union; materialization will replay these decisions once.

(relation FusionStep (i64 i64 RegionKey OperationKey OperationKey))
(relation StepUse (i64 OperationKey OperandRole))
(relation StepObserved (i64))
(ruleset fusion-record)
(rule ((Chosen n family p c) (GroupUseFact p (Outside consumer role)))
      ((StepUse n consumer role)) :ruleset fusion-record)
(rule ((Chosen n family p c)
       (Current p a)
       (Current c b)
       (= v0 (Scope a))
       (= v1 (Owner a))
       (= v2 (Owner b)))
      ((FusionStep n family v0 v1 v2)) :ruleset fusion-record)
(rule ((Chosen n family p c)
       (GroupUseFact p (To u role))
       (!= p u)
       (Current u plan)
       (= v0 (Owner plan)))
      ((StepUse n v0 role)) :ruleset fusion-record)
(rule ((Chosen n family p c)
       (GroupUseFact p (Returned)))
      ((StepObserved n)) :ruleset fusion-record)

(ruleset fusion-commit)
(relation NewPlan (i64 FusionGroup FusionGroup FusionPlan FusionPlan FusionPlan))
(rule ((Chosen n family p c)
       (Current p a)
       (Current c b)
       (= v0 (Retained n p c)))
      ((NewPlan n p c a b (Joined family a b v0))) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (= v0 (Owner b))
       (= v1 (Scope b))
       (= v2 (DemandLimit a))
       (= v3 (PredicatePure b)))
      ((set (Owner next) v0)
       (set (Scope next) v1)
       (set (DemandLimit next) v2)
       (set (PredicatePure next) v3)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n family p c)
       (> family 0)
       (< family 3)
       (= v0 (IterationDomain a)))
      ((set (IterationDomain next) v0)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 0 p c)
       (= (StreamSlices p c) (set-of (WholeInput)))
       (= v0 (IterationDomain a)))
      ((set (IterationDomain next) v0)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 0 p c)
       (!= (StreamSlices p c) (set-of (WholeInput)))
       (= v0 (IterationDomain b)))
      ((set (IterationDomain next) v0)) :ruleset fusion-commit)

; Body properties are algebra on summaries, independent of scalar syntax.
(rule ((NewPlan n p c a b next)
       (Chosen n 1 p c)
       (= v0 (Scans a))
       (= v1 (Scans b))
       (= v2 (Reductions a))
       (= v3 (Reductions b))
       (= v4 (ArrayOutputs a))
       (= v5 (ArrayOutputs b))
       (= v6 (PrePure a))
       (= v7 (PrePure b))
       (= v8 (PostPure a))
       (= v9 (PostPure b)))
      ((ScremaPlan next)
       (set (Scans next) (+ v0 v1))
       (set (Reductions next) (+ v2 v3))
       (set (ArrayOutputs next) (+ v4 v5))
       (set (PrePure next) (and v6 v7))
       (set (PostPure next) (and v8 v9))) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 0 p c)
       (= v0 (Scans a))
       (= v1 (Scans b))
       (= v2 (Reductions a))
       (= v3 (Reductions b))
       (= v4 (ArrayOutputs b))
       (= v5 (Retained n p c))
       (= v6 (BoolNumber v5))
       (= v7 (ArrayOutputs a)))
      ((ScremaPlan next)
       (set (Scans next) (+ v0 v1))
       (set (Reductions next) (+ v2 v3))
       (set (ArrayOutputs next) (+ v4 (* v6 v7)))) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 0 p c)
       (= (Scans a) 0)
       (= v0 (PrePure a))
       (= v1 (PostPure a))
       (= v2 (PrePure b))
       (= v3 (PostPure b)))
      ((set (PrePure next) (and v0 (and v1 v2)))
       (set (PostPure next) v3)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 0 p c)
       (> (Scans a) 0)
       (= v0 (PrePure a))
       (= v1 (Scans b))
       (= v2 (Reductions b))
       (= v3 (PostPure a))
       (= v4 (PrePure b))
       (= v5 (PostPure b)))
      ((set (PrePure next) (and v0 (or (bool-= (+ v1 v2) 0) (and v3 v4))))
       (set (PostPure next) (and v3 (and v4 v5)))) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 2 p c)
       (= v0 (Scans b))
       (= v1 (Reductions b))
       (= v2 (ArrayOutputs b))
       (= v3 (PrePure a))
       (= v4 (PostPure a))
       (= v5 (PrePure b))
       (= v6 (PostPure b)))
      ((ElementPlan next)
       (set (Scans next) v0)
       (set (Reductions next) v1)
       (set (ArrayOutputs next) v2)
       (set (PrePure next) (and v3 (and v4 v5)))
       (set (PostPure next) v6)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (Chosen n 2 p c)
       (FilterPlan b))
      ((FilterPlan next)) :ruleset fusion-commit)
(relation CountAdded (i64 i64))
(rule ((Chosen n family p c)
       (= v0 (GroupLengths p))
       (= v1 (SelfUses p)))
      ((CountAdded n (min 1 (set-length (set-diff v0 v1))))) :ruleset fusion-record)
(rule ((NewPlan n p c a b next)
       (Chosen n family p c)
       (>= family 3)
       (CountAdded n count)
       (= v0 (BoolNumber (bool-= family 5)))
       (= v1 (Reductions b))
       (= v2 (IterationDomain a)))
      ((ScremaPlan next)
       (set (Scans next) 0)
       (set (ArrayOutputs next) 0)
       (set (Reductions next) (+ (* (- 1 v0) v1) count))
       (set (PrePure next) true)
       (set (PostPure next) true)
       (set (IterationDomain next) v2)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (SafePlan a)
       (SafePlan b))
      ((SafePlan next)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next)
       (SafePlan next)
       (ScremaPlan next))
      ((MovablePlan next)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next) (SafePlan next) (FilterPlan next))
      ((MovablePlan next)) :ruleset fusion-commit)

; Apply only after the new plan and the complete action record exist.
(ruleset fusion-indexed-retire)
(rule ((FusionStep n 4 region owner owner) (Current p plan) (= (Owner plan) owner))
      ((delete (Current p plan))) :ruleset fusion-indexed-retire)
(ruleset fusion-union)
(rule ((NewPlan n p c a b next))
      ((delete (Current p a))
       (delete (Current c b))
       (Current c next)
       (union p c)) :ruleset fusion-union)
(rule ((Chosen n family p c)
       (>= family 3)
       (GroupUseFact p (To length (Length)))
       (!= p length)
       (Current length plan))
      ((delete (Current length plan))
       (union length c)) :ruleset fusion-union)

; Discard round-local proofs before evaluating the changed quotient graph.
(ruleset fusion-clear)
(rule ((Chosen n f p c))
      ((delete (PlanningRound n)) (PlanningRound (+ n 1))) :ruleset fusion-clear)
(rule ((Chosen n f p c))
      ((delete (Chosen n f p c))) :ruleset fusion-clear)
(rule ((NewPlan n p c a b next))
      ((delete (NewPlan n p c a b next))) :ruleset fusion-clear)
(ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (Pair n p a c b))
      ((delete (Pair n p a c b))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (PlanCandidate n f p c))
      ((delete (PlanCandidate n f p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (= v (Retained n p c)))
      ((delete (Retained n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (ClearStream n p c))
      ((delete (ClearStream n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (NoSlice n p c))
      ((delete (NoSlice n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (SliceAllowed n p c))
      ((delete (SliceAllowed n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (BarrierAllowed n p c))
      ((delete (BarrierAllowed n p c))) :ruleset fusion-clear-candidates)
(rule ((Chosen n chosen-family chosen-producer chosen-consumer) (MaskablePlan n p))
      ((delete (MaskablePlan n p))) :ruleset fusion-clear-candidates)

; Freeze indexed candidates once; record every use before retiring any producer.
(ruleset fusion-indexed-candidates)
(rule ((PlanningRound n) (IndexedCandidate p))
      ((PlanCandidate n 4 p p)) :ruleset fusion-indexed-candidates)
(ruleset fusion-indexed-finish)
(rule ((Chosen n 4 p p))
      ((delete (IndexedCandidate p))) :ruleset fusion-indexed-finish)