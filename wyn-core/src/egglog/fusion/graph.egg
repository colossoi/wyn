(ruleset graph-fusion)
(ruleset graph-fusion-apply)
(function FusionOutputBase (OperationKey OperationKey) i64 :no-merge)
(function FusionOperationBase (OperationKey OperationKey) i64 :no-merge)
(relation AccumulatorPair (OperationKey OperationKey))
(relation AccumulatorFuseSelected (OperationKey OperationKey))
(function FusionGroupBase (OperationKey OperationKey) i64 :no-merge)
(rule ((= revision (AnalysisRevision)) (NextOperation first second)
       (AccumulatorOperation first) (AccumulatorOperation second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= na (AccumulatorGroupCount first)) (= nb (AccumulatorGroupCount second))
       (= (RegionParameterCount a) na) (= (RegionYieldCount a) na)
       (= (RegionParameterCount b) nb) (= (RegionYieldCount b) nb))
      ((AccumulatorPair first second) (EffectCompare first second)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorPolicy second group)))
      ((set (AccumulatorPolicy first (+ base group)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorArrayCount second group)))
      ((set (AccumulatorArrayCount first (+ base group)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorArray second group field)))
      ((set (AccumulatorArray first (+ base group) field) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorCombiner second group)))
      ((set (AccumulatorCombiner first (+ base group)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (RegionParameter b slot)))
      ((set (RegionParameter a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (ParameterDiet b slot)))
      ((set (ParameterDiet a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (RegionReturnType b slot)))
      ((set (RegionReturnType a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (RegionYield b slot)))
      ((set (RegionYield a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= count (RegionParameterCount b)))
      ((delete (RegionParameterCount a)) (set (RegionParameterCount a) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= count (RegionYieldCount b)))
      ((delete (RegionYieldCount a)) (set (RegionYieldCount a) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= count (AccumulatorGroupCount second)))
      ((delete (AccumulatorGroupCount first)) (set (AccumulatorGroupCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionOutputBase first second)) (= value (Output second slot)))
      ((set (Output first (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionOutputBase first second)) (= count (OutputCount second)))
      ((delete (OutputCount first)) (set (OutputCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0)) (= b (OperationRegion operation))
       (= order (OperationOrder operation)) (= base (FusionOperationBase first second)))
      ((delete (OperationRegion operation)) (set (OperationRegion operation) a)
       (delete (OperationOrder operation)) (set (OperationOrder operation) (+ base order))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second) (OperationCertificate second name))
      ((OperationCertificate first name)) :ruleset graph-fusion-apply)

; Finish ownership/effect and demand proofs before selecting any placement.
(ruleset placement-index)
(ruleset placement-demand)
(ruleset placement-legality)
(ruleset placement-select)
(function PlacementReadOnly (OperationKey) bool :merge (and old new))
(function PlacementMember (OperationKey OperationKey) bool :merge (or old new))
(relation PlacementValue (OperationKey Name))
(function PlacementInput (OperationKey Name) bool :merge (and old new))
(relation PlacementPath (OperationKey OperationKey))
(relation PlacementDemand (OperationKey RegionKey))
(function PlacementHasDemand (OperationKey) bool :merge (or old new))
(relation PlacementDead (OperationKey))
(relation PlacementSite (OperationKey OperationKey RegionKey))
(function PlacementUnder (OperationKey RegionKey RegionKey) bool :merge (or old new))
(function PlacementGuarded (OperationKey RegionKey) bool :merge (or old new))
(function PlacementAvailable (OperationKey Name) bool :merge (or old new))
(function PlacementUnsafe (OperationKey OperationKey RegionKey) bool :merge (or old new))
(relation SinkProducer (OperationKey OperationKey RegionKey))
(rule ((= revision (AnalysisRevision)) (LiveOperation operation)) ((set (PlacementReadOnly operation) true)) :ruleset placement-index)
(rule ((= revision (AnalysisRevision)) (OperationWrite operation resource)) ((set (PlacementReadOnly operation) false)) :ruleset placement-index)
(rule ((= revision (AnalysisRevision)) (ConsumedToken operation token)) ((set (PlacementReadOnly operation) false)) :ruleset placement-index)
(rule ((= revision (AnalysisRevision)) (InvocationDependent operation)) ((set (PlacementReadOnly operation) false)) :ruleset placement-index)
(rule ((= revision (AnalysisRevision)) (LiveOperation producer) (= body (ControlRegion producer 0)))
      ((set (PlacementMember producer producer) true)) :ruleset placement-index)
(rule ((= (PlacementMember producer member) true) (= name (Output member slot))) ((PlacementValue producer name)) :ruleset placement-index)
(rule ((PlacementValue producer name) (DirectOperationUse user name)) ((set (PlacementMember producer user) false)) :ruleset placement-index)
(rule ((PlacementValue producer name) (DirectOperationUse user name) (= parent (OperationRegion producer)) (= parent (OperationRegion user))
       (= before (OperationOrder producer)) (= after (OperationOrder user)) (< before after)
       (= (PureOperation user) true) (DiscardableOperation user) (RepeatableOperation user))
      ((set (PlacementMember producer user) true)) :ruleset placement-index)
(rule ((= (PlacementMember producer member) true) (OperationUse member name)) ((set (PlacementInput producer name) true)) :ruleset placement-index)
(rule ((PlacementValue producer name)) ((set (PlacementInput producer name) false)) :ruleset placement-index)
(rule ((PlacementValue producer name) (DirectOperationUse user name) (LiveOperation user) (= (PlacementMember producer user) false) (= region (OperationRegion user)))
      ((PlacementDemand producer region)) :ruleset placement-demand)
(rule ((PlacementValue producer name) (EndDemand region name) (LiveRegion region)) ((PlacementDemand producer region)) :ruleset placement-demand)
(rule ((= (PlacementMember producer producer) true) (= (PlacementReadOnly producer) true) (NextOperation producer next))
      ((PlacementPath producer next)) :ruleset placement-demand)
(rule ((PlacementPath producer middle) (= (PlacementReadOnly middle) true) (NextOperation middle next)) ((PlacementPath producer next)) :ruleset placement-demand)
(rule ((PlacementPath producer scope) (BranchOperation scope) (= body (ControlRegion scope edge)) (PlacementDemand producer region) (FlowScopeAncestor body region))
      ((PlacementSite producer scope body)) :ruleset placement-demand)
(rule ((PlacementPath producer scope) (AccumulatorOperation scope) (= body (ControlRegion scope 0))) ((PlacementSite producer scope body)) :ruleset placement-demand)
(rule ((PlacementSite producer scope body)) ((set (PlacementUnsafe producer scope body) false)) :ruleset placement-demand)
(rule ((PlacementSite producer scope body) (PlacementDemand producer region)) ((set (PlacementUnder scope body region) false)) :ruleset placement-demand)
(rule ((PlacementSite producer scope body) (PlacementDemand producer region) (FlowScopeAncestor body region)) ((set (PlacementUnder scope body region) true)) :ruleset placement-demand)
(rule ((PlacementDemand producer region)) ((set (PlacementGuarded producer region) false)) :ruleset placement-demand)
(rule ((PlacementDemand producer region) (= parent (OperationRegion producer)) (BranchOperation scope) (= parent (OperationRegion scope))
       (= body (ControlRegion scope edge)) (FlowScopeAncestor body region)) ((set (PlacementGuarded producer region) true)) :ruleset placement-demand)
(rule ((PlacementSite producer scope body) (= (PlacementInput producer name) true))
      ((AvailabilityDemand scope name) (set (PlacementAvailable scope name) false)) :ruleset placement-demand)
(rule ((PlacementSite producer scope body) (= (PlacementInput producer name) true) (AvailableAt scope name)) ((set (PlacementAvailable scope name) true)) :ruleset placement-demand)
(rule ((PlacementSite producer scope body) (= (PlacementInput producer name) true) (= (PlacementAvailable scope name) false))
      ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
(rule ((PlacementSite producer scope body) (PlacementValue producer name) (DirectOperationUse scope name)) ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
(rule ((PlacementSite producer scope body) (AccumulatorOperation scope)
       (PlacementDemand producer region) (= (PlacementUnder scope body region) false))
      ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
(rule ((= (PlacementMember producer producer) true)) ((set (PlacementHasDemand producer) false)) :ruleset placement-demand)
(rule ((PlacementDemand producer region)) ((set (PlacementHasDemand producer) true)) :ruleset placement-demand)
(rule ((= (PlacementHasDemand producer) false) (= (PlacementReadOnly producer) true) (= (PlacementMember producer member) true)) ((PlacementDead member)) :ruleset placement-select)
(rule ((PlacementSite producer scope body) (PlacementSite producer other target) (!= scope other) (BranchOperation scope) (BranchOperation other)
       (= condition (Input scope 0)) (= condition (Input other 0))) ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
; Copy only conditional demands; a value needed in both arms stays shared.
; Keep cheap work where the hoister would put it instead of repeatedly cloning it.
(rule ((PlacementSite producer scope body) (BranchOperation scope))
      ((OperationWorkDemand producer)) :ruleset placement-legality)
(rule ((PlacementSite producer scope body) (BranchOperation scope) (= work (OperationWork producer)) (<= work (bigint 4)))
      ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
(rule ((PlacementSite producer scope body) (BranchOperation scope) (PlacementDemand producer region) (= (PlacementGuarded producer region) false))
      ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
(rule ((PlacementSite producer scope body) (BranchOperation scope) (= other (ControlRegion scope edge)) (!= body other)
       (PlacementDemand producer region) (FlowScopeAncestor other region)) ((set (PlacementUnsafe producer scope body) true)) :ruleset placement-legality)
(rule ((PlacementSite producer scope body) (= (PlacementUnsafe producer scope body) false))
      ((SinkProducer producer scope body)) :ruleset placement-select)

; Coalesce adjacent occurrences of the same guard while retaining path order.
(relation BranchPair (OperationKey OperationKey))
(function BranchUnsafe (OperationKey OperationKey) bool :merge (or old new))
(relation BranchFuseSelected (OperationKey OperationKey))
(function BranchOperationBase (OperationKey OperationKey i64) i64 :merge (max old new))
(rule ((= revision (AnalysisRevision)) (NextOperation first second) (BranchOperation first) (BranchOperation second)
       (= condition (Input first 0)) (= condition (Input second 0))) ((set (BranchUnsafe first second) false)) :ruleset placement-index)
(rule ((= (BranchUnsafe first second) unsafe) (OperationDependency second first)) ((set (BranchUnsafe first second) true)) :ruleset placement-index)
(rule ((= (BranchUnsafe first second) false) (= base (OutputCount first))) ((BranchPair first second) (set (FusionOutputBase first second) base)) :ruleset placement-select)
(rule ((BranchPair first second) (= arm (ControlRegion first edge))) ((set (BranchOperationBase first second edge) 0)) :ruleset graph-fusion)
(rule ((BranchPair first second) (= arm (ControlRegion first edge)) (= arm (OperationRegion operation)) (= order (OperationOrder operation)))
      ((set (BranchOperationBase first second edge) (+ order 1))) :ruleset graph-fusion)
(rule ((BranchFuseSelected first second) (= base (FusionOutputBase first second)) (= value (Output second slot))) ((set (Output first (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (= base (FusionOutputBase first second)) (= count (OutputCount second)))
      ((delete (OutputCount first)) (set (OutputCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (= a (ControlRegion first edge)) (= b (ControlRegion second edge)) (= base (FusionOutputBase first second)) (= value (RegionYield b slot)))
      ((set (RegionYield a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (= a (ControlRegion first edge)) (= b (ControlRegion second edge)) (= base (FusionOutputBase first second)) (= value (RegionReturnType b slot)))
      ((set (RegionReturnType a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (= a (ControlRegion first edge)) (= b (ControlRegion second edge)) (= base (FusionOutputBase first second)) (YieldCertificate b slot value))
      ((YieldCertificate a (+ base slot) value)) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (= a (ControlRegion first edge)) (= b (ControlRegion second edge)) (= base (FusionOutputBase first second)) (= count (RegionYieldCount b)))
      ((delete (RegionYieldCount a)) (set (RegionYieldCount a) (+ base count))) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (= a (ControlRegion first edge)) (= b (ControlRegion second edge)) (= b (OperationRegion operation)) (= order (OperationOrder operation)) (= base (BranchOperationBase first second edge)))
      ((delete (OperationRegion operation)) (set (OperationRegion operation) a) (delete (OperationOrder operation)) (set (OperationOrder operation) (+ base order))) :ruleset graph-fusion-apply)
(rule ((BranchFuseSelected first second) (OperationCertificate second name)) ((OperationCertificate first name)) :ruleset graph-fusion-apply)
