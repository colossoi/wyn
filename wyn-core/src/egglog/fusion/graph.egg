(ruleset graph-fusion)
(ruleset graph-fusion-select)
(ruleset graph-fusion-legality)
(ruleset graph-fusion-apply)
(relation ParallelPair (OperationKey OperationKey))
(relation ParallelPath (OperationKey OperationKey))
(function FusionInputAvailable (OperationKey OperationKey Name) bool :merge (or old new))
(relation FusionChildRegion (OperationKey OperationKey RegionKey))
(relation SameDomainPrefix (OperationKey OperationKey i64))
(relation FusionLoadPrefix (OperationKey OperationKey OperationKey i64))
(relation FusionForwardLoad (OperationKey OperationKey OperationKey Name))
(function FusionUnsafe (OperationKey OperationKey) bool :merge (or old new))
(function FusionHandledUse (OperationKey OperationKey OperationKey Name) bool :merge (or old new))
(relation FuseCandidate (OperationKey OperationKey))
(relation FuseSelected (OperationKey OperationKey))
(function FusionClauseBase (OperationKey OperationKey) i64 :no-merge)
(function FusionOutputBase (OperationKey OperationKey) i64 :no-merge)
(function FusionOperationBase (OperationKey OperationKey) i64 :no-merge)
(relation MotionCandidate (OperationKey OperationKey))
(relation FusionPreparation (OperationKey))
(relation FusionBoundary (OperationKey))
(relation FusionNested (OperationKey))
(relation FusionCollective (OperationKey))
(function FusionHasForwardedLoad (OperationKey OperationKey) bool :merge (or old new))
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= body (ControlRegion operation 0))
       (FlowScopeAncestor body region) (= region (OperationRegion nested)) (ParallelOperation nested))
      ((FusionNested operation)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= (ResultKindOf operation clause) (Folded kind)))
      ((FusionCollective operation)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second))
      ((set (FusionHasForwardedLoad first second) false)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (FusionForwardLoad first second load value))
      ((set (FusionHasForwardedLoad first second) true)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (= (FusionHasForwardedLoad first second) false)
       (FusionNested first) (FusionCollective second))
      ((set (FusionUnsafe first second) true)) :ruleset graph-fusion-legality)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (= (FusionHasForwardedLoad first second) false)
       (FusionCollective first) (FusionNested second))
      ((set (FusionUnsafe first second) true)) :ruleset graph-fusion-legality)
; Total, memory-free intermediates do not impose an execution barrier.
(rule ((= revision (AnalysisRevision)) (NextOperation first next) (ParallelOperation first))
      ((ParallelPath first next)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPath first middle) (= (MovableOperation middle) true)
       (= (PureOperation middle) true) (NextOperation middle next))
      ((ParallelPath first next)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPath first second) (ParallelOperation second)
       (= execution (OperationExecution first)) (= execution (OperationExecution second)))
      ((ParallelPair first second) (SameDomainPrefix first second 0)
       (set (FusionUnsafe first second) false) (EffectCompare first second)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (= a (OperationDomain first)) (= b (OperationDomain second))
       (SameDomainPrefix first second slot) (< slot (DomainRank a))
       (= extent (DomainExtent a slot)) (= extent (DomainExtent b slot)))
      ((SameDomainPrefix first second (+ slot 1))) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (= a (OperationDomain first)) (= b (OperationDomain second))
       (SameDomainPrefix first second slot) (< slot (DomainRank a))
       (= left (DomainExtent a slot)) (= right (DomainExtent b slot)) (ConstantBound left n) (ConstantBound right n))
      ((SameDomainPrefix first second (+ slot 1))) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (= region (OperationRegion load)) (IndexOperation load)
       (= source (Input load 0)) (= source (Output first output))
       (= (OutputRole first output) (CollectedOutput)))
      ((FusionLoadPrefix first second load 0)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (FusionLoadPrefix first second load slot) (= domain (OperationDomain second))
       (< slot (DomainRank domain)) (= axis (DomainAxis domain slot))
       (= (Input load (+ slot 1)) (ValueNameRef axis)))
      ((FusionLoadPrefix first second load (+ slot 1))) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (FusionLoadPrefix first second load (DomainRank (OperationDomain second)))
       (= count (DomainRank (OperationDomain second))) (= (InputCount load) (+ count 1))
       (= source (Input load 0)) (= source (Output first output))
       (= clause (OutputClause first output)) (= field (OutputField first output))
       (= value (ResultValue first clause field)))
      ((FusionForwardLoad first second load value)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (FusionChildRegion first second region) (= region (OperationRegion user))
       (DirectOperationUse user name) (= name (Output first slot)))
      ((set (FusionHandledUse first second user name) false)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (FusionForwardLoad first second load value) (= name (Input load 0)))
      ((set (FusionHandledUse first second load name) true)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (= (FusionHandledUse first second user name) false))
      ((set (FusionUnsafe first second) true)) :ruleset graph-fusion-legality)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (= a (OperationDomain first)) (= b (OperationDomain second))
       (= rank (DomainRank a)) (= rank (DomainRank b)) (SameDomainPrefix first second rank)
       (= (FusionUnsafe first second) false))
      ((FuseCandidate first second)) :ruleset graph-fusion-select)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (OperationUse second name))
      ((AvailabilityDemand first name) (set (FusionInputAvailable first second name) false)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (OperationUse second name) (AvailableAt first name))
      ((set (FusionInputAvailable first second name) true)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (OperationUse second name) (= name (Output first slot)))
      ((set (FusionInputAvailable first second name) true)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (= (FusionInputAvailable first second name) false))
      ((set (FusionUnsafe first second) true)) :ruleset graph-fusion-legality)
; Motion is limited to total reusable occurrences whose inputs dominate the owner.
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= (MovableOperation operation) true)
       (= region (OperationRegion operation)) (RegionOwnedBy region owner))
      ((MotionCandidate operation owner) (EffectCompare operation owner)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (MotionCandidate operation owner) (OperationUse operation name))
      ((AvailabilityDemand owner name)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultKindOf second clause)))
      ((set (ResultKindOf first (+ base clause)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultValueCount second clause)))
      ((set (ResultValueCount first (+ base clause)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultValue second clause field)))
      ((set (ResultValue first (+ base clause) field) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultPredicate second clause)))
      ((set (ResultPredicate first (+ base clause)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultReducer second clause)))
      ((set (ResultReducer first (+ base clause)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultNeutral second clause field)))
      ((set (ResultNeutral first (+ base clause) field) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultNeutralCount second clause)))
      ((set (ResultNeutralCount first (+ base clause)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= value (ResultCommutative second clause)))
      ((set (ResultCommutative first (+ base clause)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionOutputBase first second)) (= value (Output second slot)))
      ((set (Output first (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionOutputBase first second)) (= value (OutputField second slot)))
      ((set (OutputField first (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionOutputBase first second)) (= value (OutputRole second slot)))
      ((set (OutputRole first (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionOutputBase first second))
       (= clauses (FusionClauseBase first second)) (= clause (OutputClause second slot)))
      ((set (OutputClause first (+ base slot)) (+ clauses clause))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionOutputBase first second)) (= count (OutputCount second)))
      ((delete (OutputCount first)) (set (OutputCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= base (FusionClauseBase first second)) (= count (ResultCount second)))
      ((delete (ResultCount first)) (set (ResultCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (= destination (ControlRegion first 0)) (= source (ControlRegion second 0))
       (= source (OperationRegion operation)) (= order (OperationOrder operation)) (= base (FusionOperationBase first second)))
      ((delete (OperationRegion operation)) (set (OperationRegion operation) destination)
       (delete (OperationOrder operation)) (set (OperationOrder operation) (+ base order))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (FuseSelected first second) (OperationCertificate second value))
      ((OperationCertificate first value)) :ruleset graph-fusion-apply)

(relation AccumulatorPair (OperationKey OperationKey))
(relation AccumulatorFuseSelected (OperationKey OperationKey))
(function FusionGroupBase (OperationKey OperationKey) i64 :no-merge)
(rule ((= revision (AnalysisRevision)) (NextOperation first second)
       (AccumulatorOperation first) (AccumulatorOperation second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= na (AccumulatorGroupCount first)) (= nb (AccumulatorGroupCount second))
       (= (RegionParameterCount a) na) (= (RegionYieldCount a) na)
       (= (RegionParameterCount b) nb) (= (RegionYieldCount b) nb))
      ((AccumulatorPair first second) (EffectCompare first second)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorPolicy second group)))
      ((set (AccumulatorPolicy first (+ base group)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorArrayCount second group)))
      ((set (AccumulatorArrayCount first (+ base group)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorArray second group field)))
      ((set (AccumulatorArray first (+ base group) field) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= value (AccumulatorCombiner second group)))
      ((set (AccumulatorCombiner first (+ base group)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (RegionParameter b slot)))
      ((set (RegionParameter a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (ParameterDiet b slot)))
      ((set (ParameterDiet a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (RegionReturnType b slot)))
      ((set (RegionReturnType a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= value (RegionYield b slot)))
      ((set (RegionYield a (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= count (RegionParameterCount b)))
      ((delete (RegionParameterCount a)) (set (RegionParameterCount a) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0))
       (= base (FusionGroupBase first second)) (= count (RegionYieldCount b)))
      ((delete (RegionYieldCount a)) (set (RegionYieldCount a) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionGroupBase first second)) (= count (AccumulatorGroupCount second)))
      ((delete (AccumulatorGroupCount first)) (set (AccumulatorGroupCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionOutputBase first second)) (= value (Output second slot)))
      ((set (Output first (+ base slot)) value)) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= base (FusionOutputBase first second)) (= count (OutputCount second)))
      ((delete (OutputCount first)) (set (OutputCount first) (+ base count))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second)
       (= a (ControlRegion first 0)) (= b (ControlRegion second 0)) (= b (OperationRegion operation))
       (= order (OperationOrder operation)) (= base (FusionOperationBase first second)))
      ((delete (OperationRegion operation)) (set (OperationRegion operation) a)
       (delete (OperationOrder operation)) (set (OperationOrder operation) (+ base order))) :ruleset graph-fusion-apply)
(rule ((= revision (AnalysisRevision)) (AccumulatorFuseSelected first second) (OperationCertificate second name))
      ((OperationCertificate first name)) :ruleset graph-fusion-apply)

(relation SinkPath (OperationKey OperationKey))
(relation SinkProducer (OperationKey OperationKey RegionKey))
(rule ((= revision (AnalysisRevision)) (NextOperation first next) (ParallelOperation first))
      ((SinkPath first next)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (SinkPath first middle) (= (PureOperation middle) true) (NextOperation middle next))
      ((SinkPath first next)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (SinkPath producer scope) (ParallelOperation producer)
       (AccumulatorOperation scope) (= body (ControlRegion scope 0)))
      ((SinkProducer producer scope body)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (NextOperation anchor operation) (ParallelOperation anchor)
       (ConstantOperation operation))
      ((MotionCandidate operation anchor)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (CseOperation operation))
      ((FusionPreparation operation)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (FreshOutput operation slot))
      ((FusionPreparation operation)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (IndexCalculationOperation operation))
      ((FusionPreparation operation)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation))
      ((FusionBoundary operation)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (AccumulatorOperation operation))
      ((FusionBoundary operation)) :ruleset graph-fusion)
; Reordering within a region does not repeat an allocation; effect checks still apply.
(rule ((= revision (AnalysisRevision)) (NextOperation anchor operation) (FusionBoundary anchor)
       (FusionPreparation operation))
      ((MotionCandidate operation anchor) (EffectCompare operation anchor)) :ruleset graph-fusion)

(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (RegionOwnedBy child second) (FlowScopeAncestor child region))
      ((FusionChildRegion first second region)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (DirectOperationUse second name) (= name (Output first slot)))
      ((set (FusionUnsafe first second) true)) :ruleset graph-fusion-legality)
(rule ((= revision (AnalysisRevision)) (FusionChildRegion first second region) (EndDemand region name) (= name (Output first slot)))
      ((set (FusionUnsafe first second) true)) :ruleset graph-fusion-legality)

; A read-only producer may stream into fresh accumulator storage: no write becomes
; observable before the enclosing accumulator scope returns.
(function FusionPrivateWrites (OperationKey OperationKey) bool :merge (and old new))
(rule ((= revision (AnalysisRevision)) (ParallelPair first second) (FusionForwardLoad first second load value)
       (= (ResultCount second) 1) (= (ResultKindOf second 0) (Contributed)))
      ((set (FusionPrivateWrites first second) true)) :ruleset graph-fusion)
(rule ((= revision (AnalysisRevision)) (= flag (FusionPrivateWrites first second)) (OperationWrite first resource))
      ((set (FusionPrivateWrites first second) false)) :ruleset graph-fusion-legality)
(rule ((= revision (AnalysisRevision)) (= flag (FusionPrivateWrites first second)) (OperationWrite second (ExternalMemory)))
      ((set (FusionPrivateWrites first second) false)) :ruleset graph-fusion-legality)
(rule ((= revision (AnalysisRevision)) (= flag (FusionPrivateWrites first second)) (OperationRead first resource) (OperationWrite second resource))
      ((set (FusionPrivateWrites first second) false)) :ruleset graph-fusion-legality)
