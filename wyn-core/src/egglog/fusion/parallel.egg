(ruleset parallel-effects)
(relation ParallelRead (i64 Resource))
(relation ParallelWrite (i64 Resource))
(relation ParallelTrap (i64))
(relation ParallelEffectConflict ())
(rule ((ParallelWrite 0 root) (ParallelRead 1 root))
      ((ParallelEffectConflict)) :ruleset parallel-effects)
(rule ((ParallelRead 0 root) (ParallelWrite 1 root))
      ((ParallelEffectConflict)) :ruleset parallel-effects)
(rule ((ParallelWrite 0 root) (ParallelWrite 1 root))
      ((ParallelEffectConflict)) :ruleset parallel-effects)
(rule ((ParallelTrap 0) (ParallelTrap 1))
      ((ParallelEffectConflict)) :ruleset parallel-effects)
(rule ((ParallelTrap 0) (ParallelWrite 1 root))
      ((ParallelEffectConflict)) :ruleset parallel-effects)
(rule ((ParallelWrite 0 root) (ParallelTrap 1))
      ((ParallelEffectConflict)) :ruleset parallel-effects)
