; Coordinate proofs refer to ordinary index expressions and statements. Digits
; partition a finite domain; no output layout or alternate traversal is stored.
(ruleset coordinate-analysis)
(ruleset coordinate-select)
(datatype CoordinateDigit (Digit i64 i64 i64)) ; input divisor, radix, output scale
(sort CoordinateDigits (Set CoordinateDigit))
(relation CoordinateWindow (Function ValueName IndexExp i64 i64 i64))
(function CoordinateParts (Function ValueName IndexExp) CoordinateDigits :no-merge)
(relation CoordinateSum (Function IndexExp IndexExp IndexExp))
(relation CoordinateScale (Function IndexExp IndexExp i64))
(relation CoordinateQuotient (Function IndexExp IndexExp i64))
(relation CoordinateRemainder (Function IndexExp IndexExp i64))
(relation CoordinateAlias (Function IndexExp IndexExp))
(rule ((ContainsDomainAxis (FunctionRoot function) (DenseAxis index size))
       (= n (StaticIndex function size)) (> n 0) (<= n 2147483647))
      ((CoordinateWindow function index (IndexValue index) 1 n 1)) :ruleset coordinate-analysis)
(rule ((CoordinateWindow function root index divisor 1 scale))
      ((set (CoordinateParts function root index) (set-empty))) :ruleset coordinate-analysis)
(rule ((CoordinateWindow function root index divisor width scale) (> width 1))
      ((set (CoordinateParts function root index) (set-of (Digit divisor width scale)))) :ruleset coordinate-analysis)
(rule ((CoordinateWindow function root index divisor width scale)
       (CoordinateScale function result index factor) (> factor 0)
       (<= factor 2147483647) (<= (* (* scale factor) width) 2147483647))
      ((CoordinateWindow function root result divisor width (* scale factor))) :ruleset coordinate-analysis)
(rule ((CoordinateWindow function root index divisor width 1)
       (CoordinateQuotient function result index factor) (> factor 0) (= (% width factor) 0))
      ((CoordinateWindow function root result (* divisor factor) (/ width factor) 1)) :ruleset coordinate-analysis)
(rule ((CoordinateWindow function root index divisor width 1)
       (CoordinateRemainder function result index factor) (> factor 0) (= (% width factor) 0))
      ((CoordinateWindow function root result divisor factor 1)) :ruleset coordinate-analysis)
(rule ((CoordinateSum function result a b)
       (= left (CoordinateParts function root a)) (= right (CoordinateParts function root b))
       (= (set-intersect left right) (set-empty)))
      ((set (CoordinateParts function root result) (set-union left right))) :ruleset coordinate-analysis)
(rule ((CoordinateAlias function result source) (= parts (CoordinateParts function root source)))
      ((set (CoordinateParts function root result) parts)) :ruleset coordinate-analysis)
(rule ((CoordinateAlias function result source) (CoordinateWindow function root source divisor width scale))
      ((CoordinateWindow function root result divisor width scale)) :ruleset coordinate-analysis)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexAdd a b)))
      ((CoordinateSum function (IndexAdd a b) a b)) :ruleset coordinate-analysis)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexMul a b)) (= n (StaticIndex function b)))
      ((CoordinateScale function (IndexMul a b) a n)) :ruleset coordinate-analysis)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexMul a b)) (= n (StaticIndex function a)))
      ((CoordinateScale function (IndexMul a b) b n)) :ruleset coordinate-analysis)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexDiv a b)) (= n (StaticIndex function b)))
      ((CoordinateQuotient function (IndexDiv a b) a n)) :ruleset coordinate-analysis)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexMod a b)) (= n (StaticIndex function b)))
      ((CoordinateRemainder function (IndexMod a b) a n)) :ruleset coordinate-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (IndexOp expression)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info)))
      ((CoordinateAlias function (IndexValue name) expression)) :ruleset coordinate-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Use (ValueOperand (Var source)))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info)))
      ((CoordinateAlias function (IndexValue name) (IndexValue source))) :ruleset coordinate-analysis)
(relation CoordinateBinary (Function ValueName String Atom Atom))
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (PrimOp opcode arguments)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= (vec-length arguments) 2))
      ((CoordinateBinary function name opcode (vec-get arguments 0) (vec-get arguments 1))) :ruleset coordinate-analysis)
(rule ((CoordinateBinary function name "+" (Var a) (Var b)))
      ((CoordinateSum function (IndexValue name) (IndexValue a) (IndexValue b))) :ruleset coordinate-analysis)
(rule ((CoordinateBinary function name "*" (Var a) b) (= (ConstantAtom function b) (LiteralBits (I32) n)))
      ((CoordinateScale function (IndexValue name) (IndexValue a) n)) :ruleset coordinate-analysis)
(rule ((CoordinateBinary function name "*" a (Var b)) (= (ConstantAtom function a) (LiteralBits (I32) n)))
      ((CoordinateScale function (IndexValue name) (IndexValue b) n)) :ruleset coordinate-analysis)
(rule ((CoordinateBinary function name "/" (Var a) b) (= (ConstantAtom function b) (LiteralBits (I32) n)))
      ((CoordinateQuotient function (IndexValue name) (IndexValue a) n)) :ruleset coordinate-analysis)
(rule ((CoordinateBinary function name "%" (Var a) b) (= (ConstantAtom function b) (LiteralBits (I32) n)))
      ((CoordinateRemainder function (IndexValue name) (IndexValue a) n)) :ruleset coordinate-analysis)

; Each output axis is contiguous in its own digits, and all input digits are
; used exactly once. Overlap and incomplete coverage cannot complete the proof.
(relation CoordinateWidth (CoordinateDigits CoordinateDigits i64))
(relation CoordinateCoverage (CoordinateDigits CoordinateDigits i64))
(rule ((= parts (CoordinateParts function root index)))
      ((CoordinateWidth parts parts 1)) :ruleset coordinate-analysis)
(rule ((CoordinateWidth parts remaining stride) (set-contains remaining digit)
       (= digit (Digit divisor width stride)) (<= (* stride width) 2147483647))
      ((CoordinateWidth parts (set-remove remaining digit) (* stride width))) :ruleset coordinate-analysis)
(rule ((CoordinateCoverage parts remaining divisor) (set-contains remaining digit)
       (= digit (Digit divisor width scale)) (<= (* divisor width) 2147483647))
      ((CoordinateCoverage parts (set-remove remaining digit) (* divisor width))) :ruleset coordinate-analysis)

; Range proofs simplify a guard only when it is true for every lane. This is
; also useful without fusion and preserves guards on incomplete gathers.
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (PrimOp "<" arguments))
       (= (vec-length arguments) 2) (= (vec-get arguments 0) (Var name))
       (= (ConstantAtom function (vec-get arguments 1)) (LiteralBits (I32) bound))
       (= parts (CoordinateParts function root (IndexValue name)))
       (CoordinateWidth parts (set-empty) width) (<= width bound))
      ((set (ReducedScalar function expression (Bool)) (LiteralBits (Bool) 1))) :ruleset coordinate-analysis)

(relation ReindexCandidate (Program Function Stm Stm Stm i64 ValueName i64))
(relation ReindexCoordinates (Stm Stm i64 CoordinateDigits))
(relation ReindexProof (Program Function Stm Stm Stm i64))
(relation ReindexApply (Program Function Stm Stm Stm Lambda Arguments))
(relation ReindexParameters (Domain Indices i64 Params Arguments IndexExp))
(function ReindexRow (ValueInfo i64) ValueInfo :no-merge)
(function ReindexReplacement (Stm Stm) Stms :no-merge)
(relation ReindexOutside (Program Function Stm Stm Renaming))
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStms (FunctionRoot function) statements) (AdjacentStatements statements producer consumer)
       (= producer (Let pid outputs proofs (Parallel execution domain body)))
       (= body (ParallelBlock code clauses)) (= values (ForwardedResults clauses))
       (= consumer (Let cid pattern certs (Parallel execution (IterationSpace flat axes) (ParallelBlock uses results))))
       (= (vec-length axes) 1) (= (vec-get axes 0) (DenseAxis index size))
       (= count (StaticIndex function size)) (> count 0)
       (= effects (EffectsStm function producer)) (ReadOnlyEffects effects)
       (= consumer-effects (EffectsStm function consumer))
       (WalkStms uses j) (< j (vec-length uses)) (= read (vec-get uses j))
       (= read (Let rid bindings read-certs (Load array indices)))
       (WalkPattern outputs slot) (< slot (vec-length outputs))
       (= (vec-get outputs slot) (BindValue array (ArrayValue element shape)))
       (= (vec-length indices) (vec-length shape))
       (= (vec-length values) (vec-length outputs)))
      ((CompareEffects effects consumer-effects)
       (ReindexCandidate program function producer consumer read slot index count)
       (ReindexCoordinates producer read 0 (set-empty))) :ruleset coordinate-analysis)
(rule ((ReindexCandidate program function producer consumer read slot root count)
       (= producer (Let pid outputs proofs expression))
       (= (vec-get outputs slot) (BindValue array (ArrayValue element shape)))
       (= read (Let rid pattern certs (Load array indices)))
       (ReindexCoordinates producer read i used) (< i (vec-length indices))
       (= parts (CoordinateParts function root (vec-get indices i)))
       (CoordinateWidth parts (set-empty) width) (= width (StaticIndex function (vec-get shape i)))
       (= (set-intersect used parts) (set-empty)))
      ((ReindexCoordinates producer read (+ i 1) (set-union used parts))) :ruleset coordinate-analysis)
(rule ((ReindexCandidate program function producer consumer read slot root count)
       (= read (Let rid pattern certs (Load array indices)))
       (ReindexCoordinates producer read (vec-length indices) parts))
      ((CoordinateCoverage parts parts 1)) :ruleset coordinate-analysis)
; ReindexProof is selected by the same calibrated repetition cost as map nests.
(rule ((ReindexProof program function producer consumer read slot)
       (= producer (Let pid outputs certs (Parallel execution domain body)))
       (= domain (IterationSpace flat axes)) (= read (Let rid pattern proofs (Load array indices))))
      ((ReindexParameters domain indices 0 (vec-of) (vec-of) (IndexConstant 0))) :ruleset coordinate-select)
(rule ((ReindexParameters domain indices i params arguments ordinal)
       (= domain (IterationSpace flat axes)) (< i (vec-length axes))
       (= (vec-get axes i) (DenseAxis index size)) (< i (vec-length indices)))
      ((ReindexParameters domain indices (+ i 1)
          (vec-push params (Parameter (BindValue index (ScalarInfo (ScalarElement (I32)))) (Observe)))
          (vec-push arguments (Pass (IndexOperand (vec-get indices i)) (Observe)))
          (IndexAdd (IndexMul ordinal size) (vec-get indices i)))) :ruleset coordinate-select)
(rule ((ReindexProof program function producer consumer read slot)
       (= producer (Let pid outputs certs (Parallel execution (IterationSpace flat axes) body)))
       (= (vec-get outputs slot) (BindValue array info)))
      ((set (ReindexRow info 0) info)) :ruleset coordinate-select)
(rule ((= (ReindexRow info i) (ArrayValue element shape)) (> (vec-length shape) 1))
      ((set (ReindexRow info (+ i 1)) (ArrayValue element (vec-remove shape 0)))) :ruleset coordinate-select)
(rule ((= (ReindexRow info i) (ArrayValue element shape)) (= (vec-length shape) 1))
      ((set (ReindexRow info (+ i 1)) (ScalarInfo element))) :ruleset coordinate-select)
(rule ((ReindexProof program function producer consumer read slot)
       (= producer (Let pid outputs certs (Parallel execution domain (ParallelBlock code clauses))))
       (= domain (IterationSpace flat axes)) (= read (Let rid bindings proofs (Load array indices)))
       (= (vec-get outputs slot) (BindValue array info)) (= values (ForwardedResults clauses))
       (= row (ReindexRow info (vec-length axes))) (= returns (LaneReturn row))
       (ReindexParameters domain indices (vec-length axes) params arguments ordinal))
      ((let lambda (FunctionBody
          (vec-push params (Parameter (BindValue flat (ScalarInfo (ScalarElement (I32)))) (Observe)))
          (vec-of returns) (Block code (vec-of (vec-get values slot)))))
       (let args (vec-push arguments (Pass (IndexOperand ordinal) (Observe))))
       (ReindexApply program function producer consumer read lambda args)
       (ApplyLambdaDemand (FusionStatement rid) (vec-of (BindValue (CallValue (FusionStatement rid) array) row))
          certs lambda args)) :ruleset coordinate-select)
(rule ((ReindexApply program function producer consumer read lambda arguments)
       (= producer (Let pid outputs certs (Parallel execution domain body)))
       (= domain (IterationSpace flat axes)) (= read (Let rid bindings proofs (Load array indices)))
       (= lambda (FunctionBody params signature (Block code results)))
       (= (vec-length indices) (vec-length axes))
       (= expanded (ApplyLambda (FusionStatement rid)
          (vec-of (BindValue (CallValue (FusionStatement rid) array) (ScalarInfo element))) certs lambda arguments))
       (= (BindingInfo function array) (ArrayValue element shape)))
      ((set (ReindexReplacement producer read) (vec-append expanded (vec-of
          (Let rid bindings proofs (Use (ValueOperand (Var (CallValue (FusionStatement rid) array))))))))) :ruleset coordinate-select)
(function ReindexSuffix (Indices i64) Indices :no-merge)
(rule ((ReindexApply program function producer consumer (Let rid bindings proofs (Load array indices)) lambda arguments))
      ((set (ReindexSuffix indices 0) indices)) :ruleset coordinate-select)
(rule ((= suffix (ReindexSuffix indices i)) (> (vec-length suffix) 0))
      ((set (ReindexSuffix indices (+ i 1)) (vec-remove suffix 0))) :ruleset coordinate-select)
(rule ((ReindexApply program function producer consumer read lambda arguments)
       (= producer (Let pid outputs certs (Parallel execution domain body)))
       (= domain (IterationSpace flat axes)) (= read (Let rid bindings proofs (Load array indices)))
       (> (vec-length indices) (vec-length axes)) (= info (BindingInfo function array))
       (= row (ReindexRow info (vec-length axes)))
       (= expanded (ApplyLambda (FusionStatement rid)
          (vec-of (BindValue (CallValue (FusionStatement rid) array) row)) certs lambda arguments))
       (= suffix (ReindexSuffix indices (vec-length axes))))
      ((set (ReindexReplacement producer read) (vec-append expanded (vec-of
          (Let rid bindings proofs (Load (CallValue (FusionStatement rid) array) suffix)))))) :ruleset coordinate-select)
(rule ((ReindexApply program function producer consumer read lambda arguments)
       (= producer (Let pid outputs certs expression)) (= read (Let rid bindings proofs access))
       (= replacement (ReindexReplacement producer read)))
      ((let env (Rename (map-empty) (map-empty) (map-empty) (map-empty)
          (map-insert (map-insert (map-empty) pid (vec-of)) rid replacement)))
       (ReindexOutside program function producer read env) (RenameFunctionDemand env function)) :ruleset coordinate-select)
(rule ((ReindexOutside program function producer read env) (CurrentProgram program)
       (= producer (Let pid outputs certs expression)) (= next (RenameFunction env function))
       (= (set-intersect (BindersPattern outputs) (NamesFunction next)) (set-empty)))
      ((set (PendingRewrite "fusion" program) (set-of env)) (RewriteDemand "fusion" program)) :ruleset coordinate-select)
