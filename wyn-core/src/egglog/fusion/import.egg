(rule ((CurrentProgram program) (= program (MemoryProgram functions externals entries)))
      ((ProgramFunctionAt program 0)) :ruleset fusion-index)
(rule ((ProgramFunctionAt program i)
       (= program (MemoryProgram functions externals entries))
       (< i (vec-size functions))
       (= function (FunctionsAt functions i)))
      ((ProgramFunction program function)
       (CheckFunction function)
       (EffectContext function)
       (ProgramFunctionAt program (+ i 1))) :ruleset fusion-index)
(rule ((= body (ParallelBlock statements results)))
      ((ContainsParallelBody (ParallelRoot body) body)) :ruleset memory-names)

; Domain equality includes dependent dimensions and offsets after alpha-renaming.
(rule ((FusionPair program function
         (Let a pa ca (Parallel execution left ba))
         (Let b pb cb (Parallel execution right bb)))
       (= left (IterationSpace x xs)) (= right (IterationSpace y ys))
       (= (vec-size xs) (vec-size ys)))
      ((MatchDomainAt function left right 0 (map-insert (map-empty) y x))) :ruleset fusion-domains)
(rule ((MatchDomainAt function left right i names)
       (= left (IterationSpace x xs))
       (= right (IterationSpace y ys))
       (< i (vec-size xs))
       (= (DomainAxesAt xs i) (DenseAxis a n))
       (= (DomainAxesAt ys i) (DenseAxis b m)))
      ((RenameIndexExpDemand (Rename names (map-empty) (map-empty) (map-empty) (map-empty)) m)) :ruleset fusion-domains)
(rule ((ContainsIndexExp (FunctionRoot function) extent))
      ((MatchingExtent function extent extent)) :ruleset fusion-domains)
(rule ((= n (StaticIndex function left)) (= n (StaticIndex function right)))
      ((MatchingExtent function left right)) :ruleset fusion-domains)
(rule ((CountLength function left source) (CountLength function right source))
      ((MatchingExtent function left right)) :ruleset fusion-domains)
(rule ((MatchDomainAt function left right i names)
       (= left (IterationSpace x xs))
       (= right (IterationSpace y ys))
       (< i (vec-size xs))
       (= (DomainAxesAt xs i) (DenseAxis a n))
       (= (DomainAxesAt ys i) (DenseAxis b m))
       (= renamed (RenameIndexExp (Rename names (map-empty) (map-empty) (map-empty) (map-empty)) m))
       (MatchingExtent function n renamed))
      ((MatchDomainAt function left right (+ i 1) (map-insert names b a))) :ruleset fusion-domains)
(rule ((MatchDomainAt function left right i names) (= left (IterationSpace x xs)) (= i (vec-size xs)))
      ((set (DomainRenaming function left right) (Rename names (map-empty) (map-empty) (map-empty) (map-empty)))) :ruleset fusion-domains)

(rule ((= results (vec-of))) ((set (ForwardedResults results) (vec-of))) :ruleset fusion-forward)
(rule ((= body (ParallelBlock statements results)))
      ((set (ForwardedPrefix results 0) (vec-of))) :ruleset fusion-forward)
(rule ((= prefix (ForwardedPrefix results i))
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Collect values)))
      ((set (ForwardedPrefix results (+ i 1)) (vec-append prefix values))) :ruleset fusion-forward)
(rule ((= values (ForwardedPrefix results (vec-size results))))
      ((set (ForwardedResults results) values)) :ruleset fusion-forward)

; Indexing a collected value at its producer coordinate returns the complete
; logical value, including products and nested arrays.
(relation MatchingIndices (Atoms Indices i64))
(rule ((MatchingIndices atoms indices i) (< i (vec-size indices)))
      ((set (IndicesAt indices i) (vec-at indices i))) :ruleset fusion-forward)
(rule ((MatchingIndices atoms indices i)
       (< i (vec-size atoms))
       (< i (vec-size indices))
       (= (AtomsAt atoms i) (Var name))
       (= (IndicesAt indices i) (IndexValue name)))
      ((MatchingIndices atoms indices (+ i 1))) :ruleset fusion-forward)

(rule ((CurrentProgram program) (= program (MemoryProgram functions externals entries)))
      ((ProgramExternalAt program 0)) :ruleset fusion-index)
(rule ((ProgramExternalAt program i)
       (= program (MemoryProgram functions externals entries))
       (< i (vec-size externals))
       (= external (ExternalsAt externals i)))
      ((ProgramExternal program external)
       (CheckExternal external)
       (ProgramExternalAt program (+ i 1))) :ruleset fusion-index)

(rule ((CurrentProgram program)) ((ContainsProgram (ProgramRoot program) program)) :ruleset memory-names)

; Forward a complete row just as a scalar element. Views preserve the row's
; binding and let ordinary memory operations consume arbitrary element shapes.

(function ForwardedTokens (AccNames i64) Results :no-merge)
(rule ((= clause (Contribute tokens)))
      ((set (ForwardedTokens tokens 0) (vec-of))) :ruleset memory-names)
(rule ((= prefix (ForwardedTokens tokens i)) (< i (vec-size tokens)))
      ((set (ForwardedTokens tokens (+ i 1)) (vec-push prefix (Yield (vec-of) (AccOperand (vec-at tokens i)))))) :ruleset memory-names)
(rule ((= prefix (ForwardedPrefix results i))
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Contribute tokens))
       (= values (ForwardedTokens tokens (vec-size tokens))))
      ((set (ForwardedPrefix results (+ i 1)) (vec-append prefix values))) :ruleset fusion-forward)
