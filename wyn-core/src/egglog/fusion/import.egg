(rule ((CurrentProgram program) (= program (MemoryProgram functions externals entries)))
      ((ProgramFunctionAt program 0)) :ruleset fusion-index)
(rule ((ProgramFunctionAt program i) (= program (MemoryProgram functions externals entries))
       (< i (vec-length functions)) (= function (vec-get functions i)))
      ((ProgramFunction program function) (CheckFunction function) (EffectContext function)
       (ProgramFunctionAt program (+ i 1))) :ruleset fusion-index)
(rule ((= body (ParallelBlock statements results)))
      ((ContainsParallelBody (ParallelRoot body) body)) :ruleset memory-names)

; Domain equality includes dependent dimensions and offsets after alpha-renaming.
(rule ((FusionPair program function
         (Let a pa ca (Parallel execution left ba))
         (Let b pb cb (Parallel execution right bb)))
       (= left (IterationSpace x xs)) (= right (IterationSpace y ys))
       (= (vec-length xs) (vec-length ys)))
      ((MatchDomainAt left right 0 (map-insert (map-empty) y x))) :ruleset fusion-domains)
(rule ((MatchDomainAt left right i names)
       (= left (IterationSpace x xs)) (= right (IterationSpace y ys))
       (< i (vec-length xs)) (= (vec-get xs i) (DenseAxis a n)) (= (vec-get ys i) (DenseAxis b m)))
      ((MatchDomainAt left right (+ i 1) (map-insert names b a))) :ruleset fusion-domains)
(rule ((MatchDomainAt left right i names)
       (= left (IterationSpace x xs)) (= right (IterationSpace y ys))
       (< i (vec-length xs)) (= (vec-get xs i) (RaggedAxis a offsets parent))
       (= (vec-get ys i) (RaggedAxis b other next)))
      ((MatchDomainAt left right (+ i 1) (map-insert names b a))) :ruleset fusion-domains)
(rule ((MatchDomainAt left right i names) (= left (IterationSpace x xs)) (= i (vec-length xs)))
      ((RenameDomainDemand (Rename names (map-empty) (map-empty) (map-empty) (map-empty)) right)) :ruleset fusion-domains)
(rule ((MatchDomainAt left right i names) (= left (IterationSpace x xs)) (= i (vec-length xs))
       (= env (Rename names (map-empty) (map-empty) (map-empty) (map-empty)))
       (= left (RenameDomain env right)))
      ((set (DomainRenaming left right) env)) :ruleset fusion-domains)

(rule ((= results (vec-of))) ((set (ForwardedResults results) (vec-of))) :ruleset fusion-forward)
(rule ((= body (ParallelBlock statements results)))
      ((set (ForwardedPrefix results 0) (vec-of))) :ruleset fusion-forward)
(rule ((= prefix (ForwardedPrefix results i)) (< i (vec-length results)) (= (vec-get results i) (Collect values)))
      ((set (ForwardedPrefix results (+ i 1)) (vec-append prefix values))) :ruleset fusion-forward)
(rule ((= values (ForwardedPrefix results (vec-length results))))
      ((set (ForwardedResults results) values)) :ruleset fusion-forward)

(rule ((ForwardAt pattern results body indices i) (< i (vec-length pattern)) (< i (vec-length results)))
      ((ForwardAt pattern results body indices (+ i 1))) :ruleset fusion-forward)
(rule ((ForwardAt pattern results body indices i) (< i (vec-length pattern)) (< i (vec-length results))
       (= (vec-get pattern i) (BindValue array info)) (= element (ArrayElement info))
       (= (vec-get results i) (Yield proofs value))
       (ContainsStm (ParallelRoot body) (Let id vector-pattern-0 certs (Load array indices)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue output (ScalarInfo element))))
      ((set (ForwardLoads pattern results body indices)
         (set-of (ReplaceStatement id (Let id (vec-of (BindValue output (ScalarInfo element)))
             (vec-append certs proofs) (Use value)))))) :ruleset fusion-forward)
(rule ((ForwardAt pattern results body indices 0))
      ((set (ForwardLoads pattern results body indices) (set-empty))) :ruleset fusion-forward)
; Conversion reads the completed immutable replacement set, never a partial map.
(rule ((= replacements (ForwardLoads pattern results body indices)))
      ((ReplacementMapDemand replacements)) :ruleset fusion-select)

(rule ((CurrentProgram program) (= program (MemoryProgram functions externals entries)))
      ((ProgramExternalAt program 0)) :ruleset fusion-index)
(rule ((ProgramExternalAt program i) (= program (MemoryProgram functions externals entries))
       (< i (vec-length externals)) (= external (vec-get externals i)))
      ((ProgramExternal program external) (CheckExternal external)
       (ProgramExternalAt program (+ i 1))) :ruleset fusion-index)

(rule ((CurrentProgram program)) ((ContainsProgram (ProgramRoot program) program)) :ruleset memory-names)

; Forward a complete row just as a scalar element. Views preserve the row's
; binding and let ordinary memory operations consume arbitrary element shapes.
(rule ((ForwardAt pattern results body indices i) (< i (vec-length pattern)) (< i (vec-length results))
       (= (vec-get pattern i) (BindValue array info))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var source))))
       (= slices (PointSlices indices (vec-length indices)))
       (ContainsBinding root (BindValue source row-info))
       (= row-info (ArrayValue element shape))
       (ContainsStm (ParallelRoot body) (Let id output certs (View array slices)))
       (= (vec-length output) 1) (= (vec-get output 0) (BindValue name row-info)))
      ((set (ForwardLoads pattern results body indices) (set-of
          (ReplaceStatement id (Let id output (vec-append certs proofs) (Use (ValueOperand (Var source)))))))) :ruleset fusion-forward)

(function ForwardedTokens (AccNames i64) Results :no-merge)
(rule ((= clause (Contribute tokens)))
      ((set (ForwardedTokens tokens 0) (vec-of))) :ruleset fusion-forward)
(rule ((= prefix (ForwardedTokens tokens i)) (< i (vec-length tokens)))
      ((set (ForwardedTokens tokens (+ i 1)) (vec-push prefix (Yield (vec-of) (AccOperand (vec-get tokens i)))))) :ruleset fusion-forward)
(rule ((= prefix (ForwardedPrefix results i)) (< i (vec-length results)) (= (vec-get results i) (Contribute tokens))
       (= values (ForwardedTokens tokens (vec-length tokens))))
      ((set (ForwardedPrefix results (+ i 1)) (vec-append prefix values))) :ruleset fusion-forward)
