; Bridge immutable source facts to the retained quotient-graph fusion planner.
(ruleset source-fusion)
(rule ((SourceOperation op region kind))
      ((Current (Group op) (FusionSource op)) (Member (Group op) op)
       (set (Owner (FusionSource op)) op) (set (PlanScope (FusionSource op)) region)
       (set (IterationDomain (FusionSource op)) (SourceDomain op))
       (set (DirectInputs (Group op)) (set-empty)) (set (SelfUses (Group op)) (set-empty))
       (set (InputUses (Group op)) (set-empty)) (set (GroupUsesOf (Group op)) (set-empty))
       (set (GroupLengths (Group op)) (set-empty)) (set (ValidLengths (Group op)) (set-empty))
       (set (GroupInputs (Group op)) (set-empty))
       (set (InternalInputs (Group op)) (set-empty))) :ruleset source-fusion)
(relation SourceScrema (OperationKey))
(rule ((SourceOperation op r "map")) ((SourceScrema op)) :ruleset source-fusion)
(rule ((SourceOperation op r "scan")) ((SourceScrema op)) :ruleset source-fusion)
(rule ((SourceOperation op r "reduce")) ((SourceScrema op)) :ruleset source-fusion)
(rule ((SourceScrema op)) ((ScremaPlan (FusionSource op))) :ruleset source-fusion)
(rule ((SourceOperation op r "filter")) ((FilterPlan (FusionSource op))) :ruleset source-fusion)
(relation SourceArrayProducer (OperationKey))
(rule ((SourceOperation op r "map")) ((SourceArrayProducer op)) :ruleset source-fusion)
(rule ((SourceOperation op r "scan")) ((SourceArrayProducer op)) :ruleset source-fusion)
(rule ((SourceOperation op r "filter")) ((SourceArrayProducer op)) :ruleset source-fusion)
(rule ((= value (SourceOperationValue op)) (= safe (SourcePure value)))
      ((set (PrePure (FusionSource op)) safe) (set (PostPure (FusionSource op)) safe)
       (set (PredicatePure (FusionSource op)) safe)) :ruleset source-fusion)
(rule ((= value (SourceOperationValue op)) (= (SourcePure value) true)) ((SafePlan (FusionSource op))) :ruleset source-fusion)
; Deterministic partial callbacks may stream over the same whole domain. This
; does not authorize speculation, slicing away evaluations, or indexed reuse.
(rule ((SourceScrema op) (= body (SourceOperatorBody op)) (= (SourceRegionDuplicable body) true)
       (= value (SourceOperationValue op)) (= (SourceReadOnly value) true))
      ((StreamPlan (FusionSource op))) :ruleset source-fusion)
(rule ((SourceOperation op r "filter") (SafePlan (FusionSource op))) ((ElementPlan (FusionSource op))) :ruleset source-fusion)
(rule ((SourceScrema op) (= value (SourceOperationValue op)) (= (SourceReadOnly value) true)) ((FilterPostMapPlan (FusionSource op))) :ruleset source-fusion)
(rule ((SourceOperation op r "filter") (= value (SourceOperationValue op)) (= (SourceReadOnly value) true)) ((ReadOnlyFilterPlan (FusionSource op))) :ruleset source-fusion)
; Initialize group sets before merging uses into them during import.
(rule ((SourceDepends consumer producer role) (= uses (GroupUsesOf (Group producer))))
      ((GroupEdge (Group producer) (Group consumer))
       (set (GroupUsesOf (Group producer)) (set-of (UseAt consumer role)))
       (GroupUseFact (Group producer) (To (Group consumer) role))) :ruleset source-fusion)
(rule ((SourceDepends consumer producer (LengthUse)) (= lengths (GroupLengths (Group producer))))
      ((set (GroupLengths (Group producer)) (set-of (UseAt consumer (LengthUse))))) :ruleset source-fusion)
(rule ((ImportedEffectOrder before after)) ((GroupBefore (Group before) (Group after))) :ruleset source-fusion)
(rule ((SourceObserved op)) ((GroupUseFact (Group op) (Returned))) :ruleset source-fusion)
(rule ((= input (SourceInput consumer i)) (= (Identity input) (Identity source)) (= source (SourceOperationValue producer)))
      ((InputFact (Group consumer) (Direct producer))
       (WholeStream (Group producer) (Group consumer))) :ruleset source-fusion)
(rule ((= input (SourceInput consumer i)) (= (SourceHasOrigin input) false) (= token (SourceOrdinal input)))
      ((InputFact (Group consumer) (External token))) :ruleset source-fusion)
(rule ((= input (SourceInput op 0)) (= token (SourceIdentityToken (Identity input))))
      ((union (SourceDomain op) (DomainValue token))) :ruleset source-fusion)
(rule ((= input (SourceInput op 0)) (= (SourceExtent input) (Fixed n)))
      ((union (SourceDomain op) (FixedDomain n))) :ruleset source-fusion)
; Scan-derived inputs remain barrier-bearing through field-sensitive uses.
(rule ((SourceDepends consumer producer role) (SourceOperation producer r "scan"))
      ((SourceScanDependency producer consumer)) :ruleset source-fusion)

(rule ((SourceOperation op r kind) (= body (SourceOperatorBody op)) (= (SourceRegionPure body) true)
       (!= kind "map") (!= kind "reduce") (!= kind "scan") (!= kind "filter"))
      ((ElementPlan (FusionSource op))) :ruleset source-fusion)

(rule ((= value (SourceOperationValue consumer)) (= array (SourceLength value))
       (= (Identity array) (Identity source)) (= source (SourceOperationValue producer)))
      ((set (ValidLengths (Group producer)) (set-of (UseAt consumer (LengthUse))))) :ruleset source-fusion)
