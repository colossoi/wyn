; Target-independent preferences over optimized scalar expressions. Target
; readout may decline unsupported operations without changing any graph facts.
(relation HostEvalValue (Expr))
(relation HostEvalArgs (ExprArgs))
(relation HostEvalPreferred (Expr))
(ruleset scalar-host)
(rule ((= e (ExprLiteral ctx t value))) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprParameter ctx t r i)) (HostEvalParameter r i)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprLeaf ctx t source)) (HostEvalLeaf source)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= xs (ExprNil ctx))) ((HostEvalArgs xs)) :ruleset scalar-host)
(rule ((= xs (ExprCons ctx x tail)) (HostEvalValue x) (HostEvalArgs tail)) ((HostEvalArgs xs)) :ruleset scalar-host)
(rule ((= e (ExprUnary ctx t op x)) (HostEvalValue x) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(rule ((= e (ExprBinary ctx t op x y)) (HostEvalValue x) (HostEvalValue y) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(rule ((= e (ExprOp ctx t op args)) (HostEvalArgs args) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(rule ((= e (ExprProject ctx t x i)) (HostEvalValue x)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprCoerce ctx t x)) (HostEvalValue x)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprTuple ctx t args)) (HostEvalArgs args)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprVector ctx t args)) (HostEvalArgs args)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprChoice ctx t c a b)) (HostEvalValue c) (HostEvalValue a) (HostEvalValue b) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(run-schedule (saturate scalar-host))
