; Candidate host targets; final readout resolves which computations are supported.
(ruleset host-targets)
(relation HostTarget (RootKey SourceValue ExprContext ValueKey))
(rule ((= (OutputWriter output) (EntryRoot entry)) (= (SourceDefinition entry) scope)
       (= (SourceOutput output) (OutputInfo entry source ty array)) (= context (ExprContextForScope scope))
       (= (OutputBacking output) value) (= storage (Backing value)))
      ((HostTarget (EntryRoot entry) source context storage)) :ruleset host-targets)
(rule ((= (OutputWriter output) (KernelRoot (Stage op "scalar")))
       (= (SourceOutput output) (OutputInfo entry source ty array))
       (= (OutputBacking output) value) (= storage (Backing value)))
      ((HostTarget (KernelRoot (Stage op "scalar")) source (ExprContextDispatch op) storage)) :ruleset host-targets)
(rule ((DispatchGroupLeader op leader) (Phase (Stage leader "scalar") region)
       (= source (SourceOperationValue op)) (= value (BufferSlot op "scalar" 0)) (= storage (Backing value)))
      ((HostTarget (KernelRoot (Stage leader "scalar")) source (ExprContextDispatch leader) storage)) :ruleset host-targets)
; Callback roots identify the actual phase consumers of scalar host preferences.
(relation HostEvalPhaseRoot (StageKey ExprContext SourceValue))
(relation HostEvalParameter (RegionKey i64))
(relation HostEvalLeaf (SourceValue))
(rule ((PhaseCallback stage region) (= source (SourceResult region)) (= context (ExprContextForScope region)))
      ((HostEvalPhaseRoot stage context source)) :ruleset host-targets)
(rule ((SourceEntryParameter region i bound false) (= source (SourceParameter region i)))
      ((HostEvalParameter region i) (HostEvalLeaf source)) :ruleset host-targets)
(rule ((= (SourceCapture region formal) actual) (HostEvalLeaf actual))
      ((HostEvalLeaf formal)) :ruleset host-targets)

; Target-independent preferences over optimized scalar expressions. Target
; readout may decline unsupported operations without changing any graph facts.
(relation HostEvalValue (Expr))
(relation HostEvalArgs (ExprArgs))
(relation HostEvalPreferred (Expr))
(ruleset scalar-host)
(rule ((= e (ExprLiteral ctx t value))) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprParameter ctx t r i)) (HostEvalParameter r i)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprLeaf ctx t source)) (HostEvalLeaf source)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= xs (ExprNil ctx))) ((HostEvalArgs xs)) :ruleset scalar-host)
(rule ((= xs (ExprCons ctx x tail)) (HostEvalValue x) (HostEvalArgs tail)) ((HostEvalArgs xs)) :ruleset scalar-host)
(rule ((= e (ExprUnary ctx t op x)) (HostEvalValue x) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(rule ((= e (ExprBinary ctx t op x y)) (HostEvalValue x) (HostEvalValue y) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(rule ((= e (ExprOp ctx t op args)) (HostEvalArgs args) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
(rule ((= e (ExprProject ctx t x i)) (HostEvalValue x)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprTuple ctx t args)) (HostEvalArgs args)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprVector ctx t args)) (HostEvalArgs args)) ((HostEvalValue e)) :ruleset scalar-host)
(rule ((= e (ExprChoice ctx t c a b source)) (HostEvalValue c) (HostEvalValue a) (HostEvalValue b) (ExprTotal e))
      ((HostEvalValue e) (HostEvalPreferred e)) :ruleset scalar-host)
