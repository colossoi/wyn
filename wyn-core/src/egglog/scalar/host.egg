; Target-independent preferences over optimized scalar expressions. Target
; readout may decline unsupported operations without changing any graph facts.
(relation ScalarHostValue (ScalarExpr))
(relation ScalarHostArgs (ScalarArgs))
(relation ScalarPreferHost (ScalarExpr))
(ruleset scalar-host)
(rule ((= e (ScalarLiteral ctx t value))) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= e (ScalarParameter ctx t r i)) (ScalarHostParameter r i)) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= e (ScalarLeaf ctx t source)) (ScalarHostLeaf source)) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= xs (ScalarNil ctx))) ((ScalarHostArgs xs)) :ruleset scalar-host)
(rule ((= xs (ScalarCons ctx x tail)) (ScalarHostValue x) (ScalarHostArgs tail)) ((ScalarHostArgs xs)) :ruleset scalar-host)
(rule ((= e (ScalarUnary ctx t op x)) (ScalarHostValue x) (ScalarTotal e))
      ((ScalarHostValue e) (ScalarPreferHost e)) :ruleset scalar-host)
(rule ((= e (ScalarBinary ctx t op x y)) (ScalarHostValue x) (ScalarHostValue y) (ScalarTotal e))
      ((ScalarHostValue e) (ScalarPreferHost e)) :ruleset scalar-host)
(rule ((= e (ScalarOp ctx t op args)) (ScalarHostArgs args) (ScalarTotal e))
      ((ScalarHostValue e) (ScalarPreferHost e)) :ruleset scalar-host)
(rule ((= e (ScalarProject ctx t x i)) (ScalarHostValue x)) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= e (ScalarCoerce ctx t x)) (ScalarHostValue x)) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= e (ScalarTuple ctx t args)) (ScalarHostArgs args)) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= e (ScalarVector ctx t args)) (ScalarHostArgs args)) ((ScalarHostValue e)) :ruleset scalar-host)
(rule ((= e (ScalarChoice ctx t c a b)) (ScalarHostValue c) (ScalarHostValue a) (ScalarHostValue b) (ScalarTotal e))
      ((ScalarHostValue e) (ScalarPreferHost e)) :ruleset scalar-host)
(run-schedule (saturate scalar-host))
