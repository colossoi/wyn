; Scalar terms share the structural graph, but rules match only this vocabulary.
; Source leaves are existing values, not re-evaluations of their definitions.
(datatype ScalarContext (ScalarFunction RegionKey) (ScalarKernel FusionPlan) (ScalarDispatch OperationKey) (ScalarTemplate RegionKey))
(sort ScalarExpr)
(sort ScalarArgs)
(constructor ScalarLeaf (ScalarContext TypeKey SourceValue) ScalarExpr)
(constructor ScalarParameter (ScalarContext TypeKey RegionKey i64) ScalarExpr)
(constructor ScalarLiteral (ScalarContext TypeKey String) ScalarExpr)
(constructor ScalarOp (ScalarContext TypeKey String ScalarArgs) ScalarExpr)
(constructor ScalarInvoke (ScalarContext TypeKey RegionKey ScalarArgs) ScalarExpr)
(constructor ScalarChoice (ScalarContext TypeKey ScalarExpr ScalarExpr ScalarExpr) ScalarExpr)
(constructor ScalarTuple (ScalarContext TypeKey ScalarArgs) ScalarExpr)
(constructor ScalarVector (ScalarContext TypeKey ScalarArgs) ScalarExpr)
(constructor ScalarProject (ScalarContext TypeKey ScalarExpr i64) ScalarExpr)
(constructor ScalarCoerce (ScalarContext TypeKey ScalarExpr) ScalarExpr)
; Substitution is a rewrite mechanism, never an executable expression.
(constructor ScalarSub (ScalarContext ScalarExpr RegionKey ScalarArgs) ScalarExpr :unextractable)
(constructor ScalarNil (ScalarContext) ScalarArgs)
(constructor ScalarCons (ScalarContext ScalarExpr ScalarArgs) ScalarArgs)
(constructor ScalarSubArgs (ScalarContext ScalarArgs RegionKey ScalarArgs) ScalarArgs :unextractable)
(function ScalarArgumentAt (ScalarArgs i64) ScalarExpr :no-merge)
(relation ScalarType (TypeKey String))
(relation ScalarInteger (TypeKey))
(relation ScalarOperatorSafe (TypeKey String))
(relation ScalarInlineBody (RegionKey ScalarExpr))
(relation ScalarRoot (ScalarContext RegionKey SourceValue ScalarExpr))
(relation ScalarTotal (ScalarContext ScalarExpr))
(relation ScalarArgsTotal (ScalarContext ScalarArgs))
; Selected invocation descriptors preserve scans, accumulators, masks and routes.
; They never match old candidate plans or substitute array values for elements.
(relation ScalarInvocation (FusionPlan OperationKey RegionKey ScalarExpr))
(ruleset scalar-analysis)
(ruleset scalar-inline)
(ruleset scalar-micro)

(relation ScalarSelectedPlacement (ScalarContext ScalarExpr RegionKey))
(function ScalarTemplateSafe (RegionKey) bool :merge (and old new))
(relation ScalarActive (ScalarContext))
(relation ScalarContextScope (ScalarContext RegionKey))
