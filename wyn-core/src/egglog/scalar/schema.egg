; Scalar terms share the structural graph, but rules match only this vocabulary.
; Source leaves are existing values, not re-evaluations of their definitions.
(datatype ExprContext (ExprContextFunction RegionKey) (ExprContextKernel FusionPlan) (ExprContextDispatch OperationKey) (ExprContextTemplate RegionKey) (ExprContextDimensions))
(function ExprContextForScope (RegionKey) ExprContext :no-merge)
(function ExprContextForSource (SourceValue) ExprContext :no-merge)
(function ExprContextOwner (SourceValue) RegionKey :no-merge)
(function ExprContextHome (RegionKey) RegionKey :no-merge)
(sort Expr)
(sort ExprArgs)
; A native vector groups roots for shared extraction after optimization.
(sort ExprOutputs (Vec Expr))
(constructor ExprLeaf (ExprContext TypeKey SourceValue) Expr)
; Execute a selected local boundary; it must never read its own stored result.
(constructor ExprExecute (ExprContext TypeKey SourceValue) Expr)
(constructor ExprInstruction (ExprContext TypeKey SourceValue String ExprArgs) Expr)
(constructor ExprCall (ExprContext TypeKey SourceValue RegionKey ExprArgs) Expr)
(constructor ExprParameter (ExprContext TypeKey RegionKey i64) Expr)
(constructor ExprLength (ExprContext TypeKey SourceValue) Expr)
(constructor ExprLiteral (ExprContext TypeKey String) Expr)
(constructor ExprUnary (ExprContext TypeKey String Expr) Expr)
(constructor ExprBinary (ExprContext TypeKey String Expr Expr) Expr)
(constructor ExprOp (ExprContext TypeKey String ExprArgs) Expr)
(constructor ExprInvoke (ExprContext TypeKey RegionKey ExprArgs) Expr)
; Retain the source boundary for value-specific layouts of inferred arrays.
(constructor ExprChoice (ExprContext TypeKey Expr Expr Expr SourceValue) Expr)
(constructor ExprTuple (ExprContext TypeKey ExprArgs) Expr)
(constructor ExprVector (ExprContext TypeKey ExprArgs) Expr)
(constructor ExprProject (ExprContext TypeKey Expr i64) Expr)
(constructor ExprCoerce (ExprContext TypeKey Expr) Expr)
; Substitution is a rewrite mechanism, never an executable expression.
(constructor ExprSub (ExprContext Expr RegionKey ExprArgs) Expr :unextractable)
(constructor ExprNil (ExprContext) ExprArgs)
(constructor ExprCons (ExprContext Expr ExprArgs) ExprArgs)
(constructor ExprSubArgs (ExprContext ExprArgs RegionKey ExprArgs) ExprArgs :unextractable)
(function ExprArgumentAt (ExprArgs i64) Expr :no-merge)
(relation ExprPrimitiveType (TypeKey String))
(relation ExprIntegerType (TypeKey))
(relation ExprOperatorTotal (TypeKey String))
(relation ExprRecordUpdateOperator (String))
(relation ExprTemplateBody (RegionKey Expr))
(relation ExprRoot (ExprContext RegionKey SourceValue Expr))
; Expression identities already carry their optimization context.
(relation ExprTotal (Expr))
(relation ExprArgsTotal (ExprArgs))
; Effects of materialization, including definitions reached through leaves.
; An effectful alternative must not acquire a proof through e-class merging.
(function ExprReadOnly (Expr) bool :merge (and old new))
(function ExprArgsReadOnly (ExprArgs) bool :merge (and old new))
; Callback contexts refer to selected fusion plans; scalar expressions stay
; in the scalar graph and are queried directly during SSA emission.
(ruleset scalar-analysis)
(ruleset scalar-effects)
(ruleset scalar-inline)
(ruleset scalar-substitute)
(ruleset scalar-arguments)
(ruleset scalar-micro)

(function ExprTemplateSafe (RegionKey) bool :merge (and old new))
(relation ExprContextActive (ExprContext))
(relation ExprContextMember (ExprContext RegionKey))
