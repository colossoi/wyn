; Project exact selected syntax into the shared flow model. No e-class-wide
; operand query is allowed: unselected alternatives must not become dependencies.
(ruleset selected-shape)
(ruleset selected-address)
(ruleset selected-flow)
(relation SelectedExecutable (i64))
(function SelectedOperandStart (i64) i64 :merge (min old new))
(relation SelectedOwned (String))
(SelectedOwned "ExprLeaf") (SelectedOwned "ExprExecute")
(SelectedOwned "ExprInstruction") (SelectedOwned "ExprCall")
(function SelectedArgument (i64 i64) i64 :no-merge)
(function SelectedBase (i64) i64 :no-merge)
(function SelectedIsIndex (i64) bool :merge (or old new))
(relation SelectedIndex (i64 i64 i64))
(function SelectedAddressBase (i64) i64 :no-merge)
(function SelectedAddressDepth (i64) i64 :no-merge)
(function SelectedAddressIndex (i64 i64) i64 :no-merge)
(relation EvaluationBoundary (ExprContext SourceValue RegionKey i64))
(relation EvaluationScopeCycle ())
(relation SelectedExecutionSource (i64 SourceValue))
(function EvaluationOrdinal (i64) i64 :no-merge)

(rule ((= expr (SelectedExpr term))) ((SelectedExecutable term)) :ruleset selected-shape)
(rule ((SelectedExecutable term) (= child (SelectedField term i)) (SelectedExecutable child))
      ((set (SelectedOperandStart term) i)) :ruleset selected-shape)
(rule ((= args (SelectedArgs term))) ((SelectedExecutable term)) :ruleset selected-shape)
(rule ((SelectedExecutable term) (= context (SelectedContext (SelectedField term 0))))
      ((FlowNode term) (EvaluationTermContext term context)
       (set (SelectedIsIndex term) false)) :ruleset selected-shape)
(rule ((SelectedExecutable term) (= head (SelectedHead term)) (!= head "ExprChoice"))
      ((set (ExprScheduleWeight term) 0)) :ruleset selected-shape)
(rule ((= expr (SelectedExpr term)) (= (ExprReadOnly expr) true)) ((EvaluationReadOnly term)) :ruleset selected-shape)
(rule ((= args (SelectedArgs term)) (= (ExprArgsReadOnly args) true)) ((EvaluationReadOnly term)) :ruleset selected-shape)
(rule ((= expr (SelectedExpr term)) (ExprTotal expr)) ((EvaluationTotal term)) :ruleset selected-shape)
(rule ((= context (ExprContextForScope scope)))
      ((FlowScope scope) (set (EvaluationScopeLoop scope) 0)) :ruleset selected-shape)
(rule ((ExprContextMember context scope)) ((EvaluationContextScope context scope)) :ruleset selected-shape)
(rule ((SourceParent child parent) (= (ExprContextBoundary child) false))
      ((FlowScopeParent child parent)) :ruleset selected-shape)
(rule ((= (SourceLoop source) (LoopInfo header body))) ((set (EvaluationScopeLoop header) 1)) :ruleset selected-shape)
(rule ((FlowScopeParent child parent) (FlowScopeAncestor child parent))
      ((EvaluationScopeCycle)) :ruleset flow-scopes)
(rule ((= head (SelectedHead term)) (SelectedOwned head) (= source (SelectedSource (SelectedField term 2)))
       (= owner (ExprContextOwner source)) (FlowScope owner))
      ((FlowScopeRequirement (FlowNode term) owner)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprParameter") (= owner (SelectedRegion (SelectedField term 2))) (FlowScope owner))
      ((FlowScopeRequirement (FlowNode term) owner)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprLeaf") (= source (SelectedSource (SelectedField term 2))))
      ((EvaluationBinding term) (EvaluationLeafSource term source)) :ruleset selected-shape)
(rule ((EvaluationLeafSource term source) (= n (SourceEvaluationPosition source)))
      ((set (EvaluationOrdinal term) n)) :ruleset selected-flow)
(rule ((EvaluationLeafSource term source) (= owner (ExprContextOwner source)) (FlowScope owner))
      ((EvaluationBindingScope term owner)) :ruleset selected-flow)
(rule ((EvaluationLeafSource term source) (EvaluationTermContext term context) (= root (SelectedRoot context source)) (!= term root))
      ((set (FlowEvaluationOperand (FlowNode term) 0) (FlowNode root))) :ruleset selected-flow)
(rule ((SelectedExecutable term) (= child (SelectedField term i)) (SelectedExecutable child))
      ((FlowOperand (FlowNode term) (FlowNode child))) :ruleset selected-flow)
(rule ((= head (SelectedHead term)) (!= head "ExprChoice") (= start (SelectedOperandStart term))
       (= (SelectedIsIndex term) false) (= child (SelectedField term i)) (SelectedExecutable child))
      ((set (FlowEvaluationOperand (FlowNode term) (- i start)) (FlowNode child))) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprChoice") (= condition (SelectedField term 2)))
      ((set (FlowEvaluationOperand (FlowNode term) 0) (FlowNode condition))
       (set (ExprScheduleCondition term) condition)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprChoice") (= arm (SelectedField term i)) (>= i 3) (<= i 4))
      ((EvaluationArm term arm) (FlowCall (FlowNode term) (FlowNode arm))) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprChoice")) ((set (ExprScheduleWeight term) 1)) :ruleset selected-shape)
(rule ((= head (SelectedHead term)) (!= head "ExprLeaf") (= (FlowEvaluationOperand (FlowNode term) i) (FlowNode child)))
      ((ExprScheduleOperand term child)) :ruleset selected-flow)
(rule ((= (SelectedHead a) "ExprChoice") (= (SelectedHead b) "ExprChoice") (= condition (SelectedField a 2))
       (= condition (SelectedField b 2)) (= yes (SelectedField a 3)) (= no (SelectedField b 4)))
      ((EvaluationPair yes no)) :ruleset selected-flow)

; Address emission consumes the base and indices directly, avoiding intermediate row copies.
(rule ((= (SelectedHead args) "ExprCons") (= head (SelectedField args 1)))
      ((set (SelectedArgument args 0) head)) :ruleset selected-shape)
(rule ((= (SelectedHead args) "ExprCons") (= tail (SelectedField args 2)) (= value (SelectedArgument tail i)))
      ((set (SelectedArgument args (+ i 1)) value)) :ruleset selected-shape)
(rule ((SelectedExecutable term) (= head (SelectedHead term)) (!= head "ExprProject"))
      ((set (SelectedBase term) term)) :ruleset selected-shape)
(rule ((= (SelectedHead term) "ExprProject") (= base (SelectedBase (SelectedField term 2))))
      ((set (SelectedBase term) base)) :ruleset selected-shape)
(rule ((= (SelectedHead term) "ExprInstruction") (= (SelectedString (SelectedField term 3)) "index")
       (= args (SelectedField term 4)) (= array (SelectedArgument args 0)) (= index (SelectedArgument args 1)))
      ((SelectedIndex term array index) (set (SelectedIsIndex term) true)) :ruleset selected-shape)
(rule ((SelectedIndex term array index) (= base (SelectedBase array)) (= (SelectedIsIndex base) false))
      ((set (SelectedAddressBase term) base) (set (SelectedAddressDepth term) 1)
       (set (SelectedAddressIndex term 1) index)) :ruleset selected-address)
(rule ((SelectedIndex term array index) (= inner (SelectedBase array)) (= base (SelectedAddressBase inner))
       (= depth (SelectedAddressDepth inner)))
      ((set (SelectedAddressBase term) base) (set (SelectedAddressDepth term) (+ depth 1))
       (set (SelectedAddressIndex term (+ depth 1)) index)) :ruleset selected-address)
(rule ((SelectedIndex term array index) (= inner (SelectedBase array)) (= value (SelectedAddressIndex inner i)))
      ((set (SelectedAddressIndex term i) value)) :ruleset selected-address)
(rule ((= base (SelectedAddressBase term)))
      ((set (FlowEvaluationOperand (FlowNode term) 0) (FlowNode base))) :ruleset selected-flow)
(rule ((= index (SelectedAddressIndex term i)))
      ((set (FlowEvaluationOperand (FlowNode term) i) (FlowNode index))) :ruleset selected-flow)

; Executing a source boundary includes its selected branch/loop roots, while
; ordinary references remain anchors for independently scheduled definitions.
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceBranch source) (BranchInfo condition yes no)))
      ((SelectedExecutionSource term condition)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceBranch source) (BranchInfo condition yes no)) (= a (SourceResult yes)) (= b (SourceResult no)))
      ((SelectedExecutionSource term a) (SelectedExecutionSource term b)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceBranch source) (BranchInfo condition yes no)) (EvaluationTermContext term context)
       (= a (SelectedRoot context (SourceResult yes))) (= b (SelectedRoot context (SourceResult no))))
      ((EvaluationPair a b)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceLoop source) (LoopInfo header body)) (= result (SourceResult body)))
      ((SelectedExecutionSource term result)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceLoop source) (LoopInfo header body)) (= (SourceLoopInitial header) (LoopInitialInfo state initial)))
      ((SelectedExecutionSource term initial)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceLoopForm source) (WhileCondition condition))) ((SelectedExecutionSource term condition)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceLoopForm source) (ForCount count ty))) ((SelectedExecutionSource term count)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceLoopForm source) (ForEach array))) ((SelectedExecutionSource term array)) :ruleset selected-flow)
(rule ((= (SelectedHead term) "ExprExecute") (= source (SelectedSource (SelectedField term 2)))
       (= (SourceLoop source) (LoopInfo header body)) (= owner (ExprContextOwner source))
       (FlowScope owner) (EvaluationTermContext term context))
      ((EvaluationBoundary context source owner term) (EvaluationBoundaryScope term owner source)) :ruleset selected-flow)
(rule ((SelectedExecutionSource term source) (EvaluationTermContext term context) (= child (SelectedRoot context source)))
      ((FlowCall (FlowNode term) (FlowNode child))) :ruleset selected-flow)
(rule ((EvaluationBoundary context source owner term)) ((FlowReach (FlowNode term) (FlowNode term))) :ruleset selected-flow)
(rule ((EvaluationPair a b)) ((FlowReach (FlowNode a) (FlowNode a)) (FlowReach (FlowNode b) (FlowNode b))) :ruleset selected-flow)
(rule ((ExprRoot context scope source expr) (= term (SelectedRoot context source)))
      ((EvaluationRequested scope term)) :ruleset selected-flow)
