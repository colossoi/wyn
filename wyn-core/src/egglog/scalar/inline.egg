; Calls retain the choice between invoking a helper and its expanded body.
(rule ((ExprContextActive ctx) (= call (ExprInvoke ctx t region args)) (ExprTemplateBody region body) (= (ExprTemplateSafe region) true))
      ((union call (ExprSub ctx body region args))) :ruleset scalar-inline)
(rule ((ExprContextActive ctx) (= call (ExprCall ctx t site region args)) (ExprTemplateBody region body) (= (ExprTemplateSafe region) true))
      ((union call (ExprSub ctx body region args))) :ruleset scalar-inline)
; Administrative substitutions retire once their replacement is established.
(rewrite (ExprSub ctx (ExprParameter original t region i) region args) argument
         :when ((ExprContextActive ctx) (= argument (ExprArgumentAt args i))) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprParameter original t other i) region args) (ExprParameter ctx t other i)
         :when ((ExprContextActive ctx) (!= other region)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprLeaf original t value) region args)
         (ExprLeaf ctx t value) :when ((ExprContextActive ctx) (!= ctx (ExprContextDimensions))) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub (ExprContextDimensions) (ExprLeaf original t value) region args)
         (ExprLeaf (ExprContextDimensions) t value) :when ((= (ExtentExprCapture value) false)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprLiteral original t value) region args)
         (ExprLiteral ctx t value) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprUnary original t op x) region args)
         (ExprUnary ctx t op (ExprSub ctx x region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprBinary original t op x y) region args)
         (ExprBinary ctx t op (ExprSub ctx x region args) (ExprSub ctx y region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprOp original t op xs) region args)
         (ExprOp ctx t op (ExprSubArgs ctx xs region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprInvoke original t callee xs) region args)
         (ExprInvoke ctx t callee (ExprSubArgs ctx xs region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprChoice original t c a b) region args)
         (ExprChoice ctx t (ExprSub ctx c region args) (ExprSub ctx a region args) (ExprSub ctx b region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprTuple original t xs) region args)
         (ExprTuple ctx t (ExprSubArgs ctx xs region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprVector original t xs) region args)
         (ExprVector ctx t (ExprSubArgs ctx xs region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprProject original t x i) region args)
         (ExprProject ctx t (ExprSub ctx x region args) i) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprCoerce original t x) region args)
         (ExprCoerce ctx t (ExprSub ctx x region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSubArgs ctx (ExprNil original) region args) (ExprNil ctx) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ExprSubArgs ctx (ExprCons original x xs) region args)
         (ExprCons ctx (ExprSub ctx x region args) (ExprSubArgs ctx xs region args)) :when ((ExprContextActive ctx)) :subsume :ruleset scalar-substitute)
(rule ((ExprContextActive ctx) (= xs (ExprCons ctx x tail))) ((set (ExprArgumentAt xs 0) x)) :ruleset scalar-arguments)
(rule ((ExprContextActive ctx) (= xs (ExprCons ctx x tail)) (= value (ExprArgumentAt tail i)))
      ((set (ExprArgumentAt xs (+ i 1)) value)) :ruleset scalar-arguments)
