; Calls retain the choice between invoking a helper and its expanded body.
(rule ((ScalarActive ctx) (= call (ScalarInvoke ctx t region args)) (ScalarInlineBody region body) (= (ScalarTemplateSafe region) true))
      ((union call (ScalarSub ctx body region args))) :ruleset scalar-inline)
(rule ((ScalarActive ctx) (= call (ScalarCall ctx t site region args)) (ScalarInlineBody region body) (= (ScalarTemplateSafe region) true))
      ((union call (ScalarSub ctx body region args))) :ruleset scalar-inline)
; Administrative substitutions retire once their replacement is established.
(rewrite (ScalarSub ctx (ScalarParameter original t region i) region args) argument
         :when ((ScalarActive ctx) (= argument (ScalarArgumentAt args i))) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarParameter original t other i) region args) (ScalarParameter ctx t other i)
         :when ((ScalarActive ctx) (!= other region)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarLeaf original t value) region args)
         (ScalarLeaf ctx t value) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarLiteral original t value) region args)
         (ScalarLiteral ctx t value) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarUnary original t op x) region args)
         (ScalarUnary ctx t op (ScalarSub ctx x region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarBinary original t op x y) region args)
         (ScalarBinary ctx t op (ScalarSub ctx x region args) (ScalarSub ctx y region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarOp original t op xs) region args)
         (ScalarOp ctx t op (ScalarSubArgs ctx xs region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarInvoke original t callee xs) region args)
         (ScalarInvoke ctx t callee (ScalarSubArgs ctx xs region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarChoice original t c a b) region args)
         (ScalarChoice ctx t (ScalarSub ctx c region args) (ScalarSub ctx a region args) (ScalarSub ctx b region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarTuple original t xs) region args)
         (ScalarTuple ctx t (ScalarSubArgs ctx xs region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarVector original t xs) region args)
         (ScalarVector ctx t (ScalarSubArgs ctx xs region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarProject original t x i) region args)
         (ScalarProject ctx t (ScalarSub ctx x region args) i) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarCoerce original t x) region args)
         (ScalarCoerce ctx t (ScalarSub ctx x region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSubArgs ctx (ScalarNil original) region args) (ScalarNil ctx) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rewrite (ScalarSubArgs ctx (ScalarCons original x xs) region args)
         (ScalarCons ctx (ScalarSub ctx x region args) (ScalarSubArgs ctx xs region args)) :when ((ScalarActive ctx)) :subsume :ruleset scalar-substitute)
(rule ((ScalarActive ctx) (= xs (ScalarCons ctx x tail))) ((set (ScalarArgumentAt xs 0) x)) :ruleset scalar-arguments)
(rule ((ScalarActive ctx) (= xs (ScalarCons ctx x tail)) (= value (ScalarArgumentAt tail i)))
      ((set (ScalarArgumentAt xs (+ i 1)) value)) :ruleset scalar-arguments)
