; Facts describe operands in the authoritative statement tree. There is no
; scalar expression import, extraction, or separately reconstructed schedule.
(ruleset scalar-analysis)
(ruleset scalar-select)
(ruleset scalar-candidates)
(function ScalarTypeName (PrimType) String :no-merge)
(relation IntegerScalar (PrimType))
(function ConstantAtom (Function Atom) Atom :no-merge)
(function ReducedScalar (Function Exp PrimType) Atom :no-merge)
(relation ScalarReplacement (Program Stm Atom))
(function ScalarEdits (Program) StatementEdits :merge (set-union old new))
(relation ConstantBranch (Program Stm Body))
(function ConstantBodyResult (Function Body) Atom :no-merge)
(rule ((ContainsBody (FunctionRoot function) body)
       (= body (Block statements indexed_vector_0))
       (= value (ConstantAtom function atom))
       (= (EffectsBody function body) (set-empty))
       (= (vec-size indexed_vector_0) 1)
       (= (ResultsAt indexed_vector_0 0) (Yield proofs (ValueOperand atom))))
      ((set (ConstantBodyResult function body) value)) :ruleset scalar-analysis)
(rule ((CurrentProgram program)
       (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id indexed_vector_0 certs (If condition returns yes no)))
       (= value (ConstantBodyResult function yes))
       (= value (ConstantBodyResult function no))
       (= value (LiteralBits primitive bits))
       (= (vec-size indexed_vector_0) 1)
       (= (PatternAt indexed_vector_0 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((ScalarReplacement program statement value)
       (set (ConstantAtom function (Var name)) value)) :ruleset scalar-analysis)

(rule ((ContainsAtom (FunctionRoot function) atom) (= atom (LiteralBits primitive bits)))
      ((set (ConstantAtom function atom) atom)) :ruleset scalar-analysis)
(rule ((FunctionValueCopy function statement name info atom)
       (= value (ConstantAtom function atom)))
      ((set (ConstantAtom function (Var name)) value)) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs expression))
       (= atom (ReducedScalar function expression primitive))
       (= (vec-size vector-pattern-0) 1)
       (= (PatternAt vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((set (ConstantAtom function (Var name)) atom)) :ruleset scalar-analysis)
(relation ScalarOperation (Function Stm Exp PrimType String Atoms))
(relation BinaryScalarOperation (Function Stm Exp PrimType String Atom Atom))
(relation UnaryScalarOperation (Function Stm Exp PrimType String Atom))
(relation ScalarStatement (Stm Exp PrimType String Atoms))
(rule ((SingleValueStatement statement name (ScalarInfo (ScalarElement output)) expression)
       (= expression (PrimOp opcode arguments)))
      ((ScalarStatement statement expression output opcode arguments)) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) statement)
       (ScalarStatement statement expression output opcode arguments))
      ((ScalarOperation function statement expression output opcode arguments)) :ruleset scalar-analysis)
(rule ((ScalarOperation function statement expression output opcode arguments) (= (vec-size arguments) 2))
      ((BinaryScalarOperation function statement expression output opcode
          (vec-at arguments 0) (vec-at arguments 1))) :ruleset scalar-analysis)
(rule ((ScalarOperation function statement expression output opcode arguments) (= (vec-size arguments) 1))
      ((UnaryScalarOperation function statement expression output opcode (vec-at arguments 0))) :ruleset scalar-analysis)
(rule ((BinaryScalarOperation function statement expression output opcode a b)
       (= (ConstantAtom function a) (LiteralBits input av)) (= (ConstantAtom function b) (LiteralBits input bv))
       (= input-name (ScalarTypeName input)) (= output-name (ScalarTypeName output))
       (= bits (wyn-binary opcode input-name output-name av bv)))
      ((set (ReducedScalar function expression output) (LiteralBits output bits))) :ruleset scalar-analysis)
(rule ((UnaryScalarOperation function statement expression output opcode a)
       (= (ConstantAtom function a) (LiteralBits input av))
       (= input-name (ScalarTypeName input)) (= output-name (ScalarTypeName output))
       (= bits (wyn-unary opcode input-name output-name av)))
      ((set (ReducedScalar function expression output) (LiteralBits output bits))) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (IndexOp (IndexConstant bits))))
       (= (vec-size vector-pattern-0) 1)
       (= (PatternAt vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement (I32))))))
      ((set (ConstantAtom function (Var name)) (LiteralBits (I32) bits))) :ruleset scalar-analysis)

; Reducing identities preserve floating-point behavior by applying only to
; integers. Atoms are already evaluated, so discarding an atom loses no effect.
(relation IntegerIdentity (String i64))
(IntegerIdentity "+" 0)
(IntegerIdentity "-" 0)
(IntegerIdentity "*" 1)
(IntegerIdentity "|" 0)
(IntegerIdentity "^" 0)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (BinaryScalarOperation function statement expression primitive opcode left right)
       (IntegerScalar primitive) (IntegerIdentity opcode identity)
       (= (ConstantAtom function right) (LiteralBits primitive identity)))
      ((ScalarReplacement program statement left)) :ruleset scalar-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (BinaryScalarOperation function statement expression primitive "-" atom atom) (IntegerScalar primitive))
      ((ScalarReplacement program statement (LiteralBits primitive 0))) :ruleset scalar-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (BinaryScalarOperation function statement expression primitive "*" left right) (IntegerScalar primitive)
       (= (ConstantAtom function right) (LiteralBits primitive 0)))
      ((ScalarReplacement program statement (LiteralBits primitive 0))) :ruleset scalar-analysis)
(rule ((CurrentProgram program)
       (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id vector-pattern-0 certs expression))
       (= atom (ReducedScalar function expression primitive))
       (= (vec-size vector-pattern-0) 1)
       (= (PatternAt vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((ScalarReplacement program statement atom)) :ruleset scalar-analysis)
(rule ((ScalarReplacement program (Let id pattern certs expression) atom) (= (Copies program) (set-empty)))
      ((set (ScalarEdits program) (set-of (ReplaceStatement id (Let id pattern certs (Use (ValueOperand atom))))))) :ruleset scalar-candidates)
(rule ((= replacements (ScalarEdits program))) ((ReplacementMapDemand replacements)) :ruleset scalar-select)
(rule ((CurrentProgram program) (= replacements (ScalarEdits program)) (= edits (ReplacementMap replacements)))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty) edits)))
       (RewriteDemand "simplify" program)) :ruleset scalar-select)

(rule ((CurrentProgram program)
       (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (PrimOp opcode arguments)))
       (= (vec-size arguments) 2)
       (= (vec-size pattern) 1)
       (= (PatternAt pattern 0) (BindValue name (ScalarInfo (ScalarElement primitive))))
       (IntegerScalar primitive)
       (IntegerIdentity opcode identity)
       (!= opcode "-")
       (= (ConstantAtom function (AtomsAt arguments 0)) (LiteralBits primitive identity)))
      ((ScalarReplacement program statement (vec-at arguments 1))) :ruleset scalar-analysis)
(rule ((CurrentProgram program)
       (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (PrimOp "index-cast" arguments)))
       (= (vec-size arguments) 1)
       (= (AtomsAt arguments 0) (Var source))
       (= (vec-size pattern) 1)
       (= (PatternAt pattern 0) (BindValue name (ScalarInfo element)))
       (= (OperandSlot function (ValueOperand (Var source))) (ScalarSlot element)))
      ((ScalarReplacement program statement (Var source))) :ruleset scalar-analysis)

; A dominating evaluation of the same partial operation can be reused without
; speculation. Memory/context-dependent operations are not repeatable.
(relation RepeatableScalarForm (Exp))
(rule ((= expression (PrimOp opcode arguments)) (RepeatableOpcode opcode))
      ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
(rule ((= expression (Use operand))) ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
(rule ((= expression (IndexOp index))) ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
(function EquivalentValues (Function StatementId ValueName) EquivalentNames :merge (set-union old new))
(relation EquivalentValuesDemand (Function))
(relation ScalarBinding (Function StatementId Exp ValueName ElementType))
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs expression))
       (= (vec-size pattern) 1)
       (PatternBindingAt pattern 0 (BindValue name (ScalarInfo element))))
      ((ScalarBinding function id expression name element)) :ruleset scalar-analysis)
(ruleset scalar-copies)
(rule ((CurrentProgram program) (ProgramFunction program function))
      ((EquivalentValuesDemand function)) :ruleset scalar-analysis)
; Dominance is local to an immutable function; unrelated program edits reuse it.
(rule ((EquivalentValuesDemand function) (= function (ScopeRoot context))
       (CheckStatement context id pattern expression available)
       (ScalarBinding function id expression name element)
       (ScalarBinding function first expression existing element)
       (set-includes available (ValueNameRef existing)) (RepeatableScalarForm expression))
      ((set (EquivalentValues function id name) (set-of existing))) :ruleset scalar-analysis)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (= choices (EquivalentValues function id name)) (> (set-size choices) 0)
       (= (Copied program name) false))
      ((set (Copies program) (set-of (Alias name (set-at choices 0) id)))
       (set (Copied program name) true)) :ruleset scalar-copies)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (If condition returns yes no)))
       (= (ConstantAtom function condition) (LiteralBits (Bool) 1)))
      ((ConstantBranch program statement yes)) :ruleset scalar-select)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (If condition returns yes no)))
       (= (ConstantAtom function condition) (LiteralBits (Bool) 0)))
      ((ConstantBranch program statement no)) :ruleset scalar-select)
(rule ((ConstantBranch program (Let id pattern certs expression) (Block statements results))
       (= (vec-size pattern) (vec-size results)))
      ((set (InlineResults id pattern certs results 0) (vec-of))) :ruleset scalar-select)
(rule ((ConstantBranch program (Let id pattern certs expression) (Block statements results))
       (= (vec-size pattern) (vec-size results))
       (= suffix (InlineResults id pattern certs results (vec-size results))))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append statements suffix)))))
       (RewriteDemand "simplify" program)) :ruleset scalar-select)

(rule ((= expression (Length name axis))) ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
