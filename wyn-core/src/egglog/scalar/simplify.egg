; Generic constant propagation and identities over explicit scalar edges.
(ruleset scalar-analysis)
(function ConstantValue (Name) i64 :no-merge)
(relation FoldedConstant (OperationKey i64))
(rule ((= (ValueType name) (ScalarInfo (ScalarElement primitive))))
      ((set (ValuePrimitive (ValueNameRef name)) primitive)) :ruleset scalar-analysis)
(rule ((= (ValueType name) (LogicalValue (ElementValue (ScalarElement primitive)))))
      ((set (ValuePrimitive (ValueNameRef name)) primitive)) :ruleset scalar-analysis)
(rule ((LiveOperation operation) (= bits (LiteralBits operation)) (ResultOrigin output operation 0))
      ((set (ConstantValue output) bits)) :ruleset scalar-analysis)
(rule ((FoldedConstant operation bits) (ResultOrigin output operation 0))
      ((set (ConstantValue output) bits)) :ruleset scalar-analysis)
(rule ((ForwardCandidate output input) (= bits (ConstantValue input)))
      ((set (ConstantValue output) bits)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation)) (BinaryOperands operation a b)
       (= (wyn-input-count operation) 2) (ResultOrigin output operation 0)
       (= primitive (ValuePrimitive a)) (= primitive (ValuePrimitive b)) (= result (ValuePrimitive output))
       (= input-name (ScalarTypeName primitive)) (= output-name (ScalarTypeName result))
       (= av (ConstantValue a)) (= bv (ConstantValue b)) (= bits (wyn-binary payload input-name output-name av bv)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation)) (= (wyn-input-count operation) 1)
       (DirectOperationUse operation a) (= a (wyn-input operation 0)) (ResultOrigin output operation 0) (= primitive (ValuePrimitive a)) (= result (ValuePrimitive output))
       (= input-name (ScalarTypeName primitive)) (= output-name (ScalarTypeName result))
       (= av (ConstantValue a)) (= bits (wyn-unary payload input-name output-name av)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
; A single scalar instruction can be evaluated without expanding its caller's graph.
(rule ((= revision (RewriteRevision)) (LiveOperation call) (= target (wyn-call-target call))
       (= (PureOperation call) true) (= (wyn-input-count call) 1) (= (wyn-output-count call) 1)
       (= root (wyn-function-root target)) (FirstOperation root operation) (LastOperation root operation)
       (= payload (ScalarPayload operation)) (= (wyn-input-count operation) 1)
       (= (wyn-parameter-count root) 1) (= (wyn-input operation 0) (wyn-parameter root 0))
       (= (wyn-yield-count root) 1) (= (wyn-output operation 0) (wyn-yield root 0))
       (DirectOperationUse call a) (= a (wyn-input call 0)) (ResultOrigin output call 0) (= primitive (ValuePrimitive a)) (= result (ValuePrimitive output))
       (= input-name (ScalarTypeName primitive)) (= output-name (ScalarTypeName result))
       (= av (ConstantValue a)) (= bits (wyn-unary payload input-name output-name av)))
      ((FoldedConstant call bits)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (= left (wyn-input operation 0)) (DirectOperationUse operation right) (= right (wyn-input operation 1)) (ResultOrigin output operation 0)
       (= primitive (ValuePrimitive output)) (IntegerScalar primitive) (IntegerIdentity payload identity)
       (= primitive (ValuePrimitive right)) (= (ConstantValue right) identity))
      ((ForwardCandidate output left)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (DirectOperationUse operation left) (= left (wyn-input operation 0)) (= right (wyn-input operation 1)) (ResultOrigin output operation 0)
       (= primitive (ValuePrimitive output)) (IntegerScalar primitive) (LeftIntegerIdentity payload identity)
       (= primitive (ValuePrimitive left)) (= (ConstantValue left) identity))
      ((ForwardCandidate output right)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (SubtractionPayload payload) (DirectOperationUse operation atom) (= atom (wyn-input operation 0)) (= atom (wyn-input operation 1))
       (ResultOrigin output operation 0) (= primitive (ValuePrimitive output)) (IntegerScalar primitive))
      ((FoldedConstant operation 0)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (MultiplicationPayload payload) (DirectOperationUse operation right) (= right (wyn-input operation 1)) (= (ConstantValue right) 0)
       (ResultOrigin output operation 0) (= primitive (ValuePrimitive output)) (IntegerScalar primitive))
      ((FoldedConstant operation 0)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (IndexCastPayload payload) (DirectOperationUse operation input) (= input (wyn-input operation 0)) (ResultOrigin output operation 0)
       (= primitive (ValuePrimitive input)) (= primitive (ValuePrimitive output)))
      ((ForwardCandidate output input)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (BranchOperation operation)
       (DirectOperationUse operation condition) (= condition (wyn-input operation 0)) (= (ConstantValue condition) 1) (= branch (wyn-control-region operation 0)))
      ((BranchCandidate operation branch)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (BranchOperation operation)
       (= (PureOperation operation) true) (= (wyn-output-count operation) 1)
       (= a (wyn-control-region operation 0)) (= b (wyn-control-region operation 1))
       (= (wyn-yield-count a) 1) (= (wyn-yield-count b) 1)
       (BranchResult operation 0 result av bv)
       (= primitive (ValuePrimitive av)) (= primitive (ValuePrimitive bv))
       (= primitive (ValuePrimitive result))
       (= bits (ConstantValue av)) (= bits (ConstantValue bv)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
(rule ((= revision (RewriteRevision)) (LiveOperation operation) (BranchOperation operation)
       (DirectOperationUse operation condition) (= condition (wyn-input operation 0)) (= (ConstantValue condition) 0) (= branch (wyn-control-region operation 1)))
      ((BranchCandidate operation branch)) :ruleset scalar-analysis)
; The selected arm determines each result, including conditions of later branches.
(rule ((BranchCandidate operation branch)
       (EndDemand branch value) (= value (wyn-yield branch slot)) (= bits (ConstantValue value))
       (ResultOrigin result operation slot))
      ((set (ConstantValue result) bits)) :ruleset scalar-analysis)
