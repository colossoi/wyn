; Facts describe operands in the authoritative statement tree. There is no
; scalar expression import, extraction, or separately reconstructed schedule.
(ruleset scalar-analysis)
(ruleset scalar-select)
(ruleset scalar-candidates)
(function ScalarTypeName (PrimType) String :no-merge)
(relation IntegerScalar (PrimType))
(function ConstantAtom (Function Atom) Atom :no-merge)
(function ReducedScalar (Function Exp PrimType) Atom :no-merge)
(relation ScalarReplacement (Program Stm Atom))
(function ScalarEdits (Program) StatementEdits :merge (set-union old new))
(relation ConstantBranch (Program Stm Body))

(rule ((ContainsAtom (FunctionRoot function) atom) (= atom (LiteralBits primitive bits)))
      ((set (ConstantAtom function atom) atom)) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (Use (ValueOperand atom))))
       (= value (ConstantAtom function atom))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name info)))
      ((set (ConstantAtom function (Var name)) value)) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs expression))
       (= atom (ReducedScalar function expression primitive))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((set (ConstantAtom function (Var name)) atom)) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-1 certs expression))
       (= expression (PrimOp opcode vector-pattern-0))
       (= (ConstantAtom function a) (LiteralBits input av)) (= (ConstantAtom function b) (LiteralBits input bv))
       (= input-name (ScalarTypeName input)) (= output-name (ScalarTypeName output))
       (= bits (wyn-binary opcode input-name output-name av bv))
       (= (vec-length vector-pattern-0) 2)
       (= (vec-get vector-pattern-0 0) a)
       (= (vec-get vector-pattern-0 1) b)
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (BindValue name (ScalarInfo (ScalarElement output)))))
      ((set (ReducedScalar function expression output) (LiteralBits output bits))) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-1 certs expression))
       (= expression (PrimOp opcode vector-pattern-0)) (= (ConstantAtom function a) (LiteralBits input av))
       (= input-name (ScalarTypeName input)) (= output-name (ScalarTypeName output))
       (= bits (wyn-unary opcode input-name output-name av))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) a)
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (BindValue name (ScalarInfo (ScalarElement output)))))
      ((set (ReducedScalar function expression output) (LiteralBits output bits))) :ruleset scalar-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs
          (IndexOp (IndexConstant bits))))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement (I32))))))
      ((set (ConstantAtom function (Var name)) (LiteralBits (I32) bits))) :ruleset scalar-analysis)

; Reducing identities preserve floating-point behavior by applying only to
; integers. Atoms are already evaluated, so discarding an atom loses no effect.
(relation IntegerIdentity (String i64))
(IntegerIdentity "+" 0)
(IntegerIdentity "-" 0)
(IntegerIdentity "*" 1)
(IntegerIdentity "|" 0)
(IntegerIdentity "^" 0)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id vector-pattern-1 certs
          (PrimOp opcode vector-pattern-0))) (IntegerScalar primitive) (IntegerIdentity opcode identity)
       (= (ConstantAtom function right) (LiteralBits primitive identity))
       (= (vec-length vector-pattern-0) 2)
       (= (vec-get vector-pattern-0 0) left)
       (= (vec-get vector-pattern-0 1) right)
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((ScalarReplacement program statement left)) :ruleset scalar-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id vector-pattern-1 certs
          (PrimOp "-" vector-pattern-0))) (IntegerScalar primitive)
       (= (vec-length vector-pattern-0) 2)
       (= (vec-get vector-pattern-0 0) atom)
       (= (vec-get vector-pattern-0 1) atom)
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((ScalarReplacement program statement (LiteralBits primitive 0))) :ruleset scalar-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id vector-pattern-1 certs
          (PrimOp "*" vector-pattern-0))) (IntegerScalar primitive)
       (= (ConstantAtom function right) (LiteralBits primitive 0))
       (= (vec-length vector-pattern-0) 2)
       (= (vec-get vector-pattern-0 0) left)
       (= (vec-get vector-pattern-0 1) right)
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((ScalarReplacement program statement (LiteralBits primitive 0))) :ruleset scalar-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id vector-pattern-0 certs expression))
       (= atom (ReducedScalar function expression primitive))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement primitive)))))
      ((ScalarReplacement program statement atom)) :ruleset scalar-analysis)
(rule ((ScalarReplacement program (Let id pattern certs expression) atom) (= (Copies program) (set-empty)))
      ((set (ScalarEdits program) (set-of (ReplaceStatement id (Let id pattern certs (Use (ValueOperand atom))))))) :ruleset scalar-candidates)
(rule ((= replacements (ScalarEdits program))) ((ReplacementMapDemand replacements)) :ruleset scalar-select)
(rule ((CurrentProgram program) (= replacements (ScalarEdits program)) (= edits (ReplacementMap replacements)))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty) edits)))
       (RewriteDemand "simplify" program)) :ruleset scalar-select)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (PrimOp opcode arguments)))
       (= (vec-length arguments) 2) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement primitive))))
       (IntegerScalar primitive) (IntegerIdentity opcode identity) (!= opcode "-")
       (= (ConstantAtom function (vec-get arguments 0)) (LiteralBits primitive identity)))
      ((ScalarReplacement program statement (vec-get arguments 1))) :ruleset scalar-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (PrimOp "index-cast" arguments)))
       (= (vec-length arguments) 1) (= (vec-get arguments 0) (Var source))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo element)))
       (= (OperandSlot function (ValueOperand (Var source))) (ScalarSlot element)))
      ((ScalarReplacement program statement (Var source))) :ruleset scalar-analysis)

; A dominating evaluation of the same partial operation can be reused without
; speculation. Memory/context-dependent operations are not repeatable.
(relation RepeatableScalarForm (Exp))
(rule ((= expression (PrimOp opcode arguments)) (RepeatableOpcode opcode))
      ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
(rule ((= expression (Use operand))) ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
(rule ((= expression (IndexOp index))) ((RepeatableScalarForm expression)) :ruleset scalar-analysis)
(sort EquivalentNames (Set ValueName))
(function EquivalentValues (Program StatementId ValueName) EquivalentNames :merge (set-union old new))
(ruleset scalar-copies)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id vector-pattern-1 expression available)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let first vector-pattern-0 proofs expression))
       (set-contains available (ValueNameRef existing)) (RepeatableScalarForm expression)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue existing (ScalarInfo element)))
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (BindValue name (ScalarInfo element))))
      ((set (EquivalentValues program id name) (set-of existing))) :ruleset scalar-analysis)

(rule ((= choices (EquivalentValues program id name)) (> (set-length choices) 0)
       (= (Copied program name) false))
      ((set (Copies program) (set-of (Alias name (set-get choices 0) id)))
       (set (Copied program name) true)) :ruleset scalar-copies)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (If condition returns yes no)))
       (= (ConstantAtom function condition) (LiteralBits (Bool) 1)))
      ((ConstantBranch program statement yes)) :ruleset scalar-select)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (If condition returns yes no)))
       (= (ConstantAtom function condition) (LiteralBits (Bool) 0)))
      ((ConstantBranch program statement no)) :ruleset scalar-select)
(rule ((ConstantBranch program (Let id pattern certs expression) (Block statements results))
       (= (vec-length pattern) (vec-length results)))
      ((set (InlineResults id pattern certs results 0) (vec-of))) :ruleset scalar-select)
(rule ((ConstantBranch program (Let id pattern certs expression) (Block statements results))
       (= (vec-length pattern) (vec-length results))
       (= suffix (InlineResults id pattern certs results (vec-length results))))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append statements suffix)))))
       (RewriteDemand "simplify" program)) :ruleset scalar-select)
