; Generic constant propagation and identities over explicit scalar edges.
(ruleset scalar-analysis)
(function ValuePrimitive (Name) PrimType :no-merge)
(function ConstantValue (Name) i64 :no-merge)
(relation FoldedConstant (OperationKey i64))
(rule ((= revision (AnalysisRevision)) (= (ValueType name) (ScalarInfo (ScalarElement primitive))))
      ((set (ValuePrimitive (ValueNameRef name)) primitive)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (= (ValueType name) (LogicalValue (ElementValue (ScalarElement primitive)))))
      ((set (ValuePrimitive (ValueNameRef name)) primitive)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= bits (LiteralBits operation)) (= output (Output operation 0)))
      ((set (ConstantValue output) bits)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (ForwardCandidate output input) (= bits (ConstantValue input)))
      ((set (ConstantValue output) bits)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation)) (= (InputCount operation) 2)
       (= a (Input operation 0)) (= b (Input operation 1)) (= output (Output operation 0))
       (= primitive (ValuePrimitive a)) (= primitive (ValuePrimitive b)) (= result (ValuePrimitive output))
       (= input-name (ScalarTypeName primitive)) (= output-name (ScalarTypeName result))
       (= av (ConstantValue a)) (= bv (ConstantValue b)) (= bits (wyn-binary payload input-name output-name av bv)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation)) (= (InputCount operation) 1)
       (= a (Input operation 0)) (= output (Output operation 0)) (= primitive (ValuePrimitive a)) (= result (ValuePrimitive output))
       (= input-name (ScalarTypeName primitive)) (= output-name (ScalarTypeName result))
       (= av (ConstantValue a)) (= bits (wyn-unary payload input-name output-name av)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (= left (Input operation 0)) (= right (Input operation 1)) (= output (Output operation 0))
       (= primitive (ValuePrimitive output)) (IntegerScalar primitive) (IntegerIdentity payload identity)
       (= primitive (ValuePrimitive right)) (= (ConstantValue right) identity))
      ((ForwardCandidate output left)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (= left (Input operation 0)) (= right (Input operation 1)) (= output (Output operation 0))
       (= primitive (ValuePrimitive output)) (IntegerScalar primitive) (LeftIntegerIdentity payload identity)
       (= primitive (ValuePrimitive left)) (= (ConstantValue left) identity))
      ((ForwardCandidate output right)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (SubtractionPayload payload) (= atom (Input operation 0)) (= atom (Input operation 1))
       (= output (Output operation 0)) (= primitive (ValuePrimitive output)) (IntegerScalar primitive))
      ((FoldedConstant operation 0)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (MultiplicationPayload payload) (= right (Input operation 1)) (= (ConstantValue right) 0)
       (= output (Output operation 0)) (= primitive (ValuePrimitive output)) (IntegerScalar primitive))
      ((FoldedConstant operation 0)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= payload (ScalarPayload operation))
       (IndexCastPayload payload) (= input (Input operation 0)) (= output (Output operation 0))
       (= primitive (ValuePrimitive input)) (= primitive (ValuePrimitive output)))
      ((ForwardCandidate output input)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (BranchOperation operation)
       (= condition (Input operation 0)) (= (ConstantValue condition) 1) (= branch (ControlRegion operation 0)))
      ((BranchCandidate operation branch)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (BranchOperation operation)
       (= (PureOperation operation) true) (= (OutputCount operation) 1)
       (= a (ControlRegion operation 0)) (= b (ControlRegion operation 1))
       (= (RegionYieldCount a) 1) (= (RegionYieldCount b) 1)
       (= av (RegionYield a 0)) (= bv (RegionYield b 0))
       (= primitive (ValuePrimitive av)) (= primitive (ValuePrimitive bv))
       (= primitive (ValuePrimitive (Output operation 0)))
       (= bits (ConstantValue av)) (= bits (ConstantValue bv)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (BranchOperation operation)
       (= condition (Input operation 0)) (= (ConstantValue condition) 0) (= branch (ControlRegion operation 1)))
      ((BranchCandidate operation branch)) :ruleset scalar-analysis)
