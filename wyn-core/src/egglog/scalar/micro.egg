; Reducing identities retire their replaced forms. No reassociation or expansion.
(rule ((ScalarActive ctx) (= e (ScalarBinary ctx t op (ScalarLiteral ctx at a) (ScalarLiteral ctx at b)))
       (ScalarType at input) (ScalarType t output) (= value (wyn-binary op input output a b)))
      ((union e (ScalarLiteral ctx t value)) (subsume (ScalarBinary ctx t op (ScalarLiteral ctx at a) (ScalarLiteral ctx at b)))) :ruleset scalar-micro)
(rule ((ScalarActive ctx) (= e (ScalarUnary ctx t op (ScalarLiteral ctx at a)))
       (ScalarType at input) (ScalarType t output) (= value (wyn-unary op input output a)))
      ((union e (ScalarLiteral ctx t value)) (subsume (ScalarUnary ctx t op (ScalarLiteral ctx at a)))) :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "+" x (ScalarLiteral ctx t "0")) x :when ((ScalarActive ctx) (ScalarInteger t)) :subsume :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "+" (ScalarLiteral ctx t "0") x) x :when ((ScalarActive ctx) (ScalarInteger t)) :subsume :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "-" x (ScalarLiteral ctx t "0")) x :when ((ScalarActive ctx) (ScalarInteger t)) :subsume :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "-" x x) (ScalarLiteral ctx t "0") :when ((ScalarActive ctx) (ScalarInteger t) (ScalarTotal x)) :subsume :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "*" x (ScalarLiteral ctx t "1")) x :when ((ScalarActive ctx) (ScalarInteger t)) :subsume :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "*" (ScalarLiteral ctx t "1") x) x :when ((ScalarActive ctx) (ScalarInteger t)) :subsume :ruleset scalar-micro)
(rewrite (ScalarBinary ctx t "*" x (ScalarLiteral ctx t "0")) (ScalarLiteral ctx t "0") :when ((ScalarActive ctx) (ScalarInteger t) (ScalarTotal x)) :subsume :ruleset scalar-micro)
(rewrite (ScalarChoice ctx t (ScalarLiteral ctx ct "true") a b) a :when ((ScalarActive ctx)) :subsume :ruleset scalar-micro)
(rewrite (ScalarChoice ctx t (ScalarLiteral ctx ct "false") a b) b :when ((ScalarActive ctx)) :subsume :ruleset scalar-micro)
(rewrite (ScalarChoice ctx t c x x) x :when ((ScalarActive ctx) (ScalarTotal c)) :subsume :ruleset scalar-micro)
(rule ((ScalarActive ctx) (= e (ScalarProject ctx t (ScalarTuple ctx tt xs) i)) (= field (ScalarArgumentAt xs i))) ((union e field) (subsume (ScalarProject ctx t (ScalarTuple ctx tt xs) i))) :ruleset scalar-micro)
(rule ((ScalarActive ctx) (= e (ScalarProject ctx t (ScalarVector ctx tt xs) i)) (= field (ScalarArgumentAt xs i))) ((union e field) (subsume (ScalarProject ctx t (ScalarVector ctx tt xs) i))) :ruleset scalar-micro)
