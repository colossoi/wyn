; Only reducing identities: no reassociation or distributive expansion.
(rule ((ScalarActive ctx) (= e (ScalarOp ctx t op (ScalarCons ctx (ScalarLiteral ctx at a) (ScalarCons ctx (ScalarLiteral ctx at b) (ScalarNil ctx)))))
       (ScalarType at input) (ScalarType t output) (= value (wyn-binary op input output a b)))
      ((union e (ScalarLiteral ctx t value))) :ruleset scalar-micro)
(rule ((ScalarActive ctx) (= e (ScalarOp ctx t op (ScalarCons ctx (ScalarLiteral ctx at a) (ScalarNil ctx))))
       (ScalarType at input) (ScalarType t output) (= value (wyn-unary op input output a)))
      ((union e (ScalarLiteral ctx t value))) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "+" (ScalarCons ctx x (ScalarCons ctx (ScalarLiteral ctx t "0") (ScalarNil ctx)))) x :when ((ScalarActive ctx) (ScalarInteger t)) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "+" (ScalarCons ctx (ScalarLiteral ctx t "0") (ScalarCons ctx x (ScalarNil ctx)))) x :when ((ScalarActive ctx) (ScalarInteger t)) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "-" (ScalarCons ctx x (ScalarCons ctx (ScalarLiteral ctx t "0") (ScalarNil ctx)))) x :when ((ScalarActive ctx) (ScalarInteger t)) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "-" (ScalarCons ctx x (ScalarCons ctx x (ScalarNil ctx)))) (ScalarLiteral ctx t "0") :when ((ScalarActive ctx) (ScalarInteger t) (ScalarTotal ctx x)) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "*" (ScalarCons ctx x (ScalarCons ctx (ScalarLiteral ctx t "1") (ScalarNil ctx)))) x :when ((ScalarActive ctx) (ScalarInteger t)) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "*" (ScalarCons ctx (ScalarLiteral ctx t "1") (ScalarCons ctx x (ScalarNil ctx)))) x :when ((ScalarActive ctx) (ScalarInteger t)) :ruleset scalar-micro)
(rewrite (ScalarOp ctx t "*" (ScalarCons ctx x (ScalarCons ctx (ScalarLiteral ctx t "0") (ScalarNil ctx)))) (ScalarLiteral ctx t "0") :when ((ScalarActive ctx) (ScalarInteger t) (ScalarTotal ctx x)) :ruleset scalar-micro)
(rewrite (ScalarChoice ctx t (ScalarLiteral ctx ct "true") a b) a :when ((ScalarActive ctx)) :ruleset scalar-micro)
(rewrite (ScalarChoice ctx t (ScalarLiteral ctx ct "false") a b) b :when ((ScalarActive ctx)) :ruleset scalar-micro)
(rewrite (ScalarChoice ctx t c x x) x :when ((ScalarActive ctx) (ScalarTotal ctx c)) :ruleset scalar-micro)
(rule ((ScalarActive ctx) (= e (ScalarProject ctx t (ScalarTuple ctx tt xs) i)) (= field (ScalarArgumentAt xs i))) ((union e field)) :ruleset scalar-micro)
(rule ((ScalarActive ctx) (= e (ScalarProject ctx t (ScalarVector ctx tt xs) i)) (= field (ScalarArgumentAt xs i))) ((union e field)) :ruleset scalar-micro)
