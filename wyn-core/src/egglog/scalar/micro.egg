; Reducing identities retire their replaced forms. No reassociation or expansion.
(rule ((ExprContextActive ctx) (= e (ExprBinary ctx t op (ExprLiteral ctx at a) (ExprLiteral ctx at b)))
       (ExprPrimitiveType at input) (ExprPrimitiveType t output) (= value (wyn-binary op input output a b)))
      ((union e (ExprLiteral ctx t value)) (subsume (ExprBinary ctx t op (ExprLiteral ctx at a) (ExprLiteral ctx at b)))) :ruleset scalar-micro)
(rule ((ExprContextActive ctx) (= e (ExprUnary ctx t op (ExprLiteral ctx at a)))
       (ExprPrimitiveType at input) (ExprPrimitiveType t output) (= value (wyn-unary op input output a)))
      ((union e (ExprLiteral ctx t value)) (subsume (ExprUnary ctx t op (ExprLiteral ctx at a)))) :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "+" x (ExprLiteral ctx t "0")) x :when ((ExprContextActive ctx) (ExprIntegerType t)) :subsume :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "+" (ExprLiteral ctx t "0") x) x :when ((ExprContextActive ctx) (ExprIntegerType t)) :subsume :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "-" x (ExprLiteral ctx t "0")) x :when ((ExprContextActive ctx) (ExprIntegerType t)) :subsume :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "-" x x) (ExprLiteral ctx t "0") :when ((ExprContextActive ctx) (ExprIntegerType t) (ExprTotal x)) :subsume :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "*" x (ExprLiteral ctx t "1")) x :when ((ExprContextActive ctx) (ExprIntegerType t)) :subsume :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "*" (ExprLiteral ctx t "1") x) x :when ((ExprContextActive ctx) (ExprIntegerType t)) :subsume :ruleset scalar-micro)
(rewrite (ExprBinary ctx t "*" x (ExprLiteral ctx t "0")) (ExprLiteral ctx t "0") :when ((ExprContextActive ctx) (ExprIntegerType t) (ExprTotal x)) :subsume :ruleset scalar-micro)
(rewrite (ExprChoice ctx t (ExprLiteral ctx ct "true") a b) a :when ((ExprContextActive ctx)) :subsume :ruleset scalar-micro)
(rewrite (ExprChoice ctx t (ExprLiteral ctx ct "false") a b) b :when ((ExprContextActive ctx)) :subsume :ruleset scalar-micro)
(rewrite (ExprChoice ctx t c x x) x :when ((ExprContextActive ctx) (ExprTotal c)) :subsume :ruleset scalar-micro)
(rule ((ExprContextActive ctx) (= e (ExprProject ctx t (ExprTuple ctx tt xs) i)) (= field (ExprArgumentAt xs i))) ((union e field) (subsume (ExprProject ctx t (ExprTuple ctx tt xs) i))) :ruleset scalar-micro)
(rule ((ExprContextActive ctx) (= e (ExprProject ctx t (ExprVector ctx tt xs) i)) (= field (ExprArgumentAt xs i))) ((union e field) (subsume (ExprProject ctx t (ExprVector ctx tt xs) i))) :ruleset scalar-micro)
; Project through a pure update without expanding the record. Total operands
; ensure these identities cannot discard an evaluation that must be retained.
(rule ((ExprContextActive ctx) (= e (ExprProject ctx t update i))
       (= update (ExprOp ctx rt op (ExprCons ctx record (ExprCons ctx (ExprLiteral ctx it index) (ExprCons ctx replacement (ExprNil ctx))))))
       (ExprRecordUpdateOperator op) (ExprTotal update) (= index (to-string i)))
      ((union e replacement) (subsume (ExprProject ctx t update i))) :ruleset scalar-micro)
(rule ((ExprContextActive ctx) (= e (ExprProject ctx t update i))
       (= update (ExprOp ctx rt op (ExprCons ctx record (ExprCons ctx (ExprLiteral ctx it index) (ExprCons ctx replacement (ExprNil ctx))))))
       (ExprRecordUpdateOperator op) (ExprTotal update) (!= index (to-string i)))
      ((union e (ExprProject ctx t record i)) (subsume (ExprProject ctx t update i))) :ruleset scalar-micro)
