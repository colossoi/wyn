; Demand and context selection use operation/region facts, before scalar import.
(ruleset scalar-admission)
(ruleset scalar-contexts)
(ruleset scalar-demands)
(ruleset scalar-import)
(function ExprContextBoundary (RegionKey) bool :merge (or old new))
(function ExprContextKernelRegion (RegionKey) bool :merge (or old new))
(function ExprContextDispatchRegion (RegionKey) bool :merge (or old new))
(relation ExprImportTemplateExpansion (RegionKey SourceValue))
(function ExprImportDispatchedSource (SourceValue) bool :merge (or old new))
(relation ExprImportDemand (OperationKey RegionKey SourceValue))
(relation ExprImportLocalDemand (RegionKey SourceValue))
(function ExprImportDispatchExpand (OperationKey SourceValue) bool :merge (or old new))
(function ExprImportMovedDemand (OperationKey SourceValue) bool :merge (or old new))
(relation ExprImportDispatchDemand (OperationKey RegionKey SourceValue))
(relation ExprImportRoot (ExprContext RegionKey SourceValue bool))

(rule ((= v (SourceTerm r i))) ((set (ExprContextOwner v) r)) :ruleset scalar-admission)
(rule ((= v (SourceFormal r i))) ((set (ExprContextOwner v) r)) :ruleset scalar-admission)
(rule ((= v (SourceInvocation r f args))) ((set (ExprContextOwner v) r)) :ruleset scalar-admission)
(rule ((= v (SourceArrayAtom parent i)) (= r (ExprContextOwner parent)))
      ((set (ExprContextOwner v) r) (ExprImportLocalDemand r v)) :ruleset scalar-admission)
(rule ((= v (SourceProjected parent i)) (= r (ExprContextOwner parent)))
      ((set (ExprContextOwner v) r)) :ruleset scalar-admission)
(rule ((= r (RegionId i)))
      ((set (ExprContextBoundary r) false) (set (ExprContextKernelRegion r) false)
       (set (ExprContextDispatchRegion r) false)) :ruleset scalar-admission)
(rule ((SourceRootRegion r)) ((set (ExprContextBoundary r) true)) :ruleset scalar-admission)
(rule ((= (SourceCallable v) r)) ((set (ExprContextBoundary r) true)) :ruleset scalar-admission)
(rule ((= r (SourceOperatorBody op))) ((set (ExprContextBoundary r) true)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= body (SourceOperatorBody op)))
      ((set (ExprContextKernelRegion body) true)) :ruleset scalar-admission)
(rule ((= ty (SourceType v))) ((set (ExprImportDispatchedSource v) false)) :ruleset scalar-admission)
(rule ((InvocationValue op) (DispatchGroupLeader op leader) (FirstPhase leader phase)
       (= v (SourceOperationValue op)) (PlannedOperation op owner plan r))
      ((set (ExprImportDispatchExpand leader v) true) (set (ExprImportDispatchedSource v) true)
       (ExprImportDispatchDemand leader r v) (set (ExprImportMovedDemand op v) true)) :ruleset scalar-admission)
(rule ((InvocationValue op) (DispatchGroupLeader op leader) (FirstPhase leader phase)
       (SourceOperand op v) (PlannedOperation op owner plan r))
      ((ExprImportDispatchDemand leader r v) (set (ExprImportMovedDemand op v) true)) :ruleset scalar-admission)
(rule ((InvocationValue op) (DispatchGroupLeader op leader) (FirstPhase leader phase) (Enters op r))
      ((set (ExprContextDispatchRegion r) true)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (FirstPhase owner phase) (PlanResult plan role i v ty))
      ((set (ExprImportDispatchedSource v) true)) :ruleset scalar-admission)
(rule ((DirectResult v owner i) (FirstPhase owner phase))
      ((set (ExprImportDispatchedSource v) true)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceOperationValue op)))
      ((ExprImportDemand op r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (SourceOperand op v)) ((ExprImportDemand op r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceInput op i))) ((ExprImportDemand op r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceNeutral op))) ((ExprImportDemand op r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceDestination op))) ((ExprImportDemand op r v)) :ruleset scalar-admission)
(rule ((= (SourceLoop source-loop-owner) (LoopInfo r source-loop-iteration)) (= (SourceLoopForm source-loop-owner) (WhileCondition v))) ((ExprImportLocalDemand r v)) :ruleset scalar-admission)
(rule ((= v (SourceResult r))) ((ExprImportLocalDemand r v)) :ruleset scalar-admission)
(rule ((= (SourceOutput i) (OutputInfo s v ty copy)) (= (SourceDefinition s) r)) ((ExprImportLocalDemand r v)) :ruleset scalar-admission)
(rule ((= extent (Scalar v)) (= r (ExprContextOwner v))) ((ExprImportLocalDemand r v)) :ruleset scalar-admission)
(rule ((= extent (Length v)) (= r (ExprContextOwner v))) ((ExprImportLocalDemand r v)) :ruleset scalar-admission)
(rule ((= (SourceSlice v) (SliceInfo a b c)) (= r (ExprContextOwner a))) ((ExprImportLocalDemand r a)) :ruleset scalar-admission)
(rule ((= (SourceSlice v) (SliceInfo a b c)) (= r (ExprContextOwner b))) ((ExprImportLocalDemand r b)) :ruleset scalar-admission)
(rule ((= (SourceSlice v) (SliceInfo a b c)) (= r (ExprContextOwner c))) ((ExprImportLocalDemand r c)) :ruleset scalar-admission)
(rule ((ExprImportDemand op r v)) ((set (ExprImportMovedDemand op v) false)) :ruleset scalar-admission)

(rule ((= (ExprContextBoundary r) true)) ((set (ExprContextHome r) r)) :ruleset scalar-contexts)
(rule ((= (ExprContextBoundary r) false) (SourceParent r p) (= home (ExprContextHome p)))
      ((set (ExprContextHome r) home)) :ruleset scalar-contexts)
(rule ((= (ExprContextBoundary r) true) (= (ExprContextKernelRegion r) false))
      ((set (ExprContextForScope r) (ExprContextFunction r))) :ruleset scalar-contexts)
(rule ((PlannedOperation op owner plan scope) (= r (SourceOperatorBody op)))
      ((set (ExprContextForScope r) (ExprContextKernel plan))) :ruleset scalar-contexts)
(rule ((= (ExprContextBoundary r) false) (= (ExprContextDispatchRegion r) false)
       (SourceParent r p) (= context (ExprContextForScope p)))
      ((set (ExprContextForScope r) context)) :ruleset scalar-contexts)
(rule ((= (ExprContextBoundary r) false) (Enters op r)
       (InvocationValue op) (DispatchGroupLeader op leader) (FirstPhase leader phase))
      ((set (ExprContextForScope r) (ExprContextDispatch leader))) :ruleset scalar-contexts)
(rule ((= context (ExprContextForScope r))) ((ExprContextMember context r)) :ruleset scalar-contexts)
(rule ((= r (ExprContextOwner v)) (= context (ExprContextForScope r)))
      ((set (ExprContextForSource v) context)) :ruleset scalar-contexts)
(rule ((= r (ExprContextOwner v)) (= home (ExprContextHome r)) (= (SourceDuplicable v) true))
      ((ExprImportTemplateExpansion home v)) :ruleset scalar-contexts)

; Moving one operation's use must not remove another operation's local demand.
(rule ((ExprImportDemand op r v) (= (ExprImportMovedDemand op v) false)) ((ExprImportLocalDemand r v)) :ruleset scalar-demands)
(rule ((ExprImportLocalDemand r v) (= context (ExprContextForScope r)) (= dispatched (ExprImportDispatchedSource v)))
      ((ExprImportRoot context r v (not dispatched))) :ruleset scalar-import)
(rule ((ExprImportDispatchDemand leader r v)) ((set (ExprImportDispatchExpand leader v) false)) :ruleset scalar-demands)
(rule ((ExprImportDispatchDemand leader r v) (= expand (ExprImportDispatchExpand leader v)))
      ((ExprImportRoot (ExprContextDispatch leader) r v expand)
       (ExprContextMember (ExprContextDispatch leader) r)) :ruleset scalar-import)
(rule ((ExprImportDispatchDemand leader r own) (ExprImportLocalDemand r v))
      ((ExprImportDispatchDemand leader r v)) :ruleset scalar-demands)
