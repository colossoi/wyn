; Demand and context selection use operation/region facts, before scalar import.
(ruleset scalar-admission)
(ruleset scalar-contexts)
(ruleset scalar-demands)
(ruleset scalar-import)
(function ScalarRegionBoundary (RegionKey) bool :merge (or old new))
(function ScalarRegionKernel (RegionKey) bool :merge (or old new))
(function ScalarRegionDispatch (RegionKey) bool :merge (or old new))
(relation ScalarTemplateExpands (RegionKey SourceValue))
(function ScalarSourceDispatched (SourceValue) bool :merge (or old new))
(relation ScalarDispatchSource (SourceValue OperationKey))
(relation ScalarCallback (FusionPlan OperationKey RegionKey))
(relation ScalarDemand (RegionKey SourceValue))
(relation ScalarRequired (RegionKey SourceValue))
(function ScalarMovedDemand (RegionKey SourceValue) bool :merge (or old new))
(relation ScalarDispatchDemand (OperationKey RegionKey SourceValue))
(relation ScalarImportRoot (ScalarContext RegionKey SourceValue bool))

(rule ((= v (SourceTerm r i))) ((set (ScalarOwner v) r)) :ruleset scalar-admission)
(rule ((= v (SourceFormal r i))) ((set (ScalarOwner v) r)) :ruleset scalar-admission)
(rule ((= v (SourceInvocation r f args))) ((set (ScalarOwner v) r)) :ruleset scalar-admission)
(rule ((= v (SourceArrayAtom parent i)) (= r (ScalarOwner parent)))
      ((set (ScalarOwner v) r) (ScalarRequired r v)) :ruleset scalar-admission)
(rule ((= v (SourceProjected parent i)) (= r (ScalarOwner parent)))
      ((set (ScalarOwner v) r)) :ruleset scalar-admission)
(rule ((= r (RegionId i)))
      ((set (ScalarRegionBoundary r) false) (set (ScalarRegionKernel r) false)
       (set (ScalarRegionDispatch r) false)) :ruleset scalar-admission)
(rule ((SourceRootRegion r)) ((set (ScalarRegionBoundary r) true)) :ruleset scalar-admission)
(rule ((SourceCallable v r)) ((set (ScalarRegionBoundary r) true)) :ruleset scalar-admission)
(rule ((= r (SourceOperatorBody op))) ((set (ScalarRegionBoundary r) true)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= body (SourceOperatorBody op)))
      ((ScalarCallback plan op body) (set (ScalarRegionKernel body) true)) :ruleset scalar-admission)
(rule ((= ty (SourceType v))) ((set (ScalarSourceDispatched v) false)) :ruleset scalar-admission)
(rule ((ScalarValue op) (ScalarGroup op leader) (FirstPhase leader phase)
       (= v (SourceOperationValue op)) (PlannedOperation op owner plan r))
      ((ScalarDispatchSource v leader) (set (ScalarSourceDispatched v) true)
       (ScalarDispatchDemand leader r v) (set (ScalarMovedDemand r v) true)) :ruleset scalar-admission)
(rule ((ScalarValue op) (ScalarGroup op leader) (FirstPhase leader phase)
       (SourceOperand op v) (PlannedOperation op owner plan r))
      ((ScalarDispatchDemand leader r v) (set (ScalarMovedDemand r v) true)) :ruleset scalar-admission)
(rule ((ScalarValue op) (ScalarGroup op leader) (FirstPhase leader phase) (Enters op r))
      ((set (ScalarRegionDispatch r) true)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (FirstPhase owner phase) (PlanResult plan role i v ty))
      ((set (ScalarSourceDispatched v) true)) :ruleset scalar-admission)
(rule ((DirectResult e owner i) (FirstPhase owner phase) (= e (SourceExprKey v)))
      ((set (ScalarSourceDispatched v) true)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceOperationValue op)))
      ((ScalarDemand r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (SourceOperand op v)) ((ScalarDemand r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceInput op i))) ((ScalarDemand r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceNeutral op))) ((ScalarDemand r v)) :ruleset scalar-admission)
(rule ((PlannedOperation op owner plan r) (= v (SourceDestination op))) ((ScalarDemand r v)) :ruleset scalar-admission)
(rule ((SourceLoopCondition r v)) ((ScalarRequired r v)) :ruleset scalar-admission)
(rule ((= v (SourceResult r))) ((ScalarRequired r v)) :ruleset scalar-admission)
(rule ((SourceOutput i s v ty copy) (SourceDefinition s r)) ((ScalarRequired r v)) :ruleset scalar-admission)
(rule ((= extent (Scalar e)) (= e (SourceExprKey v)) (= r (ScalarOwner v))) ((ScalarRequired r v)) :ruleset scalar-admission)
(rule ((= extent (Length e)) (= e (SourceExprKey v)) (= r (ScalarOwner v))) ((ScalarRequired r v)) :ruleset scalar-admission)
(rule ((SourceSlice v a b c) (= r (ScalarOwner a))) ((ScalarRequired r a)) :ruleset scalar-admission)
(rule ((SourceSlice v a b c) (= r (ScalarOwner b))) ((ScalarRequired r b)) :ruleset scalar-admission)
(rule ((SourceSlice v a b c) (= r (ScalarOwner c))) ((ScalarRequired r c)) :ruleset scalar-admission)
(rule ((ScalarDemand r v)) ((set (ScalarMovedDemand r v) false)) :ruleset scalar-admission)

(rule ((= (ScalarRegionBoundary r) true)) ((set (ScalarHome r) r)) :ruleset scalar-contexts)
(rule ((= (ScalarRegionBoundary r) false) (SourceParent r p) (= home (ScalarHome p)))
      ((set (ScalarHome r) home)) :ruleset scalar-contexts)
(rule ((= (ScalarRegionBoundary r) true) (= (ScalarRegionKernel r) false))
      ((set (ScalarScopeContext r) (ScalarFunction r))) :ruleset scalar-contexts)
(rule ((ScalarCallback plan op r)) ((set (ScalarScopeContext r) (ScalarKernel plan))) :ruleset scalar-contexts)
(rule ((= (ScalarRegionBoundary r) false) (= (ScalarRegionDispatch r) false)
       (SourceParent r p) (= context (ScalarScopeContext p)))
      ((set (ScalarScopeContext r) context)) :ruleset scalar-contexts)
(rule ((= (ScalarRegionBoundary r) false) (Enters op r)
       (ScalarValue op) (ScalarGroup op leader) (FirstPhase leader phase))
      ((set (ScalarScopeContext r) (ScalarDispatch leader))) :ruleset scalar-contexts)
(rule ((= context (ScalarScopeContext r))) ((ScalarContextScope context r)) :ruleset scalar-contexts)
(rule ((= r (ScalarOwner v)) (= context (ScalarScopeContext r)))
      ((set (ScalarSourceContext v) context)) :ruleset scalar-contexts)
(rule ((= r (ScalarOwner v)) (= home (ScalarHome r)) (= (SourceDuplicable v) true))
      ((ScalarTemplateExpands home v)) :ruleset scalar-contexts)

(relation ScalarLocalDemand (RegionKey SourceValue))
(rule ((ScalarDemand r v) (= (ScalarMovedDemand r v) false)) ((ScalarLocalDemand r v)) :ruleset scalar-demands)
(rule ((ScalarRequired r v)) ((ScalarLocalDemand r v)) :ruleset scalar-demands)
(rule ((ScalarLocalDemand r v) (= context (ScalarScopeContext r)) (= dispatched (ScalarSourceDispatched v)))
      ((ScalarImportRoot context r v (not dispatched))) :ruleset scalar-import)
(function ScalarDispatchExpand (OperationKey SourceValue) bool :merge (or old new))
(rule ((ScalarDispatchDemand leader r v)) ((set (ScalarDispatchExpand leader v) false)) :ruleset scalar-demands)
(rule ((ScalarDispatchSource v leader)) ((set (ScalarDispatchExpand leader v) true)) :ruleset scalar-demands)
(rule ((ScalarDispatchDemand leader r v) (= expand (ScalarDispatchExpand leader v)))
      ((ScalarImportRoot (ScalarDispatch leader) r v expand)
       (ScalarContextScope (ScalarDispatch leader) r)) :ruleset scalar-import)
(rule ((ScalarDispatchDemand leader r own) (ScalarLocalDemand r v))
      ((ScalarDispatchDemand leader r v)) :ruleset scalar-demands)
