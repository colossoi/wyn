; Dimension recipes use the same substitution rules and extracted scalar DAG as arithmetic.
(constructor ScalarExtentArgs (Extent) ScalarArgs :unextractable)
(relation ScalarExtentRoot (Extent ScalarExpr))
(ruleset scalar-extents)
(ruleset scalar-extent-sources)
(relation ScalarExtentNeeded (Extent))
(function ScalarExtentValue (Extent) ScalarExpr :no-merge)
(function ScalarDimensionCapture (SourceValue) bool :merge (or old new))
(rule ((ScalarLeaf ctx t source)) ((set (ScalarDimensionCapture source) false)) :ruleset scalar-extent-sources)
(rule ((SourceCapture region formal actual)) ((set (ScalarDimensionCapture formal) true)) :ruleset scalar-extent-sources)
(rule ((= extent (CallExtent call inner)) (= (ExtentUniform extent) true))
      ((ScalarExtentNeeded extent) (ScalarActive (ScalarDimensions))) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded extent) (ExtentEdge extent child)) ((ScalarExtentNeeded child)) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (CallExtent call inner))) ((ScalarExtentNeeded inner)) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (Scalar source)) (= ctx (ScalarSourceContext source)) (ScalarRoot ctx region source value))
      ((set (ScalarExtentValue (Scalar source)) value)) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (Length source)) (= extent (RectangularExtent (Length source))) (!= extent (Length source))
       (= value (ScalarExtentValue extent))) ((set (ScalarExtentValue (Length source)) value)) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (Length source)) (= (RectangularExtent (Length source)) (Length source)) (LengthType t))
      ((set (ScalarExtentValue (Length source)) (ScalarLength (ScalarDimensions) t source))) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (Fixed n)) (LengthType t))
      ((set (ScalarExtentValue (Fixed n)) (ScalarLiteral (ScalarDimensions) t (to-string n)))) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (Product a b)) (LengthType t) (= x (ScalarExtentValue a)) (= y (ScalarExtentValue b)))
      ((set (ScalarExtentValue (Product a b)) (ScalarBinary (ScalarDimensions) t "*" x y))) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded (Difference a b)) (LengthType t) (= x (ScalarExtentValue a)) (= y (ScalarExtentValue b)))
      ((set (ScalarExtentValue (Difference a b)) (ScalarBinary (ScalarDimensions) t "-" x y))) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded extent) (= extent (CallExtent call inner)) (= region (PlanCallee call)) (= body (ScalarExtentValue inner)))
      ((set (ScalarExtentValue extent) (ScalarSub (ScalarDimensions) body region (ScalarExtentArgs extent)))) :ruleset scalar-extents)
(rule ((ScalarExtentNeeded extent) (ExtentBinding extent formal actual) (ExtentSource formal source)
       (= i (SourceParameterIndex source)) (= value (ScalarExtentValue actual)))
      ((set (ScalarArgumentAt (ScalarExtentArgs extent) i) value)) :ruleset scalar-extents)
(rule ((= extent (CallExtent call inner)) (= (ExtentUniform extent) true) (= value (ScalarExtentValue extent)))
      ((ScalarExtentRoot extent value)) :ruleset scalar-extents)

; Captures and length queries resolve before the common parameter substitution.
(rewrite (ScalarSub (ScalarDimensions) (ScalarLeaf old t formal) region args)
         (ScalarSub (ScalarDimensions) value region args)
         :when ((SourceCapture owner formal actual) (= ctx (ScalarSourceContext actual)) (ScalarRoot ctx scope actual value))
         :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub (ScalarDimensions) (ScalarExecute old t source) region args)
         (ScalarSub (ScalarDimensions) value region args)
         :when ((= array (SourceLength source)) (= value (ScalarExtentValue (Length array))))
         :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarLength old t source) region args) value
         :when ((= region (SourceParameterRegion source)) (= i (SourceParameterIndex source)) (= value (ScalarArgumentAt args i)))
         :subsume :ruleset scalar-substitute)
(rewrite (ScalarSub ctx (ScalarLength old t source) region args) (ScalarLength ctx t source)
         :when ((= other (SourceParameterRegion source)) (!= other region)) :subsume :ruleset scalar-substitute)
