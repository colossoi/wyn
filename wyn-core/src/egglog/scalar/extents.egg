; Dimension recipes use the same substitution rules and extracted scalar DAG as arithmetic.
(constructor ExtentExprArgs (Extent) ExprArgs :unextractable)
(relation ExtentExprRoot (Extent Expr))
(ruleset scalar-extents)
(ruleset scalar-extent-sources)
(relation ExtentExprDemand (Extent))
(function ExtentExprValue (Extent) Expr :no-merge)
(function ExtentExprCapture (SourceValue) bool :merge (or old new))
(rule ((ExprLeaf ctx t source)) ((set (ExtentExprCapture source) false)) :ruleset scalar-extent-sources)
(rule ((SourceCapture region formal actual)) ((set (ExtentExprCapture formal) true)) :ruleset scalar-extent-sources)
(rule ((= extent (CallExtent call inner)) (= (ExtentUniform extent) true))
      ((ExtentExprDemand extent) (ExprContextActive (ExprContextDimensions))) :ruleset scalar-extents)
(rule ((ExtentExprDemand extent) (ExtentEdge extent child)) ((ExtentExprDemand child)) :ruleset scalar-extents)
(rule ((ExtentExprDemand (CallExtent call inner))) ((ExtentExprDemand inner)) :ruleset scalar-extents)
(rule ((ExtentExprDemand (Scalar source)) (= ctx (ExprContextForSource source)) (ExprRoot ctx region source value))
      ((set (ExtentExprValue (Scalar source)) value)) :ruleset scalar-extents)
(rule ((ExtentExprDemand (Length source)) (= extent (RectangularExtent (Length source))) (!= extent (Length source))
       (= value (ExtentExprValue extent))) ((set (ExtentExprValue (Length source)) value)) :ruleset scalar-extents)
(rule ((ExtentExprDemand (Length source)) (= (RectangularExtent (Length source)) (Length source)) (LengthType t))
      ((set (ExtentExprValue (Length source)) (ExprLength (ExprContextDimensions) t source))) :ruleset scalar-extents)
(rule ((ExtentExprDemand (Fixed n)) (LengthType t))
      ((set (ExtentExprValue (Fixed n)) (ExprLiteral (ExprContextDimensions) t (to-string n)))) :ruleset scalar-extents)
(rule ((ExtentExprDemand (Product a b)) (LengthType t) (= x (ExtentExprValue a)) (= y (ExtentExprValue b)))
      ((set (ExtentExprValue (Product a b)) (ExprBinary (ExprContextDimensions) t "*" x y))) :ruleset scalar-extents)
(rule ((ExtentExprDemand (Difference a b)) (LengthType t) (= x (ExtentExprValue a)) (= y (ExtentExprValue b)))
      ((set (ExtentExprValue (Difference a b)) (ExprBinary (ExprContextDimensions) t "-" x y))) :ruleset scalar-extents)
(rule ((ExtentExprDemand extent) (= extent (CallExtent call inner)) (= region (PlanCallee call)) (= body (ExtentExprValue inner)))
      ((set (ExtentExprValue extent) (ExprSub (ExprContextDimensions) body region (ExtentExprArgs extent)))) :ruleset scalar-extents)
(rule ((ExtentExprDemand extent) (ExtentBinding extent formal actual) (ExtentSource formal source)
       (= i (SourceParameterIndex source)) (= value (ExtentExprValue actual)))
      ((set (ExprArgumentAt (ExtentExprArgs extent) i) value)) :ruleset scalar-extents)
(rule ((= extent (CallExtent call inner)) (= (ExtentUniform extent) true) (= value (ExtentExprValue extent)))
      ((ExtentExprRoot extent value)) :ruleset scalar-extents)

; Captures and length queries resolve before the common parameter substitution.
(rewrite (ExprSub (ExprContextDimensions) (ExprLeaf old t formal) region args)
         (ExprSub (ExprContextDimensions) value region args)
         :when ((SourceCapture owner formal actual) (= ctx (ExprContextForSource actual)) (ExprRoot ctx scope actual value))
         :subsume :ruleset scalar-substitute)
(rewrite (ExprSub (ExprContextDimensions) (ExprExecute old t source) region args)
         (ExprSub (ExprContextDimensions) value region args)
         :when ((= array (SourceLength source)) (= value (ExtentExprValue (Length array))))
         :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprLength old t source) region args) value
         :when ((= region (SourceParameterRegion source)) (= i (SourceParameterIndex source)) (= value (ExprArgumentAt args i)))
         :subsume :ruleset scalar-substitute)
(rewrite (ExprSub ctx (ExprLength old t source) region args) (ExprLength ctx t source)
         :when ((= other (SourceParameterRegion source)) (!= other region)) :subsume :ruleset scalar-substitute)
