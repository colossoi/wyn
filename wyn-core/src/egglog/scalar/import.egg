; Admission follows source identities in place. Only completed expressions enter Expr.
(datatype AdmissionForm
  (AdmitLeaf) (AdmitExecute) (AdmitLiteral i64)
  (AdmitParameter RegionKey i64) (AdmitAlias SourceValue) (AdmitField SourceValue)
  (AdmitProject SourceValue i64) (AdmitChoice SourceValue SourceValue SourceValue)
  (AdmitTuple SourceArguments bool) (AdmitVector SourceArguments)
  (AdmitOperator String SourceArguments bool bool)
  (AdmitCall SourceValue SourceArguments bool bool))
; Call flags: reusable invocation, and ordinary syntax arguments (rather than implicit callback arguments).
; Operator flags: retained instruction, and unary/binary specialization.
(relation ExprSyntax (SourceValue))
(relation ExprLiteralBits (SourceValue i64))
(relation ExprSourceOperator (SourceValue String bool bool))
(relation ExprImportInlining ())
(relation ExprSourceCandidate (SourceValue bool i64 AdmissionForm))
(function ExprSourceRank (SourceValue bool) i64 :merge (max old new))
(function ExprSourceForm (SourceValue bool) AdmissionForm :no-merge)
(function ExprSourceDuplicate (SourceValue) bool :merge (or old new))
(function ExprSourceView (SourceValue) bool :merge (or old new))
(function ExprSourceRematerialize (SourceValue) bool :merge (or old new))
(ruleset scalar-source-flags)
(ruleset scalar-source-forms)
(ruleset scalar-source-select)
(rule ((= ty (SourceType s)))
      ((set (ExprSourceDuplicate s) false)
       (set (ExprSourceView s) false) (set (ExprSourceRematerialize s) false)
       (ExprSourceCandidate s false 0 (AdmitLeaf)) (ExprSourceCandidate s true 0 (AdmitLeaf))) :ruleset scalar-source-flags)
(rule ((= (SourceDuplicable s) true)) ((set (ExprSourceDuplicate s) true)) :ruleset scalar-source-flags)
(rule ((= (HasViewStage s) true)) ((set (ExprSourceView s) true)) :ruleset scalar-source-flags)
(rule ((= op (SourceValueOperation s)) (= (Rematerialize op) true))
      ((set (ExprSourceRematerialize s) true)) :ruleset scalar-source-flags)
; Precedence preserves parameters and forwarding before stored operation boundaries.
(rule ((ExprSourceCandidate s expand 0 form) (ExprSyntax s))
      ((ExprSourceCandidate s expand 1 (AdmitExecute))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (ExprLiteralBits s bits))
      ((ExprSourceCandidate s expand 2 (AdmitLiteral bits))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= owner (SourceParameterRegion s)) (= i (SourceParameterIndex s)))
      ((ExprSourceCandidate s expand 7 (AdmitParameter owner i))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= actual (SourceAlias s)))
      ((ExprSourceCandidate s expand 6 (AdmitAlias actual))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= (SourceProjection s) (ProjectionInfo parent i)) (SourceField parent i field) (!= s field))
      ((ExprSourceCandidate s expand 5 (AdmitField field))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= s (SourceInvocation scope function args)))
      ((ExprSourceCandidate s expand 4 (AdmitCall function args false false))) :ruleset scalar-source-forms)
(rule ((= (SourceHasOperation s) true))
      ((ExprSourceCandidate s false 3 (AdmitLeaf))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (ExprSyntax s) (= (SourceProjection s) (ProjectionInfo parent i)))
      ((ExprSourceCandidate s expand 2 (AdmitProject parent i))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= (SourceConstruct s) "tuple") (= args (SourceArgumentsOf s)))
      ((ExprSourceCandidate s expand 2 (AdmitTuple args true))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= (SourceConstruct s) "zip") (= args (SourceArgumentsOf s)))
      ((ExprSourceCandidate s expand 2 (AdmitTuple args false))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= (SourceConstruct s) "vector") (= args (SourceArgumentsOf s)))
      ((ExprSourceCandidate s expand 2 (AdmitVector args))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= op (SourceConstruct s)) (!= op "tuple") (!= op "vector") (!= op "zip") (= args (SourceArgumentsOf s)) (= ty (SourceType s)))
      ((ExprSourceCandidate s expand 2 (AdmitOperator op args false false)) (ExprOperatorTotal ty op)) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (ExprSourceOperator s op retained safe) (= args (SourceArgumentsOf s)))
      ((ExprSourceCandidate s expand 2 (AdmitOperator op args retained true))) :ruleset scalar-source-forms)
(rule ((ExprSourceOperator s op false true) (= ty (SourceType s))) ((ExprOperatorTotal ty op)) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= a (SourceIndexedArray s)) (= i (SourceIndex s)))
      ((ExprSourceCandidate s expand 2 (AdmitOperator "index" (vec-of a i) true false))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (SourceApply s function) (= args (SourceArgumentsOf s)) (= region (SourceCallable function)) (= duplicate (ExprSourceDuplicate s)))
      ((ExprSourceCandidate s expand 2 (AdmitCall function args duplicate true))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand 0 form) (= (SourceBranch s) (BranchInfo condition yes no)) (= a (SourceResult yes)) (= b (SourceResult no))
       (= operation (SourceHasOperation s)) (= duplicate (ExprSourceDuplicate s)) (= true (or (not operation) duplicate)))
      ((ExprSourceCandidate s expand 2 (AdmitChoice condition a b))) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand rank form)) ((set (ExprSourceRank s expand) rank)) :ruleset scalar-source-forms)
(rule ((ExprSourceCandidate s expand rank form) (= rank (ExprSourceRank s expand)))
      ((set (ExprSourceForm s expand) form)) :ruleset scalar-source-select)

(relation ExprRequest (ExprContext SourceValue bool))
(relation ExprNeed (ExprContext SourceValue bool))
(function ExprImported (ExprContext SourceValue bool) Expr :no-merge)
(function ExprRequested (ExprContext SourceValue bool) Expr :no-merge)
(function ExprImportComplete (ExprContext SourceValue bool) bool :merge (or old new))
(relation ExprChild (ExprContext SourceValue))
(function ExprChildExpand (ExprContext SourceValue) bool :merge (or old new))
(function ExprChildValue (ExprContext SourceValue) Expr :no-merge)
(relation ExprArgsNeed (ExprContext SourceArguments i64 bool))
(function ExprArgsValue (ExprContext SourceArguments i64 bool) ExprArgs :no-merge)
(function ExprArgValue (ExprContext SourceArguments i64 bool) Expr :no-merge)
(relation ExprTemplateDemand (RegionKey))
(function ExprTemplateComplete (RegionKey) bool :merge (or old new))
(ruleset scalar-request)
(ruleset scalar-build)
(rule ((ExprImportRoot c r s expand)) ((ExprRequest c s expand) (ExprContextActive c)) :ruleset scalar-request)
(rule ((ExprRequest c s expand)) ((set (ExprImportComplete c s expand) false)) :ruleset scalar-request)
(rule ((ExprRequest c s expand) (= remat (ExprSourceRematerialize s)) (= view (ExprSourceView s)))
      ((ExprNeed c s (or expand (and remat (not view))))) :ruleset scalar-request)
(rule ((ExprChild c s)) ((set (ExprChildExpand c s) false)) :ruleset scalar-request)
(rule ((ExprChild c s) (= c (ExprContextTemplate region)) (ExprImportTemplateExpansion region s))
      ((set (ExprChildExpand c s) true)) :ruleset scalar-request)
(rule ((ExprChild c s) (= expand (ExprChildExpand c s))) ((ExprRequest c s expand)) :ruleset scalar-build)
(rule ((ExprChild c s) (= expand (ExprChildExpand c s)) (= expr (ExprRequested c s expand)))
      ((set (ExprChildValue c s) expr)) :ruleset scalar-build)
(rule ((ExprRequest c s expand) (= remat (ExprSourceRematerialize s)) (= view (ExprSourceView s))
       (= expr (ExprImported c s (or expand (and remat (not view))))))
      ((set (ExprRequested c s expand) expr) (set (ExprImportComplete c s expand) true)) :ruleset scalar-build)
(rule ((ExprImportRoot c r s expand) (= expr (ExprRequested c s expand))) ((ExprRoot c r s expr)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitLeaf)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprLeaf c ty s))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitExecute)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprExecute c ty s))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitLiteral bits)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprLiteral c ty bits))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitParameter owner i)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprParameter c ty owner i))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitAlias child)) (= dispatched (ExprImportDispatchedSource child)))
      ((ExprRequest c child (and expand (not dispatched)))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitAlias child)) (= dispatched (ExprImportDispatchedSource child)) (= expr (ExprRequested c child (and expand (not dispatched)))))
      ((set (ExprImported c s expand) expr)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitField child))) ((ExprRequest c child false)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitField child)) (= expr (ExprRequested c child false)))
      ((set (ExprImported c s expand) expr)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitProject child i))) ((ExprChild c child)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitProject child i)) (= expr (ExprChildValue c child)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprProject c ty expr i))) :ruleset scalar-build)
; Templates have their own contexts; only substitutions activate them.
(rule ((ExprTemplateDemand region) (ExprImportInlining) (WorkInlineEligible region))
      ((set (ExprTemplateComplete region) false)) :ruleset scalar-request)
(rule ((ExprTemplateDemand region) (ExprImportInlining) (WorkInlineEligible region) (= source (SourceResult region)))
      ((ExprRequest (ExprContextTemplate region) source true) (set (ExprTemplateSafe region) true)) :ruleset scalar-build)
(rule ((ExprTemplateDemand region) (ExprImportInlining) (WorkInlineEligible region) (= source (SourceResult region)) (= expr (ExprRequested (ExprContextTemplate region) source true)))
      ((ExprTemplateBody region expr) (set (ExprTemplateComplete region) true)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitChoice cond yes no))) ((ExprChild c cond)) :ruleset scalar-build)
(function ExprTemplateContext (ExprContext) bool :no-merge)
(rule ((= c (ExprContextTemplate region))) ((set (ExprTemplateContext c) true)) :ruleset scalar-request)
(rule ((= c (ExprContextFunction region))) ((set (ExprTemplateContext c) false)) :ruleset scalar-request)
(rule ((= c (ExprContextKernel plan))) ((set (ExprTemplateContext c) false)) :ruleset scalar-request)
(rule ((= c (ExprContextDispatch op))) ((set (ExprTemplateContext c) false)) :ruleset scalar-request)
(rule ((= c (ExprContextDimensions))) ((set (ExprTemplateContext c) false)) :ruleset scalar-request)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitChoice cond yes no)) (= template (ExprTemplateContext c)))
      ((ExprRequest c yes template) (ExprRequest c no template)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitChoice cond yes no)) (= template (ExprTemplateContext c))
       (= a (ExprRequested c yes template)) (= b (ExprRequested c no template)) (= condition (ExprChildValue c cond)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprChoice c ty condition a b s))) :ruleset scalar-build)

; Ordered operands are source facts, not a second syntax walk.
(rule ((ExprArgsNeed c args i mode) (< i (vec-length args))) ((ExprArgsNeed c args (+ i 1) mode)) :ruleset scalar-build)
(rule ((ExprArgsNeed c args i mode) (= i (vec-length args))) ((set (ExprArgsValue c args i mode) (ExprNil c))) :ruleset scalar-build)
(rule ((ExprArgsNeed c args i false) (< i (vec-length args)) (= child (vec-get args i))) ((ExprRequest c child false)) :ruleset scalar-build)
(rule ((ExprArgsNeed c args i true) (< i (vec-length args)) (= child (vec-get args i))) ((ExprChild c child)) :ruleset scalar-build)
(rule ((ExprArgsNeed c args i false) (= child (vec-get args i)) (= expr (ExprRequested c child false))) ((set (ExprArgValue c args i false) expr)) :ruleset scalar-build)
(rule ((ExprArgsNeed c args i true) (= child (vec-get args i)) (= expr (ExprChildValue c child))) ((set (ExprArgValue c args i true) expr)) :ruleset scalar-build)
(rule ((ExprArgsNeed c args i mode) (= expr (ExprArgValue c args i mode)) (= tail (ExprArgsValue c args (+ i 1) mode)))
      ((set (ExprArgsValue c args i mode) (ExprCons c expr tail))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitTuple args mode))) ((ExprArgsNeed c args 0 mode)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitVector args))) ((ExprArgsNeed c args 0 true)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitOperator op args retained specialized))) ((ExprArgsNeed c args 0 true)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitCall function args invoke mode))) ((ExprArgsNeed c args 0 mode)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitCall function args invoke mode)) (= region (SourceCallable function)) (= true (or invoke (not mode))))
      ((ExprTemplateDemand region)) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitTuple args mode)) (= values (ExprArgsValue c args 0 mode)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprTuple c ty values))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitVector args)) (= values (ExprArgsValue c args 0 true)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprVector c ty values))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitOperator op args true specialized)) (= values (ExprArgsValue c args 0 true)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprInstruction c ty s op values))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitOperator op args false false))
       (= values (ExprArgsValue c args 0 true)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprOp c ty op values))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitOperator op args false true))
       (= values (ExprArgsValue c args 0 true)) (= ty (SourceType s)) (= n (vec-length args)) (!= n 1) (!= n 2))
      ((set (ExprImported c s expand) (ExprOp c ty op values))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitOperator op args false true)) (= 1 (vec-length args)) (= x (ExprArgValue c args 0 true)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprUnary c ty op x))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitOperator op args false true)) (= 2 (vec-length args)) (= x (ExprArgValue c args 0 true)) (= y (ExprArgValue c args 1 true)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprBinary c ty op x y))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitCall function args false mode)) (= region (SourceCallable function)) (= values (ExprArgsValue c args 0 mode)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprCall c ty s region values))) :ruleset scalar-build)
(rule ((ExprNeed c s expand) (= (ExprSourceForm s expand) (AdmitCall function args true mode)) (= region (SourceCallable function)) (= values (ExprArgsValue c args 0 mode)) (= ty (SourceType s)))
      ((set (ExprImported c s expand) (ExprInvoke c ty region values))) :ruleset scalar-build)
