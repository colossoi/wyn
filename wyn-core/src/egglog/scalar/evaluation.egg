; Evaluation of selected occurrences over native source scopes and contexts.
(relation EvaluationReadOnly (i64))
(relation EvaluationTotal (i64))
(relation EvaluationContains (i64 i64))
(relation EvaluationBinding (i64))
(relation EvaluationBindingScope (i64 RegionKey))
(relation EvaluationAvailableAt (i64 RegionKey))
(rule ((EvaluationBindingScope term owner) (FlowScopeAncestor owner scope))
      ((EvaluationAvailableAt term scope)) :ruleset flow-scopes)
(sort EvaluationScopes (Set RegionKey))
(function EvaluationRequirements (i64) EvaluationScopes :merge (set-union old new))
(rule ((FlowNode term)) ((set (EvaluationRequirements term) (set-of))) :ruleset source-summary)
(rule ((FlowScopeRequirement (FlowNode term) scope))
      ((set (EvaluationRequirements term) (set-of scope))) :ruleset source-summary)
(rule ((FlowReach (FlowNode root) (FlowNode leaf)) (EvaluationBinding leaf))
      ((EvaluationContains root leaf)) :ruleset flow-evaluation)
(relation EvaluationAvailable (i64 i64))
(relation EvaluationLeafSource (i64 SourceValue))
(relation EvaluationBoundaryScope (i64 RegionKey SourceValue))
(relation EvaluationCommonAvailable (i64 RegionKey))
(relation EvaluationBefore (i64 i64))
(relation EvaluationHoistable (i64))
(ruleset evaluation-placement)
(rule ((EvaluationBoundaryScope boundary scope source) (EvaluationContains boundary leaf)
       (EvaluationAvailableAt leaf scope) (EvaluationLeafSource leaf other) (!= source other))
      ((EvaluationAvailable boundary leaf)) :ruleset evaluation-placement)
; Containment follows evaluation and scope edges for requested loop/branch roots.
; Earlier bindings already execute in their enclosing region; this restores
; their evaluation without granting permission to speculate their producers.
(rule ((EvaluationContains boundary leaf) (EvaluationAvailable boundary leaf)
       (EvaluationReadOnly leaf))
      ((EvaluationBefore boundary leaf)) :ruleset evaluation-placement)
; Read-only alone is insufficient for moving an expression across a guard.
(rule ((EvaluationReadOnly term) (EvaluationTotal term))
      ((EvaluationHoistable term)) :ruleset evaluation-placement)

; Only branch-arm queries need transitive mandatory-demand sets. Keeping their
; roots explicit avoids computing the all-pairs closure of the expression DAG.
(relation EvaluationPair (i64 i64))
(rule ((EvaluationPair yes no)) ((FlowDemand (FlowNode yes) (FlowNode yes)) (FlowDemand (FlowNode no) (FlowNode no))) :ruleset flow-evaluation)
(relation EvaluationShared (i64 i64 i64))
(relation EvaluationSharedBinding (i64 i64 i64))
(rule ((EvaluationSharedBinding yes no leaf) (EvaluationAvailableAt leaf scope))
      ((EvaluationCommonAvailable leaf scope)) :ruleset evaluation-placement)
(rule ((EvaluationPair yes no) (EvaluationReadOnly yes) (EvaluationReadOnly no)
       (FlowDemand (FlowNode yes) (FlowNode term)) (FlowDemand (FlowNode no) (FlowNode term)))
      ((EvaluationShared yes no term)) :ruleset evaluation-placement)
(rule ((EvaluationPair yes no) (EvaluationReadOnly yes) (EvaluationReadOnly no)
       (EvaluationContains yes leaf) (EvaluationContains no leaf))
      ((EvaluationSharedBinding yes no leaf)) :ruleset evaluation-placement)

; Choose minimal execution frequency, then the latest lexical ancestor at that
; frequency. Ranking stages run separately so provisional minima never become
; permanent placement facts.
(datatype EvaluationQueryId (EvaluationRequest ExprContext RegionKey EvaluationScopes))
(relation EvaluationDemand (ExprContext RegionKey i64))
(relation EvaluationRequested (RegionKey i64))
(relation EvaluationTermContext (i64 ExprContext))
(relation EvaluationArm (i64 i64))
(relation EvaluationPlacement (RegionKey i64 RegionKey))
(relation EvaluationSite (EvaluationQueryId i64 RegionKey i64 i64))
(relation EvaluationContextScope (ExprContext RegionKey))
(function EvaluationScopeLoop (RegionKey) i64 :merge (max old new))
(relation EvaluationQuery (EvaluationQueryId ExprContext RegionKey i64))
(relation EvaluationCandidate (EvaluationQueryId RegionKey i64 i64))
(function EvaluationBlocked (EvaluationQueryId RegionKey) bool :merge (or old new))
(ruleset evaluation-candidates)
(ruleset evaluation-legality)
(ruleset evaluation-sites)
(rule ((EvaluationRequested scope term) (= (FlowEvaluationOperand (FlowNode term) index) (FlowNode child)))
      ((EvaluationRequested scope child)) :ruleset evaluation-candidates)
(rule ((EvaluationRequested scope term) (EvaluationArm term child))
      ((EvaluationRequested scope child)) :ruleset evaluation-candidates)
(rule ((EvaluationRequested scope term) (EvaluationTermContext term context))
      ((EvaluationDemand context scope term)) :ruleset evaluation-candidates)
(rule ((EvaluationDemand context scope term) (EvaluationHoistable term) (= required (EvaluationRequirements term)))
      ((EvaluationQuery (EvaluationRequest context scope required) context scope term)) :ruleset evaluation-candidates)
; Scores are relative to the query scope: fewer remaining loops, then nearest scope.
(rule ((EvaluationQuery query context scope term) (EvaluationContextScope context scope) (EvaluationHoistable term))
      ((EvaluationCandidate query scope 0 0)) :ruleset evaluation-candidates)
(rule ((EvaluationCandidate query child loops depth) (EvaluationQuery query context scope term)
       (FlowScopeParent child parent) (EvaluationContextScope context parent) (= crossed (EvaluationScopeLoop child)))
      ((EvaluationCandidate query parent (- loops crossed) (- depth 1))) :ruleset evaluation-candidates)
(rule ((EvaluationCandidate query site loops depth))
      ((set (EvaluationBlocked query site) false)) :ruleset evaluation-candidates)
(rule ((EvaluationCandidate query site loops depth) (EvaluationQuery query context scope term)
       (FlowScopeRequirement (FlowNode term) required))
      ((set (FlowScopeContains required site) false)) :ruleset evaluation-candidates)
(rule ((EvaluationCandidate query site loops depth) (EvaluationQuery query context scope term)
       (FlowScopeRequirement (FlowNode term) required) (= (FlowScopeContains required site) false))
      ((set (EvaluationBlocked query site) true)) :ruleset evaluation-legality)
(rule ((EvaluationCandidate query site loops depth) (EvaluationQuery query context scope term)
       (= (EvaluationBlocked query site) false))
      ((EvaluationSite query term site loops depth)) :ruleset evaluation-sites)
(function EvaluationLoopDepth (EvaluationQueryId) i64 :merge (min old new))
(function EvaluationLexicalDepth (EvaluationQueryId) i64 :merge (max old new))
(function EvaluationTarget (EvaluationQueryId) RegionKey :no-merge)
(ruleset evaluation-frequency)
(ruleset evaluation-lifetime)
(ruleset evaluation-target)
(rule ((EvaluationSite query term site loops depth) (EvaluationHoistable term))
      ((set (EvaluationLoopDepth query) loops)) :ruleset evaluation-frequency)
(rule ((EvaluationSite query term site loops depth) (= loops (EvaluationLoopDepth query)))
      ((set (EvaluationLexicalDepth query) depth)) :ruleset evaluation-lifetime)
(rule ((EvaluationSite query term site loops depth) (= loops (EvaluationLoopDepth query))
       (= depth (EvaluationLexicalDepth query)))
      ((set (EvaluationTarget query) site)) :ruleset evaluation-target)

(rule ((EvaluationQuery query context scope term) (= target (EvaluationTarget query)))
      ((EvaluationPlacement scope term target)) :ruleset evaluation-target)

; A source leaf is an evaluation anchor: its producer has its own schedule.
; Order inside each anchor is dependency postorder, with pure choices grouped
; only after their mandatory operands. Emission consumes these decisions.
(function ExprScheduleWeight (i64) i64 :no-merge)
(relation ExprScheduleOperand (i64 i64))
(function ExprScheduleCondition (i64) i64 :no-merge)
(function ExprScheduleChoiceDepth (i64) i64 :merge (max old new))
(ruleset schedule-rank)
(rule ((= weight (ExprScheduleWeight term))) ((set (ExprScheduleChoiceDepth term) weight)) :ruleset schedule-rank)
(rule ((= weight (ExprScheduleWeight term)) (ExprScheduleOperand term child) (= rank (ExprScheduleChoiceDepth child)))
      ((set (ExprScheduleChoiceDepth term) (+ rank weight))) :ruleset schedule-rank)
