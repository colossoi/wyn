(rule ((ScalarActive ctx) (= e (ScalarLiteral ctx t value))) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarLeaf ctx t value))) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarParameter ctx t region i))) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= xs (ScalarNil ctx))) ((ScalarArgsTotal ctx xs)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= xs (ScalarCons ctx x tail)) (ScalarTotal ctx x) (ScalarArgsTotal ctx tail)) ((ScalarArgsTotal ctx xs)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarOp ctx t op xs)) (ScalarOperatorSafe t op) (ScalarArgsTotal ctx xs)) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarTuple ctx t xs)) (ScalarArgsTotal ctx xs)) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarVector ctx t xs)) (ScalarArgsTotal ctx xs)) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarProject ctx t x i)) (ScalarTotal ctx x)) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarCoerce ctx t x)) (ScalarTotal ctx x)) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarChoice ctx t c a b)) (ScalarTotal ctx c) (ScalarTotal ctx a) (ScalarTotal ctx b)) ((ScalarTotal ctx e)) :ruleset scalar-analysis)
