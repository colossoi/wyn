(rule ((ScalarActive ctx) (= e (ScalarLiteral ctx t value))) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarLeaf ctx t value))) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarParameter ctx t region i))) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= xs (ScalarNil ctx))) ((ScalarArgsTotal xs)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= xs (ScalarCons ctx x tail)) (ScalarTotal x) (ScalarArgsTotal tail)) ((ScalarArgsTotal xs)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarOp ctx t op xs)) (ScalarOperatorSafe t op) (ScalarArgsTotal xs)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarTuple ctx t xs)) (ScalarArgsTotal xs)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarVector ctx t xs)) (ScalarArgsTotal xs)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarProject ctx t x i)) (ScalarTotal x)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarCoerce ctx t x)) (ScalarTotal x)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarChoice ctx t c a b)) (ScalarTotal c) (ScalarTotal a) (ScalarTotal b)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarUnary ctx t op x)) (ScalarOperatorSafe t op) (ScalarTotal x)) ((ScalarTotal e)) :ruleset scalar-analysis)
(rule ((ScalarActive ctx) (= e (ScalarBinary ctx t op x y)) (ScalarOperatorSafe t op) (ScalarTotal x) (ScalarTotal y)) ((ScalarTotal e)) :ruleset scalar-analysis)
