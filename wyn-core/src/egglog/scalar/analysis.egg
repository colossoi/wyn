(rule ((ExprContextActive ctx) (= e (ExprLiteral ctx t value))) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprLeaf ctx t value))) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprParameter ctx t region i))) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprLength ctx t source))) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= xs (ExprNil ctx))) ((ExprArgsTotal xs)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= xs (ExprCons ctx x tail)) (ExprTotal x) (ExprArgsTotal tail)) ((ExprArgsTotal xs)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprOp ctx t op xs)) (ExprOperatorTotal t op) (ExprArgsTotal xs)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprTuple ctx t xs)) (ExprArgsTotal xs)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprVector ctx t xs)) (ExprArgsTotal xs)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprProject ctx t x i)) (ExprTotal x)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprCoerce ctx t x)) (ExprTotal x)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprChoice ctx t c a b)) (ExprTotal c) (ExprTotal a) (ExprTotal b)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprUnary ctx t op x)) (ExprOperatorTotal t op) (ExprTotal x)) ((ExprTotal e)) :ruleset scalar-analysis)
(rule ((ExprContextActive ctx) (= e (ExprBinary ctx t op x y)) (ExprOperatorTotal t op) (ExprTotal x) (ExprTotal y)) ((ExprTotal e)) :ruleset scalar-analysis)

; A read-only proof does not authorize speculation: guarded reads and loops
; can be read-only without being total.
(rule ((ExprContextActive ctx) (= e (ExprLiteral ctx t value))) ((set (ExprReadOnly e) true)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprParameter ctx t region i))) ((set (ExprReadOnly e) true)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprLength ctx t source))) ((set (ExprReadOnly e) true)) :ruleset scalar-effects)
; Loop state, iteration values, and captures are bound by their invocation.
(rule ((ExprContextActive ctx) (= e (ExprLeaf ctx t (SourceFormal region i)))) ((set (ExprReadOnly e) true)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprLeaf ctx t source)) (= readonly (SourceReadOnly source))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprExecute ctx t source)) (= readonly (SourceReadOnly source))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
; A source summary treats earlier bindings as available; readout may have to
; materialize their selected definitions. Propagate those effects as well.
(rule ((ExprContextActive ctx) (= e (ExprLeaf ctx t source)) (ExprRoot ctx region source root) (= (ExprReadOnly root) false))
      ((set (ExprReadOnly e) false)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= xs (ExprNil ctx))) ((set (ExprArgsReadOnly xs) true)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= xs (ExprCons ctx x tail)) (= a (ExprReadOnly x)) (= b (ExprArgsReadOnly tail))) ((set (ExprArgsReadOnly xs) (and a b))) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprInstruction ctx t source op args)) (= a (SourceReadOnly source)) (= b (ExprArgsReadOnly args))) ((set (ExprReadOnly e) (and a b))) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprCall ctx t source region args)) (= a (SourceReadOnly source)) (= b (ExprArgsReadOnly args))) ((set (ExprReadOnly e) (and a b))) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprInvoke ctx t region args)) (= a (SourceRegionReadOnly region)) (= b (ExprArgsReadOnly args))) ((set (ExprReadOnly e) (and a b))) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprUnary ctx t op x)) (= readonly (ExprReadOnly x))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprBinary ctx t op x y)) (= a (ExprReadOnly x)) (= b (ExprReadOnly y))) ((set (ExprReadOnly e) (and a b))) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprOp ctx t op xs)) (= readonly (ExprArgsReadOnly xs))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprTuple ctx t xs)) (= readonly (ExprArgsReadOnly xs))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprVector ctx t xs)) (= readonly (ExprArgsReadOnly xs))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprProject ctx t x i)) (= readonly (ExprReadOnly x))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprCoerce ctx t x)) (= readonly (ExprReadOnly x))) ((set (ExprReadOnly e) readonly)) :ruleset scalar-effects)
(rule ((ExprContextActive ctx) (= e (ExprChoice ctx t c a b)) (= cr (ExprReadOnly c)) (= ar (ExprReadOnly a)) (= br (ExprReadOnly b))) ((set (ExprReadOnly e) (and cr (and ar br)))) :ruleset scalar-effects)

; A helper retaining an execution boundary from its own body is not a scalar
; substitution template. Caller-supplied stored values remain ordinary inputs.
(rule ((= v (ExprLeaf (ExprContextTemplate r) ty source)) (= owner (ExprContextOwner source)) (= r (ExprContextHome owner)))
      ((set (ExprTemplateSafe r) false)) :ruleset scalar-analysis)
(rule ((= v (ExprExecute (ExprContextTemplate r) ty source)) (= owner (ExprContextOwner source)) (= r (ExprContextHome owner)))
      ((set (ExprTemplateSafe r) false)) :ruleset scalar-analysis)
(rule ((= v (ExprInstruction (ExprContextTemplate r) ty source op args)) (= owner (ExprContextOwner source)) (= r (ExprContextHome owner)))
      ((set (ExprTemplateSafe r) false)) :ruleset scalar-analysis)
(rule ((= v (ExprCall (ExprContextTemplate r) ty source callee args)) (= owner (ExprContextOwner source)) (= r (ExprContextHome owner)))
      ((set (ExprTemplateSafe r) false)) :ruleset scalar-analysis)
