; TLC import, schema version 1. All metadata keys index the matching
; IdArena in AssociatedData. Keys are local to this one emitted program.
(datatype ProgramKey (ProgramId i64))
(datatype Symbol (SymbolId i64))
(datatype Type (TypeId i64))
(datatype TermKey (TermId i64))
(datatype DefinitionKey (DefinitionId i64))
(datatype EntryKey (EntryId i64))
(datatype EntryParamKey (EntryParamId i64))
(datatype InputBoundKey (InputBoundId i64))
(datatype BuiltinKey (BuiltinId i64))
(datatype ExternKey (ExternId i64))
(datatype BucketShapeKey (BucketShapeId i64))
(datatype Ownership (Fresh) (UniqueInput))
(datatype Param (MkParam Symbol Type))
(datatype Params (NoParams) (ParamsCons Param Params))
(datatype Place (MkPlace Symbol Type))

(datatype*
  (Expr
    (Typed Type Expr)
    (Var Symbol)
    (Builtin BuiltinKey)
    (BinOp String)
    (UnOp String)
    (LambdaValue Lambda)
    (Closure Symbol i64 Exprs)
    ; Application carries an occurrence key: no purity proof is assumed.
    (App TermKey Expr Exprs)
    (Let Param Expr Expr)
    ; Integers retain their full spelling/range. Floats retain their f32 bits.
    (Int String)
    (FloatBits i64)
    (Bool bool)
    (UnitLit)
    (Coerce Expr Type)
    (Extern ExternKey)
    (If Expr Expr Expr)
    (Loop TermKey Param Expr Bindings LoopKind Expr)
    (ArrayValue Array)
    (Tuple Exprs)
    (Project Expr i64)
    (Index TermKey Expr Expr)
    (Vector Exprs)
    (Map TermKey SoacBody Arrays Ownership)
    (Reduce TermKey SoacBody Expr Array)
    (Scan TermKey SoacBody Expr Array Ownership)
    (Filter TermKey SoacBody Array Ownership)
    (Scatter TermKey Place SoacBody Arrays)
    (BucketScatter TermKey Place SoacBody Arrays BucketShapeKey)
    (ReduceByIndex TermKey Place SoacBody Expr Array Array))
  (Exprs (NoExprs) (ExprsCons Expr Exprs))
  (OptionalExpr (NoExpr) (SomeExpr Expr))
  (Lambda (MkLambda Params Type Expr))
  (Binding (MkBinding Param Expr))
  (Bindings (NoBindings) (BindingsCons Binding Bindings))
  (LoopKind
    (For Param Expr)
    (ForRange Param Expr)
    (While Expr))
  (SoacBody (MkSoacBody Lambda Bindings))
  (Array
    (ArrayVar Type Expr)
    (Zip Arrays)
    (ArrayLiteral Exprs)
    (Range Expr Expr OptionalExpr))
  (Arrays (NoArrays) (ArraysCons Array Arrays)))

; Relations preserve roots and provenance without making source positions part
; of pure expression equality. Query with the sidecar ID's egglog() value.
(relation Program (ProgramKey))
(relation Definition (DefinitionKey Symbol Type Expr))
(relation Entry (EntryKey DefinitionKey))
(relation EntryParam (EntryParamKey EntryKey i64))
(relation InputBound (InputBoundKey EntryKey Symbol))
(relation SourceTerm (TermKey Expr))
