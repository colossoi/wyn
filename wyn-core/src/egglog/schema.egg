; Fusion graph only. Scalar expressions, types, bodies, argument values, and
; control-flow structure live in AssociatedData, indexed by these opaque IDs.
(datatype RegionKey (RegionId i64))
(datatype OperationKey (OperationId i64))

; Live executions in scopes containing SOACs. Other executions appear only as
; dependency/effect constraints or external observers of a SOAC's result.
(relation Operation (RegionKey OperationKey))
; Input count, result count, scan count, reduction count.
(relation Screma (OperationKey i64 i64 i64 i64))
(relation IdentityPost (OperationKey))
(relation Safe (OperationKey))
(relation Movable (OperationKey))
; Consumer input slot -> producer result slot. No scalar argument syntax.
(relation InputFrom (OperationKey i64 OperationKey i64))
(relation DependsOn (OperationKey OperationKey))
(relation EffectBefore (OperationKey OperationKey))

; A streamed use must not hide a capture, neutral, or externally observed use.
(datatype OperandRole (Input) (Capture) (Neutral) (Argument))
(datatype UseSite (OperationUse OperationKey OperandRole) (ReturnUse))
(relation Use (OperationKey UseSite))
