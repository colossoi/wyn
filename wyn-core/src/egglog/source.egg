; Scalar syntax is complete at import, independently of the original TLC tree.
(relation ExprSyntax (SourceValue))
(relation ExprLiteralBits (SourceValue i64))
(relation ExprSourceOperator (SourceValue String bool bool))
(relation SourcePrimitiveType (TypeKey String))
(relation SourceIntegerType (TypeKey))
(relation SourceRecordUpdateOperator (String))

(datatype ExternalDeclaration (ExternalInfo TypeKey String))
(function SourceExternal (RegionKey) ExternalDeclaration :no-merge)

; An operator definition owns its required operands. The Source* tables below
; are indexed projections used by shared flow and layout analyses.
(datatype FoldMode (FoldTotal) (FoldPrefix))
(datatype Operator
  (ScalarOperator String)
  (MapOperator RegionKey SourceArguments)
  (FoldOperator FoldMode RegionKey SourceValue SourceValue)
  (PackOperator RegionKey SourceValue)
  (WriteOperator RegionKey SourceValue SourceArguments)
  (IndexedOperator RegionKey SourceValue SourceValue SourceValue SourceValue)
  (ReserveOperator RegionKey SourceValue SourceArguments i64 IndexMaps))
(datatype OperationDefinition (DefinedIn RegionKey Operator))
(function OperatorDefinition (OperationKey) OperationDefinition :no-merge)
(function OperatorInputs (OperationKey) SourceArguments :no-merge)
(ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (ScalarOperator kind))))
      ((set (SourceOperation op) (OperationInfo region kind)) (set (OperatorInputs op) (vec-of))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (MapOperator body inputs))))
      ((set (SourceOperation op) (OperationInfo region "map"))
       (set (SourceOperatorBody op) body) (set (OperatorInputs op) inputs)) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (FoldOperator mode body neutral input))))
      ((set (SourceOperatorBody op) body) (set (SourceNeutral op) neutral)
       (set (OperatorInputs op) (vec-of input))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (FoldOperator (FoldTotal) body neutral input))))
      ((set (SourceOperation op) (OperationInfo region "reduce"))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (FoldOperator (FoldPrefix) body neutral input))))
      ((set (SourceOperation op) (OperationInfo region "scan"))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (PackOperator body input))))
      ((set (SourceOperation op) (OperationInfo region "filter"))
       (set (SourceOperatorBody op) body) (set (OperatorInputs op) (vec-of input))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (WriteOperator body destination inputs))))
      ((set (SourceOperation op) (OperationInfo region "scatter")) (set (SourceOperatorBody op) body)
       (set (SourceDestination op) destination) (set (OperatorInputs op) inputs)) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (IndexedOperator body destination neutral keys values))))
      ((set (SourceOperation op) (OperationInfo region "reduce-by-index")) (set (SourceOperatorBody op) body)
       (set (SourceDestination op) destination) (set (SourceNeutral op) neutral)
       (set (OperatorInputs op) (vec-of keys values))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (ReserveOperator body destination inputs rank maps))))
      ((set (SourceOperation op) (OperationInfo region "bucket-scatter")) (set (SourceOperatorBody op) body)
       (set (SourceDestination op) destination) (set (OperatorInputs op) inputs)
       (set (SourceDomainRank op) rank)) :ruleset operator-structure)
(relation OperatorInputAt (OperationKey i64))
(rule ((= inputs (OperatorInputs op)))
      ((OperatorInputAt op 0)) :ruleset operator-structure)
(rule ((OperatorInputAt op i) (= inputs (OperatorInputs op)) (< i (vec-length inputs)))
      ((set (SourceInput op i) (vec-get inputs i)) (OperatorInputAt op (+ i 1))) :ruleset operator-structure)

; A callable region is one immutable signature/body pair. Indexed facts are views.
(datatype RegionCapture (CaptureBinding SourceValue SourceValue))
(sort RegionCaptures (Vec RegionCapture))
(datatype RegionBodyData (RegionBody SourceArguments RegionCaptures SourceValue))
(function RegionDefinition (RegionKey) RegionBodyData :no-merge)
(relation RegionParameterAt (RegionKey i64))
(relation RegionCaptureAt (RegionKey i64))
(rule ((= (RegionDefinition region) (RegionBody parameters captures result)))
      ((set (SourceResult region) result) (RegionParameterAt region 0) (RegionCaptureAt region 0)) :ruleset operator-structure)
(rule ((RegionParameterAt region i) (= (RegionDefinition region) (RegionBody parameters captures result))
       (< i (vec-length parameters)))
      ((set (SourceParameter region i) (vec-get parameters i)) (RegionParameterAt region (+ i 1))) :ruleset operator-structure)
(rule ((RegionCaptureAt region i) (= (RegionDefinition region) (RegionBody parameters captures result))
       (< i (vec-length captures)) (= (vec-get captures i) (CaptureBinding formal actual)))
      ((set (SourceCapture region formal) actual) (RegionCaptureAt region (+ i 1))) :ruleset operator-structure)

; Input coordinate maps are immutable vectors. Pick an extent witness before
; deriving shapes; repeated mappings of one axis need only one source dimension.
(relation InputMapAt (OperationKey i64 i64))
(function DomainInput (OperationKey i64) i64 :merge (max old new))
(function DomainDimension (OperationKey i64 i64) i64 :merge (max old new))
(rule ((= (OperatorDefinition op) (DefinedIn region (ReserveOperator body dest inputs rank maps)))
       (OperatorInputAt op i) (< i (vec-length maps)))
      ((set (SourceInputMap op i) (vec-get maps i)) (InputMapAt op i 0)) :ruleset operator-structure)
(rule ((InputMapAt op input dimension) (= mapping (SourceInputMap op input)) (< dimension (vec-length mapping))
       (= axis (vec-get mapping dimension)))
      ((set (DomainInput op axis) input) (set (DomainDimension op axis input) dimension)
       (InputMapAt op input (+ dimension 1))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (DefinedIn region (IndexedOperator body dest neutral keys values))))
      ((set (SourceIndexedReducer op) false)) :ruleset source-summary)
(relation AtomicScalarName (String))
(AtomicScalarName "i32")
(AtomicScalarName "u32")
(rule ((= (OperatorDefinition op) (DefinedIn region (IndexedOperator body dest neutral keys values)))
       (= ty (SourceType dest)) (SourceArrayElement ty element) (SourcePrimitiveType element kind)
       (AtomicScalarName kind))
      ((set (SourceIndexedReducer op) true)) :ruleset source-summary)

(function ArrayTypeRank (TypeKey) i64 :merge (max old new))
(relation ArrayTypeAxis (TypeKey i64 ArraySize))
(rule ((= ty (TypeId id))) ((set (ArrayTypeRank ty) 0)) :ruleset operator-structure)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (= n (ArrayTypeRank element)))
      ((set (ArrayTypeRank ty) (+ n 1))) :ruleset operator-structure)
(rule ((= size (SourceArraySize ty))) ((ArrayTypeAxis ty 0 size)) :ruleset operator-structure)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (ArrayTypeAxis element i size))
      ((ArrayTypeAxis ty (+ i 1) size)) :ruleset operator-structure)

; The loop record owns control and carried values; these are indexed projections.
(rule ((= loop (SourceLoop source)) (= loop (LoopInfo header body form state initial)) (= next (SourceResult body)))
      ((set (LoopHeader header) loop) (set (SourceLoopForm source) form)
       (set (SourceLoopInitial header) (LoopInitialInfo state initial))
       (SourceLoopBackedge header state next)) :ruleset operator-structure)
