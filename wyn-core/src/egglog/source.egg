; These are source identities and placement constraints, not arithmetic enodes.
; Occurrences include their execution scope. Equality of optimized values must
; never erase the distinction between executions in different scopes.
; A lifted callback's implicit application belongs to its invocation region.
(sort SourceArguments (Vec SourceValue))
(constructor SourceInvocation (RegionKey SourceValue SourceArguments) SourceValue)
(function SourceDefinition (i64) RegionKey :no-merge)

(relation SourceParent (RegionKey RegionKey))
(relation SourceRegionUse (RegionKey SourceValue))
(relation SourceRootRegion (RegionKey))
; Lexical nesting alone does not establish dominance across callable boundaries.

(function SourceParameter (RegionKey i64) SourceValue :no-merge)
(function SourceParameterRegion (SourceValue) RegionKey :no-merge)
(function SourceParameterIndex (SourceValue) i64 :no-merge)
; Immediate operands, including aliases and SOAC inputs. Region dependency
; summaries are deliberately excluded: these are actual value uses.
(relation SourceDirectUse (SourceValue SourceValue))
; Free values evaluated by a nested region, not direct operand occurrences.
(relation SourceNestedUse (SourceValue SourceValue))
(relation SourceOperand (OperationKey SourceValue))
(function SourceResult (RegionKey) SourceValue :no-merge)
(datatype SourceOperationData (OperationInfo RegionKey String))
(function SourceOperation (OperationKey) SourceOperationData :no-merge)
(function SourceOperationValue (OperationKey) SourceValue :no-merge)
(function SourceValueOperation (SourceValue) OperationKey :no-merge)
(datatype SourceBranchData (BranchInfo SourceValue RegionKey RegionKey))
(function SourceBranch (SourceValue) SourceBranchData :no-merge)
(datatype LoopForm (ForCount SourceValue TypeKey) (ForEach SourceValue) (WhileCondition SourceValue))
(datatype SourceLoopData (LoopInfo RegionKey RegionKey LoopForm SourceValue SourceValue))
(function LoopHeader (RegionKey) SourceLoopData :no-merge)
(function SourceLoop (SourceValue) SourceLoopData :no-merge)
(datatype SourceLoopInitialData (LoopInitialInfo SourceValue SourceValue))
(function SourceLoopInitial (RegionKey) SourceLoopInitialData :no-merge)
(relation SourceLoopBackedge (RegionKey SourceValue SourceValue))

(function SourceIterationValue (RegionKey) SourceValue :no-merge)
(function SourceOperatorBody (OperationKey) RegionKey :no-merge)
(function SourceCapture (RegionKey SourceValue) SourceValue :no-merge)
(function SourceCallable (SourceValue) RegionKey :no-merge)

; Finite source summaries. Arithmetic remains outside equality saturation.
(function SourceType (SourceValue) TypeKey :no-merge)
(function SourceBuiltin (SourceValue) String :no-merge)

(relation SourceArrayElement (TypeKey TypeKey))
(relation SourceArrayType (TypeKey))
(relation SourceApply (SourceValue SourceValue))
(relation SourceClosureCode (SourceValue SourceValue))
(function SourceLength (SourceValue) SourceValue :no-merge)
(relation SourceScratch (SourceValue Extent))
(function SourceRequiresDevice (SourceValue) bool :merge (or old new))
(function SourceSpeculatable (SourceValue) bool :merge (and old new))
(function SourceReadOnly (SourceValue) bool :merge (and old new))
(function SourceDuplicable (SourceValue) bool :merge (and old new))
(function SourceWork (SourceValue) i64 :no-merge)
(function SourceInput (OperationKey i64) SourceValue :no-merge)
(function SourceNeutral (OperationKey) SourceValue :no-merge)
(function SourceDestination (OperationKey) SourceValue :no-merge)
; Permission belongs to a value, independently of its current consumers.
(relation SourceReusePermission (SourceValue RegionKey))
(function SourceDomainExtent (OperationKey) Extent :no-merge)
(function SourceDomainShape (OperationKey) DomainShape :no-merge)
(function SourceExtent (SourceValue) Extent :no-merge)
(constructor SourceArrayAtom (SourceValue i64) SourceValue)
(constructor SourceDescriptorPart (SourceValue i64) SourceValue)
(constructor SourceProjected (SourceValue i64) SourceValue)
(relation SourceOriginalEntry (i64 RegionKey bool))
(datatype SourceOutputData (OutputInfo i64 SourceValue TypeKey bool))
(function SourceOutput (i64) SourceOutputData :no-merge)

(function SourceStorage (SourceValue) bool :merge (or old new))

(relation SourceViewType (TypeKey))
(sort SourceTypes (Vec TypeKey))
(datatype ArraySize (FixedSize i64) (DynamicSize))
(function SourceArraySize (TypeKey) ArraySize :no-merge)
(function SourceArrayDimension (TypeKey) TypeKey :no-merge)
(function SourceStorageStride (TypeKey) i64 :no-merge)
(function SourceByteSize (TypeKey) i64 :no-merge)
(function SourceTypeFields (TypeKey) SourceTypes :no-merge)
(function SourceAggregateShape (TypeKey) TypeKey :no-merge)
(relation SourceOwnedArrayType (TypeKey))
(relation SourceBufferedArrayType (TypeKey))
(relation SourceAtomicType (TypeKey))

(relation SourceResultOperand (SourceValue i64 SourceValue))
(relation SourceEntryParameter (RegionKey i64 bool bool))
(function SourceParameterStorageAccess (RegionKey i64) i64 :no-merge)

(relation SourceBlockLayout (TypeKey i64 i64))
(function SourceLoopForm (SourceValue) LoopForm :no-merge)
(function SourceDomainRank (OperationKey) i64 :no-merge)
(function SourceDomainAxis (OperationKey i64) Extent :no-merge)
(relation SourceDomainInputAxis (OperationKey i64 i64))
(sort IndexMap (Vec i64))
(sort IndexMaps (Vec IndexMap))
(function SourceInputMap (OperationKey i64) IndexMap :no-merge)

(relation SourceDispatchLoop (SourceValue))
(relation SourceLoopAggregate (SourceValue SourceValue))
(relation SourceLoopField (SourceValue SourceValue i64 SourceValue))
(relation SourceLoopCarry (SourceValue i64 SourceValue SourceValue SourceValue SourceValue bool))
(function SourceLoopDomain (SourceValue) Extent :no-merge)
(function SourceInteger32 (SourceValue) i64 :no-merge)

(function SourceEvaluationPosition (SourceValue) i64 :merge (min old new))

(function SourceIndexedArray (SourceValue) SourceValue :no-merge)

(relation SourceBinary (SourceValue String SourceValue SourceValue))

(relation SourceSubgroupScalar (TypeKey))

(function SourceIndex (SourceValue) SourceValue :no-merge)
(relation SourceUnitRange (SourceValue SourceValue SourceValue))

(function SourceArgumentsOf (SourceValue) SourceArguments :no-merge)
(function SourceConstruct (SourceValue) String :no-merge)

; Scalar syntax is complete at import, independently of the original TLC tree.
(relation ExprSyntax (SourceValue))
(relation ExprLiteralBits (SourceValue i64))
(relation ExprSourceOperator (SourceValue String bool bool))
(relation SourcePrimitiveType (TypeKey String))
(relation SourceIntegerType (TypeKey))
(relation SourceRecordUpdateOperator (String))

(datatype ExternalDeclaration (ExternalInfo TypeKey String))
(function SourceExternal (RegionKey) ExternalDeclaration :no-merge)

; An operator definition owns its required operands. The Source* tables below
; are indexed projections used by shared flow and layout analyses.
(datatype FoldMode (FoldTotal) (FoldPrefix))
(datatype Operator
  (ScalarOperator String)
  (MapOperator RegionKey SourceArguments)
  (FoldOperator FoldMode RegionKey SourceValue SourceValue)
  (PackOperator RegionKey SourceValue)
  (WriteOperator RegionKey SourceValue SourceArguments)
  (IndexedOperator RegionKey SourceValue SourceValue SourceValue SourceValue)
  (ReserveOperator RegionKey SourceValue SourceArguments i64 IndexMaps))
(function OperatorDefinition (OperationKey) Operator :no-merge)
(function RegionOperationOwner (OperationKey) RegionKey :no-merge)
(function OperatorInputs (OperationKey) SourceArguments :no-merge)
(ruleset operator-structure)
(rule ((= (OperatorDefinition op) (ScalarOperator kind)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region kind)) (set (OperatorInputs op) (vec-of))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (MapOperator body inputs)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "map"))
       (set (SourceOperatorBody op) body) (set (OperatorInputs op) inputs)) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (FoldOperator mode body neutral input)) (= region (RegionOperationOwner op)))
      ((set (SourceOperatorBody op) body) (set (SourceNeutral op) neutral)
       (set (OperatorInputs op) (vec-of input))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (FoldOperator (FoldTotal) body neutral input)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "reduce"))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (FoldOperator (FoldPrefix) body neutral input)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "scan"))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (PackOperator body input)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "filter"))
       (set (SourceOperatorBody op) body) (set (OperatorInputs op) (vec-of input))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (WriteOperator body destination inputs)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "scatter")) (set (SourceOperatorBody op) body)
       (set (SourceDestination op) destination) (set (OperatorInputs op) inputs)) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (IndexedOperator body destination neutral keys values)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "reduce-by-index")) (set (SourceOperatorBody op) body)
       (set (SourceDestination op) destination) (set (SourceNeutral op) neutral)
       (set (OperatorInputs op) (vec-of keys values))) :ruleset operator-structure)
(rule ((= (OperatorDefinition op) (ReserveOperator body destination inputs rank maps)) (= region (RegionOperationOwner op)))
      ((set (SourceOperation op) (OperationInfo region "bucket-scatter")) (set (SourceOperatorBody op) body)
       (set (SourceDestination op) destination) (set (OperatorInputs op) inputs)
       (set (SourceDomainRank op) rank)) :ruleset operator-structure)
(relation OperatorInputAt (OperationKey i64))
(rule ((= inputs (OperatorInputs op)))
      ((OperatorInputAt op 0)) :ruleset operator-structure)
(rule ((OperatorInputAt op i) (= inputs (OperatorInputs op)) (< i (vec-length inputs)))
      ((set (SourceInput op i) (vec-get inputs i)) (OperatorInputAt op (+ i 1))) :ruleset operator-structure)

; A region owns its signature and ordered operations. Indexed facts are views.
(datatype RegionCapture (CaptureBinding SourceValue SourceValue))
(sort RegionCaptures (Vec RegionCapture))
(sort RegionOperations (Vec OperationKey))
(datatype RegionBodyData (RegionBody SourceArguments RegionCaptures RegionOperations SourceValue))
(function RegionDefinition (RegionKey) RegionBodyData :no-merge)
(relation RegionParameterAt (RegionKey i64))
(relation RegionCaptureAt (RegionKey i64))
(relation RegionOperationAt (RegionKey i64))
(relation ImportedPosition (OperationKey i64))
(relation SourceNextOperation (OperationKey OperationKey))
(rule ((= (RegionDefinition region) (RegionBody parameters captures operations result)))
      ((set (SourceResult region) result) (RegionParameterAt region 0) (RegionCaptureAt region 0)
       (RegionOperationAt region 0)) :ruleset operator-structure)
(rule ((RegionParameterAt region i) (= (RegionDefinition region) (RegionBody parameters captures operations result))
       (< i (vec-length parameters)))
      ((set (SourceParameter region i) (vec-get parameters i)) (RegionParameterAt region (+ i 1))) :ruleset operator-structure)
(rule ((RegionCaptureAt region i) (= (RegionDefinition region) (RegionBody parameters captures operations result))
       (< i (vec-length captures)) (= (vec-get captures i) (CaptureBinding formal actual)))
      ((set (SourceCapture region formal) actual) (RegionCaptureAt region (+ i 1))) :ruleset operator-structure)

(rule ((RegionOperationAt region i) (= (RegionDefinition region) (RegionBody parameters captures operations result))
       (< i (vec-length operations)))
      ((set (RegionOperationOwner (vec-get operations i)) region)
       (ImportedPosition (vec-get operations i) i) (RegionOperationAt region (+ i 1))) :ruleset operator-structure)
(rule ((RegionOperationAt region i) (= (RegionDefinition region) (RegionBody parameters captures operations result))
       (< (+ i 1) (vec-length operations)))
      ((SourceNextOperation (vec-get operations i) (vec-get operations (+ i 1)))) :ruleset operator-structure)

; Input coordinate maps are immutable vectors. Pick an extent witness before
; deriving shapes; repeated mappings of one axis need only one source dimension.
(relation InputMapAt (OperationKey i64 i64))
(function DomainInput (OperationKey i64) i64 :merge (max old new))
(function DomainDimension (OperationKey i64 i64) i64 :merge (max old new))
(rule ((= (OperatorDefinition op) (ReserveOperator body dest inputs rank maps)) (= region (RegionOperationOwner op))
       (OperatorInputAt op i) (< i (vec-length maps)))
      ((set (SourceInputMap op i) (vec-get maps i)) (InputMapAt op i 0)) :ruleset operator-structure)
(rule ((InputMapAt op input dimension) (= mapping (SourceInputMap op input)) (< dimension (vec-length mapping))
       (= axis (vec-get mapping dimension)))
      ((set (DomainInput op axis) input) (set (DomainDimension op axis input) dimension)
       (InputMapAt op input (+ dimension 1))) :ruleset operator-structure)
(relation AtomicScalarName (String))
(AtomicScalarName "i32")
(AtomicScalarName "u32")
(function ArrayTypeRank (TypeKey) i64 :merge (max old new))
(relation ArrayTypeAxis (TypeKey i64 ArraySize))
(rule ((= ty (TypeId id))) ((set (ArrayTypeRank ty) 0)) :ruleset operator-structure)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (= n (ArrayTypeRank element)))
      ((set (ArrayTypeRank ty) (+ n 1))) :ruleset operator-structure)
(rule ((= size (SourceArraySize ty))) ((ArrayTypeAxis ty 0 size)) :ruleset operator-structure)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (ArrayTypeAxis element i size))
      ((ArrayTypeAxis ty (+ i 1) size)) :ruleset operator-structure)

; The loop record owns control and carried values; these are indexed projections.
(rule ((= loop (SourceLoop source)) (= loop (LoopInfo header body form state initial)) (= next (SourceResult body)))
      ((set (LoopHeader header) loop) (set (SourceLoopForm source) form)
       (set (SourceLoopInitial header) (LoopInitialInfo state initial))
       (SourceLoopBackedge header state next)) :ruleset operator-structure)

; Structural analyses project the imported expressions, never a parallel
; interpretation of the original syntax tree.
(rule ((ExprSourceOperator value op false safe) (= args (SourceArgumentsOf value)) (= (vec-length args) 2))
      ((SourceBinary value op (vec-get args 0) (vec-get args 1))) :ruleset operator-structure)
(rule ((ExprSourceOperator value "index" retained safe) (= args (SourceArgumentsOf value)) (= (vec-length args) 2))
      ((set (SourceIndexedArray value) (vec-get args 0)) (set (SourceIndex value) (vec-get args 1))) :ruleset operator-structure)
(relation Integer32Name (String))
(Integer32Name "i32")
(Integer32Name "u32")
(rule ((ExprLiteralBits value bits) (= ty (SourceType value)) (SourcePrimitiveType ty name) (Integer32Name name))
      ((set (SourceInteger32 value) bits)) :ruleset operator-structure)
(rule ((= (SourceBuiltin value) "length") (= args (SourceArgumentsOf value)) (= (vec-length args) 1))
      ((set (SourceLength value) (vec-get args 0))) :ruleset operator-structure)
(rule ((= (SourceBuiltin value) "_w_intrinsic_slice") (= args (SourceArgumentsOf value)) (= (vec-length args) 3))
      ((set (SourceSlice value) (SliceInfo (vec-get args 0) (vec-get args 1) (vec-get args 2)))) :ruleset operator-structure)
(rule ((= (SourceBuiltin value) "scratch") (= args (SourceArgumentsOf value)) (= (vec-length args) 1))
      ((SourceScratch value (Scalar (vec-get args 0)))) :ruleset operator-structure)
(rule ((= (SourceBuiltin value) "duplicate_scratch") (= args (SourceArgumentsOf value)) (= (vec-length args) 1))
      ((SourceScratch value (Length (vec-get args 0)))) :ruleset operator-structure)
(relation ReturnsArrayOperand (String))
(ReturnsArrayOperand "_w_intrinsic_array_with")
(ReturnsArrayOperand "_w_intrinsic_array_with_inplace")
(rule ((= name (SourceBuiltin value)) (ReturnsArrayOperand name) (= args (SourceArgumentsOf value)) (= (vec-length args) 3))
      ((SourceResultOperand value 0 (vec-get args 0))) :ruleset operator-structure)
(function SourceMetadataOnly (SourceValue) bool :merge (or old new))
(rule ((= value (SourceOperationValue op))) ((set (SourceMetadataOnly value) false)) :ruleset operator-structure)
(rule ((= array (SourceLength value))) ((set (SourceMetadataOnly value) true)) :ruleset operator-structure)
(rule ((SourceScratch value (Length array))) ((set (SourceMetadataOnly value) true)) :ruleset operator-structure)
