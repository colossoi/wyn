; These are source identities and placement constraints, not arithmetic enodes.
; Occurrences include their execution scope. Equality of optimized values must
; never erase the distinction between executions in different scopes.
; A lifted callback's implicit application belongs to its invocation region.
(sort SourceArguments (Vec SourceValue))
(constructor SourceInvocation (RegionKey SourceValue SourceArguments) SourceValue)
(relation SourceDefinition (i64 RegionKey))
(relation SourceEntryPoint (i64 RegionKey))
(relation SourceParent (RegionKey RegionKey))
(relation SourceRootRegion (RegionKey))
; Lexical nesting alone does not establish dominance across callable boundaries.
(relation SourceEnteredBy (RegionKey SourceValue))
(function SourceParameter (RegionKey i64) SourceValue :no-merge)
(function SourceParameterRegion (SourceValue) RegionKey :no-merge)
(function SourceParameterIndex (SourceValue) i64 :no-merge)
(relation SourceComputedUse (SourceValue SourceValue))
; Immediate operands, including aliases and SOAC inputs. Region dependency
; summaries are deliberately excluded: these are actual value uses.
(relation SourceDirectUse (SourceValue SourceValue))
(relation SourceOperand (OperationKey SourceValue))
(function SourceAlias (SourceValue) SourceValue :no-merge)
(function SourceResult (RegionKey) SourceValue :no-merge)
(relation SourceOperation (OperationKey RegionKey String))
(function SourceOperationValue (OperationKey) SourceValue :no-merge)
(function SourceValueOperation (SourceValue) OperationKey :no-merge)
(relation SourceBranch (SourceValue SourceValue RegionKey RegionKey))
(relation SourceLoop (SourceValue RegionKey RegionKey))
(relation SourceLoopInitial (RegionKey SourceValue SourceValue))
(relation SourceLoopBackedge (RegionKey SourceValue SourceValue))
(relation SourceLoopCondition (RegionKey SourceValue))
(function SourceIterationValue (RegionKey) SourceValue :no-merge)
(function SourceOperatorBody (OperationKey) RegionKey :no-merge)
(relation SourceCapture (RegionKey SourceValue SourceValue))
(relation SourceCallable (SourceValue RegionKey))

; Finite source summaries. Arithmetic remains outside equality saturation.
(function SourceType (SourceValue) TypeKey :no-merge)
(relation SourceScalarLayout (TypeKey))
(relation SourceArrayElement (TypeKey TypeKey))
(relation SourceArrayType (TypeKey))
(relation SourceApply (SourceValue SourceValue))
(relation SourceClosureCode (SourceValue SourceValue))
(relation SourceProjection (SourceValue SourceValue i64))
(relation SourceField (SourceValue i64 SourceValue))
(function SourceLength (SourceValue) SourceValue :no-merge)
(relation SourceSlice (SourceValue SourceValue SourceValue SourceValue))
(relation SourceScratch (SourceValue Extent))
(function SourceDevice (SourceValue) bool :merge (or old new))
(function SourcePure (SourceValue) bool :merge (and old new))
(function SourceReadOnly (SourceValue) bool :merge (and old new))
(function SourceDuplicable (SourceValue) bool :merge (and old new))
(function SourceWork (SourceValue) i64 :no-merge)
(function SourceInput (OperationKey i64) SourceValue :no-merge)
(function SourceNeutral (OperationKey) SourceValue :no-merge)
(function SourceDestination (OperationKey) SourceValue :no-merge)
; Permission belongs to a value, independently of its current consumers.
(relation SourceReusePermission (SourceValue RegionKey))
(relation SourceBucketDomain (OperationKey Extent))
(relation SourceKnownBucketDomain (OperationKey bool))
(function SourceExtent (SourceValue) Extent :no-merge)
(constructor SourceArrayAtom (SourceValue i64) SourceValue)
(constructor SourceProjected (SourceValue i64) SourceValue)
(relation SourceArrayPart (SourceValue i64 SourceValue))
(relation SourceOriginalEntry (i64 RegionKey bool))
(relation SourceOutput (i64 i64 SourceValue TypeKey bool))

(function SourceInputCount (OperationKey) i64 :no-merge)
(function SourceStorage (SourceValue) bool :merge (or old new))
(relation SourceStorageField (SourceValue))
(relation SourceViewType (TypeKey))
(sort SourceTypes (Vec TypeKey))
(datatype ArraySize (FixedSize i64) (DynamicSize))
(function SourceArraySize (TypeKey) ArraySize :no-merge)
(function SourceArrayDimension (TypeKey) TypeKey :no-merge)
(function SourceStorageStride (TypeKey) i64 :no-merge)
(function SourceByteSize (TypeKey) i64 :no-merge)
(function SourceTypeFields (TypeKey) SourceTypes :no-merge)
(function SourceAggregateShape (TypeKey) TypeKey :no-merge)
(relation SourceOwnedArrayType (TypeKey))
(relation SourceBufferedArrayType (TypeKey))
(relation SourceAtomicType (TypeKey))
(relation SourceSameShape (SourceValue SourceValue))
(relation SourceResultOperand (SourceValue i64))
(relation SourceEntryParameter (RegionKey i64 bool bool))
(relation SourceParameterStorageAccess (RegionKey i64 i64))
(relation SourceImmutableParameter (RegionKey i64))
(relation SourceBlockLayout (TypeKey i64 i64))
(datatype LoopForm (ForCount SourceValue TypeKey) (ForEach SourceValue) (WhileCondition SourceValue))
(function SourceLoopForm (SourceValue) LoopForm :no-merge)
(relation SourceIndexedReducer (OperationKey bool AtomicUpdate))
(function SourceBucketRank (OperationKey) i64 :no-merge)
(function SourceBucketAxis (OperationKey i64) Extent :no-merge)
(relation SourceBucketInputAxis (OperationKey i64 i64))
(function SourceBucketInputRank (OperationKey i64) i64 :no-merge)
(function SourceBucketInputDimension (OperationKey i64 i64) i64 :no-merge)

(relation SourceCountedArrayLoop (SourceValue))
(function SourceInteger32 (SourceValue) i64 :no-merge)
