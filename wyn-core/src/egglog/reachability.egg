; Effect classification is complete before this stratum runs. Nonmovable work
; constrains ordering; nondiscardable work supplies an additional liveness root.
(ruleset reachability)
(relation ActiveRegion (RegionKey))
(relation Demanded (Expr))
(relation Precedes (OperationKey OperationKey))
(relation OrderingBarrier (OperationKey))
(function Intermediates (OperationKey OperationKey) OperationSet :merge (set-union old new))

(rule ((Operation r op t a) (set-not-contains (MovableMembers r) op))
      ((OrderingBarrier op)) :ruleset reachability)
(rule ((Operation r op t a) (set-not-contains (DiscardableMembers r) op))
      ((RequiredEffect op)) :ruleset reachability)
; Unknown effects may conflict with reads in otherwise pure array operations.
; Preserve their source order with every member, but never order two safe ops
; just because one appeared earlier in TLC.
(rule ((Operation r before bt ba) (Operation r after at aa)
       (SourcePosition before bp) (SourcePosition after ap) (< bp ap) (OrderingBarrier before))
      ((EffectBefore before after)) :ruleset reachability)
(rule ((Operation r before bt ba) (Operation r after at aa)
       (SourcePosition before bp) (SourcePosition after ap) (< bp ap) (OrderingBarrier after))
      ((EffectBefore before after)) :ruleset reachability)

; Work BACKWARD from results and required effects, never from every member.
; Effect-order edges constrain the schedule but do not keep dead pure work alive.
(rule ((Definition d s t r)) ((ActiveRegion r)) :ruleset reachability)
(rule ((ActiveRegion r) (RegionResult r i e)) ((Demanded e)) :ruleset reachability)
(rule ((ActiveRegion r) (Operation r op t a) (RequiredEffect op)) ((LiveOperation r op)) :ruleset reachability)
(rule ((Demanded e) (ExprChild e x)) ((Demanded x)) :ruleset reachability)
(rule ((Demanded (OperationResult op)) (Operation r op t a)) ((LiveOperation r op)) :ruleset reachability)
(rule ((Demanded (LambdaValue r))) ((ActiveRegion r)) :ruleset reachability)
(rule ((LiveOperation r op) (Operation r op t a) (Operand a role e)) ((Demanded e)) :ruleset reachability)
(rule ((LiveOperation r op) (Operation r op t a) (ActionRegion a child)) ((ActiveRegion child)) :ruleset reachability)

(rule ((DependsOn after before) (Operation r before bt ba) (Operation r after at aa)
       (LiveOperation r before) (LiveOperation r after)) ((Precedes before after)) :ruleset reachability)
(rule ((EffectBefore before after) (Operation r before bt ba)
       (LiveOperation r before) (LiveOperation r after)) ((Precedes before after)) :ruleset reachability)
(rule ((Precedes a b) (Precedes b c)) ((Precedes a c)) :ruleset reachability)
; Contracting a->b is illegal when a surviving node lies on another path
; a->...->b. This covers dependency cycles and opaque effect barriers alike.
(rule ((DependsOn consumer producer)) ((set (Intermediates producer consumer) (set-empty))) :ruleset reachability)
(rule ((DependsOn consumer producer) (Precedes producer middle) (Precedes middle consumer)
       (!= middle producer) (!= middle consumer))
      ((set (Intermediates producer consumer) (set-of middle))) :ruleset reachability)

; These sets are complete before fusion runs. Multiple roles count separately:
; a streamed use cannot hide a capture or a neutral dependency.
(ruleset uses)
(datatype UseSite (OperationUse OperationKey OperandRole) (ReturnUse RegionKey))
(sort UseSet (Set UseSite))
(function Uses (OperationKey) UseSet :merge (set-union old new))
(rule ((Operation r op t a)) ((set (Uses op) (set-empty))) :ruleset uses)
(rule ((LiveOperation r consumer) (Operation r consumer t a)
       (Operand a role e) (ValueDependency e producer))
      ((set (Uses producer) (set-of (OperationUse consumer role)))) :ruleset uses)
(rule ((ActiveRegion r) (ResultDependsOn r producer))
      ((set (Uses producer) (set-of (ReturnUse r)))) :ruleset uses)
(rule ((LiveOperation r consumer) (Operation r consumer t a)
       (ActionRegion a child) (RegionDependency child producer))
      ((set (Uses producer) (set-of (OperationUse consumer (Capture))))) :ruleset uses)
