; A compacted array used only for its outer length needs a count, not storage.
(ruleset compact-length-analysis)
(ruleset compact-length-select)
(function CompactDataObserved (Function ValueName) bool :merge (or old new))
(function CompactLengthSites (Function ValueName) StatementIds :merge (set-union old new))
(function CompactLengthHead (StatementIds) StatementId :no-merge)
(function CompactLengthEdits (Function ValueName ValueName) StatementEdits :merge (set-union old new))
(relation CompactDataUse (Exp ValueName))
(rule ((= expression (Index array indices))) ((CompactDataUse expression array)) :ruleset compact-length-analysis)
(rule ((= expression (View array slices))) ((CompactDataUse expression array)) :ruleset compact-length-analysis)
(rule ((= expression (Copy array))) ((CompactDataUse expression array)) :ruleset compact-length-analysis)
(rule ((= expression (Update mode array slices value))) ((CompactDataUse expression array)) :ruleset compact-length-analysis)
(rule ((= expression (Length array axis)) (!= axis 0)) ((CompactDataUse expression array)) :ruleset compact-length-analysis)
(rule ((= expression (BucketScatter array lambda sources mappings rank)))
      ((CompactDataUse expression array)) :ruleset compact-length-analysis)
(rule ((ContainsExp (FunctionRoot function) expression) (CompactDataUse expression array))
      ((set (CompactDataObserved function array) true)) :ruleset compact-length-analysis)
(rule ((ContainsAtom (FunctionRoot function) (Var array)))
      ((set (CompactDataObserved function array) true)) :ruleset compact-length-analysis)
(rule ((ContainsAccInput (FunctionRoot function) (AccumulatorInput arrays policy))
       (WalkValueNames arrays i) (< i (vec-length arrays)) (= array (vec-get arrays i)))
      ((set (CompactDataObserved function array) true)) :ruleset compact-length-analysis)
(rule ((ContainsExp (FunctionRoot function) (BucketScatter destination lambda arrays mappings rank))
       (WalkValueNames arrays i) (< i (vec-length arrays)) (= array (vec-get arrays i)))
      ((set (CompactDataObserved function array) true)) :ruleset compact-length-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution domain (ParallelBlock statements clauses))))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Compact predicate (vec-of (Yield proofs (ValueOperand atom)))))
       (= offset (ClauseOffset clauses i)) (= (vec-get pattern offset) (BindValue array info)))
      ((set (CompactDataObserved function array) false)
       (set (CompactLengthSites function array) (set-empty))) :ruleset compact-length-analysis)
(rule ((ContainsStm (FunctionRoot function)
          (Let id (vec-of (BindValue name info)) certs (Length array 0)))
       (= (ValueSlot info) (ScalarSlot (ScalarElement (I32))))
       (= used (UsedNames function)) (set-contains used (ValueNameRef name)))
      ((set (CompactLengthSites function array) (set-of id))) :ruleset compact-length-analysis)
(rule ((= sites (CompactLengthSites function array)) (> (set-length sites) 0))
      ((set (CompactLengthHead sites) (set-get sites 0))) :ruleset compact-length-select)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (= (CompactDataObserved function array) false)
       (= sites (CompactLengthSites function array)) (= length-id (CompactLengthHead sites))
       (ContainsStm (FunctionRoot function)
          (Let length-id (vec-of (BindValue count info)) certs (Length array 0))))
      ((set (CompactLengthEdits function array count) (set-empty))) :ruleset compact-length-select)
(rule ((= edits (CompactLengthEdits function array count))
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Length array 0))))
      ((set (CompactLengthEdits function array count) (set-of
          (ReplaceStatement id (Let id pattern certs (Use (ValueOperand (Var count)))))))) :ruleset compact-length-select)
(rule ((= edits (CompactLengthEdits function array count)))
      ((ReplacementMapDemand edits)) :ruleset compact-length-select)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (= (CompactDataObserved function array) false)
       (= sites (CompactLengthSites function array)) (= length-id (CompactLengthHead sites))
       (ContainsStm (FunctionRoot function)
          (Let length-id (vec-of (BindValue count info)) length-certs (Length array 0)))
       (ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution domain (ParallelBlock statements clauses))))
       (= domain (IterationSpace flat (vec-of (DenseAxis index size))))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Compact predicate (vec-of (Yield proofs (ValueOperand atom)))))
       (= offset (ClauseOffset clauses i)) (= (vec-get pattern offset) (BindValue array array-info))
       (= edits (CompactLengthEdits function array count)) (= map (ReplacementMap edits)))
      ((let scalar (ScalarInfo (ScalarElement (I32))))
       (let flag (CallValue (FusionStatement length-id) array))
       (let left (CallValue (CallParameter length-id 0) array))
       (let right (CallValue (CallParameter length-id 1) array))
       (let sum (CallValue (CallResult length-id 0) array))
       (let choose (Let (FusionStatement length-id) (vec-of (BindValue flag scalar)) (vec-of)
          (If predicate (vec-of (ReturnScalar (ScalarElement (I32))))
              (Block (vec-of) (vec-of (Yield (vec-of) (ValueOperand (LiteralBits (I32) 1)))))
              (Block (vec-of) (vec-of (Yield (vec-of) (ValueOperand (LiteralBits (I32) 0))))))))
       (let combine (FunctionBody
          (vec-of (Parameter (BindValue left scalar) (Observe)) (Parameter (BindValue right scalar) (Observe)))
          (vec-of (ReturnScalar (ScalarElement (I32))))
          (Block (vec-of (Let (CallResult length-id 0) (vec-of (BindValue sum scalar)) (vec-of)
              (IndexOp (IndexAdd (IndexValue left) (IndexValue right)))))
            (vec-of (Yield (vec-of) (ValueOperand (Var sum)))))))
       (let clause (Fold (Total) (Reduction (Commutative) (vec-of (LiteralBits (I32) 0)) combine)
          (vec-of (Yield (vec-of) (ValueOperand (Var flag))))))
       (set (PendingRewrite "compact-count" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert map length-id (vec-of)) id (vec-of
                  (Let id (vec-set pattern offset (BindValue count info)) certs
                      (Parallel execution domain
                          (ParallelBlock (vec-push statements choose) (vec-set clauses i clause)))))))))
       (RewriteDemand "compact-count" program)) :ruleset compact-length-select)
