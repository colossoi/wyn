; Logical work estimates guide placement. Missing bounds never justify local storage.
(function BoundedWork (Function Exp) BigInt :no-merge)
(function BodyWork (Function Body) BigInt :no-merge)
(function SequenceWork (Function Stms i64) BigInt :no-merge)
(function DomainWork (Function DomainAxes i64) BigInt :no-merge)
(function LoopStateBytes (Function Merges i64) BigInt :no-merge)
(function LogicalBytes (LogicalType) BigInt :no-merge)
(function ExtentProduct (Extents i64) BigInt :no-merge)
(function ProductBytes (LogicalTypes i64) BigInt :no-merge)
(function ElementBytes (ElementType) BigInt :no-merge)
(function PrimitiveBytes (PrimType) BigInt :no-merge)
(function ElementProductBytes (ElementTypes i64) BigInt :no-merge)
(set (PrimitiveBytes (I8)) (bigint 1))
(set (PrimitiveBytes (U8)) (bigint 1))
(set (PrimitiveBytes (I16)) (bigint 2))
(set (PrimitiveBytes (U16)) (bigint 2))
(set (PrimitiveBytes (F16)) (bigint 2))
(set (PrimitiveBytes (I32)) (bigint 4))
(set (PrimitiveBytes (U32)) (bigint 4))
(set (PrimitiveBytes (F32)) (bigint 4))
(set (PrimitiveBytes (Bool)) (bigint 4))
(set (PrimitiveBytes (I64)) (bigint 8))
(set (PrimitiveBytes (U64)) (bigint 8))
(set (PrimitiveBytes (F64)) (bigint 8))
(set (PrimitiveBytes (UnitType)) (bigint 0))
(function LocalLoop (Function Exp) bool :merge (or old new))
(function WhileLoop (LoopForm) bool :no-merge)
(relation UnitWork (Exp))
(rule ((= expression (Use operand))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (PrimOp name arguments))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (IndexOp index))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Length name axis))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Index name indices))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (View name slices))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Product atoms))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Project atom field))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Update mode name slices atom))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Accumulate mode name indices atoms))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((= expression (Reserve name indices atom))) ((UnitWork expression)) :ruleset schedule-cost)
(rule ((UnitWork expression) (ContainsExp (FunctionRoot function) expression))
      ((set (BoundedWork function expression) (bigint 1))) :ruleset schedule-cost)
(rule ((ContainsBody (FunctionRoot function) (Block statements results)))
      ((set (SequenceWork function statements 0) (bigint 0))) :ruleset schedule-cost)
(rule ((= work (SequenceWork function statements i))
       (< i (vec-size statements))
       (= (StmsAt statements i) (Let id pattern certs expression))
       (= next (BoundedWork function expression)))
      ((set (SequenceWork function statements (+ i 1)) (+ work next))) :ruleset schedule-cost)
(rule ((ContainsBody (FunctionRoot function) body) (= body (Block statements results))
       (= work (SequenceWork function statements (vec-size statements))))
      ((set (BodyWork function body) work)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (GenerateArray (ArrayLiteral values))))
      ((set (BoundedWork function expression) (bigint (vec-size values)))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (GenerateArray (RangeValues start count step))))
      ((set (BoundedWork function expression) (bigint 1))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (If condition returns yes no))
       (= a (BodyWork function yes)) (= b (BodyWork function no)))
      ((set (BoundedWork function expression) (+ (bigint 1) (max a b)))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression)
       (= expression (Loop merges (Counted name start count step) returns body))
       (= n (StaticIndex function count)) (= work (BodyWork function body)))
      ((set (BoundedWork function expression) (* (bigint (max 0 n)) work))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution (IterationSpace flat axes) (ParallelBlock statements results))))
      ((set (DomainWork function axes 0) (bigint 1)) (set (SequenceWork function statements 0) (bigint 0))) :ruleset schedule-cost)
(rule ((= work (DomainWork function axes i))
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis name size))
       (= n (StaticIndex function size)))
      ((set (DomainWork function axes (+ i 1)) (* work (bigint (max 0 n))))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression)
       (= expression (Parallel execution (IterationSpace flat axes) (ParallelBlock statements results)))
       (= n (DomainWork function axes (vec-size axes))) (= work (SequenceWork function statements (vec-size statements))))
      ((set (BoundedWork function expression) (* n (+ work (bigint 1))))) :ruleset schedule-cost)

; These sizes are cost estimates on logical types, not selected layouts or allocations.
(rule ((= type (ScalarElement primitive)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementBytes type) bytes)) :ruleset schedule-cost)
(rule ((= type (VectorElement primitive lanes)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementBytes type) (* bytes (bigint lanes)))) :ruleset schedule-cost)
(rule ((= type (MatrixElement primitive rows columns)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementBytes type) (* bytes (bigint (* rows columns))))) :ruleset schedule-cost)
(rule ((= type (ProductElement fields))) ((set (ElementProductBytes fields 0) (bigint 0))) :ruleset schedule-cost)
(rule ((= prefix (ElementProductBytes fields i))
       (< i (vec-size fields))
       (= bytes (ElementBytes (ElementTypesAt fields i))))
      ((set (ElementProductBytes fields (+ i 1)) (+ prefix bytes))) :ruleset schedule-cost)
(rule ((= type (ProductElement fields)) (= bytes (ElementProductBytes fields (vec-size fields))))
      ((set (ElementBytes type) bytes)) :ruleset schedule-cost)
(rule ((= type (ElementValue element)) (= bytes (ElementBytes element)))
      ((set (LogicalBytes type) bytes)) :ruleset schedule-cost)
(rule ((= type (ArrayType ownership extents element))) ((set (ExtentProduct extents 0) (bigint 1))) :ruleset schedule-cost)
(rule ((= prefix (ExtentProduct extents i))
       (< i (vec-size extents))
       (= (ExtentsAt extents i) (FixedExtent n)))
      ((set (ExtentProduct extents (+ i 1)) (* prefix (bigint (max 0 n))))) :ruleset schedule-cost)
(rule ((= type (ArrayType ownership extents element)) (= n (ExtentProduct extents (vec-size extents)))
       (= bytes (LogicalBytes element))) ((set (LogicalBytes type) (* n bytes))) :ruleset schedule-cost)
(rule ((= type (ProductType fields))) ((set (ProductBytes fields 0) (bigint 0))) :ruleset schedule-cost)
(rule ((= prefix (ProductBytes fields i))
       (< i (vec-size fields))
       (= bytes (LogicalBytes (LogicalTypesAt fields i))))
      ((set (ProductBytes fields (+ i 1)) (+ prefix bytes))) :ruleset schedule-cost)
(rule ((= type (ProductType fields)) (= bytes (ProductBytes fields (vec-size fields))))
      ((set (LogicalBytes type) bytes)) :ruleset schedule-cost)
(rule ((= form (While condition))) ((set (WhileLoop form) true)) :ruleset schedule-cost)
(rule ((= form (Counted index start count step))) ((set (WhileLoop form) false)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) (Loop merges form returns body)))
      ((set (LoopStateBytes function merges 0) (bigint 0))
       (set (LocalLoop function (Loop merges form returns body)) false)) :ruleset schedule-cost)
(rule ((= bytes (LoopStateBytes function merges i))
       (< i (vec-size merges))
       (= (MergesAt merges i) (Carry (Parameter (BindValue name (ScalarInfo element)) diet) initial)))
      ((set (LoopStateBytes function merges (+ i 1)) bytes)) :ruleset schedule-cost)
(rule ((= bytes (LoopStateBytes function merges i))
       (< i (vec-size merges))
       (= (MergesAt merges i) (Carry (Parameter (BindValue name (LogicalValue type)) diet) initial))
       (= next (LogicalBytes type))
       (<= (+ bytes next) (bigint 16384)))
      ((set (LoopStateBytes function merges (+ i 1)) (+ bytes next))) :ruleset schedule-cost)
