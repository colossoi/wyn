; Type and index proofs accompany a flat graph of operation occurrences.
; Executable bodies and operand lists are not egglog syntax trees.
(datatype FunctionName (FunctionId i64 String))
(datatype ValueName (ValueId i64) (ClonedValue OperationKey ValueName))
(datatype AccName (AccumulatorId i64) (ClonedAccumulator OperationKey AccName))
(datatype Name (ValueNameRef ValueName) (AccNameRef AccName))
(constructor DerivedRegion (OperationKey i64 i64) RegionKey)
(constructor DerivedOperation (OperationKey i64 i64) OperationKey)
(constructor DerivedValue (OperationKey i64 i64) ValueName)
(constructor ClonedOperation (OperationKey OperationKey) OperationKey)
(constructor ClonedRegion (OperationKey RegionKey) RegionKey)
(constructor FlowNamed (ValueName) SourceValue)
(constructor FlowAccumulator (AccName) SourceValue)
(constructor OperationEvaluation (OperationKey) SourceValue)

(datatype PrimType
  (I8) (I16) (I32) (I64) (U8) (U16) (U32) (U64)
  (F16) (F32) (F64) (Bool) (UnitType))
(datatype*
  (ElementType
    (ScalarElement PrimType) (VectorElement PrimType i64)
    (MatrixElement PrimType i64 i64) (ProductElement ElementTypes))
  (sort ElementTypes (Vec ElementType)))

; Index arithmetic is used only by shape, bounds, coordinate and launch proofs.
(datatype IndexExp
  (IndexConstant i64) (IndexValue ValueName)
  (IndexAdd IndexExp IndexExp) (IndexSub IndexExp IndexExp)
  (IndexMul IndexExp IndexExp) (IndexDiv IndexExp IndexExp)
  (IndexMod IndexExp IndexExp) (IndexMin IndexExp IndexExp) (IndexMax IndexExp IndexExp))
(sort Shape (Vec IndexExp))
(datatype DimIndex (At IndexExp) (Slice IndexExp IndexExp IndexExp))
(sort Indices (Vec IndexExp))
(sort Slices (Vec DimIndex))

(datatype ResourceType (TextureType) (SamplerType) (ImageType i64 i64))
(datatype Extent (FixedExtent i64) (UnspecifiedExtent))
(sort Extents (Vec Extent))
(datatype ArrayOwnership (ValueArray) (StorageArray))
(datatype*
  (LogicalType
    (ElementValue ElementType)
    (ArrayType ArrayOwnership Extents LogicalType)
    (ProductType LogicalTypes)
    (ResourceValue ResourceType))
  (sort LogicalTypes (Vec LogicalType)))
(datatype ValueInfo
  (LogicalValue LogicalType) (ScalarInfo ElementType) (ResourceInfo ResourceType))
(datatype AccInfo (AccumulatorInfo Shape ElementTypes) (LogicalAccumulator LogicalType))
(datatype*
  (Diet (Observe) (Consume) (ProductDiet Diets))
  (sort Diets (Vec Diet)))
(datatype ReturnInfo
  (LogicalReturn LogicalType) (ReturnScalar ElementType)
  (ReturnAccumulator AccInfo) (ReturnResource ResourceType))
(datatype CallBehavior (TotalCall) (MayTrapCall))
(datatype ResourceAccess (ReadResource i64) (WriteResource i64))

(datatype Domain (DomainId i64) (ClonedDomain OperationKey Domain))
(function DomainRank (Domain) i64 :no-merge)
(function DomainOrdinal (Domain) ValueName :no-merge)
(function DomainAxis (Domain i64) ValueName :no-merge)
(function DomainExtent (Domain i64) IndexExp :no-merge)
(datatype Grid (AutomaticGrid) (Grid3D Shape Shape))
(datatype Execution (Unscheduled) (DeviceKernel Grid) (InvocationLocal))
(datatype FoldKind
  (Total) (InclusiveScan) (ExclusiveScan)
  (InclusiveScanAndTotal) (ExclusiveScanAndTotal))
(datatype ResultKind (Collected) (Compacted) (Contributed) (Folded FoldKind))
(datatype ResultRole (CollectedOutput) (CompactedOutput) (PrefixOutput) (TotalOutput) (UpdatedOutput))
(datatype AccPolicy (DisjointWrites) (IdenticalWrites) (CombineWrites) (FetchAddWrites))

; Operand and region-edge cells supply the current planning rules.
(function GraphEditRevision () i64 :no-merge)
(set (GraphEditRevision) 0)
(relation Operation (OperationKey))
(relation Region (RegionKey))
(relation AritySlot (i64 i64))
(relation BranchArm (i64))
(BranchArm 0)
(BranchArm 1)
(function InstructionWork (OperationKey) i64 :no-merge)
(relation OperationWorkDemand (OperationKey))
(function OperationWork (OperationKey) BigInt :no-merge)
(function InputDiet (OperationKey i64) Diet :no-merge)
(function ValueType (ValueName) ValueInfo :no-merge)
(function AccumulatorType (AccName) AccInfo :no-merge)
(relation OperationCertificate (OperationKey ValueName))

(function ParameterDiet (RegionKey i64) Diet :no-merge)
(function RegionReturnType (RegionKey i64) ReturnInfo :no-merge)
(relation YieldCertificate (RegionKey i64 ValueName))
(function LoopStart (OperationKey) IndexExp :no-merge)
(function LoopCount (OperationKey) IndexExp :no-merge)
(function LoopStep (OperationKey) IndexExp :no-merge)

(function OperationIndex (OperationKey i64) IndexExp :no-merge)
(function OperationSlices (OperationKey) Slices :no-merge)
(datatype ArrayLayout (TransposeAxes) (FlattenAxes))
(function OperationLayout (OperationKey) ArrayLayout :no-merge)
(function OperationShape (OperationKey) Shape :no-merge)
(function OperationDomain (OperationKey) Domain :no-merge)
(function OperationWidth (OperationKey) i64 :no-merge)
(function OperationExecution (OperationKey) Execution :no-merge)
(function ResultKindOf (OperationKey i64) ResultKind :no-merge)
(function ResultCount (OperationKey) i64 :no-merge)
; Compacted values and packed scan prefixes share the lane predicate.
(function ResultCommutative (OperationKey i64) bool :no-merge)
(function OutputClause (OperationKey i64) i64 :no-merge)
(function OutputField (OperationKey i64) i64 :no-merge)
(function OutputRole (OperationKey i64) ResultRole :no-merge)

(function AccumulatorPolicy (OperationKey i64) AccPolicy :no-merge)
(function AccumulatorGroupCount (OperationKey) i64 :no-merge)
(function AccumulatorParameter (OperationKey i64) AccName :no-merge)

(function RetainAllFunctions () bool :merge (or old new))
(set (RetainAllFunctions) false)
(relation Function (FunctionName))
(relation External (FunctionName))
(function ExternalParameterName (FunctionName i64) ValueName :no-merge)
(function ExternalParameterType (FunctionName i64) ValueInfo :no-merge)
(function ExternalParameterDiet (FunctionName i64) Diet :no-merge)
(function ExternalParameterCount (FunctionName) i64 :no-merge)
(function FunctionResultType (FunctionName i64) ReturnInfo :no-merge)
(function FunctionResultCount (FunctionName) i64 :no-merge)
(function FunctionBehavior (FunctionName) CallBehavior :no-merge)
(function FunctionResourceAccess (FunctionName i64) ResourceAccess :no-merge)
(function CallReturnType (OperationKey i64) ReturnInfo :no-merge)
(function EntryOrder (FunctionName) i64 :no-merge)
(function InvocationEntry (FunctionName) bool :merge (or old new))
(function EntryGrid (FunctionName) Grid :no-merge)
(function GeneratedDispatches () bool :no-merge)
(function SubgroupsEnabled () bool :merge (or old new))
(set (SubgroupsEnabled) false)

; Immutable semantic properties are published from Rust's payload catalogue.
(function LiteralBits (OperationKey) i64 :no-merge)
(function ScalarPayload (OperationKey) InstructionPayload :no-merge)
(function ScalarTypeName (PrimType) String :no-merge)
(relation IntegerScalar (PrimType))
(relation IntegerIdentity (InstructionPayload i64))
(relation LeftIntegerIdentity (InstructionPayload i64))
(relation SubtractionPayload (InstructionPayload))
(relation MultiplicationPayload (InstructionPayload))
(relation DivisionPayload (InstructionPayload))
(relation ShiftPayload (InstructionPayload))
(relation IndexCastPayload (InstructionPayload))
(relation AdditionPayload (InstructionPayload))
(relation SelectPayload (InstructionPayload))
(relation NativeIntegerOpcode (InstructionPayload))
(relation ConstantOperation (OperationKey))
(relation ProductOperation (OperationKey))
(relation ProjectionOperation (OperationKey i64))
(relation LengthOperation (OperationKey i64))
(relation IndexCalculationOperation (OperationKey))
(relation IndexOperation (OperationKey))
(relation CallOperation (OperationKey))
(relation BranchOperation (OperationKey))
(relation CountedLoopOperation (OperationKey))
(relation WhileLoopOperation (OperationKey))
(relation ParallelOperation (OperationKey))
(relation AccumulatorOperation (OperationKey))
(relation DiscardableOperation (OperationKey))
(relation RepeatableOperation (OperationKey))
(relation OrderedOperation (OperationKey))
(relation LaneDependentOperation (OperationKey))
(relation ReadsInput (OperationKey i64))
(relation ConsumesInput (OperationKey i64))
(relation WritesInput (OperationKey i64))
(relation AliasesInput (OperationKey i64 i64))
(relation FreshOutput (OperationKey i64))

(relation MaterializedCopyOperation (OperationKey))
(relation ScratchAllocation (OperationKey))

(relation ViewOperation (OperationKey))

(relation ArrayLiteralOperation (OperationKey))

(relation RangeOperation (OperationKey))

(relation PreservesInputShape (OperationKey i64 i64))
