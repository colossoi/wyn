; Copy propagation, dead statements, and movement of total scalar computation
; share the same binder/effect analyses in every nested region.
(ruleset simplify-analysis)
(ruleset simplify-select)
(function UsedNames (Function) Names :merge (set-union old new))
(relation LiteralCanCross (Exp))
(rule ((= expression (Length source axis))) ((LiteralCanCross expression)) :ruleset simplify-analysis)
(rule ((= expression (Parallel execution domain body))) ((LiteralCanCross expression)) :ruleset simplify-analysis)
; Literal captures have no dependencies or effects. Keep them from separating
; producer/consumer regions; movement stays within the same lexical statement list.
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStms (FunctionRoot function) statements)
       (AdjacentStatements statements first second)
       (= first (Let a pa ca expression)) (LiteralCanCross expression)
       (= second (Let b (vec-of (BindValue name (ScalarInfo (ScalarElement type)))) (vec-of)
          (Use (ValueOperand (LiteralBits type bits))))))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert (map-empty) a (vec-of second first)) b (vec-of)))))
       (RewriteDemand "simplify" program)) :ruleset simplify-select)

; Once callbacks have been substituted, only entry-reachable definitions need
; rewriting. Modules without entry points retain their callable definitions.
(function LiveFunction (Program FunctionName) bool :merge (or old new))
(function RetainedFunctions (Program i64) Functions :no-merge)
(rule ((ProgramFunction program (DefineFunction name params returns body)))
      ((set (LiveFunction program name) false)) :ruleset simplify-analysis)
(rule ((ContainsEntry (ProgramRoot program) (EntryPoint name identity)))
      ((set (LiveFunction program name) true)) :ruleset simplify-analysis)

(rule ((ProgramFunction program function) (= function (DefineFunction name params returns body))
       (= (LiveFunction program name) true) (ContainsExp (FunctionRoot function) (Call target arguments signature)))
      ((set (LiveFunction program target) true)) :ruleset simplify-analysis)
(rule ((CurrentProgram program) (= program (MemoryProgram functions externals entries)) (> (vec-length entries) 0))
      ((set (RetainedFunctions program 0) (vec-of))) :ruleset simplify-select)
(rule ((= prefix (RetainedFunctions program i)) (= program (MemoryProgram functions externals entries))
       (< i (vec-length functions)) (= function (vec-get functions i))
       (= function (DefineFunction name params returns body)) (= (LiveFunction program name) true))
      ((set (RetainedFunctions program (+ i 1)) (vec-push prefix function))) :ruleset simplify-select)
(rule ((= prefix (RetainedFunctions program i)) (= program (MemoryProgram functions externals entries))
       (< i (vec-length functions)) (= (vec-get functions i) (DefineFunction name params returns body))
       (= (LiveFunction program name) false))
      ((set (RetainedFunctions program (+ i 1)) prefix)) :ruleset simplify-select)
(rule ((CurrentProgram program) (= program (MemoryProgram functions externals entries))
       (= live (RetainedFunctions program (vec-length functions))) (!= live functions))
      ((delete (CurrentProgram program)) (CurrentProgram (MemoryProgram live externals entries))) :ruleset simplify-select)
(rule ((ProgramFunction program function)) ((set (UsedNames function) (set-empty))) :ruleset simplify-analysis)
(rule ((ContainsExp (FunctionRoot function) expression) (= used (NamesExp expression)) (= bound (BindersExp expression)))
      ((set (UsedNames function) (set-diff used bound))) :ruleset simplify-analysis)
(rule ((ContainsBinding (FunctionRoot function) binding) (= names (NamesBinding binding)) (= bound (BindersBinding binding)) (= used (set-diff names bound)))
      ((set (UsedNames function) used)) :ruleset simplify-analysis)
(rule ((ContainsReturnInfo (FunctionRoot function) info) (= used (NamesReturnInfo info)))
      ((set (UsedNames function) used)) :ruleset simplify-analysis)
(rule ((ContainsResult (FunctionRoot function) result) (= used (NamesResult result)))
      ((set (UsedNames function) used)) :ruleset simplify-analysis)
(rule ((ContainsParallelResult (FunctionRoot function) result) (= used (NamesParallelResult result)) (= bound (BindersParallelResult result)))
      ((set (UsedNames function) (set-diff used bound))) :ruleset simplify-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs expression)) (= used (NamesCertificates certs)))
      ((set (UsedNames function) used)) :ruleset simplify-analysis)
(rule ((= expression (Use operand))) ((TotalScalarForm expression)) :ruleset simplify-analysis)
(rule ((= expression (PrimOp name arguments))) ((TotalScalarForm expression)) :ruleset simplify-analysis)
(rule ((= expression (IndexOp index))) ((TotalScalarForm expression)) :ruleset simplify-analysis)
(rule ((= expression (Length source axis))) ((TotalScalarForm expression)) :ruleset simplify-analysis)

; Resolve a whole acyclic alias chain before rewriting. Dominance checked by
; memory-scopes makes the terminal source available at every removed copy.
(ruleset simplify-copies)
(datatype CopyAlias (Alias ValueName ValueName StatementId))
(sort CopyAliases (Set CopyAlias))
(function Copies (Program) CopyAliases :merge (set-union old new))
(function Copied (Program ValueName) bool :merge (or old new))
(function CopyTarget (Program ValueName) ValueName :no-merge)
(function CopyRenaming (Program CopyAliases) Renaming :no-merge)
(relation CopyRenamingDemand (Program CopyAliases))
(function CopyAliasesHead (CopyAliases) CopyAlias :no-merge)
(function CopyAliasesTail (CopyAliases) CopyAliases :no-merge)
(rule ((CurrentProgram program)) ((set (Copies program) (set-empty))) :ruleset simplify-analysis)
(rule ((CurrentProgram program) (ContainsValueName (ProgramRoot program) name))
      ((set (Copied program name) false)) :ruleset simplify-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Use (ValueOperand (Var source)))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info))
       (= info (BindingInfo function source)))
      ((set (Copies program) (set-of (Alias name source id))) (set (Copied program name) true)) :ruleset simplify-analysis)
(rule ((= copies (Copies program)) (= alias (Alias name source id)) (set-contains copies alias)
       (= (Copied program source) false))
      ((set (CopyTarget program name) source)) :ruleset simplify-copies)
(rule ((= copies (Copies program)) (= alias (Alias name source id)) (set-contains copies alias)
       (= target (CopyTarget program source)))
      ((set (CopyTarget program name) target)) :ruleset simplify-copies)
(rule ((= copies (Copies program))) ((CopyRenamingDemand program copies)) :ruleset simplify-copies)
(rule ((CopyRenamingDemand program copies) (= copies (set-empty)))
      ((set (CopyRenaming program copies) (Rename (map-empty) (map-empty) (map-empty) (map-empty) (map-empty)))) :ruleset simplify-copies)
(rule ((CopyRenamingDemand program copies) (> (set-length copies) 0))
      ((set (CopyAliasesHead copies) (set-get copies 0))
       (set (CopyAliasesTail copies) (set-remove copies (set-get copies 0)))
       (CopyRenamingDemand program (set-remove copies (set-get copies 0)))) :ruleset simplify-copies)
(rule ((CopyRenamingDemand program copies) (= alias (CopyAliasesHead copies)) (= tail (CopyAliasesTail copies))
       (= alias (Alias name source id)) (= target (CopyTarget program name))
       (= (CopyRenaming program tail) (Rename values blocks tokens statements edits)))
      ((set (CopyRenaming program copies) (Rename (map-insert values name target) blocks tokens statements
          (map-insert edits id (vec-of))))) :ruleset simplify-copies)
(rule ((CurrentProgram program) (= copies (Copies program)) (> (set-length copies) 0)
       (= edit (CopyRenaming program copies)))
      ((set (PendingRewrite "simplify" program) (set-of edit)) (RewriteDemand "simplify" program)) :ruleset simplify-select)

(ruleset simplify-removals)
(ruleset simplify-hoists)
(sort Statements (Set Stm))
(function StatementsHead (Statements) Stm :no-merge)
(function StatementsTail (Statements) Statements :no-merge)
(function DeadStatements (Program) StatementIds :merge (set-union old new))
(function RemoveStatements (StatementIds) StatementReplacements :no-merge)
(relation RemoveStatementsDemand (StatementIds))
(rule ((CurrentProgram program)) ((set (DeadStatements program) (set-empty))) :ruleset simplify-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs expression))
       (= effects (EffectsStm function statement)) (ReadOnlyEffects effects)
       (= (set-intersect (BindersPattern pattern) (UsedNames function)) (set-empty)))
      ((set (DeadStatements program) (set-of id))) :ruleset simplify-removals)
(rule ((= dead (DeadStatements program))) ((RemoveStatementsDemand dead)) :ruleset simplify-select)
(rule ((RemoveStatementsDemand ids) (= ids (set-empty)))
      ((set (RemoveStatements ids) (map-empty))) :ruleset simplify-select)
(rule ((RemoveStatementsDemand ids) (> (set-length ids) 0))
      ((set (StatementIdsHead ids) (set-get ids 0))
       (set (StatementIdsTail ids) (set-remove ids (set-get ids 0)))
       (RemoveStatementsDemand (set-remove ids (set-get ids 0)))) :ruleset simplify-select)
(rule ((RemoveStatementsDemand ids) (= id (StatementIdsHead ids)) (= tail (StatementIdsTail ids))
       (= rest (RemoveStatements tail)))
      ((set (RemoveStatements ids) (map-insert rest id (vec-of)))) :ruleset simplify-select)
(rule ((CurrentProgram program) (= (Copies program) (set-empty))
       (= dead (DeadStatements program)) (> (set-length dead) 0)
       (= edits (RemoveStatements dead)))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty) edits)))
       (RewriteDemand "simplify" program)) :ruleset simplify-select)

; Move independent total preparations before parallel or accumulator scopes.
; Array initialization and scalar preparation obey the same effect check.
(relation FusionPreparation (Exp))
(rule ((TotalScalarForm expression)) ((FusionPreparation expression)) :ruleset simplify-analysis)
(rule ((= expression (GenerateArray generator))) ((FusionPreparation expression)) :ruleset simplify-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (= (Copies program) (set-empty)) (= (DeadStatements program) (set-empty))
       (ContainsStms (FunctionRoot function) statements) (AdjacentStatements statements first next)
       (= first (Let id pattern certs region)) (FusionRegion region)
       (= next (Let other vector-pattern-0 proofs expression))
       (FusionPreparation expression) (= (EffectsStm function next) (set-empty))
       (= (set-intersect (BindersPattern pattern) (NamesStm next)) (set-empty)))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert (map-empty) id (vec-of next first)) other (vec-of)))))
       (RewriteDemand "simplify" program)) :ruleset simplify-select)

; A scope exit is legal when all operands/annotations dominate the parent and
; the moved statement is total and its reads commute with the enclosing body.
; This applies equally to
; branch arms, loop bodies, and parallel bodies before explicit allocation.
; A launch establishes an invocation context even for pure kernel intrinsics.
; Allocation placement handles its host boundary separately.
(relation HoistableScope (Exp))
(relation HoistCostSafe (Function Exp Exp))
(relation HoistCostDemand (Function Exp Exp))
(function OwnershipCopy (Exp) bool :merge (or old new))
(rule ((ContainsExp root expression)) ((set (OwnershipCopy expression) false)) :ruleset simplify-analysis)
(rule ((ContainsExp root expression) (= expression (Copy source)))
      ((set (OwnershipCopy expression) true)) :ruleset simplify-analysis)
(rule ((HoistCostDemand function scope inner) (= scope (If condition signature yes no))
       (= work (BoundedWork function inner))
       (<= work (bigint 4)))
      ((HoistCostSafe function scope inner)) :ruleset simplify-analysis)
(rule ((HoistCostDemand function scope inner) (= scope (Loop carries form signature body)))
      ((HoistCostSafe function scope inner)) :ruleset simplify-analysis)
(rule ((HoistCostDemand function scope inner) (= scope (WithAcc inputs body)))
      ((HoistCostSafe function scope inner)) :ruleset simplify-analysis)
(rule ((HoistCostDemand function scope inner) (= scope (Parallel execution domain body)))
      ((HoistCostSafe function scope inner)) :ruleset simplify-analysis)
(rule ((= expression (If condition signature yes no))) ((HoistableScope expression)) :ruleset simplify-analysis)
(rule ((= expression (Loop carries form signature body))) ((HoistableScope expression)) :ruleset simplify-analysis)
(rule ((= expression (WithAcc inputs body))) ((HoistableScope expression)) :ruleset simplify-analysis)
(rule ((= expression (Parallel execution domain body))) ((HoistableScope expression)) :ruleset simplify-analysis)
(function HoistedStatements (Program Function Stm) Statements :merge (set-union old new))
(function HoistPrefix (Statements) Stms :no-merge)
(function HoistRemovals (Statements) StatementIds :no-merge)
(relation HoistPrefixDemand (Statements))
(rule ((CheckStatement context id pattern expression available) (= function (ScopeRoot context))
       (CheckSequence (NestedScope context id child) statements inner-available)
       (WalkStms statements i) (< i (vec-length statements)) (= inner (vec-get statements i))
       (= inner (Let inner-id inner-pattern proofs operation))
       (= reads (MovableEffects function inner)) (ReadOnlyEffects reads)
       (= enclosing (EffectsExp function expression)))
      ((CompareEffects reads (set-remove enclosing (OrderedEffect)))
       (HoistCostDemand function expression operation)) :ruleset memory-effects)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (= (Copies program) (set-empty)) (= (DeadStatements program) (set-empty))
       (CheckStatement context id pattern expression available)
       (ContainsStm (FunctionRoot function) parent) (= parent (Let id pattern certs expression))
       (HoistableScope expression)
       (CheckSequence (NestedScope context id child) statements inner-available)
       (WalkStms statements i) (< i (vec-length statements)) (= inner (vec-get statements i))
       (= inner (Let inner-id inner-pattern proofs operation))
       (HoistCostSafe function expression operation)
       ; Each consuming iteration needs its own ownership copy, even from an invariant source.
       (= (OwnershipCopy operation) false)
       (= reads (MovableEffects function inner)) (ReadOnlyEffects reads)
       (= enclosing (EffectsExp function expression))
       (= (Commutes reads (set-remove enclosing (OrderedEffect))) true)
       (= free (set-diff (NamesStm inner) (BindersStm inner))) (= (set-diff free available) (set-empty)))
      ((set (HoistedStatements program function parent) (set-of inner))) :ruleset simplify-hoists)
(rule ((= statements (HoistedStatements program function parent)))
      ((HoistPrefixDemand statements)) :ruleset simplify-select)
(rule ((HoistPrefixDemand statements) (= statements (set-empty)))
      ((set (HoistPrefix statements) (vec-of)) (set (HoistRemovals statements) (set-empty))) :ruleset simplify-select)
(rule ((HoistPrefixDemand statements) (> (set-length statements) 0))
      ((set (StatementsHead statements) (set-get statements 0))
       (set (StatementsTail statements) (set-remove statements (set-get statements 0)))
       (HoistPrefixDemand (set-remove statements (set-get statements 0)))) :ruleset simplify-select)
(rule ((HoistPrefixDemand statements) (= statement (StatementsHead statements))
       (= statement (Let id pattern certs expression)) (= rest (StatementsTail statements))
       (= prefix (HoistPrefix rest)) (= ids (HoistRemovals rest)))
      ((set (HoistPrefix statements) (vec-push prefix statement))
       (set (HoistRemovals statements) (set-insert ids id))) :ruleset simplify-select)
(rule ((= statements (HoistedStatements program function parent)) (= ids (HoistRemovals statements)))
      ((RemoveStatementsDemand ids)) :ruleset simplify-select)
(rule ((= statements (HoistedStatements program function parent)) (= ids (HoistRemovals statements))
       (= removals (RemoveStatements ids)) (= parent (Let id pattern certs expression)))
      ((RenameExpDemand (Rename (map-empty) (map-empty) (map-empty) (map-empty) removals) expression)) :ruleset simplify-select)
(rule ((CurrentProgram program) (= statements (HoistedStatements program function parent))
       (= parent (Let id pattern certs expression)) (= prefix (HoistPrefix statements))
       (= ids (HoistRemovals statements)) (= removals (RemoveStatements ids))
       (= next (RenameExp (Rename (map-empty) (map-empty) (map-empty) (map-empty) removals) expression)))
      ((set (PendingRewrite "hoist" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-push prefix (Let id pattern certs next))))))
       (RewriteDemand "hoist" program)) :ruleset simplify-hoists)

; A dead collected value needs no destination, but its lane computation remains
; until ordinary effect-aware dead statement elimination can remove it.


; Copy coalescing leaves an identity transfer; remove it using exact typed
; memory bindings, including the layout, rather than array-name equality.


; Point views compose in the statement language before allocation. This keeps
; row access visible to fusion and preserves the remaining dimensions' bounds.
(function PointIndices (Slices i64) Indices :no-merge)
(rule ((ContainsExp (FunctionRoot function) (View source slices)))
      ((set (PointIndices slices 0) (vec-of))) :ruleset simplify-analysis)
(rule ((= prefix (PointIndices slices i)) (< i (vec-length slices)) (= (vec-get slices i) (At index)))
      ((set (PointIndices slices (+ i 1)) (vec-push prefix index))) :ruleset simplify-analysis)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) (Let view-id bindings proofs (View source slices)))
       (= (vec-length bindings) 1) (= (vec-get bindings 0) (BindValue view info))
       (= prefix (PointIndices slices (vec-length slices)))
       (ContainsStm (FunctionRoot function) (Let id pattern certs (View view suffix))))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of
                  (Let id pattern (vec-append proofs certs) (View source (vec-append slices suffix))))))))
       (RewriteDemand "simplify" program)) :ruleset simplify-select)

; Logical extents are independent of buffer representation. Each value has one
; producer; these facts never infer uniform row sizes from an unproven shape.
(rule ((ContainsParam (FunctionRoot function)
          (Parameter (BindValue name (LogicalValue (ArrayType ownership extents element))) diet))
       (> (vec-length extents) 0) (= (vec-get extents 0) (FixedExtent n)))
      ((set (LogicalOuterCount function name) (IndexConstant n))) :ruleset simplify-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (GenerateArray (RangeValues start count step))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info)))
      ((set (LogicalOuterCount function name) (IndexMax (IndexConstant 0) count))) :ruleset simplify-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (GenerateArray (ArrayLiteral values))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info)))
      ((set (LogicalOuterCount function name) (IndexConstant (vec-length values)))) :ruleset simplify-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution (IterationSpace flat axes) (ParallelBlock statements results))))
       (> (vec-length axes) 0) (= (vec-get axes 0) (DenseAxis index count))
       (WalkParallelResults results i) (< i (vec-length results))
       (= (vec-get results i) (Collect values)) (= offset (ClauseOffset results i))
       (WalkResults values j) (< j (vec-length values)) (< (+ offset j) (vec-length pattern))
       (= (vec-get pattern (+ offset j)) (BindValue name info)))
      ((set (LogicalOuterCount function name) count)) :ruleset simplify-analysis)
; A scan retains the input domain's outer extent, independently of the reducer
; state's own array dimensions. Optional total slots are not prefix arrays.
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution (IterationSpace flat axes) (ParallelBlock statements results))))
       (> (vec-length axes) 0) (= (vec-get axes 0) (DenseAxis index count))
       (WalkParallelResults results i) (< i (vec-length results))
       (= (vec-get results i) (Fold kind (Reduction order neutral lambda) values))
       (FoldSlots kind 1 totals) (= offset (ClauseOffset results i))
       (WalkAtoms neutral j) (< j (vec-length neutral)) (< (+ offset j) (vec-length pattern))
       (= (vec-get pattern (+ offset j)) (BindValue name info)))
      ((set (LogicalOuterCount function name) count)) :ruleset simplify-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (View source slices)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info))
       (= (vec-length slices) 1) (= (vec-get slices 0) (Slice start count stride)))
      ((set (LogicalOuterCount function name) count)) :ruleset simplify-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Length source 0)))
       (= count (LogicalOuterCount function source)))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
            (map-insert (map-empty) id (vec-of (Let id pattern certs (IndexOp count)))))))
       (RewriteDemand "simplify" program)) :ruleset simplify-select)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) (Let id pattern certs (IndexOp (IndexValue source))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info))
       (= info (BindingInfo function source)))
      ((set (Copies program) (set-of (Alias name source id)))
       (set (Copied program name) true)) :ruleset simplify-analysis)
(rule ((= expression (Length name axis))) ((TotalScalarForm expression)) :ruleset simplify-analysis)

; A dead map is discardable only when its reads are within its own domain
; and every other statement is already known to have no observable effects.
(relation DiscardableMapPrefix (Function Domain Stms i64))
(relation DiscardableClauses (ParallelResults i64))
(relation DomainRead (Function Domain Exp))
(rule ((EffectsStmDemand function (Let id pattern certs
          (Parallel execution domain (ParallelBlock statements results)))))
      ((DiscardableMapPrefix function domain statements 0)
       (DiscardableClauses results 0)) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= statement (vec-get statements i)) (= effects (EffectsStm function statement))
       (ReadOnlyEffects effects))
      ((DiscardableMapPrefix function domain statements (+ i 1))) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression)) (DomainRead function domain expression))
      ((DiscardableMapPrefix function domain statements (+ i 1))) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source (vec-of (Var index))))
       (= domain (IterationSpace flat axes)) (WalkDomainAxes axes axis) (< axis (vec-length axes))
       (= (vec-get axes axis) (DenseAxis index count))
       (= count (LogicalOuterCount function source)))
      ((DomainRead function domain expression)) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source (vec-of (Var index))))
       (= domain (IterationSpace flat axes)) (WalkDomainAxes axes axis) (< axis (vec-length axes))
       (= (vec-get axes axis) (DenseAxis index count))
       (= n (StaticIndex function count)) (= source-count (LogicalOuterCount function source))
       (= n (StaticIndex function source-count)))
      ((DomainRead function domain expression)) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source (vec-of (Var index))))
       (= domain (IterationSpace flat axes)) (WalkDomainAxes axes axis) (< axis (vec-length axes))
       (= (vec-get axes axis) (DenseAxis index (IndexValue length)))
       (ContainsStm (FunctionRoot function) (Let lid (vec-of (BindValue length info)) proofs (Length source 0))))
      ((DomainRead function domain expression)) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source (vec-of (Var index))))
       (= domain (IterationSpace flat axes)) (WalkDomainAxes axes axis) (< axis (vec-length axes))
       (= (vec-get axes axis) (DenseAxis index count)) (= n (StaticIndex function count))
       (= (BindingInfo function source) (LogicalValue (ArrayType ownership extents element)))
       (> (vec-length extents) 0) (= (vec-get extents 0) (FixedExtent n)))
      ((DomainRead function domain expression)) :ruleset simplify-analysis)
(rule ((DiscardableClauses results i) (< i (vec-length results))
       (= (vec-get results i) (Collect values)))
      ((DiscardableClauses results (+ i 1))) :ruleset simplify-analysis)
; A proved in-domain read whose value is unused cannot trap or affect memory.
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements results)))
       (WalkStms statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source indices)) (DomainRead function domain expression)
       (= (set-intersect (BindersPattern pattern) (UsedNames function)) (set-empty)))
      ((set (DeadStatements program) (set-of id))) :ruleset simplify-removals)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution domain (ParallelBlock statements results))))
       (DiscardableMapPrefix function domain statements (vec-length statements))
       (DiscardableClauses results (vec-length results))
       (= (set-intersect (BindersPattern pattern) (UsedNames function)) (set-empty)))
      ((set (DeadStatements program) (set-of id))) :ruleset simplify-removals)

; Scratch needs the scalar array's shape, never its elements.
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Scratch source)))
       (= (BindingInfo function source) (LogicalValue (ArrayType ownership extents (ElementValue element))))
       (= (vec-length extents) 1) (= count (LogicalOuterCount function source)))
      ((set (PendingRewrite "simplify" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
            (map-insert (map-empty) id
              (vec-of (Let id pattern certs (GenerateArray (UninitializedShape (vec-of count)))))))))
       (RewriteDemand "simplify" program)) :ruleset simplify-select)

(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source (vec-of (Var index))))
       (= domain (IterationSpace flat (vec-of (DenseAxis index (IndexValue length)))))
       (ContainsStm (FunctionRoot function) (Let lid (vec-of (BindValue length info)) proofs (IndexOp count)))
       (= count (LogicalOuterCount function source)))
      ((DomainRead function domain expression)) :ruleset simplify-analysis)

(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression))
       (= expression (Index source (vec-of position)))
       (= domain (IterationSpace flat (vec-of (DenseAxis index (IndexValue length)))))
       (= position (Var index))
       (ContainsStm (FunctionRoot function)
         (Let lid (vec-of (BindValue length info)) proofs (Use (ValueOperand (LiteralBits (I32) n)))))
       (= (LogicalOuterCount function source) (IndexConstant n)))
      ((DomainRead function domain expression)) :ruleset simplify-analysis)

(rule ((= effects (EffectsStm function statement)) (ReadOnlyEffects effects))
      ((set (MovableEffects function statement) effects)) :ruleset simplify-analysis)
(rule ((EffectsStmDemand function statement)
       (= statement (Let id pattern certs
          (Parallel execution domain (ParallelBlock statements results))))
       (DiscardableMapPrefix function domain statements (vec-length statements))
       (DiscardableClauses results (vec-length results))
       (= effects (EffectsStm function statement)))
      ((set (MovableEffects function statement) (set-remove effects (OrderedEffect)))) :ruleset simplify-analysis)
(rule ((DiscardableMapPrefix function domain statements i) (< i (vec-length statements))
       (= statement (vec-get statements i)) (= effects (MovableEffects function statement))
       (ReadOnlyEffects effects))
      ((DiscardableMapPrefix function domain statements (+ i 1))) :ruleset simplify-analysis)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements results)))
       (DiscardableClauses results i) (< i (vec-length results))
       (= (vec-get results i) (Fold kind (Reduction order neutral combine) values))
       (= effects (EffectsLambda function combine)) (ReadOnlyEffects effects))
      ((DiscardableClauses results (+ i 1))) :ruleset simplify-analysis)

(rule ((= effects (MovableEffects function statement)))
      ((InspectReadOnly effects)) :ruleset memory-effects)

; Drop unused collection outputs while retaining the callback and its effects.
(ruleset simplify-result-analysis)
(ruleset simplify-result-select)
(function FirstDeadCollection (Program Stm) i64 :merge (min old new))
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Compact predicate (vec-of (Yield proofs (ValueOperand atom)))))
       (= offset (ClauseOffset clauses i)) (= (vec-get pattern offset) (BindValue name info))
       (= (set-intersect (UsedNames function) (set-of (ValueNameRef name))) (set-empty)))
      ((set (FirstDeadCollection program statement) i)) :ruleset simplify-result-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Collect results)) (= (vec-length results) 1)
       (= offset (ClauseOffset clauses i)) (= (vec-get pattern offset) (BindValue name info))
       (= (set-intersect (UsedNames function) (set-of (ValueNameRef name))) (set-empty)))
      ((set (FirstDeadCollection program statement) i)) :ruleset simplify-result-analysis)
(rule ((CurrentProgram program) (= i (FirstDeadCollection program statement))
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses i)))
      ((set (PendingRewrite "dead-collections" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
            (map-insert (map-empty) id
              (vec-of (Let id (vec-remove pattern offset) certs
                 (Parallel execution domain (ParallelBlock statements (vec-remove clauses i)))))))))
       (RewriteDemand "dead-collections" program)) :ruleset simplify-result-select)
