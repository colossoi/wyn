; Program membership belongs to the common IR, including signature validation.
(relation CurrentProgram (Program))
(relation AdjacentStatements (Stms Stm Stm))
(rule ((WalkStms statements i) (< (+ i 1) (vec-length statements)))
      ((AdjacentStatements statements (vec-get statements i) (vec-get statements (+ i 1)))) :ruleset memory-names)

(relation ProgramFunctionAt (Program i64))
(relation ProgramFunction (Program Function))
(relation ProgramExternalAt (Program i64))
(relation ProgramExternal (Program External))
; Lexical validation over the unified statement language.
; Run after memory-names reaches a fixed point. Environments are immutable;
; shared syntax is checked separately at each enclosing statement occurrence.
(datatype ScopeContext
  (FunctionScope Function) (ExternalScope External) (NestedScope ScopeContext StatementId i64)
  (ReducerScope ScopeContext i64))
(relation CheckFunction (Function))
(relation CheckBody (ScopeContext Body Names))
(relation CheckSequence (ScopeContext Stms Names))
(function ScopeAt (ScopeContext i64) Names :no-merge)
(relation CheckStatement (ScopeContext StatementId Pattern Exp Names))
(relation CheckLambda (ScopeContext Lambda Names))
(relation CheckParallel (ScopeContext ParallelBody Names Names)) ; lane and enclosing environments
(relation RequiredNames (ScopeContext Names Names)) ; used, available
(relation InvalidScope (ScopeContext String))
(relation StatementOccurrence (StatementId ScopeContext i64))
(function ScopeRoot (ScopeContext) Function :no-merge)
(ruleset memory-scopes)
; Tokens have one successor in a sequence. Branch arms may use the same
; incoming capability, but a loop must carry it through its merge parameter.
(function AccumulatorNames (Names) Names :no-merge)
(relation AccumulatorNamesDemand (Names))
(function NamesHead (Names) Name :no-merge)
(function NamesTail (Names) Names :no-merge)
(function ConsumedTokens (Exp) Names :no-merge)
(rule ((ContainsExp root expression) (= used (NamesExp expression)) (= bound (BindersExp expression)))
      ((AccumulatorNamesDemand (set-diff used bound))) :ruleset memory-scopes)
(rule ((AccumulatorNamesDemand names) (= names (set-empty)))
      ((set (AccumulatorNames names) (set-empty))) :ruleset memory-scopes)
(rule ((AccumulatorNamesDemand names) (> (set-length names) 0))
      ((set (NamesHead names) (set-get names 0))
       (set (NamesTail names) (set-remove names (set-get names 0)))
       (AccumulatorNamesDemand (set-remove names (set-get names 0)))) :ruleset memory-scopes)
(rule ((= first (NamesHead names)) (= tail (NamesTail names))
       (= rest (AccumulatorNames tail)) (= first (AccNameRef name)))
      ((set (AccumulatorNames names) (set-insert rest first))) :ruleset memory-scopes)
(rule ((= first (NamesHead names)) (= tail (NamesTail names))
       (= rest (AccumulatorNames tail)) (= first (ValueNameRef name)))
      ((set (AccumulatorNames names) rest)) :ruleset memory-scopes)
(rule ((= first (NamesHead names)) (= tail (NamesTail names))
       (= rest (AccumulatorNames tail)) (= first (BlockNameRef name)))
      ((set (AccumulatorNames names) rest)) :ruleset memory-scopes)
(rule ((ContainsExp root expression) (= used (NamesExp expression)) (= bound (BindersExp expression))
       (= tokens (AccumulatorNames (set-diff used bound))))
      ((set (ConsumedTokens expression) tokens)) :ruleset memory-scopes)
(rule ((CheckFunction function)) ((ContainsFunction (FunctionRoot function) function)) :ruleset memory-names)

(rule ((CheckFunction function) (= function (DefineFunction name params returns body)))
      ((set (ScopeRoot (FunctionScope function)) function)
       (CheckLambda (FunctionScope function) (FunctionBody params returns body) (set-empty))) :ruleset memory-scopes)
(rule ((= context (NestedScope parent id index)) (= root (ScopeRoot parent)))
      ((set (ScopeRoot context) root)) :ruleset memory-scopes)
(rule ((= context (ReducerScope parent index)) (= root (ScopeRoot parent)))
      ((set (ScopeRoot context) root)) :ruleset memory-scopes)
(rule ((CheckLambda context (FunctionBody params returns body) outer)
       (= bound (BindersParams params)) (= uses (NamesParams params)) (= result-uses (NamesReturnInfos returns)))
      ((RequiredNames context uses (set-union outer bound))
       (RequiredNames context result-uses (set-union outer bound))
       (CheckBody context body (set-union outer bound))) :ruleset memory-scopes)
(rule ((CheckLambda context (FunctionBody params returns body) outer)
       (!= (set-length (BindersParams params)) (vec-length params)))
      ((InvalidScope context "duplicate parameter")) :ruleset memory-scopes)
(rule ((CheckBody context (Block statements results) available))
      ((CheckSequence context statements available)) :ruleset memory-scopes)
(rule ((CheckSequence context statements available))
      ((set (ScopeAt context 0) available)) :ruleset memory-scopes)
(rule ((CheckSequence context statements initial) (= available (ScopeAt context i))
       (< i (vec-length statements)) (= (vec-get statements i) (Let id pattern certificates expression))
       (= proofs (NamesCertificates certificates)) (= bound (BindersPattern pattern))
       (= consumed (ConsumedTokens expression)))
      ((RequiredNames context proofs available)
       (StatementOccurrence id context i)
       (CheckStatement context id pattern expression available)
       (set (ScopeAt context (+ i 1)) (set-union (set-diff available consumed) bound))) :ruleset memory-scopes)
(rule ((StatementOccurrence id first i) (StatementOccurrence id second j) (!= first second)
       (= root (ScopeRoot first)) (= root (ScopeRoot second)))
      ((InvalidScope second "statement appears in multiple scopes")) :ruleset memory-scopes)
(rule ((StatementOccurrence id context i) (StatementOccurrence id context j) (!= i j))
      ((InvalidScope context "statement appears more than once")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern expression available)
       (= uses (NamesExp expression)) (= internal (BindersExp expression))
       (= annotations (NamesPattern pattern)) (= bound (BindersPattern pattern)))
      ((RequiredNames context (set-diff uses internal) available)
       (RequiredNames context annotations (set-union available bound))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern expression available)
       (!= (set-length (BindersPattern pattern)) (vec-length pattern)))
      ((InvalidScope context "duplicate result binding")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern expression available)
       (!= (set-intersect available (BindersPattern pattern)) (set-empty)))
      ((InvalidScope context "result name already in scope")) :ruleset memory-scopes)
(rule ((RequiredNames context used available) (!= (set-diff used available) (set-empty)))
      ((InvalidScope context "operand or annotation outside its scope, or accumulator already consumed")) :ruleset memory-scopes)
(rule ((CheckBody context (Block statements results) initial)
       (= available (ScopeAt context (vec-length statements))) (= uses (NamesResults results)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (If condition returns yes no) available) (= uses (NamesReturnInfos returns)))
      ((CheckBody (NestedScope context id 0) yes available)
       (CheckBody (NestedScope context id 1) no available)
       (RequiredNames context uses available)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Loop merges form returns body) available)
       (= carried (BindersMerges merges)) (= index (BindersLoopForm form)) (= uses (NamesReturnInfos returns))
       (= consumed (ConsumedTokens (Loop merges form returns body))))
      ((CheckBody (NestedScope context id 0) body
         (set-union (set-diff available consumed) (set-union carried index)))
       (RequiredNames context uses available)) :ruleset memory-scopes)
(relation CheckMergeAt (ScopeContext Merges Names i64))
(rule ((CheckStatement context id pattern (Loop merges form returns body) available))
      ((CheckMergeAt context merges available 0)) :ruleset memory-scopes)
(rule ((CheckMergeAt context merges available i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry parameter initial)) (= uses (NamesOperand initial)))
      ((RequiredNames context uses available) (CheckMergeAt context merges available (+ i 1))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Loop merges (Counted name start count step) returns body) available)
       (= a (NamesIndexExp start)) (= b (NamesIndexExp count)) (= c (NamesIndexExp step)))
      ((RequiredNames context (set-union a (set-union b c)) available)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Parallel execution domain body) available) (= indices (BindersDomain domain)))
      ((CheckParallel (NestedScope context id 0) body
         (set-union available indices) available)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= uses (NamesExecution execution)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)
; A domain's extents cannot depend on its own coordinates. Dependent lengths
; remain in a lexically nested Parallel body until a legal domain transformation.
(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= domain (IterationSpace flat axes)) (= indices (BindersDomain domain))
       (WalkDomainAxes axes i) (< i (vec-length axes)) (= (vec-get axes i) (DenseAxis index extent))
       (= uses (NamesIndexExp extent)) (!= (set-intersect uses indices) (set-empty)))
      ((InvalidScope context "dense domain extent depends on its own indices")) :ruleset memory-scopes)
(relation CheckAxisAt (ScopeContext DomainAxes Names i64))
(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) body) available))
      ((CheckAxisAt (NestedScope context id 0) axes available 0)) :ruleset memory-scopes)
(rule ((CheckAxisAt context axes available i) (< i (vec-length axes))
       (= axis (vec-get axes i)) (= bound (BindersDomainAxis axis)))
      ((CheckAxisAt context axes (set-union available bound) (+ i 1))) :ruleset memory-scopes)
(rule ((CheckAxisAt context axes available i) (< i (vec-length axes))
       (= (vec-get axes i) (DenseAxis name length)) (= uses (NamesIndexExp length)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((CheckParallel context (ParallelBlock statements results) lanes outer))
      ((CheckSequence context statements lanes)) :ruleset memory-scopes)
(relation ParallelResultAt (ScopeContext ParallelResults Names i64))
(rule ((CheckParallel context (ParallelBlock statements results) lanes outer)
       (= available (ScopeAt context (vec-length statements))))
      ((ParallelResultAt context results available 0)) :ruleset memory-scopes)
(rule ((ParallelResultAt context results available i) (< i (vec-length results)))
      ((ParallelResultAt context results available (+ i 1))) :ruleset memory-scopes)
(rule ((ParallelResultAt context results available i) (< i (vec-length results))
       (= (vec-get results i) (Collect values)) (= uses (NamesResults values)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)
(rule ((ParallelResultAt context results available i) (< i (vec-length results))
       (= (vec-get results i) (Compact condition values))
       (= uses (NamesResults values)) (= predicate (NamesAtom condition)))
      ((RequiredNames context (set-union uses predicate) available)) :ruleset memory-scopes)
(rule ((ParallelResultAt context results available i) (< i (vec-length results))
       (= (vec-get results i) (Fold kind (Reduction commutative neutral combine) values))
       (CheckParallel context (ParallelBlock statements results) lanes outer)
       (= uses (NamesResults values)) (= initial (NamesAtoms neutral)))
      ((RequiredNames context uses available)
       (RequiredNames context initial outer)
       (CheckLambda (ReducerScope context i) combine outer)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (WithAcc inputs body) available))
      ((CheckLambda (NestedScope context id 0) body available)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (BucketScatter destination lambda sources mappings rank) available))
      ((CheckLambda (NestedScope context id 0) lambda available)) :ruleset memory-scopes)
(relation AccInputAt (ScopeContext StatementId AccInputs Names i64))
(rule ((CheckStatement context id pattern (WithAcc inputs body) available))
      ((AccInputAt context id inputs available 0)) :ruleset memory-scopes)
(rule ((AccInputAt context id inputs available i) (< i (vec-length inputs)))
      ((AccInputAt context id inputs available (+ i 1))) :ruleset memory-scopes)
(rule ((AccInputAt context id inputs available i) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (CombineWrites combine))))
      ((CheckLambda (NestedScope context id (+ i 1)) combine available)) :ruleset memory-scopes)

; A name has one defining occurrence, even when sibling bodies are disjoint.
(datatype BindingSite
  (StatementBinding ScopeContext StatementId i64)
  (ParameterBinding ScopeContext i64)
  (MergeBinding ScopeContext StatementId i64)
  (CountedBinding ScopeContext StatementId)
  (AxisBinding ScopeContext StatementId i64)
  (OrdinalBinding ScopeContext StatementId))
(relation BindingOccurrence (Function Name BindingSite))
(relation InvalidFunction (Function String))
(rule ((BindingOccurrence function name first) (BindingOccurrence function name second) (!= first second))
      ((InvalidFunction function "name has multiple binding occurrences")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern expression available) (= root (ScopeRoot context))
       (WalkPattern pattern i) (< i (vec-length pattern))
       (= names (BindersBinding (vec-get pattern i))) (= name (set-get names 0)))
      ((BindingOccurrence root name (StatementBinding context id i))) :ruleset memory-scopes)
(relation ParameterAt (ScopeContext Params Names i64))
(rule ((CheckLambda context (FunctionBody params returns body) outer))
      ((ParameterAt context params outer 0)) :ruleset memory-scopes)
(rule ((ParameterAt context params available i) (< i (vec-length params))
       (= (vec-get params i) (Parameter binding diet))
       (= names (BindersBinding binding)) (= uses (NamesBinding binding))
       (= name (set-get names 0)) (= root (ScopeRoot context)))
      ((RequiredNames context (set-diff uses names) available)
       (BindingOccurrence root name (ParameterBinding context i))
       (ParameterAt context params (set-union available names) (+ i 1))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Loop merges form returns body) available)
       (WalkMerges merges i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter binding diet) initial))
       (= bound (BindersBinding binding)) (= name (set-get bound 0)) (= root (ScopeRoot context)))
      ((BindingOccurrence root name (MergeBinding context id i))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Loop merges (Counted name start count step) returns body) available)
       (= root (ScopeRoot context)))
      ((BindingOccurrence root (ValueNameRef name) (CountedBinding context id))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) body) available)
       (= root (ScopeRoot context)))
      ((BindingOccurrence root (ValueNameRef flat) (OrdinalBinding context id))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) body) available)
       (WalkDomainAxes axes i) (< i (vec-length axes))
       (= names (BindersDomainAxis (vec-get axes i))) (= name (set-get names 0)) (= root (ScopeRoot context)))
      ((BindingOccurrence root name (AxisBinding context id i))) :ruleset memory-scopes)

(rule ((ParallelResultAt context results available i) (< i (vec-length results))
       (= (vec-get results i) (Contribute tokens)) (= uses (NamesAccNames tokens)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(relation CheckExternal (External))
(rule ((CheckExternal external) (= external (DeclareExternal name params returns behavior resources)))
      ((ContainsFunction (FunctionRoot (DefineFunction name params returns (Block (vec-of) (vec-of))))
          (DefineFunction name params returns (Block (vec-of) (vec-of))))) :ruleset memory-names)
(rule ((CheckExternal external) (= external (DeclareExternal name params returns behavior resources)))
      ((set (ScopeRoot (ExternalScope external)) (DefineFunction name params returns (Block (vec-of) (vec-of))))
       (CheckLambda (ExternalScope external) (FunctionBody params returns (Block (vec-of) (vec-of))) (set-empty))) :ruleset memory-scopes)

; Capabilities follow token results through the same lexical control flow as
; values. A merge of different accumulator inputs is an invalid capability.
(function TokenCapability (Function AccName) AccInput :no-merge)
(relation TokenAlias (Function AccName AccName))
(function ClauseOffset (ParallelResults i64) i64 :no-merge)
(relation FoldSlots (FoldKind i64 i64))
(FoldSlots (Total) 0 1)
(FoldSlots (InclusiveScan) 1 0)
(FoldSlots (ExclusiveScan) 1 0)
(FoldSlots (InclusiveScanAndTotal) 1 1)
(FoldSlots (ExclusiveScanAndTotal) 1 1)
(function ClauseArity (ParallelResult) i64 :no-merge)
(relation TokenResults (Function Pattern Body))
(rule ((ContainsExp (FunctionRoot function) (WithAcc inputs (FunctionBody params returns body)))
       (WalkAccInputs inputs i) (< i (vec-length inputs)) (< i (vec-length params))
       (= (vec-get params i) (Parameter (BindAccumulator token info) diet)))
      ((set (TokenCapability function token) (vec-get inputs i))) :ruleset memory-scopes)
(rule ((TokenAlias function output input) (= capability (TokenCapability function input)))
      ((set (TokenCapability function output) capability)) :ruleset memory-scopes)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Accumulate bounds input indices values)))
       (= (vec-get pattern 0) (BindAccumulator output info)))
      ((TokenAlias function output input)) :ruleset memory-scopes)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Reserve input indices value)))
       (= (vec-get pattern 0) (BindAccumulator output info)))
      ((TokenAlias function output input)) :ruleset memory-scopes)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (Use (AccOperand input))))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindAccumulator output info)))
      ((TokenAlias function output input)) :ruleset memory-scopes)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (If condition returns yes no))))
      ((TokenResults function pattern yes) (TokenResults function pattern no)) :ruleset memory-scopes)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Loop merges form returns body))))
      ((TokenResults function pattern body)) :ruleset memory-scopes)
(rule ((ContainsExp (FunctionRoot function) (Loop merges form returns body))
       (WalkMerges merges i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter (BindAccumulator output info) diet) (AccOperand input))))
      ((TokenAlias function output input)) :ruleset memory-scopes)
(rule ((TokenResults function pattern (Block statements results)) (WalkPattern pattern i)
       (< i (vec-length pattern)) (< i (vec-length results))
       (= (vec-get pattern i) (BindAccumulator output info)) (= (vec-get results i) (Yield certs (AccOperand input))))
      ((TokenAlias function output input)) :ruleset memory-scopes)
(rule ((= clause (Collect results))) ((set (ClauseArity clause) (vec-length results))) :ruleset memory-scopes)
(rule ((= clause (Contribute tokens))) ((set (ClauseArity clause) (vec-length tokens))) :ruleset memory-scopes)
(rule ((= clause (Fold kind (Reduction commutative neutral combine) results))
       (FoldSlots kind prefix total))
      ((set (ClauseArity clause) (* (+ prefix total) (vec-length neutral)))) :ruleset memory-scopes)

(rule ((= body (ParallelBlock statements results))) ((set (ClauseOffset results 0) 0)) :ruleset memory-scopes)
(rule ((= offset (ClauseOffset results i)) (< i (vec-length results)) (= arity (ClauseArity (vec-get results i))))
      ((set (ClauseOffset results (+ i 1)) (+ offset arity))) :ruleset memory-scopes)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Parallel execution domain (ParallelBlock statements results))))
       (= offset (ClauseOffset results i)) (< i (vec-length results)) (= (vec-get results i) (Contribute tokens))
       (WalkAccNames tokens j) (< j (vec-length tokens)) (< (+ offset j) (vec-length pattern))
       (= (vec-get pattern (+ offset j)) (BindAccumulator output info)))
      ((TokenAlias function output (vec-get tokens j))) :ruleset memory-scopes)

; Signature checking projects only slot kinds from the authoritative bindings.
; Shape witnesses remain in ReturnInfo; no inferred layout can replace them.
(datatype*
 (sort SlotKinds (Vec SlotKind))
 (SlotKind
  (LogicalSlot LogicalType)
  (ProductSlot SlotKinds) (NestedArraySlot SlotKind i64)
  (ScalarSlot ElementType) (ArraySlot ElementType i64) (MemorySlot)
  (AccumulatorSlot AccInfo) (ResourceSlot ResourceType)))
(function LogicalSlotKind (LogicalType) SlotKind :no-merge)
(function CollectedSlot (SlotKind i64) SlotKind :no-merge)
(relation CollectSlotDemand (SlotKind i64))
(function ProductSlotPrefix (LogicalTypes i64) SlotKinds :no-merge)
(rule ((= ty (ElementValue element))) ((set (LogicalSlotKind ty) (ScalarSlot element))) :ruleset memory-scopes)
(rule ((= ty (ResourceValue resource))) ((set (LogicalSlotKind ty) (ResourceSlot resource))) :ruleset memory-scopes)
(rule ((= ty (ArrayType ownership extents element)) (= item (LogicalSlotKind element)))
      ((CollectSlotDemand item (vec-length extents))) :ruleset memory-scopes)
(rule ((= ty (ArrayType ownership extents element)) (= item (LogicalSlotKind element))
       (= collected (CollectedSlot item (vec-length extents))))
      ((set (LogicalSlotKind ty) collected)) :ruleset memory-scopes)
(rule ((= ty (ProductType fields))) ((set (ProductSlotPrefix fields 0) (vec-of))) :ruleset memory-scopes)
(rule ((= prefix (ProductSlotPrefix fields i)) (< i (vec-length fields)) (= field (LogicalSlotKind (vec-get fields i))))
      ((set (ProductSlotPrefix fields (+ i 1)) (vec-push prefix field))) :ruleset memory-scopes)
(rule ((= ty (ProductType fields)) (= fields2 (ProductSlotPrefix fields (vec-length fields))))
      ((set (LogicalSlotKind ty) (ProductSlot fields2))) :ruleset memory-scopes)
(function ValueSlot (ValueInfo) SlotKind :no-merge)
(function BindingSlot (Binding) SlotKind :no-merge)
(function ReturnKind (ReturnInfo) SlotKind :no-merge)
(function OperandSlot (Function Operand) SlotKind :no-merge)
(rule ((= info (LogicalValue ty)) (= kind (LogicalSlotKind ty))) ((set (ValueSlot info) kind)) :ruleset memory-scopes)
(rule ((= info (LogicalReturn ty)) (= kind (LogicalSlotKind ty))) ((set (ReturnKind info) kind)) :ruleset memory-scopes)
(relation CheckSignature (ScopeContext ReturnInfos Results))
(relation CheckPatternSignature (ScopeContext Pattern ReturnInfos))
(relation CheckSlot (ScopeContext SlotKind Operand))
(rule ((ParallelResultAt context results available i) (< i (vec-length results))
       (= (vec-get results i) (Compact condition values)))
      ((CheckSlot context (ScalarSlot (ScalarElement (Bool))) (ValueOperand condition))) :ruleset memory-scopes)
(relation ExecutableScope (ScopeContext))
(rule ((CheckFunction function)) ((ExecutableScope (FunctionScope function))) :ruleset memory-scopes)
(rule ((= context (NestedScope parent id i)) (ExecutableScope parent)) ((ExecutableScope context)) :ruleset memory-scopes)
(rule ((= context (ReducerScope parent i)) (ExecutableScope parent)) ((ExecutableScope context)) :ruleset memory-scopes)
(rule ((= info (ScalarInfo element))) ((set (ValueSlot info) (ScalarSlot element))) :ruleset memory-scopes)




(rule ((= info (ResourceInfo resource))) ((set (ValueSlot info) (ResourceSlot resource))) :ruleset memory-scopes)
(rule ((= binding (BindValue name info)) (= kind (ValueSlot info))) ((set (BindingSlot binding) kind)) :ruleset memory-scopes)

(rule ((= binding (BindAccumulator name info))) ((set (BindingSlot binding) (AccumulatorSlot info))) :ruleset memory-scopes)
(rule ((= info (ReturnScalar element))) ((set (ReturnKind info) (ScalarSlot element))) :ruleset memory-scopes)



(rule ((= info (ReturnAccumulator accumulator))) ((set (ReturnKind info) (AccumulatorSlot accumulator))) :ruleset memory-scopes)
(rule ((= info (ReturnResource resource))) ((set (ReturnKind info) (ResourceSlot resource))) :ruleset memory-scopes)
(rule ((ContainsBinding (FunctionRoot function) binding) (= binding (BindValue name info)) (= kind (BindingSlot binding)))
      ((set (OperandSlot function (ValueOperand (Var name))) kind)) :ruleset memory-scopes)

(rule ((ContainsBinding (FunctionRoot function) (BindAccumulator name info)))
      ((set (OperandSlot function (AccOperand name)) (AccumulatorSlot info))) :ruleset memory-scopes)
(rule ((ContainsOperand (FunctionRoot function) operand) (= operand (IndexOperand index)))
      ((set (OperandSlot function operand) (ScalarSlot (ScalarElement (I32))))) :ruleset memory-scopes)
(rule ((ContainsAtom (FunctionRoot function) atom) (= atom (LiteralBits primitive bits)))
      ((set (OperandSlot function (ValueOperand atom)) (ScalarSlot (ScalarElement primitive)))) :ruleset memory-scopes)
(rule ((BindingOccurrence function (ValueNameRef name) (CountedBinding context id)))
      ((set (OperandSlot function (ValueOperand (Var name))) (ScalarSlot (ScalarElement (I32))))) :ruleset memory-scopes)
(rule ((BindingOccurrence function (ValueNameRef name) (AxisBinding context id axis)))
      ((set (OperandSlot function (ValueOperand (Var name))) (ScalarSlot (ScalarElement (I32))))) :ruleset memory-scopes)
(rule ((BindingOccurrence function (ValueNameRef name) (OrdinalBinding context id)))
      ((set (OperandSlot function (ValueOperand (Var name))) (ScalarSlot (ScalarElement (I32))))) :ruleset memory-scopes)
(rule ((CheckSlot context expected operand) (= function (ScopeRoot context)) (= actual (OperandSlot function operand)) (!= actual expected))
      ((InvalidScope context "operand type differs from its signature")) :ruleset memory-scopes)
(rule ((CheckLambda context (FunctionBody params returns (Block statements results)) outer) (ExecutableScope context))
      ((CheckSignature context returns results)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (If condition returns (Block a yes) (Block b no)) available))
      ((CheckSignature (NestedScope context id 0) returns yes) (CheckSignature (NestedScope context id 1) returns no)
       (CheckPatternSignature context pattern returns)
       (CheckSlot context (ScalarSlot (ScalarElement (Bool))) (ValueOperand condition))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Loop merges form returns (Block statements results)) available))
      ((CheckSignature (NestedScope context id 0) returns results) (CheckPatternSignature context pattern returns)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Call name arguments returns) available))
      ((CheckPatternSignature context pattern returns)) :ruleset memory-scopes)
(rule ((CheckSignature context returns results) (!= (vec-length returns) (vec-length results)))
      ((InvalidScope context "body result count differs from its signature")) :ruleset memory-scopes)
(rule ((CheckPatternSignature context pattern returns) (!= (vec-length pattern) (vec-length returns)))
      ((InvalidScope context "statement result count differs from its signature")) :ruleset memory-scopes)
(rule ((CheckSignature context returns results) (WalkReturnInfos returns i) (< i (vec-length returns)) (< i (vec-length results))
       (= expected (ReturnKind (vec-get returns i))) (= (vec-get results i) (Yield certs operand)))
      ((CheckSlot context expected operand)) :ruleset memory-scopes)
(rule ((CheckPatternSignature context pattern returns) (WalkReturnInfos returns i) (< i (vec-length returns)) (< i (vec-length pattern))
       (= expected (ReturnKind (vec-get returns i))) (= actual (BindingSlot (vec-get pattern i))) (!= actual expected))
      ((InvalidScope context "result binding type differs from its signature")) :ruleset memory-scopes)
(rule ((CheckMergeAt context merges available i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter binding diet) operand)) (= kind (BindingSlot binding)))
      ((CheckSlot context kind operand)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Loop merges (While condition) returns body) available))
      ((CheckSlot context (ScalarSlot (ScalarElement (Bool))) (ValueOperand (Var condition)))) :ruleset memory-scopes)

; Existential references are indices in the entire result list, and must point
; to a size or memory slot of the required kind, never an array or capability.
(relation CheckReturnIndex (ScopeContext ReturnInfos i64 SlotKind))
(rule ((ContainsReturnInfos root returns))
      ((ContainsReturnInfos (ReturnRoot returns) returns)) :ruleset memory-names)


(rule ((CheckReturnIndex context returns i expected) (< i 0))
      ((InvalidScope context "negative result witness index")) :ruleset memory-scopes)
(rule ((CheckReturnIndex context returns i expected) (>= i (vec-length returns)))
      ((InvalidScope context "result witness index exceeds signature")) :ruleset memory-scopes)
(rule ((CheckReturnIndex context returns i expected) (>= i 0) (< i (vec-length returns))
       (= actual (ReturnKind (vec-get returns i))) (!= actual expected))
      ((InvalidScope context "result witness refers to the wrong slot kind")) :ruleset memory-scopes)

(relation CallableSignature (Program FunctionName Params ReturnInfos))
(rule ((ProgramFunction program (DefineFunction name params returns body)))
      ((CallableSignature program name params returns)) :ruleset memory-scopes)
(rule ((ProgramExternal program (DeclareExternal name params returns behavior accesses)))
      ((CallableSignature program name params returns)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context)) (ProgramFunction program function)
       (CallableSignature program name params declared) (!= (vec-length params) (vec-length arguments)))
      ((InvalidScope context "call argument count differs from callee signature")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context)) (ProgramFunction program function)
       (CallableSignature program name params declared) (!= (vec-length returns) (vec-length declared)))
      ((InvalidScope context "call result count differs from callee signature")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context)) (ProgramFunction program function)
       (CallableSignature program name params declared) (WalkArguments arguments i)
       (< i (vec-length arguments)) (< i (vec-length params))
       (= (vec-get arguments i) (Pass operand diet)) (= (vec-get params i) (Parameter binding callee-diet))
       (= expected (BindingSlot binding)))
      ((CheckSlot context expected operand)) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context)) (ProgramFunction program function)
       (CallableSignature program name params declared) (WalkReturnInfos returns i)
       (< i (vec-length returns)) (< i (vec-length declared))
       (= expected (ReturnKind (vec-get declared i))) (= actual (ReturnKind (vec-get returns i))) (!= actual expected))
      ((InvalidScope context "call result type differs from callee signature")) :ruleset memory-scopes)

(function DomainIndexPrefix (DomainAxes i64) Indices :no-merge)
(function DomainIndices (Domain) Indices :no-merge)
(function OuterDomain (Domain) Domain :no-merge)
(rule ((= domain (IterationSpace flat axes)))
      ((set (DomainIndexPrefix axes 0) (vec-of))) :ruleset memory-scopes)
(rule ((= prefix (DomainIndexPrefix axes i)) (< i (vec-length axes)) (= (vec-get axes i) (DenseAxis name length)))
      ((set (DomainIndexPrefix axes (+ i 1)) (vec-push prefix (IndexValue name)))) :ruleset memory-scopes)
(rule ((= domain (IterationSpace flat axes)) (= indices (DomainIndexPrefix axes (vec-length axes))))
      ((set (DomainIndices domain) indices)) :ruleset memory-scopes)
; Collection preserves nested logical values. TLC represents zipped products
; as products of arrays, so collection distributes over their fields.

(rule ((= domain (IterationSpace flat axes)) (> (vec-length axes) 0))
      ((set (OuterDomain domain) (IterationSpace flat (vec-remove axes (- (vec-length axes) 1))))) :ruleset memory-scopes)
(rule ((CollectSlotDemand kind 0)) ((set (CollectedSlot kind 0) kind)) :ruleset memory-scopes)
(rule ((CollectSlotDemand kind dimensions) (> dimensions 0))
      ((CollectSlotDemand kind (- dimensions 1))) :ruleset memory-scopes)
(relation NonProductSlot (SlotKind))
(rule ((= kind (ScalarSlot element))) ((NonProductSlot kind)) :ruleset memory-scopes)
(rule ((= kind (ResourceSlot resource))) ((NonProductSlot kind)) :ruleset memory-scopes)
(rule ((= kind (NestedArraySlot element rank))) ((NonProductSlot kind)) :ruleset memory-scopes)
(rule ((CollectSlotDemand kind dimensions) (NonProductSlot kind) (> dimensions 0) (= inner (CollectedSlot kind (- dimensions 1))))
      ((set (CollectedSlot kind dimensions) (NestedArraySlot inner 1))) :ruleset memory-scopes)
(function CollectedProductPrefix (SlotKinds i64 i64) SlotKinds :no-merge)
(rule ((CollectSlotDemand (ProductSlot fields) dimensions) (> dimensions 0))
      ((set (CollectedProductPrefix fields dimensions 0) (vec-of))) :ruleset memory-scopes)
(rule ((= prefix (CollectedProductPrefix fields dimensions i)) (< i (vec-length fields)))
      ((CollectSlotDemand (vec-get fields i) dimensions)) :ruleset memory-scopes)
(rule ((= prefix (CollectedProductPrefix fields dimensions i)) (< i (vec-length fields))
       (= field (CollectedSlot (vec-get fields i) dimensions)))
      ((set (CollectedProductPrefix fields dimensions (+ i 1)) (vec-push prefix field))) :ruleset memory-scopes)
(rule ((CollectSlotDemand kind dimensions) (= kind (ProductSlot fields)) (> dimensions 0)
       (= collected (CollectedProductPrefix fields dimensions (vec-length fields))))
      ((set (CollectedSlot kind dimensions) (ProductSlot collected))) :ruleset memory-scopes)






(relation CheckCollected (ScopeContext Pattern i64 Results i64))
(relation CheckClauseBindings (ScopeContext Pattern i64 ParallelResult i64))
(rule ((CheckStatement context id pattern (Parallel execution domain (ParallelBlock statements clauses)) available)
       (= count (ClauseOffset clauses (vec-length clauses))) (!= count (vec-length pattern)))
      ((InvalidScope context "parallel result count differs from its pattern")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= offset (ClauseOffset clauses i)) (= indices (DomainIndices (IterationSpace flat axes))))
      ((CheckClauseBindings context pattern offset (vec-get clauses i) (vec-length indices))) :ruleset memory-scopes)
(rule ((CheckClauseBindings context pattern offset (Collect results) dimensions))
      ((CheckCollected context pattern offset results dimensions)) :ruleset memory-scopes)
(rule ((CheckClauseBindings context pattern offset (Compact condition results) dimensions))
      ((CheckCollected context pattern offset results dimensions)) :ruleset memory-scopes)

(rule ((CheckCollected context pattern offset results dimensions) (WalkResults results i) (< i (vec-length results))
       (= (vec-get results i) (Yield certs operand)) (= function (ScopeRoot context)) (= item (OperandSlot function operand)))
      ((CollectSlotDemand item dimensions)) :ruleset memory-scopes)
(rule ((CheckCollected context pattern offset results dimensions) (WalkResults results i) (< i (vec-length results))
       (= (vec-get results i) (Yield certs operand)) (= function (ScopeRoot context))
       (= item (OperandSlot function operand)) (= expected (CollectedSlot item dimensions))
       (< (+ offset i) (vec-length pattern)) (= actual (BindingSlot (vec-get pattern (+ offset i)))) (!= expected actual))
      ((InvalidScope context "collected result type or rank differs from its binding")) :ruleset memory-scopes)
(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (!= (vec-length params) (* 2 (vec-length neutral))))
      ((InvalidScope context "reducer must take two accumulator tuples")) :ruleset memory-scopes)
(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (!= (vec-length returns) (vec-length neutral)))
      ((InvalidScope context "reducer changes its accumulator arity")) :ruleset memory-scopes)
(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (WalkAtoms neutral j) (< j (vec-length neutral)) (< j (vec-length returns))
       (= expected (ReturnKind (vec-get returns j))))
      ((CheckSignature context returns values)
       (CheckSlot context expected (ValueOperand (vec-get neutral j)))) :ruleset memory-scopes)
(relation CheckFoldBindings (ScopeContext Pattern i64 ReturnInfos i64))
(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (FoldSlots kind 1 total) (= offset (ClauseOffset clauses i))
       (= indices (DomainIndices (IterationSpace flat axes))))
      ((CheckFoldBindings context pattern offset returns (vec-length indices))) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i) (< i (vec-length clauses)) (> (vec-length axes) 0)
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (FoldSlots kind prefix 1) (= offset (ClauseOffset clauses i))
       (= outer (OuterDomain (IterationSpace flat axes))) (= indices (DomainIndices outer)))
      ((CheckFoldBindings context pattern (+ offset (* prefix (vec-length neutral))) returns (vec-length indices))) :ruleset memory-scopes)
(rule ((CheckFoldBindings context pattern offset returns dimensions)
       (WalkReturnInfos returns i) (< i (vec-length returns)) (= item (ReturnKind (vec-get returns i))))
      ((CollectSlotDemand item dimensions)) :ruleset memory-scopes)
(rule ((CheckFoldBindings context pattern offset returns dimensions)
       (WalkReturnInfos returns i) (< i (vec-length returns)) (< (+ offset i) (vec-length pattern))
       (= element (ReturnKind (vec-get returns i))) (= expected (CollectedSlot element dimensions))
       (= actual (BindingSlot (vec-get pattern (+ offset i)))) (!= actual expected))
      ((InvalidScope context "fold result type or rank differs from its binding")) :ruleset memory-scopes)
(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (WalkParams params j) (< j (vec-length params)) (> (vec-length neutral) 0)
       (= slot (% j (vec-length neutral))) (< slot (vec-length returns))
       (= (vec-get params j) (Parameter binding diet)) (= actual (BindingSlot binding))
       (= expected (ReturnKind (vec-get returns slot))) (!= actual expected))
      ((InvalidScope context "reducer parameter type differs from its accumulator")) :ruleset memory-scopes)

(rule ((CheckBody context (Block statements results) available)
       (WalkResults results i) (WalkResults results j) (< i j) (< j (vec-length results))
       (= (vec-get results i) (Yield a (AccOperand token))) (= (vec-get results j) (Yield b (AccOperand token))))
      ((InvalidScope context "body returns the same accumulator capability twice")) :ruleset memory-scopes)
(rule ((CheckMergeAt context merges available i) (CheckMergeAt context merges available j)
       (< i j) (< j (vec-length merges))
       (= (vec-get merges i) (Carry a (AccOperand token))) (= (vec-get merges j) (Carry b (AccOperand token))))
      ((InvalidScope context "loop duplicates an incoming accumulator capability")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (WithAcc inputs (FunctionBody params returns (Block statements results))) available)
       (= function (ScopeRoot context)) (WalkAccInputs inputs i) (< i (vec-length inputs)) (< i (vec-length results))
       (= (vec-get results i) (Yield certs (AccOperand token)))
       (= actual (TokenCapability function token)) (= expected (vec-get inputs i)) (!= actual expected))
      ((InvalidScope context "accumulator scope returns a different capability")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (WithAcc inputs (FunctionBody params returns body)) available)
       (< (vec-length params) (vec-length inputs)))
      ((InvalidScope context "accumulator scope has fewer parameters than inputs")) :ruleset memory-scopes)
(rule ((CheckStatement context id pattern (WithAcc inputs (FunctionBody params returns (Block statements results))) available)
       (< (vec-length results) (vec-length inputs)))
      ((InvalidScope context "accumulator scope loses a capability")) :ruleset memory-scopes)


(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat (vec-of)) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i) (< i (vec-length clauses)) (= (vec-get clauses i) (Fold kind reducer values)))
      ((InvalidScope context "fold requires an iteration axis")) :ruleset memory-scopes)


















(rule ((= (TokenCapability function token) (AccumulatorInput arrays policy)))
      ((set (TokenWrites function token) (set-empty))) :ruleset memory-effects)
(rule ((= (TokenCapability function token) (AccumulatorInput arrays policy))
       (WalkValueNames arrays i) (< i (vec-length arrays)) (= writes (ArrayWrites function (vec-get arrays i))))
      ((set (TokenWrites function token) writes)) :ruleset memory-effects)

(function PointSlices (Indices i64) Slices :no-merge)
(rule ((= prefix (PointSlices indices i)) (< i (vec-length indices)))
      ((set (PointSlices indices (+ i 1)) (vec-push prefix (At (vec-get indices i))))) :ruleset memory-names)
(rule ((= indices (DomainIndices domain)))
      ((set (PointSlices indices 0) (vec-of))) :ruleset memory-names)



; Domain and counted-loop indices are scalar binders without a Pattern node.
(rule ((= (OperandSlot function (ValueOperand (Var name))) (ScalarSlot element)))
      ((set (BindingInfo function name) (ScalarInfo element))) :ruleset memory-origin)
