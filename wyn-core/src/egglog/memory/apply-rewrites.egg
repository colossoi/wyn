; Each optimizer applies only its own completed candidate set.
(ruleset REWRITE_RULESET)
(rule ((CurrentProgram program) (RewriteDemand REWRITE_PASS program)
       (= edits (PendingRewrite REWRITE_PASS program)) (> (set-size edits) 0))
      ((RenameProgramDemand (set-at edits 0) program)) :ruleset REWRITE_RULESET)
(rule ((CurrentProgram program) (RewriteDemand REWRITE_PASS program)
       (= edits (PendingRewrite REWRITE_PASS program)) (> (set-size edits) 0)
       (= next (RenameProgram (set-at edits 0) program)) (!= next program))
      ((delete (RewriteDemand REWRITE_PASS program))
       (delete (CurrentProgram program)) (CurrentProgram next)) :ruleset REWRITE_RULESET)
