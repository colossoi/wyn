(relation CallReach (FunctionName FunctionName))
(function RecursiveFunction (FunctionName) bool :merge (or old new))
; Array and parallel helpers inline through the common region renamer. Scalar
; helpers keep their function ABI. Recursive cycles are never expanded.
(ruleset inline-discover)
(ruleset inline-prepare)
(ruleset inline-select)
(relation InlineFunction (Function))
(relation InlineScalarFunctions ())
(relation InlineCall (Program Function Stm Function))
(function FunctionStatementIds (Function) StatementIds :merge (set-union old new))
(function InlineNames (StatementId Names) Renaming :no-merge)
(relation InlineNamesDemand (StatementId Names))
(function InlineIds (StatementId StatementIds) StatementIdRenaming :no-merge)
(relation InlineIdsDemand (StatementId StatementIds))
(function StatementIdsHead (StatementIds) StatementId :no-merge)
(function StatementIdsTail (StatementIds) StatementIds :no-merge)
(function CallRenaming (StatementId Function) Renaming :no-merge)
(function InlineParameters (StatementId Params Arguments i64) Stms :no-merge)
(function InlineResults (StatementId Pattern Certificates Results i64) Stms :no-merge)

(rule ((ProgramFunction program function) (= function (DefineFunction name params returns body)))
      ((set (FunctionStatementIds function) (set-empty))) :ruleset inline-discover)

(rule ((ContainsValueInfo (FunctionRoot function) (LogicalValue ty))) ((InlineFunction function)) :ruleset inline-discover)
(rule ((InlineScalarFunctions) (ProgramFunction program function))
      ((InlineFunction function)) :ruleset inline-discover)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body))) ((InlineFunction function)) :ruleset inline-discover)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs expression)))
      ((set (FunctionStatementIds function) (set-of id))) :ruleset inline-discover)
(rule ((CurrentProgram program) (ProgramFunction program caller)
       (ContainsStm (FunctionRoot caller) call) (= call (Let id pattern certs (Call name arguments signature)))
       (ProgramFunction program target) (= target (DefineFunction name params returns body))
       (InlineFunction target) (= (RecursiveFunction name) false)
       (= (vec-size arguments) (vec-size params))
       (= names (BindersFunction target)) (= ids (FunctionStatementIds target)))
      ((InlineCall program caller call target)
       (InlineNamesDemand id names) (InlineIdsDemand id ids)) :ruleset inline-prepare)

(rule ((InlineNamesDemand id names) (= names (set-empty)))
      ((set (InlineNames id names) (Rename (map-empty) (map-empty) (map-empty) (map-empty) (map-empty)))) :ruleset inline-prepare)
(rule ((InlineNamesDemand id names) (> (set-size names) 0))
      ((set (NamesHead names) (set-at names 0))
       (set (NamesTail names) (set-remove names (set-at names 0)))
       (InlineNamesDemand id (set-remove names (set-at names 0)))) :ruleset inline-prepare)
(rule ((InlineNamesDemand id names) (= item (NamesHead names)) (= tail (NamesTail names))
       (= (InlineNames id tail) (Rename values blocks tokens statements edits))
       (= item (ValueNameRef name)))
      ((set (InlineNames id names) (Rename (map-insert values name (CallValue id name)) blocks tokens statements edits))) :ruleset inline-prepare)
(rule ((InlineNamesDemand id names) (= item (NamesHead names)) (= tail (NamesTail names))
       (= (InlineNames id tail) (Rename values blocks tokens statements edits))
       (= item (BlockNameRef name)))
      ((set (InlineNames id names) (Rename values (map-insert blocks name (CallMemory id name)) tokens statements edits))) :ruleset inline-prepare)
(rule ((InlineNamesDemand id names) (= item (NamesHead names)) (= tail (NamesTail names))
       (= (InlineNames id tail) (Rename values blocks tokens statements edits))
       (= item (AccNameRef name)))
      ((set (InlineNames id names) (Rename values blocks (map-insert tokens name (CallAccumulator id name)) statements edits))) :ruleset inline-prepare)
(rule ((InlineIdsDemand id names) (= names (set-empty))) ((set (InlineIds id names) (map-empty))) :ruleset inline-prepare)
(rule ((InlineIdsDemand id names) (> (set-size names) 0))
      ((set (StatementIdsHead names) (set-at names 0))
       (set (StatementIdsTail names) (set-remove names (set-at names 0)))
       (InlineIdsDemand id (set-remove names (set-at names 0)))) :ruleset inline-prepare)
(rule ((InlineIdsDemand id names) (= name (StatementIdsHead names)) (= tail (StatementIdsTail names))
       (= rest (InlineIds id tail)))
      ((set (InlineIds id names) (map-insert rest name (CallStatement id name)))) :ruleset inline-prepare)
(rule ((InlineCall program caller (Let id pattern certs expression) target)
       (= (InlineNames id (BindersFunction target)) (Rename values blocks tokens unused edits))
       (= statements (InlineIds id (FunctionStatementIds target))))
      ((set (CallRenaming id target) (Rename values blocks tokens statements edits))
       (RenameFunctionDemand (Rename values blocks tokens statements edits) target)) :ruleset inline-prepare)

(rule ((InlineCall program caller (Let id pattern certs (Call name arguments signature)) target)
       (= renamed (RenameFunction (CallRenaming id target) target))
       (= renamed (DefineFunction name params returns (Block statements results))))
      ((set (InlineParameters id params arguments 0) (vec-of))
       (set (InlineResults id pattern certs results 0) (vec-of))) :ruleset inline-select)
(rule ((= prefix (InlineParameters id params arguments i)) (< i (vec-size arguments)))
      ((set (ArgumentsAt arguments i) (vec-at arguments i))) :ruleset inline-select)
(rule ((= prefix (InlineParameters id params arguments i))
       (< i (vec-size params))
       (= (ParamsAt params i) (Parameter binding diet))
       (= (ArgumentsAt arguments i) (Pass operand argument-diet)))
      ((set (InlineParameters id params arguments (+ i 1)) (vec-push prefix (Let (CallParameter id i) (vec-of binding) (vec-of) (Use operand))))) :ruleset inline-select)
(rule ((= prefix (InlineResults id pattern certs results i))
       (< i (vec-size pattern))
       (< i (vec-size results))
       (= (ResultsAt results i) (Yield proofs operand)))
      ((set (InlineResults id pattern certs results (+ i 1)) (vec-push prefix (Let (CallResult id i) (vec-of (vec-at pattern i)) (vec-append certs proofs) (Use operand))))) :ruleset inline-select)
(rule ((InlineCall program caller (Let id pattern certs (Call name arguments signature)) target)
       (= renamed (RenameFunction (CallRenaming id target) target))
       (= renamed (DefineFunction name params returns (Block statements results)))
       (= (vec-size pattern) (vec-size results))
       (= parameters (InlineParameters id params arguments (vec-size params)))
       (= outputs (InlineResults id pattern certs results (vec-size pattern))))
      ((set (PendingRewrite "inline" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append parameters (vec-append statements outputs))))))
       (RewriteDemand "inline" program)) :ruleset inline-select)

; Cloning is shared by inlining and scheduling; captures stay free while every
; local binder, annotation, and statement occurrence is renamed together.
(ruleset clone-index)
(ruleset clone-prepare)
(relation CloneLambdaDemand (StatementId Lambda))
(function LambdaStatementIds (Lambda) StatementIds :merge (set-union old new))
(function CloneLambda (StatementId Lambda) Lambda :no-merge)
(rule ((CloneLambdaDemand id lambda))
      ((ContainsLambda (LambdaRoot lambda) lambda) (set (LambdaStatementIds lambda) (set-empty))) :ruleset clone-index)
(rule ((ContainsStm (LambdaRoot lambda) (Let id pattern certs expression)))
      ((set (LambdaStatementIds lambda) (set-of id))) :ruleset clone-index)
(rule ((CloneLambdaDemand id lambda) (= names (BindersLambda lambda)) (= statements (LambdaStatementIds lambda)))
      ((InlineNamesDemand id names) (InlineIdsDemand id statements)) :ruleset clone-prepare)
(rule ((CloneLambdaDemand id lambda) (= names (BindersLambda lambda)) (= statements (LambdaStatementIds lambda))
       (= (InlineNames id names) (Rename values blocks tokens unused edits)) (= ids (InlineIds id statements)))
      ((RenameLambdaDemand (Rename values blocks tokens ids edits) lambda)) :ruleset clone-prepare)
(rule ((CloneLambdaDemand id lambda) (= names (BindersLambda lambda)) (= statements (LambdaStatementIds lambda))
       (= (InlineNames id names) (Rename values blocks tokens unused edits)) (= ids (InlineIds id statements))
       (= next (RenameLambda (Rename values blocks tokens ids edits) lambda)))
      ((set (CloneLambda id lambda) next)) :ruleset clone-prepare)

; Applying a region constructs ordinary parameter, body, and result statements.
; This is a rewrite API, not another expression form or executable body store.
(relation ApplyLambdaDemand (StatementId Pattern Certificates Lambda Arguments))
(function ApplyLambda (StatementId Pattern Certificates Lambda Arguments) Stms :no-merge)
(rule ((ApplyLambdaDemand id pattern certs lambda arguments))
      ((CloneLambdaDemand id lambda)) :ruleset clone-index)
(rule ((ApplyLambdaDemand id pattern certs lambda arguments) (= next (CloneLambda id lambda))
       (= next (FunctionBody params returns (Block statements results)))
       (= (vec-size params) (vec-size arguments)) (= (vec-size pattern) (vec-size results)))
      ((set (InlineParameters id params arguments 0) (vec-of))
       (set (InlineResults id pattern certs results 0) (vec-of))) :ruleset clone-prepare)
(rule ((ApplyLambdaDemand id pattern certs lambda arguments) (= next (CloneLambda id lambda))
       (= next (FunctionBody params returns (Block statements results)))
       (= prefix (InlineParameters id params arguments (vec-size params)))
       (= suffix (InlineResults id pattern certs results (vec-size results))))
      ((set (ApplyLambda id pattern certs lambda arguments) (vec-append prefix (vec-append statements suffix)))) :ruleset clone-prepare)

; Calls inherit the same body effect analysis. Nonempty effects remain ordered
; at the call boundary because parameter aliases have not been substituted.
(rule ((ProgramFunction program (DefineFunction name params returns body)))
      ((set (RecursiveFunction name) false)) :ruleset memory-origin)
(rule ((ContainsExp (FunctionRoot (DefineFunction caller params returns body)) (Call callee arguments signature)))
      ((CallReach caller callee)) :ruleset memory-origin)
(rule ((CallReach first next) (CallReach next last)) ((CallReach first last)) :ruleset memory-origin)
(rule ((CallReach name name)) ((set (RecursiveFunction name) true)) :ruleset memory-origin)

(rule ((EffectsExpDemand function (Call name arguments signature))
       (= (RecursiveFunction name) true))
      ((set (CallEffects function name) (set-of (OrderedEffect)))) :ruleset memory-effects)
(rule ((EffectsExpDemand function (Call name arguments signature))
       (ProgramFunction program function) (ProgramExternal program (DeclareExternal name params returns behavior accesses)))
      ((set (CallEffects function name) (set-of (OrderedEffect)))) :ruleset memory-effects)
(rule ((EffectsExpDemand function (Call name arguments signature))
       (ProgramFunction program function) (ProgramFunction program target)
       (= target (DefineFunction name params returns body)) (= (RecursiveFunction name) false)
       (= (EffectsFunction target target) (set-empty)))
      ((set (CallEffects function name) (set-empty))) :ruleset memory-effects)
(rule ((EffectsExpDemand function (Call name arguments signature))
       (ProgramFunction program function) (ProgramFunction program target)
       (= target (DefineFunction name params returns body)) (= (RecursiveFunction name) false)
       (= effects (EffectsFunction target target)) (!= effects (set-empty)))
      ((set (CallEffects function name) (set-of (OrderedEffect)))) :ruleset memory-effects)

; Binary reducers share their input and output structure. Clone the first
; parameter tuple, including dependent shape witnesses, for application results.
(relation ReducerOutputsDemand (StatementId Lambda))
(relation ReducerOutputPrefix (StatementId Lambda i64 Pattern))
(function ReducerOutputs (StatementId Lambda) Pattern :no-merge)
(rule ((ReducerOutputPrefix id lambda i pattern)) ((WalkPattern pattern 0)) :ruleset clone-index)
(rule ((ReducerOutputsDemand id lambda) (= lambda (FunctionBody params returns body))
       (= (vec-size params) (* 2 (vec-size returns))))
      ((ReducerOutputPrefix id lambda 0 (vec-of))) :ruleset clone-index)
(rule ((ReducerOutputPrefix id lambda i pattern)
       (= lambda (FunctionBody params returns body))
       (< i (vec-size returns))
       (= (ParamsAt params i) (Parameter binding diet)))
      ((ReducerOutputPrefix id lambda (+ i 1) (vec-push pattern binding))) :ruleset clone-index)
(rule ((ReducerOutputPrefix id lambda i pattern) (= lambda (FunctionBody params returns body))
       (= i (vec-size returns)) (= bound (BindersPattern pattern)))
      ((InlineNamesDemand id bound)) :ruleset clone-prepare)
(rule ((ReducerOutputPrefix id lambda i pattern) (= lambda (FunctionBody params returns body))
       (= i (vec-size returns)) (= bound (BindersPattern pattern)) (= env (InlineNames id bound)))
      ((RenamePatternDemand env pattern)) :ruleset clone-prepare)
(rule ((ReducerOutputPrefix id lambda i pattern) (= lambda (FunctionBody params returns body))
       (= i (vec-size returns)) (= bound (BindersPattern pattern)) (= env (InlineNames id bound))
       (= output (RenamePattern env pattern)))
      ((set (ReducerOutputs id lambda) output)) :ruleset clone-prepare)
