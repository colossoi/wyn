; Compiler invariant auditing. Loaded only in debug builds.
; Scope and type facts used by optimization remain in regions.egg.

(rule ((CheckLambda context (FunctionBody params returns body) outer)
       (= bound (BindersParams params)) (= uses (NamesParams params)) (= result-uses (NamesReturnInfos returns)))
      ((RequiredNames context uses (set-union outer bound))
       (RequiredNames context result-uses (set-union outer bound))) :ruleset memory-scopes)

(rule ((CheckLambda context (FunctionBody params returns body) outer)
       (!= (set-size (BindersParams params)) (vec-size params)))
      ((InvalidScope context "duplicate parameter")) :ruleset memory-scopes)

(rule ((CheckSequence context statements initial)
       (= available (ScopeAt context i))
       (< i (vec-size statements))
       (= (StmsAt statements i) (Let id pattern certificates expression))
       (= proofs (NamesCertificates certificates))
       (= bound (BindersPattern pattern))
       (= consumed (ConsumedTokens expression)))
      ((RequiredNames context proofs available)) :ruleset memory-scopes)

(rule ((StatementOccurrence id first i) (StatementOccurrence id second j) (!= first second)
       (= root (ScopeRoot first)) (= root (ScopeRoot second)))
      ((InvalidScope second "statement appears in multiple scopes")) :ruleset memory-scopes)

(rule ((StatementOccurrence id context i) (StatementOccurrence id context j) (!= i j))
      ((InvalidScope context "statement appears more than once")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern expression available)
       (= uses (NamesExp expression)) (= internal (BindersExp expression))
       (= annotations (NamesPattern pattern)) (= bound (BindersPattern pattern)))
      ((RequiredNames context (set-diff uses internal) available)
       (RequiredNames context annotations (set-union available bound))) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern expression available)
       (!= (set-size (BindersPattern pattern)) (vec-size pattern)))
      ((InvalidScope context "duplicate result binding")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern expression available)
       (!= (set-intersect available (BindersPattern pattern)) (set-empty)))
      ((InvalidScope context "result name already in scope")) :ruleset memory-scopes)

(rule ((RequiredNames context used available) (!= (set-diff used available) (set-empty)))
      ((InvalidScope context "operand or annotation outside its scope, or accumulator already consumed")) :ruleset memory-scopes)

(rule ((CheckBody context (Block statements results) initial)
       (= available (ScopeAt context (vec-size statements))) (= uses (NamesResults results)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (If condition returns yes no) available) (= uses (NamesReturnInfos returns)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Loop merges form returns body) available)
       (= carried (BindersMerges merges)) (= index (BindersLoopForm form)) (= uses (NamesReturnInfos returns))
       (= consumed (ConsumedTokens (Loop merges form returns body))))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Loop merges form returns body) available))
      ((CheckMergeAt context merges available 0)) :ruleset memory-scopes)

(rule ((CheckMergeAt context merges available i)
       (< i (vec-size merges))
       (= (MergesAt merges i) (Carry parameter initial))
       (= uses (NamesOperand initial)))
      ((RequiredNames context uses available)
       (CheckMergeAt context merges available (+ i 1))) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Loop merges (Counted name start count step) returns body) available)
       (= a (NamesIndexExp start)) (= b (NamesIndexExp count)) (= c (NamesIndexExp step)))
      ((RequiredNames context (set-union a (set-union b c)) available)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= uses (NamesExecution execution)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= domain (IterationSpace flat axes))
       (= indices (BindersDomain domain))
       (WalkDomainAxes axes i)
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis index extent))
       (= uses (NamesIndexExp extent))
       (!= (set-intersect uses indices) (set-empty)))
      ((InvalidScope context "dense domain extent depends on its own indices")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) body) available))
      ((CheckAxisAt (NestedScope context id 0) axes available 0)) :ruleset memory-scopes)

(rule ((CheckAxisAt context axes available i)
       (< i (vec-size axes))
       (= axis (DomainAxesAt axes i))
       (= bound (BindersDomainAxis axis)))
      ((CheckAxisAt context axes (set-union available bound) (+ i 1))) :ruleset memory-scopes)

(rule ((CheckAxisAt context axes available i)
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis name length))
       (= uses (NamesIndexExp length)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((ParallelResultAt context results available i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Collect values))
       (= uses (NamesResults values)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((ParallelResultAt context results available i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Compact condition values))
       (= uses (NamesResults values))
       (= predicate (NamesAtom condition)))
      ((RequiredNames context (set-union uses predicate) available)) :ruleset memory-scopes)

(rule ((ParallelResultAt context results available i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Fold kind (Reduction commutative neutral combine) values))
       (CheckParallel context (ParallelBlock statements results) lanes outer)
       (= uses (NamesResults values))
       (= initial (NamesAtoms neutral)))
      ((RequiredNames context uses available)
       (RequiredNames context initial outer)) :ruleset memory-scopes)

(rule ((BindingOccurrence function name first) (BindingOccurrence function name second) (!= first second))
      ((InvalidFunction function "name has multiple binding occurrences")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern expression available)
       (= root (ScopeRoot context))
       (WalkPattern pattern i)
       (< i (vec-size pattern))
       (= names (BindersBinding (PatternAt pattern i)))
       (= name (set-at names 0)))
      ((BindingOccurrence root name (StatementBinding context id i))) :ruleset memory-scopes)

(rule ((CheckLambda context (FunctionBody params returns body) outer))
      ((ParameterAt context params outer 0)) :ruleset memory-scopes)

(rule ((ParameterAt context params available i)
       (< i (vec-size params))
       (= (ParamsAt params i) (Parameter binding diet))
       (= names (BindersBinding binding))
       (= uses (NamesBinding binding))
       (= name (set-at names 0))
       (= root (ScopeRoot context)))
      ((RequiredNames context (set-diff uses names) available)
       (BindingOccurrence root name (ParameterBinding context i))
       (ParameterAt context params (set-union available names) (+ i 1))) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Loop merges form returns body) available)
       (WalkMerges merges i)
       (< i (vec-size merges))
       (= (MergesAt merges i) (Carry (Parameter binding diet) initial))
       (= bound (BindersBinding binding))
       (= name (set-at bound 0))
       (= root (ScopeRoot context)))
      ((BindingOccurrence root name (MergeBinding context id i))) :ruleset memory-scopes)

(rule ((ParallelResultAt context results available i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Contribute tokens))
       (= uses (NamesAccNames tokens)))
      ((RequiredNames context uses available)) :ruleset memory-scopes)

(rule ((ParallelResultAt context results available i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Compact condition values)))
      ((CheckSlot context (ScalarSlot (ScalarElement (Bool))) (ValueOperand condition))) :ruleset memory-scopes)

(rule ((CheckFunction function))
      ((ExecutableScope (FunctionScope function))) :ruleset memory-scopes)

(rule ((= context (NestedScope parent id i)) (ExecutableScope parent))
      ((ExecutableScope context)) :ruleset memory-scopes)

(rule ((= context (ReducerScope parent i)) (ExecutableScope parent))
      ((ExecutableScope context)) :ruleset memory-scopes)

(rule ((CheckSlot context expected operand) (= function (ScopeRoot context)) (= actual (OperandSlot function operand)) (!= actual expected))
      ((InvalidScope context "operand type differs from its signature")) :ruleset memory-scopes)

(rule ((CheckLambda context (FunctionBody params returns (Block statements results)) outer) (ExecutableScope context))
      ((CheckSignature context returns results)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (If condition returns (Block a yes) (Block b no)) available))
      ((CheckSignature (NestedScope context id 0) returns yes)
       (CheckSignature (NestedScope context id 1) returns no)
       (CheckPatternSignature context pattern returns)
       (CheckSlot context (ScalarSlot (ScalarElement (Bool))) (ValueOperand condition))) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Loop merges form returns (Block statements results)) available))
      ((CheckSignature (NestedScope context id 0) returns results)
       (CheckPatternSignature context pattern returns)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Call name arguments returns) available))
      ((CheckPatternSignature context pattern returns)) :ruleset memory-scopes)

(rule ((CheckSignature context returns results) (!= (vec-size returns) (vec-size results)))
      ((InvalidScope context "body result count differs from its signature")) :ruleset memory-scopes)

(rule ((CheckPatternSignature context pattern returns) (!= (vec-size pattern) (vec-size returns)))
      ((InvalidScope context "statement result count differs from its signature")) :ruleset memory-scopes)

(rule ((CheckSignature context returns results)
       (WalkReturnInfos returns i)
       (< i (vec-size returns))
       (< i (vec-size results))
       (= expected (ReturnKind (ReturnInfosAt returns i)))
       (= (ResultsAt results i) (Yield certs operand)))
      ((CheckSlot context expected operand)) :ruleset memory-scopes)

(rule ((CheckPatternSignature context pattern returns)
       (WalkReturnInfos returns i)
       (< i (vec-size returns))
       (< i (vec-size pattern))
       (= expected (ReturnKind (ReturnInfosAt returns i)))
       (= actual (BindingSlot (PatternAt pattern i)))
       (!= actual expected))
      ((InvalidScope context "result binding type differs from its signature")) :ruleset memory-scopes)

(rule ((CheckMergeAt context merges available i)
       (< i (vec-size merges))
       (= (MergesAt merges i) (Carry (Parameter binding diet) operand))
       (= kind (BindingSlot binding)))
      ((CheckSlot context kind operand)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Loop merges (While condition) returns body) available))
      ((CheckSlot context (ScalarSlot (ScalarElement (Bool))) (ValueOperand (Var condition)))) :ruleset memory-scopes)

(rule ((ContainsReturnInfos root returns))
      ((ContainsReturnInfos (ReturnRoot returns) returns)) :ruleset memory-names)

(rule ((CheckReturnIndex context returns i expected) (< i 0))
      ((InvalidScope context "negative result witness index")) :ruleset memory-scopes)

(rule ((CheckReturnIndex context returns i expected) (>= i (vec-size returns)))
      ((InvalidScope context "result witness index exceeds signature")) :ruleset memory-scopes)

(rule ((CheckReturnIndex context returns i expected)
       (>= i 0)
       (< i (vec-size returns))
       (= actual (ReturnKind (ReturnInfosAt returns i)))
       (!= actual expected))
      ((InvalidScope context "result witness refers to the wrong slot kind")) :ruleset memory-scopes)

(rule ((ProgramFunction program (DefineFunction name params returns body)))
      ((CallableSignature program name params returns)) :ruleset memory-scopes)

(rule ((ProgramExternal program (DeclareExternal name params returns behavior accesses)))
      ((CallableSignature program name params returns)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context)) (ProgramFunction program function)
       (CallableSignature program name params declared) (!= (vec-size params) (vec-size arguments)))
      ((InvalidScope context "call argument count differs from callee signature")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context)) (ProgramFunction program function)
       (CallableSignature program name params declared) (!= (vec-size returns) (vec-size declared)))
      ((InvalidScope context "call result count differs from callee signature")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context))
       (ProgramFunction program function)
       (CallableSignature program name params declared)
       (WalkArguments arguments i)
       (< i (vec-size arguments))
       (< i (vec-size params))
       (= (ArgumentsAt arguments i) (Pass operand diet))
       (= (ParamsAt params i) (Parameter binding callee-diet))
       (= expected (BindingSlot binding)))
      ((CheckSlot context expected operand)) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Call name arguments returns) available)
       (= function (ScopeRoot context))
       (ProgramFunction program function)
       (CallableSignature program name params declared)
       (WalkReturnInfos returns i)
       (< i (vec-size returns))
       (< i (vec-size declared))
       (= expected (ReturnKind (ReturnInfosAt declared i)))
       (= actual (ReturnKind (ReturnInfosAt returns i)))
       (!= actual expected))
      ((InvalidScope context "call result type differs from callee signature")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution domain (ParallelBlock statements clauses)) available)
       (= count (ClauseOffset clauses (vec-size clauses))) (!= count (vec-size pattern)))
      ((InvalidScope context "parallel result count differs from its pattern")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i) (< i (vec-size clauses))
       (= offset (ClauseOffset clauses i)) (= indices (DomainIndices (IterationSpace flat axes))))
      ((CheckClauseBindings context pattern offset (vec-at clauses i) (vec-size indices))) :ruleset memory-scopes)

(rule ((CheckClauseBindings context pattern offset (Collect results) dimensions))
      ((CheckCollected context pattern offset results dimensions)) :ruleset memory-scopes)

(rule ((CheckClauseBindings context pattern offset (Compact condition results) dimensions))
      ((CheckCollected context pattern offset results dimensions)) :ruleset memory-scopes)

(rule ((CheckCollected context pattern offset results dimensions)
       (WalkResults results i)
       (< i (vec-size results))
       (= (ResultsAt results i) (Yield certs operand))
       (= function (ScopeRoot context))
       (= item (OperandSlot function operand))
       (= expected (CollectedSlot item dimensions))
       (< (+ offset i) (vec-size pattern))
       (= actual (BindingSlot (PatternAt pattern (+ offset i))))
       (!= expected actual))
      ((InvalidScope context "collected result type or rank differs from its binding")) :ruleset memory-scopes)

(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (!= (vec-size params) (* 2 (vec-size neutral))))
      ((InvalidScope context "reducer must take two accumulator tuples")) :ruleset memory-scopes)

(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (!= (vec-size returns) (vec-size neutral)))
      ((InvalidScope context "reducer changes its accumulator arity")) :ruleset memory-scopes)

(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (WalkAtoms neutral j)
       (< j (vec-size neutral))
       (< j (vec-size returns))
       (= expected (ReturnKind (ReturnInfosAt returns j))))
      ((CheckSignature context returns values)
       (CheckSlot context expected (ValueOperand (vec-at neutral j)))) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (FoldSlots kind 1 total)
       (= offset (ClauseOffset clauses i))
       (= indices (DomainIndices (IterationSpace flat axes))))
      ((CheckFoldBindings context pattern offset returns (vec-size indices))) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (> (vec-size axes) 0)
       (= (ParallelResultsAt clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (FoldSlots kind prefix 1)
       (= offset (ClauseOffset clauses i))
       (= outer (OuterDomain (IterationSpace flat axes)))
       (= indices (DomainIndices outer)))
      ((CheckFoldBindings context pattern (+ offset (* prefix (vec-size neutral))) returns (vec-size indices))) :ruleset memory-scopes)

(rule ((CheckFoldBindings context pattern offset returns dimensions)
       (WalkReturnInfos returns i)
       (< i (vec-size returns))
       (< (+ offset i) (vec-size pattern))
       (= element (ReturnKind (ReturnInfosAt returns i)))
       (= expected (CollectedSlot element dimensions))
       (= actual (BindingSlot (PatternAt pattern (+ offset i))))
       (!= actual expected))
      ((InvalidScope context "fold result type or rank differs from its binding")) :ruleset memory-scopes)

(rule ((CheckParallel context (ParallelBlock statements clauses) lanes outer)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (WalkParams params j)
       (< j (vec-size params))
       (> (vec-size neutral) 0)
       (= slot (% j (vec-size neutral)))
       (< slot (vec-size returns))
       (= (ParamsAt params j) (Parameter binding diet))
       (= actual (BindingSlot binding))
       (= expected (ReturnKind (ReturnInfosAt returns slot)))
       (!= actual expected))
      ((InvalidScope context "reducer parameter type differs from its accumulator")) :ruleset memory-scopes)

(rule ((CheckBody context (Block statements results) available)
       (WalkResults results i)
       (WalkResults results j)
       (< i j)
       (< j (vec-size results))
       (= (ResultsAt results i) (Yield a (AccOperand token)))
       (= (ResultsAt results j) (Yield b (AccOperand token))))
      ((InvalidScope context "body returns the same accumulator capability twice")) :ruleset memory-scopes)

(rule ((CheckMergeAt context merges available i)
       (CheckMergeAt context merges available j)
       (< i j)
       (< j (vec-size merges))
       (= (MergesAt merges i) (Carry a (AccOperand token)))
       (= (MergesAt merges j) (Carry b (AccOperand token))))
      ((InvalidScope context "loop duplicates an incoming accumulator capability")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (WithAcc inputs (FunctionBody params returns (Block statements results))) available)
       (= function (ScopeRoot context))
       (WalkAccInputs inputs i)
       (< i (vec-size inputs))
       (< i (vec-size results))
       (= (ResultsAt results i) (Yield certs (AccOperand token)))
       (= actual (TokenCapability function token))
       (= expected (AccInputsAt inputs i))
       (!= actual expected))
      ((InvalidScope context "accumulator scope returns a different capability")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (WithAcc inputs (FunctionBody params returns body)) available)
       (< (vec-size params) (vec-size inputs)))
      ((InvalidScope context "accumulator scope has fewer parameters than inputs")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (WithAcc inputs (FunctionBody params returns (Block statements results))) available)
       (< (vec-size results) (vec-size inputs)))
      ((InvalidScope context "accumulator scope loses a capability")) :ruleset memory-scopes)

(rule ((CheckStatement context id pattern (Parallel execution (IterationSpace flat (vec-of)) (ParallelBlock statements clauses)) available)
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind reducer values)))
      ((InvalidScope context "fold requires an iteration axis")) :ruleset memory-scopes)
(rule ((CheckCollected context pattern offset results dimensions)
       (WalkResults results i)
       (< i (vec-size results))
       (= (ResultsAt results i) (Yield certs operand))
       (= function (ScopeRoot context))
       (= item (OperandSlot function operand)))
      ((CollectSlotDemand item dimensions)) :ruleset memory-scopes)

(rule ((CheckFoldBindings context pattern offset returns dimensions)
       (WalkReturnInfos returns i)
       (< i (vec-size returns))
       (= item (ReturnKind (ReturnInfosAt returns i))))
      ((CollectSlotDemand item dimensions)) :ruleset memory-scopes)
