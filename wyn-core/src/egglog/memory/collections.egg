; Analysis collection types precede borrowed primitive registration.
(sort ProgramRewrites (Set Renaming))
(datatype StatementEdit (ReplaceStatement StatementId Stm) (ReplaceStatements StatementId Stms))
(sort StatementEdits (Set StatementEdit))
(sort StatementEditGroups (Set StatementEdits))
(sort StatementIds (Set StatementId))
(datatype CopyAlias (Alias ValueName ValueName StatementId))
(sort CopyAliases (Set CopyAlias))
(sort Statements (Set Stm))
(sort EquivalentNames (Set ValueName))
