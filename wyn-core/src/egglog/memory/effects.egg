; Logical effects describe observable reads, updates, and traps before storage is selected.
(ruleset memory-origin)
(function MovableEffects (Function Stm) Accesses :merge (set-union old new))
(function BindingInfo (Function ValueName) ValueInfo :no-merge)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name info)))
      ((set (BindingInfo function name) info)) :ruleset memory-origin)
(rule ((EffectContext function)) ((EffectsFunctionDemand function function)) :ruleset memory-effects)
; Value arrays are immutable logical values; only storage arrays observe shared memory.
(rule ((ContainsValueName (FunctionRoot function) name))
      ((set (ArrayReads function name) (set-empty))
       (set (ArrayWrites function name) (set-of (SharedRead) (SharedWrite)))) :ruleset memory-effects)
(rule ((ContainsBinding (FunctionRoot function)
          (BindValue name (LogicalValue (ArrayType (StorageArray) extents element)))))
      ((set (ArrayReads function name) (set-of (SharedRead)))) :ruleset memory-effects)
(rule ((ContainsAccName (FunctionRoot function) name))
      ((set (TokenWrites function name) (set-of (SharedWrite)))) :ruleset memory-effects)
(rule ((ContainsExp (FunctionRoot function) (Call name arguments returns)))
      ((set (CallEffects function name) (set-of (OrderedEffect)))) :ruleset memory-effects)
(rule ((EffectsStmDemand function (Let id pattern certs expression)))
      ((set (ResultEffects function expression pattern) (set-empty))) :ruleset memory-effects)
(rule ((EffectsStmDemand function (Let id pattern certs expression))
       (= expression (PrimOp opcode arguments))
       (= (vec-size pattern) 1)
       (= (PatternAt pattern 0) (BindValue name info)))
      ((set (PrimitiveResultType function expression) info)) :ruleset memory-effects)
(rule ((ContainsIndexExp (FunctionRoot function) denominator))
      ((set (IndexDivisionEffects function denominator) (set-of (OrderedEffect)))) :ruleset memory-effects)
(function Commutes (Accesses Accesses) bool :merge (and old new))
(relation CompareEffects (Accesses Accesses))
; A bounded read can be discarded, but moving it still requires Commutes.
(relation InspectReadOnly (Accesses))
(relation ReadOnlyEffects (Accesses))
(relation ReadOnlyAccess (Access))
(relation NonWritingEffects (Accesses))

(ReadOnlyAccess (SharedRead))
(rule ((= effects (EffectsStm function statement))) ((InspectReadOnly effects)) :ruleset memory-effects)
(rule ((= effects (EffectsParallelBody function body))) ((InspectReadOnly effects)) :ruleset memory-effects)
(rule ((InspectReadOnly effects) (= effects (set-empty))) ((ReadOnlyEffects effects)) :ruleset memory-effects)
(rule ((InspectReadOnly effects) (> (set-size effects) 0) (= first (set-at effects 0)) (ReadOnlyAccess first))
      ((InspectReadOnly (set-remove effects first))) :ruleset memory-effects)
(rule ((InspectReadOnly effects) (> (set-size effects) 0) (= first (set-at effects 0)) (ReadOnlyAccess first)
       (ReadOnlyEffects (set-remove effects first)))
      ((ReadOnlyEffects effects)) :ruleset memory-effects)
(rule ((= effects (EffectsStm function statement)))
      ((InspectReadOnly (set-remove effects (OrderedEffect)))) :ruleset memory-effects)
(rule ((= effects (EffectsStm function statement)) (ReadOnlyEffects (set-remove effects (OrderedEffect))))
      ((NonWritingEffects effects)) :ruleset memory-effects)
(rule ((CompareEffects left right)) ((set (Commutes left right) true)) :ruleset memory-effects)
(relation OrderedAccess (Access))
(OrderedAccess (OrderedEffect))
(OrderedAccess (SharedWrite))
(rule ((= access (MemoryWrite block))) ((OrderedAccess access)) :ruleset memory-effects)
; A total read can cross a trap; writes and other traps retain their source order.
(rule ((CompareEffects left right) (set-includes left (OrderedEffect))
       (OrderedAccess access) (set-includes right access))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-includes right (OrderedEffect))
       (OrderedAccess access) (set-includes left access))
      ((set (Commutes left right) false)) :ruleset memory-effects)

(rule ((CompareEffects left right) (set-includes left (SharedWrite)) (set-includes right (SharedWrite)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-includes left (SharedWrite)) (set-includes right (SharedRead)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-includes right (SharedWrite)) (set-includes left (SharedRead)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
