(ruleset memory-origin)
(function BindingInfo (Function ValueName) ValueInfo :no-merge)
; Function-local views are indices into syntax, never another layout authority.
(relation BlockSpace (Function BlockName Space))
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (Alloc space bytes)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindBlock block bytes)))
      ((BlockSpace function block space)) :ruleset memory-origin)
(rule ((= function (DefineFunction name params returns body))
       (WalkParams params i) (< i (vec-length params))
       (= (vec-get params i) (Parameter (BindBlock block bytes) diet)))
      ((BlockSpace function block (DeviceSpace))) :ruleset memory-origin)
(relation BlockAlias (Function BlockName BlockName))
(relation BlockResults (Function Pattern Body))
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (Use (BlockOperand input))))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindBlock output bytes)))
      ((BlockAlias function output input)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (If condition returns yes no))))
      ((BlockResults function pattern yes) (BlockResults function pattern no)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (WithAcc inputs (FunctionBody params returns body)))))
      ((BlockResults function pattern body)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Loop merges form returns body))))
      ((BlockResults function pattern body)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Loop merges form returns (Block statements results))))
       (WalkMerges merges i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter (BindBlock parameter bytes) diet) (BlockOperand initial)))
       (= (vec-get pattern i) (BindBlock output output-bytes))
       (= (vec-get results i) (Yield proofs (BlockOperand next))))
      ((BlockAlias function parameter initial)
       (BlockAlias function parameter next) (BlockAlias function output parameter)) :ruleset memory-origin)
(rule ((BlockResults function pattern (Block statements results)) (WalkPattern pattern i)
       (< i (vec-length pattern)) (< i (vec-length results))
       (= (vec-get pattern i) (BindBlock output bytes)) (= (vec-get results i) (Yield certs (BlockOperand input))))
      ((BlockAlias function output input)) :ruleset memory-origin)
(rule ((BlockAlias function output input) (BlockSpace function input space))
      ((BlockSpace function output space)) :ruleset memory-origin)
(function FreshBlock (Function BlockName) bool :merge (or old new))
(function BlockReads (Function BlockName) Accesses :merge (set-union old new))
(function BlockWrites (Function BlockName) Accesses :merge (set-union old new))
(rule ((ContainsBinding (FunctionRoot function) (BindBlock block bytes)))
      ((set (FreshBlock function block) false)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (Alloc space bytes)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindBlock block bytes)))
      ((set (FreshBlock function block) true)) :ruleset memory-origin)
(rule ((= (FreshBlock function block) true))
      ((set (BlockReads function block) (set-of (MemoryRead block)))
       (set (BlockWrites function block) (set-of (MemoryWrite block)))) :ruleset memory-effects)
; Different parameter/result block names do not prove different allocations.
(rule ((= (FreshBlock function block) false))
      ((set (BlockReads function block) (set-of (MemoryRead block) (SharedRead)))
       (set (BlockWrites function block) (set-of (MemoryWrite block) (SharedWrite)))) :ruleset memory-effects)
(rule ((BlockAlias function output input)
       (= reads (BlockReads function input)) (= writes (BlockWrites function input)))
      ((set (BlockReads function output) reads) (set (BlockWrites function output) writes)) :ruleset memory-effects)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayInfo element (ArrayIn block layout))))
       (= reads (BlockReads function block)) (= writes (BlockWrites function block)))
      ((set (ArrayReads function name) reads)
       (set (ArrayWrites function name) (set-union reads writes))) :ruleset memory-effects)
; Before allocation, a logical array's allocation identity is its binder.
; The same alias closure and conflict checks serve both IR phases.
(function BindingBlock (Function ValueName) BlockName :no-merge)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayInfo element (ArrayIn block layout)))))
      ((set (BindingBlock function name) block)) :ruleset memory-origin)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayValue element shape))))
      ((set (BindingBlock function name) (ArrayMemory name))
       (set (FreshBlock function (ArrayMemory name)) false)) :ruleset memory-origin)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayValue element shape)))
       (= reads (BlockReads function (ArrayMemory name))) (= writes (BlockWrites function (ArrayMemory name))))
      ((set (ArrayReads function name) reads)
       (set (ArrayWrites function name) (set-union reads writes))) :ruleset memory-effects)
(rule ((BlockAlias function output input) (= (FreshBlock function input) true))
      ((set (FreshBlock function output) true)) :ruleset memory-origin)
(relation FreshArrayResult (Exp))
(relation AliasedArrayResult (Exp ValueName))
(rule ((= expression (GenerateArray generator))) ((FreshArrayResult expression)) :ruleset memory-origin)
(rule ((= expression (Copy source))) ((FreshArrayResult expression)) :ruleset memory-origin)
(rule ((= expression (Parallel execution domain body))) ((FreshArrayResult expression)) :ruleset memory-origin)
(rule ((= expression (Use (ValueOperand (Var source))))) ((AliasedArrayResult expression source)) :ruleset memory-origin)
(rule ((= expression (View source slices))) ((AliasedArrayResult expression source)) :ruleset memory-origin)
(rule ((= expression (Permute source permutation))) ((AliasedArrayResult expression source)) :ruleset memory-origin)
(rule ((= expression (Reshape source shape))) ((AliasedArrayResult expression source)) :ruleset memory-origin)
(rule ((= expression (Update bounds source slices value))) ((AliasedArrayResult expression source)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs expression)) (FreshArrayResult expression)
       (WalkPattern pattern i) (< i (vec-length pattern)) (= (vec-get pattern i) (BindValue name (ArrayValue element shape))))
      ((set (FreshBlock function (ArrayMemory name)) true)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs expression)) (AliasedArrayResult expression source)
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ArrayValue element shape)))
       (= input (BindingBlock function source)))
      ((BlockAlias function (ArrayMemory name) input)) :ruleset memory-origin)
(rule ((BlockResults function pattern (Block statements results)) (WalkPattern pattern i)
       (< i (vec-length pattern)) (< i (vec-length results))
       (= (vec-get pattern i) (BindValue output (ArrayValue element shape)))
       (= (vec-get results i) (Yield certs (ValueOperand (Var input)))) (= block (BindingBlock function input)))
      ((BlockAlias function (ArrayMemory output) block)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Loop merges form returns (Block statements results))))
       (WalkMerges merges i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter (BindValue parameter (ArrayValue element shape)) diet) (ValueOperand (Var initial))))
       (= (vec-get pattern i) (BindValue output info)) (= (vec-get results i) (Yield proofs (ValueOperand (Var next))))
       (= initial-block (BindingBlock function initial)) (= next-block (BindingBlock function next)))
      ((BlockAlias function (ArrayMemory parameter) initial-block)
       (BlockAlias function (ArrayMemory parameter) next-block)
       (BlockAlias function (ArrayMemory output) (ArrayMemory parameter))) :ruleset memory-origin)
; An opaque array result may alias any array argument, including fresh storage.
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Call callee arguments returns)))
       (WalkPattern pattern i) (< i (vec-length pattern)) (= (vec-get pattern i) (BindValue output (ArrayValue element shape)))
       (WalkArguments arguments j) (< j (vec-length arguments)) (= (vec-get arguments j) (Pass (ValueOperand (Var input)) diet))
       (= block (BindingBlock function input)))
      ((BlockAlias function (ArrayMemory output) block)) :ruleset memory-origin)
(rule ((= info (ArrayInfo element location))) ((set (ArrayElement info) element)) :ruleset memory-names)
(rule ((= info (ArrayValue element shape))) ((set (ArrayElement info) element)) :ruleset memory-names)
(rule ((EffectsPatternDemand function pattern) (= pattern (vec-of))) ((set (DestinationEffects function pattern) (set-empty))) :ruleset memory-effects)
(rule ((EffectsPatternDemand function pattern) (WalkPattern pattern i) (< i (vec-length pattern)))
      ((set (DestinationEffects function pattern) (set-empty))) :ruleset memory-effects)
(rule ((EffectsPatternDemand function pattern) (WalkPattern pattern i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name (ArrayInfo element (ArrayIn block layout))))
       (= effects (BlockWrites function block)))
      ((set (DestinationEffects function pattern) effects)) :ruleset memory-effects)
(rule ((EffectsPatternDemand function pattern) (WalkPattern pattern i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindBlock block bytes)))
      ((set (DestinationEffects function pattern) (set-of (MemoryWrite block)))) :ruleset memory-effects)
(rule ((EffectsStmDemand function (Let id pattern certs expression))
       (= (WritesResult expression) true) (= effects (DestinationEffects function pattern)))
      ((set (ResultEffects function expression pattern) effects)) :ruleset memory-effects)
(rule ((EffectsStmDemand function (Let id pattern certs expression)) (= (WritesResult expression) false))
      ((set (ResultEffects function expression pattern) (set-empty))) :ruleset memory-effects)

(function Commutes (Accesses Accesses) bool :merge (and old new))
(relation CompareEffects (Accesses Accesses))
; A bounded read can be discarded, but moving it still requires Commutes.
(relation InspectReadOnly (Accesses))
(relation ReadOnlyEffects (Accesses))
(relation ReadOnlyAccess (Access))
(rule ((= access (MemoryRead block))) ((ReadOnlyAccess access)) :ruleset memory-effects)
(ReadOnlyAccess (SharedRead))
(rule ((= effects (EffectsStm function statement))) ((InspectReadOnly effects)) :ruleset memory-effects)
(rule ((= effects (EffectsParallelBody function body))) ((InspectReadOnly effects)) :ruleset memory-effects)
(rule ((InspectReadOnly effects) (= effects (set-empty))) ((ReadOnlyEffects effects)) :ruleset memory-effects)
(rule ((InspectReadOnly effects) (> (set-length effects) 0) (= first (set-get effects 0)) (ReadOnlyAccess first))
      ((InspectReadOnly (set-remove effects first))) :ruleset memory-effects)
(rule ((InspectReadOnly effects) (> (set-length effects) 0) (= first (set-get effects 0)) (ReadOnlyAccess first)
       (ReadOnlyEffects (set-remove effects first)))
      ((ReadOnlyEffects effects)) :ruleset memory-effects)
(rule ((CompareEffects left right)) ((set (Commutes left right) true)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-contains left (OrderedEffect)) (!= right (set-empty)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-contains right (OrderedEffect)) (!= left (set-empty)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (= write (MemoryWrite block))
       (set-contains left write) (set-contains right write))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (= write (MemoryWrite block))
       (set-contains left write) (set-contains right (MemoryRead block)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (= write (MemoryWrite block))
       (set-contains right write) (set-contains left (MemoryRead block)))
      ((set (Commutes left right) false)) :ruleset memory-effects)

(rule ((CompareEffects left right) (set-contains left (SharedWrite)) (set-contains right (SharedWrite)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-contains left (SharedWrite)) (set-contains right (SharedRead)))
      ((set (Commutes left right) false)) :ruleset memory-effects)
(rule ((CompareEffects left right) (set-contains right (SharedWrite)) (set-contains left (SharedRead)))
      ((set (Commutes left right) false)) :ruleset memory-effects)

; Read-only indexing can still fail outside its original guard. A complete
; dense domain proves its own pointwise reads safe without licensing gathers.
(function BoundedLoad (Function Exp) bool :merge (or old new))
(function ArrayRank (ValueInfo) i64 :no-merge)
(function ArrayExtent (ValueInfo i64) IndexExp :no-merge)
(relation LoadBoundsAt (Function Exp i64))
(rule ((= info (ArrayValue element shape)))
      ((set (ArrayRank info) (vec-length shape))) :ruleset memory-origin)
(rule ((= info (ArrayValue element shape)) (WalkShape shape i) (< i (vec-length shape)))
      ((set (ArrayExtent info i) (vec-get shape i))) :ruleset memory-origin)
(rule ((= info (ArrayInfo element (ArrayIn block (Layout offset dims)))))
      ((set (ArrayRank info) (vec-length dims))) :ruleset memory-origin)
(rule ((= info (ArrayInfo element (ArrayIn block (Layout offset dims))))
       (WalkLMADDims dims i) (< i (vec-length dims)) (= (vec-get dims i) (Dim stride size)))
      ((set (ArrayExtent info i) size)) :ruleset memory-origin)
(rule ((= expression (Load name indices)) (= info (BindingInfo function name)))
      ((set (BoundedLoad function expression) false)) :ruleset memory-origin)
(rule ((= expression (Load name indices)) (= info (BindingInfo function name))
       (= (vec-length indices) (ArrayRank info)))
      ((LoadBoundsAt function expression 0)) :ruleset memory-origin)
(rule ((LoadBoundsAt function expression i) (= expression (Load name indices))
       (< i (vec-length indices)) (= info (BindingInfo function name))
       (= size (ArrayExtent info i)) (= (vec-get indices i) (IndexValue index))
       (ContainsDomainAxis (FunctionRoot function) (DenseAxis index size)))
      ((LoadBoundsAt function expression (+ i 1))) :ruleset memory-origin)
(rule ((LoadBoundsAt function expression i) (= expression (Load name indices)) (= i (vec-length indices)))
      ((set (BoundedLoad function expression) true)) :ruleset memory-origin)
(rule ((= (BoundedLoad function expression) true))
      ((set (LoadBoundsEffects function expression) (set-empty))) :ruleset memory-effects)
(rule ((= (BoundedLoad function expression) false) (= expression (Load name indices)))
      ((set (LoadBoundsEffects function expression) (set-of (IndexedRead name indices)))) :ruleset memory-effects)

(rule ((ContainsBinding (FunctionRoot function) (BindValue name info)))
      ((set (BindingInfo function name) info)) :ruleset memory-origin)

(rule ((EffectContext function)) ((EffectsFunctionDemand function function)) :ruleset memory-effects)

; Primitive totality is typed: floating-point division cannot trap like integer division.
(rule ((EffectsStmDemand function (Let id pattern certs expression))
       (= expression (PrimOp opcode arguments)) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue name (ScalarInfo element))))
      ((set (PrimitiveResultType function expression) element)) :ruleset memory-effects)

(function AccumulatorArrays (AccInputs) ValueNames :no-merge)
(function AccumulatorArrayPrefix (AccInputs i64) ValueNames :no-merge)
(rule ((= expression (WithAcc inputs body))) ((set (AccumulatorArrayPrefix inputs 0) (vec-of))) :ruleset memory-origin)
(rule ((= prefix (AccumulatorArrayPrefix inputs i)) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays policy)))
      ((set (AccumulatorArrayPrefix inputs (+ i 1)) (vec-append prefix arrays))) :ruleset memory-origin)
(rule ((= arrays (AccumulatorArrayPrefix inputs (vec-length inputs))))
      ((set (AccumulatorArrays inputs) arrays)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (WithAcc inputs body)))
       (= arrays (AccumulatorArrays inputs)) (WalkPattern pattern i) (< i (vec-length pattern)) (< i (vec-length arrays))
       (= (vec-get pattern i) (BindValue output (ArrayValue element shape)))
       (= block (BindingBlock function (vec-get arrays i))))
      ((BlockAlias function (ArrayMemory output) block)) :ruleset memory-origin)
