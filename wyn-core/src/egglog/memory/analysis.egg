; Logical metadata consumed by optimization and direct SSA emission.
(ruleset schedule-cost)
(relation TotalScalarForm (Exp))
; Native subgroup addition is one implementation of the ordinary reducer.
; Other associative combiners retain the portable workgroup implementation.
(function NativeBinaryReducer (Lambda) String :no-merge)
(function NativeAddition (Lambda) bool :merge (or old new))
(rule ((ContainsLambda root lambda)) ((set (NativeAddition lambda) false)) :ruleset schedule-cost)
(rule ((= (NativeBinaryReducer lambda) "+"))
      ((set (NativeAddition lambda) true)) :ruleset schedule-cost)
(function StaticIndex (Function IndexExp) i64 :no-merge)
(function KnownSize (Function IndexExp) bool :merge (or old new))
(rule ((ContainsIndexExp (FunctionRoot function) index))
      ((set (KnownSize function index) false)) :ruleset schedule-cost)
(rule ((= n (StaticIndex function index)))
      ((set (KnownSize function index) true)) :ruleset schedule-cost)
(function GeneratedDispatches () bool :no-merge)
(function InvocationEntry (FunctionName) bool :merge (or old new))
(function EntryGrid (FunctionName) Grid :no-merge)
(function SubgroupsEnabled () bool :merge (or old new))
(set (SubgroupsEnabled) false)
(function LaneDependentFunction (Function) bool :merge (or old new))
(relation LaneBuiltin (String))
(LaneBuiltin "_w_intrinsic_thread_id")
(LaneBuiltin "_w_intrinsic_thread_id_y")
(LaneBuiltin "_w_intrinsic_thread_id_z")
(LaneBuiltin "_w_intrinsic_local_id")
(LaneBuiltin "_w_intrinsic_num_workgroups")
(LaneBuiltin "_w_intrinsic_workgroup_id")
(rule ((ProgramFunction program function))
      ((set (LaneDependentFunction function) false)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) (PrimOp opcode arguments)) (LaneBuiltin opcode))
      ((set (LaneDependentFunction function) true)) :ruleset schedule-cost)
(rule ((ProgramFunction program caller) (ProgramFunction program callee)
       (= callee (DefineFunction name params returns body))
       (ContainsExp (FunctionRoot caller) (Call name arguments signature))
       (= (LaneDependentFunction callee) true))
      ((set (LaneDependentFunction caller) true)) :ruleset schedule-cost)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexConstant n)))
      ((set (StaticIndex function (IndexConstant n)) n)) :ruleset schedule-cost)

; Fold only arithmetic whose result agrees with the emitted i32 index operation.
(relation IndexArithmetic (IndexExp String IndexExp IndexExp))
(rule ((= index (IndexAdd left right))) ((IndexArithmetic index "+" left right)) :ruleset schedule-cost)
(rule ((= index (IndexSub left right))) ((IndexArithmetic index "-" left right)) :ruleset schedule-cost)
(rule ((= index (IndexMul left right))) ((IndexArithmetic index "*" left right)) :ruleset schedule-cost)
(relation IndexArithmeticOperands (Function IndexExp String i64 i64))
(rule ((IndexArithmetic index op left right)
       (= a (StaticIndex function left)) (= b (StaticIndex function right))
       (>= a -2147483648) (<= a 2147483647) (>= b -2147483648) (<= b 2147483647))
      ((IndexArithmeticOperands function index op a b)) :ruleset schedule-cost)
(rule ((IndexArithmeticOperands function index "+" a b) (= n (+ a b))
       (>= n -2147483648) (<= n 2147483647))
      ((set (StaticIndex function index) n)) :ruleset schedule-cost)
(rule ((IndexArithmeticOperands function index "-" a b) (= n (- a b))
       (>= n -2147483648) (<= n 2147483647))
      ((set (StaticIndex function index) n)) :ruleset schedule-cost)
(rule ((IndexArithmeticOperands function index "*" a b) (= n (* a b))
       (>= n -2147483648) (<= n 2147483647))
      ((set (StaticIndex function index) n)) :ruleset schedule-cost)

; Recognize scalar reducers without choosing buffers or emitting memory operations.

(relation AtomicInteger (PrimType))
(AtomicInteger (I32))
(AtomicInteger (U32))
(relation NativeIntegerOpcode (String))
(NativeIntegerOpcode "+")
(NativeIntegerOpcode "&")
(NativeIntegerOpcode "|")
(NativeIntegerOpcode "^")
; Project vector members once, then join related reducer facts by lambda.
(relation BinaryReducerParts (Lambda Param Param ReturnInfo Stm Result))
(relation BinaryReducerOperation (Lambda Binding String Atom Atom))
(rule ((ContainsLambda root lambda)
       (= lambda (FunctionBody parameters returns (Block statements results)))
       (= (vec-length parameters) 2) (= (vec-length returns) 1)
       (= (vec-length statements) 1) (= (vec-length results) 1))
      ((BinaryReducerParts lambda (vec-get parameters 0) (vec-get parameters 1)
          (vec-get returns 0) (vec-get statements 0) (vec-get results 0))) :ruleset schedule-cost)
(rule ((BinaryReducerParts lambda left right result
          (Let id pattern certs (PrimOp opcode arguments)) yielded)
       (= (vec-length pattern) 1) (= (vec-length arguments) 2))
      ((BinaryReducerOperation lambda (vec-get pattern 0) opcode
          (vec-get arguments 0) (vec-get arguments 1))) :ruleset schedule-cost)
(rule ((BinaryReducerParts lambda
          (Parameter (BindValue left (ScalarInfo (ScalarElement primitive))) dl)
          (Parameter (BindValue right (ScalarInfo (ScalarElement primitive))) dr)
          (ReturnScalar (ScalarElement primitive)) statement
          (Yield proofs (ValueOperand (Var result))))
       (BinaryReducerOperation lambda (BindValue result (ScalarInfo (ScalarElement primitive))) opcode (Var a) (Var b))
       (AtomicInteger primitive) (NativeIntegerOpcode opcode)
       (= (set-of (ValueNameRef left) (ValueNameRef right))
          (set-of (ValueNameRef a) (ValueNameRef b))))
      ((set (NativeBinaryReducer lambda) opcode)) :ruleset schedule-cost)
(rule ((BinaryReducerParts lambda
          (Parameter (BindValue left (ScalarInfo (ScalarElement (F32)))) dl)
          (Parameter (BindValue right (ScalarInfo (ScalarElement (F32)))) dr)
          (ReturnScalar (ScalarElement (F32))) statement (Yield proofs (ValueOperand (Var result))))
       (BinaryReducerOperation lambda (BindValue result (ScalarInfo (ScalarElement (F32)))) "+" (Var a) (Var b))
       (= (set-of (ValueNameRef left) (ValueNameRef right))
          (set-of (ValueNameRef a) (ValueNameRef b))))
      ((set (NativeAddition lambda) true)) :ruleset schedule-cost)
; A destination snapshot cannot alias the source streams of an indexed update.
(relation FreshArray (Function ValueName))
(rule ((ContainsStm (FunctionRoot function)
          (Let id pattern certs (Copy source)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info)))
      ((FreshArray function name)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Length source dimension)))
       (= info (BindingInfo function source))
       (= info (LogicalValue (ArrayType ownership extents element)))
       (>= dimension 0) (< dimension (vec-length extents)) (= (vec-get extents dimension) (FixedExtent n))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name scalar)))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Use (ValueOperand (LiteralBits primitive n)))))
       (AtomicInteger primitive) (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name scalar)))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (IndexOp index)))
       (= n (StaticIndex function index)) (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name scalar)))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)

; A capacity bound never replaces a logical length. It only permits allocation
; before a compacted count is available to the host.
(function OuterCapacity (Function ValueName) i64 :merge (min old new))
(function IndexUpper (Function IndexExp) i64 :merge (min old new))
(function LogicalOuterCount (Function ValueName) IndexExp :no-merge)
(rule ((= count (LogicalOuterCount function name)) (= bound (OuterCapacity function name)))
      ((set (IndexUpper function count) bound)) :ruleset schedule-cost)

; Loop transport may retain a host length only when every backedge preserves it.
(relation LengthSource (Function ValueName ValueName))
(relation ReducerPreservesOuterLength (Function Lambda i64))
(relation CountLength (Function IndexExp ValueName))
(relation LengthWitness (Function ValueName ValueName))
(relation LoopArrayCarry (Function Exp i64 ValueName ValueName ValueName))
(relation LoopPreservesOuterLength (Function Exp i64))
; Product fields retain their logical identity; no signature or storage decomposition is needed.
(datatype LogicalPath (RootPath) (FieldPath LogicalPath i64))
(relation ProductField (Function ValueName i64 ValueName))
(relation ProductComponent (Function ValueName LogicalPath ValueName))
(relation ProjectionPath (Function ValueName ValueName LogicalPath))
(relation LoopValueCarry (Function Exp i64 ValueName ValueName ValueName))
(relation LoopArrayComponent (Function Exp i64 LogicalPath ValueName ValueName ValueName))
(relation LoopPreservesComponentLength (Function Exp i64 LogicalPath))
(rule ((ContainsValueName (FunctionRoot function) value))
      ((ProductComponent function value (RootPath) value)
       (ProjectionPath function value value (RootPath))) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue product info)) certs (Product fields)))
       (WalkAtoms fields i) (< i (vec-length fields)) (= (vec-get fields i) (Var value)))
      ((ProductField function product i value)) :ruleset schedule-cost)
(rule ((ProductComponent function product path value) (ProductField function value i field))
      ((ProductComponent function product (FieldPath path i) field)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue value info)) certs (Project (Var source) i)))
       (ProjectionPath function source root path))
      ((ProjectionPath function value root (FieldPath path i))) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue value info)) certs (Project (Var source) i)))
       (ProductComponent function source (FieldPath (RootPath) i) field))
      ((LengthSource function value field)) :ruleset schedule-cost)
(rule ((LengthSource function value source) (ProductComponent function source path field))
      ((ProductComponent function value path field)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression)
       (= expression (Loop merges form returns (Block statements results)))
       (WalkMerges merges i) (< i (vec-length merges)) (< i (vec-length results))
       (= (vec-get merges i) (Carry (Parameter (BindValue carried info) diet) (ValueOperand (Var initial))))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var next)))))
      ((LoopValueCarry function expression i carried initial next)) :ruleset schedule-cost)
(rule ((LoopValueCarry function expression i carried initial next)
       (ProjectionPath function array carried path)
       (ContainsBinding (FunctionRoot function) (BindValue array (LogicalValue (ArrayType ownership extents element))))
       (ProductComponent function initial path first) (ProductComponent function next path last))
      ((LoopArrayComponent function expression i path array first last)
       (LengthWitness function array array)) :ruleset schedule-cost)
(rule ((LoopArrayComponent function expression i path array first last) (LengthWitness function last array))
      ((LoopPreservesComponentLength function expression i path)) :ruleset schedule-cost)
(rule ((LoopArrayComponent function expression i path array first last)
       (LoopPreservesComponentLength function expression i path) (= bound (OuterCapacity function first)))
      ((set (OuterCapacity function array) bound)) :ruleset schedule-cost)
(rule ((LoopValueCarry function expression i carried initial next)
       (LoopPreservesComponentLength function expression i path)
       (ContainsStm (FunctionRoot function) (Let id pattern certs expression)) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue result info)) (ProjectionPath function array result path)
       (ProductComponent function initial path first))
      ((LengthSource function array first)) :ruleset schedule-cost)
(rule ((LengthSource function value middle) (LengthSource function middle source))
      ((LengthSource function value source)) :ruleset schedule-cost)
(rule ((LengthSource function value source) (= bound (OuterCapacity function source)))
      ((set (OuterCapacity function value) bound)) :ruleset schedule-cost)
(rule ((ContainsReducer (FunctionRoot function) (Reduction order neutral lambda))
       (= lambda (FunctionBody parameters returns (Block statements results)))
       (WalkAtoms neutral i) (< i (vec-length neutral)) (< i (vec-length parameters)) (< i (vec-length results))
       (= (vec-get parameters i) (Parameter (BindValue state info) diet))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var value))))
       (LengthSource function value state))
      ((ReducerPreservesOuterLength function lambda i)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue name info)) certs (Length source 0))))
      ((CountLength function (IndexValue name) source)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue name info)) certs (IndexOp count)))
       (CountLength function count source))
      ((CountLength function (IndexValue name) source)) :ruleset schedule-cost)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexMax (IndexConstant 0) count))
       (CountLength function count source))
      ((CountLength function (IndexMax (IndexConstant 0) count) source)) :ruleset schedule-cost)
(rule ((= count (LogicalOuterCount function name)) (CountLength function count source))
      ((LengthSource function name source)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue name info)) certs (Copy source))))
      ((LengthSource function name source)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue name info)) certs (Use (ValueOperand (Var source))))))
      ((LengthSource function name source)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue name info)) certs (Update mode source slices value))))
      ((LengthSource function name source)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression)
       (= expression (Loop merges form returns (Block statements results)))
       (WalkMerges merges i) (< i (vec-length merges)) (< i (vec-length results))
       (= (vec-get merges i) (Carry (Parameter (BindValue carried (LogicalValue (ArrayType ownership extents element))) diet) (ValueOperand (Var initial))))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var next)))))
      ((LoopArrayCarry function expression i carried initial next)
       (LengthWitness function carried carried)) :ruleset schedule-cost)
(rule ((LengthSource function next previous) (LengthWitness function previous carried))
      ((LengthWitness function next carried)) :ruleset schedule-cost)
(rule ((ProjectionPath function left root path) (ProjectionPath function right root path))
      ((LengthSource function left right)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs
          (If condition returns (Block yes-statements yes-results) (Block no-statements no-results))))
       (WalkResults yes-results i) (< i (vec-length yes-results))
       (< i (vec-length no-results)) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue result info))
       (= (vec-get yes-results i) (Yield yes-proofs (ValueOperand (Var yes))))
       (= (vec-get no-results i) (Yield no-proofs (ValueOperand (Var no))))
       (LengthWitness function yes carried) (LengthWitness function no carried))
      ((LengthWitness function result carried)) :ruleset schedule-cost)
(rule ((LoopArrayCarry function expression i carried initial next) (LengthWitness function next carried))
      ((LoopPreservesOuterLength function expression i)) :ruleset schedule-cost)
(rule ((LoopArrayCarry function expression i carried initial next) (LoopPreservesOuterLength function expression i)
       (= bound (OuterCapacity function initial)))
      ((set (OuterCapacity function carried) bound)) :ruleset schedule-cost)
(rule ((LoopArrayCarry function expression i carried initial next) (LoopPreservesOuterLength function expression i)
       (ContainsStm (FunctionRoot function) (Let id pattern certs expression))
       (< i (vec-length pattern)) (= (vec-get pattern i) (BindValue result info)))
      ((LengthSource function result initial)) :ruleset schedule-cost)
(rule ((= n (StaticIndex function index)))
      ((set (IndexUpper function index) n)) :ruleset schedule-cost)
(rule ((ContainsBinding (FunctionRoot function)
          (BindValue name (LogicalValue (ArrayType ownership extents element))))
       (> (vec-length extents) 0) (= (vec-get extents 0) (FixedExtent n)))
      ((set (OuterCapacity function name) (max 0 n))) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id (vec-of (BindValue name info)) certs
          (View source (vec-of (Slice start count (IndexConstant stride))))))
       (!= stride 0) (= bound (OuterCapacity function source)))
      ((set (OuterCapacity function name) bound)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Length source 0)))
       (= n (OuterCapacity function source)) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue name info)))
      ((set (IndexUpper function (IndexValue name)) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (IndexOp index)))
       (= n (IndexUpper function index)) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue name info)))
      ((set (IndexUpper function (IndexValue name)) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (GenerateArray (RangeValues start count step))))
       (= n (IndexUpper function count)) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue name info)))
      ((set (OuterCapacity function name) (max 0 n))) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (GenerateArray (ArrayLiteral values))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name info)))
      ((set (OuterCapacity function name) (vec-length values))) :ruleset schedule-cost)
(relation CapacityClause (ParallelResult Results))
(rule ((= clause (Collect results))) ((CapacityClause clause results)) :ruleset schedule-cost)
(rule ((= clause (Compact predicate results))) ((CapacityClause clause results)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (> (vec-length axes) 0) (= (vec-get axes 0) (DenseAxis index count)) (= n (IndexUpper function count))
       (WalkParallelResults clauses i) (< i (vec-length clauses)) (= clause (vec-get clauses i))
       (CapacityClause clause results) (= offset (ClauseOffset clauses i))
       (WalkResults results j) (< j (vec-length results)) (< (+ offset j) (vec-length pattern))
       (= (vec-get pattern (+ offset j)) (BindValue name info)))
      ((set (OuterCapacity function name) (max 0 n))) :ruleset schedule-cost)
(rule ((= index (IndexMax left right))
       (= a (StaticIndex function left)) (= b (StaticIndex function right)))
      ((set (StaticIndex function index) (max a b))) :ruleset schedule-cost)
(rule ((= index (IndexMin left right))
       (= a (StaticIndex function left)) (= b (StaticIndex function right)))
      ((set (StaticIndex function index) (min a b))) :ruleset schedule-cost)
(rule ((= index (IndexMax left right))
       (= a (IndexUpper function left)) (= b (IndexUpper function right)))
      ((set (IndexUpper function index) (max a b))) :ruleset schedule-cost)
(rule ((= index (IndexMin left right))
       (= a (IndexUpper function left)) (= b (IndexUpper function right)))
      ((set (IndexUpper function index) (min a b))) :ruleset schedule-cost)

; Only nonoverflowing nonnegative integer sums can bound an allocation count.
(function IntegerLower (Function Atom) i64 :merge (max old new))
(function IntegerUpper (Function Atom) i64 :merge (min old new))
(rule ((ContainsAtom (FunctionRoot function) atom) (= atom (LiteralBits (I32) n))
       (>= n -2147483648) (<= n 2147483647))
      ((set (IntegerLower function atom) n) (set (IntegerUpper function atom) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Use (ValueOperand atom))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= low (IntegerLower function atom)) (= high (IntegerUpper function atom)))
      ((set (IntegerLower function (Var name)) low) (set (IntegerUpper function (Var name)) high)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (PrimOp "select" arguments)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= (vec-length arguments) 3) (= a (vec-get arguments 0)) (= b (vec-get arguments 1))
       (= low-a (IntegerLower function a)) (= low-b (IntegerLower function b))
       (= high-a (IntegerUpper function a)) (= high-b (IntegerUpper function b)))
      ((set (IntegerLower function (Var name)) (min low-a low-b))
       (set (IntegerUpper function (Var name)) (max high-a high-b))) :ruleset schedule-cost)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= high (IntegerUpper function (Var name))))
      ((set (IndexUpper function (IndexValue name)) high)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs
          (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (vec-length axes) 1) (= (vec-get axes 0) (DenseAxis index count))
       (= n (IndexUpper function count)) (>= n 0) (<= n 2147483647)
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral combine) values))
       (= (vec-length neutral) 1) (= (vec-get neutral 0) (LiteralBits (I32) 0))
       (= (NativeBinaryReducer combine) "+") (= (vec-length values) 1)
       (= (vec-get values 0) (Yield proofs (ValueOperand contribution)))
       (= low (IntegerLower function contribution)) (>= low 0)
       (= high (IntegerUpper function contribution)) (<= high 2147483647)
       (= bound (* n high)) (<= bound 2147483647)
       (FoldSlots kind prefix 1) (= offset (ClauseOffset clauses i))
       (< (+ offset prefix) (vec-length pattern))
       (= (vec-get pattern (+ offset prefix)) (BindValue name (ScalarInfo (ScalarElement (I32))))))
      ((set (IntegerLower function (Var name)) 0)
       (set (IntegerUpper function (Var name)) bound)) :ruleset schedule-cost)
