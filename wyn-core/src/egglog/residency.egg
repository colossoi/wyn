; Only host invocations create launches; scalar callbacks stay invocation-local.
; Classify opaque scalar subtrees before deriving host regions and phases.
(rule ((= r (OperationRegion op)))
      ((set (ContainsCollective op) false) (set (InvocationBoundary op) false) (set (HostLoopCandidate op) false)) :ruleset structure)
(rule ((= r (OperationRegion child)) (= true (ContainsCollective child)) (Enters parent r))
      ((set (ContainsCollective parent) true)) :ruleset structure)
(rule ((= r (OperationRegion op)) (= true (ContainsCollective op))) ((RegionContainsCollective r)) :ruleset structure)
(rule ((InvocationScalarCandidate op) (= false (ContainsCollective op)))
      ((set (InvocationBoundary op) true)) :ruleset classify)
(rule ((HostRegion r) (= r (OperationRegion op)) (InvocationScalarCandidate op) (= false (ContainsCollective op)) (= (Rematerialize op) false))
      ((InvocationValue op)) :ruleset residency)
; Control without a host-loop recipe remains invocation-local.
(rule ((InvocationScalarCandidate op) (OperationControl op) (= (HostLoopCandidate op) false))
      ((set (InvocationBoundary op) true)) :ruleset classify)
(rule ((HostRegion r) (= r (OperationRegion op)) (InvocationScalarCandidate op) (OperationControl op) (= (HostLoopCandidate op) false) (= (Rematerialize op) false))
      ((InvocationValue op)) :ruleset residency)
(rule ((HostRoot entry r)) ((HostRegion r)) :ruleset host-regions)
(rule ((HostRoot entry r)) ((OwnedRegion entry r)) :ruleset residency)
(rule ((OwnedRegion entry r) (= r (OperationRegion op)) (Enters op child))
      ((OwnedRegion entry child)) :ruleset residency)
(rule ((Phase stage r) (OwnedRegion entry r)) ((PhaseOwner stage entry)) :ruleset residency)
(rule ((HostRegion r) (= r (OperationRegion op)) (Enters op child) (= false (InvocationBoundary op)))
      ((HostRegion child)) :ruleset host-regions)

; Resolve component references without merging value or execution identities.
(rule ((ArrayResult op i t)) ((ResultSlot op i)) :ruleset residency)
(rule ((TotalResult op i t)) ((ResultSlot op i)) :ruleset residency)
(rule ((UpdatedResult op i e)) ((ResultSlot op i)) :ruleset residency)
(rule ((InitializedResult op i t n)) ((ResultSlot op i)) :ruleset residency)
(rule ((FilterResult op t)) ((ResultSlot op 0) (ResultSlot op 1)) :ruleset residency)
(rule ((BucketResult op destination)) ((ResultSlot op 1) (ResultSlot op 2)) :ruleset residency)
(rule ((ParameterValue e)) ((set (ValueRef e) (Source e))) :ruleset residency)
(rule ((DirectResult e op i)) ((set (ValueRef e) (Result op i))) :ruleset residency)
(rule ((Projection e tuple i) (ResultTuple tuple op) (ResultSlot op i))
      ((set (ValueRef e) (Result op i))) :ruleset residency)
(rule ((Projection e tuple i) (SourceField tuple i field))
      ((ForwardValue e field)) :ruleset residency)
(rule ((Projection e tuple i) (ForwardValue tuple inner))
      ((Projection e inner i)) :ruleset residency)
; A field reads its containing value, but does not alias the whole buffer.
(rule ((ReferenceDemand e) (Projection e tuple i) (= (ValueRef tuple) value))
      ((References e (Contents value))) :ruleset residency)
(rule ((ForwardValue e source) (= (ValueRef source) value))
      ((set (ValueRef e) value)) :ruleset residency)
(rule ((= (SourceSlice e) (SliceInfo source start end)) (= (ValueRef source) value)) ((set (ValueRef e) value)) :ruleset residency)
(rule ((DirectResult e op i) (= access (ResultRead op i)))
      ((set (ValueRead e) access)) :ruleset residency)
(rule ((Projection e tuple i) (ResultTuple tuple op) (= access (ResultRead op i)))
      ((set (ValueRead e) access)) :ruleset residency)
(rule ((ForwardValue e source) (= access (ValueRead source)))
      ((set (ValueRead e) access)) :ruleset residency)

; Request shared reference summaries only for scheduling, reuse, and output
; consumers. Propagate demand through scalar structure, stopping at results.
(rule ((Demand site e)) ((ReferenceDemand e)) :ruleset residency)
(rule ((PlannedOutput output owner e)) ((ReferenceDemand e)) :ruleset residency)
(rule ((Phase (Stage op name) r) (Operand op role e)) ((ReferenceDemand e)) :ruleset residency)
(rule ((ReferenceDemand e) (ChildValue e child)) ((ReferenceDemand child)) :ruleset residency)
(rule ((ReferenceDemand e) (ForwardValue e child)) ((ReferenceDemand child)) :ruleset residency)
(rule ((ReferenceDemand e) (Projection e tuple i) (ComputedValue tuple)) ((ReferenceDemand tuple)) :ruleset residency)
(rule ((ReferenceDemand e) (= (SourceSlice e) (SliceInfo source start end)))
      ((ReferenceDemand source) (ReferenceDemand start) (ReferenceDemand end)) :ruleset residency)
(rule ((ReferenceDemand e) (= (ValueRef e) value)) ((References e (Contents value))) :ruleset residency)
(rule ((ReferenceDemand e) (ChildValue e child) (References child value)) ((References e value)) :ruleset residency)
(rule ((ReferenceDemand e) (ForwardValue e child) (References child value)) ((References e value)) :ruleset residency)
(rule ((ReferenceDemand e) (Projection e tuple i) (ComputedValue tuple) (References tuple value))
      ((References e value)) :ruleset residency)
(rule ((ReferenceDemand e) (ResultTuple e op) (ResultSlot op i)) ((References e (Contents (Result op i)))) :ruleset residency)
(rule ((ReferenceDemand e) (= (SourceSlice e) (SliceInfo source start end)) (References source value)) ((References e value)) :ruleset residency)
(rule ((ReferenceDemand e) (= (SourceSlice e) (SliceInfo source start end)) (References start value)) ((References e value)) :ruleset residency)
(rule ((ReferenceDemand e) (= (SourceSlice e) (SliceInfo source start end)) (References end value)) ((References e value)) :ruleset residency)

; Only actual uses join those summaries; there is no stage x expression search.
(rule ((PhaseInput stage op role) (Operand op role e)) ((Demand (InStage stage) e)) :ruleset residency)
; Scalar control bodies may capture earlier executions through nested regions.
(relation DispatchGroupContentNeed (StageKey ValueKey))
(rule ((DispatchGroupLeader op leader) (Phase (Stage leader "scalar") r) (OperationDependency op before) (Produces producer (Result before i)))
      ((Needs (Stage leader "scalar") (Result before i))
       (DispatchGroupContentNeed (Stage leader "scalar") (Result before i))) :ruleset residency)
; Lengths follow view metadata; reading an allocation's size does not require
; waiting for its element writer. Compacted lengths do require the count writer.
(rule ((PhaseDomain stage n width)) ((ExtentDemand stage n)) :ruleset residency)
(rule ((Needs stage value) (= n (CapacityExtent value))) ((ExtentDemand stage n)) :ruleset residency)
(rule ((ExtentDemand stage (Scalar e))) ((Demand (InStage stage) e)) :ruleset residency)
(rule ((ExtentDemand stage (Product a b))) ((ExtentDemand stage a) (ExtentDemand stage b)) :ruleset residency)
(rule ((ExtentDemand stage (Difference a b))) ((ExtentDemand stage a) (ExtentDemand stage b)) :ruleset residency)
(rule ((ExtentDemand stage (Stored value))) ((Needs stage value)) :ruleset residency)
(rule ((ExtentDemand stage (Length e)) (= n (ViewExtent e))) ((ExtentDemand stage n)) :ruleset residency)
(rule ((ExtentDemand stage (Length e)) (= (ValueRef e) (Source source))) ((Needs stage (Source source))) :ruleset residency)
(rule ((ExtentDemand stage (Length e)) (= (ValueRef e) value) (= n (LiveLength value))) ((ExtentDemand stage n)) :ruleset residency)
(rule ((ExtentDemand stage (Length e)) (= (ValueRef e) value) (= source (SameBacking value))) ((ExtentDemand stage (Length source))) :ruleset residency)
(rule ((ExtentDemand stage (Length e)) (= (SourceSlice e) (SliceInfo source start end)))
      ((Demand (InStage stage) start) (Demand (InStage stage) end)) :ruleset residency)
(rule ((HostRegion r) (= r (OperationRegion op)) (InvocationResult value op) (= (InvocationBoundary op) false)
       (= (Rematerialize op) false) (Operand op role e))
      ((Demand (InOperation op) e)) :ruleset residency)
(rule ((HostRegion r) (ExitValue r e)) ((Demand (AtExit) e)) :ruleset residency)
(rule ((Demand site e) (References e (Contents value))) ((Requires site value)) :ruleset residency)
(rule ((Demand (InStage stage) e) (References e (Descriptor source)))
      ((Needs stage (Source source))) :ruleset residency)
(rule ((Requires (InStage stage) value)) ((Needs stage value)) :ruleset residency)

; Any host-region exit requires its values to survive the invocation.
(rule ((Requires (AtExit) value)) ((Escapes value)) :ruleset residency)
(rule ((Produces producer value) (Needs consumer value) (!= producer consumer))
      ((Materialize value)) :ruleset residency)
(rule ((Escapes value) (Produces producer value)) ((Materialize value)) :ruleset residency)
(rule ((Requires (InOperation op) value) (Produces producer value))
      ((Materialize value)) :ruleset residency)

(rule ((UninitializedResult op i t n)) ((ResultSlot op i)) :ruleset residency)

(rule ((HostRegion parent) (= parent (OperationRegion op)) (= (ContainsCollective op) true)
       (CountedArrayLoop op r a s i n))
      ((HostLoop op r a s i n)) :ruleset residency)
