; Identities shared by the fusion, expression, and block layers.
(datatype RegionKey (RegionId i64))
(datatype OperationKey (OperationId i64))
; Scoped source identities are shared directly by planning and scalar admission.
(datatype SourceValue
  (SourceTerm RegionKey i64)
  (SourceFormal RegionKey i64)
  (SourceGlobal i64))
; Stable import order is only used for deterministic choices, never as a value wrapper.
(function SourceOrdinal (SourceValue) i64 :no-merge)

; A value's forwarding identity is distinct from evaluating its occurrence.
(ruleset flow-forward)
(ruleset flow-projections)
(ruleset source-summary)
; Backward resource liveness over explicit evaluation edges.
(ruleset flow-live)
(relation FlowNext (i64 i64))
(relation FlowLive (i64 i64))
(relation FlowLiveOut (i64 i64))
(function FlowKilled (i64 i64) bool :merge (or old new))
(rule ((FlowNext point next) (FlowLive next resource)) ((FlowLiveOut point resource)) :ruleset flow-live)
(rule ((FlowLiveOut point resource)) ((set (FlowKilled point resource) false)) :ruleset flow-live)
(rule ((FlowLiveOut point resource) (= (FlowKilled point resource) false)) ((FlowLive point resource)) :ruleset flow-live)
(function SourceAlias (SourceValue) SourceValue :no-merge)
(relation SourceField (SourceValue i64 SourceValue))
(datatype SourceProjectionData (ProjectionInfo SourceValue i64))
(function SourceProjection (SourceValue) SourceProjectionData :no-merge)
; Structural dependencies include projections, which do not equate whole values.
(relation FlowFrom (SourceValue SourceValue))
(rule ((= child (SourceAlias value))) ((FlowFrom value child)) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo child i))) ((FlowFrom value child)) :ruleset source-summary)
(relation SourceSelect (SourceValue SourceValue i64))
(relation SourceFieldUpdate (SourceValue SourceValue i64 SourceValue))
(function SourceForwardField (SourceValue i64) SourceValue :no-merge)
(function SourceSelectResolved (SourceValue) bool :merge (or old new))
(rule ((SourceSelect value parent i)) ((set (SourceSelectResolved value) false)) :ruleset flow-forward)
(rule ((SourceField value i child)) ((set (SourceForwardField value i) child)) :ruleset flow-forward)
(rule ((= parent (SourceAlias value)) (= child (SourceForwardField parent i)))
      ((set (SourceForwardField value i) child)) :ruleset flow-forward)
(rule ((SourceFieldUpdate value parent i child))
      ((set (SourceForwardField value i) child)) :ruleset flow-forward)
(rule ((SourceFieldUpdate value parent i child) (= other (SourceForwardField parent j)) (!= i j))
      ((set (SourceForwardField value j) other)) :ruleset flow-forward)
(rule ((SourceSelect value parent i) (= child (SourceForwardField parent i)) (!= value child))
      ((set (SourceAlias value) child) (set (SourceSelectResolved value) true)) :ruleset flow-forward)
(rule ((SourceSelect value parent i) (= (SourceSelectResolved value) false))
      ((set (SourceProjection value) (ProjectionInfo parent i))) :ruleset flow-projections)

; Early passes query input dependencies and component-wise unchanged inputs.
(function FlowInput (SourceValue) i64 :no-merge)
(function FlowStructuralInput (SourceValue) i64 :no-merge)
(rule ((= symbol (FlowInput value))) ((set (FlowStructuralInput value) symbol)) :ruleset source-summary)
(rule ((= child (SourceAlias value)) (= symbol (FlowStructuralInput child)))
      ((set (FlowStructuralInput value) symbol)) :ruleset source-summary)
(relation FlowOperand (SourceValue SourceValue))
; Placement adds reference edges without changing the source dependency proofs.
(relation FlowReferenceEdge (SourceValue SourceValue))
(relation FlowChoice (SourceValue SourceValue SourceValue))
(relation FlowRead (SourceValue SourceValue))
(datatype FlowPath (FlowEnd) (FlowAt i64 FlowPath))
(FlowEnd)
(function FlowInputAt (SourceValue FlowPath) i64 :no-merge)
(rule ((= symbol (FlowInput value)))
      ((FlowRead value value) (set (FlowInputAt value (FlowEnd)) symbol)) :ruleset source-summary)
(rule ((FlowOperand value child) (FlowRead child symbol))
      ((FlowRead value symbol)) :ruleset source-summary)
(rule ((FlowFrom value child) (FlowRead child symbol))
      ((FlowRead value symbol)) :ruleset source-summary)
(rule ((= child (SourceAlias value)) (= symbol (FlowInputAt child path)))
      ((set (FlowInputAt value path) symbol)) :ruleset source-summary)
(rule ((= child (SourceForwardField value i)) (= symbol (FlowInputAt child path)))
      ((set (FlowInputAt value (FlowAt i path)) symbol)) :ruleset source-summary)
(rule ((FlowChoice value yes no) (= symbol (FlowInputAt yes path)) (= symbol (FlowInputAt no path)))
      ((set (FlowInputAt value path) symbol)) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo parent i)) (= symbol (FlowInputAt parent (FlowAt i path))))
      ((set (FlowInputAt value path) symbol)) :ruleset source-summary)

; Executing an occurrence is distinct from referring to its resulting value.
(relation FlowEvaluation (SourceValue SourceValue))
(relation FlowRegionEvaluation (RegionKey SourceValue))
