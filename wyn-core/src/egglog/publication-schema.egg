; Resource identities come from source interfaces; dependencies are selected here.
(datatype PublicationResource
  (NamedResource String String)
  (DescriptorResource String i64 i64))
(relation SourceInterfaceParameter (SourceValue PublicationResource i64))
(relation SourceInterfaceOutput (i64 PublicationResource bool))
(relation SourceInterfaceBinding (i64 BindingKey PublicationResource))
(relation SourceInterfaceFamily (i64 String))
(relation SourceEntryOrder (i64 i64))
(relation SourceRegionUse (RegionKey SourceValue))
(relation SourceDrawRead (i64 PublicationResource))
(relation RootUsesRegion (RootKey RegionKey))
(relation RootValueUse (RootKey SourceValue))
(function RootReadOnly (RootKey) bool :merge (and old new))
(function PublicationAccess (RootKey PublicationResource) i64 :merge (| old new))
(relation PublicationProduced (RootKey PublicationResource))
(relation PublicationDependency (RootKey RootKey))
(relation PhaseCallback (StageKey RegionKey))
(relation RootPushInput (RootKey i64 i64))
