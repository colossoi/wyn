; Backing identity is distinct from the version of a value stored there.
; Destination selection completes before fresh storage can be allocated.
(rule ((FreshValue value)) ((set (ReuseSelected value) false)) :ruleset allocation)
(rule ((FreshValue value)) ((set (IsMaterialized value) false)) :ruleset allocation)
(rule ((Materialize value)) ((set (IsMaterialized value) true)) :ruleset allocation)
(rule ((Materialize value) (= (StorageFor value) (Allocate))) ((set (Backing value) value)) :ruleset allocation)
(rule ((= (StorageFor value) (Reuse e))) ((SameBacking value e)) :ruleset allocation)
(rule ((Needs stage (Source e))) ((set (Backing (Source e)) (Source e))) :ruleset allocation)
(rule ((Requires (InOperation op) (Source e))) ((set (Backing (Source e)) (Source e))) :ruleset allocation)
(rule ((Escapes (Source e))) ((set (Backing (Source e)) (Source e))) :ruleset allocation)
(rule ((SameBacking value e) (ValueRef e source) (= storage (Backing source)))
      ((set (Backing value) storage)) :ruleset allocation)
(rule ((SameBacking value e) (ValueRef e source) (Materialize value))
      ((Materialize source)) :ruleset allocation)
(rule ((SameBacking value e) (ValueRef e (Source source)))
      ((set (Backing value) (Source source))) :ruleset allocation)
(rule ((= value (Backing value)) (FreshValue value) (CapacityExtent value n))
      ((Allocation value n)) :ruleset allocation)

; Capacity describes allocation, while LiveLength describes the usable view.
(rule ((ScalarValue op))
      ((ResultSlot op 0)
       (CapacityExtent (Result op 0) (Fixed 1)) (FreshValue (Result op 0))
       (BufferSlot op "scalar" 0 (Result op 0))) :ruleset allocation)
(rule ((ArrayResult op i t) (InputDomain op n))
      ((ElementType (Result op i) t) (CapacityExtent (Result op i) n)
       (LiveLength (Result op i) n) (FreshValue (Result op i))) :ruleset allocation)
(rule ((TotalResult op i t))
      ((ElementType (Result op i) t) (CapacityExtent (Result op i) (Fixed 1))
       (LiveLength (Result op i) (Fixed 1)) (FreshValue (Result op i))) :ruleset allocation)
(rule ((FilterResult op t) (InputDomain op n))
      ((ElementType (Result op 0) t) (CapacityExtent (Result op 0) n)
       (LiveLength (Result op 0) (Stored (Result op 1)))
       (CapacityExtent (Result op 1) (Fixed 1)) (LiveLength (Result op 1) (Fixed 1))
       (FreshValue (Result op 0)) (FreshValue (Result op 1))) :ruleset allocation)
(rule ((FilterResult op t) (CounterType count))
      ((ElementType (Result op 1) count)) :ruleset allocation)
; Bucket updates retain the destination; counts and overflow are fresh outputs.
(rule ((= (Plan op) (Buckets)) (Phase (Stage op "clear") r)
       (= counts (Backing (Result op 1))) (= overflow (Backing (Result op 2))))
      ((set (Access (Stage op "clear") counts) 2) (set (Access (Stage op "clear") overflow) 2)) :ruleset allocation)
(rule ((BucketResult op destination) (CounterType count))
      ((ElementType (Result op 1) count) (ElementType (Result op 2) count)
       (CapacityExtent (Result op 1) (Length destination)) (LiveLength (Result op 1) (Length destination))
       (CapacityExtent (Result op 2) (Fixed 1)) (LiveLength (Result op 2) (Fixed 1))
       (FreshValue (Result op 1)) (FreshValue (Result op 2))) :ruleset allocation)
(rule ((UpdatedResult op i source))
      ((SameBacking (Result op i) source)) :ruleset allocation)
; Value destinations receive independent storage with the destination's shape,
; not the number of updates. The ordered kernel initializes it before writing.
(rule ((InitializedResult op i t n))
      ((ElementType (Result op i) t) (CapacityExtent (Result op i) n)
       (LiveLength (Result op i) n) (FreshValue (Result op i))
       (BufferSlot op "output" i (Result op i))) :ruleset allocation)
(rule ((InitializedResult op i t n) (Produces stage (Result op i)))
      ((Materialize (Result op i))) :ruleset allocation)
(rule ((UpdatedResult op i source) (ValueRef source old) (Produces stage (Result op i)))
      ((Clobbers stage old)) :ruleset allocation)

; Returning or reading a compacted view also requires its stored live length.
(rule ((Materialize value) (LiveLength value (Stored count)))
      ((Materialize count)) :ruleset allocation)
(rule ((Needs stage value) (LiveLength value (Stored count)))
      ((Needs stage count)) :ruleset allocation)
(rule ((Needs stage value) (= storage (Backing value)))
      ((set (Access stage storage) 1)) :ruleset allocation)
(rule ((Produces stage value) (= storage (Backing value)))
      ((set (Access stage storage) 2)) :ruleset allocation)

; Kernel emission looks up these slots; only Allocation facts create storage.
(rule ((ReturnScalar output t))
      ((ElementType (Output output) t) (CapacityExtent (Output output) (Fixed 1))
       (FreshValue (Output output)) (Materialize (Output output))
       (OutputBacking output (Output output)) (CopyOutput output)) :ruleset allocation)
(rule ((ReturnArray output e)) ((set (OutputHasBacking output) false)) :ruleset allocation)
(rule ((OutputBacking output storage)) ((set (OutputHasBacking output) true)) :ruleset allocation)
; Run after residency/allocation settles: array literals and other computed
; results need their own publication buffer only when no backing already exists.
(rule ((ReturnedArrayLayout output t n) (= (OutputHasBacking output) false))
      ((ElementType (Output output) t) (CapacityExtent (Output output) n)
       (FreshValue (Output output)) (Materialize (Output output))
       (OutputBacking output (Output output)) (CopyOutput output)) :ruleset materialize-outputs)
(rule ((ReturnArray output e) (ValueRef e value) (= storage (Backing value)))
      ((OutputBacking output storage)) :ruleset allocation)
(rule ((ReturnArray output e) (ValueRef e (Source source)))
      ((set (Backing (Source source)) (Source source)) (OutputBacking output (Source source))) :ruleset allocation)
(rule ((TotalResult op i t)) ((BufferSlot op "total" i (Result op i))) :ruleset allocation)
(rule ((ArrayResult op i t) (TotalCount op n))
      ((BufferSlot op "output" (- i n) (Result op i))) :ruleset allocation)
(rule ((FilterResult op t))
      ((BufferSlot op "output" 0 (Result op 0)) (BufferSlot op "length" 0 (Result op 1))) :ruleset allocation)
(rule ((BucketResult op e))
      ((BufferSlot op "counts" 0 (Result op 1)) (BufferSlot op "overflow" 0 (Result op 2))) :ruleset allocation)
(rule ((Scratch op name i n))
      ((BufferSlot op name i (Temporary op name i))) :ruleset allocation)

; Resolve interfaces using logical resource identities; bindings are numbered only at readout.
(rule ((Allocation value n) (ElementType value t) (TypeStride t stride))
      ((AbiStorage (AbiResource value) (ResourceBinding value) stride)
       (AbiCapacity value (AbiExtent n) stride)) :ruleset abi)
(rule ((= storage (Backing value))) ((AbiStorageAlias (AbiResource value) (AbiResource storage))) :ruleset abi)
(rule ((= value (AbiResource (Source (ExprId e))))) ((AbiAlias value (AbiExpr e))) :ruleset abi)
(rule ((LiveLength value n)) ((AbiArrayLength (AbiResource value) (AbiExtent n))) :ruleset abi)
(rule ((CapacityExtent value n)) ((AbiArrayBound (AbiResource value) (AbiExtent n))) :ruleset abi)
(rule ((SameBacking value (ExprId e))) ((AbiAlias (AbiResource value) (AbiExpr e))) :ruleset abi)
(rule ((ValueRef (ExprId e) value)) ((AbiStorageAlias (AbiExpr e) (AbiResource value))) :ruleset abi)
(rule ((DirectResult (ExprId e) op i)) ((AbiAlias (AbiExpr e) (AbiResource (Result op i)))) :ruleset abi)
(rule ((ResultTuple (ExprId e) op) (ResultSlot op i))
      ((AbiFieldValue (AbiExpr e) i (AbiResource (Result op i)))
       (AbiChild (AbiExpr e) (AbiResource (Result op i)))) :ruleset abi)
(rule ((ResultTuple (ExprId e) op) (Operand op role (ExprId child)))
      ((AbiChild (AbiExpr e) (AbiExpr child))) :ruleset abi)
(rule ((DirectResult (ExprId e) op i) (Operand op role (ExprId child)))
      ((AbiChild (AbiExpr e) (AbiExpr child))) :ruleset abi)
(rule ((ForwardValue (ExprId e) (ExprId source))) ((AbiAlias (AbiExpr e) (AbiExpr source))) :ruleset abi)
(rule ((ChildValue (ExprId e) (ExprId child))) ((AbiChild (AbiExpr e) (AbiExpr child))) :ruleset abi)
(rule ((FieldValue (ExprId e) i (ExprId field))) ((AbiFieldValue (AbiExpr e) i (AbiExpr field))) :ruleset abi)
(rule ((Projection (ExprId e) (ExprId tuple) i)) ((AbiAlias (AbiExpr e) (AbiField (AbiExpr tuple) i)) (AbiChild (AbiExpr e) (AbiExpr tuple))) :ruleset abi)
(rule ((SliceView (ExprId e) (ExprId source) (ExprId start) (ExprId end)))
      ((AbiStorageAlias (AbiExpr e) (AbiExpr source))
       (AbiArrayLength (AbiExpr e) (AbiBinary "sub" (AbiExpr end) (AbiExpr start)))
       (AbiArrayBound (AbiExpr e) (AbiLength (AbiExpr source)))) :ruleset abi)

; Extents stay in the planning graph through physical-interface publication.
(rule ((= v (AbiExtent n))) ((set (AbiBoundKnown v) false)) :ruleset abi)
(rule ((= v (AbiExtent (Fixed n)))) ((AbiAlias v (AbiNumber n))) :ruleset abi)
(rule ((= v (AbiExtent (Length (ExprId e))))) ((AbiAlias v (AbiLength (AbiExpr e)))) :ruleset abi)
(rule ((= v (AbiExtent (Scalar (ExprId e))))) ((AbiAlias v (AbiExpr e))) :ruleset abi)
(rule ((= v (AbiExtent (Stored value)))) ((AbiChild v (AbiResource value))) :ruleset abi)
(rule ((FilterResult op t) (InputDomain op n))
      ((AbiBound (AbiExtent (Stored (Result op 1))) (AbiExtent n))) :ruleset abi)
(rule ((= v (AbiExtent (ChunkCount n width))))
      ((AbiAlias v (AbiBinary "ceil_div" (AbiExtent n) (AbiNumber width)))
       (AbiBound v (AbiExtent n))) :ruleset abi)
(rule ((= v (AbiExtent (Product a b))))
      ((AbiAlias v (AbiBinary "mul" (AbiExtent a) (AbiExtent b)))) :ruleset abi)

; Alias and size information is shared by every capacity using that value.
(rule ((= v (AbiNumber n))) ((set (AbiConstant v) n)) :ruleset abi)
(rule ((AbiAlias a b) (= n (AbiConstant b))) ((set (AbiConstant a) n)) :ruleset abi)
(rule ((AbiAlias a b) (AbiStorage b binding stride))
      ((AbiStorage a binding stride)) :ruleset abi)
(rule ((AbiAlias a b) (AbiArrayLength b n)) ((AbiArrayLength a n)) :ruleset abi)
(rule ((AbiAlias a b) (AbiArrayBound b n)) ((AbiArrayBound a n)) :ruleset abi)
(rule ((AbiAlias a b) (AbiFieldValue b i field)) ((AbiFieldValue a i field)) :ruleset abi)
(rule ((= v (AbiField a i)) (AbiFieldValue a i field)) ((AbiAlias v field)) :ruleset abi)
(rule ((= v (AbiLength a)) (AbiArrayLength a n)) ((AbiAlias v n)) :ruleset abi)
(rule ((= v (AbiLength a)) (AbiAlias a b)) ((AbiAlias v (AbiLength b))) :ruleset abi)
(rule ((= v (AbiLength a)) (AbiArrayBound a n)) ((AbiBound v n)) :ruleset abi)
(rule ((= n (AbiConstant v))) ((set (AbiBoundConstant v) n)) :ruleset abi)
(rule ((AbiAlias a b)) ((AbiBound a b)) :ruleset abi)
(rule ((AbiBound a b) (= n (AbiBoundConstant b))) ((set (AbiBoundConstant a) n)) :ruleset abi)
(rule ((= n (AbiBoundConstant v))) ((set (AbiBoundKnown v) true)) :ruleset abi)
(rule ((= v (AbiBufferLength binding stride))) ((AbiBoundInput v binding stride)) :ruleset abi)
(rule ((AbiBound a b) (AbiBoundInput b binding stride)) ((AbiBoundInput a binding stride)) :ruleset abi)
(rule ((AbiBound a b) (AbiParameterCount b offset)) ((AbiParameterCount a offset)) :ruleset abi)
(rule ((AbiBound a b)) ((AbiChild a b)) :ruleset abi)
; A branch result inherits only bounds valid for both arms. It is not an alias
; of either arm, and unequal fixed bounds require their maximum.
(rule ((= length (AbiLength v)) (AbiChoice v a b))
      ((AbiChoice length (AbiLength a) (AbiLength b))) :ruleset abi)
(rule ((= field (AbiField v i)) (AbiChoice v a b))
      ((AbiChoice field (AbiField a i) (AbiField b i))) :ruleset abi)
(rule ((AbiChoice v a b) (= x (AbiBoundConstant a)) (= y (AbiBoundConstant b)))
      ((set (AbiBoundConstant v) (max x y))) :ruleset abi)
(rule ((AbiChoice v a b) (AbiBoundInput a binding stride) (AbiBoundInput b binding stride))
      ((AbiBoundInput v binding stride)) :ruleset abi)
(rule ((AbiChoice v a b) (AbiParameterCount a offset) (AbiParameterCount b offset))
      ((AbiParameterCount v offset)) :ruleset abi)
(rule ((= v (AbiLength a))) ((AbiChild v a)) :ruleset abi)
(rule ((= v (AbiBinary op a b))) ((AbiChild v a) (AbiChild v b)) :ruleset abi)
; Sizes use nonnegative, checked arithmetic, independently of scalar wraparound.
(rule ((= v (AbiBinary "mul" a b)) (= x (AbiConstant a)) (= y (AbiConstant b))
       (>= x 0) (> y 0) (<= x (/ 4294967295 y)))
      ((set (AbiConstant v) (* x y))) :ruleset abi)
(rule ((= v (AbiBinary "mul" a b)) (= 0 (AbiConstant b))) ((set (AbiConstant v) 0)) :ruleset abi)
(rule ((= v (AbiBinary "mul" a b)) (= 1 (AbiConstant a))) ((AbiAlias v b)) :ruleset abi)
(rule ((= v (AbiBinary "mul" a b)) (= 1 (AbiConstant b))) ((AbiAlias v a)) :ruleset abi)
(rule ((= v (AbiBinary "mul" a b)) (AbiBoundInput a binding stride)
       (= factor (AbiConstant b)) (> factor 0) (= 0 (% stride factor)))
      ((AbiBoundInput v binding (/ stride factor))) :ruleset abi)
(rule ((= v (AbiBinary "sub" a b)) (= x (AbiConstant a)) (= y (AbiConstant b)) (>= x y))
      ((set (AbiConstant v) (- x y))) :ruleset abi)
(rule ((= v (AbiBinary "ceil_div" a b)) (= x (AbiConstant a)) (= y (AbiConstant b)) (> y 0))
      ((set (AbiConstant v) (+ (/ x y) (min 1 (% x y))))) :ruleset abi)
(rule ((= v (AbiBinary "max" a b)) (= x (AbiConstant a)) (= y (AbiConstant b)))
      ((set (AbiConstant v) (max x y))) :ruleset abi)
; Traverse only capacity dependencies, not the expression-by-buffer product.
(rule ((AbiCapacity buffer n stride)) ((AbiCapacityNeed buffer n)) :ruleset abi)
(rule ((AbiCapacityNeed buffer v) (AbiChild v child)) ((AbiCapacityNeed buffer child)) :ruleset abi)
(rule ((AbiCapacityNeed buffer v) (AbiHostInput v input)) ((AbiCapacityInput buffer input)) :ruleset abi)
(rule ((AbiStorage (AbiResource buffer) binding stride)) ((AbiBufferBinding buffer binding)) :ruleset abi)
(rule ((LocalBuffer op name i t n)) ((AbiLocalCapacity op name i (AbiExtent n))) :ruleset abi)
(rule ((AbiLocalCapacity op name i n) (= size (AbiBoundConstant n)))
      ((AbiLocalLength op name i (max 1 size))) :ruleset abi)
; Resolve source binding constraints through the completed logical allocation.
(rule ((AbiOutputBinding output set binding) (OutputBacking output buffer))
      ((AbiPinnedBinding buffer set binding output)) :ruleset abi)
(rule ((AbiPinnedBinding buffer set binding output) (Allocation buffer n))
      ((union (ResourceBinding buffer) (InputBinding set binding))) :ruleset abi)
(rule ((AbiCapacity buffer n stride) (= count (AbiBoundConstant n)) (> stride 0)
       (<= count (/ 9223372036854775807 stride)))
      ((set (BufferCapacity buffer) (FixedCapacity (* (max 1 count) stride)))) :ruleset abi-final)
; A runtime-array binding needs storage for at least one element even when its
; logical length is zero. Keep the live extent and dispatch domain unchanged.
(rule ((AbiCapacity buffer n stride))
      ((AbiAllocationBytes buffer (AbiBinary "mul" (AbiBinary "max" n (AbiNumber 1)) (AbiNumber stride)))) :ruleset abi)
(rule ((AbiCapacity buffer n stride) (= (AbiBoundKnown n) false) (AbiBoundInput n binding source-stride))
      ((set (BufferCapacity buffer) (InputCapacity binding stride source-stride))) :ruleset abi-final)
; SameAsDispatch is valid only when each launched invocation owns at most one
; output element. Explicit grids and chunked writers cannot size larger outputs.
(rule ((AbiCapacity buffer (AbiExtent domain) stride) (Produces stage buffer)
       (PhaseDomain stage domain width) (AbiGridDomain stage n launch-width)
       (= (AbiBoundKnown (AbiExtent domain)) false) (AbiParameterCount n offset))
      ((set (BufferCapacity buffer) (DispatchCapacity stride))) :ruleset abi-final)
(rule ((AbiCapacity buffer n stride)) ((set (AbiCapacityResolved buffer) false)) :ruleset abi-final)
(rule ((= capacity (BufferCapacity buffer))) ((set (AbiCapacityResolved buffer) true)) :ruleset abi-final)
(rule ((AbiCapacity buffer n stride) (= (AbiCapacityResolved buffer) false) (AbiCapacityInput buffer input))
      ((set (BufferCapacity buffer) (HostCapacity stride)) (AbiHostCapacityInput buffer input)) :ruleset readout)

(rule ((AbiStorageAlias a b) (AbiStorage b binding stride)) ((AbiStorage a binding stride)) :ruleset abi)
(rule ((AbiStorageAlias a b)) ((AbiChild a b)) :ruleset abi)
; Follow only shader-root dependencies when publishing resource reads.
(rule ((AbiRootNeed root value) (AbiChild value child)) ((AbiRootNeed root child)) :ruleset abi)
(rule ((AbiRootNeed root value) (AbiStorage value binding stride))
      ((AbiRootStorage root binding)) :ruleset abi-final)
