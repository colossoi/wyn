; Backing identity is distinct from the version of a value stored there.
; Start with fresh storage and authored updates; optional storage reuse needs
; a separate, completed legality analysis before it can select alternatives.
(rule ((Materialize value) (FreshValue value)) ((Backing value value)) :ruleset allocation)
(rule ((Needs stage (Source e))) ((Backing (Source e) (Source e))) :ruleset allocation)
(rule ((Requires (InOperation op) (Source e))) ((Backing (Source e) (Source e))) :ruleset allocation)
(rule ((Escapes r (Source e))) ((Backing (Source e) (Source e))) :ruleset allocation)
(rule ((SameBacking value e) (ValueRef e source) (Backing source storage))
      ((Backing value storage)) :ruleset allocation)
(rule ((SameBacking value e) (ValueRef e source) (Materialize value))
      ((Materialize source)) :ruleset allocation)
(rule ((SameBacking value e) (ValueRef e (Source source)))
      ((Backing value (Source source))) :ruleset allocation)
(rule ((Backing value value) (FreshValue value) (Capacity value n))
      ((Allocation value n)) :ruleset allocation)

; Capacity describes allocation, while LiveLength describes the usable view.
(rule ((ScalarValue op t))
      ((ResultSlot op 0) (ElementType (Result op 0) t)
       (Capacity (Result op 0) (Fixed 1)) (FreshValue (Result op 0))
       (BufferSlot op "scalar" 0 (Result op 0))) :ruleset allocation)
(rule ((ArrayResult op i t) (InputDomain op n))
      ((ElementType (Result op i) t) (Capacity (Result op i) n)
       (LiveLength (Result op i) n) (FreshValue (Result op i))) :ruleset allocation)
(rule ((TotalResult op i t))
      ((ElementType (Result op i) t) (Capacity (Result op i) (Fixed 1))
       (LiveLength (Result op i) (Fixed 1)) (FreshValue (Result op i))) :ruleset allocation)
(rule ((FilterResult op t) (InputDomain op n))
      ((ElementType (Result op 0) t) (Capacity (Result op 0) n)
       (LiveLength (Result op 0) (Stored (Result op 1)))
       (Capacity (Result op 1) (Fixed 1)) (LiveLength (Result op 1) (Fixed 1))
       (FreshValue (Result op 0)) (FreshValue (Result op 1))) :ruleset allocation)
(rule ((FilterResult op t) (CounterType count))
      ((ElementType (Result op 1) count)) :ruleset allocation)
(rule ((Plan op (Compact)) (Scratch op name i n) (CounterType count))
      ((ElementType (Temporary op name i) count)) :ruleset allocation)
; Bucket updates retain the destination; counts and overflow are fresh outputs.
(rule ((BucketResult op destination) (CounterType count))
      ((ElementType (Result op 1) count) (ElementType (Result op 2) count)
       (Capacity (Result op 1) (Length destination)) (LiveLength (Result op 1) (Length destination))
       (Capacity (Result op 2) (Fixed 1)) (LiveLength (Result op 2) (Fixed 1))
       (FreshValue (Result op 1)) (FreshValue (Result op 2))) :ruleset allocation)
(rule ((UpdatedResult op i source))
      ((SameBacking (Result op i) source)) :ruleset allocation)
(rule ((UpdatedResult op i source) (ValueRef source old) (Produces stage (Result op i)))
      ((Clobbers stage old)) :ruleset allocation)

; Returning or reading a compacted view also requires its stored live length.
(rule ((Materialize value) (LiveLength value (Stored count)))
      ((Materialize count)) :ruleset allocation)
(rule ((Needs stage value) (LiveLength value (Stored count)))
      ((Needs stage count)) :ruleset allocation)
(rule ((Needs stage value) (Backing value storage))
      ((Access stage storage "read")) :ruleset allocation)
(rule ((Produces stage value) (Backing value storage))
      ((Access stage storage "write")) :ruleset allocation)

; Kernel emission looks up these slots; only Allocation facts create storage.
(rule ((ReturnScalar output e t))
      ((ElementType (Output output) t) (Capacity (Output output) (Fixed 1))
       (FreshValue (Output output)) (Materialize (Output output))
       (OutputBacking output (Output output))) :ruleset allocation)
(rule ((ReturnArray output e) (ValueRef e value) (Backing value storage))
      ((OutputBacking output storage)) :ruleset allocation)
(rule ((ReturnArray output e) (ValueRef e (Source source)))
      ((Backing (Source source) (Source source)) (OutputBacking output (Source source))) :ruleset allocation)
(rule ((TotalResult op i t)) ((BufferSlot op "total" i (Result op i))) :ruleset allocation)
(rule ((ArrayResult op i t) (TotalCount op n))
      ((BufferSlot op "output" (- i n) (Result op i))) :ruleset allocation)
(rule ((FilterResult op t))
      ((BufferSlot op "output" 0 (Result op 0)) (BufferSlot op "length" 0 (Result op 1))) :ruleset allocation)
(rule ((BucketResult op e))
      ((BufferSlot op "counts" 0 (Result op 1)) (BufferSlot op "overflow" 0 (Result op 2))) :ruleset allocation)
(rule ((Scratch op name i n))
      ((BufferSlot op name i (Temporary op name i))) :ruleset allocation)
