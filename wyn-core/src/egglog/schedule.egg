; Select an execution recipe from collective structure and sidecar effect proofs.
; No scalar expressions or lambda implementation enter this pass.
(datatype AtomicUpdate (AtomicAdd) (AtomicAnd) (AtomicOr) (AtomicXor) (AtomicCas))
(datatype Recipe (Elements) (Totals) (Prefixes) (Compact) (Serial) (Atomic AtomicUpdate) (Buckets))
; Only the presence of scans and reductions determines the recipe.
(relation CollectiveShape (OperationKey bool bool))
(relation FilterShape (OperationKey))
(relation IndexedWrite (OperationKey))
(relation IndexedReducer (OperationKey bool AtomicUpdate))
(relation BucketShape (OperationKey bool))
(function Plan (OperationKey) Recipe :no-merge)
; Parallel callbacks may read arrays and contain control flow. They must not
; write shared state or call unknown effects. This is weaker than movability.
(relation ParallelEffect (OperationKey))
(function ParallelSafe (OperationKey) bool :merge (and old new))
(function ParallelBodySafe (OperationKey) bool :merge (and old new))
(rule ((Site op r)) ((set (ParallelSafe op) true) (set (ParallelBodySafe op) true)) :ruleset structure)
(rule ((ParallelEffect op)) ((set (ParallelSafe op) false)) :ruleset structure)
(rule ((Enters op r) (Site child r) (= (ParallelSafe child) false))
      ((set (ParallelSafe op) false) (set (ParallelBodySafe op) false)) :ruleset structure)
(rule ((Callback op r) (Site child r) (= (ParallelSafe child) false))
      ((set (ParallelSafe op) false) (set (ParallelBodySafe op) false)) :ruleset structure)
(ruleset schedule)
(rule ((CollectiveShape op false false) (= (ParallelBodySafe op) true)) ((set (Plan op) (Elements))) :ruleset schedule)
(rule ((CollectiveShape op false true) (= (ParallelBodySafe op) true)) ((set (Plan op) (Totals))) :ruleset schedule)
(rule ((CollectiveShape op true reductions) (= (ParallelBodySafe op) true)) ((set (Plan op) (Prefixes))) :ruleset schedule)
(rule ((CollectiveShape op scans reductions) (= (ParallelBodySafe op) false)) ((set (Plan op) (Serial))) :ruleset schedule)
(rule ((FilterShape op) (= (ParallelBodySafe op) true)) ((set (Plan op) (Compact))) :ruleset schedule)
(rule ((FilterShape op) (= (ParallelBodySafe op) false)) ((set (Plan op) (Serial))) :ruleset schedule)
; Preserve ordering for potentially colliding writes until atomic/disjointness
; proofs are available. A single-invocation kernel implements the serial loop.
(rule ((IndexedWrite op)) ((set (Plan op) (Serial))) :ruleset schedule)
(rule ((IndexedReducer op false kind)) ((set (Plan op) (Serial))) :ruleset schedule)
(rule ((IndexedReducer op true kind) (= (ParallelBodySafe op) false)) ((set (Plan op) (Serial))) :ruleset schedule)
(rule ((IndexedReducer op true update) (= (ParallelBodySafe op) true)) ((set (Plan op) (Atomic update))) :ruleset schedule)
(rule ((BucketShape op true) (= (ParallelBodySafe op) true)) ((set (Plan op) (Buckets))) :ruleset schedule)
(rule ((BucketShape op true) (= (ParallelBodySafe op) false)) ((set (Plan op) (Serial))) :ruleset schedule)
(rule ((BucketShape op false)) ((set (Plan op) (Serial))) :ruleset schedule)

; Recipes declare logical phases before any kernel body is built. Widths match
; the current emitters; PhaseDomain counts invocations, not rounded workgroups.
(relation KernelPhase (OperationKey String Extent i64))
(relation PhaseEnds (OperationKey String String))
(relation PhaseLink (OperationKey String String))
; A scalar execution crossing dispatches runs once and publishes its value.
; Its called regions belong to that invocation, not the host launch graph.
(rule ((ScalarValue op t) (Site op r) (SplitRegion r))
      ((KernelPhase op "scalar" (Fixed 1) 1) (PhaseEnds op "scalar" "scalar")) :ruleset schedule)
(rule ((ScalarValue op t) (Phase (Stage op "scalar") r))
      ((Produces (Stage op "scalar") (Result op 0))) :ruleset schedule)
(rule ((= (Plan op) (Elements)) (InputDomain op n))
      ((KernelPhase op "elements" n 64) (PhaseEnds op "elements" "elements")) :ruleset schedule)
(rule ((= (Plan op) (Totals)) (InputDomain op n))
      ((KernelPhase op "chunks" (ChunkCount n 64) 64)
       (KernelPhase op "combine" (Fixed 256) 256) (PhaseEnds op "chunks" "combine")
       (PhaseLink op "chunks" "combine")) :ruleset schedule)
(rule ((= (Plan op) (Prefixes)) (InputDomain op n))
      ((KernelPhase op "chunks" (ChunkCount n 64) 64)
       (KernelPhase op "combine" (Fixed 1) 1) (KernelPhase op "offsets" n 64)
       (PhaseEnds op "chunks" "offsets") (PhaseLink op "chunks" "combine")
       (PhaseLink op "combine" "offsets")) :ruleset schedule)
(rule ((= (Plan op) (Compact)) (InputDomain op n))
      ((KernelPhase op "flags" n 64) (KernelPhase op "local_offsets" n 64)
       (KernelPhase op "offsets" (Fixed 1) 1) (KernelPhase op "compact" n 64)
       (PhaseEnds op "flags" "compact") (PhaseLink op "flags" "local_offsets")
       (PhaseLink op "local_offsets" "offsets") (PhaseLink op "offsets" "compact")) :ruleset schedule)
(rule ((= (Plan op) (Serial)))
      ((KernelPhase op "ordered" (Fixed 1) 1) (PhaseEnds op "ordered" "ordered")) :ruleset schedule)
(rule ((= (Plan op) (Atomic update)) (InputDomain op n))
      ((KernelPhase op "atomic" n 64) (PhaseEnds op "atomic" "atomic")) :ruleset schedule)
; Counts are cleared in a completed dispatch before any invocation reserves a slot.
(rule ((= (Plan op) (Buckets)) (InputDomain op n) (BucketResult op dest))
      ((KernelPhase op "clear" (Length dest) 64) (KernelPhase op "buckets" n 64)
       (PhaseEnds op "clear" "buckets") (PhaseLink op "clear" "buckets")) :ruleset schedule)
(rule ((= (Plan op) (Buckets)) (Phase (Stage op "buckets") r))
      ((PhaseInput (Stage op "buckets") op "input")
       (Materialize (Result op 1)) (Materialize (Result op 2))) :ruleset schedule)
(rule ((KernelPhase op name n width) (Site op r) (HostRegion r))
      ((Phase (Stage op name) r) (PhaseDomain (Stage op name) n width)
       (PhaseInput (Stage op name) op "environment")) :ruleset schedule)
(rule ((PhaseEnds op first last) (Phase (Stage op first) r) (Phase (Stage op last) r))
      ((FirstPhase op (Stage op first)) (LastPhase op (Stage op last))) :ruleset schedule)
(rule ((PhaseLink op a b) (Phase (Stage op a) r) (Phase (Stage op b) r))
      ((Before (Stage op a) (Stage op b))) :ruleset schedule)
(rule ((FirstPhase op first)) ((PhaseInput first op "input")) :ruleset schedule)
(rule ((Phase (Stage op "compact") r)) ((PhaseInput (Stage op "compact") op "input")) :ruleset schedule)

; Record the phase that actually writes each result, not just the recipe's last phase.
(rule ((= (Plan op) (Elements)) (ArrayResult op i t) (Phase (Stage op "elements") r))
      ((Produces (Stage op "elements") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Totals)) (ArrayResult op i t) (Phase (Stage op "chunks") r))
      ((Produces (Stage op "chunks") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Prefixes)) (ArrayResult op i t) (Phase (Stage op "offsets") r))
      ((Produces (Stage op "offsets") (Result op i))) :ruleset schedule)
(rule ((TotalResult op i t) (Phase (Stage op "combine") r))
      ((Produces (Stage op "combine") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Serial)) (ResultSlot op i) (Phase (Stage op "ordered") r))
      ((Produces (Stage op "ordered") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Atomic update)) (ResultSlot op i) (Phase (Stage op "atomic") r))
      ((Produces (Stage op "atomic") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Buckets)) (ResultSlot op i) (Phase (Stage op "buckets") r))
      ((Produces (Stage op "buckets") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Compact)) (Phase (Stage op "compact") r))
      ((Produces (Stage op "compact") (Result op 0))
       (Produces (Stage op "offsets") (Result op 1))) :ruleset schedule)

; Scratch is a recipe result with ordinary producers, consumers, and capacity.
(relation Scratch (OperationKey String i64 Extent))
(rule ((Accumulator op i t) (InputDomain op n) (Phase (Stage op "chunks") r))
      ((Scratch op "partial" i (ChunkCount n 64))
       (ElementType (Temporary op "partial" i) t)
       (Produces (Stage op "chunks") (Temporary op "partial" i))
       (Needs (Stage op "combine") (Temporary op "partial" i))) :ruleset schedule)
(rule ((ScanComponent op i t) (InputDomain op n) (Phase (Stage op "offsets") r))
      ((Scratch op "prefix" i n) (Scratch op "offset" i (ChunkCount n 64))
       (ElementType (Temporary op "prefix" i) t) (ElementType (Temporary op "offset" i) t)
       (Produces (Stage op "chunks") (Temporary op "prefix" i))
       (Produces (Stage op "combine") (Temporary op "offset" i))
       (Needs (Stage op "offsets") (Temporary op "prefix" i))
       (Needs (Stage op "offsets") (Temporary op "offset" i))) :ruleset schedule)
(rule ((MappedComponent op i t) (= (Plan op) (Prefixes)) (InputDomain op n)
       (Phase (Stage op "chunks") r))
      ((Scratch op "mapped" i n) (ElementType (Temporary op "mapped" i) t)
       (Produces (Stage op "chunks") (Temporary op "mapped" i))
       (Needs (Stage op "offsets") (Temporary op "mapped" i))) :ruleset schedule)
(rule ((= (Plan op) (Compact)) (InputDomain op n) (Phase (Stage op "flags") r))
      ((Scratch op "flags" 0 n) (Scratch op "local_offsets" 0 n)
       (Scratch op "totals" 0 (ChunkCount n 64)) (Scratch op "offsets" 0 (ChunkCount n 64))
       (Produces (Stage op "flags") (Temporary op "flags" 0))
       (Needs (Stage op "local_offsets") (Temporary op "flags" 0))
       (Needs (Stage op "compact") (Temporary op "flags" 0))
       (Produces (Stage op "local_offsets") (Temporary op "local_offsets" 0))
       (Needs (Stage op "compact") (Temporary op "local_offsets" 0))
       (Produces (Stage op "local_offsets") (Temporary op "totals" 0))
       (Needs (Stage op "offsets") (Temporary op "totals" 0))
       (Produces (Stage op "offsets") (Temporary op "offsets" 0))
       (Needs (Stage op "compact") (Temporary op "offsets" 0))) :ruleset schedule)
(rule ((Scratch op name i n))
      ((FreshValue (Temporary op name i)) (CapacityExtent (Temporary op name i) n)) :ruleset schedule)

; Invocation-local allocations are recipe outputs, without dispatches or shared storage.
(rule ((Site op r) (DeviceRegion r)) ((DeviceOperation op)) :ruleset schedule)
(rule ((DeviceOperation op) (Enters op r)) ((DeviceRegion r)) :ruleset schedule)
(rule ((Phase (Stage op "scalar") r)) ((DeviceOperation op)) :ruleset schedule)
(rule ((DeviceOperation op) (= recipe (Plan op)) (BufferSlot op name i value) (ElementType value t) (CapacityExtent value n))
      ((LocalBuffer op name i t n)) :ruleset schedule)
