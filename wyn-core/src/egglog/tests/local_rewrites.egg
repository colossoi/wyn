(let scalar (ScalarInfo (ScalarElement (I32))))
(let a (vec-of (BindValue (ValueId 0) scalar)))
(let b (vec-of (BindValue (ValueId 1) scalar)))
(let c (vec-of (BindValue (ValueId 2) scalar)))
(let first (DefineFunction (FunctionId 0 "first") (vec-of) (vec-of)
  (Block (vec-of
    (Let (StatementTag 0) a (vec-of) (Use (ValueOperand (LiteralBits (I32) 1))))
    (Let (StatementTag 1) b (vec-of) (Use (ValueOperand (LiteralBits (I32) 2))))) (vec-of))))
(let second (DefineFunction (FunctionId 1 "second") (vec-of) (vec-of)
  (Block (vec-of (Let (StatementTag 2) c (vec-of) (Use (ValueOperand (LiteralBits (I32) 3))))) (vec-of))))
(let untouched (DefineFunction (FunctionId 2 "untouched") (vec-of)
  (vec-of (ReturnScalar (ScalarElement (I32))))
  (Block (vec-of) (vec-of (Yield (vec-of) (ValueOperand (LiteralBits (I32) 42)))))))
(let program (MemoryProgram (vec-of first second untouched) (vec-of) (vec-of)))
(CurrentProgram program)
(set (LocalRewriteCandidates "simplify" program first) (set-of
  (set-of (ReplaceStatements (StatementTag 0) (vec-of
    (Let (StatementTag 0) a (vec-of) (Use (ValueOperand (LiteralBits (I32) 11)))))))
  (set-of (ReplaceStatements (StatementTag 1) (vec-of
    (Let (StatementTag 1) b (vec-of) (Use (ValueOperand (LiteralBits (I32) 12)))))))))
(set (LocalRewriteCandidates "simplify" program second) (set-of (set-of
  (ReplaceStatement (StatementTag 2)
    (Let (StatementTag 2) c (vec-of) (Use (ValueOperand (LiteralBits (I32) 22))))))))
(run-schedule (saturate memory-local-rewrites) (saturate memory-edits)
  (saturate memory-local-rewrite-select)
  (saturate memory-rewrite-simplify memory-rename)
  (saturate fusion-index memory-names))
(check (CurrentProgram current) (!= current program))
(check (CurrentProgram current) (ProgramFunction current untouched))
(check (CurrentProgram current) (ContainsStm (ProgramRoot current)
  (Let (StatementTag 2) c (vec-of) (Use (ValueOperand (LiteralBits (I32) 22))))))
; Either choice is legal in the first function, but applying both in one batch is not.
(relation ChangedFirst ())
(ruleset check-local-batch)
(rule ((CurrentProgram current) (ContainsStm (ProgramRoot current)
  (Let (StatementTag 0) a (vec-of) (Use (ValueOperand (LiteralBits (I32) 11))))))
  ((ChangedFirst)) :ruleset check-local-batch)
(rule ((CurrentProgram current) (ContainsStm (ProgramRoot current)
  (Let (StatementTag 1) b (vec-of) (Use (ValueOperand (LiteralBits (I32) 12))))))
  ((ChangedFirst)) :ruleset check-local-batch)
(run-schedule check-local-batch)
(check (ChangedFirst))
(fail (check (CurrentProgram current)
  (ContainsStm (ProgramRoot current) (Let (StatementTag 0) a (vec-of) (Use (ValueOperand (LiteralBits (I32) 11)))))
  (ContainsStm (ProgramRoot current) (Let (StatementTag 1) b (vec-of) (Use (ValueOperand (LiteralBits (I32) 12)))))))
