; One logical map nest, with an expensive scalar prefix supplied by the test.
(let scalar (ScalarInfo (ScalarElement (I32))))
(set (PrimitiveEffects "*" scalar) (set-empty))
(set (PrimitiveEffects "+" scalar) (set-empty))
(RepeatableOpcode "*")
(RepeatableOpcode "+")
(let item (ElementValue (ScalarElement (I32))))
(let row-type (ArrayType (ValueArray) (vec-of (FixedExtent 3)) item))
(let result-type (ArrayType (ValueArray) (vec-of (FixedExtent 8192)) row-type))
(let inner (Let (StatementTag 200) (vec-of (BindValue (ValueId 300) (LogicalValue row-type))) (vec-of)
  (Parallel (Unscheduled)
    (IterationSpace (ValueId 201) (vec-of (DenseAxis (ValueId 200) (IndexConstant 3))))
    (ParallelBlock
      (vec-of (Let (StatementTag 201) (vec-of (BindValue (ValueId 301) scalar)) (vec-of)
        (PrimOp "+" (vec-of (Var (ValueId 80)) (Var (ValueId 200))))))
      (vec-of (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ValueId 301)))))))))))
(let outer (Let (StatementTag 400) (vec-of (BindValue (ValueId 400) (LogicalValue result-type))) (vec-of)
  (Parallel (Unscheduled)
    (IterationSpace (ValueId 202) (vec-of (DenseAxis (ValueId 0) (IndexConstant 8192))))
    (ParallelBlock (vec-of PREFIX inner)
      (vec-of (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ValueId 300)))))))))))
(let function (DefineFunction (FunctionId 0 "cost") (vec-of) (vec-of (LogicalReturn result-type))
  (Block (vec-of outer) (vec-of (Yield (vec-of) (ValueOperand (Var (ValueId 400))))))))
(let program (MemoryProgram (vec-of function) (vec-of) (vec-of (EntryPoint (FunctionId 0 "cost") 0))))
(CurrentProgram program)
