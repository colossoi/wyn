(let scalar (ScalarInfo (ScalarElement (I32))))
(let predicate (LiteralBits (Bool) 1))
(let value (Yield (vec-of) (ValueOperand (LiteralBits (I32) 7))))
(let domain (IterationSpace (ValueId 0) (vec-of (DenseAxis (ValueId 1) (IndexConstant 4)))))
(let compact (Compact predicate (vec-of value)))
(let mixed (Let (StatementTag 0)
  (vec-of (BindValue (ValueId 2) scalar) (BindValue (ValueId 3) scalar)) (vec-of)
  (Parallel (Unscheduled) domain (ParallelBlock (vec-of) (vec-of (Collect (vec-of value)) compact)))))
(let retained (Let (StatementTag 1) (vec-of (BindValue (ValueId 4) scalar)) (vec-of)
  (Parallel (Unscheduled) domain (ParallelBlock (vec-of) (vec-of compact)))))
(let wide (Let (StatementTag 2)
  (vec-of (BindValue (ValueId 5) scalar) (BindValue (ValueId 6) scalar)) (vec-of)
  (Parallel (Unscheduled) domain
    (ParallelBlock (vec-of) (vec-of (Compact predicate (vec-of value value)))))))
(let function (DefineFunction (FunctionId 0 "bindings") (vec-of) (vec-of)
  (Block (vec-of mixed retained wide) (vec-of))))
(let program (MemoryProgram (vec-of function) (vec-of) (vec-of)))
(CurrentProgram program)
(ProgramFunction program function)
(ContainsFunction (FunctionRoot function) function)
(set (UsedNames function) (set-of (ValueNameRef (ValueId 2)) (ValueNameRef (ValueId 4))))
(run-schedule (saturate memory-names) (saturate memory-scopes)
  (saturate memory-origin)
  (saturate simplify-uses)
  (saturate simplify-result-analysis))
(check (CompactBinding mixed 1 (BindValue (ValueId 3) scalar) predicate))
(check (CompactBinding retained 0 (BindValue (ValueId 4) scalar) predicate))
(fail (check (CompactBinding mixed 0 (BindValue (ValueId 2) scalar) predicate)))
(fail (check (CompactBinding wide 0 (BindValue (ValueId 5) scalar) predicate)))
(check (= (FirstDeadCollection program mixed) 1))
(fail (check (= (FirstDeadCollection program retained) 0)))
(fail (check (= (FirstDeadCollection program wide) 0)))
