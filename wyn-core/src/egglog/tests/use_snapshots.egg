(let info (ScalarInfo (ScalarElement (I32))))
(let binding (BindValue (ValueId 44) info))
(let pattern (vec-of binding))
(let statement (Let (StatementTag 44) pattern (vec-of)
    (Use (ValueOperand (LiteralBits (I32) 7)))))
(let name (FunctionId 44 "uses"))
(let live (DefineFunction name (vec-of) (vec-of (ReturnScalar (ScalarElement (I32))))
    (Block (vec-of statement) (vec-of (Yield (vec-of) (ValueOperand (Var (ValueId 44))))))))
(let dead (DefineFunction name (vec-of) (vec-of) (Block (vec-of statement) (vec-of))))
(let a (MemoryProgram (vec-of live) (vec-of) (vec-of)))
(let b (MemoryProgram (vec-of dead) (vec-of) (vec-of)))
(CurrentProgram a)
(run-schedule (saturate fusion-index memory-names)
    (saturate memory-origin simplify-analysis) (saturate simplify-uses))
(fail (check (UnusedValue a live (ValueId 44))))
(fail (check (UnusedPattern a live pattern)))
(delete (CurrentProgram a)) (CurrentProgram b)
(run-schedule (saturate fusion-index memory-names)
    (saturate memory-origin simplify-analysis) (saturate simplify-uses))
(check (UnusedValue b dead (ValueId 44)))
(check (UnusedPattern b dead pattern))
(fail (check (UnusedValue b live (ValueId 44))))
