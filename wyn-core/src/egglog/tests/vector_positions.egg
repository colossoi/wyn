; Repeated expressions and multi-binding patterns must retain position identity.
(let pos-info (ScalarInfo (ScalarElement (I32))))
(let pos-expression (Use (ValueOperand (LiteralBits (I32) 7))))
(let pos-first (Let (StatementTag 9000)
    (vec-of (BindValue (ValueId 9000) pos-info) (BindValue (ValueId 9001) pos-info))
    (vec-of) pos-expression))
(let pos-second (Let (StatementTag 9001)
    (vec-of (BindValue (ValueId 9002) pos-info)) (vec-of) pos-expression))
(let pos-body (Block (vec-of pos-first pos-second) (vec-of)))
(run-schedule (saturate memory-names))
(check (= (StmsAt (vec-of pos-first pos-second) 0) pos-first))
(check (= (StmsAt (vec-of pos-first pos-second) 1) pos-second))
(check (SingleValueStatement pos-second (ValueId 9002) pos-info pos-expression))
(fail (check (SingleValueStatement pos-first (ValueId 9000) pos-info pos-expression)))
(fail (check (= (StmsAt (vec-of pos-first pos-second) 2) pos-first)))
(fail (check (= (StmsAt (vec-of pos-first pos-second) -1) pos-first)))
(check (= (PatternAt (vec-of (BindValue (ValueId 9000) pos-info)
                            (BindValue (ValueId 9001) pos-info)) 1)
          (BindValue (ValueId 9001) pos-info)))

; Domain analysis returns an index vector without putting it in a syntax node.
; The matching cursor must project this temporary vector itself.
(let pos-atoms (vec-of (Var (ValueId 9010)) (Var (ValueId 9011))))
(let pos-index-use (Index (ValueId 9012) pos-atoms))
(function PositionTestIndices () Indices :no-merge)
(set (PositionTestIndices) (vec-of (IndexValue (ValueId 9010)) (IndexValue (ValueId 9011))))
(let pos-indices (PositionTestIndices))
(MatchingIndices pos-atoms pos-indices 0)
(run-schedule (saturate memory-names fusion-forward))
(check (MatchingIndices pos-atoms pos-indices 2))

; Region application can also supply arguments without constructing a Call.
(let pos-parameter (Parameter (BindValue (ValueId 9020) pos-info) (Observe)))
(let pos-params (vec-of pos-parameter))
(let pos-lambda (FunctionBody pos-params (vec-of) pos-body))
(let pos-arguments (vec-of (Pass (ValueOperand (LiteralBits (I32) 8)) (Observe))))
(set (InlineParameters (StatementTag 9020) pos-params pos-arguments 0) (vec-of))
(run-schedule (saturate memory-names inline-select))
(check (= (InlineParameters (StatementTag 9020) pos-params pos-arguments 1)
    (vec-of (Let (CallParameter (StatementTag 9020) 0)
        (vec-of (BindValue (ValueId 9020) pos-info)) (vec-of)
        (Use (ValueOperand (LiteralBits (I32) 8)))))))
