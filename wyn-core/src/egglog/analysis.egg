; Source summaries settle before boundary-sensitive dependency queries run.
(ruleset source-summary)
(ruleset source-dependencies)
; Source identities are queried in either direction during scalar admission and
; final readout. Populate the shared inverse indexes with the source summaries.
(rule ((= value (SourceParameter region index)))
      ((set (SourceParameterRegion value) region) (set (SourceParameterIndex value) index)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op))) ((set (SourceValueOperation value) op)) :ruleset source-summary)
(function SourceRegionSpeculatable (RegionKey) bool :merge (and old new))
(function SourceRegionReadOnly (RegionKey) bool :merge (and old new))
(function SourceRegionRequiresDevice (RegionKey) bool :merge (or old new))
(function SourceRegionDuplicable (RegionKey) bool :merge (and old new))
(relation SourceEnters (SourceValue RegionKey))
; Value-preserving coercions and projections share identity without equating
; their execution occurrences. Lexical bindings are resolved during import.
(datatype SourceIdentity (Identity SourceValue))
(function SourceIdentityToken (SourceIdentity) i64 :merge (min old new))
(function SourceHasOrigin (SourceValue) bool :merge (or old new))
(relation SourceOrigin (SourceValue OperationKey))
(relation SourceDepends (OperationKey OperationKey OperandRole))
(relation SourceObserved (OperationKey))
(relation SourceReturnDependency (RegionKey OperationKey))
(rule ((SourceReturnDependency region op) (= (SourceOperation op) (OperationInfo region kind)))
      ((SourceObserved op)) :ruleset source-summary)
(function WorkOperationCheap (OperationKey) bool :merge (or old new))

(rule ((= value (SourceInput op i)) (= token (SourceOrdinal value))) ((set (SourceIdentityToken (Identity value)) token)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op))) ((SourceOrigin value op) (Identity value)) :ruleset source-summary)
(rule ((= target (SourceAlias value))) ((union (Identity value) (Identity target))) :ruleset source-summary)
(rule ((= target (SourceAlias value)) (SourceOrigin target op)) ((SourceOrigin value op)) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo tuple i)) (SourceOrigin tuple op)) ((SourceOrigin value op)) :ruleset source-summary)
(rule ((SourceOrigin value op)) ((set (SourceHasOrigin value) true)) :ruleset source-summary)
(rule ((= (SourceDefinition symbol) region)) ((set (SourceCallable (SourceGlobal symbol)) region)) :ruleset source-summary)
(rule ((= target (SourceAlias value)) (= (SourceCallable target) region)) ((set (SourceCallable value) region)) :ruleset source-summary)
(rule ((SourceClosureCode value code) (= (SourceCallable code) region)) ((set (SourceCallable value) region)) :ruleset source-summary)
(rule ((SourceApply value function) (= (SourceCallable function) region)) ((SourceEnters value region)) :ruleset source-summary)

(relation ImportedPosition (OperationKey i64))
(relation SourceNextOperation (OperationKey OperationKey))
(relation ImportedEffectOrder (OperationKey OperationKey))

(rule ((= value (SourceDestination op))) ((set (SourceStorage value) false)) :ruleset source-summary)
(rule ((= ty (SourceType value)) (SourceViewType ty)) ((set (SourceStorage value) true)) :ruleset source-summary)
(rule ((= target (SourceAlias value)) (= storage (SourceStorage target))) ((set (SourceStorage value) storage)) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo target i)) (= storage (SourceStorage target))) ((set (SourceStorage value) storage)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op)) (= destination (SourceDestination op)) (= storage (SourceStorage destination)))
      ((set (SourceStorage value) storage)) :ruleset source-summary)
(rule ((= source (SourceAlias value)) (SourceReusePermission source region))
      ((SourceReusePermission value region)) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo r kind)) (!= kind "bucket-scatter") (= count (SourceInputCount op)) (> count 0))
      ((set (SourceDomainRank op) 1) (SourceDomainInputAxis op 0 0)) :ruleset source-summary)
(rule ((= (SourceInputCount op) 0))
      ((set (SourceDomainRank op) 1) (set (SourceDomainAxis op 0) (Fixed 0))) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo r kind)) (!= kind "bucket-scatter") (= value (SourceInput op i)))
      ((set (SourceInputRank op i) 1) (set (SourceInputDimension op i 0) 0)) :ruleset source-summary)
(function SourceDomainPrefixExtent (OperationKey i64) Extent :no-merge)
(rule ((SourceDomainInputAxis op axis i) (= input (SourceInput op i)) (= n (SourceExtent input)))
      ((set (SourceDomainAxis op axis) n)) :ruleset source-summary)
(rule ((= n (SourceDomainAxis op 0))) ((set (SourceDomainPrefixExtent op 1) n)) :ruleset source-summary)
(rule ((= (SourceDomainPrefixExtent op axis) product) (= rank (SourceDomainRank op)) (< axis rank) (= n (SourceDomainAxis op axis)))
      ((set (SourceDomainPrefixExtent op (+ axis 1)) (Product product n))) :ruleset source-summary)
(rule ((= rank (SourceDomainRank op)) (= (SourceDomainPrefixExtent op rank) n))
      ((set (SourceDomainExtent op) n)) :ruleset source-summary)

; Backing equivalence is conservative and never equates value versions.
(datatype SourceBacking (BackingIdentity SourceValue))
(relation ScatterReadValue (OperationKey SourceValue))
; Only scatter's in-place safety check needs transitive input/capture reads.
(rule ((= (SourceOperation op) (OperationInfo region "scatter")) (= input (SourceInput op i)))
      ((ScatterReadValue op input)) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo region "scatter")) (= body (SourceOperatorBody op)) (= (SourceCapture body formal) actual))
      ((ScatterReadValue op actual)) :ruleset source-summary)
(rule ((ScatterReadValue op value) (SourceDirectUse value child))
      ((ScatterReadValue op child)) :ruleset source-summary)
(rule ((ScatterReadValue op value) (SourceNestedUse value child))
      ((ScatterReadValue op child)) :ruleset source-summary)
(rule ((ScatterReadValue op value)) ((BackingIdentity value)) :ruleset source-summary)
(rule ((= value (SourceDestination op))) ((BackingIdentity value)) :ruleset source-summary)
(rule ((= target (SourceAlias value))) ((union (BackingIdentity value) (BackingIdentity target))) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo target i))) ((union (BackingIdentity value) (BackingIdentity target))) :ruleset source-summary)
(rule ((= (SourceSlice value) (SliceInfo target start end))) ((union (BackingIdentity value) (BackingIdentity target))) :ruleset source-summary)
(rule ((= value (SourceOperationValue op)) (= destination (SourceDestination op)))
      ((union (BackingIdentity value) (BackingIdentity destination))) :ruleset source-summary)
(function SourceScratchValue (SourceValue) bool :merge (or old new))
(rule ((= value (SourceDestination op))) ((set (SourceScratchValue value) false)) :ruleset source-summary)
(rule ((SourceScratch value n)) ((set (SourceScratchValue value) true)) :ruleset source-summary)
(rule ((= target (SourceAlias value)) (= scratch (SourceScratchValue target))) ((set (SourceScratchValue value) scratch)) :ruleset source-summary)

(function SourceRegionWork (RegionKey) i64 :no-merge)
(relation SourceSummaryCalls (SourceValue SourceValue))
(relation SourceSummaryEnters (SourceValue RegionKey))
(relation SourceSummaryDeviceCalls (SourceValue SourceValue))
(relation SourceSummaryDeviceEnters (SourceValue RegionKey))
(relation SourceRegionCalls (RegionKey SourceValue))
(relation SourceRegionEnters (RegionKey RegionKey))
(relation SourceRegionDeviceCalls (RegionKey SourceValue))
(relation SourceRegionDeviceEnters (RegionKey RegionKey))
(relation SourceRegionDependency (RegionKey OperationKey))
; Read footprints are summarized during the TLC walk. A concrete binding may
; be reread only when no authored update or writable declaration can change it.
(relation SourceBinding (SourceValue i64 i64))
(relation SourceReadsBinding (SourceValue i64 i64))
(relation SourceRegionReadsBinding (RegionKey i64 i64))
(relation SourceMutableBinding (i64 i64))
(relation SourceUnknownWrite ())
(rule ((= source (SourceAlias value)) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo source i)) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((SourceField value i source) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((SourceArrayPart value i source) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((= (SourceSlice value) (SliceInfo source start end)) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((= value (SourceDestination op)) (SourceBinding value set binding))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceReusePermission value region) (SourceBinding value set binding))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op)) (= (SourceReadOnly value) false)
       (SourceOperand op input) (SourceBinding input set binding))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceReadsBinding value set binding) (SourceUnknownWrite))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceRegionReadsBinding region set binding) (SourceUnknownWrite))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceReadsBinding value set binding) (SourceMutableBinding set binding))
      ((set (SourceDuplicable value) false)) :ruleset source-summary)
(rule ((SourceRegionReadsBinding region set binding) (SourceMutableBinding set binding))
      ((set (SourceRegionDuplicable region) false)) :ruleset source-summary)
(rule ((SourceEnters value region) (= value (SourceOperationValue op)) (SourceRegionDependency region before) (!= op before))
      ((SourceDepends op before (Other))) :ruleset source-dependencies)
(rule ((SourceSummaryCalls owner function) (= (SourceCallable function) region))
      ((SourceSummaryEnters owner region)) :ruleset source-summary)
(rule ((SourceSummaryDeviceCalls owner function) (= (SourceCallable function) region))
      ((SourceSummaryDeviceEnters owner region)) :ruleset source-summary)
(rule ((SourceSummaryEnters owner region) (= (SourceRegionSpeculatable region) false))
      ((set (SourceSpeculatable owner) false)) :ruleset source-summary)
(rule ((SourceSummaryEnters owner region) (= (SourceRegionReadOnly region) false))
      ((set (SourceReadOnly owner) false)) :ruleset source-summary)
(rule ((SourceSummaryEnters owner region) (= (SourceRegionDuplicable region) false))
      ((set (SourceDuplicable owner) false)) :ruleset source-summary)
(rule ((SourceSummaryEnters owner region) (= (SourceRegionRequiresDevice region) true))
      ((set (SourceRequiresDevice owner) true)) :ruleset source-summary)
(rule ((SourceSummaryDeviceEnters owner region) (= (SourceRegionRequiresDevice region) true))
      ((set (SourceRequiresDevice owner) true)) :ruleset source-summary)
(rule ((SourceRegionCalls owner function) (= (SourceCallable function) region))
      ((SourceRegionEnters owner region)) :ruleset source-summary)
(rule ((SourceRegionDeviceCalls owner function) (= (SourceCallable function) region))
      ((SourceRegionDeviceEnters owner region)) :ruleset source-summary)
(rule ((SourceRegionEnters owner region) (= (SourceRegionSpeculatable region) false))
      ((set (SourceRegionSpeculatable owner) false)) :ruleset source-summary)
(rule ((SourceRegionEnters owner region) (= (SourceRegionReadOnly region) false))
      ((set (SourceRegionReadOnly owner) false)) :ruleset source-summary)
(rule ((SourceRegionEnters owner region) (= (SourceRegionDuplicable region) false))
      ((set (SourceRegionDuplicable owner) false)) :ruleset source-summary)
(rule ((SourceRegionEnters owner region) (= (SourceRegionRequiresDevice region) true))
      ((set (SourceRegionRequiresDevice owner) true)) :ruleset source-summary)
(rule ((SourceRegionDeviceEnters owner region) (= (SourceRegionRequiresDevice region) true))
      ((set (SourceRegionRequiresDevice owner) true)) :ruleset source-summary)

(rule ((= value (SourceInput op i))) ((set (SourceHasOrigin value) false)) :ruleset source-summary)
(rule ((= array (SourceLength value))) ((Identity array)) :ruleset source-summary)

; Inverse index for entry-local output queries during readout.
(sort SourceOutputIds (Set i64))
(function SourceOutputsForEntry (i64) SourceOutputIds :merge (set-union old new))
(rule ((= (SourceOutput id) (OutputInfo entry value ty array)))
      ((set (SourceOutputsForEntry entry) (set-of id))) :ruleset source-summary)
