; Source summaries settle before boundary-sensitive dependency queries run.
(ruleset source-dependencies)
; Resolve structural forwarding before emitting conservative opaque projections.
(ruleset source-forwarding)
(ruleset source-projections)
; Classify the shared use graph only after inputs, captures and aliases are known.
(relation SourceUse (SourceValue SourceValue))
(function SourceComputed (SourceValue) bool :merge (and old new))
(rule ((= target (SourceAlias value))) ((set (SourceComputed value) false)) :ruleset source-forwarding)
(rule ((SourceSelect value parent i)) ((set (SourceComputed value) false)) :ruleset source-forwarding)
(rule ((= value (SourceOperationValue op))) ((set (SourceComputed value) false)) :ruleset source-forwarding)
(function SourceUseIsInput (SourceValue SourceValue) bool :merge (or old new))
(rule ((SourceDirectUse value child)) ((SourceUse value child)) :ruleset source-forwarding)
(rule ((SourceNestedUse value child)) ((SourceUse value child)) :ruleset source-forwarding)
(rule ((SourceUse value child))
      ((set (SourceComputed value) true) (set (SourceUseIsInput value child) false)) :ruleset source-forwarding)
(rule ((= value (SourceOperationValue op)) (= child (SourceInput op i)))
      ((set (SourceUseIsInput value child) true)) :ruleset source-forwarding)
(rule ((SourceUse value child) (= (SourceComputed value) true))
      ((FlowOperand value child)) :ruleset source-projections)
(rule ((SourceUse value child) (= value (SourceOperationValue op))
       (= (SourceUseIsInput value child) false))
      ((SourceOperand op child)) :ruleset source-projections)
(rule ((= region (SourceOperatorBody op)) (= child (SourceCapture region formal))
       (= value (SourceOperationValue op)) (SourceUse value child))
      ((SourceOperand op child)) :ruleset source-projections)
; Keep tiny local traversals explicit so array indices become constants.
; Larger traversals retain loops to bound generated code size.
(relation ExpandLocalTripCount (i64))
(ExpandLocalTripCount 0)
(rule ((ExpandLocalTripCount n) (< n 16))
      ((ExpandLocalTripCount (+ n 1))) :ruleset source-summary)
; Collective lanes access the same component together: store those components
; in separate columns instead of striding across an array-valued lane record.
(relation ColumnarCollectiveExtent (i64))
(rule ((ExpandLocalTripCount n) (> n 0))
      ((ColumnarCollectiveExtent n)) :ruleset source-summary)
; Source identities are queried in either direction during scalar admission and
; final readout. Populate the shared inverse indexes with the source summaries.
(rule ((= value (SourceParameter region index)))
      ((set (SourceParameterRegion value) region) (set (SourceParameterIndex value) index)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op))) ((set (SourceValueOperation value) op)) :ruleset source-summary)
; Borrowed formals and projections do not re-execute their producers.
(rule ((= value (SourceFormal region i)))
      ((set (SourceReadOnly value) true)) :ruleset source-summary)
(rule ((= (SourceProjection value) (ProjectionInfo parent i)))
      ((set (SourceReadOnly value) true)) :ruleset source-summary)
; Indexed writes into owned values are private to the invocation. Only view
; destinations introduce shared-storage effects. Neither form is speculative.
(rule ((= destination (SourceDestination op)) (= value (SourceOperationValue op)))
      ((set (SourceSpeculatable value) false)) :ruleset source-summary)
(rule ((= destination (SourceDestination op)) (= ty (SourceType destination))
       (SourceViewType ty) (= value (SourceOperationValue op)))
      ((set (SourceReadOnly value) false)) :ruleset source-summary)
(relation SourceEnters (SourceValue RegionKey))
; Value-preserving coercions and projections share identity without equating
; their execution occurrences. Lexical bindings are resolved during import.
; Captures stay scope boundaries here; FlowValue equality serves shape/bounds proofs.
(datatype SourceIdentity (Identity SourceValue))
(function SourceIdentityToken (SourceIdentity) i64 :merge (min old new))
(function SourceHasOrigin (SourceValue) bool :merge (or old new))
(relation SourceOrigin (SourceValue OperationKey))
(relation SourceDepends (OperationKey OperationKey OperandRole))
(relation SourceObserved (OperationKey))
(relation SourceReturnDependency (RegionKey OperationKey))
(relation SourceRegionDependency (RegionKey OperationKey))
; Value dependencies stop at operation results; execution dependencies connect
; those results to their operands without making every edge transitive.
; Freeze the lexical owner at the use site; later bindings cannot change it.
(relation SourceLexicalUse (RegionKey SourceValue RegionKey))
(rule ((SourceLexicalUse scope value owner) (!= scope owner) (SourceParent scope parent))
      ((SourceLexicalUse parent value owner)) :ruleset source-forwarding)
; Before call resolution, SourceEnters contains the imported nested regions.
(rule ((SourceEnters value region) (SourceLexicalUse region free owner) (!= region owner))
      ((SourceNestedUse value free)) :ruleset source-forwarding)
(function SourceOperandRole (OperationKey) OperandRole :no-merge)
(rule ((= value (SourceOperationValue op)))
      ((FlowRead value value)) :ruleset source-summary)
(rule ((= value (SourceResult region)) (FlowRead value origin) (= origin (SourceOperationValue op)))
      ((SourceReturnDependency region op)) :ruleset source-summary)
(rule ((SourceLexicalUse region value owner) (!= region owner) (FlowRead value origin) (= origin (SourceOperationValue op)))
      ((SourceRegionDependency region op)) :ruleset source-summary)
(rule ((= value (SourceInput op i)) (FlowRead value origin) (= origin (SourceOperationValue before)) (!= op before))
      ((SourceDepends op before (Input))) :ruleset source-dependencies)
(rule ((SourceOperand op value) (= role (SourceOperandRole op))
       (FlowRead value origin) (= origin (SourceOperationValue before)) (!= op before))
      ((SourceDepends op before role)) :ruleset source-dependencies)
(rule ((SourceReturnDependency region op) (= (SourceOperation op) (OperationInfo region kind)))
      ((SourceObserved op)) :ruleset source-summary)
(function WorkOperationCheap (OperationKey) bool :merge (or old new))

(rule ((= value (SourceInput op i)) (= token (SourceOrdinal value))) ((set (SourceIdentityToken (Identity value)) token)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op))) ((SourceOrigin value op) (Identity value)) :ruleset source-summary)
(rule ((= target (SourceAlias value))) ((union (Identity value) (Identity target))) :ruleset source-summary)
(rule ((FlowFrom value target) (SourceOrigin target op)) ((SourceOrigin value op)) :ruleset source-summary)
(rule ((SourceOrigin value op)) ((set (SourceHasOrigin value) true)) :ruleset source-summary)
(rule ((= (SourceDefinition symbol) region)) ((set (SourceCallable (SourceGlobal symbol)) region)) :ruleset source-summary)
(rule ((= target (SourceAlias value)) (= (SourceCallable target) region)) ((set (SourceCallable value) region)) :ruleset source-summary)
(rule ((SourceClosureCode value code) (= (SourceCallable code) region)) ((set (SourceCallable value) region)) :ruleset source-summary)
(rule ((SourceApply value function) (= (SourceCallable function) region)) ((SourceEnters value region)) :ruleset source-summary)

(relation ImportedPosition (OperationKey i64))
(relation SourceNextOperation (OperationKey OperationKey))
(relation ImportedEffectOrder (OperationKey OperationKey))

(rule ((= value (SourceDestination op))) ((set (SourceStorage value) false)) :ruleset source-summary)
(rule ((= ty (SourceType value)) (SourceViewType ty)) ((set (SourceStorage value) true)) :ruleset source-summary)
(rule ((FlowFrom value target) (= storage (SourceStorage target))) ((set (SourceStorage value) storage)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op)) (= destination (SourceDestination op)) (= storage (SourceStorage destination)))
      ((set (SourceStorage value) storage)) :ruleset source-summary)
(rule ((= source (SourceAlias value)) (SourceReusePermission source region))
      ((SourceReusePermission value region)) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo r kind)) (!= kind "bucket-scatter") (= count (SourceInputCount op)) (> count 0))
      ((set (SourceDomainRank op) 1) (SourceDomainInputAxis op 0 0)) :ruleset source-summary)
(rule ((= (SourceInputCount op) 0))
      ((set (SourceDomainRank op) 1) (set (SourceDomainAxis op 0) (Fixed 0))) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo r kind)) (!= kind "bucket-scatter") (= value (SourceInput op i)))
      ((set (SourceInputRank op i) 1) (set (SourceInputDimension op i 0) 0)) :ruleset source-summary)
(function SourceDomainPrefixExtent (OperationKey i64) Extent :no-merge)
(rule ((SourceDomainInputAxis op axis i) (= input (SourceInput op i)) (= n (SourceExtent input)))
      ((set (SourceDomainAxis op axis) n)) :ruleset source-summary)
(rule ((= n (SourceDomainAxis op 0))) ((set (SourceDomainPrefixExtent op 1) n)) :ruleset source-summary)
(rule ((= (SourceDomainPrefixExtent op axis) product) (= rank (SourceDomainRank op)) (< axis rank) (= n (SourceDomainAxis op axis)))
      ((set (SourceDomainPrefixExtent op (+ axis 1)) (Product product n))) :ruleset source-summary)
(rule ((= rank (SourceDomainRank op)) (= (SourceDomainPrefixExtent op rank) n))
      ((set (SourceDomainExtent op) n)) :ruleset source-summary)

; Backing equivalence is conservative and never equates value versions.
(datatype SourceBacking (BackingIdentity SourceValue))
(relation ScatterReadValue (OperationKey SourceValue))
; Only scatter's in-place safety check needs transitive input/capture reads.
(rule ((= (SourceOperation op) (OperationInfo region "scatter")) (= input (SourceInput op i)))
      ((ScatterReadValue op input)) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo region "scatter")) (= body (SourceOperatorBody op)) (= (SourceCapture body formal) actual))
      ((ScatterReadValue op actual)) :ruleset source-summary)
(rule ((ScatterReadValue op value) (SourceUse value child))
      ((ScatterReadValue op child)) :ruleset source-summary)
(rule ((ScatterReadValue op value)) ((BackingIdentity value)) :ruleset source-summary)
(rule ((= value (SourceDestination op))) ((BackingIdentity value)) :ruleset source-summary)
(rule ((FlowFrom value target)) ((union (BackingIdentity value) (BackingIdentity target))) :ruleset source-summary)
(rule ((= (SourceSlice value) (SliceInfo target start end))) ((union (BackingIdentity value) (BackingIdentity target))) :ruleset source-summary)
(rule ((= value (SourceOperationValue op)) (= destination (SourceDestination op)))
      ((union (BackingIdentity value) (BackingIdentity destination))) :ruleset source-summary)
(function SourceScratchValue (SourceValue) bool :merge (or old new))
(rule ((= value (SourceDestination op))) ((set (SourceScratchValue value) false)) :ruleset source-summary)
(rule ((SourceScratch value n)) ((set (SourceScratchValue value) true)) :ruleset source-summary)
(rule ((= target (SourceAlias value)) (= scratch (SourceScratchValue target))) ((set (SourceScratchValue value) scratch)) :ruleset source-summary)

(function SourceRegionWork (RegionKey) i64 :no-merge)
(relation SourceSummaryEnters (SourceValue RegionKey))
(relation SourceRegionEnters (RegionKey RegionKey))
; Read footprints follow evaluation edges. A concrete binding may
; be reread only when no authored update or writable declaration can change it.
(relation SourceBinding (SourceValue i64 i64))
(relation SourceReadsBinding (SourceValue i64 i64))
(relation SourceMutableBinding (i64 i64))
(relation SourceUnknownWrite ())
(rule ((FlowFrom value source) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((SourceField value i source) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((SourceArrayPart value i source) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((= (SourceSlice value) (SliceInfo source start end)) (SourceBinding source set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
; Runtime array state carries storage descriptors; fixed arrays are copied values.
(rule ((= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= ty (SourceType state)) (= (SourceArraySize ty) (DynamicSize))
       (SourceBinding initial set binding))
      ((SourceBinding state set binding)) :ruleset source-summary)
(rule ((SourceLoopBackedge header state next) (= ty (SourceType state))
       (= (SourceArraySize ty) (DynamicSize)) (SourceBinding next set binding))
      ((SourceBinding state set binding)) :ruleset source-summary)
(rule ((= (SourceLoop value) (LoopInfo header iteration))
       (= (SourceLoopInitial header) (LoopInitialInfo state initial)) (SourceBinding state set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((SourceResultOperand value index original) (= ty (SourceType original))
       (= (SourceArraySize ty) (DynamicSize)) (SourceBinding original set binding))
      ((SourceBinding value set binding)) :ruleset source-summary)
(rule ((= value (SourceDestination op)) (SourceBinding value set binding))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceReusePermission value region) (SourceBinding value set binding))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((= value (SourceOperationValue op)) (= (SourceReadOnly value) false)
       (SourceOperand op input) (SourceBinding input set binding))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceReadsBinding value set binding) (SourceUnknownWrite))
      ((SourceMutableBinding set binding)) :ruleset source-summary)
(rule ((SourceReadsBinding value set binding) (SourceMutableBinding set binding))
      ((set (SourceDuplicable value) false)) :ruleset source-summary)
(rule ((SourceEnters value region) (= value (SourceOperationValue op)) (SourceRegionDependency region before) (!= op before))
      ((SourceDepends op before (Other))) :ruleset source-dependencies)
(rule ((SourceEnters owner region)) ((FlowCall owner (FlowRegion region))) :ruleset source-summary)
; A reference carries device requirements, but does not re-execute its effects.
(rule ((SourceUse value child) (= (SourceRequiresDevice child) true))
      ((set (SourceRequiresDevice value) true)) :ruleset source-summary)
(rule ((FlowFrom value child) (= (SourceRequiresDevice child) true))
      ((set (SourceRequiresDevice value) true)) :ruleset source-summary)
(rule ((= value (SourceInvocation owner function args)) (= (SourceCallable function) region))
      ((FlowCall (FlowRegion owner) (FlowRegion region))) :ruleset source-summary)
(rule ((= value (SourceInput op i))) ((set (SourceHasOrigin value) false)) :ruleset source-summary)
(rule ((= array (SourceLength value))) ((Identity array)) :ruleset source-summary)

; Inverse index for entry-local output queries during readout.
(sort SourceOutputIds (Set i64))
(function SourceOutputsForEntry (i64) SourceOutputIds :merge (set-union old new))
(rule ((= (SourceOutput id) (OutputInfo entry value ty array)))
      ((set (SourceOutputsForEntry entry) (set-of id))) :ruleset source-summary)

; Literal-valued helpers can supply constant array seeds without a GPU producer.
(function SourceConstantInteger (SourceValue) i64 :no-merge)
(rule ((= n (SourceInteger32 value))) ((set (SourceConstantInteger value) n)) :ruleset source-summary)
(rule ((= original (SourceAlias value)) (= n (SourceConstantInteger original)))
      ((set (SourceConstantInteger value) n)) :ruleset source-summary)
(rule ((= value (SourceInvocation caller function args)) (= callee (SourceCallable function))
       (= result (SourceResult callee)) (= n (SourceConstantInteger result)))
      ((set (SourceConstantInteger value) n)) :ruleset source-summary)

; Evaluation edges carry effects; value-reference edges never re-execute them.
(rule ((FlowEvaluation owner value) (SourceReadsBinding value set binding))
      ((SourceReadsBinding owner set binding)) :ruleset source-summary)
(rule ((FlowEvaluation owner value) (SourceSummaryEnters value region))
      ((SourceSummaryEnters owner region)) :ruleset source-summary)
(rule ((FlowEffect owner value) (= flag (SourceSpeculatable value))) ((set (SourceSpeculatable owner) flag)) :ruleset source-summary)
(rule ((FlowEffect owner value) (= flag (SourceReadOnly value))) ((set (SourceReadOnly owner) flag)) :ruleset source-summary)
(rule ((FlowEffect owner value) (= flag (SourceDuplicable value))) ((set (SourceDuplicable owner) flag)) :ruleset source-summary)
(rule ((FlowEffect owner value) (= flag (SourceRequiresDevice value))) ((set (SourceRequiresDevice owner) flag)) :ruleset source-summary)
(rule ((FlowReference owner value) (= flag (SourceRequiresDevice value))) ((set (SourceRequiresDevice owner) flag)) :ruleset source-summary)

; Region properties are views of ordinary execution nodes.
(rule ((SourceRegionUse region value)) ((FlowReference (FlowRegion region) value)) :ruleset source-summary)
(rule ((FlowCall owner (FlowRegion region))) ((SourceSummaryEnters owner region)) :ruleset source-summary)
(rule ((SourceSummaryEnters (FlowRegion owner) region)) ((SourceRegionEnters owner region)) :ruleset source-summary)

(function SourceHasOperation (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (SourceHasOperation value) false)) :ruleset source-summary)
(rule ((= op (SourceValueOperation value))) ((set (SourceHasOperation value) true)) :ruleset source-summary)

(relation SourceScrema (OperationKey))
(rule ((= (SourceOperation op) (OperationInfo r "map"))) ((SourceScrema op)) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo r "scan"))) ((SourceScrema op)) :ruleset source-summary)
(rule ((= (SourceOperation op) (OperationInfo r "reduce"))) ((SourceScrema op)) :ruleset source-summary)

(function SourceCallTarget (SourceValue) RegionKey :no-merge)
(function SourceCallArgument (SourceValue i64) SourceValue :no-merge)
(relation SourceCallIndex (SourceValue i64))
(rule ((= value (SourceInvocation scope function args))) ((SourceCallIndex value 0)) :ruleset source-summary)
(rule ((= value (SourceInvocation scope function args)) (= (SourceCallable function) callee))
      ((set (SourceCallTarget value) callee)) :ruleset source-summary)
(rule ((SourceCallIndex value i) (= value (SourceInvocation scope function args)) (< i (vec-length args)))
      ((set (SourceCallArgument value i) (vec-get args i)) (SourceCallIndex value (+ i 1))) :ruleset source-summary)

; Project source syntax into the shared canonical value graph.
(rule ((= t (SourceType s))) ((FlowValueOf s)) :ruleset flow-structure)
(rule ((= a (SourceCapture r s))) ((union (FlowValueOf s) (FlowValueOf a))) :ruleset flow-structure)
(rule ((SourceBinary s op a b))
      ((FlowBinary (FlowValueOf s) op (FlowValueOf a) (FlowValueOf b))) :ruleset flow-structure)
(rule ((= (SourceBranch s) (BranchInfo condition yes no)) (= a (SourceResult yes)) (= b (SourceResult no)))
      ((FlowBranch (FlowValueOf s) (FlowValueOf a) (FlowValueOf b))) :ruleset flow-structure)
