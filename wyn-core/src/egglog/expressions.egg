; Loaded only AFTER fusion. This layer joins through RegionId/OperationId;
; it does not change the fusion schema or its operation records.
(datatype TypeKey (TypeId i64))
(datatype ParameterKey (ParameterId i64))
(datatype SymbolKey (SymbolId i64))
(datatype BuiltinKey (BuiltinId i64))
(datatype ExternKey (ExternId i64))
(sort Expr)
(sort Node)
(sort Array)
(sort Exprs (Vec Expr))
(sort Arrays (Vec Array))
(constructor Typed (TypeKey Node) Expr)
; Stable roots follow e-class unions until scalar extraction.
(function SourceExpression (i64) Expr :no-merge)
(constructor Global (SymbolKey) Node)
(constructor Parameter (ParameterKey) Node)
(constructor Builtin (BuiltinKey) Node)
(constructor Extern (ExternKey) Node)
(constructor BinOp (String) Node)
(constructor UnOp (String) Node)
(constructor Int (String) Node)
(constructor FloatBits (i64) Node)
(constructor Bool (bool) Node)
(constructor UnitValue () Node)
(constructor PureApp (Expr Exprs) Node)
(constructor Lambda (RegionKey) Node)
(constructor Closure (SymbolKey i64 Exprs) Node)
(constructor Coerce (Expr) Node)
(constructor Select (Expr Expr Expr) Node)
(constructor Tuple (Exprs) Node)
(constructor Project (Expr i64) Node)
(constructor Vector (Exprs) Node)
(constructor ArrayValue (Array) Node)
(constructor OperationResult (OperationKey) Node)
(constructor ArrayInput (Expr) Array)
(constructor Zip (Arrays) Array)
(constructor ArrayLiteral (Exprs) Array)
(constructor Range (Expr Expr) Array)
(constructor StridedRange (Expr Expr Expr) Array)

(relation Region (RegionKey))
(relation RegionParent (RegionKey RegionKey))
(relation NamedRegion (SymbolKey RegionKey))
(relation EntryRegion (i64 RegionKey))
(relation RegionParameter (RegionKey i64 ParameterKey))
(relation RegionResult (RegionKey i64 Expr))
; This is complete live membership, including scalar-only scopes. It is
; separate from the SOAC-focused Operation relation consumed by fusion.
(relation Execution (RegionKey OperationKey))
(relation Callee (OperationKey Expr))
(relation GlobalEvaluation (OperationKey SymbolKey))
(relation IndexOperands (OperationKey Expr Expr))
(relation OperationInput (OperationKey Array))
; Order constraints are retained independently of value dependencies.
(relation ExecutionOrder (OperationKey OperationKey))

(ruleset expressions)
(relation ValueVector (Exprs))
(relation ValueAt (Exprs i64 Expr))
(rule ((ValueVector xs) (> (vec-length xs) 0))
      ((ValueAt xs 0 (vec-get xs 0))) :ruleset expressions)
(rule ((ValueAt xs i x) (= j (+ i 1)) (< j (vec-length xs)))
      ((ValueAt xs j (vec-get xs j))) :ruleset expressions)
(relation ArrayAt (Arrays i64 Array))
(rule ((= a (Zip xs)) (> (vec-length xs) 0))
      ((ArrayAt xs 0 (vec-get xs 0))) :ruleset expressions)
(rule ((ArrayAt xs i a) (= j (+ i 1)) (< j (vec-length xs)))
      ((ArrayAt xs j (vec-get xs j))) :ruleset expressions)
(relation ArrayExpr (Array Expr))
(rule ((= a (ArrayInput e))) ((ArrayExpr a e)) :ruleset expressions)
(rule ((= a (ArrayLiteral xs))) ((ValueVector xs)) :ruleset expressions)
(rule ((= a (ArrayLiteral xs)) (ValueAt xs i e)) ((ArrayExpr a e)) :ruleset expressions)
(rule ((= a (Range start len))) ((ArrayExpr a start) (ArrayExpr a len)) :ruleset expressions)
(rule ((= a (StridedRange start len step)))
      ((ArrayExpr a start) (ArrayExpr a len) (ArrayExpr a step)) :ruleset expressions)
(rule ((= a (Zip xs)) (ArrayAt xs i child) (ArrayExpr child e))
      ((ArrayExpr a e)) :ruleset expressions)

; Direct data edges in the pure DAG. RegionExpr records USE, not ownership:
; one interned expression may be used in several regions.
(relation ExprArgs (Expr Exprs))
(relation ExprChild (Expr Expr))
(rule ((= e (Typed t (PureApp f xs)))) ((ExprChild e f) (ExprArgs e xs)) :ruleset expressions)
(rule ((= e (Typed t (Closure code arity xs)))) ((ExprArgs e xs)) :ruleset expressions)
(rule ((= e (Typed t (Tuple xs)))) ((ExprArgs e xs)) :ruleset expressions)
(rule ((= e (Typed t (Vector xs)))) ((ExprArgs e xs)) :ruleset expressions)
(rule ((ExprArgs e xs)) ((ValueVector xs)) :ruleset expressions)
(rule ((ExprArgs e xs) (ValueAt xs i x)) ((ExprChild e x)) :ruleset expressions)
(rule ((= e (Typed t (Coerce x)))) ((ExprChild e x)) :ruleset expressions)
(rule ((= e (Typed t (Project x i)))) ((ExprChild e x)) :ruleset expressions)
(rule ((= e (Typed t (Select c yes no))))
      ((ExprChild e c) (ExprChild e yes) (ExprChild e no)) :ruleset expressions)
(rule ((= e (Typed t (ArrayValue a))) (ArrayExpr a x)) ((ExprChild e x)) :ruleset expressions)
(relation ExprParameter (Expr ParameterKey))
(relation ExprOperation (Expr OperationKey))
(rule ((= e (Typed t (Parameter p)))) ((ExprParameter e p)) :ruleset expressions)
(rule ((= e (Typed t (OperationResult op)))) ((ExprOperation e op)) :ruleset expressions)
(rule ((ExprChild e x) (ExprParameter x p)) ((ExprParameter e p)) :ruleset expressions)
(rule ((ExprChild e x) (ExprOperation x op)) ((ExprOperation e op)) :ruleset expressions)

(relation Callable (Expr RegionKey))
(rule ((= e (Typed t (Lambda r)))) ((Callable e r)) :ruleset expressions)
(rule ((= e (Typed t (Global s))) (NamedRegion s r)) ((Callable e r)) :ruleset expressions)
(rule ((= e (Typed t (Closure s arity xs))) (NamedRegion s r)) ((Callable e r)) :ruleset expressions)
(rule ((= e (Typed t (Coerce x))) (Callable x r)) ((Callable e r)) :ruleset expressions)
(relation Invokes (OperationKey RegionKey))
; Import callback regions and value operands directly. Body routing and operand
; roles remain in the sidecar; dependency analysis only needs these edges.
(relation OperationExpr (OperationKey Expr))
(rule ((Callee op e)) ((OperationExpr op e)) :ruleset expressions)
(rule ((Callee op e) (Callable e r)) ((Invokes op r)) :ruleset expressions)
(rule ((GlobalEvaluation op s) (NamedRegion s r)) ((Invokes op r)) :ruleset expressions)
(rule ((IndexOperands op a i)) ((OperationExpr op a) (OperationExpr op i)) :ruleset expressions)
(rule ((OperationInput op a) (ArrayExpr a e)) ((OperationExpr op e)) :ruleset expressions)

(relation RegionExpr (RegionKey Expr))
(rule ((RegionResult r i e)) ((RegionExpr r e)) :ruleset expressions)
(rule ((Execution r op) (OperationExpr op e)) ((RegionExpr r e)) :ruleset expressions)
(rule ((RegionExpr r e) (ExprChild e x)) ((RegionExpr r x)) :ruleset expressions)
(relation RegionAncestor (RegionKey RegionKey))
(rule ((RegionParent r p)) ((RegionAncestor r p)) :ruleset expressions)
(rule ((RegionParent r p) (RegionAncestor p outer)) ((RegionAncestor r outer)) :ruleset expressions)
(relation OperationDependency (OperationKey OperationKey))
(relation OperationParameter (OperationKey ParameterKey))
(rule ((OperationExpr op e) (ExprOperation e producer)) ((OperationDependency op producer)) :ruleset expressions)
(rule ((OperationExpr op e) (ExprParameter e p)) ((OperationParameter op p)) :ruleset expressions)
; Crossing an invocation carries only free dependencies from enclosing scopes.
; A callee's own executions/formals do not become dependencies of its caller.
(relation RegionExternalOperation (RegionKey OperationKey))
(relation RegionExternalParameter (RegionKey ParameterKey))
; A lexical lambda value needs its captured environment, but constructing it
; does not invoke its body or execute that body's local operations.
(rule ((= e (Typed t (Lambda r))) (RegionExternalOperation r op))
      ((ExprOperation e op)) :ruleset expressions)
(rule ((= e (Typed t (Lambda r))) (RegionExternalParameter r p))
      ((ExprParameter e p)) :ruleset expressions)
(rule ((RegionExpr r e) (ExprOperation e op) (Execution owner op) (RegionAncestor r owner))
      ((RegionExternalOperation r op)) :ruleset expressions)
(rule ((RegionExpr r e) (ExprParameter e p) (RegionParameter owner i p) (RegionAncestor r owner))
      ((RegionExternalParameter r p)) :ruleset expressions)
; The caller can depend only on values from its own scope or an enclosing one.
; In particular, a loop body uses header parameters that belong INSIDE the loop;
; they must not become incoming dependencies of the enclosing loop operation.
(rule ((Invokes op child) (Execution r op)
       (RegionExternalOperation child producer) (Execution r producer))
      ((OperationDependency op producer)) :ruleset expressions)
(rule ((Invokes op child) (Execution r op)
       (RegionExternalOperation child producer) (Execution owner producer) (RegionAncestor r owner))
      ((OperationDependency op producer)) :ruleset expressions)
(rule ((Invokes op child) (Execution r op)
       (RegionExternalParameter child p) (RegionParameter r i p))
      ((OperationParameter op p)) :ruleset expressions)
(rule ((Invokes op child) (Execution r op)
       (RegionExternalParameter child p) (RegionParameter owner i p) (RegionAncestor r owner))
      ((OperationParameter op p)) :ruleset expressions)
(rule ((Execution r op) (OperationDependency op producer) (Execution owner producer) (RegionAncestor r owner))
      ((RegionExternalOperation r producer)) :ruleset expressions)
(rule ((Execution r op) (OperationParameter op p) (RegionParameter owner i p) (RegionAncestor r owner))
      ((RegionExternalParameter r p)) :ruleset expressions)
