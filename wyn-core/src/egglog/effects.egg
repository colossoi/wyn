; Run after dependency/membership saturation. Members is then complete and
; immutable; MovableMembers grows monotonically until every member is proved safe.
(ruleset effects)
(relation Movable (OperationKey))
(function MovableMembers (RegionKey) OperationSet :merge (set-union old new))
(relation DiscardableOperation (OperationKey))
(function DiscardableMembers (RegionKey) OperationSet :merge (set-union old new))
(relation SafeRegion (RegionKey))
(relation SafeBody (SoacBody))
(relation SafeCollectives (Collectives))
(relation FreshOwnerships (Ownerships))

(rule ((Region r)) ((set (MovableMembers r) (set-empty))) :ruleset effects)
(rule ((Region r)) ((set (DiscardableMembers r) (set-empty))) :ruleset effects)
(rule ((Operation r op t a) (Movable op)) ((set (MovableMembers r) (set-of op))) :ruleset effects)
(rule ((Movable op)) ((DiscardableOperation op)) :ruleset effects)
(rule ((Operation r op t a) (DiscardableOperation op))
      ((set (DiscardableMembers r) (set-of op))) :ruleset effects)
(rule ((Region r) (= (Members r) (MovableMembers r))) ((SafeRegion r)) :ruleset effects)
; Pure expression construction already excludes effects. Copy-value indexing
; is movable; unknown calls and memory-sensitive actions require ordering.
(rule ((Operation r op t (Index (Typed at a) i)) (CopyType at)) ((Movable op)) :ruleset effects)
(rule ((Operation r op t (ScremaApp (Screma pre scans reductions post) inputs ownership))
       (SafeBody pre) (SafeCollectives scans) (SafeCollectives reductions) (SafeBody post)
       (FreshOwnerships ownership)) ((Movable op)) :ruleset effects)
; UniqueInput is a storage-reuse permission on an exclusively owned value,
; not an observable effect by itself. It constrains movement of LIVE work, but
; does not force an unused pure SOAC to execute. Unknown body effects still do.
(rule ((Operation r op t (ScremaApp (Screma pre scans reductions post) inputs ownership))
       (SafeBody pre) (SafeCollectives scans) (SafeCollectives reductions) (SafeBody post))
      ((DiscardableOperation op)) :ruleset effects)
(rule ((= xs (NoOwnerships))) ((FreshOwnerships xs)) :ruleset effects)
(rule ((= xs (OwnershipsCons (Fresh) tail)) (FreshOwnerships tail)) ((FreshOwnerships xs)) :ruleset effects)
(rule ((= b (ApplyBody r params results captures)) (SafeRegion r))
      ((SafeBody b)) :ruleset effects)
(rule ((= b (IdentityBody ts))) ((SafeBody b)) :ruleset effects)
(rule ((= b (RouteBody ts indices))) ((SafeBody b)) :ruleset effects)
(rule ((= b (ParallelBody a c)) (SafeBody a) (SafeBody c)) ((SafeBody b)) :ruleset effects)
(rule ((= b (ComposeBody a c)) (SafeBody a) (SafeBody c)) ((SafeBody b)) :ruleset effects)
(rule ((= xs (NoCollectives))) ((SafeCollectives xs)) :ruleset effects)
(rule ((= xs (CollectivesCons (Scan op ne) tail)) (SafeBody op) (SafeCollectives tail))
      ((SafeCollectives xs)) :ruleset effects)
(rule ((= xs (CollectivesCons (Reduction op ne commutative) tail))
       (SafeBody op) (SafeCollectives tail)) ((SafeCollectives xs)) :ruleset effects)
