; Egglog selects legal contractions. Bodies and input expressions remain opaque:
; applying a decision composes the two sidecar bodies and preserves the consumer.
(ruleset fusion)
(relation FusionCandidate (RegionKey OperationKey OperationKey))

(rule (
    (Operation region producer) (Operation region consumer)
    ; Current vertical case: a map with one result feeds a single-input Screma.
    (Screma producer producer-inputs 1 0 0) (IdentityPost producer)
    (Screma consumer 1 1 scans reductions)
    (InputFrom consumer 0 producer 0)
    (!= producer consumer)
    (Movable producer) (Safe consumer)
    ; Complete uses include captures, neutrals, returns, and cross-scope observers.
    (= (Uses producer) (set-of (OperationUse consumer (Input))))
    (= 0 (set-length (Intermediates producer consumer))))
  ((FusionCandidate region producer consumer))
  :ruleset fusion)
