; Scheduling inputs describe source structure, not allocation decisions.
; Stage identities name static launch sites. Site/Enters retain the
; invocation boundaries; a repeated launch is not a cycle in the dispatch DAG.
(datatype StageKey (Stage OperationKey String))
(datatype DispatchGrid (AutomaticGrid) (FixedGrid i64 i64 i64))
(function EntryGrid (i64) DispatchGrid :no-merge)
(function OperationGrid (OperationKey) DispatchGrid :no-merge)
(function PhaseGrid (StageKey) DispatchGrid :no-merge)
(datatype ValueKey
  (Output i64)
  (Source SourceValue)
  (Result OperationKey i64)
  (Temporary OperationKey String i64))
(datatype Extent
  (Fixed i64)
  (Length SourceValue)
  (Scalar SourceValue)
  (Product Extent Extent)
  (Difference Extent Extent)
  (Stored ValueKey))
(relation Site (OperationKey RegionKey))
(relation HostRoot (i64 RegionKey))
(relation Enters (OperationKey RegionKey))
(relation ExitValue (RegionKey SourceValue))
(relation OutputExpression (i64 SourceValue))
(relation Operand (OperationKey String SourceValue))
(relation EffectInput (i64 OperationKey))
(relation EffectWait (OperationKey i64))
(relation SourceDependency (OperationKey OperationKey))
(relation ScalarSite (OperationKey))
(relation ScalarCandidate (OperationKey))
(function ContainsCollective (OperationKey) bool :merge (or old new))
(function ScalarBoundary (OperationKey) bool :merge (or old new))
(function ParallelSafe (OperationKey) bool :merge (and old new))
(function ParallelBodySafe (OperationKey) bool :merge (and old new))
(relation SplitRegion (RegionKey))
(relation ScalarValue (OperationKey))
(relation InputDomain (OperationKey Extent))
; Output components and collective components are semantic facts, before recipes.
(relation ArrayResult (OperationKey i64 TypeKey))
(relation TotalCount (OperationKey i64))
(relation TotalResult (OperationKey i64 TypeKey))
(relation Accumulator (OperationKey i64 TypeKey))
(relation ScanComponent (OperationKey i64 TypeKey))
(relation UpdatedResult (OperationKey i64 SourceValue))
(relation InitializedResult (OperationKey i64 TypeKey Extent))
(relation FilterResult (OperationKey TypeKey))
(relation BucketResult (OperationKey SourceValue))
(relation CounterType (TypeKey))
(relation ParameterValue (SourceValue))
(relation ResultTuple (SourceValue OperationKey))
(relation DirectResult (SourceValue OperationKey i64))
(relation FieldValue (SourceValue i64 SourceValue))
(relation Projection (SourceValue SourceValue i64))
(relation ForwardValue (SourceValue SourceValue))
(relation ChildValue (SourceValue SourceValue))
(relation ComputedValue (SourceValue))
; Views retain the source value version, rather than equating executions.
(relation SliceView (SourceValue SourceValue SourceValue SourceValue))

(relation HostRegion (RegionKey))
(ruleset host-regions)
(relation Phase (StageKey RegionKey))
(relation FirstPhase (OperationKey StageKey))
(relation LastPhase (OperationKey StageKey))
(relation PhaseInput (StageKey OperationKey String))
(relation PhaseDomain (StageKey Extent i64))
(relation ExtentDemand (StageKey Extent))
(relation LengthDemand (StageKey SourceValue))
(relation Produces (StageKey ValueKey))
(relation Needs (StageKey ValueKey))
(relation ElementType (ValueKey TypeKey))
(function CapacityExtent (ValueKey) Extent :no-merge)
(function LiveLength (ValueKey) Extent :no-merge)
(function HostBound (Extent) Extent :no-merge)
(function LocalCapacity (Extent) i64 :merge (max old new))
(function LaunchGrid (StageKey) DispatchGrid :no-merge)
(relation FreshValue (ValueKey))
(datatype StorageChoice (Allocate) (Reuse SourceValue))
(function StorageFor (ValueKey) StorageChoice :no-merge)
(function ReuseSelected (ValueKey) bool :merge (or old new))
(relation PreferredReuse (ValueKey SourceValue))
(relation ReusableSource (SourceValue TypeKey RegionKey))
(relation FixedInputLength (SourceValue i64))
(function SameBacking (ValueKey) SourceValue :no-merge)
(relation ValueRef (SourceValue ValueKey))
; A value crossing a storage boundary is either a descriptor or an element load.
; Forwarded values preserve this choice; slices retain their own descriptor bounds.
(datatype StorageRead (ReadView ValueKey) (ReadElement ValueKey))
(function ResultRead (OperationKey i64) StorageRead :no-merge)
(function ValueRead (SourceValue) StorageRead :no-merge)
; All dependencies share one expression propagation path. A descriptor use
; requires the input binding without observing its mutable element contents.
(datatype ValueReference (Contents ValueKey) (Descriptor SourceValue))
(relation References (SourceValue ValueReference))
(relation ReferenceDemand (SourceValue))
(relation ResultSlot (OperationKey i64))
(datatype UseKey (InStage StageKey) (InOperation OperationKey) (AtExit))
(relation Demand (UseKey SourceValue))
(relation Requires (UseKey ValueKey))
(relation Escapes (ValueKey))
(relation Materialize (ValueKey))
(function Backing (ValueKey) ValueKey :no-merge)
(relation Allocation (ValueKey Extent))
; Names identify slots in a kernel recipe, not a second allocation policy.
(relation BufferSlot (OperationKey String i64 ValueKey))
(relation OwnedRegion (i64 RegionKey))
(relation PhaseOwner (StageKey i64))
(relation ReturnScalar (i64 TypeKey))
(relation ReturnArray (i64 SourceValue))
(relation ReturnedArrayLayout (i64 TypeKey Extent))
(function OutputHasBacking (i64) bool :merge (or old new))
(relation CopyOutput (i64))
(ruleset materialize-outputs)
(relation OutputBacking (i64 ValueKey))
; Access flags: read = 1, write = 2; both = 3.
(function Access (StageKey ValueKey) i64 :merge (| old new))
(relation Before (StageKey StageKey))
(relation Crossing (StageKey StageKey ValueKey))
(relation Clobbers (StageKey ValueKey))
; Shared gates keep effect fan-in/fan-out linear in the imported graph.
(datatype OrderKey (At StageKey) (Start OperationKey) (End OperationKey) (Gate i64))
(relation OrderEdge (OrderKey OrderKey))
; Dispatch order is complete before assigning sidecar IDs or building kernels.
(relation Waits (StageKey OrderKey))
(relation DispatchDependency (StageKey StageKey))

; Final readout joins; Rust assigns arena IDs without reconstructing these joins.
(relation PlannedBuffer (ValueKey i64 Extent))
; Logical roots and resources remain independent of backend numbering.
(datatype RootKey (EntryRoot i64) (KernelRoot StageKey))
(datatype BindingKey (InputBinding i64 i64))
(relation DeviceRegion (RegionKey))
(relation DeviceOperation (OperationKey))
(relation LocalBuffer (OperationKey String i64 TypeKey Extent))
(relation SourceEntry (i64 RegionKey bool))
(relation SourceControl (OperationKey))
(relation OutputOwner (i64 i64))
(ruleset readout)
(rule ((Allocation value n) (ElementType value (TypeId ty)))
      ((PlannedBuffer value ty n)) :ruleset readout)

(ruleset residency)
(ruleset structure)
(ruleset classify)
(ruleset allocation)
(ruleset dispatch)
; Binding facts consumed by final interface publication.
(datatype InputStorage (StorageInput BindingKey i64))
(function AbiStorage (SourceValue) InputStorage :no-merge)
(relation AbiOutputBinding (i64 i64 i64))
(datatype UpdateDestination (DestinationBuffer ValueKey) (DestinationValue SourceValue))
(function SelectedDestination (OperationKey) UpdateDestination :no-merge)

(relation Callback (OperationKey RegionKey))

(relation UninitializedResult (OperationKey i64 TypeKey Extent))

; Explicit output bindings cannot be satisfied by borrowing an input buffer.
(function OutputPinned (i64) bool :merge (or old new))

(function HostLoopCandidate (OperationKey) bool :merge (or old new))
(relation CountedArrayLoop (OperationKey RegionKey SourceValue SourceValue SourceValue SourceValue))
(relation HostLoop (OperationKey RegionKey SourceValue SourceValue SourceValue SourceValue))
