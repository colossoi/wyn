; Bounds requested by a shift follow its scalar inputs and counted-loop limit.
(ruleset integer-ranges)
(relation IntegerBoundsDemand (Name))
(function IntegerLower (Name) i64 :merge (max old new))
(function IntegerUpper (Name) i64 :merge (min old new))
(relation BoundsArithmetic (InstructionPayload))
(relation LoopInduction (OperationKey ValueName))
(relation TrackedI32 (Name))
(rule ((AdditionPayload payload)) ((BoundsArithmetic payload)) :ruleset integer-ranges)
(rule ((SubtractionPayload payload)) ((BoundsArithmetic payload)) :ruleset integer-ranges)
(rule ((MultiplicationPayload payload)) ((BoundsArithmetic payload)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation)
       (= payload (ScalarPayload operation)) (ShiftPayload payload)
       (DirectOperationUse operation (ValueNameRef value)) (= (wyn-input operation 0) (ValueNameRef value)) (= (ValueType value) (ScalarInfo (ScalarElement (I32))))
       (= source (wyn-input operation 1)))
      ((IntegerBoundsDemand source)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand name) (ResultOrigin name operation slot)
       (= payload (ScalarPayload operation)) (BoundsArithmetic payload)
       (= a (wyn-input operation 0)) (= b (wyn-input operation 1)))
      ((IntegerBoundsDemand a) (IntegerBoundsDemand b)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand name) (ResultOrigin name operation slot)
       (= payload (ScalarPayload operation)) (IndexCastPayload payload) (= value (wyn-input operation 0)))
      ((IntegerBoundsDemand value)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand name) (ResultOrigin name operation slot)
       (= payload (ScalarPayload operation)) (SelectPayload payload)
       (= a (wyn-input operation 0)) (= b (wyn-input operation 1)))
      ((IntegerBoundsDemand a) (IntegerBoundsDemand b)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand name) (ResultOrigin name operation slot)
       (BranchOperation operation) (BranchArm edge)
       (= value (wyn-control-yield operation edge slot)))
      ((IntegerBoundsDemand value)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand (ValueNameRef name))
       (= (ValueType name) (ScalarInfo (ScalarElement (I32)))))
      ((TrackedI32 (ValueNameRef name))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand (ValueNameRef name))
       (= (ValueType name) (LogicalValue (ElementValue (ScalarElement (I32))))))
      ((TrackedI32 (ValueNameRef name))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand (ValueNameRef index)) (LoopInduction operation index)
       (= (wyn-loop-count operation) (IndexValue count)))
      ((IntegerBoundsDemand (ValueNameRef count))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (TrackedI32 (ValueNameRef name))
       (ResultOrigin (ValueNameRef name) operation 0) (= bits (LiteralBits operation))
       (>= bits -2147483648) (<= bits 2147483647))
      ((set (IntegerLower (ValueNameRef name)) bits) (set (IntegerUpper (ValueNameRef name)) bits)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand (ValueNameRef index)) (LoopInduction operation index)
       (CountedLoopOperation operation)
       (= count (wyn-loop-count operation)) (ConstantBound count n) (> n 0) (<= n 2147483647))
      ((set (IntegerLower (ValueNameRef index)) 0) (set (IntegerUpper (ValueNameRef index)) (- n 1))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (IntegerBoundsDemand (ValueNameRef index)) (LoopInduction operation index)
       (CountedLoopOperation operation)
       (= (wyn-loop-count operation) (IndexValue count)) (= n (IntegerUpper (ValueNameRef count)))
       (> n 0) (<= n 2147483647))
      ((set (IntegerLower (ValueNameRef index)) 0) (set (IntegerUpper (ValueNameRef index)) (- n 1))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (TrackedI32 output) (ResultOrigin output operation 0)
       (= payload (ScalarPayload operation)) (IndexCastPayload payload)
       (DirectOperationUse operation input) (= input (wyn-input operation 0))
       (= low (IntegerLower input)) (= high (IntegerUpper input)))
      ((set (IntegerLower output) low) (set (IntegerUpper output) high)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (TrackedI32 output) (ResultOrigin output operation 0)
       (= payload (ScalarPayload operation)) (MultiplicationPayload payload)
       (DirectOperationUse operation a) (= a (wyn-input operation 0)) (DirectOperationUse operation b) (= b (wyn-input operation 1)) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b))
       (= low (min (min (* la lb) (* la hb)) (min (* ha lb) (* ha hb))))
       (= high (max (max (* la lb) (* la hb)) (max (* ha lb) (* ha hb))))
       (>= low -2147483648) (<= high 2147483647))
      ((set (IntegerLower output) low) (set (IntegerUpper output) high)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation)
       (= payload (ScalarPayload operation)) (ShiftPayload payload) (DirectOperationUse operation a) (= a (wyn-input operation 1))
       (DirectOperationUse operation (ValueNameRef value)) (= (wyn-input operation 0) (ValueNameRef value)) (= (ValueType value) (ScalarInfo (ScalarElement (I32))))
       (= low (IntegerLower a)) (= high (IntegerUpper a)) (>= low 0) (< high 32))
      ((set (OperationTotal operation) true)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (SelectPayload payload)
       (DirectOperationUse operation a) (= a (wyn-input operation 0)) (DirectOperationUse operation b) (= b (wyn-input operation 1)) (ResultOrigin output operation 0)
       (TrackedI32 output) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b)))
      ((set (IntegerLower output) (min la lb)) (set (IntegerUpper output) (max ha hb))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (BranchResult operation slot output av bv)
       (TrackedI32 output) (= la (IntegerLower av)) (= lb (IntegerLower bv))
       (= ha (IntegerUpper av)) (= hb (IntegerUpper bv)))
      ((set (IntegerLower output) (min la lb)) (set (IntegerUpper output) (max ha hb))) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (AdditionPayload payload)
       (DirectOperationUse operation a) (= a (wyn-input operation 0)) (DirectOperationUse operation b) (= b (wyn-input operation 1)) (ResultOrigin output operation 0)
       (TrackedI32 output) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b))
       (= low (+ la lb)) (= high (+ ha hb)) (>= low -2147483648) (<= high 2147483647))
      ((set (IntegerLower output) low) (set (IntegerUpper output) high)) :ruleset integer-ranges)
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (SubtractionPayload payload)
       (DirectOperationUse operation a) (= a (wyn-input operation 0)) (DirectOperationUse operation b) (= b (wyn-input operation 1)) (ResultOrigin output operation 0)
       (TrackedI32 output) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b))
       (= low (- la hb)) (= high (- ha lb)) (>= low -2147483648) (<= high 2147483647))
      ((set (IntegerLower output) low) (set (IntegerUpper output) high)) :ruleset integer-ranges)
