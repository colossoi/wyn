; Definitions and execution scopes are read directly from the editable graph.
(rule ((= revision (AnalysisRevision)) (LiveRegion region))
      ((FlowScopeAncestor region region)) :ruleset graph-structure)
(rule ((= revision (AnalysisRevision)) (LiveRegion region) (= name (RegionParameter region slot)))
      ((set (Defines name) (ParameterSite region slot)) (DefinitionRegion name region)
       (AvailableIn region name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= name (Output operation slot)) (= region (wyn-region-of operation)))
      ((set (Defines name) (OperationSite operation slot)) (DefinitionRegion name region)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (LiveRegion region) (= name (RegionParameter region slot))
       (= site (Defines name)) (!= site (ParameterSite region slot)))
      ((InvalidDataflow "value has more than one definition")) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= name (Output operation slot))
       (= site (Defines name)) (!= site (OperationSite operation slot)))
      ((InvalidDataflow "value has more than one definition")) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (= (RegionOwnedBy child) operation) (= parent (wyn-region-of operation)))
      ((FlowScopeParent child parent)) :ruleset graph-structure)
(rule ((= revision (AnalysisRevision)) (LiveRegion child) (FlowScopeParent child parent) (FlowScopeAncestor child parent))
      ((InvalidDataflow "cyclic execution-region nesting")) :ruleset dataflow-scopes)


(rule ((= revision (AnalysisRevision)) (AvailabilityDemand operation name) (= region (wyn-region-of operation)) (AvailableIn region name))
      ((AvailableAt operation name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (AvailabilityDemand operation name) (= (Defines name) (OperationSite producer slot))
       (= region (wyn-region-of operation)) (= region (wyn-region-of producer))
       (= before (wyn-operation-position producer)) (= after (wyn-operation-position operation))
       (< before after))
      ((AvailableAt operation name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (EntryDemand child name) (= (RegionOwnedBy child) operation) (AvailableAt operation name))
      ((AvailableIn child name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (AvailabilityDemand operation name) (= region (wyn-region-of operation))
       (DefinitionRegion name owner) (!= owner region))
      ((EntryDemand region name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (EntryDemand child name) (= (RegionOwnedBy child) operation))
      ((AvailabilityDemand operation name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (EndDemand region name) (AvailableIn region name))
      ((AvailableEnd region name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (EndDemand region name) (DefinitionRegion name region))
      ((AvailableEnd region name)) :ruleset dataflow-scopes)
(rule ((= revision (AnalysisRevision)) (EndDemand region name) (DefinitionRegion name owner) (!= owner region))
      ((EntryDemand region name)) :ruleset dataflow-scopes)

; Index, shape, and slice facts follow immutable terms across graph edits.
(rule ((= revision (AnalysisRevision)) (= (AccumulatorType token) (AccumulatorInfo shape elements)))
      ((ShapeDemand shape)) :ruleset graph-indices)
(rule ((= index (IndexValue name))) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexAdd a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexAdd a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexSub a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexSub a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMul a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMul a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexDiv a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexDiv a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMod a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMod a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMin a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMin a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMax a b)) (IndexUse a name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMax a b)) (IndexUse b name)) ((IndexUse index name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= shape (OperationShape operation))) ((ShapeDemand shape)) :ruleset graph-indices)
(rule ((ShapeDemand shape)) ((ShapeWalk shape 0)) :ruleset graph-indices)
(rule ((ShapeWalk shape slot) (< slot (vec-length shape)))
      ((set (ShapeAt shape slot) (vec-get shape slot)) (ShapeWalk shape (+ slot 1))) :ruleset graph-indices)
(rule ((= index (ShapeAt shape slot)) (IndexUse index name))
      ((ShapeUse shape name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= slices (OperationSlices operation))) ((SliceDemand slices)) :ruleset graph-indices)
(rule ((SliceDemand slices)) ((SliceWalk slices 0)) :ruleset graph-indices)
(rule ((SliceWalk slices slot) (< slot (vec-length slices)))
      ((set (SliceAt slices slot) (vec-get slices slot)) (SliceWalk slices (+ slot 1))) :ruleset graph-indices)
(rule ((= (SliceAt slices slot) (At index)) (IndexUse index name))
      ((SliceUse slices name)) :ruleset dataflow-dependencies)
(rule ((= (SliceAt slices slot) (Slice a b c)) (IndexUse a name)) ((SliceUse slices name)) :ruleset dataflow-dependencies)
(rule ((= (SliceAt slices slot) (Slice a b c)) (IndexUse b name)) ((SliceUse slices name)) :ruleset dataflow-dependencies)
(rule ((= (SliceAt slices slot) (Slice a b c)) (IndexUse c name)) ((SliceUse slices name)) :ruleset dataflow-dependencies)

(rule ((= revision (AnalysisRevision)) (Operation operation) (= count (wyn-input-count operation))
       (AritySlot count slot) (= name (wyn-input operation slot))) ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (OperationUse operation name)) ((AvailabilityDemand operation name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (Region region) (= arity (wyn-yield-count region))
       (AritySlot arity slot) (= name (wyn-yield region slot))) ((EndDemand region name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= region (wyn-control-region operation 0)) (= name (ResultValue operation clause slot)))
      ((EndDemand region name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= region (wyn-control-region operation 0)) (= value (ResultPredicate operation clause)))
      ((EndDemand region (ValueNameRef value))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= name (ResultNeutral operation clause slot))) ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= array (AccumulatorArray operation group slot)))
      ((OperationAttributeUse operation (ValueNameRef array))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= operation (RegionOwnedBy child)) (BranchArm edge)
       (= child (wyn-control-region operation edge)) (= parameter (RegionParameter child slot))
       (= name (wyn-edge-argument operation edge slot)))
      ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= index (OperationIndex operation slot)) (IndexUse index name))
      ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= slices (OperationSlices operation)) (SliceUse slices name))
      ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= shape (OperationShape operation)) (ShapeUse shape name))
      ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= domain (OperationDomain operation)) (= extent (DomainExtent domain axis)) (IndexUse extent name))
      ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= index (LoopStart operation)) (IndexUse index name)) ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= index (LoopCount operation)) (IndexUse index name)) ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= index (LoopStep operation)) (IndexUse index name)) ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (OperationUse operation name) (= region (wyn-region-of operation))
       (DefinitionRegion name owner) (!= region owner))
      ((RegionCapture region name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= (RegionOwnedBy child) operation) (RegionCapture child name))
      ((OperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (EndDemand region name) (DefinitionRegion name owner)
       (!= region owner) (= (wyn-region-yields region name) true))
      ((RegionCapture region name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= (RegionOwnedBy child) operation) (= child (wyn-control-region operation 0))
       (= name (ResultValue operation clause field)) (DefinitionRegion name owner) (!= child owner))
      ((RegionCapture child name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= child (wyn-control-region operation 0)) (= value (ResultPredicate operation clause))
       (DefinitionRegion (ValueNameRef value) owner) (!= child owner))
      ((RegionCapture child (ValueNameRef value))) :ruleset dataflow-dependencies)

; Forwarding publishes the same value language used by the earlier TLC passes.
(rule ((= revision (AnalysisRevision)) (ProductOperation operation)
       (= arity (wyn-input-count operation)) (AritySlot arity slot) (DirectOperationUse operation (ValueNameRef input)) (= (wyn-input operation slot) (ValueNameRef input))
       (= (Output operation 0) (ValueNameRef output)))
      ((SourceField (FlowNamed output) slot (FlowNamed input))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (ProjectionOperation operation slot) (DirectOperationUse operation (ValueNameRef input)) (= (wyn-input operation 0) (ValueNameRef input))
       (= (Output operation 0) (ValueNameRef output)))
      ((SourceSelect (FlowNamed output) (FlowNamed input) slot)) :ruleset dataflow-dependencies)


(rule ((= revision (AnalysisRevision)) (OperationCertificate operation name))
      ((DirectOperationUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (YieldCertificate region slot name))
      ((EndDemand region (ValueNameRef name)) (RegionAttributeUse region (ValueNameRef name))) :ruleset dataflow-dependencies)

; Exact outer bounds survive scalar folding and domain composition.
(rule ((= revision (AnalysisRevision)) (= (ValueType array) (LogicalValue (ArrayType ownership extents element)))
       (> (vec-length extents) 0) (= (vec-get extents 0) (FixedExtent n)))
      ((ArrayOuterBound array (IndexConstant n))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= (ValueType array) (LogicalValue (ArrayType ownership extents element)))
       (> (vec-length extents) 1) (= (vec-get extents 1) (FixedExtent n)))
      ((ArrayRowWidth array n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= (DomainRank (OperationDomain operation)) 1)
       (= (Output operation slot) (ValueNameRef array)) (= (OutputRole operation slot) (CollectedOutput))
       (= clause (OutputClause operation slot)) (= field (OutputField operation slot))
       (= (ResultValue operation clause field) (ValueNameRef row)) (ArrayOuterBound row bound) (ConstantBound bound n))
      ((ArrayRowWidth array n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (IndexOperands operation array index)
       (ArrayRowWidth array n)
       (= (Output operation 0) (ValueNameRef row)))
      ((ArrayOuterBound row (IndexConstant n))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (LengthMeasure operation 0 array length))
      ((ArrayOuterBound array (IndexValue length))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef array)) (= (OutputRole operation slot) (CollectedOutput))
       (= domain (OperationDomain operation)) (= bound (DomainExtent domain 0)))
      ((ArrayOuterBound array bound)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef array)) (= (OutputRole operation slot) (PrefixOutput))
       (= domain (OperationDomain operation)) (= bound (DomainExtent domain 0)))
      ((ArrayOuterBound array bound)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry loop slot carry initial next)
       (ArrayOuterBound initial bound) (ArrayOuterBound next bound))
      ((ArrayOuterBound carry bound) (LoopMatchesOuterBound loop slot)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= (SourceAlias (FlowNamed array)) (FlowNamed source)) (ArrayOuterBound source bound))
      ((ArrayOuterBound array bound)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (RangeOperation operation) (= (Output operation 0) (ValueNameRef array))
       (= count (OperationIndex operation 0)))
      ((ArrayOuterBound array (IndexMax (IndexConstant 0) count))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (ArrayOuterBound array bound) (IndexCalculationOperation operation)
       (= bound (OperationIndex operation 0)) (= (Output operation 0) (ValueNameRef value)))
      ((ArrayOuterBound array (IndexValue value))) :ruleset dataflow-dependencies)
; If a combiner preserves its left length, the neutral and lane widths fix both operands.
(rule ((= revision (AnalysisRevision)) (= (ResultKindOf operation clause) (Folded kind))
       (= (ResultNeutralCount operation clause) 1) (= (ResultValueCount operation clause) 1)
       (= (ResultNeutral operation clause 0) (ValueNameRef neutral)) (ArrayOuterBound neutral initial)
       (= (ResultValue operation clause 0) (ValueNameRef item)) (ArrayOuterBound item input)
       (ConstantBound initial n) (ConstantBound input n)
       (= region (ResultReducer operation clause)) (= (RegionParameterCount region) 2)
       (= (RegionParameter region 0) (ValueNameRef left)) (= (RegionParameter region 1) (ValueNameRef right))
       (= (wyn-yield region 0) (ValueNameRef result))
       (LengthMeasure length 0 left count)
        (ArrayOuterBound result (IndexValue count)))
      ((ArrayOuterBound left (IndexConstant n)) (ArrayOuterBound right (IndexConstant n))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (ArrayOuterBound array bound) (ConstantBound bound n)
       (LengthMeasure length 0 array count))
      ((ConstantBound (IndexValue count) n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= bound (IndexConstant n)))
      ((ConstantBound bound n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= bound (IndexValue name)) (= (Output operation 0) (ValueNameRef name))
       (= n (LiteralBits operation)) (= (ValueType name) (ScalarInfo (ScalarElement (I32)))))
      ((ConstantBound bound n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (LengthMeasure operation axis array name)
       (= (ValueType array) (LogicalValue (ArrayType ownership extents element)))
       (>= axis 0) (< axis (vec-length extents)) (= (vec-get extents axis) (FixedExtent n)))
      ((ConstantBound (IndexValue name) n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (IndexCalculationOperation operation) (= index (OperationIndex operation 0))
       (= (Output operation 0) (ValueNameRef name)) (ConstantBound index n))
      ((ConstantBound (IndexValue name) n)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= index (IndexMax a b)) (ConstantBound a x) (ConstantBound b y))
      ((ConstantBound index (max x y))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= index (IndexMin a b)) (ConstantBound a x) (ConstantBound b y))
      ((ConstantBound index (min x y))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (IndexOperands operation array axis)
       (= lane (wyn-region-of operation)) (= parallel (RegionOwnedBy lane))
       (= lane (wyn-control-region parallel 0)) (= domain (OperationDomain parallel))
       (= axis (DomainAxis domain slot))
       (= bound (DomainExtent domain slot)) (ArrayOuterBound array bound))
      ((TotalIndex operation)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (IndexOperands operation array name)
       (ArrayOuterBound array bound) (ConstantBound bound n)
       (ConstantBound (IndexValue name) index)
       (>= index 0) (< index n))
      ((TotalIndex operation)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (IndexOperands operation array axis)
       (= lane (wyn-region-of operation)) (= parallel (RegionOwnedBy lane))
       (= lane (wyn-control-region parallel 0)) (= domain (OperationDomain parallel))
       (= axis (DomainAxis domain slot))
       (= bound (DomainExtent domain slot)) (ArrayOuterBound array source-bound)
       (ConstantBound bound n) (ConstantBound source-bound n))
      ((TotalIndex operation)) :ruleset dataflow-dependencies)

(rule ((= revision (AnalysisRevision)) (OperationUse operation (AccNameRef token))
       (= (AccumulatorType token) (AccumulatorInfo shape elements)) (ShapeUse shape name))
      ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (EndDemand region (AccNameRef token))
       (= (AccumulatorType token) (AccumulatorInfo shape elements)) (ShapeUse shape name))
      ((EndDemand region (ValueNameRef name)) (RegionAttributeUse region (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (= (RegionParameter region slot) (AccNameRef token))
       (= (AccumulatorType token) (AccumulatorInfo shape elements)) (ShapeUse shape name)
       (DefinitionRegion (ValueNameRef name) definition) (!= region definition))
      ((EntryDemand region (ValueNameRef name)) (RegionCapture region (ValueNameRef name))
       (RegionAttributeUse region (ValueNameRef name))) :ruleset dataflow-dependencies)

(rule ((= revision (AnalysisRevision)) (DirectOperationUse operation name))
      ((OperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((= revision (AnalysisRevision)) (OperationAttributeUse operation name))
      ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
