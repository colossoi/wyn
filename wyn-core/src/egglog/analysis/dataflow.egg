; Definitions and execution scopes are read directly from the editable graph.
(rule ((LiveRegion region))
      ((FlowScopeAncestor region region)) :ruleset graph-structure)
(rule ((LiveRegion child) (= (RegionOwnedBy child) operation) (= parent (wyn-region-of operation)))
      ((FlowScopeParent child parent)) :ruleset graph-structure)
(rule ((LiveRegion child) (FlowScopeParent child parent) (FlowScopeAncestor child parent))
      ((InvalidDataflow (InvalidAtRegion child) "cyclic execution-region nesting")) :ruleset graph-structure)


; Index, shape, and slice facts follow immutable terms across graph edits.
(rule ((= (AccumulatorType token) (AccumulatorInfo shape elements)))
      ((ShapeDemand shape)) :ruleset graph-indices)
(rule ((= index (IndexValue name))) ((IndexUse index name)) :ruleset graph-indices)
(rule ((= index (IndexAdd a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((= index (IndexSub a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((= index (IndexMul a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((= index (IndexDiv a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((= index (IndexMod a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((= index (IndexMin a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((= index (IndexMax a b))) ((IndexChild index a) (IndexChild index b)) :ruleset graph-indices)
(rule ((IndexChild parent child) (IndexUse child name)) ((IndexUse parent name)) :ruleset graph-indices)
(rule ((ShapeDemand shape)) ((ShapeWalk shape 0)) :ruleset graph-indices)
(rule ((ShapeWalk shape slot) (< slot (vec-length shape)))
      ((set (ShapeAt shape slot) (vec-get shape slot)) (ShapeWalk shape (+ slot 1))) :ruleset graph-indices)
(rule ((= index (ShapeAt shape slot)) (IndexUse index name))
      ((ShapeUse shape name)) :ruleset graph-indices)
(rule ((SliceDemand slices)) ((SliceWalk slices 0)) :ruleset graph-indices)
(rule ((SliceWalk slices slot) (< slot (vec-length slices)))
      ((set (SliceAt slices slot) (vec-get slices slot)) (SliceWalk slices (+ slot 1))) :ruleset graph-indices)
(rule ((= (SliceAt slices slot) (At index)) (IndexUse index name))
      ((SliceUse slices name)) :ruleset graph-indices)
(rule ((= (SliceAt slices slot) (Slice a b c)) (IndexUse a name)) ((SliceUse slices name)) :ruleset graph-indices)
(rule ((= (SliceAt slices slot) (Slice a b c)) (IndexUse b name)) ((SliceUse slices name)) :ruleset graph-indices)
(rule ((= (SliceAt slices slot) (Slice a b c)) (IndexUse c name)) ((SliceUse slices name)) :ruleset graph-indices)

(rule ((CollectiveScopeUse region name)) ((EndDemand region name)) :ruleset dataflow-dependencies)
(rule ((FoldSeedUse operation name)) ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((AccumulatorBackingUse operation group slot array))
      ((OperationAttributeUse operation (ValueNameRef array))) :ruleset dataflow-dependencies)
(rule ((= operation (RegionOwnedBy child)) (BranchArm edge)
       (= child (wyn-control-region operation edge)) (FormalOrigin parameter child slot)
       (= name (wyn-edge-argument operation edge slot)))
      ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((OperationUse operation name) (= region (wyn-region-of operation))
       (DefinitionRegion name owner) (!= region owner))
      ((RegionCapture region name)) :ruleset dataflow-dependencies)
(rule ((= (RegionOwnedBy child) operation) (RegionCapture child name))
      ((OperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((EndDemand region name) (DefinitionRegion name owner)
       (!= region owner) (= (wyn-region-yields region name) true))
      ((RegionCapture region name)) :ruleset dataflow-dependencies)
(rule ((CollectiveScopeUse region name) (DefinitionRegion name owner) (!= region owner))
      ((RegionCapture region name)) :ruleset dataflow-dependencies)

(rule ((DefinitionRegion (ValueNameRef array) proof-region) (= (ValueType array) (LogicalValue (ArrayType ownership extents element)))
       (> (vec-length extents) 0) (= (vec-get extents 0) (FixedExtent n)))
      ((ArrayOuterBound array (IndexConstant n))) :ruleset dataflow-dependencies)
(rule ((DefinitionRegion (ValueNameRef array) proof-region) (= (ValueType array) (LogicalValue (ArrayType ownership extents element)))
       (> (vec-length extents) 1) (= (vec-get extents 1) (FixedExtent n)))
      ((ArrayRowWidth array n)) :ruleset dataflow-dependencies)
(rule ((ParallelOperation operation) (= (wyn-domain-rank (wyn-iteration-domain operation)) 1)
       (ResultOrigin (ValueNameRef array) operation slot) (= (wyn-output-role operation slot) (CollectedOutput))
       (= clause (wyn-output-clause operation slot)) (= field (wyn-output-field operation slot))
       (CollectiveLaneUse operation clause (ValueNameRef row)) (= (wyn-contribution operation clause field) (ValueNameRef row)) (ArrayOuterBound row bound) (ConstantBound bound n))
      ((ArrayRowWidth array n)) :ruleset dataflow-dependencies)
(rule ((IndexOperands operation (ValueNameRef array) (ValueNameRef index))
       (ArrayRowWidth array n)
       (ResultOrigin (ValueNameRef row) operation 0))
      ((ArrayOuterBound row (IndexConstant n))) :ruleset dataflow-dependencies)
(rule ((DefinitionRegion (ValueNameRef array) proof-region) (LengthMeasure operation 0 (ValueNameRef array) (ValueNameRef length)))
      ((ArrayOuterBound array (IndexValue length))) :ruleset dataflow-dependencies)
(rule ((ParallelOperation operation)
       (ResultOrigin (ValueNameRef array) operation slot) (= (wyn-output-role operation slot) (CollectedOutput))
       (= domain (wyn-iteration-domain operation)) (= bound (wyn-domain-extent domain 0)))
      ((ArrayOuterBound array bound)) :ruleset dataflow-dependencies)
(rule ((ParallelOperation operation)
       (ResultOrigin (ValueNameRef array) operation slot) (= (wyn-output-role operation slot) (PrefixOutput))
       (= domain (wyn-iteration-domain operation)) (= bound (wyn-domain-extent domain 0)))
      ((ArrayOuterBound array bound)) :ruleset dataflow-dependencies)
(rule ((LoopValueCarry loop slot carry initial next)
       (ArrayOuterBound initial bound) (ArrayOuterBound next bound))
      ((ArrayOuterBound carry bound) (LoopMatchesOuterBound loop slot)) :ruleset dataflow-dependencies)
(rule ((= (ProjectionAlias (ValueNameRef array)) (ValueNameRef source)) (ArrayOuterBound source bound))
      ((ArrayOuterBound array bound)) :ruleset dataflow-dependencies)
(rule ((RangeOperation operation) (ResultOrigin (ValueNameRef array) operation 0)
       (= count (wyn-index-expression operation)))
      ((ArrayOuterBound array (IndexMax (IndexConstant 0) count))) :ruleset dataflow-dependencies)
(rule ((ArrayOuterBound array bound) (IndexCalculationOperation operation)
       (= bound (wyn-index-expression operation)) (ResultOrigin (ValueNameRef value) operation 0))
      ((ArrayOuterBound array (IndexValue value))) :ruleset dataflow-dependencies)
(relation ReducerWidthInputs (OperationKey i64 ValueName ValueName ValueName))
(rule ((ReducerBody operation clause region) (= (wyn-parameter-count region) 2)
       (FormalOrigin (ValueNameRef left) region 0) (FormalOrigin (ValueNameRef right) region 1)
       (EndDemand region (ValueNameRef result)) (= (wyn-yield region 0) (ValueNameRef result)))
      ((ReducerWidthInputs operation clause left right result)) :ruleset dataflow-dependencies)
; If a combiner preserves its left length, the neutral and lane widths fix both operands.
(rule ((ReducerWidthInputs operation clause left right result)
       (FoldClause operation clause kind)
       (= (wyn-fold-seed-count operation clause) 1) (= (wyn-contribution-count operation clause) 1)
       (FoldSeedUse operation (ValueNameRef neutral)) (= (wyn-fold-seed operation clause 0) (ValueNameRef neutral)) (ArrayOuterBound neutral initial)
       (CollectiveLaneUse operation clause (ValueNameRef item)) (= (wyn-contribution operation clause 0) (ValueNameRef item)) (ArrayOuterBound item input)
       (ConstantBound initial n) (ConstantBound input n)
       (LengthMeasure length 0 (ValueNameRef left) (ValueNameRef count))
       (ArrayOuterBound result (IndexValue count)))
      ((ArrayOuterBound left (IndexConstant n)) (ArrayOuterBound right (IndexConstant n))) :ruleset dataflow-dependencies)
(rule ((ArrayOuterBound array bound) (ConstantBound bound n)
       (LengthMeasure length 0 (ValueNameRef array) (ValueNameRef count)))
      ((ConstantBound (IndexValue count) n)) :ruleset dataflow-dependencies)
(rule ((= bound (IndexConstant n)))
      ((ConstantBound bound n)) :ruleset dataflow-dependencies)
(rule ((= bound (IndexValue name)) (ResultOrigin (ValueNameRef name) operation 0)
       (= n (LiteralBits operation)) (= (ValueType name) (ScalarInfo (ScalarElement (I32)))))
      ((ConstantBound bound n)) :ruleset dataflow-dependencies)
(rule ((LiveOperation operation) (LengthMeasure operation axis (ValueNameRef array) (ValueNameRef name))
       (= (ValueType array) (LogicalValue (ArrayType ownership extents element)))
       (>= axis 0) (< axis (vec-length extents)) (= (vec-get extents axis) (FixedExtent n)))
      ((ConstantBound (IndexValue name) n)) :ruleset dataflow-dependencies)
(rule ((IndexCalculationOperation operation) (= index (wyn-index-expression operation))
       (ResultOrigin (ValueNameRef name) operation 0) (ConstantBound index n))
      ((ConstantBound (IndexValue name) n)) :ruleset dataflow-dependencies)
(rule ((= index (IndexMax a b)) (ConstantBound a x) (ConstantBound b y))
      ((ConstantBound index (max x y))) :ruleset dataflow-dependencies)
(rule ((= index (IndexMin a b)) (ConstantBound a x) (ConstantBound b y))
      ((ConstantBound index (min x y))) :ruleset dataflow-dependencies)
(rule ((IndexOperands operation (ValueNameRef array) (ValueNameRef axis))
       (= lane (wyn-region-of operation)) (LaneAxisExtent lane axis bound) (ArrayOuterBound array bound))
      ((TotalIndex operation)) :ruleset dataflow-dependencies)
(rule ((IndexOperands operation (ValueNameRef array) (ValueNameRef name))
       (ArrayOuterBound array bound) (ConstantBound bound n)
       (ConstantBound (IndexValue name) index)
       (>= index 0) (< index n))
      ((TotalIndex operation)) :ruleset dataflow-dependencies)
(rule ((IndexOperands operation (ValueNameRef array) (ValueNameRef axis))
       (= lane (wyn-region-of operation)) (LaneAxisExtent lane axis bound) (ArrayOuterBound array source-bound)
       (ConstantBound bound n) (ConstantBound source-bound n))
      ((TotalIndex operation)) :ruleset dataflow-dependencies)

(rule ((OperationUse operation (AccNameRef token))
       (= (AccumulatorType token) (AccumulatorInfo shape elements)) (ShapeUse shape name))
      ((OperationAttributeUse operation (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((EndDemand region (AccNameRef token))
       (= (AccumulatorType token) (AccumulatorInfo shape elements)) (ShapeUse shape name))
      ((EndDemand region (ValueNameRef name)) (RegionAttributeUse region (ValueNameRef name))) :ruleset dataflow-dependencies)
(rule ((FormalOrigin (AccNameRef token) region slot)
       (= (AccumulatorType token) (AccumulatorInfo shape elements)) (ShapeUse shape name)
       (DefinitionRegion (ValueNameRef name) definition) (!= region definition))
      ((RegionCapture region (ValueNameRef name))
       (RegionAttributeUse region (ValueNameRef name))) :ruleset dataflow-dependencies)

(rule ((DirectOperationUse operation name))
      ((OperationUse operation name)) :ruleset dataflow-dependencies)
(rule ((OperationAttributeUse operation name))
      ((DirectOperationUse operation name)) :ruleset dataflow-dependencies)
