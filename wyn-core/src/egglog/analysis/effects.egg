; Walk adjacent operations to delimit read-only intervals with writes.
(function PreviousWrite (OperationKey) OperationKey :no-merge)
(function NextWrite (OperationKey) OperationKey :no-merge)
(ruleset effect-positions)
(ruleset effect-edges)
(rule ((SourceNextOperation before after) (= v (SourceOperationValue before))
       (= (SourceReadOnly v) false))
      ((set (PreviousWrite after) before)) :ruleset effect-positions)
(rule ((SourceNextOperation before after) (= v (SourceOperationValue before))
       (= (SourceReadOnly v) true) (= write (PreviousWrite before)))
      ((set (PreviousWrite after) write)) :ruleset effect-positions)
(rule ((SourceNextOperation before after) (= v (SourceOperationValue after))
       (= (SourceReadOnly v) false))
      ((set (NextWrite before) after)) :ruleset effect-positions)
(rule ((SourceNextOperation before after) (= v (SourceOperationValue after))
       (= (SourceReadOnly v) true) (= write (NextWrite after)))
      ((set (NextWrite before) write)) :ruleset effect-positions)
(rule ((= before (PreviousWrite after)))
      ((ImportedEffectOrder before after)) :ruleset effect-edges)
(rule ((= after (NextWrite before)) (= v (SourceOperationValue before))
       (= (SourceReadOnly v) true))
      ((ImportedEffectOrder before after)) :ruleset effect-edges)
