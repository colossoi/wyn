; Alias roots are demanded by real accesses, not materialized for every value.
(rule ((= (ValueType value) (LogicalValue (ArrayType (StorageArray) extents element))))
      ((StorageValue value) (ArrayValue value)) :ruleset dataflow-resources)
(rule ((= (ValueType value) (LogicalValue (ArrayType (ValueArray) extents element))))
      ((ArrayValue value)) :ruleset dataflow-resources)
; Accumulator capabilities inherit their arrays' roots; they are not external inputs.
(rule ((FormalOrigin (ValueNameRef value) region slot))
      ((ResourceAnchor (ValueNameRef value))) :ruleset dataflow-resources)
(rule ((CallOperation operation) (ResultOrigin name operation slot))
      ((ResourceAnchor name)) :ruleset dataflow-resources)
(rule ((ResourceDemand name) (ResourceAnchor name))
      ((ResourceRoot name (ExternalMemory))) :ruleset dataflow-resources)
(rule ((FreshOutput operation slot) (ResultOrigin name operation slot))
      ((ResourceRoot name (FreshResource name))) :ruleset dataflow-resources)
(rule ((AliasesInput operation output input) (ResultOrigin result operation output) (= source (wyn-input operation input)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((ProjectionOperation operation field) (ResultOrigin result operation 0) (= source (wyn-input operation 0)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((ProductOperation operation)
       (= arity (wyn-input-count operation)) (AritySlot arity slot) (ResultOrigin result operation 0) (= source (wyn-input operation slot)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((= (ProjectionAlias (ValueNameRef result)) (ValueNameRef source)))
      ((ResourceParent (ValueNameRef result) (ValueNameRef source))) :ruleset dataflow-resources)
(rule ((IndexOperation operation) (ResultOrigin result operation 0) (= source (wyn-input operation 0)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((ResourceDemand child) (ResourceParent child parent))
      ((ResourceDemand parent)) :ruleset dataflow-resources)
(rule ((ResourceDemand child) (ResourceParent child parent) (ResourceRoot parent root))
      ((ResourceRoot child root)) :ruleset dataflow-resources)

(rule ((= operation (RegionOwnedBy region))
       (= region (wyn-control-region operation 0)) (= initial (wyn-edge-argument operation 0 slot))
       (FormalOrigin parameter region slot))
      ((ResourceParent parameter initial)) :ruleset dataflow-resources)
(rule ((BranchOperation operation) (BranchArm edge)
       (ResultOrigin result operation slot) (= yielded (wyn-control-yield operation edge slot)))
      ((ResourceParent result yielded)) :ruleset dataflow-resources)
(rule ((CountedLoopOperation operation) (= child (wyn-control-region operation 0))
       (ResultOrigin result operation slot) (= yielded (wyn-yield child slot)))
      ((ResourceParent result yielded)) :ruleset dataflow-resources)
(rule ((WhileLoopOperation operation) (= child (wyn-control-region operation 0))
       (ResultOrigin result operation slot) (= yielded (wyn-yield child slot)))
      ((ResourceParent result yielded)) :ruleset dataflow-resources)
(rule ((ParallelOperation operation) (= clause (wyn-output-clause operation slot)) (= field (wyn-output-field operation slot))
       (ContributedClause operation clause)
       (ResultOrigin result operation slot) (= source (wyn-contribution operation clause field)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((AccumulatorOperation operation) (= body (wyn-control-region operation 0))
       (= (wyn-parameter body group) (AccNameRef token))
       (AccumulatorBackingUse operation group slot array))
      ((set (AccumulatorParameter operation group) token)
       (TokenArray token (ValueNameRef array))
       (ResourceParent (AccNameRef token) (ValueNameRef array))) :ruleset dataflow-resources)
(rule ((AccumulatorOperation operation) (ResultOrigin result operation output)
       (AccumulatorBackingUse operation group slot array))
      ((ResourceParent result (ValueNameRef array))) :ruleset dataflow-resources)

(rule ((ReadsInput operation slot) (DirectOperationUse operation (ValueNameRef value)) (= (wyn-input operation slot) (ValueNameRef value)) (StorageValue value))
      ((ResourceDemand (ValueNameRef value))) :ruleset dataflow-resources)
(rule ((DefinitionRegion name proof-region) (WritesInput operation slot) (= name (wyn-input operation slot)))
      ((ResourceDemand name)) :ruleset dataflow-resources)
(rule ((ReadsInput operation slot) (DirectOperationUse operation (ValueNameRef value)) (= (wyn-input operation slot) (ValueNameRef value)) (StorageValue value)
       (ResourceRoot (ValueNameRef value) root))
      ((OperationRead operation root)) :ruleset dataflow-effects)
(rule ((WritesInput operation slot) (DirectOperationUse operation name) (= name (wyn-input operation slot)) (ResourceRoot name root))
      ((OperationWrite operation root)) :ruleset dataflow-effects)
(rule ((LiveOperation operation) (OrderedOperation operation)) ((set (OperationTotal operation) false)) :ruleset dataflow-total)
(rule ((TotalIndex operation)) ((set (OperationTotal operation) true)) :ruleset dataflow-total)
(rule ((LiveOperation operation) (ReadsInput operation slot))
      ((set (DiscardableRead operation) false)) :ruleset dataflow-total)
(rule ((TotalIndex operation))
      ((set (DiscardableRead operation) true)) :ruleset dataflow-total)
(rule ((LiveOperation operation) (ProvenTotalOperation operation)) ((set (OperationTotal operation) true)) :ruleset dataflow-total)
; A positive i32 divisor excludes both zero and the signed overflow case.
(rule ((= payload (ScalarPayload operation)) (DivisionPayload payload)
       (DirectOperationUse operation (ValueNameRef divisor)) (= (wyn-input operation 1) (ValueNameRef divisor)) (= (ValueType divisor) (ScalarInfo (ScalarElement (I32))))
       (ResultOrigin (ValueNameRef divisor) literal 0) (= bits (LiteralBits literal))
       (> bits 0) (<= bits 2147483647))
      ((set (OperationTotal operation) true)) :ruleset dataflow-total)
(rule ((OrderedOperation operation) (= (OperationTotal operation) false))
      ((OperationTrap operation)) :ruleset dataflow-effects)
(rule ((LiveOperation operation) (CallOperation operation) (= target (wyn-call-target operation)) (= (wyn-external target) true))
      ((OperationTrap operation) (OperationRead operation (ExternalMemory))
       (OperationWrite operation (ExternalMemory))) :ruleset dataflow-effects)
(rule ((= region (wyn-region-of operation)) (OperationRead operation root))
      ((RegionRead region root)) :ruleset dataflow-effects)
(rule ((= region (wyn-region-of operation)) (OperationWrite operation root))
      ((RegionWrite region root)) :ruleset dataflow-effects)
(rule ((= region (wyn-region-of operation)) (OperationTrap operation))
      ((RegionTrap region)) :ruleset dataflow-effects)
(rule ((= (RegionOwnedBy child) operation) (RegionRead child root))
      ((OperationRead operation root)) :ruleset dataflow-effects)
(rule ((= (RegionOwnedBy child) operation) (RegionWrite child root))
      ((OperationWrite operation root)) :ruleset dataflow-effects)
(rule ((= (RegionOwnedBy child) operation) (RegionTrap child))
      ((OperationTrap operation)) :ruleset dataflow-effects)
(rule ((CallBody operation root) (RegionRead root resource))
      ((OperationRead operation resource)) :ruleset dataflow-effects)
(rule ((CallBody operation root) (RegionWrite root resource))
      ((OperationWrite operation resource)) :ruleset dataflow-effects)
(rule ((CallBody operation root) (RegionTrap root))
      ((OperationTrap operation)) :ruleset dataflow-effects)

; Transformation candidates request only the effect comparisons they need.
(rule ((EffectCompare left right) (OperationWrite left root) (OperationRead right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((EffectCompare left right) (OperationRead left root) (OperationWrite right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((EffectCompare left right) (OperationWrite left root) (OperationWrite right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((EffectCompare left right) (OperationTrap left) (OperationTrap right))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((EffectCompare left right) (OperationTrap left) (OperationWrite right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((EffectCompare left right) (OperationWrite left root) (OperationTrap right))
      ((OperationsConflict left right)) :ruleset dataflow-effects)

; Collections allocate their own result storage; prefix and compact roles are explicit.
(rule ((ParallelOperation operation)
       (ResultOrigin (ValueNameRef name) operation slot) (= (wyn-output-role operation slot) (CollectedOutput)))
      ((ResourceRoot (ValueNameRef name) (FreshResource (ValueNameRef name)))) :ruleset dataflow-resources)
(rule ((ParallelOperation operation)
       (ResultOrigin (ValueNameRef name) operation slot) (= (wyn-output-role operation slot) (CompactedOutput)))
      ((ResourceRoot (ValueNameRef name) (FreshResource (ValueNameRef name)))) :ruleset dataflow-resources)
(rule ((ParallelOperation operation)
       (ResultOrigin (ValueNameRef name) operation slot) (= (wyn-output-role operation slot) (PrefixOutput)))
      ((ResourceRoot (ValueNameRef name) (FreshResource (ValueNameRef name)))) :ruleset dataflow-resources)

(rule ((AccumulatorOperation operation) (= token (AccumulatorParameter operation group)))
      ((set (TokenCapability token) (TokenBindingAt operation group))) :ruleset dataflow-resources)
(rule ((DirectOperationUse operation (AccNameRef token)) (= (wyn-input operation 0) (AccNameRef token)) (ResultOrigin (AccNameRef result) operation 0)
       (= capability (TokenCapability token)))
      ((set (TokenCapability result) capability)) :ruleset dataflow-resources)
(rule ((ResourceParent (AccNameRef result) (AccNameRef source))
       (= capability (TokenCapability source)))
      ((set (TokenCapability result) capability)) :ruleset dataflow-resources)

; Capabilities are consumed at occurrences, including captures crossing a control edge.
(rule ((LiveOperation operation) (ConsumesInput operation slot) (= (wyn-input operation slot) (AccNameRef token)))
      ((ConsumedToken operation token)) :ruleset dataflow-resources)
(rule ((= operation (RegionOwnedBy child)) (BranchArm edge)
       (= child (wyn-control-region operation edge)) (FormalOrigin parameter child slot)
       (= (wyn-edge-argument operation edge slot) (AccNameRef token)))
      ((ConsumedToken operation token)) :ruleset dataflow-resources)
(rule ((ConsumedToken operation token) (= region (wyn-region-of operation))
       (= (RegionOwnedBy region) owner) (DefinitionRegion (AccNameRef token) definition) (!= definition region))
      ((ConsumedToken owner token)) :ruleset dataflow-resources)
(rule ((OperationUse operation (AccNameRef token))
       (ConsumedToken consumer token) (= region (wyn-region-of consumer)) (= region (wyn-region-of operation))
       (= before (wyn-operation-position consumer)) (= after (wyn-operation-position operation)) (< before after))
      ((TokenUnavailableAt operation token) (InvalidDataflow "accumulator capability was already consumed")) :ruleset dataflow-resources)
(rule ((EndDemand region (AccNameRef token)) (ConsumedToken consumer token)
       (= region (wyn-region-of consumer)))
      ((InvalidDataflow "region yields a consumed accumulator capability")) :ruleset dataflow-resources)

(rule ((CallOperation operation) (= target (wyn-call-target operation)) (= (RecursiveFunction target) true))
      ((OperationTrap operation)) :ruleset dataflow-effects)
(rule ((LiveOperation operation) (= (InputDiet operation slot) (Consume))
       (= (wyn-input operation slot) (AccNameRef token)))
      ((ConsumedToken operation token)) :ruleset dataflow-resources)

; Hoisting may repeat total reads only when they commute with the enclosing writes.
(rule ((LiveOperation operation))
      ((set (MovableOperation operation) true)) :ruleset dataflow-motion)
(rule ((OperationTrap operation))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((OperationWrite operation resource))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((LiveOperation operation) (MaterializedCopyOperation operation))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((ConsumedToken operation token))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((LiveOperation operation) (LaneDependentOperation operation))
      ((InvocationDependent operation)) :ruleset dataflow-motion)
(rule ((InvocationDependent operation) (= region (wyn-region-of operation)))
      ((InvocationRegion region)) :ruleset dataflow-motion)
(rule ((InvocationRegion region) (= (RegionOwnedBy region) operation))
      ((InvocationDependent operation)) :ruleset dataflow-motion)
(rule ((InvocationRegion region) (CallBody operation region))
      ((InvocationDependent operation)) :ruleset dataflow-motion)

(function PureOperation (OperationKey) bool :merge (and old new))
(rule ((LiveOperation operation))
      ((set (PureOperation operation) true)) :ruleset dataflow-purity)
(rule ((OperationRead operation resource))
      ((set (PureOperation operation) false)) :ruleset dataflow-purity)
(rule ((OperationWrite operation resource))
      ((set (PureOperation operation) false)) :ruleset dataflow-purity)
(rule ((OperationTrap operation))
      ((set (PureOperation operation) false)) :ruleset dataflow-purity)
