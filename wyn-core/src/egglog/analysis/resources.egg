; Alias roots are demanded by real accesses, not materialized for every value.
(rule ((= revision (AnalysisRevision)) (= (ValueType value) (LogicalValue (ArrayType (StorageArray) extents element))))
      ((StorageValue value) (ArrayValue value)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (= (ValueType value) (LogicalValue (ArrayType (ValueArray) extents element))))
      ((ArrayValue value)) :ruleset dataflow-resources)
; Accumulator capabilities inherit their arrays' roots; they are not external inputs.
(rule ((= revision (AnalysisRevision)) (= (ValueNameRef value) (RegionParameter region slot)))
      ((ResourceAnchor (ValueNameRef value))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (CallOperation operation) (= name (Output operation slot)))
      ((ResourceAnchor name)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ResourceDemand name) (ResourceAnchor name))
      ((ResourceRoot name (ExternalMemory))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (FreshOutput operation slot) (= name (Output operation slot)))
      ((ResourceRoot name (FreshResource name))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (AliasesInput operation output input) (= result (Output operation output)) (= source (Input operation input)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ProjectionOperation operation field) (= result (Output operation 0)) (= source (Input operation 0)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ProductOperation operation) (= result (Output operation 0)) (= source (Input operation slot)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (= (SourceAlias (FlowNamed result)) (FlowNamed source)))
      ((ResourceParent (ValueNameRef result) (ValueNameRef source))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (IndexOperation operation) (= result (Output operation 0)) (= source (Input operation 0)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ResourceDemand child) (ResourceParent child parent))
      ((ResourceDemand parent)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ResourceDemand child) (ResourceParent child parent) (ResourceRoot parent root))
      ((ResourceRoot child root)) :ruleset dataflow-resources)

(rule ((= revision (AnalysisRevision)) (= region (ControlRegion operation 0)) (= initial (EdgeArgument operation 0 slot))
       (= parameter (RegionParameter region slot)))
      ((ResourceParent parameter initial)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (BranchOperation operation) (= child (ControlRegion operation edge))
       (= result (Output operation slot)) (= yielded (RegionYield child slot)))
      ((ResourceParent result yielded)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (CountedLoopOperation operation) (= child (ControlRegion operation 0))
       (= result (Output operation slot)) (= yielded (RegionYield child slot)))
      ((ResourceParent result yielded)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (WhileLoopOperation operation) (= child (ControlRegion operation 0))
       (= result (Output operation slot)) (= yielded (RegionYield child slot)))
      ((ResourceParent result yielded)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= clause (OutputClause operation slot)) (= field (OutputField operation slot))
       (= (ResultKindOf operation clause) (Contributed))
       (= result (Output operation slot)) (= source (ResultValue operation clause field)))
      ((ResourceParent result source)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (AccumulatorOperation operation) (= body (ControlRegion operation 0))
       (= (RegionParameter body group) (AccNameRef token))
       (= array (AccumulatorArray operation group slot)))
      ((set (AccumulatorParameter operation group) token)
       (TokenArray token (ValueNameRef array))
       (ResourceParent (AccNameRef token) (ValueNameRef array))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (AccumulatorOperation operation) (= result (Output operation output))
       (= array (AccumulatorArray operation group slot)))
      ((ResourceParent result (ValueNameRef array))) :ruleset dataflow-resources)

(rule ((= revision (AnalysisRevision)) (ReadsInput operation slot) (= (Input operation slot) (ValueNameRef value)) (StorageValue value))
      ((ResourceDemand (ValueNameRef value))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (WritesInput operation slot) (= name (Input operation slot)))
      ((ResourceDemand name)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ReadsInput operation slot) (= (Input operation slot) (ValueNameRef value)) (StorageValue value)
       (ResourceRoot (ValueNameRef value) root))
      ((OperationRead operation root)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (WritesInput operation slot) (= name (Input operation slot)) (ResourceRoot name root))
      ((OperationWrite operation root)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (OrderedOperation operation)) ((set (OperationTotal operation) false)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (TotalIndex operation)) ((set (OperationTotal operation) true)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (ReadsInput operation slot))
      ((set (DiscardableRead operation) false)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (TotalIndex operation))
      ((set (DiscardableRead operation) true)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (ProvenTotalOperation operation)) ((set (OperationTotal operation) true)) :ruleset dataflow-total)
; A positive i32 divisor excludes both zero and the signed overflow case.
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (DivisionPayload payload)
       (= (Input operation 1) (ValueNameRef divisor)) (= (ValueType divisor) (ScalarInfo (ScalarElement (I32))))
       (= (Defines (ValueNameRef divisor)) (OperationSite literal 0)) (= bits (LiteralBits literal))
       (> bits 0) (<= bits 2147483647))
      ((set (OperationTotal operation) true)) :ruleset dataflow-total)
(relation ThirtyTwoBitInteger (PrimType))
(ThirtyTwoBitInteger (I32)) (ThirtyTwoBitInteger (U32))
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (ShiftPayload payload)
       (= (Input operation 0) (ValueNameRef value)) (= (ValueType value) (ScalarInfo (ScalarElement primitive)))
       (ThirtyTwoBitInteger primitive) (= (Input operation 1) (ValueNameRef amount))
       (= (ValueType amount) (ScalarInfo (ScalarElement primitive)))
       (= (Defines (ValueNameRef amount)) (OperationSite literal 0)) (= shift (LiteralBits literal))
       (>= shift 0) (< shift 32))
      ((set (OperationTotal operation) true)) :ruleset dataflow-total)
(rule ((= revision (AnalysisRevision)) (OrderedOperation operation) (= (OperationTotal operation) false))
      ((OperationTrap operation)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (CallOperation operation) (= target (CallTarget operation)) (External target))
      ((OperationTrap operation) (OperationRead operation (ExternalMemory))
       (OperationWrite operation (ExternalMemory))) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= region (OperationRegion operation)) (OperationRead operation root))
      ((RegionRead region root)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= region (OperationRegion operation)) (OperationWrite operation root))
      ((RegionWrite region root)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= region (OperationRegion operation)) (OperationTrap operation))
      ((RegionTrap region)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= (RegionOwnedBy child) operation) (RegionRead child root))
      ((OperationRead operation root)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= (RegionOwnedBy child) operation) (RegionWrite child root))
      ((OperationWrite operation root)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= (RegionOwnedBy child) operation) (RegionTrap child))
      ((OperationTrap operation)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (CallOperation operation) (= target (CallTarget operation)) (= root (FunctionRoot target)) (RegionRead root resource))
      ((OperationRead operation resource)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (CallOperation operation) (= target (CallTarget operation)) (= root (FunctionRoot target)) (RegionWrite root resource))
      ((OperationWrite operation resource)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (CallOperation operation) (= target (CallTarget operation)) (= root (FunctionRoot target)) (RegionTrap root))
      ((OperationTrap operation)) :ruleset dataflow-effects)

; Transformation candidates request only the effect comparisons they need.
(rule ((= revision (AnalysisRevision)) (EffectCompare left right) (OperationWrite left root) (OperationRead right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (EffectCompare left right) (OperationRead left root) (OperationWrite right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (EffectCompare left right) (OperationWrite left root) (OperationWrite right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (EffectCompare left right) (OperationTrap left) (OperationTrap right))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (EffectCompare left right) (OperationTrap left) (OperationWrite right root))
      ((OperationsConflict left right)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (EffectCompare left right) (OperationWrite left root) (OperationTrap right))
      ((OperationsConflict left right)) :ruleset dataflow-effects)

; Shared liveness uses the existing flow-live solver and occurrence boundaries.
(rule ((LivenessRequest root) (FlowScopeAncestor root region) (LiveRegion region))
      ((LivenessRegion region)) :ruleset dataflow-live-index)
(rule ((LivenessRegion region) (= region (OperationRegion operation)) (LiveOperation operation))
      ((LivenessOperation operation)) :ruleset dataflow-live-index)
(rule ((LivenessOperation operation) (OperationUse operation name))
      ((LivenessName name)) :ruleset dataflow-live-index)
(rule ((LivenessOperation operation) (= name (Output operation slot)))
      ((LivenessName name)) :ruleset dataflow-live-index)
(rule ((LivenessRegion region) (EndDemand region name))
      ((LivenessName name)) :ruleset dataflow-live-index)
(rule ((LivenessRegion region) (FirstOperation region first))
      ((FlowNext (FlowRegion region) (OperationEvaluation first))) :ruleset dataflow-live-seeds)
(rule ((LivenessRegion region) (LastOperation region last))
      ((FlowNext (OperationEvaluation last) (FlowRegionEnd region))) :ruleset dataflow-live-seeds)
(rule ((LivenessRegion region) (EmptyRegion region))
      ((FlowNext (FlowRegion region) (FlowRegionEnd region))) :ruleset dataflow-live-seeds)
(rule ((LivenessOperation operation) (NextOperation operation next))
      ((FlowNext (OperationEvaluation operation) (OperationEvaluation next))) :ruleset dataflow-live-seeds)
(rule ((LivenessOperation operation))
      ((FlowExecution (OperationEvaluation operation) (OperationEvaluation operation) (OperationEvaluation operation))) :ruleset dataflow-live-seeds)
(rule ((LivenessOperation operation) (OperationUse operation name) (= ordinal (NameOrdinal name)))
      ((FlowLive (OperationEvaluation operation) ordinal)) :ruleset dataflow-live-seeds)
(rule ((LivenessOperation operation) (= name (Output operation slot)) (= ordinal (NameOrdinal name)))
      ((set (FlowKilled (OperationEvaluation operation) ordinal) true)) :ruleset dataflow-live-seeds)
(rule ((LivenessRegion region) (EndDemand region name) (= ordinal (NameOrdinal name)))
      ((FlowLive (FlowRegionEnd region) ordinal)) :ruleset dataflow-live-seeds)
(rule ((= revision (AnalysisRevision)) (FlowLiveAfter (OperationEvaluation operation) ordinal)
       (= ordinal (NameOrdinal name)))
      ((NameLiveAfter operation name)) :ruleset dataflow-live)
(rule ((= revision (AnalysisRevision)) (NameLiveAfter operation (ValueNameRef name)) (ArrayValue name))
      ((ResourceDemand (ValueNameRef name))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (NameLiveAfter operation (AccNameRef token)))
      ((ResourceDemand (AccNameRef token))) :ruleset dataflow-resources)
; Collections allocate their own result storage; prefix and compact roles are explicit.
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef name)) (= (OutputRole operation slot) (CollectedOutput)))
      ((ResourceRoot (ValueNameRef name) (FreshResource (ValueNameRef name)))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef name)) (= (OutputRole operation slot) (CompactedOutput)))
      ((ResourceRoot (ValueNameRef name) (FreshResource (ValueNameRef name)))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef name)) (= (OutputRole operation slot) (PrefixOutput)))
      ((ResourceRoot (ValueNameRef name) (FreshResource (ValueNameRef name)))) :ruleset dataflow-resources)

(rule ((= revision (AnalysisRevision)) (AccumulatorOperation operation) (= token (AccumulatorParameter operation group)))
      ((set (TokenCapability token) (TokenBindingAt operation group))) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (= (Input operation 0) (AccNameRef token)) (= (Output operation 0) (AccNameRef result))
       (= capability (TokenCapability token)))
      ((set (TokenCapability result) capability)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ResourceParent (AccNameRef result) (AccNameRef source))
       (= capability (TokenCapability source)))
      ((set (TokenCapability result) capability)) :ruleset dataflow-resources)

; Capabilities are consumed at occurrences, including captures crossing a control edge.
(rule ((= revision (AnalysisRevision)) (ConsumesInput operation slot) (= (Input operation slot) (AccNameRef token)))
      ((ConsumedToken operation token)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (= (EdgeArgument operation edge slot) (AccNameRef token)))
      ((ConsumedToken operation token)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (ConsumedToken operation token) (= region (OperationRegion operation))
       (= (RegionOwnedBy region) owner) (DefinitionRegion (AccNameRef token) definition) (!= definition region))
      ((ConsumedToken owner token)) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (AvailabilityDemand operation (AccNameRef token))
       (ConsumedToken consumer token) (= region (OperationRegion consumer)) (= region (OperationRegion operation))
       (= before (OperationOrder consumer)) (= after (OperationOrder operation)) (< before after))
      ((TokenUnavailableAt operation token) (InvalidDataflow "accumulator capability was already consumed")) :ruleset dataflow-resources)
(rule ((= revision (AnalysisRevision)) (EndDemand region (AccNameRef token)) (ConsumedToken consumer token)
       (= region (OperationRegion consumer)))
      ((InvalidDataflow "region yields a consumed accumulator capability")) :ruleset dataflow-resources)

(rule ((= revision (AnalysisRevision)) (= target (CallTarget operation)) (= (RecursiveFunction target) true))
      ((OperationTrap operation)) :ruleset dataflow-effects)
(rule ((= revision (AnalysisRevision)) (= (InputDiet operation slot) (Consume))
       (= (Input operation slot) (AccNameRef token)))
      ((ConsumedToken operation token)) :ruleset dataflow-resources)

; Hoisting may repeat total reads only when they commute with the enclosing writes.
(rule ((= revision (AnalysisRevision)) (LiveOperation operation))
      ((set (MovableOperation operation) true)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (OperationTrap operation))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (OperationWrite operation resource))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (MaterializedCopyOperation operation))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (ConsumedToken operation token))
      ((set (MovableOperation operation) false)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (LaneDependentOperation operation))
      ((InvocationDependent operation)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (InvocationDependent operation) (= region (OperationRegion operation)))
      ((InvocationRegion region)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (InvocationRegion region) (= (RegionOwnedBy region) operation))
      ((InvocationDependent operation)) :ruleset dataflow-motion)
(rule ((= revision (AnalysisRevision)) (InvocationRegion region) (= region (FunctionRoot function)) (= function (CallTarget operation)))
      ((InvocationDependent operation)) :ruleset dataflow-motion)

(function PureOperation (OperationKey) bool :merge (and old new))
(rule ((= revision (AnalysisRevision)) (LiveOperation operation))
      ((set (PureOperation operation) true)) :ruleset dataflow-purity)
(rule ((= revision (AnalysisRevision)) (OperationRead operation resource))
      ((set (PureOperation operation) false)) :ruleset dataflow-purity)
(rule ((= revision (AnalysisRevision)) (OperationWrite operation resource))
      ((set (PureOperation operation) false)) :ruleset dataflow-purity)
(rule ((= revision (AnalysisRevision)) (OperationTrap operation))
      ((set (PureOperation operation) false)) :ruleset dataflow-purity)
