; Track value variation separately from variation in logical array shape.
(ruleset regularity-index)
(ruleset regularity)
(function RegularLength (OperationKey) bool :merge (or old new))
(relation RowDependent (OperationKey Name))
(relation VaryingShape (OperationKey ValueName))
(relation RowShapePair (OperationKey ValueName ValueName))
(function SameRowShape (OperationKey ValueName ValueName) bool :merge (or old new))
(relation RowExtent (ValueName IndexExp))
(relation IrregularResult (OperationKey))
(rule ((LiveOperation operation)) ((set (RegularLength operation) false)) :ruleset regularity-index)
(rule ((LengthOperation operation axis)) ((set (RegularLength operation) true)) :ruleset regularity-index)
(rule ((LiveOperation map) (ParallelOperation map) (= lane (wyn-control-region map 0)) (= name (RegionParameter lane slot)))
      ((RowDependent map name)) :ruleset regularity)
(rule ((RowDependent map name) (OperationUse operation name) (= (RegularLength operation) false) (= output (Output operation slot)))
      ((RowDependent map output)) :ruleset regularity)
(rule ((RowDependent map name) (= operation (RegionOwnedBy body)) (BranchArm edge)
       (= name (wyn-edge-argument operation edge slot)) (= body (wyn-control-region operation 0)) (= parameter (RegionParameter body slot)))
      ((RowDependent map parameter)) :ruleset regularity)
(rule ((RowDependent map (ValueNameRef name)) (ArrayOuterBound array bound) (IndexUse bound name))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((VaryingShape map array) (LengthOperation operation axis) (= (Input operation 0) (ValueNameRef array)) (= output (Output operation 0)))
      ((RowDependent map output)) :ruleset regularity)
(rule ((RowDependent map (ValueNameRef name)) (ViewOperation operation) (= slices (OperationSlices operation)) (SliceUse slices name)
       (= (Output operation 0) (ValueNameRef array))) ((VaryingShape map array)) :ruleset regularity)
(rule ((VaryingShape map source) (PreservesInputShape operation output input)
       (= (Input operation input) (ValueNameRef source)) (= (Output operation output) (ValueNameRef array)))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((VaryingShape map source) (= (SourceAlias (FlowNamed array)) (FlowNamed source)))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((VaryingShape map field) (ProductField product slot field)) ((VaryingShape map product)) :ruleset regularity)
(rule ((VaryingShape map row) (= (RegionYield body slot) (ValueNameRef row)) (BranchArm edge) (= operation (RegionOwnedBy body)) (= body (wyn-control-region operation edge)) (= (Output operation slot) (ValueNameRef array)))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((ParallelOperation operation) (= (Output operation slot) (ValueNameRef array)) (= clause (OutputClause operation slot))
       (= (OutputRole operation slot) (CompactedOutput)) (= predicate (ResultPredicate operation clause)) (RowDependent map (ValueNameRef predicate)))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((= bound (CollectionExtent array axis)) (IndexUse bound name) (RowDependent map (ValueNameRef name)))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((ParallelOperation operation) (= (Output operation slot) (ValueNameRef array)) (= clause (OutputClause operation slot))
       (= field (OutputField operation slot)) (= (ResultKindOf operation clause) (Collected))
       (= (ResultValue operation clause field) (ValueNameRef row)) (VaryingShape map row))
      ((VaryingShape map array)) :ruleset regularity)
(rule ((BranchOperation branch) (= yes (wyn-control-region branch 0)) (= no (wyn-control-region branch 1))
       (= (RegionYield yes slot) (ValueNameRef a)) (= (RegionYield no slot) (ValueNameRef b)) (ArrayValue a) (ArrayValue b))
      ((RowShapePair branch a b) (set (SameRowShape branch a b) false)) :ruleset regularity-index)
(rule ((RowShapePair branch a b) (ArrayOuterBound a x) (ArrayOuterBound b y)) ((RowExtent a x) (RowExtent b y)) :ruleset regularity-index)
(rule ((RowExtent row (IndexValue name)) (LengthOperation operation 0) (= (Output operation 0) (ValueNameRef name))
       (= (Input operation 0) (ValueNameRef array)) (ArrayOuterBound array bound)) ((RowExtent row bound)) :ruleset regularity-index)
(rule ((RowExtent row (IndexValue name)) (IndexCalculationOperation operation) (= (Output operation 0) (ValueNameRef name))
       (= bound (OperationIndex operation 0))) ((RowExtent row bound)) :ruleset regularity-index)
(rule ((RowExtent row bound) (ConstantBound bound n)) ((RowExtent row (IndexConstant n))) :ruleset regularity-index)
(rule ((RowShapePair branch a b) (RowExtent a bound) (RowExtent b bound)
       (= (ValueType a) (LogicalValue (ArrayType ownership extents element))) (= (vec-length extents) 1) (= bytes (LogicalBytes element)))
      ((set (SameRowShape branch a b) true)) :ruleset regularity-index)
(rule ((ArrayLiteralOperation operation) (= (Input operation 0) (ValueNameRef row)) (= (Output operation 0) (ValueNameRef array))) ((set (CollectionElement array) row)) :ruleset regularity-index)
(rule ((RowShapePair branch a b) (= x (CollectionElement a)) (= y (CollectionElement b)))
      ((RowShapePair branch x y) (set (SameRowShape branch x y) false)) :ruleset regularity-index)
(rule ((RowShapePair branch a b) (RowExtent a bound) (RowExtent b bound)
       (= p (CollectionElement a)) (= q (CollectionElement b)) (= (SameRowShape branch p q) true))
      ((set (SameRowShape branch a b) true)) :ruleset regularity-index)
(rule ((RowShapePair branch a b) (= (SameRowShape branch a b) false) (= condition (Input branch 0)) (RowDependent map condition)
       (= yes (wyn-control-region branch 0)) (= (RegionYield yes slot) (ValueNameRef a)) (= (Output branch slot) (ValueNameRef result)))
      ((VaryingShape map result)) :ruleset regularity)
(rule ((ParallelOperation map) (= (ResultKindOf map clause) (Collected)) (= (ResultValue map clause slot) (ValueNameRef row))
       (VaryingShape map row)) ((IrregularResult map)) :ruleset regularity)
