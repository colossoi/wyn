; Summaries are queried only after the region graph has settled. Bounded native
; weight queries return one number; eligibility and thresholds are chosen here.
(sort WorkRegions (Set RegionKey))
(function OperationWorkRegions (OperationKey) WorkRegions :merge (set-union old new))
(function WorkChildren (RegionKey) WorkRegions :merge (set-union old new))
(function WorkCost (RegionKey) i64 :no-merge)
(relation SourceInlineEligible (RegionKey))
(ruleset work-summaries)
(ruleset work-costs)
(ruleset work-select)
(rule ((= n (SourceRegionWork region)))
      ((set (WorkChildren region) (set-empty))) :ruleset work-summaries)
(rule ((= v (SourceOperationValue op)))
      ((set (OperationWorkRegions op) (set-empty))) :ruleset work-summaries)
(rule ((= v (SourceOperationValue op)) (SourceSummaryEnters v r))
      ((set (OperationWorkRegions op) (set-of r))) :ruleset work-summaries)
(rule ((SourceRegionEnters r child))
      ((set (WorkChildren r) (set-of child))) :ruleset work-summaries)
(rule ((SourceCallable f r) (= n (wyn-inline-weight r 65)))
      ((set (WorkCost r) n)) :ruleset work-costs :naive)
(rule ((= value (SourceOperationValue op)))
      ((set (SourceOperationCheap op) false)) :ruleset work-select)
(rule ((= value (SourceOperationValue op)) (= n (wyn-operation-weight op 65)) (<= n 64))
      ((set (SourceOperationCheap op) true)) :ruleset work-select :naive)
(rule ((SourceCallable f r) (= (SourceRegionDuplicable r) true) (= n (WorkCost r)) (<= n 64))
      ((SourceInlineEligible r)) :ruleset work-select)
