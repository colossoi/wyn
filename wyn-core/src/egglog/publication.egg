(ruleset publication-uses)
(ruleset publication-access)
(ruleset publication-order)
(rule ((EmitOriginalEntry owner) (SourceDefinition owner region))
      ((RootUsesRegion (EntryRoot owner) region)) :ruleset publication-uses)
(rule ((PhaseCallback stage region)) ((RootUsesRegion (KernelRoot stage) region)) :ruleset publication-uses)
(rule ((Demand (InStage stage) key) (= key (SourceExprKey source)))
      ((RootValueUse (KernelRoot stage) source)) :ruleset publication-uses)
(rule ((RootUsesRegion root region) (SourceRegionEnters region child))
      ((RootUsesRegion root child)) :ruleset publication-uses)
(rule ((RootUsesRegion root region) (= readonly (SourceRegionReadOnly region)))
      ((set (RootReadOnly root) readonly)) :ruleset publication-uses)
(rule ((RootUsesRegion root region) (SourceRegionUse region value))
      ((RootValueUse root value)) :ruleset publication-uses)
(rule ((RootValueUse root parameter) (SourceCapture region parameter actual))
      ((RootValueUse root actual)) :ruleset publication-uses)
(rule ((RootValueUse root value) (SourceAlias value actual))
      ((RootValueUse root actual)) :ruleset publication-uses)
(rule ((RootValueUse root value) (SourceInterfaceParameter value resource flags)
       (= (RootReadOnly root) true) (> (& flags 1) 0))
      ((set (PublicationAccess root resource) 1)) :ruleset publication-access)
(rule ((RootValueUse root value) (SourceInterfaceParameter value resource flags)
       (= (RootReadOnly root) false))
      ((set (PublicationAccess root resource) flags)) :ruleset publication-access)
(rule ((RootOwner root owner) (= flags (RootBindingAccess root binding))
       (SourceInterfaceBinding owner binding resource))
      ((set (PublicationAccess root resource) flags)) :ruleset publication-access)
(rule ((EmitOriginalEntry owner) (SourceInterfaceOutput owner resource produced))
      ((set (PublicationAccess (EntryRoot owner) resource) 2)) :ruleset publication-access)
(rule ((EmitOriginalEntry owner) (SourceInterfaceOutput owner resource true))
      ((PublicationProduced (EntryRoot owner) resource)) :ruleset publication-access)
(rule ((SourceDrawRead owner resource))
      ((set (PublicationAccess (EntryRoot owner) resource) 1)) :ruleset publication-access)
(rule ((OutputWriter output root) (AbiOutputBinding output set binding)
       (RootOwner root owner) (SourceInterfaceBinding owner (InputBinding set binding) resource))
      ((set (PublicationAccess root resource) 2) (PublicationProduced root resource)) :ruleset publication-access)
(rule ((DispatchDependency before after))
      ((PublicationDependency (KernelRoot before) (KernelRoot after))) :ruleset publication-order)
(rule ((FinishDependency entry stage))
      ((PublicationDependency (KernelRoot stage) (EntryRoot entry))) :ruleset publication-order)
; Produced values order consumers regardless of declaration order.
(rule ((PublicationProduced before resource) (= flags (PublicationAccess after resource))
       (> (& flags 1) 0) (RootOwner before a) (RootOwner after b) (!= a b))
      ((PublicationDependency before after)) :ruleset publication-order)
; State accesses follow source entry order. Joins are restricted to one resource.
(function PublicationIsProduced (PublicationResource) bool :merge (or old new))
(rule ((= flags (PublicationAccess root resource)))
      ((set (PublicationIsProduced resource) false)) :ruleset publication-access)
(rule ((PublicationProduced root resource))
      ((set (PublicationIsProduced resource) true)) :ruleset publication-access)
(rule ((= a (PublicationAccess before resource)) (= b (PublicationAccess after resource))
       (= (PublicationIsProduced resource) false) (> (& (| a b) 2) 0)
       (RootOwner before x) (RootOwner after y) (SourceEntryOrder x i) (SourceEntryOrder y j) (< i j))
      ((PublicationDependency before after)) :ruleset publication-order)
(rule ((SourceInterfaceFamily a family) (SourceInterfaceFamily b family)
       (SourceInterfaceBinding a binding x) (SourceInterfaceBinding b binding y))
      ((union x y)) :ruleset publication-uses)

(rule ((RootValueUse root value) (SourceInterfaceParameter value resource flags)
       (RootOwner root owner) (SourceInterfaceBinding owner binding resource)
       (= (RootReadOnly root) true) (> (& flags 1) 0))
      ((set (RootBindingAccess root binding) 1)) :ruleset publication-access)
(rule ((RootValueUse root value) (SourceInterfaceParameter value resource flags)
       (RootOwner root owner) (SourceInterfaceBinding owner binding resource)
       (= (RootReadOnly root) false))
      ((set (RootBindingAccess root binding) flags)) :ruleset publication-access)

(rule ((ScalarGroup op leader) (Phase (Stage leader "scalar") region)
       (= source (SourceOperationValue op)) (= readonly (SourceReadOnly source)))
      ((set (RootReadOnly (KernelRoot (Stage leader "scalar"))) readonly)
       (RootValueUse (KernelRoot (Stage leader "scalar")) source)) :ruleset publication-uses)
(rule ((ScalarGroup op leader) (Phase (Stage leader "scalar") region) (SourceOperand op source))
      ((RootValueUse (KernelRoot (Stage leader "scalar")) source)) :ruleset publication-uses)
(rule ((RootValueUse root value) (SourceComputedUse value child))
      ((RootValueUse root child)) :ruleset publication-uses)
(rule ((RootValueUse root value) (= value (SourceOperationValue op))
       (= (Rematerialize op) true) (SourceOperand op child))
      ((RootValueUse root child)) :ruleset publication-uses)
(rule ((RootValueUse root value) (SourceSummaryEnters value region))
      ((RootUsesRegion root region)) :ruleset publication-uses)
(rule ((RootValueUse root value) (SourceProjection value parent index))
      ((RootValueUse root parent)) :ruleset publication-uses)
(rule ((RootValueUse root parameter) (= parameter (SourceParameter region i))
       (= (ParameterAbi region i) (PushInput offset size)))
      ((RootPushInput root offset size)) :ruleset publication-access)

(rule ((FinishEntry owner) (SourceDefinition owner region))
      ((RootUsesRegion (EntryRoot owner) region)) :ruleset publication-uses)
(rule ((OutputWriter output root) (OutputExpression output key) (= key (SourceExprKey source)))
      ((RootValueUse root source)) :ruleset publication-uses)

(rule ((PhaseCallback stage region) (SourceCapture region formal actual))
      ((RootValueUse (KernelRoot stage) actual)) :ruleset publication-uses)
