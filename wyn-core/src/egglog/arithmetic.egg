; Scalar equality saturation between fusion and scheduling. Integer laws use
; wrapping arithmetic. Float reassociation, x*0 and x+0 are excluded because of
; rounding, NaNs, infinities and signed zero. Extraction chooses by cost.
(ruleset arithmetic)
(ruleset algebra)
(relation Zero (Expr))
(relation One (Expr))
(relation Bitcast (Expr))
(relation IntegerType (TypeKey))

; Vec primitives are not invertible patterns; expose their operands once.
(relation Binary (Expr TypeKey Expr Expr Expr))
(relation Unary (Expr TypeKey Expr Expr))
(rule ((= e (Typed t (PureApp f xs))) (= (vec-length xs) 2)
       (= a (vec-get xs 0)) (= b (vec-get xs 1)))
      ((Binary e t f a b)) :ruleset arithmetic)
(rule ((= e (Typed t (PureApp f xs))) (= (vec-length xs) 1) (= a (vec-get xs 0)))
      ((Unary e t f a)) :ruleset arithmetic)

(rule ((= e (Typed t (Int "0")))) ((Zero e)) :ruleset arithmetic)
(rule ((= e (Typed t (Int "1")))) ((One e)) :ruleset arithmetic)
(rule ((= e (Typed t (FloatBits 1065353216)))) ((One e)) :ruleset arithmetic)

; Integer zero identities preserve the result type.
(rule ((Binary e t (Typed ft (BinOp "+")) z x) (IntegerType t) (Zero z)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)
(rule ((Binary e t (Typed ft (BinOp "+")) x z) (IntegerType t) (Zero z)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)
(rule ((Binary e t (Typed ft (BinOp "-")) x z) (IntegerType t) (Zero z)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)
(rule ((Binary e t (Typed ft (BinOp "-")) x x) (IntegerType t))
      ((union e (Typed t (Int "0")))) :ruleset arithmetic)

; Unit identities also handle vector/scalar applications without changing type.
(rule ((Binary e t (Typed ft (BinOp "*")) one x) (One one)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)
(rule ((Binary e t (Typed ft (BinOp "*")) x one) (One one)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)
(rule ((Binary e t (Typed ft (BinOp "/")) x one) (One one)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)

; A scalar zero cannot replace an entire vector result.
(rule ((Binary e t (Typed ft (BinOp "*")) z x) (IntegerType t) (Zero z)
       (= z (Typed t node))) ((union e z)) :ruleset arithmetic)
(rule ((Binary e t (Typed ft (BinOp "*")) x z) (IntegerType t) (Zero z)
       (= z (Typed t node))) ((union e z)) :ruleset arithmetic)

; Both supported unary operators are involutions: -(-x), !(!x).
(rule ((Unary e t (Typed ft (UnOp op)) inner)
       (Unary inner it (Typed ift (UnOp op)) x) (= x (Typed t node)))
      ((union e x)) :ruleset arithmetic)

; Known selections and projections have no runtime work.
(rewrite (Typed t (Select (Typed ct (Bool true)) yes no)) yes :ruleset arithmetic)
(rewrite (Typed t (Select (Typed ct (Bool false)) yes no)) no :ruleset arithmetic)
(rewrite (Typed t (Select c x x)) x :ruleset arithmetic)
(rewrite (Typed t (Project (Typed tt (Tuple xs)) i)) (vec-get xs i)
  :when ((>= i 0) (< i (vec-length xs))) :ruleset arithmetic)
(rewrite (Typed t (Project (Typed tt (Vector xs)) i)) (vec-get xs i)
  :when ((>= i 0) (< i (vec-length xs))) :ruleset arithmetic)
(rewrite (Typed t (Coerce (Typed t node))) (Typed t node) :ruleset arithmetic)

; Remove identity bitcasts and inverse pairs, without changing numeric casts.
(rule ((Unary e t f x) (Bitcast f) (= x (Typed t node))) ((union e x)) :ruleset arithmetic)
(rule ((Unary e t f inner) (Unary inner it g x) (Bitcast f) (Bitcast g)
       (= x (Typed t node))) ((union e x)) :ruleset arithmetic)

; Expanding alternatives have a separate budget from constant propagation.
; Commutativity and associativity expose shared integer terms and constants.
(rule ((Binary e t f a b) (IntegerType t) (= f (Typed ft (BinOp "+"))))
      ((union e (Typed t (PureApp f (vec-of b a))))) :ruleset algebra)
(rule ((Binary e t f a b) (IntegerType t) (= f (Typed ft (BinOp "*"))))
      ((union e (Typed t (PureApp f (vec-of b a))))) :ruleset algebra)
(rule ((Binary e t f ab c) (Binary ab t f a b) (IntegerType t)
       (= f (Typed ft (BinOp "+"))))
      ((union e (Typed t (PureApp f (vec-of a (Typed t (PureApp f (vec-of b c)))))))) :ruleset algebra)
(rule ((Binary e t f ab c) (Binary ab t f a b) (IntegerType t)
       (= f (Typed ft (BinOp "*"))))
      ((union e (Typed t (PureApp f (vec-of a (Typed t (PureApp f (vec-of b c)))))))) :ruleset algebra)

; Retain both forms; extraction chooses factoring when it costs less.
(rule ((Binary e t add ab ac) (Binary ab t mul a b) (Binary ac t mul a c)
       (IntegerType t) (= add (Typed aft (BinOp "+"))) (= mul (Typed mft (BinOp "*"))))
      ((union e (Typed t (PureApp mul (vec-of a (Typed t (PureApp add (vec-of b c)))))))) :ruleset algebra)

; Constants are seeded from literals and propagated by pure primitives.
(relation Literal (Expr String))
(relation ScalarType (TypeKey String))
(relation FoldUnary (Expr String))

; Small scalar powers use fewer multiplies than general power. Each fact carries
; the original expression, result/function types, base, remaining factors, and
; accumulated product. Preserve left-to-right floating-point multiplication order.
(relation PowerChain (Expr TypeKey TypeKey Expr i64 Expr))
(relation MultiplicationType (TypeKey TypeKey))
(rule ((Binary e t (Typed ft (BinOp "**")) x exponent)
       (= x (Typed t xn)) (= exponent (Typed et en)) (ScalarType et scalar)
       (MultiplicationType t mt)
       (Literal exponent value) (= n (wyn-chain-exponent scalar value)))
      ((PowerChain e t mt x (- n 1) x)) :ruleset arithmetic)
(rule ((PowerChain e t ft x remaining product) (> remaining 0))
      ((PowerChain e t ft x (- remaining 1)
         (Typed t (PureApp (Typed ft (BinOp "*")) (vec-of product x))))) :ruleset arithmetic)
; Commit this strength reduction: tree extraction overcounts the shared base.
(rule ((PowerChain e t ft x 0 product)
       (Binary e t power x exponent) (= power (Typed pt (BinOp "**"))))
      ((union e product) (subsume (PureApp power (vec-of x exponent)))) :ruleset arithmetic)

(rule ((= e (Typed t (Int n))) (IntegerType t)) ((Literal e n)) :ruleset arithmetic)
(rule ((= e (Typed t (FloatBits n))) (ScalarType t "f32"))
      ((Literal e (to-string n))) :ruleset arithmetic)
(rule ((= e (Typed t (Bool true)))) ((Literal e "true")) :ruleset arithmetic)
(rule ((= e (Typed t (Bool false)))) ((Literal e "false")) :ruleset arithmetic)
(rule ((= f (Typed t (UnOp op)))) ((FoldUnary f op)) :ruleset arithmetic)

; The pure primitives evaluate one matched operation; they never inspect the graph.
(rule ((Binary e t (Typed ft (BinOp op)) a b)
       (= a (Typed at an)) (ScalarType at input) (ScalarType t output)
       (Literal a av) (Literal b bv)
       (= value (wyn-binary op input output av bv)))
      ((Literal e value)) :ruleset arithmetic)
(rule ((Unary e t f a) (FoldUnary f op)
       (= a (Typed at an)) (ScalarType at input) (ScalarType t output)
       (Literal a av) (= value (wyn-unary op input output av)))
      ((Literal e value)) :ruleset arithmetic)

; Publish literals as equivalent terms so extraction can choose them.
(rule ((= e (Typed t node)) (Literal e value) (IntegerType t))
      ((union e (Typed t (Int value)))) :ruleset arithmetic)
(rule ((= e (Typed t node)) (Literal e value) (ScalarType t "f32")
       (= bits (wyn-i64 value)))
      ((union e (Typed t (FloatBits bits)))) :ruleset arithmetic)
(rule ((= e (Typed t node)) (Literal e "true") (ScalarType t "bool"))
      ((union e (Typed t (Bool true)))) :ruleset arithmetic)
(rule ((= e (Typed t node)) (Literal e "false") (ScalarType t "bool"))
      ((union e (Typed t (Bool false)))) :ruleset arithmetic)

; Literal indexing is safe only in bounds and when element/result types agree.
; Filter candidates before joining element and result types. Combining these
; joins spends time on unrelated Typed rows even when no literal index matches.
(relation LiteralIndexValue (OperationKey Expr))
(rule ((IndexOperands op (Typed at (Vector xs)) index)
       (Literal index text) (= n (wyn-i64 text)) (>= n 0) (< n (vec-length xs)))
      ((LiteralIndexValue op (vec-get xs n))) :ruleset arithmetic)
(rule ((IndexOperands op (Typed at (ArrayValue (ArrayLiteral xs))) index)
       (Literal index text) (= n (wyn-i64 text)) (>= n 0) (< n (vec-length xs)))
      ((LiteralIndexValue op (vec-get xs n))) :ruleset arithmetic)
; Exclude the eliminated execution from extraction of its earlier input element.
(rule ((LiteralIndexValue op value) (= value (Typed t node))
       (= e (Typed t (OperationResult op))))
      ((union e value) (subsume (Typed t (OperationResult op)))) :ruleset arithmetic)
