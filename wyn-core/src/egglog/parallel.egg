(ruleset fusion-counts)
(rule ((PlanMember plan op)) ((set (PlanStreamResult plan op) false)) :ruleset fusion-counts)
(rule ((PlanMember plan op) (= value (SourceOperationValue op)) (ResultContains (PlanArrays plan) value))
      ((set (PlanStreamResult plan op) true)) :ruleset fusion-counts)
(rule ((= (PlanBody plan) (ParallelLoop domain totals scans arrays action)))
      ((set (PlanDomain plan) domain) (set (PlanTotals plan) totals)
       (set (PlanScans plan) scans) (set (PlanArrays plan) arrays)
       (set (PlanAction plan) action)) :ruleset fusion-counts)
(rule ((= (SourceOperation op) (OperationInfo region kind)))
      ((PlanMember (FusionSource op) op)) :ruleset source-fusion)
(rule ((= (SourceOperation op) (OperationInfo r "map"))) ((set (PlanMapping op) true)) :ruleset source-fusion)
(rule ((= (SourceOperation op) (OperationInfo r kind)) (!= kind "map")) ((set (PlanMapping op) false)) :ruleset source-fusion)
(rule ((= domain (SourceDomainShape op)) (= (SourceOperation op) (OperationInfo r "map")) (= value (SourceOperationValue op))
       (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (PlanBody (FusionSource op)) (ParallelLoop domain (NoResults) (NoResults) (OneResult value element) (Publish)))) :ruleset source-fusion)
(rule ((= domain (SourceDomainShape op)) (= (SourceOperation op) (OperationInfo r "reduce")) (= value (SourceOperationValue op)) (= ty (SourceType value)))
      ((set (PlanBody (FusionSource op)) (ParallelLoop domain (OneResult value ty) (NoResults) (NoResults) (Publish)))) :ruleset source-fusion)
(rule ((= domain (SourceDomainShape op)) (= (SourceOperation op) (OperationInfo r "scan")) (= value (SourceOperationValue op))
       (= ty (SourceType value)) (SourceArrayElement ty element) (= neutral (SourceNeutral op)) (= state (SourceType neutral)))
      ((set (PlanBody (FusionSource op)) (ParallelLoop domain (NoResults) (OneResult value state) (OneResult value element) (Publish)))) :ruleset source-fusion)
(rule ((= domain (SourceDomainShape op)) (= (SourceOperation op) (OperationInfo r "filter")) (= input (SourceInput op 0))
       (= value (SourceOperationValue op)) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (PlanBody (FusionSource op)) (ParallelLoop domain (NoResults) (NoResults) (OneResult value element) (Pack op input)))) :ruleset source-fusion)
(rule ((= domain (SourceDomainShape op)) (= updates (SourceUpdates op)))
      ((set (PlanBody (FusionSource op)) (ParallelLoop domain (NoResults) (NoResults) (NoResults) (PerformUpdates updates)))) :ruleset source-fusion)
(rule ((= (SourceOperation op) (OperationInfo r kind))
       (!= kind "map") (!= kind "reduce") (!= kind "scan") (!= kind "filter")
       (!= kind "scatter") (!= kind "reduce-by-index") (!= kind "bucket-scatter"))
      ((set (PlanBody (FusionSource op)) (ScalarBody))) :ruleset source-fusion)

(relation ResultAlias (SourceValue SourceValue))
(rule ((NewPlan n p c a b next) (PlanMember a op)) ((PlanMember next op)) :ruleset fusion-commit)
(rule ((NewPlan n p c a b next) (PlanMember b op)) ((PlanMember next op)) :ruleset fusion-commit)

; Composition depends on the output actions, independently of candidate priority.
(function ComposedAction (OutputAction OutputAction) OutputAction :no-merge)
(rule ((= action (PlanAction plan))) ((set (ComposedAction (Publish) action) action)) :ruleset fusion-counts)
(rule ((= action (PlanAction plan))) ((set (ComposedAction action (Publish)) action)) :ruleset fusion-counts)
(rule ((= a (Pack op input)) (= b (Pack next source))) ((set (ComposedAction a b) b)) :ruleset fusion-counts)
(rule ((= a (Pack op input)) (= b (PerformUpdates operations))) ((set (ComposedAction a b) b)) :ruleset fusion-counts)
(rule ((JoinCandidate n priority p c keep) (Current p first) (Current c second)
       (= a (PlanAction first)) (= a (PerformUpdates (WithUpdates left lb)))
       (= b (PlanAction second)) (= b (PerformUpdates (WithUpdates right rb))))
      ((set (ComposedAction a b) (PerformUpdates (WithUpdates (vec-append left right) (vec-append lb rb))))) :ruleset fusion-candidates)

; Domain composition is proved before constructing the replacement body.
(function JoinedDomain (FusionPlan FusionPlan bool) DomainShape :no-merge)
(rule ((JoinCandidate n priority p c keep) (Current p a) (Current c b)
       (= domain (PlanDomain a)) (= other (PlanDomain b))
       (= (vec-length (ShapeDimensions domain)) 1) (= (vec-length (ShapeDimensions other)) 1))
      ((set (JoinedDomain a b keep) domain)) :ruleset fusion-candidates)
(rule ((JoinCandidate n priority p c keep) (Current p a) (Current c b)
       (= domain (PlanDomain a)) (SameDomain domain (PlanDomain b)))
      ((set (JoinedDomain a b keep) domain)) :ruleset fusion-candidates)
(rule ((JoinCandidate n priority p c false) (Current p a) (Current c b)
       (= (PlanBody a) (ParallelLoop domain (NoResults) (NoResults) (OneResult value ty) (Publish)))
       (= other (PlanDomain b)) (ProperDomainPrefix domain other)
       (= depth (SourceTraversalDepth value)) (>= depth (vec-length (ShapeDimensions other))))
      ((set (JoinedDomain a b false) other)) :ruleset fusion-candidates)

(rule ((JoinCandidate n priority p c keep) (Current p a) (Current c b)
       (= (PlanBody a) (ParallelLoop ad at ast aa ax))
       (= (PlanBody b) (ParallelLoop bd bt bst ba bx)) (= domain (JoinedDomain a b keep))
       (= action (ComposedAction ax bx)))
      ((JoinedCandidate n priority p c keep domain (JoinResults at bt) (JoinResults ast bst) aa ba action)) :ruleset fusion-candidates)
(function StreamRepresentationBlocked (i64 FusionGroup FusionGroup) bool :merge (or old new))
(rule ((JoinedCandidate n priority p c keep domain totals scans aa ba action))
      ((set (StreamRepresentationBlocked n p c) false)) :ruleset fusion-candidates)
(rule ((JoinedCandidate n priority p c keep domain totals scans aa ba action)
       (Current p a) (Current c b) (PlanMember b consumer) (= input (SourceInput consumer i))
       (SourceOrigin input producer) (PlanMember a producer)
       (= suffix (SourceFixedSuffix input)) (> suffix (vec-length (ShapeDimensions domain))))
      ((set (StreamRepresentationBlocked n p c) true)) :ruleset fusion-candidates)
(rule ((JoinedCandidate n priority p c false domain totals scans aa ba action)
       (= (StreamRepresentationBlocked n p c) false))
      ((PlanCandidate n priority p c (ReplaceBody (ParallelLoop domain totals scans ba action) (set-empty)))) :ruleset fusion-replacements)
(rule ((JoinedCandidate n priority p c true domain totals scans aa ba action)
       (= (StreamRepresentationBlocked n p c) false))
      ((PlanCandidate n priority p c (ReplaceBody (ParallelLoop domain totals scans (JoinResults aa ba) action) (set-empty)))) :ruleset fusion-replacements)

; Packing whose elements do not escape becomes guarded contributions and an
; ordinary total. All observed aliases are collected before freezing the rewrite.
(rule ((MaskCandidate n priority p c)) ((set (MaskBindings n p) (set-empty))) :ruleset fusion-candidates)
(rule ((MaskCandidate n priority p c) (= (set-diff (GroupLengths p) (GroupInternalUseMask p)) (set-empty)))
      ((set (MaskTotals n p) (NoResults))) :ruleset fusion-candidates)
(rule ((MaskCandidate n priority p c) (Current p a) (= (PlanAction a) (Pack predicate input))
       (GroupUseFact p (To length (LengthUse))) (!= p length) (Current length observer)
       (= op (Owner observer)) (= value (SourceOperationValue op)) (= ty (SourceType value)))
      ((set (MaskTotals n p) (OneResult (CountValue (Joined n) predicate input) ty))
       (set (MaskBindings n p) (set-of (BindResult value (CountValue (Joined n) predicate input))))) :ruleset fusion-candidates)
(rule ((MaskCandidate n priority p c) (Current p a) (Current c b)
       (= (PlanBody a) (ParallelLoop domain at ast aa ax))
       (= (PlanBody b) (ParallelLoop bd bt bst ba bx)) (= counts (MaskTotals n p)) (= bindings (MaskBindings n p)))
      ((PlanCandidate n priority p c (ReplaceBody (ParallelLoop domain (JoinResults bt counts) (JoinResults ast bst) (NoResults) (Publish)) bindings))) :ruleset fusion-replacements)

; Apply the selected replacement without reconstructing its semantics.
(rule ((Chosen n p c (ReplaceBody body bindings)) (NewPlan n p c a b next))
      ((set (PlanBody next) body)) :ruleset fusion-commit)
(rule ((Chosen n p c (ReplaceBody body bindings)) (NewPlan n p c a b next)
       (set-contains bindings (BindResult old value)) (= op (SourceValueOperation old)) (= ty (SourceType old)))
      ((ResultAlias old value) (PlanMember next op) (set (SourceType value) ty)) :ruleset fusion-commit)
; Expand result trees only for surviving plans, preserving sharing in the plan.
(ruleset fusion-signatures)
(function SelectedPlan (OperationKey) FusionPlan :no-merge)
(rule ((Current group plan) (PlanMember plan op)) ((set (SelectedPlan op) plan)) :ruleset fusion-signatures)
(function ResultCount (ResultTree) i64 :no-merge)
; Counts are needed while choosing fusion; result slots still expand only once.

(rule ((= tree (NoResults))) ((set (ResultCount tree) 0)) :ruleset fusion-counts)
(rule ((= tree (OneResult value ty))) ((set (ResultCount tree) 1)) :ruleset fusion-counts)
(rule ((= tree (JoinResults left right)) (= a (ResultCount left)) (= b (ResultCount right)))
      ((set (ResultCount tree) (+ a b))) :ruleset fusion-counts)
(rule ((= tree (OneResult value ty))) ((ResultContains tree value)) :ruleset fusion-counts)
(rule ((= tree (JoinResults left right)) (ResultContains left value)) ((ResultContains tree value)) :ruleset fusion-counts)
(rule ((= tree (JoinResults left right)) (ResultContains right value)) ((ResultContains tree value)) :ruleset fusion-counts)
(rule ((PlanMember plan op)) ((set (PlanTotal plan op) false)) :ruleset fusion-counts)
(rule ((PlanMember plan op) (= value (SourceOperationValue op)) (ResultContains (PlanTotals plan) value))
      ((set (PlanTotal plan op) true)) :ruleset fusion-counts)
(rule ((PlanMember plan op) (= value (SourceOperationValue op)) (ResultAlias value result) (ResultContains (PlanTotals plan) result))
      ((set (PlanTotal plan op) true)) :ruleset fusion-counts)
(rule ((= tree (PlanArrays plan)) (= count (ResultCount tree)))
      ((set (ArrayOutputs plan) count)) :ruleset fusion-counts)
(rule ((= tree (PlanTotals plan)) (= count (ResultCount tree)))
      ((set (HasReductions plan) (bool-> count 0))) :ruleset fusion-counts)
(rule ((= tree (PlanScans plan)) (= count (ResultCount tree)))
      ((set (HasScans plan) (bool-> count 0))) :ruleset fusion-counts)
(relation ResultWalk (FusionPlan String ResultTree i64))
(relation PlanResult (FusionPlan String i64 SourceValue TypeKey))
(rule ((Current group plan) (= tree (PlanTotals plan))) ((ResultWalk plan "total" tree 0)) :ruleset fusion-signatures)
(rule ((Current group plan) (= tree (PlanArrays plan)) (= totals (PlanTotals plan)) (= n (ResultCount totals))) ((ResultWalk plan "array" tree n)) :ruleset fusion-signatures)
(rule ((Current group plan) (= tree (PlanScans plan))) ((ResultWalk plan "scan" tree 0)) :ruleset fusion-signatures)
(rule ((ResultWalk plan role (JoinResults left right) offset) (= n (ResultCount left)))
      ((ResultWalk plan role left offset) (ResultWalk plan role right (+ offset n))) :ruleset fusion-signatures)
(rule ((ResultWalk plan role (OneResult value ty) offset)) ((PlanResult plan role offset value ty)) :ruleset fusion-signatures)
(function PlanInternal (FusionPlan SourceValue) bool :merge (or old new))
; Computed captures of plan results must wait for those results as well.
(rule ((Current group plan) (PlanMember plan producer) (SourceOrigin value producer))
      ((set (PlanInternal plan value) true)) :ruleset fusion-signatures)
(rule ((FlowOperand value child) (= (PlanInternal plan child) true))
      ((set (PlanInternal plan value) true)) :ruleset fusion-signatures)
(rule ((= child (SourceAlias value)) (= (PlanInternal plan child) true))
      ((set (PlanInternal plan value) true)) :ruleset fusion-signatures)
(rule ((Current group plan) (PlanMember plan op) (= value (SourceInput op i))) ((set (PlanInternal plan value) false)) :ruleset fusion-signatures)
(rule ((Current group plan) (PlanMember plan op) (SourceOperand op child)) ((set (PlanInternal plan child) false)) :ruleset fusion-signatures)

; Contributions are expressions. Selection controls evaluation, so a rejected
; lane cannot evaluate a trapping consumer or an out-of-bounds update.
(sort Contribution)
(sort Contributions (Vec Contribution))
(constructor ElementAt (SourceValue IndexMap) Contribution)
(constructor ApplyElement (SourceValue RegionKey Contributions) Contribution)
(constructor SelectElement (Contribution Contribution) Contribution)
(constructor TupleElements (Contributions) Contribution)
(datatype Reducer (CombineWith RegionKey SourceValue) (AddValues TypeKey))
(datatype Fold (FoldWith Reducer Contribution RegionCaptures))
(function CountRetained (FusionPlan OperationKey SourceValue) RegionCaptures :no-merge)
(function PlanFold (FusionPlan SourceValue) Fold :no-merge)
(function StreamInput (FusionPlan SourceValue) Contribution :no-merge)
; Canonicalize constructed terms before asserting the unique input expression.
(relation StreamContribution (FusionPlan SourceValue Contribution))
(ruleset fusion-streams)
(rule ((StreamContribution plan input value)) ((set (StreamInput plan input) value)) :ruleset fusion-streams)
(rule ((PlanMember plan op) (= input (SourceInput op i)) (= (PlanInternal plan input) false))
      ((StreamContribution plan input (ElementAt input (vec-of 0)))) :ruleset fusion-signatures)
(rule ((PlanMember plan op) (= input (SourceInput op i)) (= (PlanInternal plan input) true)
       (= origin (SourceValueOperation input)) (= (SourceOperation origin) (OperationInfo r kind)) (!= kind "filter") (!= kind "map"))
      ((StreamContribution plan input (ElementAt input (vec-of 0)))) :ruleset fusion-signatures)
(rule ((PlanMember plan op) (= input (SourceInput op i)) (= (PlanInternal plan input) true)
       (= filter (SourceValueOperation input)) (= (SourceOperation filter) (OperationInfo r "filter"))
       (= source (SourceInput filter 0)) (= element (StreamInput plan source))
       (= body (SourceOperatorBody filter)) (= predicate (SourceResult body)))
      ((StreamContribution plan input (SelectElement (ApplyElement predicate body (vec-of element)) element))) :ruleset fusion-signatures)
(rule ((PlanMember plan op) (= neutral (SourceNeutral op)) (= value (SourceOperationValue op))
       (= input (SourceInput op 0)) (= element (StreamInput plan input)) (= body (SourceOperatorBody op)))
      ((set (PlanFold plan value) (FoldWith (CombineWith body neutral) element (vec-of)))) :ruleset fusion-signatures)
(rule ((= value (CountValue origin op input)) (= ty (SourceType value)) (= element (StreamInput plan input))
       (= body (SourceOperatorBody op)) (= predicate (SourceResult body)) (= retained (CountRetained plan op input)))
      ((set (PlanFold plan (CountValue origin op input)) (FoldWith (AddValues ty) (ApplyElement predicate body (vec-of element)) retained))) :ruleset fusion-signatures)

(rule ((= (PlanBody plan) (ScalarBody)))
      ((set (PlanTotals plan) (NoResults)) (set (PlanScans plan) (NoResults))
       (set (PlanArrays plan) (NoResults))) :ruleset fusion-counts)
(rule ((= (PlanAction plan) (Publish))) ((ScremaPlan plan)) :ruleset fusion-counts)
(rule ((= (PlanAction plan) (PerformUpdates operations))) ((ScremaPlan plan)) :ruleset fusion-counts)
(rule ((= (PlanAction plan) (Pack op input))) ((FilterPlan plan)) :ruleset fusion-counts)
(rule ((= value (SourceOperationValue op)) (= (SourceReadOnly value) true))
      ((ReadOnlyPlan (FusionSource op))) :ruleset source-fusion)
(rule ((NewPlan n p c a b next) (ReadOnlyPlan a) (ReadOnlyPlan b))
      ((ReadOnlyPlan next)) :ruleset fusion-commit)

; Summaries are folds over phase dependencies, not per-fusion-family formulas.
; A contribution depending on a prefix participates in both phases when replayed.
(relation AfterPrefix (FusionPlan OperationKey))
(rule ((PlanMember plan before) (PlanMember plan after) (SourceDepends after before role)
       (= (OperatorDefinition before) (FoldOperator (FoldPrefix) body neutral input)))
      ((AfterPrefix plan after)) :ruleset fusion-dependencies)
(rule ((AfterPrefix plan before) (PlanMember plan after) (SourceDepends after before role))
      ((AfterPrefix plan after)) :ruleset fusion-dependencies)
(rule ((PlanMember plan op))
      ((set (PrePure plan) true) (set (PostPure plan) true)) :ruleset fusion-counts)
(rule ((= (PlanEarly plan op) true) (= value (SourceOperationValue op)) (= safe (SourceSpeculatable value)))
      ((set (PrePure plan) safe)) :ruleset fusion-counts)
(rule ((= (PlanEarly plan op) false) (= value (SourceOperationValue op)) (= safe (SourceSpeculatable value)))
      ((set (PostPure plan) safe)) :ruleset fusion-counts)
(rule ((AfterPrefix plan op) (= value (SourceOperationValue op)) (= safe (SourceSpeculatable value)))
      ((set (PostPure plan) safe)) :ruleset fusion-counts)

; Map application substitutes guarded arguments recursively. No separate rule
; is needed for the number or ordering of intervening maps and selections.
(function StreamArguments (FusionPlan SourceArguments i64) Contributions :no-merge)
(rule ((PlanMember plan op) (= inputs (OperatorInputs op)))
      ((set (StreamArguments plan inputs 0) (vec-of))) :ruleset fusion-signatures)
(rule ((= arguments (StreamArguments plan inputs i)) (< i (vec-length inputs))
       (= value (StreamInput plan (vec-get inputs i))))
      ((set (StreamArguments plan inputs (+ i 1)) (vec-push arguments value))) :ruleset fusion-signatures)
(rule ((PlanMember plan op) (= (OperatorDefinition op) (MapOperator body inputs))
       (= value (SourceOperationValue op)) (= arguments (StreamArguments plan inputs (vec-length inputs))))
      ((StreamContribution plan value (ApplyElement value body arguments))) :ruleset fusion-signatures)
(rule ((PlanMember plan op) (= input (SourceInput op i)) (= (SourceHasOperation input) false))
      ((StreamContribution plan input (ElementAt input (vec-of 0)))) :ruleset fusion-signatures)

(relation PlanEffect (FusionPlan OperationKey i64))
(rule ((= (OperatorDefinition op) (WriteOperator body destination inputs)))
      ((set (UpdateModeOf op) (Overwrite))) :ruleset source-fusion)
(rule ((= (OperatorDefinition op) (IndexedOperator body destination neutral keys values)))
      ((set (UpdateModeOf op) (Combining body))) :ruleset source-fusion)

; Each effect binds its own input expression and exports its declared arrays.
(function UpdateContribution (FusionPlan OperationKey) Contribution :no-merge)
(rule ((PlanEffect plan op offset) (= (UpdateModeOf op) (Overwrite))
       (= inputs (OperatorInputs op)) (= arguments (StreamArguments plan inputs (vec-length inputs)))
       (= body (SourceOperatorBody op)) (= result (SourceResult body)))
      ((set (UpdateContribution plan op) (ApplyElement result body arguments))) :ruleset fusion-signatures)
(rule ((PlanEffect plan op offset) (= (UpdateModeOf op) (Combining combine))
       (= inputs (OperatorInputs op)) (= arguments (StreamArguments plan inputs (vec-length inputs))))
      ((set (UpdateContribution plan op) (TupleElements arguments))) :ruleset fusion-signatures)

(rule ((Current group plan) (= (PlanAction plan) (Pack op input)) (CounterType ty))
      ((set (SourceType (CountValue plan op input)) ty)) :ruleset fusion-signatures)

; Operand indexing belongs to the expression, including broadcast operands.
(function MappedArguments (SourceArguments IndexMaps i64) Contributions :no-merge)
(rule ((= (OperatorDefinition op) (ReserveOperator body destination inputs rank maps)))
      ((set (MappedArguments inputs maps 0) (vec-of))) :ruleset fusion-signatures)
(rule ((= arguments (MappedArguments inputs maps i)) (< i (vec-length inputs)))
      ((set (MappedArguments inputs maps (+ i 1))
            (vec-push arguments (ElementAt (vec-get inputs i) (vec-get maps i))))) :ruleset fusion-signatures)
(rule ((PlanEffect plan op offset)
       (= (OperatorDefinition op) (ReserveOperator body destination inputs rank maps))
       (= arguments (MappedArguments inputs maps (vec-length inputs))) (= result (SourceResult body)))
      ((set (UpdateContribution plan op) (ApplyElement result body arguments))) :ruleset fusion-signatures)

(datatype ArrayViewDefinition (ReindexedArray SourceValue Extent CoordinateFormulas))
(function SourceView (SourceValue) ArrayViewDefinition :no-merge)
(function HasLogicalExtent (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (HasLogicalExtent value) false)) :ruleset source-fusion)
(rule ((= extent (SourceExtent value))) ((set (HasLogicalExtent value) true)) :ruleset source-fusion)
(rule ((= (SourceView value) (ReindexedArray base extent indices)))
      ((set (HasLogicalExtent value) true)) :ruleset source-fusion)
(rule ((= (SourceSlice value) (SliceInfo base start end)))
      ((set (SourceView value) (ReindexedArray base (Difference (Scalar end) (Scalar start))
         (vec-of (FormulaBinary "+" (FormulaInput 0) (FormulaExtent (Scalar start))))))) :ruleset source-fusion)
(rule ((= view (SourceView value)) (= rank (ArrayTypeRank (SourceType value)))
       (= safe (SourceSpeculatable value)))
      ((set (SourceTraversalDepth value) rank) (set (TraversalPrefixSpeculatable value) safe)) :ruleset traversal-depths)
(datatype OutputRoute (OutputAt SourceValue ScalarFormula ScalarFormula))
(function PlanOutputRoute (FusionPlan) OutputRoute :no-merge)
; Retained bindings carry map values across the collective barrier. Output
; formulas receive the contributing value and its completed inclusive prefix.
(rule ((ScremaPlan plan) (PlanMember plan op) (= value (CountValue origin op input)))
      ((set (CountRetained plan op input) (vec-of))) :ruleset fusion-signatures)
(rule ((Current group plan) (= (PlanAction plan) (Pack op input)) (= result (SourceOperationValue op)))
      ((set (CountRetained plan op input) (vec-of (CaptureBinding input input) (CaptureBinding result input)))
       (set (PlanOutputRoute plan) (OutputAt (CountValue plan op input)
          (FormulaBinary ">" (FormulaInput 0) (FormulaConstant 0))
          (FormulaBinary "-" (FormulaInput 1) (FormulaConstant 1))))) :ruleset fusion-signatures)

(rule ((= destination (SourceDestination op)) (= mode (UpdateModeOf op)))
      ((set (SourceUpdates op)
        (WithUpdates (vec-of (UpdateArray (ScopedUpdate op 0) (SeedArray destination) mode))
          (vec-of (EvaluateUpdates op
            (ChooseUpdates (FormulaBinary "&&" (FormulaBinary ">=" (FormulaInput 0) (FormulaConstant 0))
                (FormulaBinary "<" (FormulaInput 0) (FormulaExtent (Length destination))))
              (BindUpdate (ScopedUpdate op 0) (vec-of (FormulaInput 0)) (FormulaInput 1) (UpdatesDone))
              (UpdatesDone))))))) :ruleset source-fusion)
(rule ((= (OperatorDefinition op) (ReserveOperator body destination inputs rank maps))
       (= ty (SourceType destination)) (ArrayTypeAxis ty 1 (FixedSize capacity)) (CounterType count) (>= capacity 0))
      ((set (SourceUpdates op)
        (WithUpdates (vec-of
          (UpdateArray (ScopedUpdate op 0) (SeedArray destination) (Overwrite))
          (UpdateArray (ScopedUpdate op 1) (ZeroInitialized (StoredArray count (Length destination) (Length destination))) (Adding))
          (UpdateArray (ScopedUpdate op 2) (ZeroInitialized (StoredValue count)) (IdenticalWrites)))
          (vec-of (EvaluateUpdates op
            (ChooseUpdates (FormulaInput 0)
              (ChooseUpdates (FormulaBinary "&&" (FormulaBinary ">=" (FormulaInput 1) (FormulaConstant 0))
                  (FormulaBinary "<" (FormulaInput 1) (FormulaExtent (Length destination))))
                (BindUpdate (ScopedUpdate op 1) (vec-of (FormulaInput 1)) (FormulaConstant 1)
                  (ChooseUpdates (FormulaBinary "<" (FormulaBound 0) (FormulaConstant capacity))
                    (BindUpdate (ScopedUpdate op 0) (vec-of (FormulaInput 1) (FormulaBound 0)) (FormulaInput 2) (UpdatesDone))
                    (BindUpdate (ScopedUpdate op 2) (vec-of (FormulaConstant 0)) (FormulaConstant 1) (UpdatesDone))))
                (BindUpdate (ScopedUpdate op 2) (vec-of (FormulaConstant 0)) (FormulaConstant 1) (UpdatesDone)))
              (UpdatesDone))))))) :ruleset source-fusion)
(rule ((Current group plan) (= (PlanAction plan) (PerformUpdates scope)))
      ((set (PlanUpdates plan) scope)) :ruleset fusion-signatures)

(relation UpdateArrayAt (FusionPlan i64))
(relation PlanUpdateArray (FusionPlan i64 UpdateInitial UpdateMode))
(rule ((= (PlanUpdates plan) (WithUpdates arrays blocks))) ((UpdateArrayAt plan 0)) :ruleset fusion-signatures)
(rule ((UpdateArrayAt plan i) (= (PlanUpdates plan) (WithUpdates arrays blocks)) (< i (vec-length arrays))
       (= (vec-get arrays i) (UpdateArray handle initial mode)))
      ((PlanUpdateArray plan i initial mode) (UpdateArrayAt plan (+ i 1))) :ruleset fusion-signatures)

(rule ((UpdateArrayAt plan i) (= (PlanUpdates plan) (WithUpdates arrays blocks)) (< i (vec-length arrays))
       (= (vec-get arrays i) (UpdateArray (ScopedUpdate op 0) initial mode)))
      ((PlanEffect plan op i)) :ruleset fusion-signatures)

; Routing belongs to each output: retaining a producer does not compact its array.
(relation PackedMember (FusionPlan OperationKey))
(function RoutedArray (FusionPlan SourceValue) bool :merge (or old new))
(rule ((Current group plan) (= (PlanAction plan) (Pack op input))) ((PackedMember plan op)) :ruleset fusion-signatures)
(rule ((PackedMember plan producer) (SourceDepends consumer producer (Input)) (PlanMember plan consumer))
      ((PackedMember plan consumer)) :ruleset fusion-signatures)
(rule ((PlanResult plan "array" slot value ty)) ((set (RoutedArray plan value) false)) :ruleset fusion-signatures)
(rule ((PlanResult plan "array" slot value ty) (SourceOrigin value op) (PackedMember plan op))
      ((set (RoutedArray plan value) true)) :ruleset fusion-signatures)
