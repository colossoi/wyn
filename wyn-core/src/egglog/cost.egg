; Bounds and work are derived from the same statement tree used by rewrites.
; Unknown bounds have no fact: an estimate never authorizes a local allocation.
(ruleset schedule-cost)
(function KnownSize (Function IndexExp) bool :merge (or old new))
(function StaticIndex (Function IndexExp) i64 :no-merge)
(function BoundedWork (Function Exp) BigInt :no-merge)
(function BodyWork (Function Body) BigInt :no-merge)
(function SequenceWork (Function Stms i64) BigInt :no-merge)
(function DomainWork (Function DomainAxes i64) BigInt :no-merge)
(function LoopStateBytes (Function Merges i64) i64 :no-merge)
(function ValueBytes (Function ValueInfo) i64 :no-merge)
(function LocalLoop (Function Exp) bool :merge (or old new))
(function HasFold (ParallelResults) bool :no-merge)
(function SelectedWidth (Function Domain ParallelResults) i64 :merge (min old new))
(rule ((ProgramFunction program function) (ContainsIndexExp (FunctionRoot function) (IndexConstant n)))
      ((set (StaticIndex function (IndexConstant n)) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (Use (ValueOperand (LiteralBits (I32) n)))))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ScalarInfo (ScalarElement (I32))))))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)
(rule ((ContainsStm (FunctionRoot function) (Let id vector-pattern-0 certs (IndexOp expression)))
       (= n (StaticIndex function expression))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name info)))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) (Loop merges form returns body)))
      ((set (LoopStateBytes function merges 0) 0)
       (set (LocalLoop function (Loop merges form returns body)) false)) :ruleset schedule-cost)
(rule ((= bytes (LoopStateBytes function merges i)) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter (BindValue name info) diet) initial))
       (= element (ArrayElement info)) (= next (ValueBytes function info)) (>= next 0) (<= next 16384) (<= (+ bytes next) 16384))
      ((set (LoopStateBytes function merges (+ i 1)) (+ bytes next))) :ruleset schedule-cost)
; Scalar carries stay in registers; only arrays contribute transfer/storage cost.
(rule ((= bytes (LoopStateBytes function merges i)) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter (BindValue name (ScalarInfo element)) diet) initial)))
      ((set (LoopStateBytes function merges (+ i 1)) bytes)) :ruleset schedule-cost)
(rule ((ContainsBody (FunctionRoot function) (Block statements results)))
      ((set (SequenceWork function statements 0) (bigint 0))) :ruleset schedule-cost)
(rule ((= work (SequenceWork function statements i)) (< i (vec-length statements))
       (= (vec-get statements i) (Let id pattern certs expression)) (= next (BoundedWork function expression)))
      ((set (SequenceWork function statements (+ i 1)) (+ work next))) :ruleset schedule-cost)
(rule ((ContainsBody (FunctionRoot function) body) (= body (Block statements results))
       (= work (SequenceWork function statements (vec-length statements))))
      ((set (BodyWork function body) work)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (GenerateArray (ArrayLiteral values))))
      ((set (BoundedWork function expression) (bigint (vec-length values)))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (GenerateArray (Uninitialized element shape))))
      ((set (BoundedWork function expression) (bigint 0))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (If condition returns yes no))
       (= a (BodyWork function yes)) (= b (BodyWork function no)))
      ((set (BoundedWork function expression) (+ (bigint 1) (max a b)))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Loop merges (Counted name start count step) returns body))
       (= n (StaticIndex function count)) (>= n 0) (= work (BodyWork function body)))
      ((set (BoundedWork function expression) (* (bigint n) work))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution (IterationSpace flat axes) (ParallelBlock statements results))))
      ((set (DomainWork function axes 0) (bigint 1)) (set (SequenceWork function statements 0) (bigint 0))) :ruleset schedule-cost)
(rule ((= work (DomainWork function axes i)) (< i (vec-length axes)) (= (vec-get axes i) (DenseAxis name size))
       (= n (StaticIndex function size)) (>= n 0))
      ((set (DomainWork function axes (+ i 1)) (* work (bigint n)))) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Parallel execution (IterationSpace flat axes) (ParallelBlock statements results)))
       (= n (DomainWork function axes (vec-length axes))) (= work (SequenceWork function statements (vec-length statements))))
      ((set (BoundedWork function expression) (* n (+ work (bigint 1))))) :ruleset schedule-cost)

(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements results))) (= (HasFold results) false))
      ((set (SelectedWidth function domain results) 128)) :ruleset schedule-cost)

; Invariant loop witnesses keep their constant bounds across SSA loop edges.
; A changing carry never inherits its initial bound.
(function StaticOperand (Function Operand) i64 :no-merge)
(rule ((ContainsOperand (FunctionRoot function) (ValueOperand (LiteralBits (I32) n))))
      ((set (StaticOperand function (ValueOperand (LiteralBits (I32) n))) n)) :ruleset schedule-cost)
(rule ((ContainsOperand (FunctionRoot function) (ValueOperand (LiteralBits (U32) n))))
      ((set (StaticOperand function (ValueOperand (LiteralBits (U32) n))) n)) :ruleset schedule-cost)
(rule ((ContainsOperand (FunctionRoot function) (ValueOperand (Var name))) (= n (StaticIndex function (IndexValue name))))
      ((set (StaticOperand function (ValueOperand (Var name))) n)) :ruleset schedule-cost)
(rule ((ContainsOperand (FunctionRoot function) (IndexOperand index)) (= n (StaticIndex function index)))
      ((set (StaticOperand function (IndexOperand index)) n)) :ruleset schedule-cost)
(rule ((ContainsExp (FunctionRoot function) (Loop merges form returns (Block statements results)))
       (WalkMerges merges i) (< i (vec-length merges)) (< i (vec-length results))
       (= (vec-get merges i) (Carry (Parameter (BindValue name (ScalarInfo (ScalarElement (I32)))) diet) initial))
       (= (vec-get results i) (Yield certs (ValueOperand (Var name)))) (= n (StaticOperand function initial)))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)

(rule ((ContainsExp (FunctionRoot function) (Loop merges form returns (Block statements results)))
       (WalkMerges merges i) (< i (vec-length merges)) (< i (vec-length results))
       (= (vec-get merges i) (Carry (Parameter (BindValue name (ScalarInfo (ScalarElement (I32)))) diet) initial))
       (= (vec-get results i) (Yield certs next)) (= n (StaticOperand function initial)) (= n (StaticOperand function next)))
      ((set (StaticIndex function (IndexValue name)) n)) :ruleset schedule-cost)

(rule ((LoadBoundsAt function expression i) (= expression (Load name indices))
       (< i (vec-length indices)) (= info (BindingInfo function name))
       (= size (ArrayExtent info i)) (= length (StaticIndex function size))
       (= index (StaticIndex function (vec-get indices i))) (>= index 0) (< index length))
      ((LoadBoundsAt function expression (+ i 1))) :ruleset memory-origin)

; A positive divisor also excludes signed MIN/-1 overflow. These are proofs,
; separate from estimated work, and apply to both indices and dispatch grids.
(function PositiveIndex (Function IndexExp) bool :merge (or old new))
(rule ((ContainsIndexExp (FunctionRoot function) index))
      ((set (PositiveIndex function index) false)) :ruleset memory-origin)
(rule ((= n (StaticIndex function index)) (> n 0))
      ((set (PositiveIndex function index) true)) :ruleset memory-origin)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexMax a b)) (= (PositiveIndex function a) true))
      ((set (PositiveIndex function (IndexMax a b)) true)) :ruleset memory-origin)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexMax a b)) (= (PositiveIndex function b) true))
      ((set (PositiveIndex function (IndexMax a b)) true)) :ruleset memory-origin)
(rule ((= (PositiveIndex function index) true))
      ((set (IndexDivisionEffects function index) (set-empty))) :ruleset memory-effects)
(rule ((= (PositiveIndex function index) false))
      ((set (IndexDivisionEffects function index) (set-of (OrderedEffect)))) :ruleset memory-effects)

(rule ((= (ConstantAtom function (Var name)) (LiteralBits (I32) value)))
      ((set (StaticIndex function (IndexValue name)) value)) :ruleset schedule-cost)

(function WhileLoop (LoopForm) bool :no-merge)
(rule ((= form (While condition))) ((set (WhileLoop form) true)) :ruleset schedule-cost)
(rule ((= form (Counted index start count step))) ((set (WhileLoop form) false)) :ruleset schedule-cost)
