; Cost sums retain contribution identities, so equal costs from distinct values
; count separately. BigInt preserves u64 saturation without signed overflow.
(let cost-limit (- (<< (bigint 1) 64) (bigint 1)))
(datatype CostItem (RegionCost RegionKey) (OperationCost OperationKey)
    (BodyCost OperationKey FusionPlan RegionKey) (InputCost SourceValue)
    (OutputCost OperationKey i64 TypeKey) (StateCost SourceValue i64))
(sort CostItems (Set CostItem))
(function CostValue (CostItem) BigInt :no-merge)
(relation CostRequest (CostItems))
(function CostPrefix (CostItems i64) BigInt :no-merge)
(function CostTotal (CostItems) BigInt :no-merge)
(ruleset cost-inputs)
(ruleset cost-requests)
(ruleset cost-values)
(ruleset loop-cost-select)
(relation CostArrayOperation (OperationKey))
(rule ((CostRequest items)) ((set (CostPrefix items 0) (bigint 0))) :ruleset cost-values)
(rule ((= n (CostPrefix items i)) (< i (set-length items)) (= x (CostValue (set-get items i))))
      ((set (CostPrefix items (+ i 1)) (min cost-limit (+ n x)))) :ruleset cost-values)
(rule ((= n (CostPrefix items (set-length items)))) ((set (CostTotal items) n)) :ruleset cost-values)

; The same region edges used by inline work also support weighted iterations.
(function CostCounted (RegionKey RegionKey) bool :merge (or old new))
(function CostRegionItems (RegionKey) CostItems :merge (set-union old new))
(function CostLoopItems (SourceValue) CostItems :merge (set-union old new))
(function CostHasLoop (SourceValue) bool :merge (or old new))
(function CostConditional (SourceValue) bool :merge (or old new))
(function CostLocal (SourceValue) bool :merge (or old new))
(function CostExtent (Extent) BigInt :no-merge)
(rule ((= n (SourceRegionWork r))) ((set (CostRegionItems r) (set-empty))) :ruleset cost-inputs)
(rule ((SourceRegionEnters r child)) ((set (CostCounted r child) false)) :ruleset cost-inputs)
(rule ((= (SourceOperation op) (OperationInfo r kind)))
      ((set (CostRegionItems r) (set-of (OperationCost op)))) :ruleset cost-inputs)
(rule ((= (SourceOperation op) (OperationInfo r "map"))) ((CostArrayOperation op)) :ruleset cost-inputs)
(rule ((= (SourceOperation op) (OperationInfo r "scan"))) ((CostArrayOperation op)) :ruleset cost-inputs)
(rule ((= (SourceOperation op) (OperationInfo r "reduce"))) ((CostArrayOperation op)) :ruleset cost-inputs)
(rule ((CostArrayOperation op) (= (SourceOperation op) (OperationInfo r kind)) (= child (SourceOperatorBody op)))
      ((set (CostCounted r child) true)) :ruleset cost-inputs)
(rule ((= source (SourceOperationValue op))) ((set (CostHasLoop source) false)) :ruleset cost-inputs)
(rule ((= (SourceLoop source) (LoopInfo header body)))
      ((set (CostHasLoop source) true) (set (CostConditional source) false)
       (set (CostLocal source) false) (set (CostLoopItems source) (set-empty))) :ruleset cost-inputs)
(rule ((= (SourceLoopForm source) (WhileCondition condition)))
      ((set (CostConditional source) true)) :ruleset cost-inputs)
(rule ((= (SourceOperation op) (OperationInfo r "control")) (= source (SourceOperationValue op))
       (= (SourceLoop source) (LoopInfo header body)))
      ((set (CostCounted r header) true) (set (CostCounted r body) true)) :ruleset cost-inputs)
(rule ((SourceLoopCarry source slot initial state next output array))
      ((set (CostLoopItems source) (set-of (StateCost source slot)))) :ruleset cost-inputs)
(rule ((SourceRegionEnters r child) (= (CostCounted r child) false))
      ((set (CostRegionItems r) (set-of (RegionCost child)))) :ruleset cost-requests)
(rule ((= items (CostRegionItems r))) ((CostRequest items)) :ruleset cost-values)
(rule ((= items (CostLoopItems source))) ((CostRequest items)) :ruleset cost-values)
(rule ((= (SourceRegionReadOnly r) true) (= items (CostRegionItems r)) (= cost (CostTotal items))
       (= n (SourceRegionWork r)))
      ((set (CostValue (RegionCost r)) (min cost-limit (+ cost (bigint (max n 0)))))) :ruleset cost-values)
(rule ((Fixed n)) ((set (CostExtent (Fixed n)) (bigint (max n 0)))) :ruleset cost-values)
(rule ((Length source) (= ty (SourceType source)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (CostExtent (Length source)) (bigint (max n 0)))) :ruleset cost-values)
(rule ((Scalar source) (= n (SourceConstantInteger source)))
      ((set (CostExtent (Scalar source)) (bigint (max n 0)))) :ruleset cost-values)
(rule ((Product a b) (= x (CostExtent a)) (= y (CostExtent b)))
      ((set (CostExtent (Product a b)) (min cost-limit (* x y)))) :ruleset cost-values)
(rule ((Sum a b) (= x (CostExtent a)) (= y (CostExtent b)))
      ((set (CostExtent (Sum a b)) (min cost-limit (+ x y)))) :ruleset cost-values)
(rule ((Difference a b) (= x (CostExtent a)) (= y (CostExtent b)))
      ((set (CostExtent (Difference a b)) (max (bigint 0) (- x y)))) :ruleset cost-values)
(rule ((= (SourceOperation op) (OperationInfo r "index")))
      ((set (CostValue (OperationCost op)) (bigint 0))) :ruleset cost-values)
(rule ((= (SourceOperation op) (OperationInfo r "control")) (= source (SourceOperationValue op))
       (= (CostHasLoop source) false)) ((set (CostValue (OperationCost op)) (bigint 0))) :ruleset cost-values)
(rule ((CostArrayOperation op)
       (= n (CostExtent (SourceDomainExtent op))) (= body (SourceOperatorBody op))
       (= inner (CostValue (RegionCost body))))
      ((set (CostValue (OperationCost op)) (min cost-limit (* n (min cost-limit (+ inner (bigint 1))))))) :ruleset cost-values)
(rule ((= (SourceOperation op) (OperationInfo r "control")) (= source (SourceOperationValue op))
       (= (SourceLoopForm source) (ForCount count ty)) (= n (SourceConstantInteger count)) (<= n 0))
      ((set (CostValue (OperationCost op)) (bigint 0))) :ruleset cost-values)
(rule ((= (SourceOperation op) (OperationInfo r "control")) (= source (SourceOperationValue op))
       (= (SourceLoop source) (LoopInfo header body)) (= (SourceLoopForm source) (ForCount count ty))
       (= n (SourceConstantInteger count)) (> n 0) (= h (CostValue (RegionCost header))) (= b (CostValue (RegionCost body))))
      ((set (CostValue (OperationCost op)) (min cost-limit (* (bigint n) (+ (+ h b) (bigint 2)))))) :ruleset cost-values)
(rule ((SourceLoopCarry source slot initial state next output false) (= ty (SourceType state)) (= n (SourceByteSize ty)))
      ((set (CostValue (StateCost source slot)) (bigint (max n 0)))) :ruleset cost-values)
(rule ((SourceLoopCarry source slot initial state next output true) (= ty (SourceType state))
       (= (SourceArraySize ty) (FixedSize size)) (= n (SourceByteSize ty)))
      ((set (CostValue (StateCost source slot)) (bigint (max n 0)))) :ruleset cost-values)
(rule ((SourceDispatchLoop source) (= (SourceLoop source) (LoopInfo header body))
       (= h (CostValue (RegionCost header))) (= b (CostValue (RegionCost body)))
       (= items (CostLoopItems source)) (> (set-length items) 0) (= bytes (CostTotal items))
       (= conditional (CostConditional source)))
      ((set (CostLocal source) (wyn-local-loop (min cost-limit (+ h b)) bytes conditional))) :ruleset cost-values)
(run-schedule (saturate cost-inputs) (saturate cost-requests) (saturate cost-values))
(rule ((SourceDispatchLoop source) (= op (SourceValueOperation source)) (= local (CostLocal source)))
      ((set (LoopDispatchProfitable op) (not local))) :ruleset loop-cost-select)
(run-schedule loop-cost-select)
