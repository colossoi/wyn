; Additional facts and rules in the scheduling program. No separate egraph.
(datatype EvaluationKey (EvalExpr i64) (EvalOperation i64) (EvalRegion i64))
(datatype EvaluationList (NoEvaluations) (Evaluations EvaluationKey EvaluationList))
(relation Evaluation (EvaluationKey))
(relation EvaluationDependency (EvaluationKey EvaluationKey))
(relation DeviceValue (EvaluationKey))
(relation EvaluationClass (EvaluationKey String))
(relation LocalWork (EvaluationKey i64))
(relation EvaluationWork (EvaluationKey EvaluationList))
(relation MutableValue (i64))
(relation BackingChild (i64 i64))
(relation ForwardingResult (i64 OperationKey))
(relation ReadsValue (EvaluationKey i64))
(function CpuBlocked (EvaluationKey) bool :merge (or old new))
(function Work (EvaluationKey) i64 :merge (max old new))
(function ListWork (EvaluationList) i64 :merge (max old new))
(function Rematerialize (OperationKey) bool :merge (or old new))
(relation ScalarResult (ExprKey OperationKey))
(relation HostValue (i64))
(relation HostOperation (i64))
; Source order comes from the shared dependency scheduler. Fuse only consecutive
; GPU scalar invocations with proven effects and no nested collective.
(relation SourcePosition (OperationKey RegionKey i64))
(relation Consecutive (OperationKey OperationKey))
(relation ScalarGroupCandidate (OperationKey))
(function GroupStart (OperationKey) i64 :merge (min old new))
(function HasSourcePosition (OperationKey) bool :merge (or old new))
(relation ScalarGroup (OperationKey OperationKey))
(relation PlannedScalar (i64 i64 i64))
(rule ((ScalarValue (OperationId op) t) (ScalarGroup (OperationId op) (OperationId leader))
       (Phase (Stage (OperationId leader) "scalar") r) (SourcePosition (OperationId op) r i))
      ((PlannedScalar leader op i)) :ruleset readout)
(rule ((Site op r)) ((set (HasSourcePosition op) false)) :ruleset structure)
(rule ((SourcePosition op r i)) ((set (GroupStart op) i) (set (HasSourcePosition op) true)) :ruleset structure)
(rule ((ScalarCandidate (OperationId op) t) (= (ContainsCollective (OperationId op)) false)
       (= (ParallelSafe (OperationId op)) true) (= (CpuBlocked (EvalOperation op)) true)
       (>= (Work (EvalOperation op)) 9)) ((ScalarGroupCandidate (OperationId op))) :ruleset classify)
(rule ((Consecutive before after) (ScalarGroupCandidate before) (ScalarGroupCandidate after)
       (= first (GroupStart before))) ((set (GroupStart after) first)) :ruleset classify)
(rule ((Site op r) (= (HasSourcePosition op) false)) ((ScalarGroup op op)) :ruleset residency)
(rule ((Site op r) (= first (GroupStart op)) (SourcePosition leader r first))
      ((ScalarGroup op leader)) :ruleset residency)
(rule ((Evaluation e)) ((set (CpuBlocked e) false) (set (Work e) 0)) :ruleset structure)
(rule ((Site op r)) ((set (Rematerialize op) false)) :ruleset structure)
(rule ((DeviceValue e)) ((set (CpuBlocked e) true)) :ruleset structure)
(rule ((EvaluationDependency e child) (= (CpuBlocked child) true))
      ((set (CpuBlocked e) true)) :ruleset structure)
(rule ((BackingChild e child) (MutableValue child)) ((MutableValue e)) :ruleset structure)
(rule ((ForwardingResult e op) (Operand op role (ExprId child))) ((BackingChild e child)) :ruleset structure)
(rule ((ForwardingResult e op) (Enters op r) (ExitValue r (ExprId child))) ((BackingChild e child)) :ruleset structure)
(rule ((ReadsValue e array) (MutableValue array)) ((set (Work e) 9)) :ruleset structure)
(rule ((EvaluationClass e "leaf")) ((LocalWork e 0)) :ruleset structure)
(rule ((EvaluationClass e "simple")) ((LocalWork e 1)) :ruleset structure)
(rule ((EvaluationClass e "opaque")) ((LocalWork e 9)) :ruleset structure)
(rule ((EvaluationClass e "loop")) ((LocalWork e 9)) :ruleset structure)
(rule ((EvaluationClass e "collective")) ((LocalWork e 9)) :ruleset structure)
(rule ((= list (NoEvaluations))) ((set (ListWork list) 0)) :ruleset structure)
(rule ((= list (Evaluations child rest)) (= a (Work child)) (= b (ListWork rest)))
      ((set (ListWork list) (min 9 (+ a b)))) :ruleset structure)
(rule ((EvaluationWork e children) (LocalWork e own) (= work (ListWork children)))
      ((set (Work e) (min 9 (+ own work)))) :ruleset structure)
; Classification observes completed proofs, never provisional false/default values.
(rule ((Evaluation (EvalExpr e)) (= (CpuBlocked (EvalExpr e)) false)) ((HostValue e)) :ruleset classify)
(rule ((Site (OperationId op) r) (= (CpuBlocked (EvalOperation op)) false))
      ((HostOperation op)) :ruleset classify)
; Work is a conservative upper bound, capped one above the eight-unit budget.
; Effects, mutable reads and unbounded work exhaust that duplication budget.
(rule ((ScalarCandidate (OperationId op) t) (= (ParallelSafe (OperationId op)) true)
       (<= (Work (EvalOperation op)) 8) (= (CpuBlocked (EvalOperation op)) true)
       (= (ContainsCollective (OperationId op)) false))
      ((set (Rematerialize (OperationId op)) true)) :ruleset classify)
(rule ((ScalarResult e op) (= (Rematerialize op) false)) ((DirectResult e op 0)) :ruleset residency)
(rule ((ScalarResult e op) (= (Rematerialize op) true))
      ((ComputedValue e)) :ruleset residency)
(rule ((ScalarResult e op) (= (Rematerialize op) true) (Operand op role child))
      ((ChildValue e child)) :ruleset residency)
(rule ((= (Rematerialize op) true) (Enters op r)) ((DeviceRegion r)) :ruleset residency)
(rule ((AbiRootNeed root (AbiExpr e)) (ScalarResult (ExprId e) op)
       (= (Rematerialize op) true) (Enters op r)) ((AbiInvokes root r)) :ruleset abi)
