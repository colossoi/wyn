; Additional facts and rules in the scheduling program. No separate egraph.
(function Rematerialize (OperationKey) bool :merge (or old new))
(relation InvocationResult (SourceValue OperationKey))
(relation LengthOperation (OperationKey SourceValue))
(function ReadsLength (OperationKey) bool :merge (or old new))
(relation LengthReference (SourceValue SourceValue))
(relation ReferencedExtent (SourceValue Extent))
(function ViewExtent (SourceValue) Extent :no-merge)
; Source order comes from the shared dependency scheduler. Scalar invocations
; may join across independent, effect-free work in the same source region.
(relation PlannedSourcePosition (OperationKey RegionKey i64))
(relation OperationOrderPosition (OperationKey RegionKey i64))
(relation Consecutive (OperationKey OperationKey))
(function IsScalarGroupCandidate (OperationKey) bool :merge (or old new))
(relation DispatchGroupWindow (OperationKey OperationKey))
(function DispatchGroupJoinBlocked (OperationKey OperationKey) bool :merge (or old new))
(relation DispatchGroupDependency (OperationKey OperationKey))
(function DispatchGroupJoined (OperationKey) bool :merge (or old new))
(ruleset scalar-windows)
(ruleset scalar-blockers)
(ruleset scalar-groups)
(function GroupStart (OperationKey) i64 :merge (min old new))
(relation DispatchGroupLeader (OperationKey OperationKey))
(rule ((= r (OperationRegion op)))
      ((set (IsScalarGroupCandidate op) false)
       (set (DispatchGroupJoined op) false)) :ruleset structure)
(rule ((OperationOrderPosition op r i)) ((set (GroupStart op) i)) :ruleset structure)
(rule ((= (IsScalarGroupCandidate before) true) (Consecutive before after))
      ((DispatchGroupWindow before after)) :ruleset scalar-windows)
(rule ((DispatchGroupWindow before middle) (= (IsScalarGroupCandidate middle) false)
       (= (ParallelSafe middle) true) (Consecutive middle after))
      ((DispatchGroupWindow before after)) :ruleset scalar-windows)
(rule ((DispatchGroupWindow before after) (= (IsScalarGroupCandidate after) true))
      ((set (DispatchGroupJoinBlocked before after) false)) :ruleset scalar-windows)
(rule ((= (IsScalarGroupCandidate after) true) (OperationDependency after before)) ((DispatchGroupDependency after before)) :ruleset scalar-windows)
(rule ((DispatchGroupDependency after middle) (= (Rematerialize middle) true) (OperationDependency middle before))
      ((DispatchGroupDependency after before)) :ruleset scalar-windows)
; A rematerialized expression moves with its use. Every stored dependency must
; precede the join point. Authored effects stop the window before it can join.
(rule ((= blocked (DispatchGroupJoinBlocked before after)) (OperationOrderPosition before r position)
       (DispatchGroupDependency after dependency) (OperationOrderPosition dependency r needed)
       (> needed position) (= (Rematerialize dependency) false))
      ((set (DispatchGroupJoinBlocked before after) true)) :ruleset scalar-blockers)
(rule ((= (DispatchGroupJoinBlocked before after) false)
       (= first (GroupStart before)))
      ((set (GroupStart after) first) (set (DispatchGroupJoined after) true)) :ruleset scalar-groups)
(rule ((HostRegion r) (= r (OperationRegion op)) (= first (GroupStart op)) (OperationOrderPosition leader r first))
      ((DispatchGroupLeader op leader)) :ruleset residency)
(rule ((= r (OperationRegion op))) ((set (Rematerialize op) false)) :ruleset structure)
(rule ((= r (OperationRegion op))) ((set (ReadsLength op) false)) :ruleset structure)
(rule ((LengthOperation op array)) ((set (ReadsLength op) true)) :ruleset structure)
(rule ((InvocationResult e op) (= (DispatchLoopSelected op) false) (= (Rematerialize op) false) (= (RuntimeArrayJoin e) false) (= (HasViewStage e) false)) ((DirectResult e op 0)) :ruleset residency)
(rule ((InvocationResult e op) (= (Rematerialize op) true))
      ((ComputedValue e)) :ruleset residency)
(rule ((InvocationResult e op) (= (Rematerialize op) true) (= (ReadsLength op) false) (Operand op role child))
      ((FlowReferenceEdge e child)) :ruleset residency)
; Structured scalar bodies can capture earlier results without listing them
; as direct operands. Carry those dependencies into the rematerialized value,
; so publication cannot mistake an element read for a count-only expression.
(rule ((InvocationResult e op) (= (Rematerialize op) true) (= (ReadsLength op) false)
       (OperationDependency op before) (InvocationResult child before))
      ((FlowReferenceEdge e child)) :ruleset residency)
(rule ((InvocationResult e op) (= (Rematerialize op) true) (= (ReadsLength op) false)
       (OperationDependency op before) (ResultTuple child before))
      ((FlowReferenceEdge e child)) :ruleset residency)
; A length use needs the logical extent, never the old element contents.
; Resolve those metadata dependencies at the length definition; ordinary
; References/FlowReferenceEdge propagation carries them through enclosing expressions.
(rule ((InvocationResult e op) (= (Rematerialize op) true) (LengthOperation op array))
      ((LengthReference e array)) :ruleset residency)
(rule ((ReferenceDemand e) (LengthReference e array) (= (ValueRef array) (Source source)))
      ((References e (Descriptor source))) :ruleset residency)
(rule ((LengthReference e array) (= (SourceSlice array) (SliceInfo source start end)))
      ((FlowReferenceEdge e start) (FlowReferenceEdge e end)) :ruleset residency)
(rule ((LengthReference e array) (= (ValueRef array) value) (= n (LiveLength value)))
      ((ReferencedExtent e n)) :ruleset residency)
(rule ((LengthReference e array) (= n (ViewExtent array)))
      ((ReferencedExtent e n)) :ruleset residency)
(rule ((LengthReference e array) (= (ValueRef array) value) (= source (SameBacking value)))
      ((LengthReference e source)) :ruleset residency)
(rule ((ReferencedExtent e (Length array))) ((LengthReference e array)) :ruleset residency)
(rule ((ReferenceDemand e) (ReferencedExtent e (Stored value))) ((References e (Contents value))) :ruleset residency)
(rule ((ReferencedExtent e (Scalar child))) ((FlowReferenceEdge e child)) :ruleset residency)
(rule ((ReferencedExtent e (Product a b))) ((ReferencedExtent e a) (ReferencedExtent e b)) :ruleset residency)
(rule ((ReferencedExtent e (Difference a b))) ((ReferencedExtent e a) (ReferencedExtent e b)) :ruleset residency)
; Keep exact view extents available even when their element slots are unused.
; Direct results and forwarding preserve lengths; sliced views keep their own
; bounds and must not inherit the backing resource's live length.
(rule ((DirectResult e op i) (= (ResultRead op i) (ReadView value)) (= n (LiveLength value))) ((set (ViewExtent e) n)) :ruleset residency)
(rule ((Projection e tuple i) (ResultTuple tuple op) (ArrayResult op i t) (= n (LiveLength (Result op i))))
      ((set (ViewExtent e) n)) :ruleset residency)
(rule ((Projection e tuple 1) (ResultTuple tuple op) (BucketResult op destination))
      ((set (ViewExtent e) (Length destination))) :ruleset residency)
(rule ((ForwardValue e source) (= n (ViewExtent source))) ((set (ViewExtent e) n)) :ruleset residency)
(rule ((= (SourceSlice e) (SliceInfo source start end))) ((set (ViewExtent e) (Difference (Scalar end) (Scalar start)))) :ruleset residency)
(rule ((= (Rematerialize op) true) (Enters op r)) ((DeviceRegion r)) :ruleset residency)

(rule ((ReferencedExtent e (Sum a b))) ((ReferencedExtent e a) (ReferencedExtent e b)) :ruleset residency)

; Dispatch ordering.
; Direct producer/consumer edges suffice: do not materialize transitive closure.
(rule ((Produces a value) (Needs b value) (!= a b) (Phase a r) (Phase b r))
      ((OrderEdge (At a) (At b))) :ruleset dispatch)
; An authored update may share backing, but readers of the old value must finish
; first. Join on that particular value version, never on all pairs of stages.
; Length-only needs do not observe the old contents and must not reverse a
; producer/consumer dependency through an in-place update.
(rule ((Clobbers writer old) (Requires (InStage reader) old) (Phase writer r) (Phase reader r) (!= reader writer))
      ((OrderEdge (At reader) (At writer))) :ruleset dispatch)
(rule ((Clobbers writer old) (Needs (Stage op "scalar") old)
       (Phase writer r) (Phase (Stage op "scalar") r) (!= (Stage op "scalar") writer))
      ((OrderEdge (At (Stage op "scalar")) (At writer))) :ruleset dispatch)

; An operation has separate start/end boundaries so its internal phases remain
; ordered without a cycle through one source-operation node.
(rule ((FirstPhase op stage)) ((OrderEdge (Start op) (At stage))) :ruleset dispatch)
(rule ((LastPhase op stage)) ((OrderEdge (At stage) (End op))) :ruleset dispatch)
(rule ((InvocationResult value op)) ((OrderEdge (Start op) (End op))) :ruleset dispatch)
(rule ((EffectInput gate op)) ((OrderEdge (End op) (Gate gate))) :ruleset dispatch)
; A proven scalar join executes at its leader, whose incoming gates remain.
; Its original gate may include the independent work it has moved ahead of.
(rule ((EffectWait op gate) (= (DispatchGroupJoined op) false))
      ((OrderEdge (Gate gate) (Start op))) :ruleset dispatch)
; Preserve direct dependencies through scalar/control boundaries;
; SOAC-to-SOAC flow uses the actual component writer.
(rule ((OperationDependency after before) (InvocationResult value after) (= r (OperationRegion after)) (= r (OperationRegion before)))
      ((OrderEdge (End before) (Start after))) :ruleset dispatch)
(rule ((OperationDependency after before) (InvocationResult value before) (= r (OperationRegion after)) (= r (OperationRegion before)))
      ((OrderEdge (End before) (Start after))) :ruleset dispatch)
(rule ((Requires (InOperation op) value) (Produces stage value) (= r (OperationRegion op)) (Phase stage r))
      ((OrderEdge (At stage) (Start op))) :ruleset dispatch)

; Read out immediate dispatch predecessors, traversing only non-launch nodes.
; Stop at a launch, so a chain remains linear instead of becoming its closure.
(rule ((Phase stage r) (OrderEdge before (At stage))) ((DispatchWaitsFor stage before)) :ruleset dispatch)
(rule ((DispatchWaitsFor after (Start op)) (OrderEdge before (Start op))) ((DispatchWaitsFor after before)) :ruleset dispatch)
(rule ((DispatchWaitsFor after (End op)) (OrderEdge before (End op))) ((DispatchWaitsFor after before)) :ruleset dispatch)
(rule ((DispatchWaitsFor after (Gate gate)) (OrderEdge before (Gate gate))) ((DispatchWaitsFor after before)) :ruleset dispatch)
(rule ((DispatchWaitsFor after (At before)) (Phase before r) (Phase after r) (!= before after))
      ((DispatchDependency before after)) :ruleset dispatch)

; Select a dependency order within each invocation before forming scalar groups.
(sort ScheduledOperations (Set OperationKey))
(function OrderPrerequisites (OperationKey) ScheduledOperations :merge (set-union old new))
(function OrderSatisfied (OperationKey) ScheduledOperations :merge (set-union old new))
(relation OrderReady (OperationKey RegionKey i64))
(relation OrderPending (OperationKey RegionKey i64))
(relation OrderRound (RegionKey i64))
(function OrderFirst (RegionKey i64) i64 :merge (min old new))
(ruleset order-import)
(ruleset order-select)
(ruleset order-emit)
(rule ((PlannedSourcePosition op r i))
      ((set (OrderPrerequisites op) (set-empty)) (set (OrderSatisfied op) (set-empty))
       (OrderPending op r i) (OrderRound r 0)) :ruleset order-import)
(rule ((OperationDependency after before) (PlannedSourcePosition after r i) (PlannedSourcePosition before r j))
      ((set (OrderPrerequisites after) (set-of before))) :ruleset order-import)
(rule ((EffectInput gate before) (EffectWait after gate)
       (PlannedSourcePosition after r i) (PlannedSourcePosition before r j))
      ((set (OrderPrerequisites after) (set-of before))) :ruleset order-import)
(rule ((= deps (OrderPrerequisites after)) (set-contains deps before)
       (OperationOrderPosition before r n))
      ((set (OrderSatisfied after) (set-of before))) :ruleset order-select)
(rule ((OrderPending op r i) (= (OrderPrerequisites op) (OrderSatisfied op)))
      ((OrderReady op r i)) :ruleset order-select)
(rule ((OrderRound r n) (OrderReady op r i))
      ((set (OrderFirst r n) i)) :ruleset order-select)
(rule ((OrderRound r n) (= i (OrderFirst r n)) (OrderReady op r i))
      ((OperationOrderPosition op r n) (delete (OrderReady op r i))
       (delete (OrderPending op r i)) (delete (OrderRound r n)) (OrderRound r (+ n 1))) :ruleset order-emit)
(rule ((OperationOrderPosition before r i) (OperationOrderPosition after r j) (= j (+ i 1)))
      ((Consecutive before after)) :ruleset order-emit)
