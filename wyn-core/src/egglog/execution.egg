; Additional facts and rules in the scheduling program. No separate egraph.
(function Rematerialize (OperationKey) bool :merge (or old new))
(relation InvocationResult (SourceValue OperationKey))
(relation LengthOperation (OperationKey SourceValue))
(function ReadsLength (OperationKey) bool :merge (or old new))
(relation LengthReference (SourceValue SourceValue))
(relation ReferencedExtent (SourceValue Extent))
(function ViewExtent (SourceValue) Extent :no-merge)
; Source order comes from the shared dependency scheduler. Scalar invocations
; may join across independent, effect-free work in the same source region.
(relation SourcePosition (OperationKey RegionKey i64))
(relation Consecutive (OperationKey OperationKey))
(function IsScalarGroupCandidate (OperationKey) bool :merge (or old new))
(relation DispatchGroupWindow (OperationKey OperationKey))
(function DispatchGroupJoinBlocked (OperationKey OperationKey) bool :merge (or old new))
(relation DispatchGroupDependency (OperationKey OperationKey))
(function DispatchGroupJoined (OperationKey) bool :merge (or old new))
(ruleset scalar-windows)
(ruleset scalar-blockers)
(ruleset scalar-groups)
(function GroupStart (OperationKey) i64 :merge (min old new))
(relation DispatchGroupLeader (OperationKey OperationKey))
(rule ((Site op r))
      ((set (IsScalarGroupCandidate op) false)
       (set (DispatchGroupJoined op) false)) :ruleset structure)
(rule ((SourcePosition op r i)) ((set (GroupStart op) i)) :ruleset structure)
(rule ((= (IsScalarGroupCandidate before) true) (Consecutive before after))
      ((DispatchGroupWindow before after)) :ruleset scalar-windows)
(rule ((DispatchGroupWindow before middle) (= (IsScalarGroupCandidate middle) false)
       (= (ParallelSafe middle) true) (Consecutive middle after))
      ((DispatchGroupWindow before after)) :ruleset scalar-windows)
(rule ((DispatchGroupWindow before after) (= (IsScalarGroupCandidate after) true))
      ((set (DispatchGroupJoinBlocked before after) false)) :ruleset scalar-windows)
(rule ((= (IsScalarGroupCandidate after) true) (SourceDependency after before)) ((DispatchGroupDependency after before)) :ruleset scalar-windows)
(rule ((DispatchGroupDependency after middle) (= (Rematerialize middle) true) (SourceDependency middle before))
      ((DispatchGroupDependency after before)) :ruleset scalar-windows)
; A rematerialized expression moves with its use. Every stored dependency must
; precede the join point. Authored effects stop the window before it can join.
(rule ((= blocked (DispatchGroupJoinBlocked before after)) (SourcePosition before r position)
       (DispatchGroupDependency after dependency) (SourcePosition dependency r needed)
       (> needed position) (= (Rematerialize dependency) false))
      ((set (DispatchGroupJoinBlocked before after) true)) :ruleset scalar-blockers)
(rule ((= (DispatchGroupJoinBlocked before after) false)
       (= first (GroupStart before)))
      ((set (GroupStart after) first) (set (DispatchGroupJoined after) true)) :ruleset scalar-groups)
(rule ((HostRegion r) (Site op r) (= first (GroupStart op)) (SourcePosition leader r first))
      ((DispatchGroupLeader op leader)) :ruleset residency)
(rule ((Site op r)) ((set (Rematerialize op) false)) :ruleset structure)
(rule ((Site op r)) ((set (ReadsLength op) false)) :ruleset structure)
(rule ((LengthOperation op array)) ((set (ReadsLength op) true)) :ruleset structure)
(rule ((InvocationResult e op) (= (Rematerialize op) false)) ((DirectResult e op 0)) :ruleset residency)
(rule ((InvocationResult e op) (= (Rematerialize op) true))
      ((ComputedValue e)) :ruleset residency)
(rule ((InvocationResult e op) (= (Rematerialize op) true) (= (ReadsLength op) false) (Operand op role child))
      ((ChildValue e child)) :ruleset residency)
; Structured scalar bodies can capture earlier results without listing them
; as direct operands. Carry those dependencies into the rematerialized value,
; so publication cannot mistake an element read for a count-only expression.
(rule ((InvocationResult e op) (= (Rematerialize op) true) (= (ReadsLength op) false)
       (SourceDependency op before) (InvocationResult child before))
      ((ChildValue e child)) :ruleset residency)
(rule ((InvocationResult e op) (= (Rematerialize op) true) (= (ReadsLength op) false)
       (SourceDependency op before) (ResultTuple child before))
      ((ChildValue e child)) :ruleset residency)
; A length use needs the logical extent, never the old element contents.
; Resolve those metadata dependencies at the length definition; ordinary
; References/ChildValue propagation carries them through enclosing expressions.
(rule ((InvocationResult e op) (= (Rematerialize op) true) (LengthOperation op array))
      ((LengthReference e array)) :ruleset residency)
(rule ((ReferenceDemand e) (LengthReference e array) (ValueRef array (Source source)))
      ((References e (Descriptor source))) :ruleset residency)
(rule ((LengthReference e array) (SliceView array source start end))
      ((ChildValue e start) (ChildValue e end)) :ruleset residency)
(rule ((LengthReference e array) (ValueRef array value) (= n (LiveLength value)))
      ((ReferencedExtent e n)) :ruleset residency)
(rule ((LengthReference e array) (= n (ViewExtent array)))
      ((ReferencedExtent e n)) :ruleset residency)
(rule ((LengthReference e array) (ValueRef array value) (= source (SameBacking value)))
      ((LengthReference e source)) :ruleset residency)
(rule ((ReferencedExtent e (Length array))) ((LengthReference e array)) :ruleset residency)
(rule ((ReferenceDemand e) (ReferencedExtent e (Stored value))) ((References e (Contents value))) :ruleset residency)
(rule ((ReferencedExtent e (Scalar child))) ((ChildValue e child)) :ruleset residency)
(rule ((ReferencedExtent e (Product a b))) ((ReferencedExtent e a) (ReferencedExtent e b)) :ruleset residency)
(rule ((ReferencedExtent e (Difference a b))) ((ReferencedExtent e a) (ReferencedExtent e b)) :ruleset residency)
; Keep exact view extents available even when their element slots are unused.
; Direct results and forwarding preserve lengths; sliced views keep their own
; bounds and must not inherit the backing resource's live length.
(rule ((ParameterValue e)) ((set (ViewExtent e) (Length e))) :ruleset residency)
(rule ((DirectResult e op i) (= (ResultRead op i) (ReadView value)) (= n (LiveLength value))) ((set (ViewExtent e) n)) :ruleset residency)
(rule ((Projection e tuple i) (ResultTuple tuple op) (ArrayResult op i t) (= n (LiveLength (Result op i))))
      ((set (ViewExtent e) n)) :ruleset residency)
(rule ((Projection e tuple 1) (ResultTuple tuple op) (BucketResult op destination))
      ((set (ViewExtent e) (Length destination))) :ruleset residency)
(rule ((ForwardValue e source) (= n (ViewExtent source))) ((set (ViewExtent e) n)) :ruleset residency)
(rule ((SliceView e source start end)) ((set (ViewExtent e) (Difference (Scalar end) (Scalar start)))) :ruleset residency)
(rule ((= (Rematerialize op) true) (Enters op r)) ((DeviceRegion r)) :ruleset residency)
