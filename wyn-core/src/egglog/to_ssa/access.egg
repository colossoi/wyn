; Keyed read access to selected facts. This ruleset runs once after optimization.
(ruleset ssa-access)
; SourceExprKey is a function; its inverse needs a keyed table.
(function SsaExprSource (ExprKey) SourceValue :no-merge)
(rule ((= e (SourceExprKey v))) ((set (SsaExprSource e) v)) :ruleset ssa-access)
(function SsaAlias (SourceValue) SourceValue :no-merge)
(rule ((SourceAlias x y)) ((set (SsaAlias x) y)) :ruleset ssa-access)
(function SsaDefinition (i64) RegionKey :no-merge)
(rule ((SourceDefinition x y)) ((set (SsaDefinition x) y)) :ruleset ssa-access)
(function SsaContext (RegionKey) ScalarContext :merge new)
(function SsaParameter (RegionKey i64) SourceValue :no-merge)
(rule ((SourceParameter r i v)) ((set (SsaParameter r i) v)) :ruleset ssa-access)
(function SsaResult (RegionKey) SourceValue :no-merge)
(rule ((SourceResult x y)) ((set (SsaResult x) y)) :ruleset ssa-access)
(function SsaCallable (SourceValue) RegionKey :no-merge)
(rule ((SourceCallable x y)) ((set (SsaCallable x) y)) :ruleset ssa-access)
(function SsaBranchYes (SourceValue) RegionKey :no-merge)
(rule ((SourceBranch x c y n)) ((set (SsaBranchYes x) y)) :ruleset ssa-access)
(function SsaBranchNo (SourceValue) RegionKey :no-merge)
(rule ((SourceBranch x c y n)) ((set (SsaBranchNo x) n)) :ruleset ssa-access)
(function SsaLoopHeader (SourceValue) RegionKey :no-merge)
(rule ((SourceLoop x h i)) ((set (SsaLoopHeader x) h)) :ruleset ssa-access)
(function SsaLoopIteration (SourceValue) RegionKey :no-merge)
(rule ((SourceLoop x h i)) ((set (SsaLoopIteration x) i)) :ruleset ssa-access)
(function SsaLoopState (RegionKey) SourceValue :no-merge)
(rule ((SourceLoopInitial x y v)) ((set (SsaLoopState x) y)) :ruleset ssa-access)
(function SsaIteration (RegionKey) SourceValue :no-merge)
(rule ((SourceIterationValue x y)) ((set (SsaIteration x) y)) :ruleset ssa-access)
(function SsaDestination (OperationKey) SourceValue :no-merge)
(rule ((SourceDestination x y)) ((set (SsaDestination x) y)) :ruleset ssa-access)
(function SsaOperation (SourceValue) OperationKey :no-merge)
(rule ((SourceOperationValue y x)) ((set (SsaOperation x) y)) :ruleset ssa-access)
(function SsaCallback (OperationKey) RegionKey :no-merge)
(rule ((SourceOperatorBody x y)) ((set (SsaCallback x) y)) :ruleset ssa-access)
(function SsaProjectionBase (SourceValue) SourceValue :no-merge)
(rule ((SourceProjection x y i)) ((set (SsaProjectionBase x) y)) :ruleset ssa-access)
(function SsaProjectionIndex (SourceValue) i64 :no-merge)
(rule ((SourceProjection x y i)) ((set (SsaProjectionIndex x) i)) :ruleset ssa-access)
(function SsaArrayPart (SourceValue) SourceValue :no-merge)
(rule ((SourceArrayPart x 0 y)) ((set (SsaArrayPart x) y)) :ruleset ssa-access)
(function SsaSliceBase (SourceValue) SourceValue :no-merge)
(rule ((SourceSlice x a b c)) ((set (SsaSliceBase x) a)) :ruleset ssa-access)
(function SsaSliceStart (SourceValue) SourceValue :no-merge)
(rule ((SourceSlice x a b c)) ((set (SsaSliceStart x) b)) :ruleset ssa-access)
(function SsaSliceEnd (SourceValue) SourceValue :no-merge)
(rule ((SourceSlice x a b c)) ((set (SsaSliceEnd x) c)) :ruleset ssa-access)
(function SsaInputAt (OperationKey i64) SourceValue :no-merge)
(rule ((SourceInput o i v)) ((set (SsaInputAt o i) v)) :ruleset ssa-access)
(function SsaCaptureAt (RegionKey SourceValue) SourceValue :no-merge)
(rule ((SourceCapture r p v)) ((set (SsaCaptureAt r p) v)) :ruleset ssa-access)
(rule ((ScalarInvocation p o r e) (= c (ScalarKernel p))) ((set (SsaContext r) c)) :ruleset ssa-access)
(sort SsaSources (Set SourceValue))
(function SsaCaptures (RegionKey) SsaSources :merge (set-union old new))
(rule ((SourceCapture r p v)) ((set (SsaCaptures r) (set-of p))) :ruleset ssa-access)
(function SsaInputCount (OperationKey) i64 :merge (max old new))
(rule ((SourceInput o i v)) ((set (SsaInputCount o) (+ i 1))) :ruleset ssa-access)
(relation SsaDeviceOperation (OperationKey))
(rule ((DeviceOperation o)) ((SsaDeviceOperation o)) :ruleset ssa-access)
(rule ((PlannedOperation o owner p r) (DeviceOperation owner)) ((SsaDeviceOperation o)) :ruleset ssa-access)
(function SsaDefinitionName (RegionKey) i64 :no-merge)
(rule ((SourceDefinition s r)) ((set (SsaDefinitionName r) s)) :ruleset ssa-access)
(function SsaCaptured (SourceValue) SourceValue :no-merge)
(rule ((SourceCapture r p v)) ((set (SsaCaptured p) v)) :ruleset ssa-access)
(function SsaGroup (OperationKey) FusionPlan :no-merge)
(rule ((PlannedOperation o owner p r)) ((set (SsaGroup o) p)) :ruleset ssa-access)
(function SsaSource (OperationKey) SourceValue :no-merge)
(rule ((SourceOperationValue o v)) ((set (SsaSource o) v)) :ruleset ssa-access)
(function SsaValueRef (SourceValue) ValueKey :no-merge)
(rule ((ValueRef e b) (= e (SourceExprKey v))) ((set (SsaValueRef v) b)) :ruleset ssa-access)
(function SsaExternal (ValueKey) SourceValue :no-merge)
(rule ((= b (Source e)) (= e (SourceExprKey v))) ((set (SsaExternal b) v)) :ruleset ssa-access)
(function SsaLiveLength (ValueKey) Extent :no-merge)
(rule ((LiveLength b e)) ((set (SsaLiveLength b) e)) :ruleset ssa-access)
(function SsaViewLength (i64) Extent :no-merge)
(rule ((PlannedViewLength v e)) ((set (SsaViewLength v) e)) :ruleset ssa-access)
(function SsaSlot (OperationKey String i64) ValueKey :no-merge)
(rule ((BufferSlot o role i b)) ((set (SsaSlot o role i) b)) :ruleset ssa-access)
(function SsaDomain (OperationKey) Extent :no-merge)
(rule ((InputDomain o e)) ((set (SsaDomain o) e)) :ruleset ssa-access)
(function SsaBucketAxis (OperationKey i64) Extent :no-merge)
(rule ((SourceBucketAxis o i e)) ((set (SsaBucketAxis o i) e)) :ruleset ssa-access)
(function SsaAtomic (OperationKey) AtomicUpdate :no-merge)
(rule ((= (Plan o) (Atomic u))) ((set (SsaAtomic o) u)) :ruleset ssa-access)
(function SsaResultAt (FusionPlan String i64) SourceValue :no-merge)
(rule ((PlanResult p role i v t)) ((set (SsaResultAt p role i) v)) :ruleset ssa-access)
(function SsaCountAt (FusionPlan i64) OperationKey :no-merge)
(rule ((PlanCountSlot p owner i t) (PlanMember owner o) (SourceOperation o r "filter")) ((set (SsaCountAt p i) o)) :ruleset ssa-access)
(function SsaOutputBacking (i64) ValueKey :no-merge)
(rule ((OutputBacking o b)) ((set (SsaOutputBacking o) b)) :ruleset ssa-access)
(function SsaOutputWriter (i64) StageKey :no-merge)
(rule ((OutputWriter o (KernelRoot k))) ((set (SsaOutputWriter o) k)) :ruleset ssa-access)
(function SsaPinnedSet (i64) i64 :no-merge)
(rule ((AbiOutputBinding o s b)) ((set (SsaPinnedSet o) s)) :ruleset ssa-access)
(function SsaPinnedBinding (i64) i64 :no-merge)
(rule ((AbiOutputBinding o s b)) ((set (SsaPinnedBinding o) b)) :ruleset ssa-access)
(sort SsaOperations (Set OperationKey))
(sort SsaStages (Set StageKey))
(sort SsaResources (Set ValueKey))
(function SsaMembers (FusionPlan) SsaOperations :merge (set-union old new))
(rule ((PlanMember p o)) ((set (SsaMembers p) (set-of o))) :ruleset ssa-access)
(function SsaScalarGroup (OperationKey) SsaOperations :merge (set-union old new))
(rule ((ScalarGroup o owner)) ((set (SsaScalarGroup owner) (set-of o))) :ruleset ssa-access)
(function SsaDependencies (StageKey) SsaStages :merge (set-union old new))
(rule ((DispatchDependency before after)) ((set (SsaDependencies after) (set-of before))) :ruleset ssa-access)
(function SsaOperationResources (OperationKey) SsaResources :merge (set-union old new))
(rule ((BufferSlot o role i b)) ((set (SsaOperationResources o) (set-of b))) :ruleset ssa-access)
(function SsaCapacitySources (Extent) SsaResources :merge (set-union old new))
(rule ((LiveLength b e)) ((set (SsaCapacitySources e) (set-of b))) :ruleset ssa-access)
(function SsaResultCount (FusionPlan String) i64 :merge (max old new))
(rule ((PlanResult p role i v t)) ((set (SsaResultCount p role) (+ i 1))) :ruleset ssa-access)
(function SsaCountCount (FusionPlan) i64 :merge (max old new))
(rule ((PlanCountSlot p owner i t)) ((set (SsaCountCount p) (+ i 1))) :ruleset ssa-access)
(run-schedule (run ssa-access))
