; Candidate host targets; final readout resolves which computations are supported.
(ruleset host-targets)
(relation HostTarget (RootKey SourceValue ScalarContext ValueKey))
(rule ((OutputWriter output (EntryRoot entry)) (SourceDefinition entry scope)
       (SourceOutput output entry source ty array) (= context (ScalarScopeContext scope))
       (OutputBacking output value) (= storage (Backing value)))
      ((HostTarget (EntryRoot entry) source context storage)) :ruleset host-targets)
(rule ((OutputWriter output (KernelRoot (Stage op "scalar")))
       (SourceOutput output entry source ty array)
       (OutputBacking output value) (= storage (Backing value)))
      ((HostTarget (KernelRoot (Stage op "scalar")) source (ScalarDispatch op) storage)) :ruleset host-targets)
(rule ((ScalarGroup op leader) (Phase (Stage leader "scalar") region)
       (= source (SourceOperationValue op)) (BufferSlot op "scalar" 0 value) (= storage (Backing value)))
      ((HostTarget (KernelRoot (Stage leader "scalar")) source (ScalarDispatch leader) storage)) :ruleset host-targets)
; Callback roots identify the actual phase consumers of scalar host preferences.
(relation ScalarPhaseSource (StageKey ScalarContext SourceValue))
(relation ScalarHostParameter (RegionKey i64))
(relation ScalarHostLeaf (SourceValue))
(rule ((PhaseCallback stage region) (= source (SourceResult region)) (= context (ScalarScopeContext region)))
      ((ScalarPhaseSource stage context source)) :ruleset host-targets)
(rule ((SourceEntryParameter region i bound false) (= source (SourceParameter region i)))
      ((ScalarHostParameter region i) (ScalarHostLeaf source)) :ruleset host-targets)
(rule ((SourceCapture region formal actual) (ScalarHostLeaf actual))
      ((ScalarHostLeaf formal)) :ruleset host-targets)
