; Candidate host targets; final readout resolves which computations are supported.
(ruleset host-targets)
(relation HostTarget (RootKey SourceValue ExprContext ValueKey))
(rule ((= (OutputWriter output) (EntryRoot entry)) (SourceDefinition entry scope)
       (SourceOutput output entry source ty array) (= context (ExprContextForScope scope))
       (OutputBacking output value) (= storage (Backing value)))
      ((HostTarget (EntryRoot entry) source context storage)) :ruleset host-targets)
(rule ((= (OutputWriter output) (KernelRoot (Stage op "scalar")))
       (SourceOutput output entry source ty array)
       (OutputBacking output value) (= storage (Backing value)))
      ((HostTarget (KernelRoot (Stage op "scalar")) source (ExprContextDispatch op) storage)) :ruleset host-targets)
(rule ((DispatchGroupLeader op leader) (Phase (Stage leader "scalar") region)
       (= source (SourceOperationValue op)) (= value (BufferSlot op "scalar" 0)) (= storage (Backing value)))
      ((HostTarget (KernelRoot (Stage leader "scalar")) source (ExprContextDispatch leader) storage)) :ruleset host-targets)
; Callback roots identify the actual phase consumers of scalar host preferences.
(relation HostEvalPhaseRoot (StageKey ExprContext SourceValue))
(relation HostEvalParameter (RegionKey i64))
(relation HostEvalLeaf (SourceValue))
(rule ((PhaseCallback stage region) (= source (SourceResult region)) (= context (ExprContextForScope region)))
      ((HostEvalPhaseRoot stage context source)) :ruleset host-targets)
(rule ((SourceEntryParameter region i bound false) (= source (SourceParameter region i)))
      ((HostEvalParameter region i) (HostEvalLeaf source)) :ruleset host-targets)
(rule ((SourceCapture region formal actual) (HostEvalLeaf actual))
      ((HostEvalLeaf formal)) :ruleset host-targets)
