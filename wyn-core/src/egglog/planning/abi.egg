(ruleset physical-abi)
(ruleset physical-bindings)
; Entry declarations and parameter order determine one physical input ABI.
; Byte sizes/alignment are target layout facts imported from the shared ABI code.
(datatype InputAbi (DeclaredInput) (ShaderInput) (PushInput i64 i64))
(function ParameterAbi (RegionKey i64) InputAbi :no-merge)
(function ParameterStorageAccess (RegionKey i64) i64 :no-merge)
(rule ((SourceParameterStorageAccess region index access))
      ((set (ParameterStorageAccess region index) access)) :ruleset planning-import)
(rule ((SourceImmutableParameter region index))
      ((set (ParameterStorageAccess region index) 1)) :ruleset planning-import)
(function PushOffset (RegionKey i64) i64 :no-merge)
(relation PushParameter (RegionKey i64))
(function MinimumArrayCapacity () i64 :no-merge)
(set (MinimumArrayCapacity) 1)
(function RootWorkgroup (RootKey) DispatchGrid :no-merge)
(function DefaultThreads (i64) i64 :merge (max old new))
(function RootResource (RootKey ValueKey) i64 :merge (| old new))
(function PhysicalBinding (ValueKey) BindingKey :no-merge)
(function RootBindingAccess (RootKey BindingKey) i64 :merge (| old new))
(relation RootOwner (RootKey i64))
(rule ((SourceEntryPoint owner r)) ((RootOwner (EntryRoot owner) owner)) :ruleset physical-abi)
(rule ((PhaseOwner stage owner)) ((RootOwner (KernelRoot stage) owner)) :ruleset physical-abi)
(rule ((= access (RootResource root value)) (> access 0) (= binding (PhysicalBinding value)))
      ((set (RootBindingAccess root binding) access)) :ruleset physical-abi)
(rule ((= access (RootResource root (Source e))) (> access 0)
       (= (AbiStorage e) (StorageInput binding stride)))
      ((set (RootBindingAccess root binding) access)) :ruleset physical-abi)
(rule ((EmitOriginalEntry owner) (OutputOwner output owner) (AbiOutputBinding output set binding))
      ((set (RootBindingAccess (EntryRoot owner) (InputBinding set binding)) 2)) :ruleset physical-abi)
(relation StorageResource (ValueKey))
(rule ((PlannedBuffer value ty extent)) ((StorageResource value)) :ruleset physical-abi)
(rule ((SourceBinding source set binding))
      ((StorageResource (Source source))) :ruleset physical-abi)
(sort RootResources (Set ValueKey))
(function RootResourceSet (RootKey) RootResources :merge (set-union old new))
(rule ((= access (RootResource root value)))
      ((set (RootResourceSet root) (set-of value))) :ruleset physical-abi)
(rule ((SourceOriginalEntry entry region compute))
      ((set (RootWorkgroup (EntryRoot entry)) (FixedGrid 1 1 1))
       (set (DefaultThreads entry) 1)) :ruleset planning-import)
(rule ((PhaseDomain stage extent width))
      ((set (RootWorkgroup (KernelRoot stage)) (FixedGrid width 1 1))) :ruleset readout)
(rule ((PhaseOwner stage entry) (PhaseDomain stage (Fixed count) width))
      ((set (DefaultThreads entry) count)) :ruleset readout)
(rule ((= access (Access stage value)) (StorageResource value))
      ((set (RootResource (KernelRoot stage) value) access)) :ruleset physical-abi)
(rule ((OutputWriter output root) (OutputBacking output value) (= backing (Backing value)))
      ((set (RootResource root backing) 2)) :ruleset physical-abi)
(rule ((OutputWriter output root) (OutputExpression output e) (References e (Contents value))
       (= backing (Backing value)) (StorageResource backing))
      ((set (RootResource root backing) 1)) :ruleset physical-abi)
(function PhysicalLocalCapacity (Extent) i64 :no-merge)
(rule ((= count (LocalCapacity extent)) (= minimum (MinimumArrayCapacity)))
      ((set (PhysicalLocalCapacity extent) (max count minimum))) :ruleset readout)

(function AllocationOwner (ValueKey) i64 :no-merge)
(rule ((Allocation (Result op i) extent) (Site op region) (OwnedRegion owner region))
      ((set (AllocationOwner (Result op i)) owner)) :ruleset physical-abi)
(rule ((Allocation (Temporary op role i) extent) (Site op region) (OwnedRegion owner region))
      ((set (AllocationOwner (Temporary op role i)) owner)) :ruleset physical-abi)
(rule ((Allocation (Output output) extent) (OutputOwner output owner))
      ((set (AllocationOwner (Output output)) owner)) :ruleset physical-abi)
(rule ((Allocation value extent) (= access (Access stage value)) (PhaseOwner stage owner))
      ((set (AllocationOwner value) owner)) :ruleset physical-abi)
(rule ((HostLoop op region initial state iteration count) (Site op parent) (OwnedRegion owner parent))
      ((set (AllocationOwner (Source state)) owner)
       (set (AllocationOwner (Source iteration)) owner)) :ruleset physical-abi)
; Runtime loop state must have an ABI even when no shader reads the index.
(rule ((HostLoop op region initial state iteration count))
      ((set (RootResource (KernelRoot (Stage op "loop_exit")) (Source state)) 0)
       (set (RootResource (KernelRoot (Stage op "loop_exit")) (Source iteration)) 0)) :ruleset physical-abi)
(datatype LaunchDescription (FixedLaunch DispatchGrid) (BufferLaunch ValueKey i64) (ExtentLaunch Extent i64))
(function SelectedLaunch (StageKey) LaunchDescription :no-merge)
(function StaticLaunch (StageKey) bool :merge (or old new))
(function HasLaunchAllocation (StageKey) bool :merge (or old new))
(relation LaunchAllocation (StageKey ValueKey))
(rule ((PhaseDomain stage extent width))
      ((set (StaticLaunch stage) false) (set (HasLaunchAllocation stage) false)) :ruleset physical-abi)
(rule ((= grid (LaunchGrid stage))) ((set (StaticLaunch stage) true)) :ruleset physical-abi)
(rule ((PhaseDomain stage extent width) (Allocation value extent) (= access (RootResource (KernelRoot stage) value)))
      ((LaunchAllocation stage value)) :ruleset physical-abi)
(rule ((PhaseDomain stage extent width) (= bound (HostBound extent)) (Allocation value bound) (= access (RootResource (KernelRoot stage) value)))
      ((LaunchAllocation stage value)) :ruleset physical-abi)
(rule ((= (PhaseGrid stage) (FixedGrid x y z)))
      ((set (SelectedLaunch stage) (FixedLaunch (FixedGrid x y z)))) :ruleset physical-bindings)
(rule ((= (PhaseGrid stage) (AutomaticGrid)) (= grid (LaunchGrid stage)))
      ((set (SelectedLaunch stage) (FixedLaunch grid))) :ruleset physical-bindings)
(rule ((= (StaticLaunch stage) false) (= (HasLaunchAllocation stage) false) (PhaseDomain stage extent width))
      ((set (SelectedLaunch stage) (ExtentLaunch extent width))) :ruleset physical-bindings)
(rule ((SourceOriginalEntry entry region compute))
      ((set (PushOffset region 0) 0)) :ruleset planning-import)
(rule ((SourceEntryParameter region i true builtin))
      ((set (ParameterAbi region i) (DeclaredInput))) :ruleset planning-import)
(rule ((SourceEntryParameter region i false true))
      ((set (ParameterAbi region i) (ShaderInput))) :ruleset planning-import)
(rule ((SourceEntryParameter region i false false) (SourceOriginalEntry entry region false))
      ((set (ParameterAbi region i) (ShaderInput))) :ruleset planning-import)
(rule ((SourceEntryParameter region i false false) (SourceOriginalEntry entry region true))
      ((PushParameter region i)) :ruleset planning-import)
(rule ((= (ParameterAbi region i) (DeclaredInput)) (= offset (PushOffset region i)))
      ((set (PushOffset region (+ i 1)) offset)) :ruleset planning-import)
(rule ((= (ParameterAbi region i) (ShaderInput)) (= offset (PushOffset region i)))
      ((set (PushOffset region (+ i 1)) offset)) :ruleset planning-import)
(rule ((PushParameter region i) (= parameter (SourceParameter region i))
       (= ty (SourceType parameter)) (SourceBlockLayout ty size align)
       (= offset (PushOffset region i)) (= aligned (* (/ (+ offset (- align 1)) align) align)))
      ((set (ParameterAbi region i) (PushInput aligned size))
       (set (PushOffset region (+ i 1)) (+ aligned size))) :ruleset planning-import)
(sort LaunchResources (Set ValueKey))
(function LaunchResourcesFor (StageKey) LaunchResources :merge (set-union old new))
(rule ((LaunchAllocation stage value))
      ((set (LaunchResourcesFor stage) (set-of value)) (set (HasLaunchAllocation stage) true)) :ruleset physical-abi)
(rule ((= (StaticLaunch stage) false) (= candidates (LaunchResourcesFor stage))
       (= value (set-get candidates 0)) (PhaseDomain stage extent width))
      ((set (SelectedLaunch stage) (BufferLaunch value width))) :ruleset physical-bindings)
(rule ((OutputBacking output value) (AbiOutputBinding output set binding))
      ((set (PhysicalBinding value) (InputBinding set binding))) :ruleset physical-bindings)

; Original-entry output capacities are selected once, before ABI translation.
; Matching inputs have the same type-level dimension, so any match supplies
; the same element count. The binding set provides a deterministic choice.
(datatype OutputCapacity (OutputBytes i64) (OutputLike BindingKey i64 i64) (OutputDispatch i64))
(function SelectedOutputCapacity (i64) OutputCapacity :no-merge)
(relation EntryArrayInput (i64 BindingKey TypeKey i64))
(rule ((SourceOriginalEntry owner region true) (= value (SourceParameter region i))
       (= ty (SourceType value)) (= dimension (SourceArrayDimension ty))
       (= (AbiStorage value) (StorageInput binding stride)))
      ((EntryArrayInput owner binding dimension stride)) :ruleset physical-abi)
(rule ((SourceOriginalEntry owner region true) (= value (SourceParameter region i))
       (= ty (SourceType value)) (= fields (SourceTypeFields ty))
       (SourceField value j field) (= dimension (SourceArrayDimension (vec-get fields j)))
       (= (AbiStorage field) (StorageInput binding stride)))
      ((EntryArrayInput owner binding dimension stride)) :ruleset physical-abi)
(sort OutputSizeInputs (Set BindingKey))
(function OutputSizeMatches (i64) OutputSizeInputs :merge (set-union old new))
(function OutputSizeStride (i64 BindingKey) i64 :no-merge)
(rule ((SourceOutput output owner value ty true) (EmitOriginalEntry owner)
       (SourceOriginalEntry owner region true) (= (SourceArraySize ty) (DynamicSize)))
      ((set (OutputSizeMatches output) (set-empty))) :ruleset physical-abi)
(rule ((SourceOutput output owner value ty true) (EmitOriginalEntry owner)
       (= (SourceArraySize ty) (DynamicSize)) (= dimension (SourceArrayDimension ty))
       (EntryArrayInput owner binding dimension stride))
      ((set (OutputSizeMatches output) (set-of binding))
       (set (OutputSizeStride output binding) stride)) :ruleset physical-abi)
(rule ((SourceOutput output owner value ty false) (EmitOriginalEntry owner)
       (SourceOriginalEntry owner region true) (= bytes (SourceByteSize ty)))
      ((set (SelectedOutputCapacity output) (OutputBytes bytes))) :ruleset physical-bindings)
(rule ((SourceOutput output owner value ty true) (EmitOriginalEntry owner)
       (SourceOriginalEntry owner region true) (= (SourceArraySize ty) (FixedSize n))
       (SourceArrayElement ty element) (= stride (SourceStorageStride element)))
      ((set (SelectedOutputCapacity output) (OutputBytes (* n stride)))) :ruleset physical-bindings)
(rule ((SourceOutput output owner value ty true) (= inputs (OutputSizeMatches output))
       (> (set-length inputs) 0) (= binding (set-get inputs 0))
       (= source-stride (OutputSizeStride output binding))
       (SourceArrayElement ty element) (= stride (SourceStorageStride element)))
      ((set (SelectedOutputCapacity output) (OutputLike binding stride source-stride))) :ruleset physical-bindings)
(rule ((SourceOutput output owner value ty true) (= inputs (OutputSizeMatches output))
       (= (set-length inputs) 0) (SourceArrayElement ty element) (= stride (SourceStorageStride element)))
      ((set (SelectedOutputCapacity output) (OutputDispatch stride))) :ruleset physical-bindings)
