; A proven tiled gather is an output address mapping, not another traversal.
; Preserve other row consumers: ordinary materialization remains demand-driven.
(ruleset output-layouts)
(relation LayoutOrigin (SourceValue SourceValue))
(rule ((= ty (SourceType value))) ((LayoutOrigin value value)) :ruleset output-layouts)
(rule ((= actual (SourceAlias value)) (LayoutOrigin actual original))
      ((LayoutOrigin value original)) :ruleset output-layouts)
(rule ((= actual (SourceCapture region formal)) (LayoutOrigin actual original))
      ((LayoutOrigin formal original)) :ruleset output-layouts)
(function LayoutInteger (SourceValue) i64 :no-merge)
(rule ((= n (SourceInteger32 value))) ((set (LayoutInteger value) n)) :ruleset output-layouts)
(rule ((= array (SourceLength value)) (= n (ConstantLogicalExtent (Length array))))
      ((set (LayoutInteger value) n)) :ruleset output-layouts)
(relation TiledGather (SourceValue SourceValue SourceValue i64 i64))
(rule ((= row (SourceIndexedArray result)) (= rows (SourceIndexedArray row))
       (= column (SourceIndex result)) (= particle (SourceIndex row))
       (SourceBinary particle "+" block lane)
       (SourceBinary block "*" quotient tile-value)
       (SourceBinary quotient "/" address stride-value)
       (SourceBinary lane "%" address lane-width)
       (SourceBinary column "/" remainder column-width)
       (SourceBinary remainder "%" address remainder-width)
       (= tile (SourceInteger32 tile-value)) (= tile (SourceInteger32 lane-width))
       (= tile (SourceInteger32 column-width)) (> tile 0)
       (= stride (SourceInteger32 stride-value)) (= stride (SourceInteger32 remainder-width)) (> stride 0) (= (% stride tile) 0))
      ((TiledGather result rows address tile (/ stride tile))) :ruleset output-layouts)
(relation LayoutCallArgument (SourceValue SourceValue SourceValue))
(rule ((= call (SourceInvocation caller function args)) (= callee (PlanCallee call))
       (= formal (SourceParameter callee i)) (< i (vec-length args)))
      ((LayoutCallArgument call formal (vec-get args i))) :ruleset output-layouts)
(rule ((= call (SourceInvocation caller function args)) (= callee (PlanCallee call))
       (= result (SourceResult callee)) (TiledGather result rows address tile columns)
       (LayoutCallArgument call address actual-index) (LayoutCallArgument call rows actual-rows))
      ((TiledGather call actual-rows actual-index tile columns)) :ruleset output-layouts)
; A range guard is redundant for producer coordinates when its bound is the
; producer row count. Padding is excluded by the exact output extent below.
(rule ((= (SourceBranch result) (BranchInfo condition yes no))
       (= inner (SourceResult yes)) (TiledGather inner rows address tile columns)
       (= row (SourceIndexedArray inner)) (= index (SourceIndex row))
       (SourceBinary condition "<" index bound) (= count (LayoutInteger bound))
       (LayoutOrigin rows original) (= (ConstantLogicalExtent (Length original)) count))
      ((TiledGather result rows address tile columns)) :ruleset output-layouts)
(rule ((= (SourceBranch result) (BranchInfo condition yes no))
       (= inner (SourceResult yes)) (TiledGather inner rows address tile columns)
       (= row (SourceIndexedArray inner)) (= index (SourceIndex row))
       (SourceBinary condition "<" index bound) (= rows (SourceLength bound)))
      ((TiledGather result rows address tile columns)) :ruleset output-layouts)
; Each row stores only the selected leading columns; metadata columns may have
; separate fused consumers. Restrict to complete tiles and a sole gather output.
(relation ElementOutputProducer (OperationKey))
(rule ((MapPlan plan producer domain) (= (IterationRank producer) 1)
       (= (MapSegmented producer) false) (= (MapExecution producer) (InvocationScope))
       (= (ParallelBodySafe producer) true))
      ((ElementOutputProducer producer)) :ruleset output-layouts)
(rule ((Current group plan) (= producer (Owner plan)) (ScremaPlan plan)
       (= (HasReductions plan) true) (= (HasScans plan) false) (= (ParallelBodySafe producer) true))
      ((ElementOutputProducer producer)) :ruleset output-layouts)
(relation TiledOutput (OperationKey i64 OperationKey i64 i64))
(datatype TiledDestination (TiledDestinationInfo OperationKey i64 i64))
(sort TiledDestinations (Set TiledDestination))
(function TiledOutputs (OperationKey i64) TiledDestinations :merge (set-union old new))
(rule ((TiledOutput producer slot gather tile columns))
      ((set (TiledOutputs producer slot) (set-of (TiledDestinationInfo gather tile columns)))) :ruleset output-layouts)
(rule ((Current group (FusionSource gather)) (= (SourceOperation gather) (OperationInfo region "map"))
       (= body (SourceOperatorBody gather)) (= result (SourceResult body))
       (TiledGather result captured address tile columns) (= address (SourceParameter body 0))
       (= input (SourceInput gather 0)) (LayoutOrigin input range) (SourceUnitRange range start size)
       (= (SourceInteger32 start) 0) (= length (SourceInteger32 size))
       (LayoutOrigin captured rows) (DirectResult rows producer slot)
       (= region (OperationRegion producer)) (ElementOutputProducer producer)
       (= original (SourceValueOperation rows)) (= extent (SourceDomainExtent original))
       (= count (ConstantLogicalExtent extent))
       (= (ArrayElementLayout rows) (ArrayLayout width element))
       (>= count 0) (<= length 2147483647) (<= columns width) (= (% count tile) 0) (= length (* count columns)))
      ((TiledOutput producer slot gather tile columns) (set (ElideElements gather) true)) :ruleset output-layouts)
(rule ((TiledOutput producer slot gather tile columns) (Produces stage (Result producer slot)))
      ((Produces stage (Result gather 0))) :ruleset schedule)
