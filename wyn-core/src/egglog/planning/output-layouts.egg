; Invert complete mixed-radix coordinate maps. Source spellings only construct
; digit expressions; coverage proves bounds and bijectivity before eliding a gather.
(ruleset output-layouts)
(function LayoutInteger (SourceValue) i64 :no-merge)
(rule ((= n (SourceInteger32 value))) ((set (LayoutInteger value) n)) :ruleset output-layouts)
(rule ((= array (SourceLength value)) (= n (ConstantLogicalExtent (Length array))))
      ((set (LayoutInteger value) n)) :ruleset output-layouts)
(datatype DigitRange (RemainingDigits) (FixedRadix i64))
(datatype IndexPart (IndexPartInfo i64 DigitRange i64))
(sort IndexParts (Set IndexPart))
(relation IndexWindow (SourceValue SourceValue i64 DigitRange i64))
(function CoordinateParts (SourceValue SourceValue) IndexParts :no-merge)
(rule ((= root (SourceParameter region i))) ((IndexWindow root root 1 (RemainingDigits) 1)) :ruleset output-layouts)
(rule ((IndexWindow value root divisor range scale))
      ((set (CoordinateParts value root) (set-of (IndexPartInfo divisor range scale)))) :ruleset output-layouts)
(rule ((IndexWindow value root divisor range scale) (SourceBinary result "*" value factor)
       (= k (LayoutInteger factor)) (> k 0) (<= k 2147483647) (<= (* scale k) 2147483647))
      ((IndexWindow result root divisor range (* scale k))) :ruleset output-layouts)
(rule ((IndexWindow value root divisor range scale) (SourceBinary result "*" factor value)
       (= k (LayoutInteger factor)) (> k 0) (<= k 2147483647) (<= (* scale k) 2147483647))
      ((IndexWindow result root divisor range (* scale k))) :ruleset output-layouts)
(rule ((IndexWindow value root divisor (RemainingDigits) 1) (SourceBinary result "/" value factor)
       (= k (LayoutInteger factor)) (> k 0) (<= k 2147483647) (<= (* divisor k) 2147483647))
      ((IndexWindow result root (* divisor k) (RemainingDigits) 1)) :ruleset output-layouts)
(rule ((IndexWindow value root divisor (FixedRadix width) 1) (SourceBinary result "/" value factor)
       (= k (LayoutInteger factor)) (> k 0) (<= k 2147483647) (= (% width k) 0) (<= (* divisor k) 2147483647))
      ((IndexWindow result root (* divisor k) (FixedRadix (/ width k)) 1)) :ruleset output-layouts)
(rule ((IndexWindow value root divisor (RemainingDigits) 1) (SourceBinary result "%" value factor)
       (= k (LayoutInteger factor)) (> k 0) (<= k 2147483647))
      ((IndexWindow result root divisor (FixedRadix k) 1)) :ruleset output-layouts)
(rule ((IndexWindow value root divisor (FixedRadix width) 1) (SourceBinary result "%" value factor)
       (= k (LayoutInteger factor)) (> k 0) (<= k 2147483647) (= (% width k) 0))
      ((IndexWindow result root divisor (FixedRadix k) 1)) :ruleset output-layouts)
(rule ((SourceBinary result "+" a b) (= left (CoordinateParts a root)) (= right (CoordinateParts b root))
       (= (set-intersect left right) (set-empty)))
      ((set (CoordinateParts result root) (set-union left right))) :ruleset output-layouts)
(rule ((= actual (SourceAlias value)) (= parts (CoordinateParts actual root)))
      ((set (CoordinateParts value root) parts)) :ruleset output-layouts)
(datatype GatherGuard (NoGatherGuard) (RowBound i64))
(relation IndexGather (SourceValue SourceValue SourceValue IndexParts IndexParts GatherGuard))
(rule ((= row (SourceIndexedArray result)) (= rows (SourceIndexedArray row))
       (= column (SourceIndex result)) (= index (SourceIndex row))
       (= a (CoordinateParts index address)) (= b (CoordinateParts column address)))
      ((IndexGather result rows address a b (NoGatherGuard))) :ruleset output-layouts)
(rule ((IndexGather result rows address a b guard) (= (SourceCapture region rows) actual))
      ((IndexGather result actual address a b guard)) :ruleset output-layouts)
(relation LayoutCallArgument (SourceValue SourceValue SourceValue))
(rule ((= callee (SourceCallTarget call)) (= actual (SourceCallArgument call i)) (= formal (SourceParameter callee i)))
      ((LayoutCallArgument call formal actual)) :ruleset output-layouts)
(relation SafeLayoutArguments (SourceValue i64))
(rule ((= callee (SourceCallTarget call))) ((SafeLayoutArguments call 0)) :ruleset output-layouts)
(rule ((SafeLayoutArguments call i) (= argument (SourceCallArgument call i)) (= (SourceSpeculatable argument) true))
      ((SafeLayoutArguments call (+ i 1))) :ruleset output-layouts)
(rule ((= call (SourceInvocation caller function args)) (= callee (SourceCallTarget call))
       (= (RegionDefinition callee) (RegionBody parameters captures operations result))
       (SafeLayoutArguments call (vec-length parameters)) (IndexGather result rows address a b guard)
       (LayoutCallArgument call address actual-index) (LayoutCallArgument call rows actual-rows))
      ((IndexGather call actual-rows actual-index a b guard)) :ruleset output-layouts)
; Carry guard obligations through calls until the producer shape is known.
(rule ((= (SourceBranch result) (BranchInfo condition yes no)) (= inner (SourceResult yes))
       (IndexGather inner rows address a b (NoGatherGuard)) (= row (SourceIndexedArray inner)) (= index (SourceIndex row))
       (SourceBinary condition "<" index bound) (= count (LayoutInteger bound)))
      ((IndexGather result rows address a b (RowBound count))) :ruleset output-layouts)
(rule ((= (SourceBranch result) (BranchInfo condition yes no)) (= inner (SourceResult yes))
       (IndexGather inner rows address a b (NoGatherGuard)) (= row (SourceIndexedArray inner)) (= index (SourceIndex row))
       (SourceBinary condition "<" index bound) (= rows (SourceLength bound)))
      ((IndexGather result rows address a b (NoGatherGuard))) :ruleset output-layouts)
(relation ElementOutputProducer (OperationKey))
(rule ((MapPlan plan producer domain) (= (IterationRank producer) 1)
       (= (MapExecution producer) (InvocationScope)) (= (ParallelBodySafe producer) true))
      ((ElementOutputProducer producer)) :ruleset output-layouts)
(rule ((Current group plan) (= producer (Owner plan)) (ScremaPlan plan)
       (= (HasReductions plan) true) (= (HasScans plan) false) (= (ParallelBodySafe producer) true))
      ((ElementOutputProducer producer)) :ruleset output-layouts)
(relation GatherMapping (OperationKey i64 OperationKey i64 i64 i64 IndexParts IndexParts GatherGuard))
(rule ((Current group (FusionSource gather)) (= (SourceOperation gather) (OperationInfo region "map"))
       (= body (SourceOperatorBody gather)) (= result (SourceResult body))
       (= value (SourceOperationValue gather)) (= (SourceReadOnly value) true)
       (IndexGather result captured address a b guard) (= address (SourceParameter body 0))
       (= input (SourceInput gather 0)) (= (FlowValueOf input) (FlowValueOf range)) (SourceUnitRange range start size)
       (= (SourceInteger32 start) 0) (= length (SourceInteger32 size))
       (= (FlowValueOf captured) (FlowValueOf rows)) (DirectResult rows producer slot)
       (= region (OperationRegion producer)) (ElementOutputProducer producer)
       (= original (SourceValueOperation rows)) (= extent (SourceDomainExtent original)) (= count (ConstantLogicalExtent extent))
       (= (ArrayElementLayout rows) (ArrayLayout width element))
       (> count 0) (> length 0) (<= length 2147483647) (= (% length count) 0) (= columns (/ length count)) (<= columns width))
      ((GatherMapping producer slot gather count columns length a b guard)) :ruleset output-layouts)

(relation GatherGuardFits (GatherGuard i64))
(rule ((GatherMapping producer slot gather count columns length a b (NoGatherGuard)))
      ((GatherGuardFits (NoGatherGuard) count)) :ruleset output-layouts)
(rule ((GatherMapping producer slot gather count columns length a b (RowBound bound)) (<= count bound))
      ((GatherGuardFits (RowBound bound) count)) :ruleset output-layouts)

; Normalize every part, including zero-valued radix-one digits. A failed part
; prevents completion instead of disappearing from the coordinate expression.
(datatype FiniteDigit (Digit i64 i64 i64))
(sort FiniteDigits (Set FiniteDigit))
(relation NormalizeCoordinates (IndexParts i64))
(relation PartWidth (IndexPart i64 i64))
(function NormalizedPart (IndexPart i64) FiniteDigits :no-merge)
(function SeenParts (IndexParts i64) IndexParts :merge (set-union old new))
(function NormalizedDigits (IndexParts i64) FiniteDigits :merge (set-union old new))
(function CompleteDigits (IndexParts i64) FiniteDigits :no-merge)
(rule ((GatherMapping producer slot gather count columns length a b guard))
      ((NormalizeCoordinates a length) (NormalizeCoordinates b length)) :ruleset output-layouts)
(rule ((NormalizeCoordinates parts length))
      ((set (SeenParts parts length) (set-empty)) (set (NormalizedDigits parts length) (set-empty))) :ruleset output-layouts)
(rule ((NormalizeCoordinates parts length) (set-contains parts part) (= part (IndexPartInfo divisor (RemainingDigits) scale)) (= (% length divisor) 0))
      ((PartWidth part length (/ length divisor))) :ruleset output-layouts)
(rule ((NormalizeCoordinates parts length) (set-contains parts part) (= part (IndexPartInfo divisor (FixedRadix width) scale)) (= (% length (* divisor width)) 0))
      ((PartWidth part length width)) :ruleset output-layouts)
(rule ((PartWidth part length 1)) ((set (NormalizedPart part length) (set-empty))) :ruleset output-layouts)
(rule ((PartWidth part length width) (> width 1) (= part (IndexPartInfo divisor range scale)))
      ((set (NormalizedPart part length) (set-of (Digit divisor width scale)))) :ruleset output-layouts)
(rule ((NormalizeCoordinates parts length) (set-contains parts part) (= digits (NormalizedPart part length)))
      ((set (SeenParts parts length) (set-of part)) (set (NormalizedDigits parts length) digits)) :ruleset output-layouts)
(rule ((NormalizeCoordinates parts length) (= (SeenParts parts length) parts) (= digits (NormalizedDigits parts length)))
      ((set (CompleteDigits parts length) digits)) :ruleset output-layouts)

; Both the input digits and each result coordinate must form complete partitions.
; The inverse is built in coordinate-stride order, independent of source syntax.
(relation AxisInverse (FiniteDigits i64 FiniteDigits i64 ScalarFormula))
(relation InputCoverage (FiniteDigits FiniteDigits i64))
(rule ((GatherMapping producer slot gather count columns length a b guard) (= left (CompleteDigits a length)) (= right (CompleteDigits b length)))
      ((AxisInverse left 0 left 1 (FormulaConstant 0)) (AxisInverse right 1 right 1 (FormulaConstant 0))
       (InputCoverage (set-union left right) (set-union left right) 1)) :ruleset output-layouts)
(rule ((AxisInverse digits argument remaining stride formula) (set-contains remaining part) (= part (Digit divisor width stride))
       (<= (* stride width) 2147483647))
      ((AxisInverse digits argument (set-remove remaining part) (* stride width)
         (FormulaBinary "+" formula (FormulaBinary "*"
           (FormulaBinary "%" (FormulaBinary "/" (FormulaInput argument) (FormulaConstant stride)) (FormulaConstant width))
           (FormulaConstant divisor))))) :ruleset output-layouts)
(rule ((InputCoverage digits remaining stride) (set-contains remaining part) (= part (Digit stride width scale))
       (<= (* stride width) 2147483647))
      ((InputCoverage digits (set-remove remaining part) (* stride width))) :ruleset output-layouts)
(relation MappedOutput (OperationKey i64 OperationKey Extent ScalarFormula))
(datatype OutputMapping (OutputMappingInfo OperationKey Extent ScalarFormula))
(sort OutputMappings (Set OutputMapping))
(function MappedOutputs (OperationKey i64) OutputMappings :merge (set-union old new))
(rule ((GatherMapping producer slot gather count columns length a b guard) (= left (CompleteDigits a length)) (= right (CompleteDigits b length))
       (GatherGuardFits guard count)
       (AxisInverse left 0 (set-empty) count row) (AxisInverse right 1 (set-empty) columns column)
       (InputCoverage (set-union left right) (set-empty) length))
      ((MappedOutput producer slot gather (Fixed columns) (FormulaBinary "+" row column)) (set (ElideElements gather) true)) :ruleset output-layouts)
(rule ((MappedOutput producer slot gather columns address))
      ((set (MappedOutputs producer slot) (set-of (OutputMappingInfo gather columns address)))) :ruleset output-layouts)
(rule ((MappedOutput producer slot gather columns address) (Produces stage (Result producer slot)))
      ((Produces stage (Result gather 0))) :ruleset schedule)
