; Unbounded invocation storage moves into an ordinary host loop. Each result
; clause contributes loop state; the lane body is evaluated exactly once.
(ruleset local-storage-analysis)
(ruleset local-storage-rewrite)
(relation SequentialBody (ScopeContext ParallelBody))
(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= function (ScopeRoot context)) (= (HostScope context) true) (= (BoundedLocals function body) false))
      ((SequentialBody context body)) :ruleset local-storage-rewrite)
(rule ((= info (ArrayValue element shape))) ((set (FreeShape shape 0) (vec-of))) :ruleset local-storage-analysis)
(rule ((= prefix (FreeShape shape i)) (< i (vec-length shape)))
      ((set (FreeShape shape (+ i 1)) (vec-push prefix (FreeIndex (vec-get shape i))))) :ruleset local-storage-analysis)

; Uniformity is lexical, not a constant-size test. The ordinal includes every
; enclosing counted iteration so hoisting cannot alias live loop generations.
(relation StorageOperation (Exp))
(rule ((= (WritesResult expression) true)) ((StorageOperation expression)) :ruleset local-storage-analysis)
(rule ((= expression (Reshape source shape))) ((StorageOperation expression)) :ruleset local-storage-analysis)
(ruleset local-storage-status)
(function StaticShape (Function Shape) bool :merge (and old new))
(function ExpandedArray (Function ValueName) bool :merge (or old new))
(function AvailableStorage (Function ParallelBody ValueName) bool :merge (or old new))
(relation StorageScope (ScopeContext StatementId ScopeContext IndexExp IndexExp Names))
; owner scope/id, nested scope, instance count, ordinal, host environment
(relation ExpandableStorage (Function ValueName ScopeContext StatementId IndexExp IndexExp))
(rule ((ContainsValueInfo (FunctionRoot function) (ArrayValue element shape)))
      ((set (StaticShape function shape) true)) :ruleset local-storage-analysis)
(rule ((ContainsValueInfo (FunctionRoot function) (ArrayValue element shape))
       (WalkShape shape i) (< i (vec-length shape)) (= (KnownSize function (vec-get shape i)) false))
      ((set (StaticShape function shape) false)) :ruleset local-storage-analysis)
(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= (HostScope context) true) (= domain (IterationSpace flat axes)) (DenseDomain axes)
       (= count (DomainSize axes (vec-length axes))) (= uses (NamesIndexExp count))
       (= (set-diff uses available) (set-empty)))
      ((StorageScope context id (NestedScope context id 0) count (IndexValue flat) available)) :ruleset local-storage-analysis)
(rule ((StorageScope owner kernel context count ordinal available)
       (CheckStatement context id pattern (If condition returns yes no) local))
      ((StorageScope owner kernel (NestedScope context id 0) count ordinal available)
       (StorageScope owner kernel (NestedScope context id 1) count ordinal available)) :ruleset local-storage-analysis)
(rule ((StorageScope owner kernel context count ordinal available)
       (CheckStatement context id pattern (WithAcc inputs body) local))
      ((StorageScope owner kernel (NestedScope context id 0) count ordinal available)) :ruleset local-storage-analysis)
(rule ((StorageScope owner kernel context count ordinal available)
       (CheckStatement context id pattern (Loop merges (Counted index start trips step) returns body) local)
       (= function (ScopeRoot context)) (= increment (StaticIndex function step)) (!= increment 0)
       (= a (NamesIndexExp start)) (= b (NamesIndexExp trips)) (= c (NamesIndexExp step))
       (= (set-diff (set-union a (set-union b c)) available) (set-empty)))
      ((StorageScope owner kernel (NestedScope context id 0) (IndexMul count (IndexMax (IndexConstant 0) trips))
          (IndexAdd (IndexMul ordinal trips) (IndexDiv (IndexSub (IndexValue index) start) step)) available)) :ruleset local-storage-analysis)
(rule ((StorageScope owner kernel context count ordinal available)
       (CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) body) local)
       (DenseDomain axes) (= trips (DomainSize axes (vec-length axes))) (= uses (NamesIndexExp trips))
       (= (set-diff uses available) (set-empty)))
      ((StorageScope owner kernel (NestedScope context id 0) (IndexMul count trips)
          (IndexAdd (IndexMul ordinal trips) (IndexValue flat)) available)) :ruleset local-storage-analysis)
(rule ((StorageScope owner kernel context count ordinal available) (= function (ScopeRoot context))
       (CheckStatement context id pattern expression local) (WalkPattern pattern i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name (ArrayValue element shape))) (= uses (NamesShape shape))
       (= (set-diff uses available) (set-empty)))
      ((ExpandableStorage function name owner kernel count ordinal)) :ruleset local-storage-analysis)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body))
       (ContainsBinding (ParallelRoot body) (BindValue name (ArrayValue element shape))))
      ((set (AvailableStorage function body name) false)) :ruleset local-storage-analysis)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body))
       (ContainsBinding (ParallelRoot body) (BindValue name (ArrayValue element shape)))
       (ExpandableStorage function name owner kernel count ordinal))
      ((set (AvailableStorage function body name) true)) :ruleset local-storage-analysis)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayValue element shape))))
      ((set (ExpandedArray function name) false)) :ruleset local-storage-analysis)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayValue element shape)))
       (= (StaticShape function shape) false) (ExpandableStorage function name owner kernel count ordinal))
      ((set (ExpandedArray function name) true)) :ruleset local-storage-analysis)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body)))
      ((set (BoundedLocals function body) true)) :ruleset local-storage-status)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body))
       (ContainsStm (ParallelRoot body) (Let id pattern certs expression)) (StorageOperation expression)
       (WalkPattern pattern i) (< i (vec-length pattern)) (= (vec-get pattern i) (BindValue name (ArrayValue element shape)))
       (= (StaticShape function shape) false) (= (AvailableStorage function body name) false))
      ((set (BoundedLocals function body) false)) :ruleset local-storage-status)

(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body))
       (ContainsExp (ParallelRoot body) (WithAcc inputs lambda)) (= (ConcurrentAccInputs function inputs) false))
      ((set (BoundedLocals function body) false)) :ruleset local-storage-status)

; Peel one enclosing map dimension before constructing a loop. Inner folds
; retain their own reduction axis, and their bodies remain ordinary Parallel.
(relation NestedSequential (Program Stm))
(relation NestedPatternAt (Stm i64 Pattern ParallelResults))
(rule ((= axes (vec-of))) ((DenseDomain axes)) :ruleset local-storage-analysis)
(rule ((= domain (IterationSpace flat axes)) (> (vec-length axes) 0))
      ((IterationSpace flat (vec-remove axes 0))) :ruleset local-storage-analysis)
(rule ((= domain (IterationSpace flat axes)) (> (vec-length axes) 0)
       (= (vec-get axes 0) (DenseAxis index size)) (DenseDomain (vec-remove axes 0)))
      ((DenseDomain axes)) :ruleset local-storage-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (SequentialBody context body)
       (= domain (IterationSpace flat axes)) (> (vec-length axes) 1) (DenseDomain axes)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (Unscheduled) domain body))))
      ((NestedSequential program statement) (NestedPatternAt statement 0 (vec-of) (vec-of))) :ruleset local-storage-rewrite)
(rule ((NestedPatternAt statement i pattern clauses)
       (= statement (Let id outputs certs expression)) (< i (vec-length outputs))
       (= (vec-get outputs i) (BindValue name (ArrayValue element shape))) (= (vec-length shape) 1))
      ((NestedPatternAt statement (+ i 1)
          (vec-push pattern (BindValue (ScheduleValue id 30 i) (ScalarInfo element)))
          (vec-push clauses (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 30 i))))))))) :ruleset local-storage-rewrite)
(rule ((NestedPatternAt statement i pattern clauses)
       (= statement (Let id outputs certs expression)) (< i (vec-length outputs))
       (= (vec-get outputs i) (BindValue name (ArrayValue element shape))) (> (vec-length shape) 1))
      ((NestedPatternAt statement (+ i 1)
          (vec-push pattern (BindValue (ScheduleValue id 30 i) (ArrayValue element (vec-remove shape 0))))
          (vec-push clauses (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 30 i))))))))) :ruleset local-storage-rewrite)
(rule ((NestedPatternAt statement i pattern clauses)
       (= statement (Let id outputs certs expression)) (< i (vec-length outputs))
       (= (vec-get outputs i) (BindAccumulator name info)))
      ((NestedPatternAt statement (+ i 1)
          (vec-push pattern (BindAccumulator (CallAccumulator (ScheduleStatement id 30 i) name) info))
          (vec-push clauses (Contribute (vec-of (CallAccumulator (ScheduleStatement id 30 i) name)))))) :ruleset local-storage-rewrite)
(rule ((NestedSequential program statement)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (vec-get axes 0) (DenseAxis index size)) (= rest (vec-remove axes 0))
       (= stride (DomainSize rest (vec-length rest)))
       (NestedPatternAt statement i inner-pattern outer-results) (= i (vec-length outputs)))
      ((let ordinal (Let (ScheduleStatement id 31 0) (vec-of (BindValue flat (ScalarInfo (ScalarElement (I32))))) (vec-of)
          (IndexOp (IndexAdd (IndexMul (IndexValue index) stride) (IndexValue (ScheduleValue id 31 0))))))
       (let inner (Let (ScheduleStatement id 30 0) inner-pattern certs
          (Parallel (Unscheduled) (IterationSpace (ScheduleValue id 31 0) rest)
              (ParallelBlock (vec-append (vec-of ordinal) statements) clauses))))
       (let outer (Let id outputs certs
          (Parallel (Unscheduled) (IterationSpace (ScheduleValue id 31 1) (vec-of (DenseAxis index size)))
              (ParallelBlock (vec-of inner) outer-results))))
       (set (PendingRewrite "local-storage" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty) (map-insert (map-empty) id (vec-of outer)))))
       (RewriteDemand "local-storage" program)) :ruleset local-storage-rewrite)

; Fragments are construction state, not executable IR. Joining them preserves
; the ordering of initializers, carries, updates, and exit projections.
(datatype LoopFragment (Fragment Stms Merges ReturnInfos Pattern Stms Results Stms))
(function ShiftedReturns (ReturnInfos i64 i64) ReturnInfos :no-merge)
(function ShiftedReturn (ReturnInfo i64) ReturnInfo :no-merge)
(function ShiftedShape (ExtShape i64 i64) ExtShape :no-merge)
(function ShiftedIndex (ExtIndex i64) ExtIndex :no-merge)
(relation ShiftReturnDemand (ReturnInfo i64))
(relation ShiftIndexDemand (ExtIndex i64))
(relation JoinLoopFragments (LoopFragment LoopFragment))
(function JoinedLoopFragments (LoopFragment LoopFragment) LoopFragment :no-merge)
(rule ((JoinLoopFragments a b)
       (= a (Fragment ia ma ra pa sa ya oa)) (= b (Fragment ib mb rb pb sb yb ob))
       (= shifted (ShiftedReturns rb (vec-length ra) (vec-length rb))))
      ((set (JoinedLoopFragments a b) (Fragment
          (vec-append ia ib) (vec-append ma mb) (vec-append ra shifted) (vec-append pa pb)
          (vec-append sa sb) (vec-append ya yb) (vec-append oa ob)))) :ruleset local-storage-rewrite)

(rule ((JoinLoopFragments a b) (= a (Fragment ia ma ra pa sa ya oa)) (= b (Fragment ib mb rb pb sb yb ob)))
      ((set (ShiftedReturns rb (vec-length ra) 0) (vec-of))) :ruleset local-storage-rewrite)
(rule ((= prefix (ShiftedReturns returns offset i)) (< i (vec-length returns)))
      ((ShiftReturnDemand (vec-get returns i) offset)) :ruleset local-storage-rewrite)
(rule ((= prefix (ShiftedReturns returns offset i)) (< i (vec-length returns)) (= next (ShiftedReturn (vec-get returns i) offset)))
      ((set (ShiftedReturns returns offset (+ i 1)) (vec-push prefix next))) :ruleset local-storage-rewrite)
(rule ((ShiftReturnDemand (ReturnArrayValue element shape) offset))
      ((set (ShiftedShape shape offset 0) (vec-of))) :ruleset local-storage-rewrite)
(rule ((= prefix (ShiftedShape shape offset i)) (< i (vec-length shape)))
      ((ShiftIndexDemand (vec-get shape i) offset)) :ruleset local-storage-rewrite)
(rule ((= prefix (ShiftedShape shape offset i)) (< i (vec-length shape)) (= next (ShiftedIndex (vec-get shape i) offset)))
      ((set (ShiftedShape shape offset (+ i 1)) (vec-push prefix next))) :ruleset local-storage-rewrite)
(rule ((ShiftReturnDemand (ReturnArrayValue element shape) offset) (= next (ShiftedShape shape offset (vec-length shape))))
      ((set (ShiftedReturn (ReturnArrayValue element shape) offset) (ReturnArrayValue element next))) :ruleset local-storage-rewrite)
(rule ((ShiftReturnDemand (ReturnScalar element) offset))
      ((set (ShiftedReturn (ReturnScalar element) offset) (ReturnScalar element))) :ruleset local-storage-rewrite)
(rule ((ShiftReturnDemand (ReturnResource resource) offset))
      ((set (ShiftedReturn (ReturnResource resource) offset) (ReturnResource resource))) :ruleset local-storage-rewrite)
(rule ((ShiftReturnDemand (ReturnAccumulator info) offset))
      ((set (ShiftedReturn (ReturnAccumulator info) offset) (ReturnAccumulator info))) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ResultIndex i) offset))
      ((set (ShiftedIndex (ResultIndex i) offset) (ResultIndex (+ i offset)))) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (FreeIndex value) offset))
      ((set (ShiftedIndex (FreeIndex value) offset) (FreeIndex value))) :ruleset local-storage-rewrite)

; Collection and scan prefixes use the same allocation/carry/update operation.
(relation LoopArrayDemand (StatementId ValueName Binding Result))
(function LoopArray (StatementId ValueName Binding Result) LoopFragment :no-merge)
(rule ((LoopArrayDemand id index binding value)
       (= binding (BindValue output (ArrayValue element shape)))
       (= value (Yield proofs (ValueOperand atom))) (= ext (FreeShape shape (vec-length shape))))
      ((set (LoopArray id index binding value) (Fragment
          (vec-of (Let (ScheduleStatement id 0 0)
              (vec-of (BindValue (ScheduleValue id 0 0) (ArrayValue element shape))) (vec-of)
              (GenerateArray (Uninitialized element shape))))
          (vec-of (Carry (Parameter (BindValue (ScheduleValue id 1 0) (ArrayValue element shape)) (Consume))
              (ValueOperand (Var (ScheduleValue id 0 0)))))
          (vec-of (ReturnArrayValue element ext))
          (vec-of (BindValue (ScheduleValue id 3 0) (ArrayValue element shape)))
          (vec-of (Let (ScheduleStatement id 1 0)
              (vec-of (BindValue (ScheduleValue id 2 0) (ArrayValue element shape))) proofs
              (Update (ProvenInBounds) (ScheduleValue id 1 0) (vec-of (At (IndexValue index))) atom)))
          (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 2 0)))))
          (vec-of (Let (ScheduleStatement id 2 0) (vec-of binding) (vec-of)
              (Use (ValueOperand (Var (ScheduleValue id 3 0))))))))) :ruleset local-storage-rewrite)

(relation SequentialParallel (Program Function Stm Names))
(relation LoopClauseAt (Stm i64 LoopFragment))
(relation LoopClauseDemand (StatementId ValueName Pattern ParallelResult))
(function LoopClause (StatementId ValueName Pattern ParallelResult) LoopFragment :no-merge)
(relation ClausePatternAt (Stm i64 i64 Pattern))
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (SequentialBody context body)
       (= domain (IterationSpace flat vector-pattern-0))
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (Unscheduled) domain body)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((SequentialParallel program function statement available)
       (LoopClauseAt statement 0 (Fragment (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of)))) :ruleset local-storage-rewrite)
(rule ((LoopClauseAt statement i prefix)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (< i (vec-length clauses)))
      ((ClausePatternAt statement i 0 (vec-of))) :ruleset local-storage-rewrite)
(rule ((ClausePatternAt statement i j prefix)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses i)) (< j (ClauseArity (vec-get clauses i))))
      ((ClausePatternAt statement i (+ j 1) (vec-push prefix (vec-get pattern (+ offset j))))) :ruleset local-storage-rewrite)
(rule ((ClausePatternAt statement i j pattern)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat vector-pattern-0)
          (ParallelBlock statements clauses)))) (= j (ClauseArity (vec-get clauses i)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((LoopClauseDemand (ScheduleStatement id 20 i) index pattern (vec-get clauses i))) :ruleset local-storage-rewrite)
(rule ((LoopClauseAt statement i prefix)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat vector-pattern-0)
          (ParallelBlock statements clauses))))
       (ClausePatternAt statement i j pattern) (= j (ClauseArity (vec-get clauses i)))
       (= next (LoopClause (ScheduleStatement id 20 i) index pattern (vec-get clauses i)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((JoinLoopFragments prefix next)) :ruleset local-storage-rewrite)
(rule ((LoopClauseAt statement i prefix)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat vector-pattern-0)
          (ParallelBlock statements clauses))))
       (ClausePatternAt statement i j pattern) (= j (ClauseArity (vec-get clauses i)))
       (= next (LoopClause (ScheduleStatement id 20 i) index pattern (vec-get clauses i)))
       (= joined (JoinedLoopFragments prefix next))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((LoopClauseAt statement (+ i 1) joined)) :ruleset local-storage-rewrite)

(relation CollectFragmentAt (StatementId ValueName Pattern Results i64 LoopFragment))
(rule ((LoopClauseDemand id index pattern (Collect values)))
      ((CollectFragmentAt id index pattern values 0 (Fragment (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of)))) :ruleset local-storage-rewrite)
(rule ((CollectFragmentAt id index pattern values i prefix) (< i (vec-length values)))
      ((LoopArrayDemand (ScheduleStatement id 0 i) index (vec-get pattern i) (vec-get values i))) :ruleset local-storage-rewrite)
(rule ((CollectFragmentAt id index pattern values i prefix) (< i (vec-length values))
       (= next (LoopArray (ScheduleStatement id 0 i) index (vec-get pattern i) (vec-get values i))))
      ((JoinLoopFragments prefix next)) :ruleset local-storage-rewrite)
(rule ((CollectFragmentAt id index pattern values i prefix) (< i (vec-length values))
       (= next (LoopArray (ScheduleStatement id 0 i) index (vec-get pattern i) (vec-get values i)))
       (= joined (JoinedLoopFragments prefix next)))
      ((CollectFragmentAt id index pattern values (+ i 1) joined)) :ruleset local-storage-rewrite)
(rule ((CollectFragmentAt id index pattern values i prefix) (= i (vec-length values)) (= i (vec-length pattern)))
      ((set (LoopClause id index pattern (Collect values)) prefix)) :ruleset local-storage-rewrite)

; Each fold carries its total, whether or not that total is an exposed result.
; Prefixes select the old or new total without changing reducer evaluation.
(relation FoldOutputs (FoldKind i64 i64 bool)) ; prefix multiplier, prefix value role, total
(FoldOutputs (Total) 0 2 true)
(FoldOutputs (InclusiveScan) 1 2 false)
(FoldOutputs (ExclusiveScan) 1 1 false)
(FoldOutputs (InclusiveScanAndTotal) 1 2 true)
(FoldOutputs (ExclusiveScanAndTotal) 1 1 true)
; Build the complete accumulator tuple before joining output arrays. Dependent
; result indices therefore keep their meaning for scalar and array state alike.
(relation FoldNamesAt (StatementId ParallelResult i64 i64 ValueNameRenaming))
(function FoldNames (StatementId ParallelResult i64) Renaming :no-merge)
(relation FoldBindingsAt (StatementId ParallelResult i64 i64 Pattern))
(function FoldBindings (StatementId ParallelResult i64) Pattern :no-merge)
(relation FoldTupleAt (StatementId Pattern ParallelResult i64 Merges Results Stms Arguments Arguments))
(function FoldTuple (StatementId Pattern ParallelResult) LoopFragment :no-merge)
(function FoldArguments (StatementId ParallelResult) Arguments :no-merge)
(function FoldExitOperation (ValueInfo ValueName) Exp :no-merge)
(relation FoldPrefixesAt (StatementId ValueName Pattern ParallelResult i64 LoopFragment))
(rule ((LoopClauseDemand id index pattern clause) (= clause (Fold kind reducer values)))
      ((FoldNamesAt id clause 1 0 (map-empty))
       (FoldNamesAt id clause 2 0 (map-empty))
       (FoldNamesAt id clause 3 0 (map-empty))
       (FoldTupleAt id pattern clause 0 (vec-of) (vec-of) (vec-of) (vec-of) (vec-of))) :ruleset local-storage-rewrite)
(rule ((FoldNamesAt id clause role i names)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params signature body)) values))
       (< i (vec-length neutral)) (= (vec-get params i) (Parameter (BindValue name info) diet)))
      ((FoldNamesAt id clause role (+ i 1) (map-insert names name (ScheduleValue id role i)))) :ruleset local-storage-rewrite)
(rule ((FoldNamesAt id clause role i names) (= clause (Fold kind (Reduction order neutral combine) values))
       (= i (vec-length neutral)))
      ((set (FoldNames id clause role) (Rename names (map-empty) (map-empty) (map-empty) (map-empty)))) :ruleset local-storage-rewrite)
(rule ((= env (FoldNames id clause role)))
      ((FoldBindingsAt id clause role 0 (vec-of))) :ruleset local-storage-rewrite)
(rule ((FoldBindingsAt id clause role i pattern)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params signature body)) values))
       (< i (vec-length neutral)) (= (vec-get params i) (Parameter binding diet)) (= env (FoldNames id clause role)))
      ((RenameBindingDemand env binding)) :ruleset local-storage-rewrite)
(rule ((FoldBindingsAt id clause role i pattern)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params signature body)) values))
       (< i (vec-length neutral)) (= (vec-get params i) (Parameter binding diet))
       (= binding2 (RenameBinding (FoldNames id clause role) binding)))
      ((FoldBindingsAt id clause role (+ i 1) (vec-push pattern binding2))) :ruleset local-storage-rewrite)
(rule ((FoldBindingsAt id clause role i pattern) (= clause (Fold kind (Reduction order neutral combine) values))
       (= i (vec-length neutral)))
      ((set (FoldBindings id clause role) pattern)) :ruleset local-storage-rewrite)
(rule ((= bindings (FoldBindings id clause 3)) (WalkPattern bindings i) (< i (vec-length bindings))
       (= (vec-get bindings i) (BindValue name (ScalarInfo element))))
      ((set (FoldExitOperation (ScalarInfo element) name) (Use (ValueOperand (Var name))))) :ruleset local-storage-rewrite)
(rule ((= bindings (FoldBindings id clause 3)) (WalkPattern bindings i) (< i (vec-length bindings))
       (= (vec-get bindings i) (BindValue name (ArrayValue element shape))))
      ((set (FoldExitOperation (ArrayValue element shape) name) (Copy name))) :ruleset local-storage-rewrite)
(function FoldExit (StatementId Pattern FoldKind i64 i64 ValueInfo) Stms :no-merge)
(rule ((FoldTupleAt id pattern clause i merges yielded exit left right)
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral))
       (= bindings (FoldBindings id clause 1)) (= (vec-get bindings i) (BindValue name info))
       (FoldOutputs kind scans prefix-role false))
      ((set (FoldExit id pattern kind (vec-length neutral) i info) (vec-of))) :ruleset local-storage-rewrite)
(rule ((FoldTupleAt id pattern clause i merges yielded exit left right)
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral))
       (= bindings (FoldBindings id clause 1)) (= (vec-get bindings i) (BindValue name info))
       (FoldOutputs kind scans prefix-role true) (= exits (FoldBindings id clause 3))
       (= (vec-get exits i) (BindValue output output-info)) (= expression (FoldExitOperation output-info output)))
      ((set (FoldExit id pattern kind (vec-length neutral) i info) (vec-of
          (Let (ScheduleStatement id 3 i) (vec-of (vec-get pattern (+ (* scans (vec-length neutral)) i))) (vec-of) expression)))) :ruleset local-storage-rewrite)
(rule ((FoldTupleAt id pattern clause i merges yielded exit left right)
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral))
       (= bindings (FoldBindings id clause 1)) (= binding (vec-get bindings i)) (= binding (BindValue name info))
       (= (vec-get values i) (Yield proofs operand))
       (= last (FoldExit id pattern kind (vec-length neutral) i info)))
      ((FoldTupleAt id pattern clause (+ i 1)
          (vec-push merges (Carry (Parameter binding (Observe)) (ValueOperand (vec-get neutral i))))
          (vec-push yielded (Yield proofs (ValueOperand (Var (ScheduleValue id 2 i))))) (vec-append exit last)
          (vec-push left (Pass (ValueOperand (Var name)) (Observe))) (vec-push right (Pass operand (Observe))))) :ruleset local-storage-rewrite)
(rule ((FoldTupleAt id pattern clause i merges yielded exit left right)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params signature body)) values))
       (= i (vec-length neutral)) (= outputs (FoldBindings id clause 3)))
      ((set (FoldTuple id pattern clause) (Fragment (vec-of) merges signature outputs (vec-of) yielded exit))
       (set (FoldArguments id clause) (vec-append left right))) :ruleset local-storage-rewrite)
(rule ((LoopClauseDemand id index pattern clause) (= part (FoldTuple id pattern clause)))
      ((FoldPrefixesAt id index pattern clause 0 part)) :ruleset local-storage-rewrite)
(rule ((FoldPrefixesAt id index pattern clause i part)
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral))
       (FoldOutputs kind 1 prefix-role total))
      ((LoopArrayDemand (ScheduleStatement id 4 i) index (vec-get pattern i)
          (Yield (vec-of) (ValueOperand (Var (ScheduleValue id prefix-role i)))))) :ruleset local-storage-rewrite)
(rule ((FoldPrefixesAt id index pattern clause i part)
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral))
       (FoldOutputs kind 1 prefix-role total)
       (= array (LoopArray (ScheduleStatement id 4 i) index (vec-get pattern i)
          (Yield (vec-of) (ValueOperand (Var (ScheduleValue id prefix-role i)))))))
      ((JoinLoopFragments part array)) :ruleset local-storage-rewrite)
(rule ((FoldPrefixesAt id index pattern clause i part)
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral))
       (FoldOutputs kind 1 prefix-role total)
       (= array (LoopArray (ScheduleStatement id 4 i) index (vec-get pattern i)
          (Yield (vec-of) (ValueOperand (Var (ScheduleValue id prefix-role i))))))
       (= joined (JoinedLoopFragments part array)))
      ((FoldPrefixesAt id index pattern clause (+ i 1) joined)) :ruleset local-storage-rewrite)
(rule ((FoldPrefixesAt id index pattern clause 0 part) (= clause (Fold (Total) (Reduction order neutral combine) values)))
      ((FoldPrefixesAt id index pattern clause (vec-length neutral) part)) :ruleset local-storage-rewrite)
(rule ((FoldPrefixesAt id index pattern clause i part) (= clause (Fold kind (Reduction order neutral combine) values))
       (= i (vec-length neutral)) (= combined (FoldBindings id clause 2)) (= arguments (FoldArguments id clause)))
      ((ApplyLambdaDemand (ScheduleStatement id 5 0) combined (vec-of) combine arguments)) :ruleset local-storage-rewrite)
(rule ((FoldPrefixesAt id index pattern clause i (Fragment initial merges returns outputs steps yielded exit))
       (= clause (Fold kind (Reduction order neutral combine) values)) (= i (vec-length neutral))
       (= combined (FoldBindings id clause 2)) (= arguments (FoldArguments id clause))
       (= applied (ApplyLambda (ScheduleStatement id 5 0) combined (vec-of) combine arguments)))
      ((set (LoopClause id index pattern clause)
          (Fragment initial merges returns outputs (vec-append applied steps) yielded exit))) :ruleset local-storage-rewrite)

(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= body (ParallelBlock statements clauses)) (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= clause (vec-get clauses i)) (= clause (Fold kind (Reduction order neutral (FunctionBody params signature inner)) values))
       (= function (ScopeRoot context)) (= (CooperativeFold function clause) false)
       (WalkReturnInfos signature j) (< j (vec-length signature)) (= (vec-get signature j) (ReturnArrayValue element shape)))
      ((SequentialBody context body)) :ruleset local-storage-rewrite)

; Token carries rename the captured input, leaving lane-local versions intact.
(relation TokenPredecessor (Function AccName AccName))
(function ContributionInput (StatementId i64) AccName :no-merge)
(relation ContributionAt (StatementId ValueName Pattern AccNames i64 LoopFragment))
(relation LoopTokenMapAt (Stm i64 i64 AccNameRenaming))
(rule ((ContainsAccName (FunctionRoot function) token))
      ((TokenPredecessor function token token)) :ruleset local-storage-analysis)
(rule ((TokenAlias function output input))
      ((TokenPredecessor function output input)) :ruleset local-storage-analysis)
(rule ((TokenAlias function output middle) (TokenPredecessor function middle input))
      ((TokenPredecessor function output input)) :ruleset local-storage-analysis)
(rule ((SequentialParallel program function statement available)
       (= statement (Let id pattern certs (Parallel execution domain body)))
       (= body (ParallelBlock statements clauses)) (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Contribute tokens)) (WalkAccNames tokens j) (< j (vec-length tokens))
       (TokenPredecessor function (vec-get tokens j) input)
       (= free (set-diff (NamesParallelBody body) (BindersParallelBody body)))
       (!= (set-intersect free (set-of (AccNameRef input))) (set-empty)))
      ((set (ContributionInput (ScheduleStatement id 20 i) j) input)) :ruleset local-storage-rewrite)
(rule ((LoopClauseDemand id index pattern (Contribute tokens)))
      ((ContributionAt id index pattern tokens 0 (Fragment (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of)))) :ruleset local-storage-rewrite)
(function ContributionPart (StatementId Pattern AccNames i64) LoopFragment :no-merge)
(rule ((ContributionAt id index pattern tokens i prefix) (< i (vec-length tokens))
       (= input (ContributionInput id i)) (= (vec-get pattern i) (BindAccumulator output info)))
      ((let parameter (CallAccumulator (ScheduleStatement id 0 i) input))
       (let result (CallAccumulator (ScheduleStatement id 1 i) output))
       (set (ContributionPart id pattern tokens i) (Fragment (vec-of)
          (vec-of (Carry (Parameter (BindAccumulator parameter info) (Consume)) (AccOperand input)))
          (vec-of (ReturnAccumulator info)) (vec-of (BindAccumulator result info)) (vec-of)
          (vec-of (Yield (vec-of) (AccOperand (vec-get tokens i))))
          (vec-of (Let (ScheduleStatement id 2 i) (vec-of (vec-get pattern i)) (vec-of) (Use (AccOperand result))))))) :ruleset local-storage-rewrite)
(rule ((ContributionAt id index pattern tokens i prefix) (= part (ContributionPart id pattern tokens i)))
      ((JoinLoopFragments prefix part)) :ruleset local-storage-rewrite)
(rule ((ContributionAt id index pattern tokens i prefix) (= part (ContributionPart id pattern tokens i))
       (= joined (JoinedLoopFragments prefix part)))
      ((ContributionAt id index pattern tokens (+ i 1) joined)) :ruleset local-storage-rewrite)
(rule ((ContributionAt id index pattern tokens i prefix) (= i (vec-length tokens)) (= i (vec-length pattern)))
      ((set (LoopClause id index pattern (Contribute tokens)) prefix)) :ruleset local-storage-rewrite)
(rule ((SequentialParallel program function statement available))
      ((LoopTokenMapAt statement 0 0 (map-empty))) :ruleset local-storage-rewrite)
(rule ((LoopTokenMapAt statement i j names)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (< i (vec-length clauses)) (= (vec-get clauses i) (Contribute tokens)) (< j (vec-length tokens))
       (= input (ContributionInput (ScheduleStatement id 20 i) j)))
      ((LoopTokenMapAt statement i (+ j 1) (map-insert names input
          (CallAccumulator (ScheduleStatement (ScheduleStatement id 20 i) 0 j) input)))) :ruleset local-storage-rewrite)
(rule ((LoopTokenMapAt statement i j names)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (< i (vec-length clauses)) (= (vec-get clauses i) (Contribute tokens)) (= j (vec-length tokens)))
      ((LoopTokenMapAt statement (+ i 1) 0 names)) :ruleset local-storage-rewrite)
(rule ((LoopTokenMapAt statement i 0 names)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (< i (vec-length clauses)) (= (vec-get clauses i) (Collect values)))
      ((LoopTokenMapAt statement (+ i 1) 0 names)) :ruleset local-storage-rewrite)
(rule ((LoopTokenMapAt statement i 0 names)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (< i (vec-length clauses)) (= (vec-get clauses i) (Fold kind reducer values)))
      ((LoopTokenMapAt statement (+ i 1) 0 names)) :ruleset local-storage-rewrite)

(rule ((SequentialParallel program function statement available)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (LoopTokenMapAt statement i 0 tokens) (= i (vec-length clauses))
       (LoopClauseAt statement i (Fragment initial merges returns outputs steps yielded exit)))
      ((RenameBodyDemand (Rename (map-empty) (map-empty) tokens (map-empty) (map-empty)) (Block statements yielded))) :ruleset local-storage-rewrite)
(rule ((SequentialParallel program function statement available)
       (= statement (Let id pattern certs (Parallel execution (IterationSpace flat vector-pattern-0)
          (ParallelBlock statements clauses))))
       (LoopClauseAt statement i (Fragment initial merges returns outputs steps yielded exit))
       (= i (vec-length clauses)) (LoopTokenMapAt statement i 0 tokens)
       (= (Block lane next) (RenameBody (Rename (map-empty) (map-empty) tokens (map-empty) (map-empty)) (Block statements yielded)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((let ordinal (Let (ScheduleStatement id 21 0)
          (vec-of (BindValue flat (ScalarInfo (ScalarElement (I32))))) (vec-of) (IndexOp (IndexValue index))))
       (let body (Block (vec-append (vec-of ordinal) (vec-append lane steps)) next))
       (let loop (Let id outputs certs (Loop merges (Counted index (IndexConstant 0) size (IndexConstant 1)) returns body)))
       (set (PendingRewrite "local-storage" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append initial (vec-append (vec-of loop) exit))))))
       (RewriteDemand "local-storage" program)) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtAdd a b) offset))
      ((ShiftIndexDemand a offset) (ShiftIndexDemand b offset)) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ExtAdd a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtAdd a b) offset) (ExtAdd x y))) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtSub a b) offset))
