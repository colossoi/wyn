(rule ((ShiftIndexDemand (ExtSub a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtSub a b) offset) (ExtSub x y))) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtMul a b) offset))
      ((ShiftIndexDemand a offset) (ShiftIndexDemand b offset)) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ExtMul a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtMul a b) offset) (ExtMul x y))) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtDiv a b) offset))
      ((ShiftIndexDemand a offset) (ShiftIndexDemand b offset)) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ExtDiv a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtDiv a b) offset) (ExtDiv x y))) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtMod a b) offset))
      ((ShiftIndexDemand a offset) (ShiftIndexDemand b offset)) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ExtMod a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtMod a b) offset) (ExtMod x y))) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtMin a b) offset))
      ((ShiftIndexDemand a offset) (ShiftIndexDemand b offset)) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ExtMin a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtMin a b) offset) (ExtMin x y))) :ruleset local-storage-rewrite)

(rule ((ShiftIndexDemand (ExtMax a b) offset))
      ((ShiftIndexDemand a offset) (ShiftIndexDemand b offset)) :ruleset local-storage-rewrite)
(rule ((ShiftIndexDemand (ExtMax a b) offset) (= x (ShiftedIndex a offset)) (= y (ShiftedIndex b offset)))
      ((set (ShiftedIndex (ExtMax a b) offset) (ExtMax x y))) :ruleset local-storage-rewrite)

; A concatenation carries a used prefix and a geometric-capacity buffer. This
; also handles offset vectors: omit their shared first endpoint and shift by
; the preceding final endpoint. All clauses share the original lane evaluation.
(function ConcatSeed (ConcatMode) i64 :no-merge)
(set (ConcatSeed (Elements)) 0)
(set (ConcatSeed (OffsetSequences)) 1)
(relation ConcatFragment (StatementId ValueName Pattern ConcatMode ValueName ElementType Shape))
(function ConcatInput (StatementId ConcatMode ValueName) Stms :no-merge)
(function ConcatRow (StatementId ConcatMode ValueName) ValueName :no-merge)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements clauses)))
       (WalkParallelResults clauses i) (< i (vec-length clauses)) (= (vec-get clauses i) (Concatenate mode source)))
      ((set (BoundedLocals function (ParallelBlock statements clauses)) false)) :ruleset local-storage-status)
(rule ((SequentialParallel program function statement available)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (ClausePatternAt statement i j pattern) (= j 3) (= (vec-get clauses i) (Concatenate mode source))
       (= (vec-get axes 0) (DenseAxis index count))
       (= (BindingInfo function source) (ArrayValue element shape)))
      ((ConcatFragment (ScheduleStatement id 20 i) index pattern mode source element shape)) :ruleset local-storage-rewrite)
(rule ((LoopTokenMapAt statement i 0 names)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (< i (vec-length clauses)) (= (vec-get clauses i) (Concatenate mode source)))
      ((LoopTokenMapAt statement (+ i 1) 0 names)) :ruleset local-storage-rewrite)
(rule ((ConcatFragment id index pattern (Elements) source element shape))
      ((set (ConcatInput id (Elements) source) (vec-of)) (set (ConcatRow id (Elements) source) source)) :ruleset local-storage-rewrite)
(rule ((ConcatFragment id index pattern (OffsetSequences) source element shape))
      ((let width (IndexSub (vec-get shape 0) (IndexConstant 1)))
       (let scalar (ScalarInfo (ScalarElement (I32))))
       (let base (Let (ScheduleStatement id 40 0) (vec-of (BindValue (ScheduleValue id 40 0) scalar)) (vec-of)
          (Load (ScheduleValue id 1 2) (vec-of (IndexSub (IndexValue (ScheduleValue id 1 0)) (IndexConstant 1))))))
       (let load (Let (ScheduleStatement id 40 1) (vec-of (BindValue (ScheduleValue id 40 1) scalar)) (vec-of)
          (Load source (vec-of (IndexAdd (IndexValue (ScheduleValue id 40 2)) (IndexConstant 1))))))
       (let add (Let (ScheduleStatement id 40 2) (vec-of (BindValue (ScheduleValue id 40 3) scalar)) (vec-of)
          (IndexOp (IndexAdd (IndexValue (ScheduleValue id 40 0)) (IndexValue (ScheduleValue id 40 1))))))
       (let body (ParallelBlock (vec-of load add)
          (vec-of (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 40 3)))))))))
       (let shift (Let (ScheduleStatement id 40 3)
          (vec-of (BindValue (ScheduleValue id 40 4) (ArrayValue element (vec-of width)))) (vec-of)
          (Parallel (Unscheduled) (IterationSpace (ScheduleValue id 40 5)
              (vec-of (DenseAxis (ScheduleValue id 40 2) width))) body)))
       (set (ConcatInput id (OffsetSequences) source) (vec-of base shift))
       (set (ConcatRow id (OffsetSequences) source) (ScheduleValue id 40 4))) :ruleset local-storage-rewrite)
(function ConcatInitial (ConcatMode ElementType Shape) Exp :no-merge)
(rule ((ConcatFragment id index pattern (Elements) source element shape))
      ((set (ConcatInitial (Elements) element shape)
          (GenerateArray (Uninitialized element (vec-set shape 0 (IndexConstant 0)))))) :ruleset local-storage-rewrite)
(rule ((ConcatFragment id index pattern (OffsetSequences) source element shape))
      ((set (ConcatInitial (OffsetSequences) element shape)
          (GenerateArray (ArrayLiteral (vec-of (LiteralBits (I32) 0)))))) :ruleset local-storage-rewrite)

(rule ((ConcatFragment id index pattern mode source element shape) (= seed (ConcatSeed mode))
       (= row (ConcatRow id mode source)) (= prepare (ConcatInput id mode source))
       (= init (ConcatInitial mode element shape))
       (= (vec-get pattern 0) (BindValue offsets (ArrayValue (ScalarElement (I32)) offset-shape)))
       (= (vec-get pattern 1) (BindValue size size-info))
       (= (vec-get pattern 2) (BindValue data data-info))
       (= suffix (vec-remove shape 0)) (= free-shape (FreeShape shape (vec-length shape)))
       (= offset-return (FreeShape offset-shape (vec-length offset-shape))))
      ((let scalar (ScalarInfo (ScalarElement (I32))))
       (let width (IndexSub (vec-get shape 0) (IndexConstant seed)))
       (let cap-shape (vec-set shape 0 (IndexValue (ScheduleValue id 1 1))))
       (let grown-shape (vec-set shape 0 (IndexValue (ScheduleValue id 2 1))))
       (let final-shape (vec-set shape 0 (IndexValue (ScheduleValue id 3 1))))
       (let create-buffer (Let (ScheduleStatement id 0 0)
          (vec-of (BindValue (ScheduleValue id 0 0) (ArrayValue element (vec-set shape 0 (IndexConstant seed))))) (vec-of) init))
       (let create-offsets (Let (ScheduleStatement id 0 1)
          (vec-of (BindValue (ScheduleValue id 0 1) (ArrayValue (ScalarElement (I32)) offset-shape))) (vec-of)
          (GenerateArray (Uninitialized (ScalarElement (I32)) offset-shape))))
       (let first-offset (Let (ScheduleStatement id 0 2)
          (vec-of (BindValue (ScheduleValue id 0 2) (ArrayValue (ScalarElement (I32)) offset-shape))) (vec-of)
          (Update (ProvenInBounds) (ScheduleValue id 0 1) (vec-of (At (IndexConstant 0))) (LiteralBits (I32) 0))))
       (let required (Let (ScheduleStatement id 2 0) (vec-of (BindValue (ScheduleValue id 2 0) scalar)) (vec-of)
          (IndexOp (IndexAdd (IndexValue (ScheduleValue id 1 0)) width))))
       (let needs-growth (Let (ScheduleStatement id 2 1)
          (vec-of (BindValue (ScheduleValue id 2 4) (ScalarInfo (ScalarElement (Bool))))) (vec-of)
          (PrimOp "<" (vec-of (Var (ScheduleValue id 1 1)) (Var (ScheduleValue id 2 0))))))
       (let new-capacity (Let (ScheduleStatement id 5 0) (vec-of (BindValue (ScheduleValue id 5 0) scalar)) (vec-of)
          (IndexOp (IndexMax (IndexMul (IndexConstant 2) (IndexValue (ScheduleValue id 1 1))) (IndexValue (ScheduleValue id 2 0))))))
       (let new-shape (vec-set shape 0 (IndexValue (ScheduleValue id 5 0))))
       (let fresh (Let (ScheduleStatement id 5 1) (vec-of (BindValue (ScheduleValue id 5 1) (ArrayValue element new-shape))) (vec-of)
          (GenerateArray (Uninitialized element new-shape))))
       (let prefix (Let (ScheduleStatement id 5 2)
          (vec-of (BindValue (ScheduleValue id 5 2) (ArrayValue element (vec-set shape 0 (IndexValue (ScheduleValue id 1 0)))))) (vec-of)
          (View (ScheduleValue id 1 2) (vec-of (Slice (IndexConstant 0) (IndexValue (ScheduleValue id 1 0)) (IndexConstant 1))))))
       (let copied (Let (ScheduleStatement id 5 3) (vec-of (BindValue (ScheduleValue id 5 3) (ArrayValue element new-shape))) (vec-of)
          (Update (ProvenInBounds) (ScheduleValue id 5 1)
              (vec-of (Slice (IndexConstant 0) (IndexValue (ScheduleValue id 1 0)) (IndexConstant 1))) (Var (ScheduleValue id 5 2)))))
       (let yes (Block (vec-of new-capacity fresh prefix copied)
          (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 5 0))))
                  (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 5 3)))))))
       (let no (Block (vec-of)
          (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 1 1))))
                  (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 1 2)))))))
       (let growth (Let (ScheduleStatement id 2 2)
          (vec-of (BindValue (ScheduleValue id 2 1) scalar) (BindValue (ScheduleValue id 2 5) (ArrayValue element grown-shape))) (vec-of)
          (If (Var (ScheduleValue id 2 4))
              (vec-of (ReturnScalar (ScalarElement (I32))) (ReturnArrayValue element (vec-set free-shape 0 (ResultIndex 0)))) yes no)))
       (let append (Let (ScheduleStatement id 2 3) (vec-of (BindValue (ScheduleValue id 2 2) (ArrayValue element grown-shape))) (vec-of)
          (Update (ProvenInBounds) (ScheduleValue id 2 5)
              (vec-of (Slice (IndexValue (ScheduleValue id 1 0)) width (IndexConstant 1))) (Var row))))
       (let segment-end (Let (ScheduleStatement id 2 4) (vec-of (BindValue (ScheduleValue id 2 6) scalar)) (vec-of)
          (IndexOp (IndexSub (IndexValue (ScheduleValue id 2 0)) (IndexConstant seed)))))
       (let offset-update (Let (ScheduleStatement id 2 5)
          (vec-of (BindValue (ScheduleValue id 2 3) (ArrayValue (ScalarElement (I32)) offset-shape))) (vec-of)
          (Update (ProvenInBounds) (ScheduleValue id 1 3)
              (vec-of (At (IndexAdd (IndexValue index) (IndexConstant 1)))) (Var (ScheduleValue id 2 6)))))
       (let exit (vec-of
          (Let (ScheduleStatement id 3 0) (vec-of (vec-get pattern 0)) (vec-of) (Use (ValueOperand (Var (ScheduleValue id 3 3)))))
          (Let (ScheduleStatement id 3 1) (vec-of (vec-get pattern 1)) (vec-of) (Use (ValueOperand (Var (ScheduleValue id 3 0)))))
          (Let (ScheduleStatement id 3 2) (vec-of (vec-get pattern 2)) (vec-of)
              (View (ScheduleValue id 3 2) (vec-of (Slice (IndexConstant 0) (IndexValue size) (IndexConstant 1)))))))
       (set (LoopClause id index pattern (Concatenate mode source)) (Fragment
          (vec-of create-buffer create-offsets first-offset)
          (vec-of
              (Carry (Parameter (BindValue (ScheduleValue id 1 0) scalar) (Observe)) (ValueOperand (LiteralBits (I32) seed)))
              (Carry (Parameter (BindValue (ScheduleValue id 1 1) scalar) (Observe)) (ValueOperand (LiteralBits (I32) seed)))
              (Carry (Parameter (BindValue (ScheduleValue id 1 2) (ArrayValue element cap-shape)) (Consume)) (ValueOperand (Var (ScheduleValue id 0 0))))
              (Carry (Parameter (BindValue (ScheduleValue id 1 3) (ArrayValue (ScalarElement (I32)) offset-shape)) (Consume)) (ValueOperand (Var (ScheduleValue id 0 2)))))
          (vec-of (ReturnScalar (ScalarElement (I32))) (ReturnScalar (ScalarElement (I32)))
              (ReturnArrayValue element (vec-set free-shape 0 (ResultIndex 1))) (ReturnArrayValue (ScalarElement (I32)) offset-return))
          (vec-of (BindValue (ScheduleValue id 3 0) scalar) (BindValue (ScheduleValue id 3 1) scalar)
              (BindValue (ScheduleValue id 3 2) (ArrayValue element final-shape))
              (BindValue (ScheduleValue id 3 3) (ArrayValue (ScalarElement (I32)) offset-shape)))
          (vec-append prepare (vec-of required needs-growth growth append segment-end offset-update))
          (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 2 0))))
              (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 2 1))))
              (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 2 2))))
              (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 2 3))))) exit))) :ruleset local-storage-rewrite)

(rule ((CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (= (HostScope context) false) (= body (ParallelBlock statements clauses))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params signature inner)) values))
       (WalkReturnInfos signature j) (< j (vec-length signature)) (= (vec-get signature j) (ReturnArrayValue element shape)))
      ((SequentialBody context body)) :ruleset local-storage-rewrite)
