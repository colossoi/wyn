; Selected callback applications reference existing fused operations and scalar bodies.
; Each index binding consumes one map axis; ranked indexed inputs use their own routing.
(ruleset map-bindings)
(datatype MapBinding
  (MapValueBinding SourceValue)
  (MapCallBinding RegionKey RegionKey SourceArguments MapBinding)
  (MapIndexBinding RegionKey RegionKey FusionPlan SourceArguments i64 MapBinding))
(relation MapBindingDemand (SourceValue i64 i64 bool))
(relation MapBindingContinue (SourceValue i64 i64 bool))
(function MapBindings (SourceValue i64 i64 bool) MapBinding :no-merge)
(function MapOutputBindings (OperationKey i64) MapBinding :no-merge)
(function MapArguments (FusionPlan OperationKey i64) SourceArguments :no-merge)

; Flat fused element producers and selected rectangular outputs share this binding plan.
(rule ((Current group plan) (PlanMember plan op) (= (PlanMapping op) true)
       (= value (SourceOperationValue op)))
      ((MapBindingDemand value 0 1 false)) :ruleset map-bindings)
(rule ((MapPlan plan owner extent) (= rank (IterationRank owner)) (= cooperative (MapCooperative owner))
       (PlanResult plan "array" i value element))
      ((MapBindingDemand value 0 rank cooperative)) :ruleset map-bindings)
(rule ((MapPlan plan owner extent) (= rank (IterationRank owner)) (= cooperative (MapCooperative owner))
       (PlanResult plan "array" i value element) (= bindings (MapBindings value 0 rank cooperative)))
      ((set (MapOutputBindings owner i) bindings)) :ruleset map-bindings)
(rule ((MapBindingDemand value rank rank false))
      ((set (MapBindings value rank rank false) (MapValueBinding value))) :ruleset map-bindings)
(rule ((MapBindingDemand value rank rank true)
       (= (SegmentTerminal value 0) (SegmentResult value owner plan role slot)))
      ((set (MapBindings value rank rank true) (MapValueBinding value))) :ruleset map-bindings)
(rule ((MapBindingDemand value axis rank cooperative) (< axis rank))
      ((MapBindingContinue value axis rank cooperative)) :ruleset map-bindings)
(rule ((MapBindingDemand value rank rank true)
       (= (SegmentTerminal value 0) (SegmentResult terminal owner plan role slot)) (!= value terminal))
      ((MapBindingContinue value rank rank true)) :ruleset map-bindings)

(rule ((MapBindingContinue value axis rank cooperative) (= actual (SourceAlias value)))
      ((MapBindingDemand actual axis rank cooperative)) :ruleset map-bindings)
(rule ((MapBindingContinue value axis rank cooperative) (= actual (SourceAlias value))
       (= bindings (MapBindings actual axis rank cooperative)))
      ((set (MapBindings value axis rank cooperative) bindings)) :ruleset map-bindings)
(rule ((MapBindingContinue value axis rank cooperative) (= callee (PlanCallee value))
       (= result (SourceResult callee)))
      ((MapBindingDemand result axis rank cooperative)) :ruleset map-bindings)
(rule ((MapBindingContinue value axis rank cooperative) (= value (SourceInvocation caller function args))
       (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= bindings (MapBindings result axis rank cooperative)))
      ((set (MapBindings value axis rank cooperative) (MapCallBinding caller callee args bindings))) :ruleset map-bindings)
(rule ((MapBindingContinue value axis rank cooperative) (< axis rank)
       (= op (SourceValueOperation value)) (= plan (SelectedPlan op)) (= (PlanMapping op) true)
       (= body (SourceOperatorBody op)) (= result (SourceResult body)))
      ((set (MapArguments plan op 0) (vec-of))
       (MapBindingDemand result (+ axis 1) rank cooperative)) :ruleset map-bindings)
(rule ((= args (MapArguments plan op i)) (= count (SourceInputCount op)) (< i count)
       (= input (SourceInput op i)))
      ((set (MapArguments plan op (+ i 1)) (vec-push args input))) :ruleset map-bindings)
(rule ((MapBindingContinue value axis rank cooperative) (< axis rank)
       (= op (SourceValueOperation value)) (= plan (SelectedPlan op)) (= (PlanMapping op) true)
       (= caller (PlanScope plan)) (= body (SourceOperatorBody op)) (= result (SourceResult body))
       (= count (SourceInputCount op)) (= args (MapArguments plan op count))
       (= bindings (MapBindings result (+ axis 1) rank cooperative)))
      ((set (MapBindings value axis rank cooperative) (MapIndexBinding caller body plan args axis bindings))) :ruleset map-bindings)

; Output addresses use the selected outer axes, with a collective element axis for scans.
(sort MapAxes (Vec i64))
(function MapOuterAxes (i64) MapAxes :no-merge)
(set (MapOuterAxes 0) (vec-of))
(rule ((= rank (IterationRank owner)) (= axes (MapOuterAxes i)) (< i rank))
      ((set (MapOuterAxes (+ i 1)) (vec-push axes i))) :ruleset map-bindings)
(function SegmentOutput (OperationKey i64) SegmentRecipe :no-merge)
(function MapOutputAxes (OperationKey i64) MapAxes :no-merge)
(rule ((MapPlan plan owner extent) (= (MapCooperative owner) false) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element) (= axes (MapOuterAxes rank)))
      ((set (MapOutputAxes owner i) axes)) :ruleset map-bindings)
(rule ((MapPlan plan owner extent) (= (MapCooperative owner) true) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element) (= terminal (SegmentTerminal value rank)))
      ((set (SegmentOutput owner i) terminal)) :ruleset map-bindings)
(rule ((= result (SegmentOutput owner i)) (= result (SegmentResult value inner plan "total" slot))
       (= rank (IterationRank owner)) (= axes (MapOuterAxes rank)))
      ((set (MapOutputAxes owner i) axes)) :ruleset map-bindings)
(rule ((= result (SegmentOutput owner i)) (= result (SegmentResult value inner plan "array" slot))
       (= rank (IterationRank owner)) (= axes (MapOuterAxes rank)))
      ((set (MapOutputAxes owner i) (vec-push axes rank))) :ruleset map-bindings)
