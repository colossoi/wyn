; Lift a closed array-producing region into an ordinary parallel loop. The
; selected traversal supplies its elements; calls and choices retain their scopes.
(ruleset distribute-discover)
(rule ((= (SourceOutput output) (OutputInfo entry value ty true)))
      ((FlowValueOf value)) :ruleset distribute-discover)
(rule ((= view (SourceView value))) ((FlowValueOf value)) :ruleset distribute-discover)
(rule ((Current group plan) (= (PlanBody plan) (ScalarBody)) (= owner (Owner plan))
       (= value (SourceOperationValue owner)) (= ty (SourceType value)) (SourceArrayElement ty element)
       (= (SourceReadOnly value) true))
      ((RectangularDemand value)) :ruleset distribute-discover)
(ruleset distribute-select)
(relation DistributedBody (FusionGroup FusionPlan FusionPlan))
(rule ((Current group plan) (= (PlanBody plan) (ScalarBody)) (= owner (Owner plan)) (= region (PlanScope plan))
       (= value (SourceOperationValue owner)) (= ty (SourceType value)) (SourceArrayElement ty element)
       (RectangularReady value) (= depth (MapDepth value)) (> depth 0) (= extent (RectangularAxis value 0))
       (= (SourceReadOnly value) true))
      ((DistributedBody group plan (Distributed plan))
       (set (PlanBody (Distributed plan))
            (ParallelLoop (OneAxis extent) (NoResults) (NoResults) (OneResult value element) (Publish)))
       (set (Owner (Distributed plan)) owner) (set (PlanScope (Distributed plan)) region)
       (PlanMember (Distributed plan) owner) (set (PlanMapping owner) true)) :ruleset distribute-select)
(ruleset distribute-commit)
(rule ((DistributedBody group original replacement) (= owner (Owner original)))
      ((delete (Current group original)) (delete (SelectedPlan owner)) (Current group replacement)) :ruleset distribute-commit)

(rule ((Current group plan) (= owner (Owner plan)) (= (PlanMapping owner) true) (Enters owner region))
      ((Callback owner region) (DeviceRegion region)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan))
       (= (PlanBody plan) (ParallelLoop domain totals scans arrays action)))
      ((set (InvocationBoundary owner) true)) :ruleset classify)
