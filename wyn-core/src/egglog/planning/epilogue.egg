; A pointwise consumer shares only the final prefix dispatch, never the reduction.
(ruleset epilogue-index)
(ruleset epilogue-legality)
(ruleset epilogue-select)
(relation EpiloguePath (OperationKey OperationKey))
(relation EpiloguePair (OperationKey OperationKey))
(relation PointwisePair (OperationKey OperationKey))
(relation PointwiseSource (OperationKey OperationKey i64))
(relation EpilogueDomainPrefix (OperationKey OperationKey i64))
(relation EpilogueClauses (OperationKey i64))
(relation EpilogueHasScan (OperationKey))
(relation PointwiseLoadPrefix (OperationKey OperationKey OperationKey i64))
(relation PointwiseLoad (OperationKey OperationKey OperationKey))
(relation PointwiseSafeOperation (OperationKey OperationKey OperationKey))
(relation PointwiseRegionPrefix (OperationKey OperationKey RegionKey OperationKey))
(relation PointwiseSafeRegion (OperationKey OperationKey RegionKey))
(function PointwiseHandledUse (OperationKey OperationKey OperationKey Name) bool :merge (or old new))
(function PointwiseLegal (OperationKey OperationKey) bool :merge (and old new))
(relation EpilogueRequiresCompletedTotal (OperationKey OperationKey))
(relation EpilogueConsumer (OperationKey))
(relation EpilogueScratch (ValueName))
(relation EpilogueOverwrite (OperationKey OperationKey i64))
(rule ((= revision (AnalysisRevision)) (ScratchAllocation operation) (= (Output operation 0) (ValueNameRef array)))
      ((EpilogueScratch array)) :ruleset epilogue-index)
(rule ((MaterializedCopyOperation operation) (= (Input operation 0) (ValueNameRef source))
       (EpilogueScratch source) (= (Output operation 0) (ValueNameRef array)))
      ((EpilogueScratch array)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= (ResultCount operation) 1) (= (ResultKindOf operation 0) (Collected)))
      ((EpilogueConsumer operation)) :ruleset epilogue-index)
; Use the prefix at its own coordinate before overwriting an independent scratch array.
(rule ((= (ResultCount operation) 1) (= (ResultKindOf operation 0) (Contributed))
       (= (ResultValueCount operation 0) 1) (= (ResultValue operation 0 0) (AccNameRef token))
       (= (TokenCapability token) (TokenBindingAt owner group)) (AtomicAccumulatorArray owner group array)
       (EpilogueScratch array) (= (AccumulatorPolicy owner group) (IdenticalWrites)))
      ((EpilogueConsumer operation) (EpilogueOverwrite operation owner group)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpiloguePath first second) (ParallelOperation first) (ParallelOperation second)
       (= execution (OperationExecution first)) (= execution (OperationExecution second))
       (= domain (OperationDomain first)) (= (DomainRank domain) 1)
       (EpilogueConsumer second))
      ((EpiloguePair first second) (PointwisePair first second) (EpilogueDomainPrefix first second 0) (EpilogueClauses first 0)
       (set (PointwiseLegal first second) true)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpilogueDomainPrefix first second slot) (= a (OperationDomain first)) (= b (OperationDomain second))
       (< slot (DomainRank a)) (= count (DomainExtent a slot)) (= count (DomainExtent b slot)))
      ((EpilogueDomainPrefix first second (+ slot 1))) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpilogueClauses operation slot) (< slot (ResultCount operation))
       (= (ResultKindOf operation slot) (Collected)))
      ((EpilogueClauses operation (+ slot 1))) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpilogueClauses operation slot) (< slot (ResultCount operation))
       (= (ResultKindOf operation slot) (Compacted)))
      ((EpilogueClauses operation (+ slot 1))) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpilogueClauses operation slot) (< slot (ResultCount operation))
       (= (ResultKindOf operation slot) (Folded kind)))
      ((EpilogueClauses operation (+ slot 1))) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= (OutputRole operation slot) (PrefixOutput)))
      ((EpilogueHasScan operation)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpiloguePair first second) (= (OutputRole first slot) (CollectedOutput)))
      ((PointwiseSource first second slot)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpiloguePair first second) (= (OutputRole first slot) (PrefixOutput)))
      ((PointwiseSource first second slot)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwiseSource first second slot) (= body (ControlRegion second 0))
       (FlowScopeAncestor body child) (= child (OperationRegion load)) (IndexOperation load)
       (= source (Input load 0)) (= source (Output first slot)))
      ((PointwiseLoadPrefix first second load 0)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwiseLoadPrefix first second load slot) (= domain (OperationDomain second))
       (< slot (DomainRank domain)) (= axis (DomainAxis domain slot)) (= (Input load (+ slot 1)) (ValueNameRef axis)))
      ((PointwiseLoadPrefix first second load (+ slot 1))) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwiseLoadPrefix first second load (DomainRank (OperationDomain second)))
       (= count (DomainRank (OperationDomain second))) (= (InputCount load) (+ count 1))
       (= source (Input load 0)))
      ((PointwiseLoad first second load) (PointwiseSafeOperation first second load)
       (set (PointwiseHandledUse first second load source) true)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwiseLoad first second load)
       (= domain (OperationDomain second)) (= axis (DomainAxis domain slot))
       (= (Input load (+ slot 1)) (ValueNameRef axis)))
      ((set (PointwiseHandledUse first second load (ValueNameRef axis)) true)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (= region (OperationRegion user))
       (DirectOperationUse user name) (= name (Output first slot)))
      ((set (PointwiseHandledUse first second user name) false)) :ruleset epilogue-index)
; A chunked scan's carry dispatch has published its scalar totals before the final pass.
(rule ((= (PointwiseHandledUse first second user (ValueNameRef value)) handled)
       (= (Output first slot) (ValueNameRef value)) (= (OutputRole first slot) (TotalOutput))
       (= (ValueType value) (ScalarInfo element)))
      ((set (PointwiseHandledUse first second user (ValueNameRef value)) true)
       (EpilogueRequiresCompletedTotal first second)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (DirectOperationUse second name) (= name (Output first slot)))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (= body (ControlRegion second 0)) (FlowScopeAncestor body region)
       (EndDemand region name) (= name (Output first slot)))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (= region (OperationRegion operation)) (= (PureOperation operation) true))
      ((PointwiseSafeOperation first second operation)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (= region (OperationRegion write)) (WritesInput write 0)
       (= (Input write 0) (AccNameRef token)) (= (TokenCapability token) (TokenBindingAt owner group)))
      ((PointwiseSafeOperation first second write) (EffectCompare first second)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (= region (OperationRegion read)) (TotalIndex read))
      ((PointwiseSafeOperation first second read)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group) (OperationsConflict first second))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group)
       (OperationRead second resource) (OperationWrite second resource))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group)
       (= array (AccumulatorArray owner group 0)) (OperationUse first (ValueNameRef array)))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group)
       (= array (AccumulatorArray owner group 0)) (OperationUse second (ValueNameRef array)))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (EmptyRegion region))
      ((PointwiseSafeRegion first second region)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (= body (ControlRegion second 0))
       (FlowScopeAncestor body region) (FirstOperation region operation))
      ((PointwiseRegionPrefix first second region operation)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwiseRegionPrefix first second region operation)
       (PointwiseSafeOperation first second operation) (NextOperation operation next))
      ((PointwiseRegionPrefix first second region next)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwiseRegionPrefix first second region operation)
       (PointwiseSafeOperation first second operation) (LastOperation region operation))
      ((PointwiseSafeRegion first second region)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (BranchOperation operation)
       (= a (ControlRegion operation 0)) (= b (ControlRegion operation 1))
       (PointwiseSafeRegion first second a) (PointwiseSafeRegion first second b))
      ((PointwiseSafeOperation first second operation)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (PointwisePair first second) (CountedLoopOperation operation)
       (= body (ControlRegion operation 0)) (PointwiseSafeRegion first second body))
      ((PointwiseSafeOperation first second operation)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= (PointwiseHandledUse first second user name) false))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((= revision (AnalysisRevision)) (EpiloguePair first second) (EpilogueHasScan first)
       (EpilogueClauses first (ResultCount first)) (= body (ControlRegion second 0))
       (PointwiseSafeRegion first second body) (PointwiseLoad first second load)
       (= domain (OperationDomain second)) (= (DomainRank domain) 1) (EpilogueDomainPrefix first second 1)
       (= (PointwiseLegal first second) true))
      ((ScanEpilogue first second)) :ruleset epilogue-select)

(rule ((= revision (AnalysisRevision)) (NextOperation first next) (ParallelOperation first))
      ((EpiloguePath first next)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpiloguePath first middle) (DiscardableOperation middle) (RepeatableOperation middle)
       (= (PureOperation middle) true) (NextOperation middle next))
      ((EpiloguePath first next)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= (OutputRole operation slot) (CompactedOutput))
       (= clause (OutputClause operation slot)) (= (ResultKindOf operation clause) (Folded kind)))
      ((EpilogueHasScan operation)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (EpiloguePair first second) (= (OutputRole first slot) (CompactedOutput))
       (= clause (OutputClause first slot)) (= (ResultKindOf first clause) (Folded kind))
       (= (Output first slot) (ValueNameRef array)) (= domain (OperationDomain second))
       (CountLength (DomainExtent domain 0) array))
      ((PointwiseSource first second slot) (EpilogueDomainPrefix first second 1)) :ruleset epilogue-index)

; An epilogue may overwrite a prefix after its last read, at the same index.
(function EpilogueReuse (OperationKey ValueName) bool :merge (and old new))
(rule ((= revision (AnalysisRevision)) (EpiloguePair first second) (PointwiseSource first second slot)
       (= (Output first slot) (ValueNameRef array)))
      ((set (EpilogueReuse second array) true)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= flag (EpilogueReuse second array))
       (DirectOperationUse user (ValueNameRef array)))
      ((set (ReuseReadSafe second array user) false)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= flag (EpilogueReuse second array))
       (LengthOperation user axis) (= (Input user 0) (ValueNameRef array)))
      ((set (ReuseReadSafe second array user) true)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= flag (EpilogueReuse second array))
       (PointwiseLoad first second user) (= (Input user 0) (ValueNameRef array)))
      ((set (ReuseReadSafe second array user) true)) :ruleset epilogue-index)
(rule ((= revision (AnalysisRevision)) (= flag (EpilogueReuse second array))
       (= (ReuseReadSafe second array user) false))
      ((set (EpilogueReuse second array) false)) :ruleset epilogue-legality)
(rule ((= revision (AnalysisRevision)) (= flag (EpilogueReuse second array)) (EndDemand region (ValueNameRef array)))
      ((set (EpilogueReuse second array) false)) :ruleset epilogue-legality)
(rule ((= revision (AnalysisRevision)) (ScanEpilogue first second) (= (EpilogueReuse second array) true)
       (= (Output second slot) (ValueNameRef output)))
      ((CanReuse output array)) :ruleset epilogue-select)
