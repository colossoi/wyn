; A pointwise consumer shares only the final prefix dispatch, never the reduction.
(ruleset epilogue-index)
(ruleset epilogue-legality)
(ruleset epilogue-select)
(relation EpilogueCandidate (OperationKey OperationKey))
(relation EpiloguePair (OperationKey OperationKey))
(relation PointwisePair (OperationKey OperationKey))
(relation PointwiseSource (OperationKey OperationKey i64))
(relation EpilogueDomainPrefix (OperationKey OperationKey i64))
(relation EpilogueClauses (OperationKey i64))
(relation PointwiseLoadPrefix (OperationKey OperationKey OperationKey i64))
(relation PointwiseLoad (OperationKey OperationKey OperationKey))
(relation PointwiseSafeOperation (OperationKey OperationKey OperationKey))
(relation PointwiseRegionPrefix (OperationKey OperationKey RegionKey OperationKey))
(relation PointwiseSafeRegion (OperationKey OperationKey RegionKey))
(function PointwiseHandledUse (OperationKey OperationKey OperationKey Name) bool :merge (or old new))
(function PointwiseLegal (OperationKey OperationKey) bool :merge (and old new))
(relation EpilogueRequiresCompletedTotal (OperationKey OperationKey))
(relation EpilogueConsumer (OperationKey))
(relation EpilogueScratch (ValueName))
(relation EpilogueOverwrite (OperationKey OperationKey i64))
(rule ((ScratchAllocation operation) (ResultOrigin (ValueNameRef array) operation 0))
      ((EpilogueScratch array)) :ruleset epilogue-index)
(rule ((MaterializedCopyOperation operation) (= (wyn-input operation 0) (ValueNameRef source))
       (EpilogueScratch source) (ResultOrigin (ValueNameRef array) operation 0))
      ((EpilogueScratch array)) :ruleset epilogue-index)
(rule ((= (wyn-result-count operation) 1) (CollectedClause operation 0))
      ((EpilogueConsumer operation)) :ruleset epilogue-index)
; Use the prefix at its own coordinate before overwriting an independent scratch array.
(rule ((= (wyn-result-count operation) 1) (ContributedClause operation 0)
       (= (wyn-contribution-count operation 0) 1) (= (wyn-contribution operation 0 0) (AccNameRef token))
       (= (TokenCapability token) (TokenBindingAt owner group)) (AtomicAccumulatorArray owner group array)
       (EpilogueScratch array) (= (wyn-accumulator-policy owner group) (IdenticalWrites)))
      ((EpilogueConsumer operation) (EpilogueOverwrite operation owner group)) :ruleset epilogue-index)
(rule ((EpilogueCandidate first second)
       (= execution (OperationExecution first)) (= execution (OperationExecution second))
       (EpilogueConsumer second))
      ((EpiloguePair first second) (PointwisePair first second) (EpilogueClauses first 0)
       (set (PointwiseLegal first second) true)) :ruleset epilogue-index)
(rule ((EpilogueClauses operation slot) (< slot (wyn-result-count operation))
       (CollectedClause operation slot))
      ((EpilogueClauses operation (+ slot 1))) :ruleset epilogue-index)
(rule ((EpilogueClauses operation slot) (< slot (wyn-result-count operation))
       (CompactedClause operation slot))
      ((EpilogueClauses operation (+ slot 1))) :ruleset epilogue-index)
(rule ((EpilogueClauses operation slot) (< slot (wyn-result-count operation))
       (FoldClause operation slot kind))
      ((EpilogueClauses operation (+ slot 1))) :ruleset epilogue-index)
(rule ((EpiloguePair first second) (ResultOrigin source first slot) (= (wyn-output-role first slot) (CollectedOutput)))
      ((PointwiseSource first second slot)) :ruleset epilogue-index)
(rule ((EpiloguePair first second) (ResultOrigin source first slot) (= (wyn-output-role first slot) (PrefixOutput)))
      ((PointwiseSource first second slot)) :ruleset epilogue-index)
(rule ((PointwiseSource first second slot) (= body (wyn-control-region second 0))
       (FlowScopeAncestor body child) (= child (wyn-region-of load)) (IndexOperation load)
       (ResultOrigin source first slot) (DirectOperationUse load source) (= source (wyn-input load 0)))
      ((PointwiseLoadPrefix first second load 0)) :ruleset epilogue-index)
(rule ((PointwiseLoadPrefix first second load slot) (= domain (wyn-iteration-domain second))
       (< slot (wyn-domain-rank domain)) (= axis (wyn-domain-axis domain slot)) (= (wyn-input load (+ slot 1)) (ValueNameRef axis)))
      ((PointwiseLoadPrefix first second load (+ slot 1))) :ruleset epilogue-index)
(rule ((PointwiseLoadPrefix first second load count)
       (= count (wyn-domain-rank (wyn-iteration-domain second))) (= (wyn-input-count load) (+ count 1))
       (= source (wyn-input load 0)))
      ((PointwiseLoad first second load) (PointwiseSafeOperation first second load)
       (set (PointwiseHandledUse first second load source) true)) :ruleset epilogue-index)
(rule ((PointwiseLoad first second load)
       (= domain (wyn-iteration-domain second)) (IterationAxis domain slot) (= axis (wyn-domain-axis domain slot))
       (= (wyn-input load (+ slot 1)) (ValueNameRef axis)))
      ((set (PointwiseHandledUse first second load (ValueNameRef axis)) true)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (= body (wyn-control-region second 0))
       (FlowScopeAncestor body region) (= region (wyn-region-of user))
       (DirectOperationUse user name) (ResultOrigin name first slot))
      ((set (PointwiseHandledUse first second user name) false)) :ruleset epilogue-index)
; A chunked scan's carry dispatch has published its scalar totals before the final pass.
(rule ((= (PointwiseHandledUse first second user (ValueNameRef value)) handled)
       (ResultOrigin (ValueNameRef value) first slot) (= (wyn-output-role first slot) (TotalOutput))
       (= (ValueType value) (ScalarInfo element)))
      ((set (PointwiseHandledUse first second user (ValueNameRef value)) true)
       (EpilogueRequiresCompletedTotal first second)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (DirectOperationUse second name) (ResultOrigin name first slot))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (= body (wyn-control-region second 0)) (FlowScopeAncestor body region)
       (EndDemand region name) (ResultOrigin name first slot))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-index)
(rule ((PointwiseRegionPrefix first second region operation) (= (PureOperation operation) true))
      ((PointwiseSafeOperation first second operation)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group) (= body (wyn-control-region second 0))
       (FlowScopeAncestor body region) (= region (wyn-region-of write)) (WritesInput write 0)
       (= (wyn-input write 0) (AccNameRef token)) (= (TokenCapability token) (TokenBindingAt owner group)))
      ((PointwiseSafeOperation first second write) (EffectCompare first second)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group) (= body (wyn-control-region second 0))
       (FlowScopeAncestor body region) (= region (wyn-region-of read)) (TotalIndex read))
      ((PointwiseSafeOperation first second read)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group) (OperationsConflict first second))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group)
       (OperationRead second resource) (OperationWrite second resource))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group)
       (= array (wyn-accumulator-backing owner group 0)) (OperationUse first (ValueNameRef array)))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (EpilogueOverwrite second owner group)
       (= array (wyn-accumulator-backing owner group 0)) (OperationUse second (ValueNameRef array)))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((PointwisePair first second) (= body (wyn-control-region second 0))
       (FlowScopeAncestor body region) (EmptyRegion region))
      ((PointwiseSafeRegion first second region)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (= body (wyn-control-region second 0))
       (FlowScopeAncestor body region) (FirstOperation region operation))
      ((PointwiseRegionPrefix first second region operation)) :ruleset epilogue-index)
(rule ((PointwiseRegionPrefix first second region operation)
       (PointwiseSafeOperation first second operation) (NextOperation operation next))
      ((PointwiseRegionPrefix first second region next)) :ruleset epilogue-index)
(rule ((PointwiseRegionPrefix first second region operation)
       (PointwiseSafeOperation first second operation) (LastOperation region operation))
      ((PointwiseSafeRegion first second region)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (BranchOperation operation)
       (= a (wyn-control-region operation 0)) (= b (wyn-control-region operation 1))
       (PointwiseSafeRegion first second a) (PointwiseSafeRegion first second b))
      ((PointwiseSafeOperation first second operation)) :ruleset epilogue-index)
(rule ((PointwisePair first second) (CountedLoopOperation operation)
       (= body (wyn-control-region operation 0)) (PointwiseSafeRegion first second body))
      ((PointwiseSafeOperation first second operation)) :ruleset epilogue-index)
(rule ((= (PointwiseHandledUse first second user name) false))
      ((set (PointwiseLegal first second) false)) :ruleset epilogue-legality)
(rule ((EpiloguePair first second)
       (EpilogueClauses first (wyn-result-count first)) (= body (wyn-control-region second 0))
       (PointwiseSafeRegion first second body) (PointwiseLoad first second load)
       (EpilogueDomainPrefix first second 1)
       (= (PointwiseLegal first second) true))
      ((ScanEpilogue first second)) :ruleset epilogue-select)

(rule ((EpiloguePair first second) (= (wyn-output-role first slot) (CompactedOutput))
       (= clause (wyn-output-clause first slot)) (FoldClause first clause kind)
       (ResultOrigin (ValueNameRef array) first slot) (= domain (wyn-iteration-domain second))
       (CountLength (wyn-domain-extent domain 0) array))
      ((PointwiseSource first second slot) (EpilogueDomainPrefix first second 1)) :ruleset epilogue-index)

; An epilogue may overwrite a prefix after its last read, at the same index.
(function EpilogueReuse (OperationKey ValueName) bool :merge (and old new))
(rule ((EpiloguePair first second) (PointwiseSource first second slot)
       (ResultOrigin (ValueNameRef array) first slot))
      ((set (EpilogueReuse second array) true)) :ruleset epilogue-index)
(rule ((= flag (EpilogueReuse second array))
       (DirectOperationUse user (ValueNameRef array)))
      ((set (ReuseReadSafe second array user) false)) :ruleset epilogue-index)
(rule ((= flag (EpilogueReuse second array))
       (LengthOperation user axis) (= (wyn-input user 0) (ValueNameRef array)))
      ((set (ReuseReadSafe second array user) true)) :ruleset epilogue-index)
(rule ((= flag (EpilogueReuse second array))
       (PointwiseLoad first second user) (= (wyn-input user 0) (ValueNameRef array)))
      ((set (ReuseReadSafe second array user) true)) :ruleset epilogue-index)
(rule ((= flag (EpilogueReuse second array))
       (= (ReuseReadSafe second array user) false))
      ((set (EpilogueReuse second array) false)) :ruleset epilogue-legality)
(rule ((= flag (EpilogueReuse second array)) (EndDemand region (ValueNameRef array)))
      ((set (EpilogueReuse second array) false)) :ruleset epilogue-legality)
(rule ((ScanEpilogue first second) (= (EpilogueReuse second array) true)
       (ResultOrigin (ValueNameRef output) second slot))
      ((CanReuse output array)) :ruleset epilogue-select)
