; Execution mapping for nested array programs. A selected map coordinate is
; uniform within its workgroup. Lexical control flow and direct calls inherit
; that scope; element callbacks introduce a new invocation scope.
; Dispatch builtins conservatively block group-uniform execution, as do
; recursive calls (region lowering requires a finite expansion).
; Uniformity here is conservative: every source term in an approved callback
; is uniform at its selected scope. Nested element callbacks are excluded from
; propagation. More precise value analysis can admit lane-dependent regions
; without changing the execution or storage representation.
; Eligibility is separate from selection: nested parallelism is the current
; profitability heuristic, not a new source operation or lowering recipe.
(ruleset execution-discover)
(ruleset execution-select)
(ruleset execution-finalize)
(function MapUsesWorkgroup (OperationKey) bool :merge (or old new))
(function RegionRecursive (RegionKey) bool :merge (or old new))
(function RegionLaneDependent (RegionKey) bool :merge (or old new))
(rule ((= region (RegionId i))) ((set (RegionLaneDependent region) false) (set (RegionRecursive region) false)) :ruleset execution-discover)
(relation DispatchBuiltin (String))
(DispatchBuiltin "_w_intrinsic_thread_id")
(DispatchBuiltin "_w_intrinsic_thread_id_y")
(DispatchBuiltin "_w_intrinsic_thread_id_z")
(DispatchBuiltin "_w_intrinsic_local_id")
(DispatchBuiltin "_w_intrinsic_num_workgroups")
(DispatchBuiltin "_w_intrinsic_workgroup_id")
(function ValueLaneDependent (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (ValueLaneDependent value) false)) :ruleset execution-discover)
(rule ((= name (SourceBuiltin value)) (DispatchBuiltin name))
      ((set (ValueLaneDependent value) true)) :ruleset execution-discover)
(rule ((SourceUse value child) (= (ValueLaneDependent child) true))
      ((set (ValueLaneDependent value) true)) :ruleset execution-discover)
(rule ((= (SourceCapture region formal) actual) (= (ValueLaneDependent actual) true))
      ((set (ValueLaneDependent formal) true) (set (RegionLaneDependent region) true)) :ruleset execution-discover)
(rule ((= value (SourceTerm region i)) (= (ValueLaneDependent value) true))
      ((set (RegionLaneDependent region) true)) :ruleset execution-discover)
(rule ((SourceRegionEnters region child) (= (RegionLaneDependent child) true))
      ((set (RegionLaneDependent region) true)) :ruleset execution-discover)
; Workgroup calls are expanded into the owning kernel, so recursive call
; graphs must retain invocation execution rather than recursively expanding.
(relation RegionCallReach (RegionKey RegionKey))
(rule ((SourceRegionEnters region child)) ((RegionCallReach region child)) :ruleset execution-discover)
(rule ((RegionCallReach region child) (SourceRegionEnters child descendant))
      ((RegionCallReach region descendant)) :ruleset execution-discover)
(rule ((RegionCallReach region region)) ((set (RegionRecursive region) true)) :ruleset execution-discover)
(rule ((SourceRegionEnters region child) (= (RegionRecursive child) true))
      ((set (RegionRecursive region) true)) :ruleset execution-discover)
(relation RegionHasParallelWork (RegionKey))
(rule ((RegionContainsCollective region)) ((RegionHasParallelWork region)) :ruleset execution-discover)
(rule ((SourceRegionEnters region child) (RegionHasParallelWork child))
      ((RegionHasParallelWork region)) :ruleset execution-discover)
(rule ((MapPlan plan owner extent)) ((set (MapUsesWorkgroup owner) false)) :ruleset execution-discover)
; Execution eligibility folds the selected traversal, including every entered
; region. Parallel work must remain inside a leaf, after rectangular flattening.
(relation GroupSafeTraversal (ParallelTraversal))
(relation ParallelTraversalWork (ParallelTraversal))
(rule ((= t (TraversalValue value))) ((GroupSafeTraversal t)) :ruleset execution-select)
(rule ((= t (TraversalResult value owner plan port extent)))
      ((GroupSafeTraversal t) (ParallelTraversalWork t)) :ruleset execution-select)
(relation TraversalRegion (ParallelTraversal RegionKey ParallelTraversal))
(rule ((= t (TraversalFor caller callee plan args next)))
      ((TraversalRegion t callee next)) :ruleset execution-discover)
(rule ((= t (TraversalCall value caller callee args next)))
      ((TraversalRegion t callee next)) :ruleset execution-discover)
(relation GroupSafeRegion (RegionKey))
(rule ((= (SourceReadOnly (FlowRegion region)) true)
       (= (RegionLaneDependent region) false) (= (RegionRecursive region) false))
      ((GroupSafeRegion region)) :ruleset execution-select)
(rule ((TraversalRegion t region next) (GroupSafeTraversal next) (GroupSafeRegion region))
      ((GroupSafeTraversal t)) :ruleset execution-select)
(rule ((= t (TraversalChoice condition yes a no b))
       (GroupSafeTraversal a) (GroupSafeTraversal b) (GroupSafeRegion yes) (GroupSafeRegion no)
       (= (ValueLaneDependent condition) false))
      ((GroupSafeTraversal t)) :ruleset execution-select)
(rule ((= t (TraversalChoice condition yes a no b)) (ParallelTraversalWork a) (ParallelTraversalWork b))
      ((ParallelTraversalWork t)) :ruleset execution-select)
(rule ((TraversalRegion t region (TraversalValue value)) (RegionHasParallelWork region))
      ((ParallelTraversalWork t)) :ruleset execution-select)
(rule ((TraversalRegion t region next) (ParallelTraversalWork next))
      ((ParallelTraversalWork t)) :ruleset execution-select)
(function WorkgroupOutputPrefix (FusionPlan) i64 :merge (max old new))
(rule ((MapPlan plan owner extent)) ((set (WorkgroupOutputPrefix plan) 0)) :ruleset execution-select)
(rule ((MapPlan plan owner extent) (= i (WorkgroupOutputPrefix plan))
       (= t (MapOutputTraversal owner i)) (GroupSafeTraversal t) (ParallelTraversalWork t))
      ((set (WorkgroupOutputPrefix plan) (+ i 1))) :ruleset execution-select)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= n (ArrayOutputs plan)) (> n 0)
       (= n (WorkgroupOutputPrefix plan))) ((set (MapUsesWorkgroup owner) true)) :ruleset execution-select)
; Width follows the remaining local computation, independent of map depth.
(function TraversalWidth (ParallelTraversal) i64 :merge (min old new))
(rule ((= t (TraversalValue value))) ((set (TraversalWidth t) 32)) :ruleset collective-costs)
(rule ((= t (TraversalResult value owner plan port extent))) ((set (TraversalWidth t) 256)) :ruleset collective-costs)
(rule ((TraversalRegion t region next) (= width (TraversalWidth next)))
      ((set (TraversalWidth t) width)) :ruleset collective-costs)
(rule ((= t (TraversalChoice condition yes a no b)) (= x (TraversalWidth a)) (= y (TraversalWidth b)))
      ((set (TraversalWidth t) (min x y))) :ruleset collective-costs)
(rule ((= traversal (MapOutputTraversal owner i)) (= width (TraversalWidth traversal)))
      ((set (MapWorkgroupWidth owner) width)) :ruleset collective-costs)
(rule ((= (SubgroupsEnabled) true) (= traversal (MapOutputTraversal owner i))
       (= extent (TraversalExtent traversal)) (= n (ConstantLogicalExtent extent)) (<= n 32))
      ((set (MapWorkgroupWidth owner) 32)) :ruleset collective-costs)
; Map scope is frozen after eligibility and selection reach a fixed point.
(rule ((= (MapUsesWorkgroup owner) true))
      ((set (MapExecution owner) (WorkgroupScope))) :ruleset execution-finalize)
(rule ((= (MapUsesWorkgroup owner) false))
      ((set (MapExecution owner) (InvocationScope))) :ruleset execution-finalize)

; These recipes have both invocation and workgroup implementations. Unsupported
; local recipes retain invocation execution even inside a workgroup region.
(function LocalSupportsWorkgroup (OperationKey) bool :merge (or old new))
(rule ((PlannedOperation original owner plan region))
      ((set (LocalSupportsWorkgroup owner) false)) :ruleset execution-discover)
(rule ((PlannedOperation original owner plan region) (= (PlanAction plan) (Publish)))
      ((set (LocalSupportsWorkgroup owner) true)) :ruleset execution-discover)
(rule ((PlannedOperation original owner plan region) (FilterPlan plan))
      ((set (LocalSupportsWorkgroup owner) true)) :ruleset execution-discover)

; Calls made inside a workgroup kernel retain lexical access to its shared
; resources, including calls from invocation-local element callbacks. Calls in
; invocation kernels also expand calls that pass owned arrays, exposing their
; accesses to local bufferization. Other calls retain the function ABI. This
; storage domain is independent of a local collective's execution scope.
(function InlineCall (RegionKey ExecutionScope) bool :no-merge)
(function RegionHasOwnedArrayParameter (RegionKey) bool :merge (or old new))
(rule ((= region (RegionId i)))
      ((set (RegionHasOwnedArrayParameter region) false)) :ruleset execution-discover)
(rule ((= formal (SourceParameter region i)) (= ty (SourceType formal))
       (SourceOwnedArrayType ty))
      ((set (RegionHasOwnedArrayParameter region) true)) :ruleset execution-discover)
(rule ((= actual (SourceCapture region formal)) (= ty (SourceType formal))
       (SourceOwnedArrayType ty))
      ((set (RegionHasOwnedArrayParameter region) true)) :ruleset execution-discover)
(rule ((= region (RegionId i)) (= (RegionRecursive region) false))
      ((set (InlineCall region (WorkgroupScope)) true)) :ruleset readout)
(rule ((= region (RegionId i)) (= (RegionHasOwnedArrayParameter region) false))
      ((set (InlineCall region (InvocationScope)) false)) :ruleset readout)
(rule ((= region (RegionId i)) (= (RegionRecursive region) true))
      ((set (InlineCall region (InvocationScope)) false)) :ruleset readout)
; Expose by-value array accesses to local bufferization instead of copying a
; complete array through the function ABI at each element callback.
(rule ((= (RegionHasOwnedArrayParameter region) true) (= (RegionRecursive region) false))
      ((set (InlineCall region (InvocationScope)) true)) :ruleset readout)

(rule ((= actual (SourceCapture region formal))
       (= (ValueRepresentation actual) (ArrayLayout count element)))
      ((set (RegionHasOwnedArrayParameter region) true)) :ruleset representations)
(rule ((= region (SourceCallTarget call)) (= actual (SourceCallArgument call i))
       (= formal (SourceParameter region i))
       (= (ValueRepresentation actual) (ArrayLayout count element)))
      ((set (RegionHasOwnedArrayParameter region) true)) :ruleset representations)

; Subgroups and indexed atomics share recognition of commutative reducers.
; Bypassing the callback must not discard trapping or effectful evaluation.
(function AtomicOperator (String) AtomicUpdate :no-merge)
(set (AtomicOperator "+") (AtomicAdd))
(set (AtomicOperator "&") (AtomicAnd))
(set (AtomicOperator "|") (AtomicOr))
(set (AtomicOperator "^") (AtomicXor))
(relation ReducerUpdate (RegionKey AtomicUpdate))
(rule ((= a (SourceParameter body i)) (= b (SourceParameter body j)) (< i 2) (< j 2) (!= i j)
       (= result (SourceResult body)) (SourceBinary result operator a b)
       (= update (AtomicOperator operator)) (= (SourceSpeculatable (FlowRegion body)) true))
      ((ReducerUpdate body update)) :ruleset execution-discover)
(rule ((= a (SourceParameter body 0)) (= b (SourceParameter body 1))
       (= result (SourceResult body)) (= result (SourceInvocation body function args))
       (= (vec-length args) 2) (= (vec-get args 0) a) (= (vec-get args 1) b)
       (= callee (SourceCallTarget result)) (ReducerUpdate callee update)
       (= (SourceSpeculatable (FlowRegion body)) true))
      ((ReducerUpdate body update)) :ruleset execution-discover)
(function HasReducerUpdate (RegionKey) bool :merge (or old new))
(rule ((= body (SourceOperatorBody op))) ((set (HasReducerUpdate body) false)) :ruleset execution-discover)
(rule ((ReducerUpdate body update)) ((set (HasReducerUpdate body) true)) :ruleset execution-discover)
(rule ((ReducerUpdate body update)) ((set (AtomicReducer body) update)) :ruleset execution-finalize)
(rule ((= (HasReducerUpdate body) false)) ((set (AtomicReducer body) (AtomicCas))) :ruleset execution-finalize)

; One execution proof folds every declaration in an update scope. Physical
; atomic selection belongs to the combiner, independently of the launch recipe.
(function UpdateArrayParallel (UpdateInitial UpdateMode) bool :merge (or old new))
(rule ((PlanUpdateArray plan i initial mode)) ((set (UpdateArrayParallel initial mode) false)) :ruleset execution-discover)
(rule ((PlanUpdateArray plan i initial (Overwrite))) ((set (UpdateArrayParallel initial (Overwrite)) true)) :ruleset execution-discover)
(rule ((PlanUpdateArray plan i initial (Adding))) ((set (UpdateArrayParallel initial (Adding)) true)) :ruleset execution-discover)
(rule ((PlanUpdateArray plan i initial (IdenticalWrites))) ((set (UpdateArrayParallel initial (IdenticalWrites)) true)) :ruleset execution-discover)
(rule ((PlanUpdateArray plan i (SeedArray source) (Combining body)) (= ty (SourceType source))
       (SourceArrayElement ty element) (SourcePrimitiveType element name) (AtomicScalarName name))
      ((set (UpdateArrayParallel (SeedArray source) (Combining body)) true)) :ruleset execution-discover)
(function UpdateSafety (FusionPlan i64) bool :no-merge)
(rule ((= (PlanUpdates plan) (WithUpdates arrays blocks)) (= (UpdateSafety plan (vec-length arrays)) false) (= owner (Owner plan)))
      ((set (ParallelBodySafe owner) false)) :ruleset execution-finalize)
(function UpdateStores (FusionPlan i64) bool :no-merge)
(rule ((= (PlanUpdates plan) (WithUpdates arrays blocks)))
      ((set (UpdateSafety plan 0) true) (set (UpdateStores plan 0) true)) :ruleset execution-finalize)
(rule ((PlanUpdateArray plan i initial mode) (= safe (UpdateSafety plan i)) (= valid (UpdateArrayParallel initial mode)))
      ((set (UpdateSafety plan (+ i 1)) (and safe valid))) :ruleset execution-finalize)
(rule ((PlanUpdateArray plan i initial (Overwrite)) (= stores (UpdateStores plan i)))
      ((set (UpdateStores plan (+ i 1)) stores)) :ruleset execution-finalize)
(rule ((PlanUpdateArray plan i initial mode) (!= mode (Overwrite)))
      ((set (UpdateStores plan (+ i 1)) false)) :ruleset execution-finalize)
(rule ((= (PlanUpdates plan) (WithUpdates arrays blocks)) (= (UpdateStores plan (vec-length arrays)) true) (= owner (Owner plan)))
      ((StoreUpdates owner) (set (LocalSupportsWorkgroup owner) true)) :ruleset execution-finalize)
(relation SubgroupAddition (RegionKey))
(rule ((= (SubgroupsEnabled) true) (= body (SourceOperatorBody op)) (ReducerUpdate body (AtomicAdd))
       (= neutral (SourceNeutral op)) (= ty (SourceType neutral)) (SourceSubgroupScalar ty))
      ((SubgroupAddition body)) :ruleset execution-discover)

; Local recipes are selected for each calling scope. The same helper can be
; reached from a group-uniform call and an invocation-local element callback.
(rule ((DeviceOperation op) (= plan (SelectedPlan op)) (= (PlanBody plan) (ParallelLoop domain totals scans arrays action)))
      ((set (LocalExecution op (InvocationScope)) (InvocationScope))) :ruleset schedule)
(rule ((DeviceOperation op) (= plan (SelectedPlan op)) (= (PlanBody plan) (ParallelLoop domain totals scans arrays action)) (= (LocalSupportsWorkgroup op) true))
      ((set (LocalExecution op (WorkgroupScope)) (WorkgroupScope))) :ruleset schedule)
(rule ((DeviceOperation op) (= plan (SelectedPlan op)) (= (PlanBody plan) (ParallelLoop domain totals scans arrays action)) (= (LocalSupportsWorkgroup op) false))
      ((set (LocalExecution op (WorkgroupScope)) (InvocationScope))) :ruleset schedule)
