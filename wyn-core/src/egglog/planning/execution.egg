; Logical result clauses determine kernel algorithms and launch requirements.
(ruleset execution-features)
(ruleset execution-atomics)
(ruleset execution-policy)
(ruleset execution-select)
(relation EmittedDispatch (OperationKey))
(function ReturnOnlyCollection (ValueName) bool :merge (and old new))
(rule ((= (EntryOrder function) order) (= root (FunctionRoot function))
       (= (RegionYield root slot) (ValueNameRef name))
       (= (Defines (ValueNameRef name)) (OperationSite operation result)) (= root (OperationRegion operation))
       (EmittedDispatch operation) (= (OutputRole operation result) (CollectedOutput)))
      ((set (ReturnOnlyCollection name) true)) :ruleset execution-features)
(rule ((= known (ReturnOnlyCollection name)) (OperationUse operation (ValueNameRef name)))
      ((set (ReturnOnlyCollection name) false)) :ruleset execution-features)
(relation EntryHasDeviceDispatch (FunctionName))
(rule ((EmittedDispatch operation) (= region (OperationRegion operation))
       (FlowScopeAncestor root region) (= (FunctionRoot function) root))
      ((EntryHasDeviceDispatch function)) :ruleset execution-features)
(relation HostInputLength (ValueName))
(rule ((= (GeneratedDispatches) true) (EntryHasDeviceDispatch function) (= root (FunctionRoot function))
       (= (RegionParameter root slot) (ValueNameRef name)) (LiveOperation operation)
       (StorageValue name) (DirectOperationUse operation (ValueNameRef name)))
      ((HostInputLength name)) :ruleset execution-features)
(function ParallelPublicationWidth (FunctionName) i64 :no-merge)
(rule ((= (EntryOrder function) order) (= (GeneratedDispatches) true)
       (= (InvocationEntry function) false) (= (LaneDependentFunction function) false))
      ((set (ParallelPublicationWidth function) 128)) :ruleset execution-features)
(function KernelFold (OperationKey) bool :merge (or old new))
(function KernelContribution (OperationKey) bool :merge (or old new))
(function KernelCompact (OperationKey bool) bool :merge (or old new))
(function KernelPredicated (OperationKey) bool :merge (or old new))
(function KernelOrdered (OperationKey bool) bool :merge (or old new))
(function KernelCanCompact (OperationKey) bool :merge (or old new))
(relation NativeClausePrefix (OperationKey i64))
(relation NativeNeutralPrefix (OperationKey i64 i64))
(relation UseNativeSubgroups (OperationKey))
(rule ((= revision (AnalysisRevision)) (= payload (NativeBinaryReducer region)) (AdditionPayload payload))
      ((NativeAddition region)) :ruleset execution-features)
(rule ((= revision (AnalysisRevision)) (BinaryReducer region payload) (AdditionPayload payload)
       (= (RegionParameter region 0) (ValueNameRef name)) (= (ValueType name) (ScalarInfo (ScalarElement (F32)))))
      ((NativeAddition region)) :ruleset execution-features)
(datatype KernelAlgorithm (ParallelKernel) (OrderedKernel) (CompactionKernel))
; Each recipe is indexed by atomic support of its concrete array bindings.
(function SelectedKernelAlgorithm (OperationKey bool) KernelAlgorithm :no-merge)
(datatype LaunchGrouping (SingleGroup) (ElementGroups) (WorkgroupGroups))
(function SelectedLaunchGrouping (OperationKey bool) LaunchGrouping :no-merge)
(function LaunchRank (OperationKey) i64 :no-merge)
(function LaunchMinimum (OperationKey bool bool) i64 :no-merge)
; LaunchMinimum's last argument means the dispatch has no public outputs.
(relation AtomicSupport (bool))
(AtomicSupport false) (AtomicSupport true)
(relation DispatchInRegion (RegionKey))
(function WorkgroupMapSafe (OperationKey) bool :merge (and old new))
(function WorkgroupMap (OperationKey) bool :merge (or old new))
(relation WorkgroupMapCandidate (OperationKey OperationKey))
(relation WorkgroupMapRegion (OperationKey RegionKey))
(relation WorkgroupCollective (OperationKey))
(relation WorkgroupScanCandidate (OperationKey OperationKey OperationKey i64))
(relation WorkgroupLoopScan (OperationKey OperationKey RegionKey OperationKey i64))
(function WorkgroupLoopSafe (OperationKey) bool :merge (and old new))
(function WorkgroupLocalWrite (OperationKey Resource) bool :merge (or old new))
(function WorkgroupWriteStatement (OperationKey OperationKey) bool :merge (or old new))
(function WorkgroupOrderedStatement (OperationKey OperationKey) bool :merge (or old new))
(function WorkgroupLoopArray (ValueName) i64 :no-merge)
(function WorkgroupCarryArray (OperationKey i64 LogicalPath) bool :merge (or old new))
(function WorkgroupScanScalar (OperationKey ValueName) bool :merge (or old new))
(relation WorkgroupAccumulatorCandidate (OperationKey OperationKey RegionKey))
(function WorkgroupAccumulatorTarget (OperationKey ValueName) bool :merge (or old new))
(datatype WorkgroupStorageRole
  (LoopConditionStorage) (LoopCarryStorage i64 LogicalPath)
  (ScanStorage) (ScanScratch i64) (AccumulatorStorage i64 i64))
(relation WorkgroupStorageRequest (OperationKey OperationKey WorkgroupStorageRole BigInt))
(function WorkgroupStorageBytes (OperationKey) i64 :no-merge)
(relation WorkgroupLoop (OperationKey))
(relation WorkgroupLoopMap (OperationKey))
(relation WorkgroupAccumulator (OperationKey))
(function WorkgroupScan (OperationKey) i64 :no-merge)
(function WorkgroupMapSuffix (OperationKey) OperationKey :no-merge)
(function WorkgroupMapWidth (OperationKey) i64 :no-merge)
(relation ChunkClausePrefix (OperationKey i64))
(function ChunkScan (OperationKey) bool :merge (or old new))
(relation PrefixFoldKind (FoldKind))
(PrefixFoldKind (InclusiveScan)) (PrefixFoldKind (ExclusiveScan))
(PrefixFoldKind (InclusiveScanAndTotal)) (PrefixFoldKind (ExclusiveScanAndTotal))
(function ChunkGuarded (OperationKey) bool :merge (or old new))
(relation CanChunkCollective (OperationKey))
(rule ((EmittedDispatch operation) (CanChunkCollective operation) (= body (ControlRegion operation 0)))
      ((RegionWorkDemand body)) :ruleset execution-features)
(rule ((EmittedDispatch operation) (CanChunkCollective operation) (= reducer (ResultReducer operation clause)))
      ((RegionWorkDemand reducer)) :ruleset execution-features)
(function LoopStatePreserved (OperationKey i64) bool :merge (and old new))
(relation FixedLoopState (OperationKey i64 ValueName))
(rule ((LoopValueCarry operation slot carried initial next))
      ((set (LoopStatePreserved operation slot) true)) :ruleset execution-features)
(rule ((= (LoopComponentPreserved operation slot path) false))
      ((set (LoopStatePreserved operation slot) false)) :ruleset execution-features)
(rule ((LoopValueCarry operation slot carried initial next) (LoopPreservesOuterLength operation slot))
      ((FixedLoopState operation slot initial)) :ruleset execution-atomics)
(rule ((LoopValueCarry operation slot carried initial next) (LoopHasArrayComponents operation slot) (= (LoopStatePreserved operation slot) true))
      ((FixedLoopState operation slot initial)) :ruleset execution-atomics)

(rule ((EmittedDispatch operation) (= region (OperationRegion operation)) (FlowScopeAncestor ancestor region))
      ((DispatchInRegion ancestor)) :ruleset execution-features)
; A group can traverse one map coordinate when every lane can run its setup.
; This lets the reduction's bound depend on the row without involving the host.
(rule ((EmittedDispatch outer) (= (OperationExecution outer) (DeviceKernel (AutomaticGrid)))
       (= body (ControlRegion outer 0)) (= (ResultCount outer) 1) (= (ResultKindOf outer 0) (Collected)))
      ((WorkgroupMapRegion outer body)) :ruleset execution-features)
(rule ((WorkgroupMapRegion outer parent) (= parent (OperationRegion branch)) (BranchOperation branch)
       (= body (ControlRegion branch edge)))
      ((WorkgroupMapRegion outer body)) :ruleset execution-features)
(rule ((WorkgroupMapRegion outer parent) (= parent (OperationRegion loop)) (CountedLoopOperation loop)
       (= body (ControlRegion loop 0)))
      ((WorkgroupMapRegion outer body)) :ruleset execution-features)
(rule ((WorkgroupMapRegion outer parent) (= parent (OperationRegion inner))
       (= (OperationExecution inner) (InvocationLocal)) (= (ResultCount inner) 1) (= (ResultKindOf inner 0) (Collected))
       (= body (ControlRegion inner 0)))
      ((WorkgroupMapRegion outer body)) :ruleset execution-features)
(rule ((WorkgroupMapRegion outer body) (= body (OperationRegion inner))
       (= (OperationExecution inner) (InvocationLocal)) (= (ResultCount inner) 1)
       (= (ResultKindOf inner 0) (Folded (Total))) (= (OutputCount inner) 1)
       (= domain (OperationDomain inner)) (= (DomainRank domain) 1)
       (= (Output inner 0) (ValueNameRef result))
       (= (ValueType result) (ScalarInfo element)))
      ((WorkgroupMapCandidate outer inner) (set (WorkgroupMapSafe outer) true)) :ruleset execution-features)
; Keep a bounded prefix in shared storage until its pointwise consumer finishes.
(rule ((EmittedDispatch outer) (= (OperationExecution outer) (DeviceKernel (AutomaticGrid)))
       (= body (ControlRegion outer 0)) (LastOperation body post) (ScanEpilogue scan post)
       (= (OperationExecution scan) (InvocationLocal)) (= (ResultCount scan) 1) (= (OutputCount scan) 1)
       (= (OutputRole scan 0) (PrefixOutput)) (= (ResultValueCount scan 0) 1)
       (= (ResultCount outer) 1) (= (ResultKindOf outer 0) (Collected)) (= (ResultValueCount outer 0) 1)
       (= (OutputCount post) 1) (= result (Output post 0)) (= result (ResultValue outer 0 0))
       (= (ResultValue scan 0 0) (ValueNameRef element)) (= (ValueType element) (ScalarInfo primitive))
       (= domain (OperationDomain scan)) (= n (StaticIndex (DomainExtent domain 0))) (> n 0) (<= n 1024))
      ((WorkgroupMapCandidate outer scan) (set (WorkgroupMapSafe outer) true)
       (WorkgroupScanCandidate outer scan post n)) :ruleset execution-features)
(rule ((WorkgroupMapCandidate outer inner) (InvocationDependent outer))
      ((set (WorkgroupMapSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupMapCandidate outer inner) (OperationWrite outer resource))
      ((set (WorkgroupMapSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupMapCandidate outer inner) (OperationTrap outer))
      ((set (WorkgroupMapSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupMapCandidate outer inner) (ConsumedToken outer token))
      ((set (WorkgroupMapSafe outer) false)) :ruleset execution-features)

; The enclosing lane region executes one coordinate per workgroup. The while
; body is group-wide, but callbacks of its scans still execute per lane.
(rule ((EmittedDispatch outer) (= (OperationExecution outer) (DeviceKernel (AutomaticGrid)))
       (= (DomainRank (OperationDomain outer)) 1)
       (= (ResultCount outer) 1) (= (ResultKindOf outer 0) (Collected))
       (= parent (ControlRegion outer 0)) (= parent (OperationRegion loop))
       (WhileLoopOperation loop) (= body (ControlRegion loop 0))
       (= body (OperationRegion scan)) (= (OperationExecution scan) (InvocationLocal))
       (= (OutputRole scan slot) (PrefixOutput))
       (= domain (OperationDomain scan)) (= (DomainRank domain) 1)
       (= size (StaticIndex (DomainExtent domain 0))) (> size 0))
      ((WorkgroupLoopScan outer loop body scan size)
       (set (WorkgroupLoopSafe outer) true)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (InvocationDependent outer))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (KernelPredicated outer) true))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (KernelPredicated scan) true))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (KernelContribution scan) true))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (ResultKindOf scan clause) (Compacted)))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (ResultValue scan clause field) (ValueNameRef name)))
      ((set (WorkgroupScanScalar scan name) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (ResultNeutral scan clause field) (ValueNameRef name)))
      ((set (WorkgroupScanScalar scan name) false)) :ruleset execution-features)
(rule ((= (WorkgroupScanScalar scan name) known) (= (ValueType name) (ScalarInfo (ScalarElement type))))
      ((set (WorkgroupScanScalar scan name) true)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (WorkgroupScanScalar scan name) false))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-atomics)
(rule ((WorkgroupLoopScan outer loop body scan size) (WorkgroupMapCandidate outer other))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (WorkgroupLoopScan outer other other-body other-scan other-size)
       (!= loop other))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
; Ordered bounds checks and structural while control retain their lane masks
; and ordering. Other unclassified ordered operations cannot be replicated.
(rule ((WorkgroupLoopScan outer loop body scan size) (= map (ControlRegion outer 0))
       (OrderedOperation operation) (OperationTrap operation)
       (= region (OperationRegion operation)) (FlowScopeAncestor map region))
      ((set (WorkgroupOrderedStatement outer operation) false)) :ruleset execution-features)
(rule ((= (WorkgroupOrderedStatement outer operation) known) (IndexOperation operation))
      ((set (WorkgroupOrderedStatement outer operation) true)) :ruleset execution-features)
(rule ((= (WorkgroupOrderedStatement outer operation) known) (WhileLoopOperation operation))
      ((set (WorkgroupOrderedStatement outer operation) true)) :ruleset execution-features)
(rule ((= (WorkgroupOrderedStatement outer operation) false))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-atomics)

(rule ((= (WorkgroupAccumulatorTarget accumulator name) known)
       (= (ValueType name) (LogicalValue (ArrayType ownership extents (ElementValue (ScalarElement type)))))
       (= (vec-length extents) 1) (= (vec-get extents 0) (FixedExtent size))
       (>= size 0))
      ((set (WorkgroupLoopArray name) size)) :ruleset execution-features)
(rule ((= (WorkgroupAccumulatorTarget accumulator name) known)
       (= (ValueType name) (LogicalValue (ArrayType ownership extents (ElementValue (ScalarElement type)))))
       (= (vec-length extents) 1) (= (vec-get extents 0) (UnspecifiedExtent))
       (= size (StaticIndex (LogicalOuterCount name))) (>= size 0))
      ((set (WorkgroupLoopArray name) size)) :ruleset execution-features)

(rule ((WorkgroupLoopScan outer loop body scan size) (LoopFieldType loop slot path (ArrayType ownership extents element)))
      ((set (WorkgroupCarryArray loop slot path) false)) :ruleset execution-features)
(rule ((= (WorkgroupCarryArray loop slot path) known)
       (LoopFieldType loop slot path (ArrayType ownership extents (ElementValue (ScalarElement type))))
       (= (vec-length extents) 1))
      ((set (WorkgroupCarryArray loop slot path) true)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (WorkgroupCarryArray loop slot path) false))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-atomics)

; Include all scratch in the portable workgroup budget, before SSA can reuse it.
; Eight bytes covers widened scalar slots. Carries reserve old and new storage.
(rule ((WorkgroupLoopScan outer loop body scan size))
      ((WorkgroupStorageRequest outer loop (LoopConditionStorage) (bigint 8))) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (WorkgroupCarryArray loop slot path) true)
       (= bytes (LoopFieldBytes loop slot path)))
      ((WorkgroupStorageRequest outer loop (LoopCarryStorage slot path)
         (max (bigint 16) (* (bigint 8) bytes)))) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= count (OutputCount scan)))
      ((WorkgroupStorageRequest outer scan (ScanStorage) (* (bigint 8) (* (bigint size) (bigint count))))) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (ResultKindOf scan clause) (Folded kind))
       (= count (ResultNeutralCount scan clause)))
      ((WorkgroupStorageRequest outer scan (ScanScratch clause) (* (bigint 2048) (bigint count)))) :ruleset execution-features)

(rule ((WorkgroupLoopScan outer loop body scan size) (AccumulatorOperation accumulator)
       (= body (OperationRegion accumulator)) (= region (ControlRegion accumulator 0)))
      ((WorkgroupAccumulatorCandidate outer accumulator region)) :ruleset execution-features)
(rule ((WorkgroupAccumulatorCandidate outer accumulator region) (= name (AccumulatorArray accumulator group slot)))
      ((set (WorkgroupAccumulatorTarget accumulator name) false)) :ruleset execution-features)
(rule ((WorkgroupAccumulatorCandidate outer accumulator region) (= name (AccumulatorArray accumulator group slot))
       (= size (WorkgroupLoopArray name)))
      ((set (WorkgroupAccumulatorTarget accumulator name) true)
       (WorkgroupStorageRequest outer accumulator (AccumulatorStorage group slot) (* (bigint 8) (bigint (max size 1))))) :ruleset execution-features)
(rule ((WorkgroupAccumulatorCandidate outer accumulator region) (= (RegionYield region slot) (ValueNameRef name)))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-features)
(rule ((WorkgroupAccumulatorCandidate outer accumulator region)
       (= (WorkgroupAccumulatorTarget accumulator name) false))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-atomics)

; Only private setup before the loop and ordered accumulator bodies may write.
(rule ((WorkgroupLoopScan outer loop body scan size) (= map (ControlRegion outer 0))
       (WritesInput write slot) (= region (OperationRegion write)) (FlowScopeAncestor map region))
      ((set (WorkgroupWriteStatement outer write) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (= map (ControlRegion outer 0))
       (WritesInput write slot) (= map (OperationRegion write))
       (< (OperationOrder write) (OperationOrder loop)))
      ((set (WorkgroupWriteStatement outer write) true)) :ruleset execution-features)
(rule ((WorkgroupAccumulatorCandidate outer accumulator region)
       (WritesInput write slot) (= child (OperationRegion write)) (FlowScopeAncestor region child))
      ((set (WorkgroupWriteStatement outer write) true)) :ruleset execution-features)
(rule ((= (WorkgroupWriteStatement outer write) false))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-atomics)
(rule ((WorkgroupLoopScan outer loop body scan size) (OperationWrite outer resource))
      ((set (WorkgroupLocalWrite outer resource) false)) :ruleset execution-features)
(rule ((WorkgroupLoopScan outer loop body scan size) (OperationWrite outer (FreshResource name))
       (= parent (ControlRegion outer 0)) (DefinitionRegion name owner)
       (FlowScopeAncestor parent owner))
      ((set (WorkgroupLocalWrite outer (FreshResource name)) true)) :ruleset execution-features)
(rule ((= (WorkgroupLocalWrite outer resource) false))
      ((set (WorkgroupLoopSafe outer) false)) :ruleset execution-atomics)
; Publish the destinations of a shared histogram traversal together.
(relation AtomicInitialization (OperationKey))
(rule ((EmittedDispatch operation) (= (ResultKindOf operation clause) (Contributed))
       (= (ResultValue operation clause field) (AccNameRef token))
       (= (TokenCapability token) (TokenBindingAt owner group)) (AtomicAccumulatorArray owner group array)
       (> (AccumulatorGroupCount owner) 1)
       (= combine (AccumulatorCombiner owner group)) (= (RetrySafe combine) true))
      ((AtomicInitialization owner)) :ruleset execution-features)
(rule ((LiveOperation operation) (ParallelOperation operation))
      ((ChunkClausePrefix operation 0) (set (ChunkScan operation) false) (set (ChunkGuarded operation) false)) :ruleset execution-features)
(rule ((ChunkClausePrefix operation clause) (= (ResultKindOf operation clause) (Collected)))
      ((ChunkClausePrefix operation (+ clause 1))) :ruleset execution-features)
(rule ((ChunkClausePrefix operation clause) (= (ResultKindOf operation clause) (Folded kind))
       (= reducer (ResultReducer operation clause)) (= (RetrySafe reducer) true))
      ((ChunkClausePrefix operation (+ clause 1))) :ruleset execution-features)
(rule ((= (ResultKindOf operation clause) (Folded kind)) (PrefixFoldKind kind))
      ((set (ChunkScan operation) true)) :ruleset execution-features)
(rule ((= (ResultKindOf operation clause) (Folded kind)) (= predicate (ResultPredicate operation clause)))
      ((set (ChunkGuarded operation) true)) :ruleset execution-features)
(rule ((ChunkClausePrefix operation (ResultCount operation)) (= (ChunkGuarded operation) false))
      ((CanChunkCollective operation)) :ruleset execution-atomics)

(rule ((LiveOperation operation) (ParallelOperation operation))
      ((set (KernelFold operation) false) (set (KernelContribution operation) false)
       (set (KernelPredicated operation) false) (set (KernelCanCompact operation) false)
       (NativeClausePrefix operation 0)) :ruleset execution-features)
(rule ((LiveOperation operation) (ParallelOperation operation) (AtomicSupport atomic))
      ((set (KernelCompact operation atomic) false) (set (KernelOrdered operation atomic) false)) :ruleset execution-features)
(rule ((= (ResultKindOf operation clause) (Folded kind)))
      ((set (KernelFold operation) true) (NativeNeutralPrefix operation clause 0)) :ruleset execution-features)
(rule ((= (ResultKindOf operation clause) (Compacted)) (AtomicSupport atomic))
      ((set (KernelCompact operation atomic) true)) :ruleset execution-features)
(rule ((= (ResultKindOf operation clause) (Contributed)))
      ((set (KernelContribution operation) true)) :ruleset execution-features)
(rule ((= predicate (ResultPredicate operation clause)))
      ((set (KernelPredicated operation) true)) :ruleset execution-features)
(rule ((NativeNeutralPrefix operation clause slot) (< slot (ResultNeutralCount operation clause))
       (= neutral (ResultNeutral operation clause slot)) (= (ConstantValue neutral) 0))
      ((NativeNeutralPrefix operation clause (+ slot 1))) :ruleset execution-features)
(rule ((NativeClausePrefix operation clause) (< clause (ResultCount operation))
       (= kind (ResultKindOf operation clause)) (!= kind (Folded (Total)))
       (!= kind (Folded (InclusiveScan))) (!= kind (Folded (ExclusiveScan))))
      ((NativeClausePrefix operation (+ clause 1))) :ruleset execution-features)
(rule ((NativeClausePrefix operation clause) (= (ResultKindOf operation clause) (Folded kind))
       (= reducer (ResultReducer operation clause)) (NativeAddition reducer)
       (NativeNeutralPrefix operation clause (ResultNeutralCount operation clause)))
      ((NativeClausePrefix operation (+ clause 1))) :ruleset execution-features)
(rule ((NativeClausePrefix operation (ResultCount operation)) (= (KernelFold operation) true) (= (SubgroupsEnabled) true))
      ((UseNativeSubgroups operation)) :ruleset execution-features)

(rule ((= (KernelContribution operation) true))
      ((set (KernelCompact operation false) true)) :ruleset execution-policy)
(rule ((EmittedDispatch operation)) ((set (WorkgroupMap operation) false)) :ruleset execution-policy)
(rule ((WorkgroupMapCandidate outer inner) (= (WorkgroupMapSafe outer) true))
      ((set (WorkgroupMap outer) true) (WorkgroupCollective inner)) :ruleset execution-policy)
(rule ((WorkgroupScanCandidate outer scan post size) (= (WorkgroupMap outer) true))
      ((set (WorkgroupScan scan) size) (set (WorkgroupMapSuffix outer) post)
       (set (WorkgroupMapWidth outer) 256)) :ruleset execution-policy)
(rule ((WorkgroupLoopScan outer loop body scan size) (= (WorkgroupLoopSafe outer) true)
       (= bytes (LoopStateBytes loop (OutputCount loop))) (<= (WorkgroupStorageBytes outer) 16384))
      ((set (WorkgroupMap outer) true) (WorkgroupLoop loop)
       (WorkgroupLoopMap outer) (WorkgroupCollective scan) (set (WorkgroupScan scan) size)) :ruleset execution-policy)
(rule ((WorkgroupLoopScan outer loop body scan size) (WorkgroupLoop loop)
       (WorkgroupAccumulatorCandidate outer accumulator region) (= body (OperationRegion accumulator)))
      ((WorkgroupAccumulator accumulator)) :ruleset execution-policy)
(rule ((= (KernelCompact operation atomic) true)) ((set (KernelOrdered operation atomic) true)) :ruleset execution-policy)
(rule ((= (KernelPredicated operation) true) (AtomicSupport atomic)) ((set (KernelOrdered operation atomic) true)) :ruleset execution-policy)
(rule ((EmittedDispatch operation) (= (KernelFold operation) false) (= (KernelContribution operation) false)
       (= domain (OperationDomain operation)) (= (DomainRank domain) 1))
      ((set (KernelCanCompact operation) true)) :ruleset execution-policy)
(rule ((EmittedDispatch operation) (= domain (OperationDomain operation)) (= rank (DomainRank domain)) (= (KernelFold operation) true))
      ((set (LaunchRank operation) (- rank 1))) :ruleset execution-policy)
(rule ((EmittedDispatch operation) (= domain (OperationDomain operation)) (= rank (DomainRank domain)) (= (KernelFold operation) false))
      ((set (LaunchRank operation) rank)) :ruleset execution-policy)
(rule ((EmittedDispatch operation) (= (KernelCompact operation atomic) true))
      ((set (SelectedLaunchGrouping operation atomic) (SingleGroup))) :ruleset execution-select)
(rule ((EmittedDispatch operation) (= (KernelCompact operation atomic) false) (= (KernelFold operation) true))
      ((set (SelectedLaunchGrouping operation atomic) (ElementGroups))) :ruleset execution-select)
(rule ((EmittedDispatch operation) (= (KernelCompact operation atomic) false) (= (KernelFold operation) false)
       (= (WorkgroupMap operation) true))
      ((set (SelectedLaunchGrouping operation atomic) (ElementGroups))) :ruleset execution-select)
(rule ((EmittedDispatch operation) (= (KernelCompact operation atomic) false) (= (KernelFold operation) false)
       (= (WorkgroupMap operation) false))
      ((set (SelectedLaunchGrouping operation atomic) (WorkgroupGroups))) :ruleset execution-select)
; Empty intermediate launches must still publish descriptor witnesses.
(rule ((EmittedDispatch operation) (AtomicSupport atomic))
      ((set (LaunchMinimum operation atomic true) 1)) :ruleset execution-select)
(rule ((EmittedDispatch operation) (= (KernelCompact operation atomic) true))
      ((set (LaunchMinimum operation atomic false) 1)) :ruleset execution-select)
(rule ((EmittedDispatch operation) (= (KernelCompact operation atomic) false))
      ((set (LaunchMinimum operation atomic false) 0)) :ruleset execution-select)
(rule ((= (KernelOrdered operation atomic) false))
      ((set (SelectedKernelAlgorithm operation atomic) (ParallelKernel))) :ruleset execution-select)
(rule ((= (KernelOrdered operation atomic) true) (= (KernelCanCompact operation) false))
      ((set (SelectedKernelAlgorithm operation atomic) (OrderedKernel))) :ruleset execution-select)
(rule ((= (KernelOrdered operation atomic) true) (= (KernelCanCompact operation) true))
      ((set (SelectedKernelAlgorithm operation atomic) (CompactionKernel))) :ruleset execution-select)
