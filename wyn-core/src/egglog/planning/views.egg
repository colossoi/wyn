; Storage identity travels with a view, including loop state and element updates.
(function InputShapeBuffer (RegionKey BindingKey) ValueKey :no-merge)
(function InputShapeIndex (RegionKey i64) i64 :no-merge)
(relation InputShapeSource (ValueKey i64 InputStorage))
(function LoopViewStorage (SourceValue) ValueKey :no-merge)
(rule ((= (LoopBoundaryLayout value) (ViewLayout resource element)))
      ((set (LoopViewStorage value) resource)) :ruleset residency)
(rule ((= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= (LoopBoundaryLayout value) (ValueLayout ty)) (SourceViewType ty)
       (= resource (ArrayStorage initial)))
      ((set (LoopViewStorage value) resource)) :ruleset residency)
(rule ((AllowGeneratedTopology) (SourceOriginalEntry owner region true) (= value (SourceParameter region index))
       (= ordinal (SourceOrdinal value)) (= (AbiStorage value) (StorageInput binding stride))
       (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (InputShapeBuffer region binding) (Metadata owner))
       (set (InputShapeIndex region index) (* ordinal 2))
       (set (MetadataCount owner) (+ (* ordinal 2) 1))
       (InputShapeSource (Metadata owner) (* ordinal 2) (StorageInput binding stride))) :ruleset planning-import)
(rule ((ParameterValue value) (= ty (SourceType value)) (SourceArrayElement ty element) (= (AbiStorage value) (StorageInput binding stride))
       (= extent (ViewExtent value)))
      ((set (ArrayStorage value) (Source value))) :ruleset residency)
(rule ((= (ValueRead value) (ReadView resource)) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (ArrayStorage value) resource)) :ruleset residency)
(rule ((ForwardValue value original) (!= value original) (= resource (ArrayStorage original)))
      ((set (ArrayStorage value) resource) (set (DerivedView value) true)) :ruleset residency)
(rule ((SourceResultOperand value index original) (= ty (SourceType value)) (SourceArrayElement ty element) (= resource (ArrayStorage original)))
      ((set (ArrayStorage value) resource) (set (DerivedView value) true)) :ruleset residency)
(rule ((= (SourceSlice value) (SliceInfo original start end)) (= resource (ArrayStorage original)))
      ((set (ArrayStorage value) resource) (set (DerivedView value) true)) :ruleset residency)
(rule ((= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= (SourceLoop value) (LoopInfo header iteration))
       (= op (SourceValueOperation value)) (= (ContainsCollective op) false)
       (= resource (LoopViewStorage value)))
      ((set (ArrayStorage state) resource)) :ruleset residency)
(rule ((= (SourceLoop value) (LoopInfo header iteration))
       (= op (SourceValueOperation value)) (= (ContainsCollective op) false)
       (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= resource (LoopViewStorage value)))
      ((set (ArrayStorage value) resource)
       (ChildValue value initial)) :ruleset residency)

; Owned loop state must not overwrite another live reference to its initializer.
(rule ((= (LoopBoundaryLayout value) (ViewLayout (LoopStorage value) element))
       (= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= next (SourceResult iteration)))
      ((set (Backing (LoopStorage value)) (LoopStorage value))
       (set (CapacityExtent (LoopStorage value)) (Length initial))
       (ElementType (LoopStorage value) element) (Allocation (LoopStorage value) (Length initial))) :ruleset allocation)
; Select backedge obligations only after the length-preservation proof settles.
(ruleset capacity-bounds)
(rule ((= (LoopBoundaryLayout value) (ViewLayout (LoopStorage value) element))
       (= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial)))
      ((set (AllocationBounds (LoopStorage value)) (set-of (Length initial)))) :ruleset capacity-bounds)
(rule ((= (LoopBoundaryLayout value) (ViewLayout (LoopStorage value) element))
       (= (SourceLoop value) (LoopInfo header iteration)) (= next (SourceResult iteration))
       (= (LoopPreservesLength value) false))
      ((set (AllocationBounds (LoopStorage value)) (set-of (Length next)))) :ruleset capacity-bounds)
(rule ((= (LoopOwnsView value) true) (= (SourceLoop value) (LoopInfo header iteration))
       (= (SourceLoopInitial header) (LoopInitialInfo state initial)))
      ((set (ValueRef state) (LoopStorage value))) :ruleset residency)
(rule ((= (LoopBoundaryLayout value) (ViewLayout (LoopStorage value) element))
       (= value (SourceTerm region ordinal)) (OwnedRegion owner region))
      ((set (AllocationOwner (LoopStorage value)) owner)) :ruleset physical-abi)
(rule ((= (LoopBoundaryLayout value) (ViewLayout (LoopStorage value) element)) (= (HasViewStage value) false)
       (= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial)))
      ((set (LiveLength (LoopStorage value)) (Length initial))) :ruleset residency)

; Joins carry their selected length in the descriptor and use a common binding.
(rule ((= (RuntimeArrayJoin value) true)
       (= (SourceBranch value) (BranchInfo condition yes no))
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((ChildValue value condition) (ChildValue value a) (ChildValue value b)
       (set (ArrayStorage value) (Source value))
       (set (ValueRef value) (Source value))
       (set (Backing (Source value)) (Source value))
       (set (CapacityExtent (Source value)) (Length value))
       (set (AllocationBounds (Source value)) (set-of (Length a) (Length b)))
       (Allocation (Source value) (Length value))) :ruleset residency)
(rule ((= (RuntimeArrayJoin value) true) (= (HasViewStage value) false))
      ((set (ViewExtent value) (Length value)) (set (LiveLength (Source value)) (Length value))) :ruleset residency)
(rule ((= (RuntimeArrayJoin value) true) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((ElementType (Source value) element)) :ruleset allocation)
(rule ((= layout (ValueRepresentation source)) (= layout (ViewLayout resource element))
       (= storage (Backing resource)) (Allocation storage extent))
      ((StorageResource storage)) :ruleset physical-abi)
(rule ((= (RuntimeArrayJoin value) true) (= value (SourceTerm region ordinal)) (OwnedRegion owner region))
      ((set (AllocationOwner (Source value)) owner)) :ruleset physical-abi)
; Materialize a host-level join once before parallel consumers read its view.
(rule ((= ty (SourceType value))) ((set (HasViewStage value) false)) :ruleset type-layouts)
(rule ((= (RuntimeArrayJoin value) true) (= op (SourceValueOperation value))
       (= region (OperationRegion op)) (HostRoot owner region))
      ((set (HasViewStage value) true)) :ruleset type-layouts)
(rule ((= (LoopOwnsView value) true) (= value (SourceTerm region ordinal)) (HostRoot owner region))
      ((set (HasViewStage value) true)) :ruleset type-layouts)
; Only control-flow context fields are extracted from a bound SSA descriptor.
(rule ((= value (SourceShape parent)) (LengthType ty))
      ((set (SourceType value) ty) (set (IsLocalResult value) false)) :ruleset residency)
(rule ((= value (SourceOffset parent)) (LengthType ty))
      ((set (SourceType value) ty) (set (IsLocalResult value) false)) :ruleset residency)
(rule ((= (HasViewStage value) true) (= op (SourceValueOperation value)) (= storage (ArrayStorage value)) (LengthType ty))
      ((set (LiveLength storage) (Scalar (SourceShape value)))
       (set (ValueRef value) storage)
       (set (ValueRead value) (ReadView storage))
       (set (ValueRef (SourceShape value)) (ViewLength value))
       (set (ValueRead (SourceShape value)) (ReadElement (ViewLength value)))
       (set (CapacityExtent (ViewLength value)) (Fixed 1))
       (set (LiveLength (ViewLength value)) (Fixed 1))
       (ElementType (ViewLength value) ty)
       (KernelPhase op "view" (Fixed 1) 1 (FixedGrid 1 1 1))
       (PhaseEnds op "view" "view")
       (Produces (Stage op "view") storage)
       (Produces (Stage op "view") (ViewLength value))
       (Demand (InStage (Stage op "view")) value)) :ruleset residency)
; Arm producers can live in nested source regions while publishing into this root.
(rule ((= (HasViewStage value) true) (= op (SourceValueOperation value))
       (Requires (InStage (Stage op "view")) resource) (Produces before resource)
       (!= before (Stage op "view")))
      ((DispatchDependency before (Stage op "view"))) :ruleset dispatch)
(rule ((= (HasViewStage value) true) (= (RuntimeArrayJoin value) true))
      ((set (ViewExtent value) (Scalar (SourceShape value)))) :ruleset residency)

(rule ((= ty (SourceType value))) ((set (HasArrayStorage value) false)) :ruleset residency)
(rule ((= storage (ArrayStorage value))) ((set (HasArrayStorage value) true)) :ruleset residency)

(rule ((= ty (SourceType value))) ((set (DerivedView value) false)) :ruleset residency)
(rule ((= loop (SourceLoop value)) (= op (SourceValueOperation value)) (= (ContainsCollective op) false) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))) ((set (DerivedView value) true)) :ruleset residency)
(rule ((= (SourceLoopInitial header) (LoopInitialInfo state initial)) (= (SourceLoop value) (LoopInfo header iteration)) (= op (SourceValueOperation value)) (= (ContainsCollective op) false) (= ty (SourceType state)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (DerivedView state) true)) :ruleset residency)
(rule ((= (RuntimeArrayJoin value) true)) ((set (DerivedView value) true)) :ruleset residency)
; Freeze complete descriptors after storage and forwarding decisions settle.
(ruleset array-views)
(rule ((= (DerivedView value) false) (= resource (ArrayStorage value)) (= (ValueRead value) (ReadView resource))
       (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize)) (= length (LiveLength resource)))
      ((set (ArrayView value) (ViewInfo resource (Fixed 0) length))) :ruleset array-views)
(rule ((= (DerivedView value) false) (ParameterValue value) (= (AbiStorage value) (StorageInput binding stride))
       (= resource (ArrayStorage value)) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (ArrayView value) (ViewInfo resource (Fixed 0) (Length value)))) :ruleset array-views)
(rule ((= (DerivedView value) false) (= resource (ArrayStorage value)) (= ty (SourceType value)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (ArrayView value) (ViewInfo resource (Fixed 0) (Fixed n)))) :ruleset array-views)
(rule ((ForwardValue value original) (= view (ArrayView original)))
      ((set (ArrayView value) view)) :ruleset array-views)
(rule ((SourceResultOperand value index original) (= view (ArrayView original)))
      ((set (ArrayView value) view)) :ruleset array-views)
(rule ((= (SourceSlice value) (SliceInfo original start end))
       (= (ArrayView original) (ViewInfo resource offset length)))
      ((set (ArrayView value) (ViewInfo resource (Sum offset (Scalar start)) (Difference (Scalar end) (Scalar start))))) :ruleset array-views)
(rule ((= (SourceLoopInitial header) (LoopInitialInfo state initial)) (= (SourceLoop value) (LoopInfo header iteration)) (= op (SourceValueOperation value)) (= (ContainsCollective op) false) (= resource (ArrayStorage state)) (= ty (SourceType state)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (ArrayView state) (ViewInfo resource (Scalar (SourceOffset state)) (Scalar (SourceShape state))))) :ruleset array-views)
(function LoopViewOffset (SourceValue) Extent :no-merge)
(rule ((= loop (SourceLoop value)) (= op (SourceValueOperation value)) (= (ContainsCollective op) false) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize)) (= (HasViewStage value) false))
      ((set (LoopViewOffset value) (Scalar (SourceOffset value)))) :ruleset array-views)
(rule ((= loop (SourceLoop value)) (= (HasViewStage value) true))
      ((set (LoopViewOffset value) (Fixed 0))) :ruleset array-views)
(rule ((= resource (ArrayStorage value)) (= offset (LoopViewOffset value)) (= (LoopPreservesLength value) false))
      ((set (ArrayView value) (ViewInfo resource offset (Scalar (SourceShape value))))) :ruleset array-views)
(rule ((= resource (ArrayStorage value)) (= offset (LoopViewOffset value)) (= (LoopPreservesLength value) true)
       (= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= (ArrayView initial) (ViewInfo initial-resource initial-offset length)))
      ((set (ArrayView value) (ViewInfo resource offset length))) :ruleset array-views)
(rule ((= (RuntimeArrayJoin value) true) (= resource (ArrayStorage value)))
      ((set (ArrayView value) (ViewInfo resource (Fixed 0) (Scalar (SourceShape value))))) :ruleset array-views)
; Input and control-flow metadata share one allocation per entry.
(rule ((= (HasViewStage value) true) (= ordinal (SourceOrdinal value))
       (= value (SourceTerm region index)) (OwnedRegion owner region))
      ((set (Backing (ViewLength value)) (Metadata owner))
       (set (MetadataIndex (ViewLength value)) (+ (* ordinal 2) 1))
       (set (MetadataCount owner) (+ (* ordinal 2) 2))) :ruleset allocation)
(ruleset metadata-allocation)
(rule ((= count (MetadataCount owner)) (LengthType ty))
      ((set (Backing (Metadata owner)) (Metadata owner))
       (set (CapacityExtent (Metadata owner)) (Fixed count))
       (set (LiveLength (Metadata owner)) (Fixed count))
       (ElementType (Metadata owner) ty)
       (Allocation (Metadata owner) (Fixed count))) :ruleset metadata-allocation)
(rule ((= count (MetadataCount owner)))
      ((set (AllocationOwner (Metadata owner)) owner)) :ruleset physical-abi)

; Swapped loop buffers must satisfy both kernels' binding capacities even when
; equivalent live domains have different conservative static bounds.
(rule ((HostLoop op region initial state index next)
       (= current (Backing (Source state))) (= result (ValueRef next)) (= following (Backing result))
       (= a (CapacityExtent current)) (= b (CapacityExtent following))
       (= na (StaticCapacityBound a)) (= nb (StaticCapacityBound b)) (= bound (Fixed (max na nb))))
      ((set (AllocationBounds current) (set-of bound))
       (set (AllocationBounds following) (set-of bound))) :ruleset capacity-bounds)
