; Structural scheduling; selected scalar evaluation is planned after extraction.
(run-schedule (seq
    (saturate traversal-types) (saturate map-types)
    (saturate rectangular-discover)
    (saturate repeatability) (run traversal-proofs) (run traversal-ready)
    (saturate (seq (run extent-shapes) (run map-shapes)))
    (saturate extent-dependencies) (run extent-uniformity)
    (saturate map-select) (saturate shape-properties)
    (saturate storage-shapes shape-properties)
    (saturate segmented-discover) segmented-select
    (saturate segmented-storage shape-properties)
    (saturate direct-outputs) (run traversal-leaves)
    ; Loop layouts introduce fields that share the ordinary forwarding proofs.
    (saturate (seq flow-structure type-layouts))
    (saturate segment-shapes)
    (saturate extent-dependencies) (run extent-uniformity)
    (saturate map-bindings)
    (saturate execution-discover) (saturate execution-select)))

; Reuse bounded region analysis for scalar prefixes; parallel leaves are costed separately.
(ruleset map-work)
(function MapPrefixWork (RegionKey) i64 :no-merge)
(rule ((= n (SourceRegionScalarWork region)) (= cost (wyn-scalar-weight region 1048576)))
      ((set (MapPrefixWork region) cost)) :ruleset map-work :naive)
(run-schedule map-work (saturate cost-values))
