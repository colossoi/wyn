; Nonuniform arrays use one offset vector per nesting level and flat leaves.
; Shape construction precedes allocation and traversal selection.
(ruleset segmented-discover)
(ruleset segmented-select)
(ruleset segmented-storage)
(function HasCompleteStorage (SourceValue) bool :merge (or old new))
(function SegmentedResult (OperationKey i64) bool :merge (or old new))
(relation SegmentedOutput (SourceValue OperationKey i64 i64))
(function SegmentedPrefix (ValueKey i64) DomainShape :no-merge)
(function SegmentedElement (ValueKey i64) TypeKey :no-merge)
(relation OutputDomain (OperationKey i64 DomainShape))
(relation ShapePhase (StageKey SourceValue DomainShape ValueKey))
(function ShapePhaseName (ValueKey) String :no-merge)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element))
      ((set (HasCompleteStorage value) false) (set (SegmentedResult owner i) false)) :ruleset segmented-discover)
(rule ((DirectResult value owner i) (= layout (StorageLayout (Result owner i))))
      ((set (HasCompleteStorage value) true)) :ruleset segmented-discover)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (PlanResult plan "array" i value element) (= ty (SourceType value))
       (= rank (ArrayTypeRank ty)) (> rank 1) (= depth (SourceTraversalDepth value)) (>= depth (- rank 1))
       (= (HasCompleteStorage value) false) (= (SourceReadOnly value) true) (RectangularReady value)
       (= (TraversalPrefixSpeculatable value) true)
       (ArrayTypeAxis ty axis (DynamicSize)) (> axis 0))
      ((SegmentedOutput value owner i rank) (set (SegmentedResult owner i) true)
       (set (SegmentedPrefix (Result owner i) 1) (OneAxis extent))
       (set (SegmentedElement (Result owner i) 0) ty)) :ruleset segmented-select)
(rule ((SegmentedOutput value owner i rank) (= prefix (SegmentedPrefix (Result owner i) axis)) (< axis rank))
      ((set (SegmentedPrefix (Result owner i) (+ axis 1)) (Segments prefix (SegmentOffsets (Result owner i) axis) (Stored (SegmentCount (SegmentOffsets (Result owner i) axis)))))) :ruleset segmented-storage)
(rule ((SegmentedOutput value owner i rank) (= ty (SegmentedElement (Result owner i) axis))
       (< axis rank) (SourceArrayElement ty child))
      ((set (SegmentedElement (Result owner i) (+ axis 1)) child)) :ruleset segmented-storage)
(rule ((SegmentedOutput value owner i rank) (= shape (SegmentedPrefix (Result owner i) rank))
       (= leaf (SegmentedElement (Result owner i) rank)))
      ((set (StorageLayout (Result owner i)) (FlatStorage leaf shape))) :ruleset segmented-storage)
(rule ((SegmentedOutput value owner i rank) (= depth (SourceTraversalDepth value))
       (= shape (SegmentedPrefix (Result owner i) (min depth rank))))
      ((OutputDomain owner i shape)) :ruleset segmented-storage)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element)
       (= (SegmentedResult owner i) false) (= shape (OutputShape owner i rank)))
      ((OutputDomain owner i shape)) :ruleset segmented-storage)
(rule ((SegmentedOutput value owner i rank) (= parents (SegmentedPrefix (Result owner i) axis)) (< axis rank)
       (= n (ShapeExtent parents)) (LengthType t))
      ((set (ShapePhaseName (SegmentOffsets (Result owner i) axis)) (+ "shape_" (to-string i) "_" (to-string axis)))
       (set (StorageDeclaration (SegmentOffsets (Result owner i) axis)) (AllocateResult (StoredArray t (Sum n (Fixed 1)) (Sum n (Fixed 1))) (NoContents)))
       (set (StorageDeclaration (SegmentCount (SegmentOffsets (Result owner i) axis))) (AllocateResult (StoredValue t) (NoContents)))) :ruleset segmented-storage)
(rule ((SegmentedOutput value owner i rank) (= parents (SegmentedPrefix (Result owner i) axis)) (< axis rank)
       (= name (ShapePhaseName (SegmentOffsets (Result owner i) axis))))
      ((KernelPhase owner name (Fixed 1) 1 (FixedGrid 1 1 1))
       (ShapePhase (Stage owner name) value parents (SegmentOffsets (Result owner i) axis))
       (PhaseLink owner name "elements") (PhaseInput (Stage owner name) owner "input")) :ruleset schedule)
(rule ((ShapePhase stage value parents offsets) (Phase stage region))
      ((Produces stage offsets) (Produces stage (SegmentCount offsets))
       (Materialize offsets) (Materialize (SegmentCount offsets))) :ruleset schedule)
(rule ((ShapePhase stage value parents offsets) (= parents (Segments prefix previous total))
       (= name (ShapePhaseName previous)) (= (Stage owner phase) stage))
      ((PhaseLink owner name phase)) :ruleset schedule)
; Every consumer of a segmented view observes its descriptor resources too.
(relation ShapeDemand (StageKey DomainShape))
(rule ((Needs stage value) (= (StorageLayout value) (FlatStorage leaf shape)))
      ((ShapeDemand stage shape)) :ruleset residency)
(rule ((Produces stage value) (= (StorageLayout value) (FlatStorage leaf shape)))
      ((ShapeDemand stage shape)) :ruleset residency)
(rule ((ShapePhase stage value parents offsets)) ((ShapeDemand stage parents)) :ruleset residency)
(relation ShapeResource (DomainShape ValueKey))
(rule ((= shape (Segments parents offsets total)))
      ((ShapeResource shape offsets)) :ruleset shape-properties)
(rule ((= shape (Segments parents offsets total)) (ShapeResource parents resource))
      ((ShapeResource shape resource)) :ruleset shape-properties)
(rule ((= shape (AppendAxis parents n)) (ShapeResource parents resource))
      ((ShapeResource shape resource)) :ruleset shape-properties)
(rule ((ShapeDemand stage shape) (ShapeResource shape resource)) ((Needs stage resource)) :ruleset residency)
(rule ((ShapeDemand stage (Segments parents offsets total))) ((ShapeDemand stage parents) (ExtentDemand stage total)) :ruleset residency)
(rule ((= access (RootResource root value)) (= (StorageLayout value) (FlatStorage leaf shape))
       (ShapeResource shape resource)) ((set (RootResource root resource) 1)) :ruleset physical-abi)
(rule ((ShapeDemand stage (AppendAxis parents n))) ((ShapeDemand stage parents) (ExtentDemand stage n)) :ruleset residency)
(rule ((ShapeDemand stage (OneAxis n))) ((ExtentDemand stage n)) :ruleset residency)

; Splitting and adjoining descriptors preserve the complete nested shape.
(relation PrependSegmentsRequest (Extent ValueKey DomainShape))
(function PrependSegments (Extent ValueKey DomainShape) DomainShape :no-merge)
(rule ((PrependSegmentsRequest n offsets (OneAxis m)))
      ((set (PrependSegments n offsets (OneAxis m)) (Segments (OneAxis n) offsets m))) :ruleset shape-properties)
(rule ((PrependSegmentsRequest n offsets (Segments parents child total)) (= prefix (PrependSegments n offsets parents)))
      ((set (PrependSegments n offsets (Segments parents child total)) (Segments prefix child total))) :ruleset shape-properties)
(rule ((PrependSegmentsRequest n offsets (Segments parents child total)))
      ((PrependSegmentsRequest n offsets parents)) :ruleset shape-properties)
(rule ((HostLoopAggregate value) (= offsets (SourceDescriptorPart value 0))
       (= elements (SourceDescriptorPart value 1)) (= offset-buffer (ValueRef offsets))
       (= extent (ViewExtent value)) (= (ArrayShape elements) (FlatStorage leaf child)))
      ((PrependSegmentsRequest extent offset-buffer child)) :ruleset residency)
(datatype DescriptorParts (DescriptorPartsInfo ValueKey DomainShape))
(function ShapeParts (DomainShape) DescriptorParts :no-merge)
(function OuterExtent (DomainShape) Extent :no-merge)
(rule ((= shape (OneAxis n))) ((set (OuterExtent shape) n)) :ruleset shape-properties)
(rule ((= shape (Segments parents offsets total)) (= n (OuterExtent parents)))
      ((set (OuterExtent shape) n)) :ruleset shape-properties)
(rule ((= shape (Segments (OneAxis n) offsets total)))
      ((set (ShapeParts shape) (DescriptorPartsInfo offsets (OneAxis total)))) :ruleset shape-properties)
(rule ((= shape (Segments parents offsets total)) (= (ShapeParts parents) (DescriptorPartsInfo first inner)))
      ((set (ShapeParts shape) (DescriptorPartsInfo first (Segments inner offsets total)))) :ruleset shape-properties)
(rule ((= part (SourceDescriptorPart parent 0)) (= (DispatchLoopValue part) false)
       (= (ArrayShape parent) (FlatStorage leaf shape)) (= (ShapeParts shape) (DescriptorPartsInfo offsets inner)) (= n (OuterExtent shape)))
      ((set (ViewExtent part) (Sum n (Fixed 1))) (set (ValueRef part) offsets)) :ruleset residency)
(rule ((= part (SourceDescriptorPart parent 1)) (= (DispatchLoopValue part) false)
       (= (ArrayShape parent) (FlatStorage leaf shape)) (= (ShapeParts shape) (DescriptorPartsInfo offsets inner))
       (= n (OuterExtent inner)) (= data (ValueRef parent)))
      ((set (ArrayShape part) (FlatStorage leaf inner)) (set (ViewExtent part) n) (set (ValueRef part) data)) :ruleset residency)
(rule ((= part (SourceDescriptorPart parent i)) (= (DispatchLoopValue part) false))
      ((FlowReferenceEdge part parent)) :ruleset residency)

