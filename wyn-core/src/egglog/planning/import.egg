; Project the completed fusion plan into the retained structural planner.
(ruleset planning-import)
(relation PlannedSourcePosition (OperationKey RegionKey i64))
(relation AllowGeneratedTopology ())
(relation AuthoredTopology ())
(relation PlannedOperation (OperationKey OperationKey FusionPlan RegionKey))
(rule ((Current group plan) (= owner (Owner plan)) (= region (Scope plan)) (PlanMember plan original))
      ((PlannedOperation original owner plan region) (Site owner region)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region compute)) ((SourceEntry entry region compute)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region true) (AllowGeneratedTopology)) ((HostRoot entry region)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region compute) (AuthoredTopology)) ((DeviceRegion region)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region false)) ((DeviceRegion region)) :ruleset planning-import)
(rule ((SourceResult region value) (= key (SourceExprKey value))) ((ExitValue region key)) :ruleset planning-import)
(rule ((SourceOutput output entry value ty array) (= key (SourceExprKey value)))
      ((OutputOwner output entry) (OutputExpression output key)) :ruleset planning-import)
(rule ((SourceOutput output entry value ty false)) ((ReturnScalar output ty)) :ruleset planning-import)
(rule ((SourceOutput output entry value ty true) (= key (SourceExprKey value))) ((ReturnArray output key)) :ruleset planning-import)
(rule ((SourceOutput output entry value ty true) (= key (SourceExprKey value)) (SourceArrayElement ty element))
      ((ReturnedArrayLayout output element (Length key))) :ruleset planning-import)
(rule ((= value (SourceFormal region symbol)) (= key (SourceExprKey value))) ((ParameterValue key)) :ruleset planning-import)
(rule ((SourceAlias value source) (= key (SourceExprKey value)) (= child (SourceExprKey source))) ((ForwardValue key child)) :ruleset planning-import)
(rule ((SourceProjection value source i) (= key (SourceExprKey value)) (= child (SourceExprKey source))) ((Projection key child i)) :ruleset planning-import)
(rule ((SourceField value i source) (= key (SourceExprKey value)) (= child (SourceExprKey source))) ((FieldValue key i child)) :ruleset planning-import)
(rule ((SourceComputedUse value source) (= key (SourceExprKey value)) (= child (SourceExprKey source)))
      ((ComputedValue key) (ChildValue key child)) :ruleset planning-import)
(rule ((SourceSlice value source start end) (= key (SourceExprKey value)) (= array (SourceExprKey source))
       (= a (SourceExprKey start)) (= b (SourceExprKey end))) ((SliceView key array a b)) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (SourceOperationValue original value) (SourceEnters value child)) ((Enters owner child)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperatorBody original child)) ((Callback owner child) (DeviceRegion child)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperationValue original value) (= (SourceReadOnly value) false)) ((ParallelEffect owner)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (SourceOperation original source "control")) ((SourceControl owner)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (SourceOperation original source kind)
       (!= kind "map") (!= kind "reduce") (!= kind "scan") (!= kind "filter")
       (!= kind "scatter") (!= kind "bucket-scatter") (!= kind "reduce-by-index")
       (SourceOperationValue original value) (= key (SourceExprKey value)))
      ((ScalarSite owner) (ScalarResult key owner)) :ruleset planning-import)
(rule ((ScalarSite owner) (SourceOperationValue owner value) (= ty (SourceType value)) (SourceScalarLayout ty))
      ((ScalarCandidate owner) (ElementType (Result owner 0) ty)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (SourceOperationValue original value)
       (= device (SourceDevice value)) (= duplicate (SourceDuplicable value)) (SourceOperationCheap original cheap))
      ((ExecutionSummary owner device duplicate cheap)) :ruleset planning-import)

(rule ((Current group plan) (= owner (Owner plan)) (= extent (PlanExtent plan)) (SourceOperation owner r kind) (!= kind "bucket-scatter")) ((InputDomain owner extent)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (= scans (HasScans plan)) (= totals (HasReductions plan)))
      ((CollectiveShape owner scans totals) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (= tree (PlanTotals plan)) (= n (ResultCount tree))) ((TotalCount owner n)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (PlanResult plan "total" i value ty) (= key (SourceExprKey value)))
      ((TotalResult owner i ty) (DirectResult key owner i)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (PlanResult plan "array" i value ty) (= key (SourceExprKey value)))
      ((ArrayResult owner i ty) (DirectResult key owner i)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanResult plan "scan" i value ty))
      ((ScanComponent owner i ty) (Accumulator owner i ty)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanResult plan "total" i value ty) (= scans (PlanScans plan)) (= count (ResultCount scans)))
      ((Accumulator owner (+ count i) ty)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (FilterPlan plan) (PlanResult plan "array" i value ty) (= key (SourceExprKey value)))
      ((FilterShape owner) (FilterResult owner ty) (DirectResult key owner 0) (set (ContainsCollective owner) true)) :ruleset planning-import)
; A fused post-map replaces the elements, but the original filtered view still
; has the compaction count. Length observers must retain that metadata route.
(rule ((PlannedOperation original owner plan region) (FilterPlan plan)
       (SourceOperation original r "filter") (SourceOperationValue original value)
       (= key (SourceExprKey value)))
      ((ViewExtent key (Stored (Result owner 1)))) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (SourceDestination original destination) (= key (SourceExprKey destination))
       (SourceOperation original r kind) (!= kind "scatter"))
      ((UpdatedResult owner 0 key) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "scatter") (= scans (HasScans plan))) ((IndexedWrite owner scans)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceIndexedReducer original safe update)) ((IndexedReducer owner safe update)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "bucket-scatter")
       (SourceDestination original destination) (= key (SourceExprKey destination))
       (SourceKnownBucketDomain original known)) ((BucketResult owner key) (BucketShape owner known)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceDestination original destination)
       (SourceOperation original r kind) (!= kind "bucket-scatter")
       (SourceOperationValue original value) (= key (SourceExprKey value))) ((DirectResult key owner 0)) :ruleset planning-import)

(rule ((Current group plan) (= owner (Owner plan)) (PlanRoute plan original i value) (= (PlanInternal plan value) false) (= key (SourceExprKey value)))
      ((Operand owner "input" key)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperand original child) (= (PlanInternal plan child) false) (= key (SourceExprKey child)))
      ((Operand owner "environment" key)) :ruleset planning-import)
(rule ((SourceDepends after before role) (PlannedOperation after owner plan region) (PlannedOperation before producer producer-plan source) (!= owner producer))
      ((SourceDependency owner producer)) :ruleset planning-import)
(rule ((ImportedEffectOrder before after) (PlannedOperation before producer p r) (PlannedOperation after consumer c r) (!= producer consumer)
       (= producer (OperationId gate))) ((EffectInput gate producer) (EffectWait consumer gate)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (ImportedPosition original i)) ((PlannedSourcePosition owner region i)) :ruleset planning-import)

(rule ((SourceLength value array) (SourceOperationValue original value) (PlannedOperation original owner plan region)
       (= key (SourceExprKey array))) ((LengthOperation owner key)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "bucket-scatter")
       (SourceBucketDomain original n)) ((InputDomain owner n)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "bucket-scatter")
       (SourceOperationValue original value) (= key (SourceExprKey value))) ((ResultTuple key owner)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "scatter")
       (SourceDestination original destination) (= (SourceStorage destination) true) (= key (SourceExprKey destination)))
      ((UpdatedResult owner 0 key) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "scatter")
       (SourceDestination original destination) (= (SourceStorage destination) false) (= (SourceScratchValue destination) false)
       (= ty (SourceType destination)) (SourceArrayElement ty element) (= key (SourceExprKey destination)))
      ((InitializedResult owner 0 element (Length key)) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceReuse original i) (PlanRoute plan original i value)
       (= (PlanInternal plan value) false) (SourceOperationValue original result)
       (PlanResult plan "array" slot result ty) (= key (SourceExprKey value)))
      ((ReusePermission owner slot key)) :ruleset planning-import)
(rule ((SourceStorageField value) (= key (SourceExprKey value))) ((ParameterValue key)) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (SourceOperation original r "scatter")
       (SourceDestination original destination) (= (SourceStorage destination) true)
       (SourceReadCandidate original read) (= (BackingIdentity read) (BackingIdentity destination)))
      ((ScatterReadConflict owner)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperation original r "scatter")
       (SourceDestination original destination) (= (SourceStorage destination) false)
       (= (Identity destination) (Identity scratch)) (SourceScratch scratch length)
       (= ty (SourceType destination)) (SourceArrayElement ty element))
      ((UninitializedResult owner 0 element length) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperationValue original value)
       (SourceScratch value length) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((UninitializedResult owner 0 element length)) :ruleset planning-import)

(rule ((Current group plan) (= owner (Owner plan)) (PlanCountSlot plan count i ty))
      ((TotalResult owner i ty) (Accumulator owner i ty)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanCountSlot plan count i ty)
       (PlanCountObserver count original) (SourceOperationValue original value) (= key (SourceExprKey value)))
      ((DirectResult key owner i)) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (SourceOperatorBody original wrapper)
       (SourceResult wrapper value) (SourceCallable value actual))
      ((Callback owner actual) (DeviceRegion actual)) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (= original owner)
       (SourceOperationValue original value) (SourceScratch value extent))
      ((set (Rematerialize owner) true)) :ruleset classify)
