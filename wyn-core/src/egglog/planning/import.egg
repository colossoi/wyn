; Project the completed fusion plan into the retained structural planner.
(ruleset planning-import)
(relation PlannedSourcePosition (OperationKey RegionKey i64))
(relation AllowGeneratedTopology ())
(relation AuthoredTopology ())
(relation PlannedOperation (OperationKey OperationKey FusionPlan RegionKey))
(rule ((Current group plan) (= owner (Owner plan)) (= region (PlanScope plan)) (PlanMember plan original))
      ((PlannedOperation original owner plan region) (set (OperationRegion owner) region)) :ruleset planning-import)

(rule ((SourceOriginalEntry entry region true) (AllowGeneratedTopology)) ((HostRoot entry region)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region compute) (AuthoredTopology)) ((DeviceRegion region)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region false)) ((DeviceRegion region)) :ruleset planning-import)
(relation EmitOriginalEntry (i64))
(relation InterfaceOnlyEntry (i64))
(function EntryExecutes (i64) bool :merge (or old new))
(rule ((HostRoot entry region)) ((set (EntryExecutes entry) false)) :ruleset residency)
(rule ((PhaseOwner stage entry)) ((set (EntryExecutes entry) true)) :ruleset residency)
(rule ((FinishEntry entry)) ((set (EntryExecutes entry) true)) :ruleset residency)
(rule ((= (EntryExecutes entry) false)) ((InterfaceOnlyEntry entry)) :ruleset readout)
(function OriginalEntryGrid (i64) DispatchGrid :no-merge)
(rule ((HostRoot entry region)) ((set (OriginalEntryGrid entry) (FixedGrid 1 1 1))) :ruleset residency)
(rule ((FinishEntry entry)) ((set (OriginalEntryGrid entry) (FixedGrid 1 1 1))) :ruleset residency)
(rule ((SourceOriginalEntry entry region false)) ((EmitOriginalEntry entry)) :ruleset planning-import)
(rule ((SourceOriginalEntry entry region true) (AuthoredTopology)) ((EmitOriginalEntry entry)) :ruleset planning-import)
(rule ((EmitOriginalEntry entry) (= (EntryGrid entry) (AutomaticGrid)))
      ((set (OriginalEntryGrid entry) (FixedGrid 1 1 1))) :ruleset planning-import)
(rule ((EmitOriginalEntry entry) (= grid (EntryGrid entry)) (= grid (FixedGrid x y z)))
      ((set (OriginalEntryGrid entry) grid)) :ruleset planning-import)
(rule ((= value (SourceResult region))) ((ExitValue region value)) :ruleset planning-import)
(rule ((= (SourceOutput output) (OutputInfo entry value ty array)) (HostRoot entry region))
      ((PlannedOutput output entry value)) :ruleset planning-import)
(rule ((= (SourceOutput output) (OutputInfo entry value ty false)) (HostRoot entry region)) ((ReturnScalar output ty)) :ruleset planning-import)
(rule ((= (SourceOutput output) (OutputInfo entry value ty true)) (HostRoot entry region)) ((ReturnArray output value)) :ruleset planning-import)
(rule ((= (SourceOutput output) (OutputInfo entry value ty true)) (HostRoot entry region) (SourceArrayElement ty element))
      ((ReturnedArrayLayout output element (Length value))) :ruleset planning-import)
(rule ((= value (SourceFormal region symbol))) ((ParameterValue value)) :ruleset planning-import)
(rule ((SourceReusePermission value region) (= ty (SourceType value))
       (SourceBufferedArrayType ty) (SourceArrayElement ty element))
      ((ReusableSource value element region)) :ruleset planning-import)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (FixedSize n)))
      ((FixedInputLength value n)) :ruleset planning-import)
(rule ((= (SourceProjection value) (ProjectionInfo parent i))
       (ParameterValue parent)) ((ParameterValue value)) :ruleset residency)
(rule ((= source (SourceAlias value))) ((ForwardValue value source)) :ruleset planning-import)
(rule ((= (SourceProjection value) (ProjectionInfo source i))) ((Projection value source i)) :ruleset planning-import)

(rule ((SourceComputedUse value source))
      ((ComputedValue value) (ChildValue value source)) :ruleset planning-import)

(rule ((= (SourceExtent value) (Fixed n)))
      ((set (ViewExtent value) (Fixed n))) :ruleset planning-import)
(rule ((= (SourceExtent value) (Scalar length)))
      ((set (ViewExtent value) (Scalar length))) :ruleset planning-import)
(rule ((SourceArrayPart value 0 first))
      ((set (ViewExtent value) (Length first))) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (= value (SourceOperationValue original)) (SourceEnters value child)) ((Enters owner child)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= child (SourceOperatorBody original))) ((Callback owner child) (DeviceRegion child)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= value (SourceOperationValue original)) (= (SourceReadOnly value) false)) ((set (ParallelSafe owner) false)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (= (SourceOperation original) (OperationInfo source "control"))) ((OperationControl owner)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (= (SourceOperation original) (OperationInfo source kind))
       (!= kind "map") (!= kind "reduce") (!= kind "scan") (!= kind "filter")
       (!= kind "scatter") (!= kind "bucket-scatter") (!= kind "reduce-by-index")
       (= value (SourceOperationValue original)))
      ((InvocationResult value owner)) :ruleset planning-import)
(rule ((InvocationResult value owner) (= ty (SourceType value)) (= source-layout-bytes (SourceByteSize ty)) (> source-layout-bytes 0))
      ((InvocationScalarCandidate owner) (ElementType (Result owner 0) ty)) :ruleset planning-import)

; Only host operations can join into a generated scalar dispatch. Device-local
; operations retain their source order inside the enclosing kernel.
(rule ((HostRegion r) (= r (OperationRegion (OperationId op)))
       (InvocationScalarCandidate (OperationId op)) (= (ContainsCollective (OperationId op)) false)
       (= (ParallelSafe (OperationId op)) true)
       (PlannedOperation (OperationId op) (OperationId op) plan r)
       (= value (SourceOperationValue (OperationId op))) (= (SourceRequiresDevice value) true)
       (= legal (SourceDuplicable value)) (= cheap (WorkOperationCheap (OperationId op)))
       (= (and legal cheap) false))
      ((set (IsScalarGroupCandidate (OperationId op)) true)) :ruleset scalar-windows)

; The source summary keeps mutable reads and speculation restrictions separate
; from work. Completed effect and collective proofs must also permit duplication.
(rule ((InvocationScalarCandidate (OperationId op)) (= (ParallelSafe (OperationId op)) true)
       (PlannedOperation (OperationId op) (OperationId op) plan region)
       (= value (SourceOperationValue (OperationId op)))
       (= (SourceDuplicable value) true) (= (WorkOperationCheap (OperationId op)) true)
       (= (ContainsCollective (OperationId op)) false))
      ((set (Rematerialize (OperationId op)) true)) :ruleset classify)

(rule ((CopyOutput output) (PlannedOutput output entry e) (References e (Contents value))
       (EpilogueValue stage value)
       (= stage (Stage op name)) (PlannedOperation op op plan region)
       (= source (SourceOperationValue op)) (= (SourceRequiresDevice source) true)
       (Phase stage r) (SourceOriginalEntry entry r true))
      ((set (OutputBlocked output stage) false)) :ruleset output-candidates)

(rule ((Current group plan) (= owner (Owner plan)) (= domain (PlanDomain plan)) (= extent (SourceDomainExtent domain)))
      ((set (InputDomain owner) extent)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan))
      ((set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (= tree (PlanTotals plan)) (= n (ResultCount tree))) ((TotalCount owner n)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (PlanResult plan "total" i value ty))
      ((TotalResult owner i ty) (DirectResult value owner i)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (ScremaPlan plan) (PlanResult plan "array" i value ty))
      ((ArrayResult owner i ty) (DirectResult value owner i)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanResult plan "scan" i value ty))
      ((Accumulator owner i ty "scan" i value)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanResult plan "total" i value ty) (= scans (PlanScans plan)) (= count (ResultCount scans)))
      ((Accumulator owner (+ count i) ty "total" i value)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (FilterPlan plan) (PlanResult plan "array" i value ty))
      ((FilterShape owner) (FilterResult owner ty) (DirectResult value owner 0) (set (ContainsCollective owner) true)) :ruleset planning-import)
; A fused post-map replaces the elements, but the original filtered view still
; has the compaction count. Length observers must retain that metadata route.
(rule ((PlannedOperation original owner plan region) (FilterPlan plan)
       (= (SourceOperation original) (OperationInfo r "filter")) (= value (SourceOperationValue original)))
      ((set (ViewExtent value) (Stored (Result owner 1)))) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (= destination (SourceDestination original))
       (= (SourceOperation original) (OperationInfo r kind)) (!= kind "scatter"))
      ((UpdatedResult owner 0 destination) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "scatter")) (= scans (HasScans plan))) ((IndexedWrite owner scans)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceIndexedReducer original safe update)) ((IndexedReducer owner safe update)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "bucket-scatter"))
       (= destination (SourceDestination original))
       (SourceKnownBucketDomain original known)) ((BucketResult owner destination) (BucketShape owner known)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= destination (SourceDestination original))
       (= (SourceOperation original) (OperationInfo r kind)) (!= kind "bucket-scatter")
       (= value (SourceOperationValue original))) ((DirectResult value owner 0)) :ruleset planning-import)

(rule ((Current group plan) (= owner (Owner plan)) (PlanMember plan original) (= value (SourceInput original i)) (= (PlanInternal plan value) false))
      ((Operand owner "input" value)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (SourceOperand original child) (= (PlanInternal plan child) false))
      ((Operand owner "environment" child)) :ruleset planning-import)
(rule ((SourceDepends after before role) (PlannedOperation after owner plan region) (PlannedOperation before producer producer-plan source) (!= owner producer))
      ((OperationDependency owner producer)) :ruleset planning-import)
(rule ((ImportedEffectOrder before after) (PlannedOperation before producer p r) (PlannedOperation after consumer c r) (!= producer consumer)
       (= producer (OperationId gate))) ((EffectInput gate producer) (EffectWait consumer gate)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= original owner) (ImportedPosition original i)) ((PlannedSourcePosition owner region i)) :ruleset planning-import)

(rule ((= array (SourceLength value)) (= value (SourceOperationValue original)) (PlannedOperation original owner plan region)) ((LengthOperation owner array)) :ruleset planning-import)
(rule ((SourceScratch value (Length array)) (= value (SourceOperationValue original))
       (PlannedOperation original owner plan region)) ((LengthOperation owner array)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "bucket-scatter"))
       (= value (SourceOperationValue original))) ((ResultTuple value owner)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "scatter"))
       (= destination (SourceDestination original)) (= (SourceStorage destination) true))
      ((UpdatedResult owner 0 destination) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "scatter"))
       (= destination (SourceDestination original)) (= (SourceStorage destination) false) (= (SourceScratchValue destination) false)
       (= ty (SourceType destination)) (SourceArrayElement ty element))
      ((InitializedResult owner 0 element (Length destination)) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= value (SourceInput original i))
       (= (PlanInternal plan value) false) (= result (SourceOperationValue original))
       (PlanResult plan "array" slot result ty))
      ((PreferredReuse (Result owner slot) value)) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "scatter"))
       (= destination (SourceDestination original)) (= (SourceStorage destination) true)
       (ScatterReadValue original read) (= (BackingIdentity read) (BackingIdentity destination)))
      ((set (ParallelBodySafe owner) false)) :ruleset planning-import)
; The destination itself is expected; inputs and captures must not reread it.
(rule ((PlannedOperation original owner plan region) (ScatterReadValue original read)
       (ReuseAlias (Stage owner name) e alias) (ValueRef read alias))
      ((set (ReuseBlocked (Stage owner name) e) true)) :ruleset reuse)
(rule ((PlannedOperation original owner plan region) (= (SourceOperation original) (OperationInfo r "scatter"))
       (= destination (SourceDestination original)) (= (SourceStorage destination) false)
       (= (Identity destination) (Identity scratch)) (SourceScratch scratch length)
       (= ty (SourceType destination)) (SourceArrayElement ty element))
      ((UninitializedResult owner 0 element length) (set (ContainsCollective owner) true)) :ruleset planning-import)
(rule ((PlannedOperation original owner plan region) (= value (SourceOperationValue original))
       (SourceScratch value length) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((UninitializedResult owner 0 element length)) :ruleset planning-import)

(rule ((Current group plan) (= owner (Owner plan)) (PlanCountSlot plan count i ty))
      ((TotalResult owner i ty)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanCountSlot plan count i ty)
       (= scans (PlanScans plan)) (= n (ResultCount scans))
       (PlanMember count filter) (= (SourceOperation filter) (OperationInfo r "filter")) (= value (SourceOperationValue filter)))
      ((Accumulator owner (+ n i) ty "count" i value)) :ruleset planning-import)
(rule ((Current group plan) (= owner (Owner plan)) (PlanCountSlot plan count i ty)
       (PlanCountObserver count original) (= value (SourceOperationValue original)))
      ((DirectResult value owner i)) :ruleset planning-import)

(rule ((PlannedOperation original owner plan region) (= wrapper (SourceOperatorBody original))
       (= value (SourceResult wrapper)) (= actual (PlanCallee value)))
      ((Callback owner actual) (DeviceRegion actual)) :ruleset planning-import)

(rule ((SourceCountedArrayLoop value) (= value (SourceOperationValue op))
       (= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (SourceLoopBackedge header state next) (= index (SourceIterationValue iteration)))
      ((set (HostLoopCandidate op) true) (CountedArrayLoop op iteration initial state index next)) :ruleset planning-import)
(rule ((HostLoop op r a state index n) (= ty (SourceType state))
       (SourceArrayElement ty element) (= it (SourceType index)))
      ((ElementType (Source state) element) (ElementType (Source index) it)) :ruleset residency)

(rule ((PlannedOperation original owner plan region) (= original owner)
       (= value (SourceOperationValue original)) (SourceScratch value extent))
      ((set (Rematerialize owner) true)) :ruleset classify)

; Combination consumes reducer callbacks, not the producer maps' environments.
(rule ((Phase (Stage leader phase) r) (PlannedOperation op leader plan r)
       (= callback (SourceOperatorBody op)) (= (SourceOperation op) (OperationInfo origin kind))
       (!= phase "initialize") (!= phase "clear") (!= phase "loop_enter") (!= phase "loop_exit")
       (!= phase "combine"))
      ((PhaseCallback (Stage leader phase) callback)) :ruleset schedule)
(rule ((Phase (Stage leader "combine") r) (PlannedOperation op leader plan r)
       (= callback (SourceOperatorBody op)) (= (SourceOperation op) (OperationInfo origin kind))
       (!= kind "map") (!= kind "filter") (!= kind "scatter") (!= kind "bucket-scatter"))
      ((PhaseCallback (Stage leader "combine") callback)) :ruleset schedule)
(rule ((PhaseCallback stage region) (SourceRegionEnters region child))
      ((PhaseCallback stage child)) :ruleset schedule)

; Only the combination callbacks and neutrals are evaluated by a combine phase.
(rule ((PhaseCallback stage region) (SourceCapture region formal source))
      ((Demand (InStage stage) source)) :ruleset schedule)
(rule ((Phase (Stage leader "combine") region) (PlannedOperation op leader plan region)
       (= neutral (SourceNeutral op)))
      ((Demand (InStage (Stage leader "combine")) neutral)) :ruleset schedule)

; A buffer consumer needs the selected view, not just its backing allocation.
; Copy slices until the draw ABI can carry their offsets and logical lengths.
(rule ((SourceBufferDemand owner) (= (SourceOutput output) (OutputInfo owner value ty true))
       (= (SourceSlice value) (SliceInfo source start end)))
      ((set (OutputPinned output) true)) :ruleset planning-import)
(rule ((SourceDrawValue draw owner slot) (SourceResultSlot owner slot output))
      ((DrawOutputRead draw output)) :ruleset planning-import)
