; Backing identity is distinct from the version of a value stored there.
; Destination selection completes before fresh storage can be allocated.
(rule ((InitializedResult op i t n))
      ((set (SelectedDestination op) (DestinationBuffer (Result op i)))) :ruleset allocation)
(rule ((UninitializedResult op i t n))
      ((set (SelectedDestination op) (DestinationBuffer (Result op i)))) :ruleset allocation)
(rule ((UpdatedResult op i source))
      ((set (SelectedDestination op) (DestinationValue source))) :ruleset allocation)
(rule ((BucketResult op source))
      ((set (SelectedDestination op) (DestinationValue source))) :ruleset allocation)
(function ReuseSelected (ValueKey) bool :merge (or old new))
(rule ((FreshValue value)) ((set (ReuseSelected value) false)) :ruleset allocation)
(datatype StorageChoice (Allocate) (Reuse SourceValue))
(function StorageFor (ValueKey) StorageChoice :no-merge)
(rule ((Materialize value) (= (StorageFor value) (Allocate))) ((set (Backing value) value)) :ruleset allocation)
(rule ((= (StorageFor value) (Reuse e))) ((set (SameBacking value) e)) :ruleset allocation)
(rule ((Needs stage (Source e))) ((set (Backing (Source e)) (Source e))) :ruleset allocation)
(rule ((Requires (InOperation op) (Source e))) ((set (Backing (Source e)) (Source e))) :ruleset allocation)
(rule ((Escapes (Source e))) ((set (Backing (Source e)) (Source e))) :ruleset allocation)
(rule ((= e (SameBacking value)) (= (ValueRef e) source) (= storage (Backing source)))
      ((set (Backing value) storage)) :ruleset allocation)
(rule ((= e (SameBacking value)) (= (ValueRef e) source) (Materialize value))
      ((Materialize source)) :ruleset allocation)
(rule ((= e (SameBacking value)) (= (ValueRef e) (Source source)))
      ((set (Backing value) (Source source))) :ruleset allocation)
(rule ((= value (Backing value)) (FreshValue value) (= n (CapacityExtent value)))
      ((Allocation value n)) :ruleset allocation)

; Capacity describes allocation, while LiveLength describes the usable view.
(rule ((= (LiveLength value) (Stored count)) (= capacity (CapacityExtent value)))
      ((set (HostBound (Stored count)) capacity)) :ruleset allocation)
(rule ((= grid (PhaseGrid stage)) (= grid (FixedGrid x y z)))
      ((set (LaunchGrid stage) grid)) :ruleset allocation)
(rule ((PhaseDomain stage extent width) (= count (StaticCapacityBound extent)) (= (PhaseGrid stage) (AutomaticGrid)))
      ((set (LaunchGrid stage) (FixedGrid (min 65535 (max 1 (/ (+ count (- width 1)) width))) 1 1))) :ruleset readout)
(rule ((InvocationValue op))
      ((ResultSlot op 0)
       (set (CapacityExtent (Result op 0)) (Fixed 1)) (FreshValue (Result op 0))
       (set (LiveLength (Result op 0)) (Fixed 1))
       (set (ResultRead op 0) (ReadElement (Result op 0)))
       (set (BufferSlot op "scalar" 0) (Result op 0))) :ruleset allocation)
(rule ((ArrayResult op i t) (= n (InputDomain op)))
      ((ElementType (Result op i) t) (set (CapacityExtent (Result op i)) n)
       (set (ResultRead op i) (ReadView (Result op i)))
       (set (LiveLength (Result op i)) n) (FreshValue (Result op i))) :ruleset allocation)
(rule ((TotalResult op i t))
      ((ElementType (Result op i) t) (set (CapacityExtent (Result op i)) (Fixed 1))
       (set (LiveLength (Result op i)) (Fixed 1))
       (set (ResultRead op i) (ReadElement (Result op i)))
       (FreshValue (Result op i))) :ruleset allocation)
(rule ((FilterResult op t) (= n (InputDomain op)))
      ((ElementType (Result op 0) t) (set (CapacityExtent (Result op 0)) n)
       (set (LiveLength (Result op 0)) (Stored (Result op 1)))
       (set (ResultRead op 0) (ReadView (Result op 0)))
       (set (ResultRead op 1) (ReadElement (Result op 1)))
       (set (CapacityExtent (Result op 1)) (Fixed 1)) (set (LiveLength (Result op 1)) (Fixed 1))
       (FreshValue (Result op 0)) (FreshValue (Result op 1))) :ruleset allocation)
(rule ((FilterResult op t) (CounterType count))
      ((ElementType (Result op 1) count)) :ruleset allocation)
; Bucket updates retain the destination; counts and overflow are fresh outputs.
(rule ((BucketResult op destination) (CounterType count))
      ((ElementType (Result op 1) count) (ElementType (Result op 2) count)
       (set (ResultRead op 1) (ReadView (Result op 1)))
       (set (ResultRead op 2) (ReadElement (Result op 2)))
       (set (CapacityExtent (Result op 1)) (Length destination)) (set (LiveLength (Result op 1)) (Length destination))
       (set (CapacityExtent (Result op 2)) (Fixed 1)) (set (LiveLength (Result op 2)) (Fixed 1))
       (FreshValue (Result op 1)) (FreshValue (Result op 2))) :ruleset allocation)
(rule ((UpdatedResult op i source))
      ((set (SameBacking (Result op i)) source)
       (set (CapacityExtent (Result op i)) (Length source))
       (set (LiveLength (Result op i)) (Length source))
       (set (ResultRead op i) (ReadView (Result op i)))) :ruleset allocation)
; Value destinations receive independent storage with the destination's shape,
; not the number of updates. Initialization completes before scatter writes.
(rule ((InitializedResult op i t n))
      ((ElementType (Result op i) t) (set (CapacityExtent (Result op i)) n)
       (set (ResultRead op i) (ReadView (Result op i)))
       (set (LiveLength (Result op i)) n) (FreshValue (Result op i))
       (set (BufferSlot op "output" 0) (Result op i))) :ruleset allocation)
(rule ((InitializedResult op i t n) (Produces stage (Result op i)))
      ((Materialize (Result op i))) :ruleset allocation)
(rule ((UpdatedResult op i source) (= (ValueRef source) old) (Produces stage (Result op i)))
      ((Clobbers stage old)) :ruleset allocation)

; Returning or reading a compacted view also requires its stored live length.
(rule ((Materialize value) (= (LiveLength value) (Stored count)))
      ((Materialize count)) :ruleset allocation)
(rule ((Needs stage value) (= (LiveLength value) (Stored count)))
      ((Needs stage count)) :ruleset allocation)

(relation OutputCanAlias (i64))
; Kernel emission looks up these slots; only Allocation facts create storage.
(ruleset output-backings)
(rule ((ReturnArray output e) (= (ArrayView e) (ViewInfo resource offset length))
       (= (ConstantLogicalExtent offset) 0))
      ((OutputCanAlias output)) :ruleset output-backings)
(rule ((ReturnArray output e) (= (DerivedView e) false))
      ((OutputCanAlias output)) :ruleset output-backings)
(rule ((ReturnScalar output t))
      ((ElementType (Output output) t) (set (CapacityExtent (Output output)) (Fixed 1))
       (FreshValue (Output output)) (Materialize (Output output))
       (set (OutputBacking output) (Output output)) (CopyOutput output)) :ruleset allocation)
(function OutputHasBacking (i64) bool :merge (or old new))
(rule ((ReturnArray output e)) ((set (OutputHasBacking output) false)) :ruleset allocation)
(rule ((= (OutputBacking output) storage)) ((set (OutputHasBacking output) true)) :ruleset allocation)
; Run after residency/allocation settles: array literals and other computed
; results need their own publication buffer only when no backing already exists.
(ruleset materialize-outputs)
(rule ((ReturnedArrayLayout output t n) (= (OutputHasBacking output) false))
      ((ElementType (Output output) t) (set (CapacityExtent (Output output)) n)
       (FreshValue (Output output)) (Materialize (Output output))
       (set (OutputBacking output) (Output output)) (CopyOutput output)) :ruleset materialize-outputs)
(rule ((ReturnArray output e) (= (OutputPinned output) false)
       (OutputCanAlias output) (= (ValueRef e) value) (= storage (Backing value)))
      ((set (OutputBacking output) storage)) :ruleset output-backings)
; A compiler allocation can take the declared output binding. A borrowed
; input/view must instead be copied, including its slice offset and length.
(rule ((ReturnArray output e) (= (ValueRef e) value) (= storage (Backing value))
       (OutputCanAlias output) (Allocation storage n))
      ((set (OutputBacking output) storage)) :ruleset output-backings)
(rule ((ReturnArray output e) (= (OutputPinned output) false) (OutputCanAlias output)
       (= (ValueRef e) (Source source)))
      ((set (Backing (Source source)) (Source source)) (set (OutputBacking output) (Source source))) :ruleset output-backings)
(rule ((TotalResult op i t)) ((set (BufferSlot op "total" i) (Result op i))) :ruleset allocation)
(rule ((FilterResult op t))
      ((set (BufferSlot op "output" 0) (Result op 0)) (set (BufferSlot op "length" 0) (Result op 1))) :ruleset allocation)
(rule ((BucketResult op e))
      ((set (BufferSlot op "counts" 0) (Result op 1)) (set (BufferSlot op "overflow" 0) (Result op 2))) :ruleset allocation)
(rule ((= value (Temporary op name i)) (= n (CapacityExtent value)))
      ((set (BufferSlot op name i) value)
       (set (LiveLength value) n)) :ruleset allocation)

(rule ((UninitializedResult op i t n))
      ((ElementType (Result op i) t) (set (CapacityExtent (Result op i)) n)
       (set (ResultRead op i) (ReadView (Result op i)))
       (set (LiveLength (Result op i)) n) (FreshValue (Result op i))
       (set (BufferSlot op "output" 0) (Result op i))) :ruleset allocation)
(rule ((UninitializedResult op i t n) (Requires site (Result op i))) ((Materialize (Result op i))) :ruleset allocation)
(rule ((UninitializedResult op i t n) (Produces stage (Result op i))) ((Materialize (Result op i))) :ruleset allocation)

; Slices retain offsets that the published result ABI cannot yet describe.
(relation WholeValue (SourceValue ValueKey))
; Storage reuse.
; Optional reuse never adds dependencies between independent dispatches.
; Finish read/order proofs and blockers before choosing inputs and output slots.
(ruleset reuse)
(rule ((ParameterValue e)) ((WholeValue e (Source e))) :ruleset reuse)
(rule ((DirectResult e op i)) ((WholeValue e (Result op i))) :ruleset reuse)
(rule ((FlowProjection e tuple i) (ResultTuple tuple op) (ResultSlot op i))
      ((WholeValue e (Result op i))) :ruleset reuse)
(rule ((FlowForward e source) (WholeValue source value))
      ((WholeValue e value)) :ruleset reuse)

; A whole input fits its own domain, or another input with the same live length.
(relation FitsInput (OperationKey SourceValue))
(rule ((= (InputDomain op) (Length e))) ((FitsInput op e)) :ruleset reuse)
(rule ((= (InputDomain op) (Length first)) (FixedInputLength first n)
       (Operand op "input" e) (FixedInputLength e n))
      ((FitsInput op e)) :ruleset reuse)
(rule ((= (InputDomain op) (Fixed n)) (Operand op "input" e) (FixedInputLength e n))
      ((FitsInput op e)) :ruleset reuse)
(rule ((= n (InputDomain op)) (Operand op "input" e) (WholeValue e old) (= n (LiveLength old)))
      ((FitsInput op e)) :ruleset reuse)
(rule ((= (InputDomain op) (Length first)) (WholeValue first first-value) (= n (LiveLength first-value))
       (Operand op "input" e) (WholeValue e old) (= n (LiveLength old)))
      ((FitsInput op e)) :ruleset reuse)

; Scatter can reuse its destination, never an arbitrary update input.
(relation ReuseResult (OperationKey i64 TypeKey))
(rule ((ArrayResult op i t)) ((ReuseResult op i t)) :ruleset reuse)
(relation ReuseOperand (OperationKey SourceValue))
(rule ((ArrayResult op i t) (Operand op "input" e) (FitsInput op e))
      ((ReuseOperand op e)) :ruleset reuse)
(rule ((InitializedResult op i t (Length destination)))
      ((ReuseResult op i t) (ReuseOperand op destination)) :ruleset reuse)
; Check each writer/input pair once, independently of the number of outputs.
(relation ReuseType (OperationKey TypeKey))
(rule ((ReuseResult op i t) (Materialize (Result op i))) ((ReuseType op t)) :ruleset reuse)
; Maps load before storing each element. Scans preserve their input through
; chunks and combine, then write the final output in the offsets phase.
(function ReuseWriter (OperationKey) StageKey :no-merge)
(rule ((= (Plan op) (Elements)) (FirstPhase op writer))
      ((set (ReuseWriter op) writer)) :ruleset reuse)
(rule ((= (Plan op) (Prefixes)) (LastPhase op writer))
      ((set (ReuseWriter op) writer)) :ruleset reuse)
(rule ((= (Plan op) (Scatter)) (LastPhase op writer))
      ((set (ReuseWriter op) writer)) :ruleset reuse)
; Ownership is a property of the input value, not the source operation whose
; output may disappear during fusion. Final shape and reads are checked here.
(function ReuseBlocked (StageKey SourceValue) bool :merge (or old new))
(relation ReuseAlias (StageKey SourceValue ValueKey))
(relation OwnedInput (OperationKey TypeKey SourceValue))
(relation ReuseBoundary (StageKey StageKey))
(rule ((= writer (ReuseWriter op)) (Phase writer region)
       (ReuseType op t) (ReuseOperand op e) (WholeValue e old)
       (FreshValue old) (ElementType old t) (Produces producer old) (Phase producer region))
      ((ReuseAlias writer e old) (set (ReuseBlocked writer e) false)
       (ReuseBoundary writer writer) (OwnedInput op t e)) :ruleset reuse)
(rule ((= writer (ReuseWriter op)) (Phase writer region) (ReuseType op t)
       (ReuseOperand op e) (WholeValue e (Source source))
       (ReusableSource source t region))
      ((ReuseAlias writer e (Source source)) (set (ReuseBlocked writer e) false)
       (ReuseBoundary writer writer) (OwnedInput op t e)) :ruleset reuse)
; Walk only this recipe's bounded phase graph, not the whole dispatch graph.
; Finishing before any of these boundaries also finishes before the writer.
(rule ((ReuseBoundary (Stage op writer) (Stage op after)) (PhaseLink op before after))
      ((ReuseBoundary (Stage op writer) (Stage op before))) :ruleset reuse)

; Follow authored aliases in both directions, scoped to actual candidates.
; Every alias and read inherits candidacy, so consumers need no candidate join.
(rule ((ReuseAlias writer e old) (= source (SameBacking alias)) (= (ValueRef source) old))
      ((ReuseAlias writer e alias)) :ruleset reuse)
(rule ((ReuseAlias writer e alias) (= source (SameBacking alias)) (= (ValueRef source) old))
      ((ReuseAlias writer e old)) :ruleset reuse)

; Length-only demands do not observe contents. Keep hidden scalar content
; dependencies separate from Needs, which also includes descriptor-only uses.
(relation ReuseRead (StageKey SourceValue UseKey))
(rule ((ReuseAlias writer e alias)
       (Requires (InStage reader) alias) (!= reader writer))
      ((ReuseRead writer e (InStage reader))) :ruleset reuse)
(rule ((ReuseAlias writer e alias)
       (DispatchGroupContentNeed (Stage op "scalar") alias) (!= (Stage op "scalar") writer))
      ((ReuseRead writer e (InStage (Stage op "scalar")))) :ruleset reuse)
(rule ((ReuseAlias writer e alias) (Requires (InOperation op) alias))
      ((ReuseRead writer e (InOperation op))) :ruleset reuse)
(function ReadFinished (StageKey UseKey) bool :merge (or old new))
(rule ((ReuseRead writer e site))
      ((set (ReadFinished writer site) false)) :ruleset reuse)
; Input-reading phases of this recipe finish before its final writer.
(rule ((ReuseRead writer e (InStage reader)) (ReuseBoundary writer reader) (!= reader writer))
      ((set (ReadFinished writer (InStage reader)) true)) :ruleset reuse)
; Existing immediate dependencies and complete recipes certify finished reads.
; Do not build a transitive closure over the dispatch graph.
(rule ((ReuseRead writer e (InStage reader))
       (ReuseBoundary writer boundary) (DispatchDependency reader boundary))
      ((set (ReadFinished writer (InStage reader)) true)) :ruleset reuse)
(rule ((ReuseRead writer e (InStage (Stage op name)))
       (LastPhase op last) (ReuseBoundary writer boundary) (DispatchDependency last boundary))
      ((set (ReadFinished writer (InStage (Stage op name))) true)) :ruleset reuse)
(rule ((ReuseRead writer e (InStage (Stage op name)))
       (ReuseBoundary writer boundary) (DispatchWaitsFor boundary (End op)))
      ((set (ReadFinished writer (InStage (Stage op name))) true)) :ruleset reuse)
(rule ((ReuseRead writer e (InOperation op))
       (ReuseBoundary writer boundary) (DispatchWaitsFor boundary (End op)))
      ((set (ReadFinished writer (InOperation op)) true)) :ruleset reuse)
(ruleset reuse-blockers)
(rule ((ReuseRead writer e site)
       (= (ReadFinished writer site) false))
      ((set (ReuseBlocked writer e) true)) :ruleset reuse-blockers)

(rule ((ReuseAlias writer e alias) (Escapes alias))
      ((set (ReuseBlocked writer e) true)) :ruleset reuse)
; Authored updates may return slices even when the result is a whole value.
(rule ((ReuseAlias writer e alias) (= source (SameBacking alias)) (= (SourceSlice source) (SliceInfo base start end)))
      ((set (ReuseBlocked writer e) true)) :ruleset reuse)
; Captures and shifted input aliases may read elements already overwritten.
(rule ((ReuseAlias (Stage op name) e alias)
       (= recipe (Plan op)) (!= recipe (Scatter))
       (Operand op "environment" capture) (References capture (Contents alias)))
      ((set (ReuseBlocked (Stage op name) e) true)) :ruleset reuse)
(rule ((ReuseAlias (Stage op name) e alias)
       (Operand op "input" other) (!= other e) (References other (Contents alias)))
      ((set (ReuseBlocked (Stage op name) e) true)) :ruleset reuse)
; Explicit output bindings require a separate destination. A surviving result's
; original input is a preference only; eliminated producers cannot lose permission.
(function PinnedResult (ValueKey) bool :merge (or old new))
(function HasPreferredReuse (ValueKey) bool :merge (or old new))
(rule ((FreshValue value))
      ((set (PinnedResult value) false) (set (HasPreferredReuse value) false)) :ruleset reuse)
(rule ((AbiOutputBinding output set binding) (ReturnArray output result) (= (ValueRef result) value))
      ((set (PinnedResult value) true)) :ruleset reuse)

; Choose one safe owned input per element type before joining output slots.
; Additional compatible inputs remain separate rather than growing a Cartesian
; product of inputs and outputs to optimize this optional choice.
(function OwnedInputChoice (OperationKey TypeKey) i64 :merge (min old new))
(ruleset reuse-owned-input)
(rule ((OwnedInput op t input) (= id (SourceOrdinal input)) (= writer (ReuseWriter op))
       (= (ReuseBlocked writer input) false))
      ((set (OwnedInputChoice op t) id)) :ruleset reuse-owned-input)
(function PreferredInputChoice (ValueKey) i64 :merge (min old new))
(rule ((PreferredReuse (Result op i) input) (ReuseResult op i t) (OwnedInput op t input)
       (= writer (ReuseWriter op)) (= (ReuseBlocked writer input) false)
       (= id (SourceOrdinal input)))
      ((set (PreferredInputChoice (Result op i)) id)
       (set (HasPreferredReuse (Result op i)) true)) :ruleset reuse-owned-input)
(function ReuseInput (ValueKey) i64 :merge (min old new))
(ruleset reuse-input)
(rule ((= id (PreferredInputChoice (Result op i)))
       (Materialize (Result op i)) (= (PinnedResult (Result op i)) false))
      ((set (ReuseInput (Result op i)) id)) :ruleset reuse-input)
(rule ((= id (OwnedInputChoice op t)) (ReuseResult op i t) (Materialize (Result op i))
       (= (HasPreferredReuse (Result op i)) false) (= (PinnedResult (Result op i)) false))
      ((set (ReuseInput (Result op i)) id)) :ruleset reuse-input)
; The lowest eligible output slot wins. Reads exclude other writers, so this
; aggregation needs no all-pairs conflict join and introduces no ordering.
(function ReuseLost (ValueKey) bool :merge (or old new))
(function ReuseOutput (ValueKey StageKey) i64 :merge (min old new))
(ruleset reuse-output)
(rule ((= id (ReuseInput (Result op i))) (Produces writer (Result op i))
       (= id (SourceOrdinal input)) (ReuseAlias writer input alias))
      ((set (ReuseOutput alias writer) i) (set (ReuseLost (Result op i)) false)) :ruleset reuse-output)
(rule ((= id (ReuseInput (Result op i))) (Produces writer (Result op i))
       (= id (SourceOrdinal input)) (ReuseAlias writer input alias) (= winner (ReuseOutput alias writer)) (< winner i))
      ((set (ReuseLost (Result op i)) true)) :ruleset reuse-output)
(ruleset select-reuse)
(rule ((= id (ReuseInput value)) (= (ReuseLost value) false) (= id (SourceOrdinal input)))
      ((set (StorageFor value) (Reuse input)) (set (ReuseSelected value) true)) :ruleset select-reuse)
(ruleset select-allocation)
(rule ((FreshValue value) (= (ReuseSelected value) false))
      ((set (StorageFor value) (Allocate))) :ruleset select-allocation)

; Inputs and captures must not reread a reused destination.
(rule ((PlannedOperation original owner plan region) (ScatterReadValue original read)
       (ReuseAlias (Stage owner name) e alias) (= (ValueRef read) alias))
      ((set (ReuseBlocked (Stage owner name) e) true)) :ruleset reuse)

(rule ((Allocation value n) (ElementType value (TypeId ty)) (= (HasStorageShape value) false))
      ((PlannedBuffer value ty n)) :ruleset readout)
(rule ((Allocation value logical) (= (StorageLayout value) (FlatStorage (TypeId ty) shape n)))
      ((PlannedBuffer value ty n)) :ruleset readout)
(rule ((ElementType value ty)) ((set (HasStorageShape value) false)) :ruleset allocation)
(rule ((= layout (StorageLayout value))) ((set (HasStorageShape value) true)) :ruleset allocation)
