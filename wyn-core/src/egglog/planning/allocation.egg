(ruleset memory-reuse)
(ruleset memory-reuse-propose)
(ruleset memory-reuse-select)
(sort ReuseNames (Set ValueName))
(function ReuseCandidates (Function ValueName) ReuseNames :merge (set-union old new))
(function ReuseDestinations (Function) ReuseNames :merge (set-union old new))
(relation AssignReuse (Function ReuseNames ReuseNames))
(function ReuseInputs (Function ValueName) ReuseNames :merge (set-union old new))
(function ReuseSafe (Function ValueName ValueName) bool :merge (and old new))
(relation ReuseCandidate (Function ValueName ValueName Stm))
(relation AllocationFunction (Function))
(ruleset memory-allocation-current)
(rule ((CurrentProgram program) (ProgramFunction program function)) ((AllocationFunction function)) :ruleset memory-allocation-current)
(rule ((CurrentProgram program) (ProgramExternal program external) (= function (ScopeRoot (ExternalScope external))))
      ((AllocationFunction function)) :ruleset memory-allocation-current)
(ruleset memory-allocation)
(function AllocationSpace (ScopeContext) Space :no-merge)
(function ArrayStorage (Function ValueName) MemBind :no-merge)
(function BlockCapacity (Function BlockName) IndexExp :no-merge)
(function LogicalInfo (Function ValueName) ValueInfo :no-merge)
(relation ExistentialArray (Function ValueName))
(relation FreshArray (ScopeContext StatementId ValueName ElementType Shape))
(function DenseDimensions (Shape) LMADDims :no-merge)
(function ElementCount (Shape) IndexExp :no-merge)
(function ElementBytes (ElementType) i64 :no-merge)
(function ElementSize (ElementType) i64 :no-merge)
(function ElementAlignment (ElementType) i64 :no-merge)
(relation ProductLayoutAt (ElementTypes i64 i64 i64))
(function PrimitiveBytes (PrimType) i64 :no-merge)
(function WitnessDimensions (ValueName Shape) LMADDims :no-merge)
(function WitnessPrefix (ValueName Shape i64) LMADDims :no-merge)
(function DescriptorBindingPrefix (ValueName LMADDims i64) Pattern :no-merge)
(function DescriptorOperands (Function ValueName) Operands :no-merge)
(function DescriptorOperandPrefix (LMADDims i64) Operands :no-merge)
(relation DenseShape (Shape))
(relation NonlocalResult (Exp))
(relation ArrayAlias (Function ValueName ValueName))
(function SliceLayout (LMAD Slices) LMAD :no-merge)
(relation SliceLayoutAt (LMAD Slices i64 IndexExp LMADDims))
(sort AxesUsed (Set i64))
(relation PermuteLayoutAt (LMAD Permutation i64 LMADDims AxesUsed))
(function PermuteLayout (LMAD Permutation) LMAD :no-merge)
(function LayoutShape (LMADDims i64) Shape :no-merge)
(function NonunitDims (LMADDims i64) LMADDims :no-merge)
(relation UnitReshapeAt (LMADDims Shape i64 i64 LMADDims bool))
(function UnitReshape (LMADDims Shape) LMADDims :no-merge)
(function UnitReshapeValid (LMADDims Shape) bool :no-merge)
(relation StridedLayoutAt (LMADDims i64 IndexExp bool))
(function StridedLayout (LMADDims) bool :no-merge)
(function LayoutBaseStride (LMADDims) IndexExp :no-merge)
(function ReshapeDims (LMADDims Shape i64) LMADDims :no-merge)
(function ReshapeLayout (LMAD Shape) LMAD :no-merge)
(function ReshapeNeedsCopy (LMAD Shape) bool :no-merge)
(ruleset memory-elaborate)
(function Witnessed (Function ValueName) bool :merge (or old new))
(function AllocateBinding (ScopeContext Binding) Pattern :no-merge)
(relation AllocateBindingDemand (ScopeContext Binding))
(function PackedOperand (Function Operand) Operands :no-merge)
(function AllocateParam (ScopeContext Param) Params :no-merge)
(relation AllocateParamDemand (ScopeContext Param))
(function AllocateParamAt (ScopeContext Param Pattern i64) Params :no-merge)
(function PackOperand (Function Operand i64) Operands :no-merge)
(relation PackOperandDemand (Function Operand i64))
(function AllocateResults (ScopeContext Results) Results :no-merge)
(relation AllocateResultsDemand (ScopeContext Results))
(relation AllocateResultsAt (ScopeContext Results i64 i64 Results))
(function ResultWidth (ScopeContext Results i64) i64 :no-merge)
(function AllocateCallArguments (ScopeContext FunctionName Arguments) Arguments :no-merge)
(relation AllocateCallArgumentsDemand (ScopeContext FunctionName Arguments))
(relation AllocateCallArgumentsAt (ScopeContext FunctionName Arguments i64 i64 Arguments))
(function ArgumentWidth (ScopeContext FunctionName i64) i64 :no-merge)
(function BindingWidth (Binding) i64 :no-merge)
(function AllocateMerge (ScopeContext Merge) Merges :no-merge)
(relation AllocateMergeDemand (ScopeContext Merge))
(function AllocateMergeAt (ScopeContext Merge Params Operands i64) Merges :no-merge)
(function ReturnSlot (ReturnInfos i64) i64 :no-merge)
(function ReturnWidth (ReturnInfo) i64 :no-merge)
(relation AllocateReturnInfosDemand (ScopeContext ReturnInfos))
(function AllocateReturnInfos (ScopeContext ReturnInfos) ReturnInfos :no-merge)
(function AllocateReturnPrefix (ScopeContext ReturnInfos i64) ReturnInfos :no-merge)
(function AllocateReturn (ScopeContext ReturnInfos i64 ReturnInfo) ReturnInfos :no-merge)
(function AllocateExtIndex (ReturnInfos ExtIndex) ExtIndex :no-merge)
(relation AllocateExtIndexDemand (ReturnInfos ExtIndex))
(function ReturnArrayPrefix (ScopeContext ReturnInfos i64 ExtShape i64) ReturnInfos :no-merge)
(function ReturnDimensions (ReturnInfos i64 ExtShape i64) ExtDims :no-merge)
(relation AllocateStmDemand (ScopeContext Stm))
(function AllocateStm (ScopeContext Stm) Stms :no-merge)
(function AllocationPrefix (ScopeContext StatementId Pattern i64) Stms :no-merge)
(function OwnsMemory (ScopeContext StatementId ValueName) bool :merge (or old new))
(relation AllocateBodyDemand (ScopeContext Body))
(function AllocateBody (ScopeContext Body) Body :no-merge)
(relation AllocateLambdaDemand (ScopeContext Lambda))
(function AllocateLambda (ScopeContext Lambda) Lambda :no-merge)
(relation AllocateExpDemand (ScopeContext StatementId Exp))
(function AllocateExp (ScopeContext StatementId Exp) Exp :no-merge)
(function AllocateAccInputPrefix (ScopeContext StatementId AccInputs i64) AccInputs :no-merge)
(function AllocateParallelPrefix (ScopeContext ParallelResults i64) ParallelResults :no-merge)
(relation AllocateProgramDemand (Program))
(function AllocateProgram (Program) Program :no-merge)
(function AllocateFunctionPrefix (Program Functions i64) Functions :no-merge)
(ruleset memory-allocation-demand)
(ruleset memory-allocation-commit)
(function AllocateExternalPrefix (Program Externals i64) Externals :no-merge)
; Allocation elaboration preserves the statement language. These tables are
; pass-local derivations of an immutable input function; the rewritten bindings
; become authoritative when its program root is replaced.

(rule ((AllocationFunction function) (CheckFunction function) (= function (DefineFunction name params returns body)) (= (FunctionHost function) true))
      ((set (AllocationSpace (FunctionScope function)) (DeviceSpace))) :ruleset memory-allocation)
(rule ((AllocationFunction function) (CheckFunction function) (= function (DefineFunction name params returns body)) (= (FunctionHost function) false))
      ((set (AllocationSpace (FunctionScope function)) (PrivateSpace))) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern expression available) (= space (AllocationSpace context))
       (= expression (If condition returns yes no)))
      ((set (AllocationSpace (NestedScope context id 0)) space)
       (set (AllocationSpace (NestedScope context id 1)) space)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (Loop merges form returns body) available) (= space (AllocationSpace context)))
      ((set (AllocationSpace (NestedScope context id 0)) space)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (WithAcc inputs body) available) (= space (AllocationSpace context)))
      ((set (AllocationSpace (NestedScope context id 0)) space)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (Parallel execution domain body) available))
      ((set (AllocationSpace (NestedScope context id 0)) (PrivateSpace))) :ruleset memory-allocation)
(rule ((= context (ReducerScope parent i)))
      ((set (AllocationSpace context) (PrivateSpace))) :ruleset memory-allocation)
(rule ((AccInputAt context id inputs available i) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (CombineWrites combine))))
      ((set (AllocationSpace (NestedScope context id (+ i 1))) (PrivateSpace))) :ruleset memory-allocation)
(rule ((AllocationFunction function) (ContainsBinding (FunctionRoot function) (BindValue name info)))
      ((set (LogicalInfo function name) info)) :ruleset memory-allocation)

(rule ((= shape (vec-of)))
      ((set (DenseDimensions shape) (vec-of)) (set (ElementCount shape) (IndexConstant 1))) :ruleset memory-allocation)
(rule ((= info (ArrayValue element shape)) (> (vec-length shape) 0))
      ((DenseShape shape)) :ruleset memory-allocation)
(rule ((DenseShape shape) (> (vec-length shape) 0)) ((DenseShape (vec-remove shape 0))) :ruleset memory-allocation)
(rule ((DenseShape shape) (> (vec-length shape) 0) (= rest (vec-remove shape 0))
       (= stride (ElementCount rest)) (= dims (DenseDimensions rest)))
      ((set (ElementCount shape) (IndexMul (vec-get shape 0) stride))
       (set (DenseDimensions shape) (vec-append (vec-of (Dim stride (vec-get shape 0))) dims))) :ruleset memory-allocation)
(rule ((= element (ScalarElement primitive)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementSize element) bytes) (set (ElementAlignment element) (max 1 bytes))) :ruleset memory-allocation)
(rule ((= element (VectorElement primitive width)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementSize element) (* bytes width))) :ruleset memory-allocation)
(rule ((= element (VectorElement primitive width)) (= bytes (PrimitiveBytes primitive)) (!= width 3))
      ((set (ElementAlignment element) (* bytes width))) :ruleset memory-allocation)
(rule ((= element (VectorElement primitive 3)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementAlignment element) (* bytes 4))) :ruleset memory-allocation)
(rule ((= element (MatrixElement primitive rows columns))) ((VectorElement primitive rows)) :ruleset memory-allocation)
(rule ((= element (MatrixElement primitive rows columns)) (= stride (ElementBytes (VectorElement primitive rows)))
       (= alignment (ElementAlignment (VectorElement primitive rows))))
      ((set (ElementSize element) (* stride columns)) (set (ElementAlignment element) alignment)) :ruleset memory-allocation)
(rule ((= element (ProductElement fields))) ((ProductLayoutAt fields 0 0 1)) :ruleset memory-allocation)
(rule ((ProductLayoutAt fields i offset alignment) (< i (vec-length fields))
       (= field (vec-get fields i)) (= size (ElementSize field)) (= align (ElementAlignment field)))
      ((ProductLayoutAt fields (+ i 1) (+ (* (/ (+ offset (- align 1)) align) align) size) (max alignment align))) :ruleset memory-allocation)
(rule ((= element (ProductElement fields)) (ProductLayoutAt fields (vec-length fields) size alignment))
      ((set (ElementSize element) (* (/ (+ size (- alignment 1)) alignment) alignment))
       (set (ElementAlignment element) alignment)) :ruleset memory-allocation)
(rule ((= size (ElementSize element)) (= alignment (ElementAlignment element)))
      ((set (ElementBytes element) (* (/ (+ size (- alignment 1)) alignment) alignment))) :ruleset memory-allocation)

(rule ((CheckStatement context id pattern expression available) (= function (ScopeRoot context)) (AllocationFunction function)
       (WalkPattern pattern i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name (ArrayValue element shape)))
       (= (WritesResult expression) true))
      ((FreshArray context id name element shape)) :ruleset memory-allocation)
(sort AllocationStatements (Set Stm))
(function HoistedAllocations (ScopeContext StatementId) AllocationStatements :merge (set-union old new))
(function HoistedPrefix (AllocationStatements i64) Stms :no-merge)
(rule ((CheckStatement context id pattern expression available))
      ((set (HoistedAllocations context id) (set-empty))) :ruleset memory-allocation)
(rule ((FreshArray context id name element shape) (= function (ScopeRoot context))
       (= (ExpandedArray function name) true) (ExpandableStorage function name owner kernel instances ordinal)
       (= dims (DenseDimensions shape)) (= count (ElementCount shape)) (= bytes (ElementBytes element))
       (WalkPattern pattern i) (< i (vec-length pattern))
       (CheckStatement context id pattern expression available) (= (vec-get pattern i) (BindValue name info)))
      ((let capacity (IndexMul instances (IndexMul count (IndexConstant bytes))))
       (set (ArrayStorage function name) (ArrayIn (ArrayMemory name) (Layout (IndexMul ordinal count) dims)))
       (set (BlockCapacity function (ArrayMemory name)) capacity)
       (set (HoistedAllocations owner kernel) (set-of
          (Let (AllocationTag id i) (vec-of (BindBlock (ArrayMemory name) capacity))
              (vec-of) (Alloc (DeviceSpace) capacity))))) :ruleset memory-allocation)

; Parameters and nonlocal results quantify their layout once. Calls, branches,
; and loops use the same witness ordering: capacity, block, offset, strides.
(rule ((CheckLambda context (FunctionBody params returns body) outer) (= function (ScopeRoot context)) (AllocationFunction function)
       (WalkParams params i) (< i (vec-length params))
       (= (vec-get params i) (Parameter (BindValue name (ArrayValue element shape)) diet)))
      ((ExistentialArray function name)) :ruleset memory-allocation)
(rule ((CheckMergeAt context merges available i) (< i (vec-length merges)) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (vec-get merges i) (Carry (Parameter (BindValue name (ArrayValue element shape)) diet) initial)))
      ((ExistentialArray function name)) :ruleset memory-allocation)
(rule ((= expression (If condition returns yes no))) ((NonlocalResult expression)) :ruleset memory-allocation)
(rule ((= expression (Loop merges form returns body))) ((NonlocalResult expression)) :ruleset memory-allocation)
(rule ((= expression (Call function arguments returns))) ((NonlocalResult expression)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern expression available) (= function (ScopeRoot context)) (AllocationFunction function) (NonlocalResult expression)
       (WalkPattern pattern i) (< i (vec-length pattern)) (= (vec-get pattern i) (BindValue name (ArrayValue element shape))))
      ((ExistentialArray function name)) :ruleset memory-allocation)
(rule ((ExistentialArray function name) (= (LogicalInfo function name) (ArrayValue element shape)))
      ((set (WitnessPrefix name shape 0) (vec-of))) :ruleset memory-allocation)
(rule ((= prefix (WitnessPrefix name shape i)) (< i (vec-length shape)))
      ((set (WitnessPrefix name shape (+ i 1))
         (vec-push prefix (Dim (IndexValue (LayoutWitness name (StrideField i))) (vec-get shape i))))) :ruleset memory-allocation)
(rule ((= dims (WitnessPrefix name shape (vec-length shape))))
      ((set (WitnessDimensions name shape) dims)) :ruleset memory-allocation)
(rule ((ExistentialArray function name) (= (LogicalInfo function name) (ArrayValue element shape))
       (= dims (WitnessDimensions name shape)))
      ((set (ArrayStorage function name) (ArrayIn (ArrayMemory name) (Layout (IndexValue (LayoutWitness name (OffsetField))) dims)))
       (set (BlockCapacity function (ArrayMemory name)) (IndexValue (LayoutWitness name (CapacityField))))) :ruleset memory-allocation)

; Alias-producing operations preserve the source block. Only the layout changes.
(rule ((CheckStatement context id vector-pattern-0 (Use (ValueOperand (Var source))) available)
       (= function (ScopeRoot context)) (AllocationFunction function)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape)))) ((ArrayAlias function name source)) :ruleset memory-allocation)
(rule ((CheckStatement context id vector-pattern-0 (Update mode source slices value) available)
       (= function (ScopeRoot context)) (AllocationFunction function)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape)))) ((ArrayAlias function name source)) :ruleset memory-allocation)
(rule ((ArrayAlias function name source) (= storage (ArrayStorage function source)))
      ((set (ArrayStorage function name) storage)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (WithAcc inputs body) available) (= function (ScopeRoot context)) (AllocationFunction function)
       (= arrays (AccumulatorArrays inputs)) (WalkPattern pattern i) (< i (vec-length pattern)) (< i (vec-length arrays))
       (= (vec-get pattern i) (BindValue name (ArrayValue element shape))))
      ((ArrayAlias function name (vec-get arrays i))) :ruleset memory-allocation)

(rule ((CheckStatement context id vector-pattern-0 (View source slices) available)
       (= function (ScopeRoot context)) (AllocationFunction function) (= (ArrayStorage function source) (ArrayIn block layout))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape))))
      ((SliceLayoutAt layout slices 0 (IndexConstant 0) (vec-of))) :ruleset memory-allocation)
(rule ((SliceLayoutAt (Layout base dims) slices i shift output) (< i (vec-length dims)) (>= i (vec-length slices)))
      ((SliceLayoutAt (Layout base dims) slices (+ i 1) shift (vec-push output (vec-get dims i)))) :ruleset memory-allocation)
(rule ((SliceLayoutAt (Layout base dims) slices i shift output) (< i (vec-length dims)) (< i (vec-length slices))
       (= (vec-get dims i) (Dim stride length)) (= (vec-get slices i) (At index)))
      ((SliceLayoutAt (Layout base dims) slices (+ i 1) (IndexAdd shift (IndexMul stride index)) output)) :ruleset memory-allocation)
(rule ((SliceLayoutAt (Layout base dims) slices i shift output) (< i (vec-length dims)) (< i (vec-length slices))
       (= (vec-get dims i) (Dim stride length)) (= (vec-get slices i) (Slice start count step)))
      ((SliceLayoutAt (Layout base dims) slices (+ i 1) (IndexAdd shift (IndexMul stride start))
          (vec-push output (Dim (IndexMul stride step) count)))) :ruleset memory-allocation)
(rule ((SliceLayoutAt layout slices i shift output) (= layout (Layout base dims)) (= i (vec-length dims)))
      ((set (SliceLayout layout slices) (Layout (IndexAdd base shift) output))) :ruleset memory-allocation)
(rule ((CheckStatement context id vector-pattern-0 (View source slices) available)
       (= function (ScopeRoot context)) (AllocationFunction function) (= (ArrayStorage function source) (ArrayIn block layout)) (= next (SliceLayout layout slices))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape))))
      ((set (ArrayStorage function name) (ArrayIn block next))) :ruleset memory-allocation)

 ; Layout transforms are derived from the source descriptor, including strides.
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayInfo element storage))))
      ((set (ArrayStorage function name) storage)) :ruleset memory-allocation)
(rule ((ContainsBinding (FunctionRoot function) (BindBlock block bytes)))
      ((set (BlockCapacity function block) bytes)) :ruleset memory-allocation)


(rule ((CheckStatement context id pattern (Permute source permutation) available) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block layout)) (= layout (Layout offset dims)) (= (vec-length dims) (vec-length permutation)))
      ((PermuteLayoutAt layout permutation 0 (vec-of) (set-empty))) :ruleset memory-allocation)
(rule ((PermuteLayoutAt layout permutation i output used) (= layout (Layout offset dims)) (< i (vec-length permutation))
       (= axis (vec-get permutation i)) (>= axis 0) (< axis (vec-length dims)) (set-not-contains used axis))
      ((PermuteLayoutAt layout permutation (+ i 1) (vec-push output (vec-get dims axis)) (set-insert used axis))) :ruleset memory-allocation)
(rule ((PermuteLayoutAt layout permutation i output used) (= layout (Layout offset dims)) (= i (vec-length permutation)))
      ((set (PermuteLayout layout permutation) (Layout offset output))) :ruleset memory-allocation)
(rule ((CheckStatement context id vector-pattern-0 (Permute source permutation) available)
       (= function (ScopeRoot context)) (AllocationFunction function) (= (ArrayStorage function source) (ArrayIn block layout)) (= next (PermuteLayout layout permutation))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape))))
      ((set (ArrayStorage function name) (ArrayIn block next))) :ruleset memory-allocation)

(rule ((= layout (Layout offset dims)))
      ((set (LayoutShape dims 0) (vec-of)) (set (NonunitDims dims 0) (vec-of))) :ruleset memory-allocation)
(rule ((= prefix (LayoutShape dims i)) (< i (vec-length dims)) (= (vec-get dims i) (Dim stride length)))
      ((set (LayoutShape dims (+ i 1)) (vec-push prefix length))) :ruleset memory-allocation)
(rule ((= prefix (NonunitDims dims i)) (< i (vec-length dims)) (= (vec-get dims i) (Dim stride length))
       (= (NormalizedIndex length) (IndexConstant 1)))
      ((set (NonunitDims dims (+ i 1)) prefix)) :ruleset memory-allocation)
(rule ((= prefix (NonunitDims dims i)) (< i (vec-length dims)) (= dim (vec-get dims i)) (= dim (Dim stride length))
       (= normalized (NormalizedIndex length)) (!= normalized (IndexConstant 1)))
      ((set (NonunitDims dims (+ i 1)) (vec-push prefix dim))) :ruleset memory-allocation)
; Layout equality follows scalar index definitions without rewriting binders or
; introducing a second shape authority.
(function ComputedIndex (Function ValueName) bool :merge (or old new))
(function IndexDefinition (Function ValueName) IndexExp :no-merge)
(function ResolvedIndex (Function IndexExp) IndexExp :no-merge)
(relation ResolveIndex (Function IndexExp))
(sort IndexFactors (MultiSet IndexExp))
(datatype IndexProduct (Product i64 IndexFactors))
(function ProductForm (IndexExp) IndexProduct :no-merge)
(relation ProductDemand (IndexExp))
(rule ((ProductDemand index) (= normalized (NormalizedIndex index)))
      ((ProductDemand normalized)) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexConstant n)))
      ((set (ProductForm index) (Product n (multiset-of)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexMul a b)))
      ((ProductDemand a) (ProductDemand b)) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexMul a b))
       (= (ProductForm (NormalizedIndex a)) (Product x xs))
       (= (ProductForm (NormalizedIndex b)) (Product y ys)) (!= x 0) (!= y 0))
      ((set (ProductForm index) (Product (* x y) (multiset-sum xs ys)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexValue name)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexAdd a b)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexSub a b)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexDiv a b)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexMod a b)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexMin a b)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(rule ((ProductDemand index) (= index (IndexMax a b)))
      ((set (ProductForm index) (Product 1 (multiset-of index)))) :ruleset memory-allocation)
(relation ReshapeCountMatches (LMAD Shape))
(rule ((ContainsValueName (FunctionRoot function) name))
      ((set (ComputedIndex function name) false)) :ruleset memory-origin)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (IndexOp expression)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32))))))
      ((set (ComputedIndex function name) true) (set (IndexDefinition function name) expression)) :ruleset memory-origin)
(rule ((ResolveIndex function (IndexConstant n)))
      ((set (ResolvedIndex function (IndexConstant n)) (IndexConstant n))) :ruleset memory-allocation)
(rule ((ResolveIndex function (IndexValue name)) (= (ComputedIndex function name) false))
      ((set (ResolvedIndex function (IndexValue name)) (IndexValue name))) :ruleset memory-allocation)
(rule ((ResolveIndex function (IndexValue name)) (= expression (IndexDefinition function name)))
      ((ResolveIndex function expression)) :ruleset memory-allocation)
(rule ((ResolveIndex function (IndexValue name)) (= expression (IndexDefinition function name)) (= resolved (ResolvedIndex function expression)))
      ((set (ResolvedIndex function (IndexValue name)) resolved)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (Reshape source shape) available) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block layout)) (= layout (Layout offset dims))
       (= oldshape (LayoutShape dims (vec-length dims))) (= oldcount (ElementCount oldshape)) (= newcount (ElementCount shape)))
      ((ResolveIndex function oldcount) (ResolveIndex function newcount)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (Reshape source shape) available) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block layout)) (= layout (Layout offset dims))
       (= oldshape (LayoutShape dims (vec-length dims))) (= oldcount (ElementCount oldshape)) (= newcount (ElementCount shape))
       (= left (ResolvedIndex function oldcount)) (= right (ResolvedIndex function newcount)))
      ((ProductDemand left) (ProductDemand right)) :ruleset memory-allocation)
(rule ((CheckStatement context id pattern (Reshape source shape) available) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block layout)) (= layout (Layout offset dims))
       (= oldshape (LayoutShape dims (vec-length dims))) (= oldcount (ElementCount oldshape)) (= newcount (ElementCount shape))
       (= left (ResolvedIndex function oldcount)) (= right (ResolvedIndex function newcount))
       (= count (ProductForm (NormalizedIndex left))) (= count (ProductForm (NormalizedIndex right))))
      ((ReshapeCountMatches layout shape)) :ruleset memory-allocation)

(rule ((CheckStatement context id pattern (Reshape source shape) available) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block (Layout offset dims))) (= oldshape (LayoutShape dims (vec-length dims))))
      ((DenseShape shape) (DenseShape oldshape) (UnitReshapeAt dims shape 0 0 (vec-of) true)) :ruleset memory-allocation)
; Unit axes carry no address information and can be inserted or removed freely.
(rule ((UnitReshapeAt dims shape i j output valid) (< i (vec-length shape))
       (= (NormalizedIndex (vec-get shape i)) (IndexConstant 1)))
      ((UnitReshapeAt dims shape (+ i 1) j (vec-push output (Dim (IndexConstant 0) (vec-get shape i))) valid)) :ruleset memory-allocation)
(rule ((UnitReshapeAt dims shape i j output valid) (< i (vec-length shape))
       (= length (NormalizedIndex (vec-get shape i))) (!= length (IndexConstant 1))
       (= old (NonunitDims dims (vec-length dims))) (< j (vec-length old)) (= (vec-get old j) (Dim stride oldlength))
       (= oldlength2 (NormalizedIndex oldlength)))
      ((UnitReshapeAt dims shape (+ i 1) (+ j 1) (vec-push output (Dim stride (vec-get shape i)))
         (and valid (not (bool-!= length oldlength2))))) :ruleset memory-allocation)
(rule ((UnitReshapeAt dims shape i j output valid) (< i (vec-length shape))
       (= length (NormalizedIndex (vec-get shape i))) (!= length (IndexConstant 1))
       (= old (NonunitDims dims (vec-length dims))) (>= j (vec-length old)))
      ((UnitReshapeAt dims shape (+ i 1) j (vec-push output (Dim (IndexConstant 0) (vec-get shape i))) false)) :ruleset memory-allocation)
(rule ((UnitReshapeAt dims shape i j output valid) (= i (vec-length shape)) (= old (NonunitDims dims (vec-length dims))))
      ((set (UnitReshape dims shape) output) (set (UnitReshapeValid dims shape) (and valid (bool-= j (vec-length old))))) :ruleset memory-allocation)

(rule ((= old (NonunitDims dims (vec-length dims))) (= (vec-length old) 0))
      ((set (LayoutBaseStride dims) (IndexConstant 1)) (StridedLayoutAt old 0 (IndexConstant 1) true)) :ruleset memory-allocation)
(rule ((= old (NonunitDims dims (vec-length dims))) (> (vec-length old) 0)
       (= (vec-get old (- (vec-length old) 1)) (Dim stride length)) (= base (NormalizedIndex stride)))
      ((set (LayoutBaseStride dims) base) (StridedLayoutAt old (vec-length old) base true)) :ruleset memory-allocation)
(rule ((StridedLayoutAt dims i expected valid) (> i 0) (= (vec-get dims (- i 1)) (Dim stride length)))
      ((ProductDemand stride) (ProductDemand expected)) :ruleset memory-allocation)
(rule ((StridedLayoutAt dims i expected valid) (> i 0) (= (vec-get dims (- i 1)) (Dim stride length))
       (= actual (ProductForm (NormalizedIndex stride))) (= normalized (ProductForm (NormalizedIndex expected)))
       (= stride-normal (NormalizedIndex stride)))
      ((StridedLayoutAt dims (- i 1) (IndexMul length expected)
         (and valid (and (not (bool-!= actual normalized)) (bool-!= stride-normal (IndexConstant 0)))))) :ruleset memory-allocation)
(rule ((= old (NonunitDims dims (vec-length dims))) (StridedLayoutAt old 0 expected valid))
      ((set (StridedLayout dims) valid)) :ruleset memory-allocation)
(rule ((= (UnitReshapeValid dims shape) true) (= output (UnitReshape dims shape)) (= layout (Layout offset dims)))
      ((set (ReshapeLayout layout shape) (Layout offset output)) (set (ReshapeNeedsCopy layout shape) false)) :ruleset memory-allocation)
(rule ((= (UnitReshapeValid dims shape) false) (= (StridedLayout dims) true))
      ((set (ReshapeDims dims shape 0) (vec-of))) :ruleset memory-allocation)
(rule ((= prefix (ReshapeDims dims shape i)) (< i (vec-length shape)) (= dense (DenseDimensions shape))
       (= (vec-get dense i) (Dim stride length)) (= base (LayoutBaseStride dims)))
      ((set (ReshapeDims dims shape (+ i 1)) (vec-push prefix (Dim (IndexMul stride base) length)))) :ruleset memory-allocation)
(rule ((= output (ReshapeDims dims shape (vec-length shape))) (= layout (Layout offset dims))
       (ReshapeCountMatches layout shape))
      ((set (ReshapeLayout layout shape) (Layout offset output)) (set (ReshapeNeedsCopy layout shape) false)) :ruleset memory-allocation)
(rule ((= (UnitReshapeValid dims shape) false) (= (StridedLayout dims) false) (= layout (Layout offset dims))
       (ReshapeCountMatches layout shape))
      ((set (ReshapeNeedsCopy layout shape) true)) :ruleset memory-allocation)
(rule ((CheckStatement context id vector-pattern-0 (Reshape source shape) available)
       (= function (ScopeRoot context)) (AllocationFunction function) (= (ArrayStorage function source) (ArrayIn block layout)) (= next (ReshapeLayout layout shape))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape))))
      ((set (ArrayStorage function name) (ArrayIn block next))) :ruleset memory-allocation)
(rule ((CheckStatement context id vector-pattern-0 (Reshape source shape) available)
       (= function (ScopeRoot context)) (AllocationFunction function) (= (ArrayStorage function source) (ArrayIn block layout)) (= (ReshapeNeedsCopy layout shape) true)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (BindValue name (ArrayValue element shape))))
      ((FreshArray context id name element shape)) :ruleset memory-allocation)
(rule ((AllocateExpDemand context id expression) (= expression (Reshape source shape)) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block layout)) (= (ReshapeNeedsCopy layout shape) true))
      ((set (AllocateExp context id expression) (Copy source))) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id expression) (= expression (Reshape source shape)) (= function (ScopeRoot context)) (AllocationFunction function)
       (= (ArrayStorage function source) (ArrayIn block layout)) (= (ReshapeNeedsCopy layout shape) false))
      ((set (AllocateExp context id expression) expression)) :ruleset memory-elaborate)

(rule ((ExistentialArray function name) (= (ArrayStorage function name) (ArrayIn block (Layout offset dims))))
      ((set (DescriptorBindingPrefix name dims 0) (vec-of))) :ruleset memory-allocation)
(rule ((= prefix (DescriptorBindingPrefix name dims i)) (< i (vec-length dims)))
      ((set (DescriptorBindingPrefix name dims (+ i 1))
          (vec-push prefix (BindValue (LayoutWitness name (StrideField i)) (ScalarInfo (ScalarElement (I32))))))) :ruleset memory-allocation)
(rule ((= storage (ArrayStorage function name)) (= storage (ArrayIn block (Layout offset dims))))
      ((set (DescriptorOperandPrefix dims 0) (vec-of))) :ruleset memory-allocation)
(rule ((= prefix (DescriptorOperandPrefix dims i)) (< i (vec-length dims)) (= (vec-get dims i) (Dim stride length)))
      ((set (DescriptorOperandPrefix dims (+ i 1)) (vec-push prefix (IndexOperand stride)))) :ruleset memory-allocation)
(rule ((= (ArrayStorage function name) (ArrayIn block (Layout offset dims))) (= bytes (BlockCapacity function block))
       (= strides (DescriptorOperandPrefix dims (vec-length dims))))
      ((set (DescriptorOperands function name)
         (vec-append (vec-of (IndexOperand bytes) (BlockOperand block) (IndexOperand offset)) strides))) :ruleset memory-allocation)

; Elaboration runs after allocation analysis reaches a fixed point.
(rule ((= info (LogicalInfo function name))) ((set (Witnessed function name) false)) :ruleset memory-allocation)
(rule ((ExistentialArray function name)) ((set (Witnessed function name) true)) :ruleset memory-allocation)
(rule ((AllocateBindingDemand context (BindValue name (ArrayValue element shape)))
       (= function (ScopeRoot context)) (AllocationFunction function) (= storage (ArrayStorage function name)) (= (Witnessed function name) false))
      ((set (AllocateBinding context (BindValue name (ArrayValue element shape)))
          (vec-of (BindValue name (ArrayInfo element storage))))) :ruleset memory-elaborate)
(rule ((AllocateBindingDemand context (BindValue name (ArrayValue element shape)))
       (= function (ScopeRoot context)) (AllocationFunction function) (= storage (ArrayStorage function name)) (= (Witnessed function name) true)
       (= storage (ArrayIn block (Layout offset dims)))
       (= strides (DescriptorBindingPrefix name dims (vec-length dims))) (= bytes (BlockCapacity function block)))
      ((set (AllocateBinding context (BindValue name (ArrayValue element shape)))
          (vec-push (vec-append (vec-of
              (BindValue (LayoutWitness name (CapacityField)) (ScalarInfo (ScalarElement (I32))))
              (BindBlock block bytes)
              (BindValue (LayoutWitness name (OffsetField)) (ScalarInfo (ScalarElement (I32))))) strides)
            (BindValue name (ArrayInfo element storage))))) :ruleset memory-elaborate)
(rule ((= witnesses (DescriptorOperands function name)))
      ((set (PackedOperand function (ValueOperand (Var name))) (vec-push witnesses (ValueOperand (Var name))))) :ruleset memory-elaborate)

(rule ((AllocateParamDemand context parameter) (= parameter (Parameter binding diet)))
      ((AllocateBindingDemand context binding)) :ruleset memory-elaborate)
(rule ((AllocateParamDemand context parameter) (= parameter (Parameter binding diet)) (= pattern (AllocateBinding context binding)))
      ((set (AllocateParamAt context parameter pattern 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateParamAt context parameter pattern i)) (= parameter (Parameter binding diet)) (< i (vec-length pattern))
       (= next (vec-get pattern i)) (= i (- (vec-length pattern) 1)))
      ((set (AllocateParamAt context parameter pattern (+ i 1)) (vec-push prefix (Parameter next diet)))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateParamAt context parameter pattern i)) (< i (- (vec-length pattern) 1)))
      ((set (AllocateParamAt context parameter pattern (+ i 1)) (vec-push prefix (Parameter (vec-get pattern i) (Observe))))) :ruleset memory-elaborate)
(rule ((= output (AllocateParamAt context parameter pattern (vec-length pattern))))
      ((set (AllocateParam context parameter) output)) :ruleset memory-elaborate)

; Signature slots determine descriptor expansion, even when an operand already
; has an explicit block/layout. Physical arrays are valid logical call results.
(rule ((PackOperandDemand function operand 1))
      ((set (PackOperand function operand 1) (vec-of operand))) :ruleset memory-elaborate)
(rule ((PackOperandDemand function operand width) (> width 1)
       (= packed (PackedOperand function operand)) (= width (vec-length packed)))
      ((set (PackOperand function operand width) packed)) :ruleset memory-elaborate)
(rule ((CheckSignature context signature results) (WalkReturnInfos signature i) (< i (vec-length signature))
       (= width (ReturnWidth (vec-get signature i))))
      ((set (ResultWidth context results i) width)) :ruleset memory-elaborate)
(rule ((CheckStatement parent id pattern (Launch grid (Block statements results)) available)
       (WalkPattern pattern i) (< i (vec-length pattern)))
      ((set (ResultWidth (NestedScope parent id 0) results i) 1)) :ruleset memory-elaborate)
(rule ((AllocateResultsDemand context results))
      ((AllocateResultsAt context results 0 0 (vec-of))) :ruleset memory-elaborate)
(rule ((AllocateResultsAt context results i j prefix) (< i (vec-length results))
       (= (vec-get results i) (Yield certs operand)) (= width (ResultWidth context results i)) (= function (ScopeRoot context)))
      ((PackOperandDemand function operand width)) :ruleset memory-elaborate)
(rule ((AllocateResultsAt context results i j prefix) (< i (vec-length results))
       (= (vec-get results i) (Yield certs operand)) (= width (ResultWidth context results i))
       (= function (ScopeRoot context)) (= packed (PackOperand function operand width)) (< j width))
      ((AllocateResultsAt context results i (+ j 1) (vec-push prefix (Yield certs (vec-get packed j))))) :ruleset memory-elaborate)
(rule ((AllocateResultsAt context results i j prefix) (< i (vec-length results)) (= j (ResultWidth context results i)))
      ((AllocateResultsAt context results (+ i 1) 0 prefix)) :ruleset memory-elaborate)
(rule ((AllocateResultsAt context results i 0 prefix) (= i (vec-length results)))
      ((set (AllocateResults context results) prefix)) :ruleset memory-elaborate)
(rule ((= binding (BindValue name (ArrayValue element shape))))
      ((set (BindingWidth binding) (+ 4 (vec-length shape)))) :ruleset memory-elaborate)
(rule ((AllocateCallArgumentsDemand context name arguments) (= function (ScopeRoot context))
       (ProgramFunction program function) (CallableSignature program name params returns)
       (WalkParams params i) (< i (vec-length params)) (= (vec-get params i) (Parameter binding diet))
       (= width (BindingWidth binding)))
      ((set (ArgumentWidth context name i) width)) :ruleset memory-elaborate)
(rule ((AllocateCallArgumentsDemand context name arguments))
      ((AllocateCallArgumentsAt context name arguments 0 0 (vec-of))) :ruleset memory-elaborate)
(rule ((AllocateCallArgumentsAt context name arguments i j prefix) (< i (vec-length arguments))
       (= (vec-get arguments i) (Pass operand diet)) (= function (ScopeRoot context)) (= width (ArgumentWidth context name i)))
      ((PackOperandDemand function operand width)) :ruleset memory-elaborate)
(rule ((AllocateCallArgumentsAt context name arguments i j prefix) (< i (vec-length arguments))
       (= (vec-get arguments i) (Pass operand diet)) (= function (ScopeRoot context)) (= width (ArgumentWidth context name i))
       (= packed (PackOperand function operand width)) (< j (- width 1)))
      ((AllocateCallArgumentsAt context name arguments i (+ j 1) (vec-push prefix (Pass (vec-get packed j) (Observe))))) :ruleset memory-elaborate)
(rule ((AllocateCallArgumentsAt context name arguments i j prefix) (< i (vec-length arguments))
       (= (vec-get arguments i) (Pass operand diet)) (= function (ScopeRoot context)) (= width (ArgumentWidth context name i))
       (= packed (PackOperand function operand width)) (= j (- width 1)))
      ((AllocateCallArgumentsAt context name arguments (+ i 1) 0 (vec-push prefix (Pass (vec-get packed j) diet)))) :ruleset memory-elaborate)
(rule ((AllocateCallArgumentsAt context name arguments i 0 prefix) (= i (vec-length arguments)))
      ((set (AllocateCallArguments context name arguments) prefix)) :ruleset memory-elaborate)

(rule ((AllocateMergeDemand context merge) (= merge (Carry parameter operand)))
      ((AllocateParamDemand context parameter)) :ruleset memory-elaborate)
(rule ((AllocateMergeDemand context merge) (= merge (Carry parameter operand)) (= function (ScopeRoot context)) (AllocationFunction function)
       (= params (AllocateParam context parameter)))
      ((PackOperandDemand function operand (vec-length params))) :ruleset memory-elaborate)
(rule ((AllocateMergeDemand context merge) (= merge (Carry parameter operand)) (= function (ScopeRoot context))
       (= params (AllocateParam context parameter)) (= operands (PackOperand function operand (vec-length params))))
      ((set (AllocateMergeAt context merge params operands 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateMergeAt context merge params operands i)) (< i (vec-length params)))
      ((set (AllocateMergeAt context merge params operands (+ i 1)) (vec-push prefix (Carry (vec-get params i) (vec-get operands i))))) :ruleset memory-elaborate)
(rule ((= output (AllocateMergeAt context merge params operands (vec-length params))))
      ((set (AllocateMerge context merge) output)) :ruleset memory-elaborate)

; One slot expansion applies to function, branch, loop, and call signatures.
(rule ((AllocateReturnInfosDemand context returns))
      ((set (ReturnSlot returns 0) 0) (set (AllocateReturnPrefix context returns 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= slot (ReturnSlot returns i)) (< i (vec-length returns)) (= width (ReturnWidth (vec-get returns i))))
      ((set (ReturnSlot returns (+ i 1)) (+ slot width))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateReturnPrefix context returns i)) (< i (vec-length returns))
       (= output (AllocateReturn context returns i (vec-get returns i))))
      ((set (AllocateReturnPrefix context returns (+ i 1)) (vec-append prefix output))) :ruleset memory-elaborate)
(rule ((= output (AllocateReturnPrefix context returns (vec-length returns))))
      ((set (AllocateReturnInfos context returns) output)) :ruleset memory-elaborate)
(rule ((= info (ReturnArrayValue element shape))) ((set (ReturnWidth info) (+ 4 (vec-length shape)))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateReturnPrefix context returns i)) (< i (vec-length returns)) (= slot (ReturnSlot returns i))
       (= (vec-get returns i) (ReturnArrayValue element shape)))
      ((set (ReturnArrayPrefix context returns i shape 0)
          (vec-of (ReturnScalar (ScalarElement (I32))) (ReturnMemory (ResultIndex slot)) (ReturnScalar (ScalarElement (I32)))))
       (set (ReturnDimensions returns i shape 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= prefix (ReturnArrayPrefix context returns i shape j)) (< j (vec-length shape)))
      ((AllocateExtIndexDemand returns (vec-get shape j))
       (set (ReturnArrayPrefix context returns i shape (+ j 1)) (vec-push prefix (ReturnScalar (ScalarElement (I32)))))) :ruleset memory-elaborate)
(rule ((= prefix (ReturnDimensions returns i shape j)) (< j (vec-length shape)) (= slot (ReturnSlot returns i))
       (= length (AllocateExtIndex returns (vec-get shape j))))
      ((set (ReturnDimensions returns i shape (+ j 1)) (vec-push prefix (ExtendedDimension (ResultIndex (+ (+ slot 3) j)) length)))) :ruleset memory-elaborate)
(rule ((= prefix (ReturnArrayPrefix context returns i shape (vec-length shape)))
       (= (vec-get returns i) (ReturnArrayValue element shape)) (= slot (ReturnSlot returns i))
       (= dims (ReturnDimensions returns i shape (vec-length shape))))
      ((set (AllocateReturn context returns i (ReturnArrayValue element shape))
          (vec-push prefix (ReturnArray element (ResultBlock (+ slot 1)) (ExtendedLayout (ResultIndex (+ slot 2)) dims))))) :ruleset memory-elaborate)
(rule ((AllocateExtIndexDemand returns (ResultIndex old)) (= slot (ReturnSlot returns old)))
      ((set (AllocateExtIndex returns (ResultIndex old)) (ResultIndex slot))) :ruleset memory-elaborate)
(rule ((AllocateExtIndexDemand returns (FreeIndex index)))
      ((set (AllocateExtIndex returns (FreeIndex index)) (FreeIndex index))) :ruleset memory-elaborate)

(rule ((CheckStatement context id pattern expression available) (WalkPattern pattern i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name info))) ((set (OwnsMemory context id name) false)) :ruleset memory-allocation)
(rule ((FreshArray context id name element shape) (= function (ScopeRoot context))
       (= inputs (ReuseInputs function name)) (= (set-length inputs) 0))
      ((set (OwnsMemory context id name) true)) :ruleset memory-allocation)
(rule ((AllocateStmDemand context (Let id pattern certificates expression)))
      ((AllocatePatternDemand context pattern) (AllocateExpDemand context id expression)
       (set (AllocationPrefix context id pattern 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= prefix (AllocationPrefix context id pattern i)) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name info)) (= (OwnsMemory context id name) false))
      ((set (AllocationPrefix context id pattern (+ i 1)) prefix)) :ruleset memory-elaborate)
(rule ((= prefix (AllocationPrefix context id pattern i)) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name info)) (= (OwnsMemory context id name) true)
       (= function (ScopeRoot context)) (= (ExpandedArray function name) true))
      ((set (AllocationPrefix context id pattern (+ i 1)) prefix)) :ruleset memory-elaborate)
(rule ((= prefix (AllocationPrefix context id pattern i)) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name info)) (= (OwnsMemory context id name) true)
       (= function (ScopeRoot context)) (= (ExpandedArray function name) false)
       (= (ArrayStorage function name) (ArrayIn block layout))
       (= bytes (BlockCapacity function block)) (= space (AllocationSpace context)))
      ((set (AllocationPrefix context id pattern (+ i 1))
          (vec-push prefix (Let (AllocationTag id i) (vec-of (BindBlock block bytes)) (vec-of) (Alloc space bytes))))) :ruleset memory-elaborate)
; These independent allocations use only enclosing names, so their set order
; does not impose a data dependency or change allocation lifetimes.
(rule ((= allocations (HoistedAllocations context id)))
      ((set (HoistedPrefix allocations 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= prefix (HoistedPrefix allocations i)) (< i (set-length allocations)))
      ((set (HoistedPrefix allocations (+ i 1)) (vec-push prefix (set-get allocations i)))) :ruleset memory-elaborate)
(rule ((AllocateStmDemand context original) (= original (Let id pattern certificates expression))
       (= prefix (AllocationPrefix context id pattern (vec-length pattern)))
       (= allocations (HoistedAllocations context id)) (= hoisted (HoistedPrefix allocations (set-length allocations)))
       (= next (AllocateExp context id expression)) (= bindings (AllocatePattern context pattern)))
      ((set (AllocateStm context original)
          (vec-push (vec-append hoisted prefix) (Let id bindings certificates next)))) :ruleset memory-elaborate)

(rule ((AllocateBodyDemand context (Block statements results)))
      ((AllocateStmsDemand context statements) (AllocateResultsDemand context results)) :ruleset memory-elaborate)
(rule ((AllocateBodyDemand context original) (= original (Block statements results))
       (= next (AllocateStms context statements)) (= output (AllocateResults context results)))
      ((set (AllocateBody context original) (Block next output))) :ruleset memory-elaborate)
(rule ((AllocateLambdaDemand context (FunctionBody params returns body)))
      ((AllocateParamsDemand context params) (AllocateReturnInfosDemand context returns) (AllocateBodyDemand context body)) :ruleset memory-elaborate)
(rule ((AllocateLambdaDemand context original) (= original (FunctionBody params returns body))
       (= p (AllocateParams context params)) (= r (AllocateReturnInfos context returns)) (= b (AllocateBody context body)))
      ((set (AllocateLambda context original) (FunctionBody p r b))) :ruleset memory-elaborate)

(rule ((AllocateExpDemand context id (If condition returns yes no)))
      ((AllocateReturnInfosDemand context returns)
       (AllocateBodyDemand (NestedScope context id 0) yes) (AllocateBodyDemand (NestedScope context id 1) no)) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id original) (= original (If condition returns yes no))
       (= r (AllocateReturnInfos context returns)) (= a (AllocateBody (NestedScope context id 0) yes)) (= b (AllocateBody (NestedScope context id 1) no)))
      ((set (AllocateExp context id original) (If condition r a b))) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id (Loop merges form returns body)))
      ((AllocateMergesDemand context merges) (AllocateReturnInfosDemand context returns) (AllocateBodyDemand (NestedScope context id 0) body)) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id original) (= original (Loop merges form returns body))
       (= m (AllocateMerges context merges)) (= r (AllocateReturnInfos context returns)) (= b (AllocateBody (NestedScope context id 0) body)))
      ((set (AllocateExp context id original) (Loop m form r b))) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id (Call name arguments returns)))
      ((AllocateCallArgumentsDemand context name arguments) (AllocateReturnInfosDemand context returns)) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id original) (= original (Call name arguments returns))
       (= a (AllocateCallArguments context name arguments)) (= r (AllocateReturnInfos context returns)))
      ((set (AllocateExp context id original) (Call name a r))) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id (WithAcc inputs body)))
      ((AllocateLambdaDemand (NestedScope context id 0) body) (set (AllocateAccInputPrefix context id inputs 0) (vec-of))) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id original) (= original (WithAcc inputs body))
       (= inputs2 (AllocateAccInputPrefix context id inputs (vec-length inputs))) (= b (AllocateLambda (NestedScope context id 0) body)))
      ((set (AllocateExp context id original) (WithAcc inputs2 b))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateAccInputPrefix context id inputs i)) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (CombineWrites combine))))
      ((AllocateLambdaDemand (NestedScope context id (+ i 1)) combine)) :ruleset memory-elaborate)
(rule ((= prefix (AllocateAccInputPrefix context id inputs i)) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (CombineWrites combine))) (= next (AllocateLambda (NestedScope context id (+ i 1)) combine)))
      ((set (AllocateAccInputPrefix context id inputs (+ i 1)) (vec-push prefix (AccumulatorInput arrays (CombineWrites next))))) :ruleset memory-elaborate)

(rule ((AllocateExpDemand context id (Parallel execution domain (ParallelBlock statements results))))
      ((AllocateStmsDemand (NestedScope context id 0) statements)
       (set (AllocateParallelPrefix (NestedScope context id 0) results 0) (vec-of))) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id original) (= original (Parallel execution domain (ParallelBlock statements results)))
       (= next (AllocateStms (NestedScope context id 0) statements)) (= output (AllocateParallelPrefix (NestedScope context id 0) results (vec-length results))))
      ((set (AllocateExp context id original) (Parallel execution domain (ParallelBlock next output)))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateParallelPrefix context results i)) (< i (vec-length results))
       (= (vec-get results i) (Fold kind (Reduction commutativity neutral combine) values)))
      ((AllocateLambdaDemand (ReducerScope context i) combine)) :ruleset memory-elaborate)
(rule ((= prefix (AllocateParallelPrefix context results i)) (< i (vec-length results))
       (= (vec-get results i) (Fold kind (Reduction commutativity neutral combine) values)) (= next (AllocateLambda (ReducerScope context i) combine)))
      ((set (AllocateParallelPrefix context results (+ i 1))
          (vec-push prefix (Fold kind (Reduction commutativity neutral next) values)))) :ruleset memory-elaborate)

(rule ((AllocateProgramDemand program) (= program (MemoryProgram functions externals entries)))
      ((set (AllocateFunctionPrefix program functions 0) (vec-of)) (set (AllocateExternalPrefix program externals 0) (vec-of))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateFunctionPrefix program functions i)) (< i (vec-length functions))
       (= function (vec-get functions i)) (= function (DefineFunction name params returns body)))
      ((AllocateLambdaDemand (FunctionScope function) (FunctionBody params returns body))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateFunctionPrefix program functions i)) (< i (vec-length functions))
       (= function (vec-get functions i)) (= function (DefineFunction name params returns body))
       (= (AllocateLambda (FunctionScope function) (FunctionBody params returns body)) (FunctionBody p r b)))
      ((set (AllocateFunctionPrefix program functions (+ i 1)) (vec-push prefix (DefineFunction name p r b)))) :ruleset memory-elaborate)
(rule ((AllocateProgramDemand program) (= program (MemoryProgram functions externals entries))
       (= output (AllocateFunctionPrefix program functions (vec-length functions)))
       (= declarations (AllocateExternalPrefix program externals (vec-length externals))))
      ((set (AllocateProgram program) (MemoryProgram output declarations entries))) :ruleset memory-elaborate)

(rule ((CurrentProgram program)) ((AllocateProgramDemand program)) :ruleset memory-allocation-demand)
(rule ((CurrentProgram program) (= next (AllocateProgram program)) (!= next program))
      ((delete (CurrentProgram program)) (CurrentProgram next)) :ruleset memory-allocation-commit)

(rule ((CheckExternal external)) ((set (AllocationSpace (ExternalScope external)) (DeviceSpace))) :ruleset memory-allocation)
(rule ((= prefix (AllocateExternalPrefix program externals i)) (< i (vec-length externals))
       (= external (vec-get externals i)) (= external (DeclareExternal name params returns behavior resources)))
      ((AllocateLambdaDemand (ExternalScope external) (FunctionBody params returns (Block (vec-of) (vec-of))))) :ruleset memory-elaborate)
(rule ((= prefix (AllocateExternalPrefix program externals i)) (< i (vec-length externals))
       (= external (vec-get externals i)) (= external (DeclareExternal name params returns behavior resources))
       (= (AllocateLambda (ExternalScope external) (FunctionBody params returns (Block (vec-of) (vec-of)))) (FunctionBody p r b)))
      ((set (AllocateExternalPrefix program externals (+ i 1)) (vec-push prefix (DeclareExternal name p r behavior resources)))) :ruleset memory-elaborate)

; Allocation provenance is available before elaboration too. Logical joins use
; the same block-alias relation as explicit block operands.
(rule ((FreshArray context id name element shape) (= function (ScopeRoot context))
       (= (ExpandedArray function name) false) (= space (AllocationSpace context)))
      ((BlockSpace function (ArrayMemory name) space)) :ruleset memory-allocation)
(rule ((FreshArray context id name element shape) (= function (ScopeRoot context))
       (= (ExpandedArray function name) true))
      ((BlockSpace function (ArrayMemory name) (DeviceSpace))) :ruleset memory-allocation)
(rule ((AllocationFunction function) (= function (DefineFunction name params returns body))
       (WalkParams params i) (< i (vec-length params))
       (= (vec-get params i) (Parameter (BindValue array (ArrayValue element shape)) diet)))
      ((BlockSpace function (ArrayMemory array) (DeviceSpace))) :ruleset memory-allocation)
(rule ((BlockResults function pattern (Block statements results)) (WalkPattern pattern i)
       (< i (vec-length pattern)) (< i (vec-length results))
       (= (vec-get pattern i) (BindValue output (ArrayValue element shape)))
       (= (vec-get results i) (Yield certs (ValueOperand (Var input))))
       (= (ArrayStorage function output) (ArrayIn out layout))
       (= (ArrayStorage function input) (ArrayIn source source-layout)))
      ((BlockAlias function out source)) :ruleset memory-allocation)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Loop merges form returns (Block statements results))))
       (WalkMerges merges i) (< i (vec-length merges))
       (= (vec-get merges i) (Carry (Parameter (BindValue parameter (ArrayValue element shape)) diet) (ValueOperand (Var initial))))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var next))))
       (= (ArrayStorage function parameter) (ArrayIn block layout))
       (= (ArrayStorage function initial) (ArrayIn first first-layout))
       (= (ArrayStorage function next) (ArrayIn last last-layout)))
      ((BlockAlias function block first) (BlockAlias function block last)) :ruleset memory-allocation)

; Private allocations have fixed storage in a shader. Keep loop-carried values
; in enclosing buffers so an allocation in the next iteration cannot overwrite
; the previous result. Snapshot all results before updating any carried buffer.
(ruleset loop-buffer-provenance)
(ruleset loop-buffer-analysis)
(ruleset loop-buffer-rewrite)
(function ConstantShape (Function Shape i64) Shape :no-merge)
(function PrivateBlock (Function BlockName) bool :merge (and old new))
(function BufferCarry (Function Merge) bool :merge (or old new))
(function BufferedLoop (StatementId) bool :merge (or old new))
(function NeedsLoopBuffers (Function Exp) bool :merge (or old new))
(relation BufferLoop (Function Stm))
(relation BufferedMerges (Function Stm i64 Stms Merges Stms Stms Results))
(rule ((ContainsValueInfo (FunctionRoot function) (ArrayValue element shape)))
      ((set (ConstantShape function shape 0) (vec-of))) :ruleset loop-buffer-analysis)
(rule ((= prefix (ConstantShape function shape i)) (< i (vec-length shape))
       (= size (StaticIndex function (vec-get shape i))))
      ((set (ConstantShape function shape (+ i 1)) (vec-push prefix (IndexConstant size)))) :ruleset loop-buffer-analysis)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs expression))
       (= expression (Loop merges form returns body)))
      ((set (BufferedLoop id) false) (set (NeedsLoopBuffers function expression) false)) :ruleset loop-buffer-analysis)
(rule ((= id (ScheduleStatement source 40 0)))
      ((set (BufferedLoop id) true)) :ruleset loop-buffer-analysis)
(rule ((BlockSpace function block space))
      ((set (PrivateBlock function block) true)) :ruleset loop-buffer-provenance)
(rule ((BlockSpace function block space) (!= space (PrivateSpace)))
      ((set (PrivateBlock function block) false)) :ruleset loop-buffer-provenance)
(rule ((ContainsMerge (FunctionRoot function) merge))
      ((set (BufferCarry function merge) false)) :ruleset loop-buffer-analysis)
(rule ((ContainsMerge (FunctionRoot function) merge)
       (= merge (Carry (Parameter (BindValue name (ArrayValue element shape)) diet) initial))
       (= fixed (ConstantShape function shape (vec-length shape)))
       (= (ArrayStorage function name) (ArrayIn block layout)) (= (PrivateBlock function block) true))
      ((set (BufferCarry function merge) true)) :ruleset loop-buffer-analysis)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Loop merges form returns body))
       (WalkMerges merges i) (< i (vec-length merges)) (= (BufferCarry function (vec-get merges i)) true))
      ((set (NeedsLoopBuffers function expression) true)) :ruleset loop-buffer-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern expression available) (= expression (Loop merges form returns body))
       (= (HostScope (NestedScope context id 0)) false) (= (BufferedLoop id) false)
       (= (NeedsLoopBuffers function expression) true)
       (ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs expression)))
      ((BufferLoop function statement)
       (BufferedMerges function statement 0 (vec-of) (vec-of) (vec-of) (vec-of) (vec-of))) :ruleset loop-buffer-rewrite)
(rule ((BufferedMerges function statement i initial carried snapshots updates yielded)
       (= statement (Let id pattern certs (Loop merges form returns (Block stms results))))
       (< i (vec-length merges)) (= merge (vec-get merges i)) (= (BufferCarry function merge) false))
      ((BufferedMerges function statement (+ i 1) initial (vec-push carried merge) snapshots updates
          (vec-push yielded (vec-get results i)))) :ruleset loop-buffer-rewrite)
(rule ((BufferedMerges function statement i initial carried snapshots updates yielded)
       (= statement (Let id pattern certs (Loop merges form returns (Block stms results))))
       (< i (vec-length merges)) (= merge (vec-get merges i)) (= (BufferCarry function merge) true)
       (= merge (Carry (Parameter (BindValue name (ArrayValue element shape)) diet) (ValueOperand (Var source))))
       (= fixed (ConstantShape function shape (vec-length shape)))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var next)))))
      ((let start (ScheduleValue id 40 i)) (let snapshot (ScheduleValue id 41 i)) (let updated (ScheduleValue id 42 i))
       (BufferedMerges function statement (+ i 1)
          (vec-push initial (Let (ScheduleStatement id 41 i) (vec-of (BindValue start (ArrayValue element fixed)))
              certs (Copy source)))
          (vec-push carried (Carry (Parameter (BindValue name (ArrayValue element fixed)) (Consume)) (ValueOperand (Var start))))
          (vec-push snapshots (Let (ScheduleStatement id 42 i) (vec-of (BindValue snapshot (ArrayValue element fixed)))
              proofs (Copy next)))
          (vec-push updates (Let (ScheduleStatement id 43 i) (vec-of (BindValue updated (ArrayValue element fixed)))
              (vec-of) (Update (ProvenInBounds) name (vec-of) (Var snapshot))))
          (vec-push yielded (Yield (vec-of) (ValueOperand (Var updated)))))) :ruleset loop-buffer-rewrite)
(rule ((CurrentProgram program) (ProgramFunction program function) (BufferLoop function statement)
       (BufferedMerges function statement i initial carried snapshots updates yielded)
       (= statement (Let id pattern certs (Loop merges form returns (Block stms results))))
       (= i (vec-length merges)))
      ((let loop (Let (ScheduleStatement id 40 0) pattern certs
          (Loop carried form returns (Block (vec-append stms (vec-append snapshots updates)) yielded))))
       (set (PendingRewrite "loop-buffers" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append initial (vec-of loop))))))
       (RewriteDemand "loop-buffers" program)) :ruleset loop-buffer-rewrite)

; A changing/private or mixed-space carry cannot reuse fixed shader storage.
; Generated parallel regions move to the ordinary host-loop lowering instead.
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain body))
       (ContainsExp (ParallelRoot body) (Loop merges form returns loop-body))
       (WalkMerges merges i) (< i (vec-length merges)) (= merge (vec-get merges i))
       (= merge (Carry (Parameter (BindValue name (ArrayValue element shape)) diet) initial))
       (= (ArrayStorage function name) (ArrayIn block layout)) (BlockSpace function block (PrivateSpace))
       (= (BufferCarry function merge) false))
      ((set (BoundedLocals function body) false)) :ruleset local-storage-status)

(rule ((CheckStatement context id pattern (Loop merges form returns body) available)
       (= (HostScope (NestedScope context id 0)) false) (= function (ScopeRoot context))
       (WalkMerges merges i) (< i (vec-length merges)) (= merge (vec-get merges i))
       (= merge (Carry (Parameter (BindValue name (ArrayValue element shape)) diet) initial))
       (= (ArrayStorage function name) (ArrayIn block layout)) (BlockSpace function block (PrivateSpace))
       (= (BufferCarry function merge) false))
      ((InvalidScope context "loop-carried private storage needs an invariant shape and address space")) :ruleset local-storage-status)

; Coalesce only consumed parameters whose entire content lifetime is this
; pointwise region or copy. Shapes and element types must match; witnesses preserve the
; input layout. Competing destinations and sources are selected one-to-one.
(rule ((AllocationFunction function) (ContainsBinding (FunctionRoot function) (BindValue name info)))
      ((set (ReuseInputs function name) (set-empty)) (set (ReuseCandidates function name) (set-empty))
       (set (ReuseDestinations function) (set-empty))) :ruleset memory-reuse)
(rule ((AllocationFunction function) (= function (DefineFunction fn params returns (Block statements results)))
       (= (FunctionHost function) true) (WalkParams params p) (< p (vec-length params))
       (= (vec-get params p) (Parameter (BindValue source (ArrayValue element shape)) (Consume)))
       (WalkStms statements i) (< i (vec-length statements))
       (= statement (vec-get statements i)) (= statement (Let id pattern certs (Parallel execution domain body)))
       (= body (ParallelBlock lanes clauses)) (= collected (ForwardedResults clauses))
       (= effects (EffectsParallelBody function body)) (ReadOnlyEffects effects) (= indices (DomainIndices domain))
       (= (BoundedLoad function (Load source indices)) true)
       (WalkPattern pattern output) (< output (vec-length pattern))
       (= (vec-get pattern output) (BindValue destination (ArrayValue element shape)))
       (= (ExpandedArray function destination) false))
      ((ReuseCandidate function destination source statement)
       (set (ReuseSafe function destination source) true)) :ruleset memory-reuse)
(rule ((AllocationFunction function) (= function (DefineFunction fn params returns (Block statements results)))
       (= (FunctionHost function) true) (WalkParams params p) (< p (vec-length params))
       (= (vec-get params p) (Parameter (BindValue source (ArrayValue element shape)) (Consume)))
       (WalkStms statements i) (< i (vec-length statements)) (= statement (vec-get statements i))
       (= statement (Let id pattern certs (Copy source))) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue destination (ArrayValue element shape))))
      ((ReuseCandidate function destination source statement)
       (set (ReuseSafe function destination source) true)) :ruleset memory-reuse)
(rule ((ReuseCandidate function destination source statement)
       (= function (DefineFunction fn params returns (Block statements results)))
       (set-contains (NamesResults results) (ValueNameRef source)))
      ((set (ReuseSafe function destination source) false)) :ruleset memory-reuse)
(rule ((ReuseCandidate function destination source statement)
       (= function (DefineFunction fn params returns (Block statements results)))
       (WalkStms statements i) (< i (vec-length statements)) (= other (vec-get statements i))
       (!= other statement) (set-contains (NamesStm other) (ValueNameRef source)))
      ((set (ReuseSafe function destination source) false)) :ruleset memory-reuse)
(rule ((ReuseCandidate function destination source statement)
       (= statement (Let id pattern certs (Parallel execution domain body)))
       (ContainsAtom (ParallelRoot body) (Var source)))
      ((set (ReuseSafe function destination source) false)) :ruleset memory-reuse)
(rule ((ReuseCandidate function destination source statement)
       (= statement (Let id pattern certs (Parallel execution domain body))) (= indices (DomainIndices domain))
       (ContainsExp (ParallelRoot body) expression) (DirectArrayAccess expression source)
       (!= expression (Load source indices)))
      ((set (ReuseSafe function destination source) false)) :ruleset memory-reuse)
(rule ((ReuseCandidate function destination source statement) (= (ReuseSafe function destination source) true))
      ((set (ReuseCandidates function destination) (set-of source))
       (set (ReuseDestinations function) (set-of destination))) :ruleset memory-reuse-propose)
(rule ((= destinations (ReuseDestinations function)))
      ((AssignReuse function destinations (set-empty))) :ruleset memory-reuse-select)
(rule ((AssignReuse function destinations used) (> (set-length destinations) 0)
       (= destination (set-get destinations 0)) (= sources (ReuseCandidates function destination))
       (= available (set-diff sources used)) (> (set-length available) 0) (= source (set-get available 0)))
      ((set (ReuseInputs function destination) (set-of source))
       (AssignReuse function (set-remove destinations destination) (set-insert used source))) :ruleset memory-reuse-select)
(rule ((AssignReuse function destinations used) (> (set-length destinations) 0)
       (= destination (set-get destinations 0)) (= sources (ReuseCandidates function destination))
       (= (set-diff sources used) (set-empty)))
      ((AssignReuse function (set-remove destinations destination) used)) :ruleset memory-reuse-select)
(rule ((FreshArray context id name element shape) (= function (ScopeRoot context))
       (= inputs (ReuseInputs function name)) (> (set-length inputs) 0)
       (= storage (ArrayStorage function (set-get inputs 0))))
      ((set (ArrayStorage function name) storage)) :ruleset memory-allocation)

; The public buffer ABI is dense and starts at zero. Entry parameters already
; obey that contract; other views must prove it from their explicit layout.
(ruleset memory-publication)
(relation PublicLayout (Function ElementType MemBind))
(relation PublicArray (Function ValueName))
(rule ((CurrentProgram program) (ProgramFunction program function)
       (= function (DefineFunction fn params returns body)) (= (EntryFunction fn) true)
       (WalkParams params i) (< i (vec-length params))
       (= (vec-get params i) (Parameter (BindValue name (ArrayInfo element storage)) diet)))
      ((PublicLayout function element storage)) :ruleset memory-publication)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayInfo element storage)))
       (= storage (ArrayIn block (Layout offset dims))) (= (NormalizedIndex offset) (IndexConstant 0))
       (= (StridedLayout dims) true) (= (NormalizedIndex (LayoutBaseStride dims)) (IndexConstant 1)))
      ((PublicLayout function element storage)) :ruleset memory-publication)
(rule ((ContainsBinding (FunctionRoot function) (BindValue name (ArrayInfo element storage)))
       (PublicLayout function element storage)) ((PublicArray function name)) :ruleset memory-publication)

; Logical extents remain exact. Proven integer bounds may size storage without
; reading a device-computed extent back to the host. Scalar names keep their
; meaning across rewrites, so their proofs survive collective decomposition.
(ruleset allocation-bounds)
(ruleset allocation-sizes)
(function IntegerLower (Atom) i64 :merge (max old new))
(function IntegerUpper (Atom) i64 :merge (min old new))
(function ExtentUpper (Function IndexExp) i64 :merge (min old new))
(function HasExtentUpper (Function IndexExp) bool :merge (or old new))
(function AllocationExtent (Function IndexExp) IndexExp :no-merge)
(function AllocationElements (Function Shape i64) IndexExp :no-merge)
(rule ((ContainsAtom (FunctionRoot function) atom) (= atom (LiteralBits (I32) n)))
      ((set (IntegerLower atom) n) (set (IntegerUpper atom) n)) :ruleset allocation-bounds)
(rule ((= n (StaticIndex function index)) (>= n 0))
      ((set (ExtentUpper function index) n)) :ruleset allocation-bounds)
(rule ((ContainsIndexExp (FunctionRoot function) index))
      ((set (HasExtentUpper function index) false)) :ruleset allocation-bounds)
(rule ((= bound (ExtentUpper function index)))
      ((set (HasExtentUpper function index) true)) :ruleset allocation-bounds)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Use (ValueOperand atom))))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= lower (IntegerLower atom)) (= upper (IntegerUpper atom)))
      ((set (IntegerLower (Var name)) lower) (set (IntegerUpper (Var name)) upper)) :ruleset allocation-bounds)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (PrimOp "select" arguments)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= (vec-length arguments) 3) (= a (vec-get arguments 0)) (= b (vec-get arguments 1))
       (= al (IntegerLower a)) (= au (IntegerUpper a))
       (= bl (IntegerLower b)) (= bu (IntegerUpper b)))
      ((set (IntegerLower (Var name)) (min al bl))
       (set (IntegerUpper (Var name)) (max au bu))) :ruleset allocation-bounds)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (Parallel execution
           (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral combine) values))
       (= (NativeAddition combine) true) (= neutral (vec-of (LiteralBits (I32) 0)))
       (= (vec-length values) 1) (= (vec-get values 0) (Yield proofs (ValueOperand value)))
       (= lower (IntegerLower value)) (>= lower 0) (= upper (IntegerUpper value))
       (= count (DomainWork function axes (vec-length axes)))
       (<= (* count (bigint upper)) (bigint 2147483647))
       (FoldSlots kind prefixes 1) (= offset (+ (ClauseOffset clauses i) prefixes))
       (= (vec-get pattern offset) (BindValue name (ScalarInfo (ScalarElement (I32))))))
      ((set (IntegerLower (Var name)) (to-i64 (bigrat (* count (bigint lower)) (bigint 1))))
       (set (IntegerUpper (Var name)) (to-i64 (bigrat (* count (bigint upper)) (bigint 1))))) :ruleset allocation-bounds)
(rule ((ContainsIndexExp (FunctionRoot function) (IndexValue name))
       (= lower (IntegerLower (Var name))) (>= lower 0) (= upper (IntegerUpper (Var name))))
      ((set (ExtentUpper function (IndexValue name)) upper)) :ruleset allocation-bounds)
(rule ((ContainsStm (FunctionRoot function) (Let id pattern certs (IndexOp index)))
       (= (vec-length pattern) 1) (= (vec-get pattern 0) (BindValue name (ScalarInfo (ScalarElement (I32)))))
       (= upper (ExtentUpper function index)) (<= upper 2147483647))
      ((set (IntegerLower (Var name)) 0) (set (IntegerUpper (Var name)) upper)) :ruleset allocation-bounds)
(rule ((= (HasExtentUpper function index) false))
      ((set (AllocationExtent function index) index)) :ruleset allocation-sizes)
(rule ((= upper (ExtentUpper function index)))
      ((set (AllocationExtent function index) (IndexConstant upper))) :ruleset allocation-sizes)
(rule ((ContainsValueInfo (FunctionRoot function) (ArrayValue element shape)))
      ((set (AllocationElements function shape 0) (IndexConstant 1))) :ruleset allocation-sizes)
(rule ((= size (AllocationElements function shape i)) (< i (vec-length shape))
       (= extent (AllocationExtent function (vec-get shape i))))
      ((set (AllocationElements function shape (+ i 1)) (IndexMul size extent))) :ruleset allocation-sizes)
(rule ((FreshArray context id name element shape) (= function (ScopeRoot context))
       (= (ExpandedArray function name) false)
       (= inputs (ReuseInputs function name)) (= (set-length inputs) 0)
       (= dims (DenseDimensions shape)) (= count (AllocationElements function shape (vec-length shape)))
       (= bytes (ElementBytes element)))
      ((set (ArrayStorage function name) (ArrayIn (ArrayMemory name) (Layout (IndexConstant 0) dims)))
       (set (BlockCapacity function (ArrayMemory name)) (IndexMul count (IndexConstant bytes)))) :ruleset memory-allocation)

(rule ((CheckStatement context id pattern (Launch grid body) available))
      ((set (AllocationSpace (NestedScope context id 0)) (PrivateSpace))) :ruleset memory-allocation)
(rule ((AllocateExpDemand context id (Launch grid body)))
      ((AllocateBodyDemand (NestedScope context id 0) body)) :ruleset memory-elaborate)
(rule ((AllocateExpDemand context id original) (= original (Launch grid body))
       (= next (AllocateBody (NestedScope context id 0) body)))
      ((set (AllocateExp context id original) (Launch grid next))) :ruleset memory-elaborate)

; Materialize dynamic per-invocation allocations while the logical domain is
; still present. Kernel lowering then preserves explicit block/layout bindings.
(ruleset memory-expand-select)
(relation ExpandMemory (Program Stm Stm Renaming))
(function ExpandedStorageExpression (Function Exp) Exp :no-merge)
(rule ((ContainsExp (FunctionRoot function) expression) (= (WritesResult expression) true))
      ((set (ExpandedStorageExpression function expression) expression)) :ruleset memory-allocation)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Reshape source shape))
       (= (ArrayStorage function source) (ArrayIn block layout)) (= (ReshapeNeedsCopy layout shape) true))
      ((set (ExpandedStorageExpression function expression) (Copy source))) :ruleset memory-allocation)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (FreshArray context id name element shape) (= function (ScopeRoot context))
       (= (ExpandedArray function name) true)
       (ExpandableStorage function name owner kernel instances ordinal)
       (CheckStatement context id pattern expression available)
       (ContainsStm (FunctionRoot function) source) (= source (Let id pattern certs expression))
       (ContainsStm (FunctionRoot function) enclosing) (= enclosing (Let kernel outputs proofs outer))
       (WalkPattern pattern i) (< i (vec-length pattern)) (= (vec-get pattern i) (BindValue name (ArrayValue element shape)))
       (= storage (ArrayStorage function name)) (= storage (ArrayIn block layout))
       (= allocations (HoistedAllocations owner kernel))
       (= allocation (Let aid (vec-of (BindBlock block capacity)) certificates (Alloc (DeviceSpace) capacity)))
       (set-contains allocations allocation) (= replacement (ExpandedStorageExpression function expression)))
      ((let env (Rename (map-empty) (map-empty) (map-empty) (map-empty)
          (map-insert (map-empty) id (vec-of (Let id (vec-set pattern i (BindValue name (ArrayInfo element storage))) certs replacement)))))
       (ExpandMemory program enclosing allocation env) (RenameExpDemand env outer)) :ruleset memory-expand-select)
(rule ((CurrentProgram program) (ExpandMemory program enclosing allocation env)
       (= enclosing (Let id pattern certs expression)) (= next (RenameExp env expression)))
      ((set (PendingRewrite "expand-memory" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of allocation (Let id pattern certs next))))))
       (RewriteDemand "expand-memory" program)) :ruleset memory-expand-select)
