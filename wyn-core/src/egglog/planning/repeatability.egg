; Demand-driven repetition proofs shared by rectangular maps and segmented collectives.
(ruleset rectangular-discover)
(ruleset traversal-types)
(ruleset repeatability)
(ruleset traversal-proofs)
(ruleset traversal-ready)
(function SourceHasOperation (SourceValue) bool :merge (or old new))
(function CallHasCallee (SourceValue) bool :merge (or old new))
(function MappingCallbackIsScalar (OperationKey) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (SourceHasOperation value) false)) :ruleset traversal-types)
(rule ((= op (SourceValueOperation value))) ((set (SourceHasOperation value) true)) :ruleset traversal-types)
(rule ((= value (SourceInvocation scope function args))) ((set (CallHasCallee value) false)) :ruleset traversal-types)
(rule ((= callee (PlanCallee value))) ((set (CallHasCallee value) true)) :ruleset traversal-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping op) true))
      ((set (MappingCallbackIsScalar op) false)) :ruleset traversal-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping op) true) (= body (SourceOperatorBody op))
       (= result (SourceResult body)) (= ty (SourceType result)) (= source-layout-bytes (SourceByteSize ty)) (> source-layout-bytes 0))
      ((set (MappingCallbackIsScalar op) true)) :ruleset traversal-types)

(relation RectangularDemand (SourceValue))
(datatype RepeatContext (OutsidePlan) (InsidePlan FusionPlan))
(relation RectangularRequirement (SourceValue RepeatContext SourceValue))
(datatype RepeatCheck (Repeat RepeatContext SourceValue))
(sort RepeatChecks (Set RepeatCheck))
(function RectangularRequired (SourceValue) RepeatChecks :merge (set-union old new))
(function RectangularApproved (SourceValue) RepeatChecks :merge (set-union old new))
(relation RepeatDemand (RepeatContext SourceValue))
(rule ((RectangularDemand value)) ((set (RectangularRequired value) (set-empty)) (set (RectangularApproved value) (set-empty))) :ruleset rectangular-discover)
(rule ((RectangularRequirement value context input))
      ((set (RectangularRequired value) (set-of (Repeat context input))) (RepeatDemand context input)) :ruleset rectangular-discover)

; shortcut: all legal repetitions have equal cost until cost-based scheduling is added.
(function RepeatMapping (RepeatContext SourceValue) bool :no-merge)
(relation RepeatEdge (RepeatContext SourceValue SourceValue))
(function Repeatable (RepeatContext SourceValue) bool :merge (and old new))
(rule ((= mapping (RepeatMapping context value)))
      ((set (Repeatable context value) true)) :ruleset repeatability)
(rule ((RepeatDemand (OutsidePlan) value)) ((set (RepeatMapping (OutsidePlan) value) false)) :ruleset repeatability)
(rule ((RepeatDemand (InsidePlan plan) value) (= (SourceHasOperation value) false))
      ((set (RepeatMapping (InsidePlan plan) value) false)) :ruleset repeatability)
(rule ((RepeatDemand (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= other (SelectedPlan op)) (!= plan other))
      ((set (RepeatMapping (InsidePlan plan) value) false)) :ruleset repeatability)
(rule ((RepeatDemand (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= mapping (PlanMapping op)))
      ((set (RepeatMapping (InsidePlan plan) value) mapping)) :ruleset repeatability)
(rule ((= (RepeatMapping context value) false) (SourceDirectUse value child))
      ((RepeatEdge context value child)) :ruleset repeatability)
(rule ((= (RepeatMapping context value) false) (= (SourceBranch value) (BranchInfo test yes no))
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((RepeatEdge context value a) (RepeatEdge context value b)) :ruleset repeatability)
(rule ((RepeatDemand context value) (= argument (PlanCallArgument value i)))
      ((RepeatEdge context value argument)) :ruleset repeatability)
(rule ((= (RepeatMapping context value) false) (= op (SourceValueOperation value))
       (= (SourceDuplicable value) false)) ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((RepeatDemand context value) (= (CallHasCallee value) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((RepeatDemand context value) (= callee (PlanCallee value)) (= (SourceRegionDuplicable callee) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= (MappingCallbackIsScalar op) false))
      ((set (Repeatable (InsidePlan plan) value) false)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (SourceOperatorBody op)) (= result (SourceResult body)))
      ((RepeatEdge (InsidePlan plan) value result)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (SourceOperatorBody op)) (SourceCapture body formal actual))
      ((RepeatEdge (InsidePlan plan) value actual)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value)) (= input (SourceInput op i)))
      ((RepeatEdge (InsidePlan plan) value input)) :ruleset repeatability)
(rule ((RepeatEdge context value child)) ((RepeatDemand context child)) :ruleset repeatability)
(rule ((RepeatEdge context value child) (= (Repeatable context child) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((RectangularRequirement value context input) (= (Repeatable context input) true))
      ((set (RectangularApproved value) (set-of (Repeat context input)))) :ruleset traversal-proofs)
(relation RectangularReady (SourceValue))
(rule ((RectangularDemand value) (= (RectangularRequired value) (RectangularApproved value))) ((RectangularReady value)) :ruleset traversal-ready)

(rule ((RectangularDemand value) (= actual (SourceAlias value))) ((RectangularDemand actual)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= callee (PlanCallee value)) (= result (SourceResult callee)))
      ((RectangularDemand result)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= argument (PlanCallArgument value i)))
      ((RectangularRequirement value (OutsidePlan) argument)) :ruleset rectangular-discover)
