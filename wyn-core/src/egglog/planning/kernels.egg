(rule ((KernelNestDemand statement width depth ordinal)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat axes) body)))
       (< (+ depth 1) (vec-length axes)) (= axis (vec-get axes depth)) (= name (AxisName axis))
       (= prefix (KernelAxisPrefix (CollectiveStatement id 203 depth) axis ordinal))
       (= base (KernelAxisBase (CollectiveStatement id 203 depth) axis ordinal))
       (= size (KernelAxisCount (CollectiveStatement id 203 depth) axis ordinal))
       (= start (KernelAxisStart id depth)) (= step (KernelAxisStep id depth))
       (= nested (KernelNest statement width (+ depth 1) (IndexAdd base (IndexValue name))))
       (= (KernelOuterTokens statement depth) (Fragment initial merges returns pattern steps results final))
       (= env (KernelTokenMap statement depth)) (= nested-body (RenameBody env (Block nested results))))
      ((let count (IndexMax (IndexConstant 0) (IndexDiv (IndexAdd (IndexSub size start) (IndexSub step (IndexConstant 1))) step)))
       (set (KernelNest statement width depth ordinal) (vec-append prefix (vec-of
          (Let (CollectiveStatement id 205 depth) pattern (vec-of)
              (Loop merges (Counted name start count step) returns nested-body)))))) :ruleset kernel-memory-build)
(rule ((KernelNestDemand statement width depth ordinal)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (+ depth 1) (vec-length axes)) (= axis (vec-get axes depth)) (= name (AxisName axis))
       (= prefix (KernelAxisPrefix (CollectiveStatement id 203 depth) axis ordinal))
       (= base (KernelAxisBase (CollectiveStatement id 203 depth) axis ordinal))
       (= size (KernelAxisCount (CollectiveStatement id 203 depth) axis ordinal))
       (KernelClausesAt statement i inputs signature yes no writes (Fragment initial merges returns exits steps yielded final))
       (= i (vec-length clauses)) (= env (KernelTokenMap statement depth))
       (= guarded-body (RenameBody env (Block (vec-append statements writes) yes))) (= owner (KernelSegmentOwner id depth)))
      ((let scalar (ScalarInfo (ScalarElement (I32))))
       (let tile (CollectiveValue id 206 0))
       (let lane (Let (CollectiveStatement id 206 0) (vec-of (BindValue (CollectiveValue id 206 1) (ScalarInfo (ScalarElement (U32))))) (vec-of)
          (PrimOp "_w_intrinsic_local_id" (vec-of))))
       (let index (Let (CollectiveStatement id 206 1) (vec-of (BindValue name scalar)) (vec-of)
          (IndexOp (IndexAdd (IndexMul (IndexValue tile) (IndexConstant width)) (IndexValue (CollectiveValue id 206 1))))))
       (let ordinal-statement (Let (CollectiveStatement id 206 2) (vec-of (BindValue flat scalar)) (vec-of) (IndexOp (IndexAdd base (IndexValue name)))))
       (let limit (Let (CollectiveStatement id 206 3) (vec-of (BindValue (CollectiveValue id 206 2) scalar)) (vec-of) (IndexOp size)))
       (let active (Let (CollectiveStatement id 206 4) (vec-of (BindValue (CollectiveValue id 202 0) (ScalarInfo (ScalarElement (Bool)))))
          (vec-of) (PrimOp "<" (vec-of (Var name) (Var (CollectiveValue id 206 2))))))
       (let input (Let (CollectiveStatement id 206 5) inputs certs
          (If (Var (CollectiveValue id 202 0)) signature guarded-body (Block (vec-of) no))))
       (let count (IndexMul owner (IndexDiv (IndexAdd size (IndexConstant (- width 1))) (IndexConstant width))))
       (let loop (Let (CollectiveStatement id 206 6) exits (vec-of)
          (Loop merges (Counted tile (IndexConstant 0) count (IndexConstant 1)) returns
              (Block (vec-append (vec-of index ordinal-statement active input) steps) yielded))))
       (set (KernelNest statement width depth ordinal) (vec-append prefix
          (vec-append initial (vec-append (vec-of lane limit loop) final))))) :ruleset kernel-memory-build)

(set (PrimitiveEffects "_w_intrinsic_local_id" (ScalarElement (U32))) (set-empty))
(set (PrimitiveEffects "_w_intrinsic_workgroup_id" (VectorElement (U32) 3)) (set-empty))
(set (PrimitiveEffects "project:0" (ScalarElement (U32))) (set-empty))
(set (PrimitiveEffects "project:1" (ScalarElement (U32))) (set-empty))
(set (PrimitiveEffects "project:2" (ScalarElement (U32))) (set-empty))
(rule ((KernelDemand program function statement width)
       (= statement (Let id outputs certs (Parallel (DeviceKernel (Grid3D groups sizes)) domain (ParallelBlock statements clauses))))
       (KernelOutputsAt statement i before) (= i (vec-length outputs))
       (= body (KernelLaunchBody statement width))
       (KernelScalarOutputsAt statement i scalar-pattern scalar-results))
      ((let scalar (ScalarInfo (ScalarElement (I32))))
       (let coordinates (Let (CollectiveStatement id 207 0)
          (vec-of (BindValue (CollectiveValue id 207 0) (ScalarInfo (VectorElement (U32) 3)))) (vec-of)
          (PrimOp "_w_intrinsic_workgroup_id" (vec-of))))
       (let x (Let (CollectiveStatement id 207 1) (vec-of (BindValue (CollectiveValue id 207 1) (ScalarInfo (ScalarElement (U32))))) (vec-of)
          (PrimOp "project:0" (vec-of (Var (CollectiveValue id 207 0))))))
       (let y (Let (CollectiveStatement id 207 2) (vec-of (BindValue (CollectiveValue id 207 2) (ScalarInfo (ScalarElement (U32))))) (vec-of)
          (PrimOp "project:1" (vec-of (Var (CollectiveValue id 207 0))))))
       (let z (Let (CollectiveStatement id 207 3) (vec-of (BindValue (CollectiveValue id 207 3) (ScalarInfo (ScalarElement (U32))))) (vec-of)
          (PrimOp "project:2" (vec-of (Var (CollectiveValue id 207 0))))))
       (let group (Let (CollectiveStatement id 204 0) (vec-of (BindValue (CollectiveValue id 204 0) scalar)) (vec-of)
          (IndexOp (IndexAdd (IndexValue (CollectiveValue id 207 1))
              (IndexMul (vec-get groups 0) (IndexAdd (IndexValue (CollectiveValue id 207 2)) (IndexMul (vec-get groups 1) (IndexValue (CollectiveValue id 207 3)))))))))
       (let count (Let (CollectiveStatement id 204 1) (vec-of (BindValue (CollectiveValue id 204 1) scalar)) (vec-of)
          (IndexOp (IndexMul (vec-get groups 0) (IndexMul (vec-get groups 1) (vec-get groups 2))))))
       (let launch (Let id scalar-pattern certs (Launch
          (Grid3D groups (vec-of (IndexConstant width) (IndexConstant 1) (IndexConstant 1)))
          (Block (vec-append (vec-of coordinates x y z group count) body) scalar-results))))
       (set (PendingRewrite "kernel-memory" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-push before launch)))))
       (RewriteDemand "kernel-memory" program)) :ruleset kernel-memory-build)

(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements clauses)))
       (WalkParallelResults clauses i) (< i (vec-length clauses)) (= width (FoldWidth function (vec-get clauses i))))
      ((set (SelectedWidth function domain clauses) width)) :ruleset collective-memory-build)

(rule ((KernelDemand program function statement width)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= (HasFold clauses) true) (= body (KernelNest statement width 0 (IndexConstant 0))))
      ((set (KernelLaunchBody statement width) body)) :ruleset kernel-memory-build)

; Rectangular maps share output transfers with folds, but distribute the full
; flattened domain over invocations. Rank does not change the kernel algorithm.
(function KernelCoordinates (Stm i64) Stms :no-merge)
(rule ((KernelDemand program function statement width)
       (= statement (Let id pattern certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (HasFold clauses) false) (= shape (DomainExtents axes (vec-length axes))))
      ((DenseShape shape) (set (KernelCoordinates statement 0) (vec-of))
       (KernelTokenMapAt statement 0 0 0 (map-empty))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelCoordinates statement i))
       (= statement (Let id pattern certs (Parallel execution (IterationSpace flat axes) body)))
       (< i (vec-length axes)) (= (vec-get axes i) (DenseAxis name size))
       (= shape (DomainExtents axes (vec-length axes))) (= dims (DenseDimensions shape))
       (= (vec-get dims i) (Dim stride length)))
      ((set (KernelCoordinates statement (+ i 1)) (vec-push prefix
          (Let (CollectiveStatement id 214 i) (vec-of (BindValue name (ScalarInfo (ScalarElement (I32))))) (vec-of)
              (IndexOp (IndexMod (IndexDiv (IndexValue flat) (IndexMax (IndexConstant 1) stride)) (IndexMax (IndexConstant 1) size))))))) :ruleset kernel-memory-build)
(rule ((KernelDemand program function statement width)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= (HasFold clauses) false)
       (KernelClausesAt statement i inputs signature yes no writes fragment) (= i (vec-length clauses))
       (= env (KernelTokenMap statement 0)))
      ((RenameBodyDemand env (Block (vec-append statements writes) yes))) :ruleset kernel-memory-build)
(rule ((KernelDemand program function statement width)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (HasFold clauses) false) (= shape (DomainExtents axes (vec-length axes))) (= size (ElementCount shape))
       (= coordinates (KernelCoordinates statement (vec-length axes)))
       (KernelClausesAt statement i inputs signature yes no writes (Fragment initial merges returns exits steps yielded final))
       (= i (vec-length clauses)) (= env (KernelTokenMap statement 0))
       (= guarded-body (RenameBody env (Block (vec-append statements writes) yes))))
      ((let lane (Let (CollectiveStatement id 213 0)
          (vec-of (BindValue (CollectiveValue id 213 0) (ScalarInfo (ScalarElement (U32))))) (vec-of)
          (PrimOp "_w_intrinsic_local_id" (vec-of))))
       (let start (IndexAdd (IndexMul (IndexValue (CollectiveValue id 204 0)) (IndexConstant width)) (IndexValue (CollectiveValue id 213 0))))
       (let step (IndexMax (IndexConstant 1) (IndexMul (IndexValue (CollectiveValue id 204 1)) (IndexConstant width))))
       (let count (IndexMax (IndexConstant 0) (IndexDiv (IndexAdd (IndexSub size start) (IndexSub step (IndexConstant 1))) step)))
       (let input (Let (CollectiveStatement id 213 1) inputs certs
          (If (LiteralBits (Bool) 1) signature guarded-body (Block (vec-of) no))))
       (let loop (Let (CollectiveStatement id 213 2) exits (vec-of)
          (Loop merges (Counted flat start count step) returns
              (Block (vec-append coordinates (vec-append (vec-of input) steps)) yielded))))
       (set (KernelLaunchBody statement width) (vec-append initial (vec-append (vec-of lane loop) final)))) :ruleset kernel-memory-build)

; Move scalar preparation through a single effect-checked path. Launch executes
; it even for empty traversal; Parallel can only absorb total computations.
(ruleset kernel-prelude-analysis)
(ruleset kernel-prelude-select)
(relation ScalarPatternAt (Pattern i64))
(relation PreludeGap (Function Stm))
(relation RepeatablePrelude (Function Stm Accesses))
(relation ScalarPreludeForm (Exp))
(rule ((TotalScalarForm expression)) ((ScalarPreludeForm expression)) :ruleset kernel-prelude-analysis)
(rule ((= expression (Call name arguments returns))) ((ScalarPreludeForm expression)) :ruleset kernel-prelude-analysis)
(function PreludeIndependent (Function Exp) bool :merge (and old new))
(function PreludeBoundary (Exp) Names :no-merge)
(relation PrependPrelude (Stm Exp))
(function PrependedPrelude (Stm Exp) Exp :no-merge)
(relation KernelPreludePath (Program Function Stms Stm Accesses i64))
(relation KernelPreludeCandidate (Program Function Stm Stm Renaming))
(rule ((ContainsPattern root pattern)) ((ScalarPatternAt pattern 0)) :ruleset kernel-prelude-analysis)
(rule ((ScalarPatternAt pattern i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name (ScalarInfo element))))
      ((ScalarPatternAt pattern (+ i 1))) :ruleset kernel-prelude-analysis)
(rule ((ContainsExp (FunctionRoot function) expression))
      ((set (PreludeIndependent function expression) true)) :ruleset kernel-prelude-analysis)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (PrimOp opcode arguments)) (LaneBuiltin opcode))
      ((set (PreludeIndependent function expression) false)) :ruleset kernel-prelude-analysis)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Call name arguments returns))
       (ProgramFunction program function) (ProgramFunction program target)
       (= target (DefineFunction name params signature body)) (= (LaneDependentFunction target) true))
      ((set (PreludeIndependent function expression) false)) :ruleset kernel-prelude-analysis)
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Call name arguments returns))
       (ProgramFunction program function) (ProgramExternal program (DeclareExternal name params signature behavior accesses)))
      ((set (PreludeIndependent function expression) false)) :ruleset kernel-prelude-analysis)
(rule ((ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs expression)) (> (vec-length pattern) 0)
       (ScalarPatternAt pattern (vec-length pattern)) (ScalarPreludeForm expression)
       (= (EffectsStm function statement) (set-empty)))
      ((RepeatablePrelude function statement (set-empty))) :ruleset kernel-prelude-analysis)
(rule ((ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Load source indices))) (= (vec-length pattern) 1)
       (= (vec-get pattern 0) (BindValue name (ScalarInfo element))) (= reads (ArrayReads function source)))
      ((RepeatablePrelude function statement reads)) :ruleset kernel-prelude-analysis)
(rule ((ContainsStm (FunctionRoot function) statement) (= (EffectsStm function statement) (set-empty)))
      ((PreludeGap function statement)) :ruleset kernel-prelude-analysis)
(rule ((ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs (Alloc (DeviceSpace) bytes))))
      ((PreludeGap function statement)) :ruleset kernel-prelude-analysis)
(rule ((ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs (GenerateArray (Uninitialized element shape)))))
      ((PreludeGap function statement)) :ruleset kernel-prelude-analysis)
(rule ((= expression (Launch grid body)) (= names (NamesGrid grid)))
      ((set (PreludeBoundary expression) names)) :ruleset kernel-prelude-analysis)
(rule ((= expression (Parallel (DeviceKernel grid) domain (ParallelBlock statements results)))
       (= names (NamesGrid grid)) (= axes (NamesDomain domain)) (= outputs (NamesParallelResults results)))
      ((set (PreludeBoundary expression) (set-union names (set-union axes outputs)))) :ruleset kernel-prelude-analysis)
(rule ((PrependPrelude source expression) (= expression (Launch (Grid3D groups sizes) (Block statements results))))
      ((let grid (Grid3D (vec-of (IndexMax (IndexConstant 1) (vec-get groups 0))
          (IndexMax (IndexConstant 1) (vec-get groups 1)) (IndexMax (IndexConstant 1) (vec-get groups 2))) sizes))
       (set (PrependedPrelude source expression) (Launch grid (Block (vec-append (vec-of source) statements) results)))) :ruleset kernel-prelude-analysis)
(rule ((PrependPrelude source expression)
       (= expression (Parallel execution domain (ParallelBlock statements results))))
      ((set (PrependedPrelude source expression) (Parallel execution domain
          (ParallelBlock (vec-append (vec-of source) statements) results)))) :ruleset kernel-prelude-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (= function (DefineFunction name params returns body)) (= (EntryGrid name) (AutomaticGrid))
       (CheckSequence context statements available) (= function (ScopeRoot context)) (= (HostScope context) true)
       (WalkStms statements i) (< i (vec-length statements)) (= statement (vec-get statements i))
       (= statement (Let id pattern certs expression))
       (RepeatablePrelude function statement reads))
      ((KernelPreludePath program function statements statement reads (+ i 1))) :ruleset kernel-prelude-analysis)
(rule ((KernelPreludePath program function statements source reads j) (< j (vec-length statements))
       (= next (vec-get statements j)) (= effects (EffectsStm function next)))
      ((CompareEffects reads (set-remove effects (OrderedEffect)))) :ruleset kernel-prelude-analysis)
(rule ((KernelPreludePath program function statements source reads j) (< j (vec-length statements))
       (= next (vec-get statements j)) (= effects (EffectsStm function next))
       (= (Commutes reads (set-remove effects (OrderedEffect))) true) (PreludeGap function next)
       (= (set-intersect (BindersStm source) (set-diff (NamesStm next) (BindersStm next))) (set-empty)))
      ((KernelPreludePath program function statements source reads (+ j 1))) :ruleset kernel-prelude-analysis)
(rule ((KernelPreludePath program function statements source reads j) (< j (vec-length statements))
       (= next (vec-get statements j)) (= next (Let kid pattern certs expression))
       (= boundary (PreludeBoundary expression)) (= source (Let id inputs proofs preparation))
       (= effects (EffectsStm function next)) (= (Commutes reads (set-remove effects (OrderedEffect))) true)
       (= uses (set-union boundary (set-union (NamesPattern pattern) (NamesCertificates certs))))
       (= (set-intersect (BindersPattern inputs) uses) (set-empty)))
      ((let remaining (Rename (map-empty) (map-empty) (map-empty) (map-empty)
          (map-insert (map-insert (map-empty) id (vec-of)) kid (vec-of))))
       (KernelPreludeCandidate program function source next remaining)
       (RenameFunctionDemand remaining function)) :ruleset kernel-prelude-analysis)
(rule ((KernelPreludeCandidate program function source next remaining)
       (= next (Let kid pattern certs expression)) (= expression (Launch grid body)))
      ((PrependPrelude source expression)) :ruleset kernel-prelude-analysis)
(rule ((KernelPreludeCandidate program function source next remaining)
       (= next (Let kid pattern certs expression)) (= expression (Parallel execution domain body))
       (= (EffectsStm function source) (set-empty)))
      ((PrependPrelude source expression)) :ruleset kernel-prelude-analysis)
(rule ((KernelPreludeCandidate program function source next remaining) (CurrentProgram program)
       (= source (Let id inputs proofs preparation)) (= (PreludeIndependent function preparation) true)
       (= next (Let kid pattern certs expression)) (= replacement (PrependedPrelude source expression))
       (= outside (RenameFunction remaining function))
       (= (set-intersect (BindersPattern inputs) (NamesFunction outside)) (set-empty)))
      ((set (PendingRewrite "kernel-prelude" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-insert (map-empty) id (vec-of)) kid
                  (vec-of (Let kid pattern certs replacement))))))
       (RewriteDemand "kernel-prelude" program)) :ruleset kernel-prelude-select)

; The tuple budget applies across fused clauses, not independently per fold.
(rule ((CheckStatement context id pattern (Parallel execution domain body) available)
       (= body (ParallelBlock statements clauses)) (= function (ScopeRoot context))
       (= bytes (KernelBytes function clauses (vec-length clauses))) (> bytes 16384))
      ((SequentialBody context body)) :ruleset local-storage-rewrite)
