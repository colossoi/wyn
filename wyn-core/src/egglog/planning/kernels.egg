; Lower scheduled parallel results to ordinary memory statements.
(rule ((ContainsValueInfo (FunctionRoot function) (ArrayValue element shape)))
      ((set (ShapeElements function shape 0) 1)) :ruleset schedule-cost)
(rule ((= count (ShapeElements function shape i)) (< i (vec-length shape))
       (= n (StaticIndex function (vec-get shape i))) (>= n 0))
      ((set (ShapeElements function shape (+ i 1)) (* count n))) :ruleset schedule-cost)
(rule ((ContainsValueInfo (FunctionRoot function) info) (= info (ScalarInfo element)) (= bytes (ElementBytes element)))
      ((set (ValueBytes function info) bytes)) :ruleset schedule-cost)
(rule ((ContainsValueInfo (FunctionRoot function) info) (= info (ArrayValue element shape))
       (= count (ShapeElements function shape (vec-length shape))) (= bytes (ElementBytes element)))
      ((set (ValueBytes function info) (* count bytes))) :ruleset schedule-cost)
(rule ((ContainsParallelResult (FunctionRoot function) clause) (= clause (Fold kind (Reduction order neutral combine) values)))
      ((set (FoldStateBytes function clause 0) 0) (set (FoldWorkingBytes function clause 0) 0)
       (set (CooperativeFold function clause) false)) :ruleset collective-memory-analysis)
(rule ((ContainsParallelResult (FunctionRoot function) clause)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params returns (Block statements results))) values))
       (WalkAtoms neutral i) (< i (vec-length neutral)))
      ((set (FoldSlotInvariant function clause i) false)) :ruleset collective-memory-analysis)
(rule ((ContainsParallelResult (FunctionRoot function) clause)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params returns (Block statements results))) values))
       (WalkAtoms neutral i) (< i (vec-length neutral))
       (= (vec-get results i) (Yield proofs (ValueOperand atom)))
       (= (vec-get values i) (Yield lane-proofs (ValueOperand lane)))
       (= constant (ConstantAtom function atom)) (= constant (ConstantAtom function lane))
       (= constant (ConstantAtom function (vec-get neutral i))))
      ((set (FoldSlotInvariant function clause i) true)) :ruleset collective-memory-analysis)
(rule ((ContainsParallelResult (FunctionRoot function) clause)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (WalkAtoms neutral i) (< i (vec-length neutral))
       (= (vec-get params i) (Parameter (BindValue name info) diet)) (= bytes (ValueBytes function info)))
      ((set (FoldSlotBytes function clause i) bytes)) :ruleset collective-memory-analysis)
(rule ((= bytes (FoldStateBytes function clause i)) (= next (FoldSlotBytes function clause i)))
      ((set (FoldStateBytes function clause (+ i 1)) (+ bytes next))) :ruleset collective-memory-analysis)
; The working budget is finalized after invariant discovery reaches a fixed point.
(rule ((= bytes (FoldWorkingBytes function clause i)) (= next (FoldSlotBytes function clause i))
       (= (FoldSlotInvariant function clause i) false))
      ((set (FoldWorkingBytes function clause (+ i 1)) (+ bytes next))) :ruleset collective-memory-build)
(rule ((= bytes (FoldWorkingBytes function clause i)) (= next (FoldSlotBytes function clause i))
       (= (FoldSlotInvariant function clause i) true))
      ((set (FoldWorkingBytes function clause (+ i 1)) bytes)) :ruleset collective-memory-build)
(rule ((= clause (Fold kind (Reduction order neutral combine) values))
       (= bytes (FoldWorkingBytes function clause (vec-length neutral))))
      ((set (FoldWidth function clause) (min 256 (max 32 (<< 1 (log2 (max 1 (/ 8192 (max 1 bytes))))))))) :ruleset collective-memory-build)
(rule ((= clause (Fold kind (Reduction order neutral combine) values))
       (= bytes (FoldStateBytes function clause (vec-length neutral))) (= width (FoldWidth function clause))
       (<= (* bytes width) 16384))
      ((set (CooperativeFold function clause) true)) :ruleset collective-memory-build)

(ruleset kernel-memory-build)
(ruleset kernel-memory-select)
; A row transfer treats scalars as singleton rows and arrays as typed views.
; Array reads take a snapshot before any simultaneous destination writes.
(relation WriteRowDemand (StatementId ElementType BlockName LMAD Atom))
(function WriteRow (StatementId ElementType BlockName LMAD Atom) Stms :no-merge)
(rule ((WriteRowDemand id element block layout (Var source))
       (= layout (Layout offset dims)) (> (vec-length dims) 0))
      ((set (WriteRow id element block layout (Var source)) (vec-of
          (Let id (vec-of (BindValue (CollectiveValue id 0 0) (ArrayInfo element (ArrayIn block layout))))
              (vec-of) (Copy source))))) :ruleset kernel-memory-build)
(rule ((WriteRowDemand id element block (Layout offset dims) atom) (= (vec-length dims) 0))
      ((set (WriteRow id element block (Layout offset dims) atom) (vec-of
          (Let id (vec-of (BindValue (CollectiveValue id 0 0)
              (ArrayInfo element (ArrayIn block (Layout offset (vec-of (Dim (IndexConstant 1) (IndexConstant 1))))))))
              (vec-of) (GenerateArray (ArrayLiteral (vec-of atom))))))) :ruleset kernel-memory-build)
(rule ((ReadRowDemand id binding source indices) (= binding (BindValue name (ScalarInfo element))))
      ((set (ReadRow id binding source indices) (vec-of (Let id (vec-of binding) (vec-of) (Load source indices))))) :ruleset kernel-memory-build)
(rule ((ReadRowDemand id binding source indices))
      ((set (PointSlices indices 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((ReadRowDemand id binding source indices) (= binding (BindValue name (ArrayValue element shape)))
       (= slices (PointSlices indices (vec-length indices))))
      ((set (ReadRow id binding source indices) (vec-of
          (Let (CollectiveStatement id 0 0) (vec-of (BindValue (CollectiveValue id 0 0) (ArrayValue element shape)))
              (vec-of) (View source slices))
          (Let id (vec-of binding) (vec-of) (Copy (CollectiveValue id 0 0)))))) :ruleset kernel-memory-build)

(rule ((ContainsValueInfo (FunctionRoot function) info) (= info (ScalarInfo element)))
      ((set (FixedInfo function info) info)) :ruleset collective-memory-analysis)
(rule ((ContainsValueInfo (FunctionRoot function) info) (= info (ArrayValue element shape))
       (= fixed (ConstantShape function shape (vec-length shape))))
      ((set (FixedInfo function info) (ArrayValue element fixed))) :ruleset collective-memory-analysis)
(rule ((= info (ScalarInfo element)))
      ((set (RowElement info) element) (set (RowShape info) (vec-of))) :ruleset kernel-memory-build)
(rule ((= info (ArrayValue element shape)))
      ((set (RowElement info) element) (set (RowShape info) shape)) :ruleset kernel-memory-build)

; Each component retains its element type. The full tuple preserves dependent
; witness positions while the scratch allocation uses proven static extents.
(relation KernelFold (Function StatementId ParallelResult i64))
(function KernelBindings (StatementId ParallelResult i64 i64) Pattern :no-merge)
(function KernelArguments (StatementId ParallelResult i64 i64) Arguments :no-merge)
(function KernelResults (StatementId ParallelResult i64 i64) Results :no-merge)
(function KernelReturns (StatementId ParallelResult i64) ReturnInfos :no-merge)
(function KernelScratch (StatementId ParallelResult i64) Stms :no-merge)
(function KernelInfo (StatementId ParallelResult i64) ValueInfo :no-merge)
(relation KernelRole (i64))
; 1 carry, 2 next carry, 3 exited carry, 4 lane input, 5 tile prefix,
; 6 tile total, 7 prefix including carry; tree stages use nested statement IDs.
(KernelRole 1) (KernelRole 2) (KernelRole 3) (KernelRole 4)
(KernelRole 5) (KernelRole 6) (KernelRole 7)
(relation KernelTuple (StatementId ParallelResult))
(relation KernelChild (StatementId StatementId ParallelResult))
(rule ((KernelFold function id clause width)) ((KernelTuple id clause)) :ruleset kernel-memory-build)
(rule ((KernelChild parent child clause)) ((KernelTuple child clause)) :ruleset kernel-memory-build)
(rule ((KernelChild parent child clause) (= info (KernelInfo parent clause i)))
      ((set (KernelInfo child clause i) info)) :ruleset kernel-memory-build)
(rule ((KernelTuple id clause) (KernelRole role))
      ((set (KernelBindings id clause role 0) (vec-of))
       (set (KernelArguments id clause role 0) (vec-of))
       (set (KernelResults id clause role 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelTuple id clause)) ((set (KernelReturns id clause 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width))
      ((set (KernelScratch id clause 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width)
       (= clause (Fold kind (Reduction order neutral (FunctionBody params signature body)) values))
       (WalkAtoms neutral i) (< i (vec-length neutral))
       (= (vec-get params i) (Parameter (BindValue name info) diet)) (= fixed (FixedInfo function info)))
      ((set (KernelInfo id clause i) fixed)) :ruleset kernel-memory-build)
(rule ((= prefix (KernelBindings id clause role i)) (= info (KernelInfo id clause i)))
      ((set (KernelBindings id clause role (+ i 1)) (vec-push prefix (BindValue (CollectiveValue id role i) info)))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelArguments id clause role i)) (= info (KernelInfo id clause i)))
      ((set (KernelArguments id clause role (+ i 1)) (vec-push prefix (Pass (ValueOperand (Var (CollectiveValue id role i))) (Observe))))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelResults id clause role i)) (= info (KernelInfo id clause i)))
      ((set (KernelResults id clause role (+ i 1)) (vec-push prefix (Yield (vec-of) (ValueOperand (Var (CollectiveValue id role i))))))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelReturns id clause i)) (= (KernelInfo id clause i) (ScalarInfo element)))
      ((set (KernelReturns id clause (+ i 1)) (vec-push prefix (ReturnScalar element)))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelReturns id clause i)) (= (KernelInfo id clause i) (ArrayValue element shape))
       (= ext (FreeShape shape (vec-length shape))))
      ((set (KernelReturns id clause (+ i 1)) (vec-push prefix (ReturnArrayValue element ext)))) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width) (= prefix (KernelScratch id clause i))
       (= info (KernelInfo id clause i)) (= element (RowElement info)) (= shape (RowShape info)))
      ((DenseShape shape)) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width) (= prefix (KernelScratch id clause i))
       (= info (KernelInfo id clause i)) (= element (RowElement info)) (= shape (RowShape info))
       (= dims (DenseDimensions shape)) (= count (ElementCount shape)) (= bytes (ElementBytes element)))
      ((let capacity (IndexMul (IndexConstant (* width bytes)) count))
       (let block (CallMemory (CollectiveStatement id 100 i) (MemoryId 0)))
       (let full (vec-append (vec-of (Dim count (IndexConstant width))) dims))
       (set (KernelScratch id clause (+ i 1)) (vec-append prefix (vec-of
          (Let (CollectiveStatement id 100 i) (vec-of (BindBlock block capacity)) (vec-of) (Alloc (WorkgroupSpace) capacity))
          (Let (CollectiveStatement id 101 i)
              (vec-of (BindValue (CollectiveValue id 0 i) (ArrayInfo element (ArrayIn block (Layout (IndexConstant 0) full)))))
              (vec-of) (GenerateArray (Uninitialized element (vec-append (vec-of (IndexConstant width)) shape)))))))) :ruleset kernel-memory-build)

(relation KernelReadDemand (StatementId StatementId ParallelResult i64 IndexExp))
(function KernelRead (StatementId StatementId ParallelResult i64 IndexExp i64) Stms :no-merge)
(relation KernelWriteDemand (StatementId StatementId ParallelResult i64 IndexExp))
(function KernelWrite (StatementId StatementId ParallelResult i64 IndexExp i64) Stms :no-merge)
(rule ((KernelReadDemand call id clause role row))
      ((set (KernelRead call id clause role row 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelRead call id clause role row i)) (= info (KernelInfo id clause i)))
      ((ReadRowDemand (CollectiveStatement call role i) (BindValue (CollectiveValue call role i) info) (CollectiveValue id 0 i) (vec-of row))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelRead call id clause role row i)) (= info (KernelInfo id clause i))
       (= next (ReadRow (CollectiveStatement call role i) (BindValue (CollectiveValue call role i) info) (CollectiveValue id 0 i) (vec-of row))))
      ((set (KernelRead call id clause role row (+ i 1)) (vec-append prefix next))) :ruleset kernel-memory-build)
(rule ((KernelWriteDemand call id clause role row))
      ((set (KernelWrite call id clause role row 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelWrite call id clause role row i)) (= info (KernelInfo id clause i))
       (= shape (RowShape info)) (= element (RowElement info)) (= count (ElementCount shape)) (= dims (DenseDimensions shape)))
      ((WriteRowDemand (CollectiveStatement call (+ 100 role) i) element (CallMemory (CollectiveStatement id 100 i) (MemoryId 0))
          (Layout (IndexMul row count) dims) (Var (CollectiveValue call role i)))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelWrite call id clause role row i)) (= info (KernelInfo id clause i))
       (= shape (RowShape info)) (= element (RowElement info)) (= count (ElementCount shape)) (= dims (DenseDimensions shape))
       (= next (WriteRow (CollectiveStatement call (+ 100 role) i) element (CallMemory (CollectiveStatement id 100 i) (MemoryId 0))
          (Layout (IndexMul row count) dims) (Var (CollectiveValue call role i)))))
      ((set (KernelWrite call id clause role row (+ i 1)) (vec-append prefix next))) :ruleset kernel-memory-build)

; Inclusive doubling scan: every lane snapshots its sources before the barrier
; preceding writes. Array-valued operators therefore need no alias repair here.
(relation KernelScanAt (StatementId ParallelResult i64 ValueName i64 Stms))
(function KernelScan (StatementId ParallelResult i64 ValueName) Stms :no-merge)
(rule ((KernelFold function id clause width))
      ((KernelScanAt id clause width (CollectiveValue id 90 0) 1 (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelScanAt id clause width lane stride prefix) (< stride width))
      ((let stage (CollectiveStatement id 110 stride))
       (KernelChild id stage clause)
       (KernelReadDemand stage id clause 1 (IndexValue lane))
       (KernelReadDemand stage id clause 2 (IndexSub (IndexValue lane) (IndexConstant stride)))
       (KernelWriteDemand stage id clause 3 (IndexValue lane))) :ruleset kernel-memory-build)
(rule ((KernelScanAt id clause width lane stride prefix) (< stride width)
       (= clause (Fold kind (Reduction order neutral combine) values))
       (= stage (CollectiveStatement id 110 stride)) (= n (vec-length neutral))
       (= pattern (KernelBindings stage clause 4 n))
       (= left (KernelArguments stage clause 2 n)) (= right (KernelArguments stage clause 1 n)))
      ((ApplyLambdaDemand (CollectiveStatement stage 90 0) pattern (vec-of) combine (vec-append left right))) :ruleset kernel-memory-build)
(rule ((KernelScanAt id clause width lane stride prefix) (< stride width)
       (= clause (Fold kind (Reduction order neutral combine) values))
       (= stage (CollectiveStatement id 110 stride)) (= n (vec-length neutral))
       (= own (KernelRead stage id clause 1 (IndexValue lane) n))
       (= neighbor (KernelRead stage id clause 2 (IndexSub (IndexValue lane) (IndexConstant stride)) n))
       (= pattern (KernelBindings stage clause 4 n))
       (= left (KernelArguments stage clause 2 n)) (= right (KernelArguments stage clause 1 n))
       (= apply (ApplyLambda (CollectiveStatement stage 90 0) pattern (vec-of) combine (vec-append left right)))
       (= selected (KernelBindings stage clause 3 n)) (= returns (KernelReturns stage clause n))
       (= combined (KernelResults stage clause 4 n)) (= unchanged (KernelResults stage clause 1 n))
       (= writes (KernelWrite stage id clause 3 (IndexValue lane) n)))
      ((let condition (Let (CollectiveStatement stage 90 1)
          (vec-of (BindValue (CollectiveValue stage 90 0) (ScalarInfo (ScalarElement (Bool))))) (vec-of)
          (PrimOp "<" (vec-of (Var lane) (LiteralBits (U32) stride)))))
       (let choose (Let (CollectiveStatement stage 90 2) selected (vec-of)
          (If (Var (CollectiveValue stage 90 0)) returns (Block (vec-of) unchanged)
              (Block (vec-append neighbor apply) combined))))
       (let before (Let (CollectiveStatement stage 90 3) (vec-of) (vec-of) (Barrier (WorkgroupFence))))
       (let after (Let (CollectiveStatement stage 90 4) (vec-of) (vec-of) (Barrier (WorkgroupFence))))
       (KernelScanAt id clause width lane (* 2 stride)
          (vec-append prefix (vec-append own (vec-append (vec-of condition choose before) (vec-append writes (vec-of after))))))) :ruleset kernel-memory-build)
(rule ((KernelScanAt id clause width lane stride prefix) (= stride width))
      ((set (KernelScan id clause width lane) prefix)) :ruleset kernel-memory-build)

; These are the same accumulator carries as sequential lowering, without a
; second per-element state model for array-valued combiners.
(function KernelMerges (StatementId ParallelResult i64) Merges :no-merge)
(rule ((KernelTuple id clause)) ((set (KernelMerges id clause 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelMerges id clause i)) (= info (KernelInfo id clause i))
       (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral)))
      ((set (KernelMerges id clause (+ i 1)) (vec-push prefix
          (Carry (Parameter (BindValue (CollectiveValue id 1 i) info) (Observe)) (ValueOperand (vec-get neutral i)))))) :ruleset kernel-memory-build)
(function KernelNeutral (ParallelResult i64) Results :no-merge)
(rule ((KernelTuple id clause)) ((set (KernelNeutral clause 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((= prefix (KernelNeutral clause i)) (= clause (Fold kind (Reduction order neutral combine) values)) (< i (vec-length neutral)))
      ((set (KernelNeutral clause (+ i 1)) (vec-push prefix (Yield (vec-of) (ValueOperand (vec-get neutral i)))))) :ruleset kernel-memory-build)

; Output arrays use ordinary initialization or a proven consumed-input alias.
; The common allocator chooses their blocks after kernel construction.
(relation KernelOutputDemand (StatementId Binding))
(function KernelOutput (StatementId Binding) Stms :no-merge)
(function KernelOutputSource (Binding) Exp :no-merge)
(rule ((KernelOutputDemand id binding) (= binding (BindValue name (ArrayValue element shape)))
       (= expression (KernelOutputSource binding)))
      ((set (KernelOutput id binding) (vec-of
          (Let (CollectiveStatement id 0 1) (vec-of binding) (vec-of) expression)))) :ruleset kernel-memory-build)
(rule ((KernelOutputDemand id binding) (= binding (BindValue name (ScalarInfo element))))
      ((set (KernelOutput id binding) (vec-of))) :ruleset kernel-memory-build)

(relation KernelStoreDemand (StatementId Binding Indices Atom))
(function KernelStore (StatementId Binding Indices Atom) Stms :no-merge)
(rule ((KernelStoreDemand id binding indices atom)) ((set (PointSlices indices 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelStoreDemand id binding indices atom) (= binding (BindValue name (ArrayValue element shape)))
       (= slices (PointSlices indices (vec-length indices))))
      ((set (KernelStore id binding indices atom) (vec-of
          (Let id (vec-of) (vec-of) (Store (ProvenInBounds) name slices atom))))) :ruleset kernel-memory-build)
(rule ((KernelStoreDemand id binding indices atom) (= binding (BindValue name (ScalarInfo element))))
      ((set (KernelStore id binding indices atom) (vec-of))) :ruleset kernel-memory-build)

(ruleset kernel-memory-native)
(function NativeKernel (Function ParallelResults) bool :merge (and old new))
(function NativeNeutrals (Function Atoms i64) bool :no-merge)
(rule ((ContainsParallelBody (FunctionRoot function) (ParallelBlock statements clauses)) (= enabled (SubgroupsEnabled)))
      ((set (NativeKernel function clauses) enabled)) :ruleset kernel-memory-native)
(rule ((ContainsParallelResult (FunctionRoot function) (Fold kind (Reduction order neutral combine) values)))
      ((set (NativeNeutrals function neutral 0) true)) :ruleset collective-memory-analysis)
(rule ((= prefix (NativeNeutrals function neutral i)) (< i (vec-length neutral))
       (= (vec-get neutral i) (LiteralBits (I32) 0)))
      ((set (NativeNeutrals function neutral (+ i 1)) prefix)) :ruleset collective-memory-analysis)
(rule ((= prefix (NativeNeutrals function neutral i)) (< i (vec-length neutral))
       (= atom (vec-get neutral i)) (!= atom (LiteralBits (I32) 0)))
      ((set (NativeNeutrals function neutral (+ i 1)) false)) :ruleset collective-memory-analysis)
(rule ((ContainsParallelBody (FunctionRoot function) (ParallelBlock statements clauses))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral combine) values))
       (= enabled (SubgroupsEnabled)) (= addition (NativeAddition combine)) (= zeros (NativeNeutrals function neutral (vec-length neutral))))
      ((set (NativeKernel function clauses) (and enabled (and addition zeros)))) :ruleset kernel-memory-native)

(rule ((ContainsParallelBody (FunctionRoot function) (ParallelBlock statements clauses))
       (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral combine) values)) (= (NativeAddition combine) false))
      ((set (NativeKernel function clauses) false)) :ruleset kernel-memory-native)

(function KernelBytes (Function ParallelResults i64) i64 :no-merge)
(rule ((ContainsParallelBody (FunctionRoot function) (ParallelBlock statements clauses)))
      ((set (KernelBytes function clauses 0) 0)) :ruleset collective-memory-analysis)
(rule ((= bytes (KernelBytes function clauses i)) (< i (vec-length clauses))
       (= clause (vec-get clauses i)) (= clause (Fold kind (Reduction order neutral combine) values))
       (= next (FoldStateBytes function clause (vec-length neutral))))
      ((set (KernelBytes function clauses (+ i 1)) (+ bytes next))) :ruleset collective-memory-analysis)
(rule ((= bytes (KernelBytes function clauses i)) (< i (vec-length clauses)) (= (vec-get clauses i) (Collect values)))
      ((set (KernelBytes function clauses (+ i 1)) bytes)) :ruleset collective-memory-analysis)
(rule ((= bytes (KernelBytes function clauses i)) (< i (vec-length clauses)) (= (vec-get clauses i) (Contribute tokens)))
      ((set (KernelBytes function clauses (+ i 1)) bytes)) :ruleset collective-memory-analysis)
(function KernelCarryDepth (Stm) i64 :no-merge)
(function KernelLaunchBody (Stm i64) Stms :no-merge)
(relation KernelDemand (Program Function Stm i64))
(relation KernelCandidate (Program Function Stm i64))
(function KernelCandidates (Program Function) Statements :merge (set-union old new))
(rule ((KernelCandidate program function statement width))
      ((set (KernelCandidates program function) (set-of statement))) :ruleset kernel-memory-select)
; Select after discovery, so a binding is elaborated in only one program revision.
(rule ((CurrentProgram program) (= candidates (KernelCandidates program function))
       (= statement (set-get candidates 0)) (KernelCandidate program function statement width))
      ((KernelDemand program function statement width)) :ruleset kernel-memory-build)
(rule ((KernelDemand program function statement width) (= statement (Let id pattern certs expression))
       (WalkPattern pattern i) (< i (vec-length pattern)) (= binding (vec-get pattern i))
       (= binding (BindValue name (ArrayValue element shape))) (= inputs (ReuseInputs function name)) (= (set-length inputs) 0))
      ((set (KernelOutputSource binding) (GenerateArray (Uninitialized element shape)))) :ruleset kernel-memory-build)
(rule ((KernelDemand program function statement width) (= statement (Let id pattern certs expression))
       (WalkPattern pattern i) (< i (vec-length pattern)) (= binding (vec-get pattern i))
       (= binding (BindValue name (ArrayValue element shape))) (= inputs (ReuseInputs function name)) (> (set-length inputs) 0))
      ((set (KernelOutputSource binding) (Use (ValueOperand (Var (set-get inputs 0)))))) :ruleset kernel-memory-build)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (DeviceKernel (Grid3D groups sizes)) domain (ParallelBlock statements clauses))))
       (= (HasFold clauses) true) (= (NativeKernel function clauses) false)
       (= bytes (KernelBytes function clauses (vec-length clauses)))
       (= (vec-get sizes 0) (IndexConstant width)))
      ((KernelCandidate program function statement (min width (<< 1 (log2 (max 1 (/ 16384 (max 1 bytes)))))))) :ruleset kernel-memory-select)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (DeviceKernel (Grid3D groups sizes))
          (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (HasFold clauses) false) (DenseDomain axes) (= (vec-get sizes 0) (IndexConstant width)))
      ((KernelCandidate program function statement width) (set (KernelCarryDepth statement) 0)) :ruleset kernel-memory-select)
(rule ((KernelDemand program function statement width)
       (= statement (Let id pattern certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (HasFold clauses) true))
      ((set (KernelCarryDepth statement) (- (vec-length axes) 1))) :ruleset kernel-memory-build)

(function KernelPrefixRead (StatementId ParallelResult i64) Stms :no-merge)
(rule ((KernelFold function id clause width) (= clause (Fold kind reducer values)) (FoldOutputs kind scans 2 totals))
      ((KernelReadDemand id id clause 5 (IndexValue (CollectiveValue id 90 0)))) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width) (= clause (Fold kind (Reduction order neutral combine) values))
       (FoldOutputs kind scans 2 totals)
       (= read (KernelRead id id clause 5 (IndexValue (CollectiveValue id 90 0)) (vec-length neutral))))
      ((set (KernelPrefixRead id clause width) read)) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width) (= clause (Fold kind reducer values)) (FoldOutputs kind scans 1 totals))
      ((let child (CollectiveStatement id 111 0)) (KernelChild id child clause)
       (KernelReadDemand child id clause 5 (IndexMax (IndexConstant 0) (IndexSub (IndexValue (CollectiveValue id 90 0)) (IndexConstant 1))))) :ruleset kernel-memory-build)
(rule ((KernelFold function id clause width) (= clause (Fold kind (Reduction order neutral combine) values))
       (FoldOutputs kind scans 1 totals) (= child (CollectiveStatement id 111 0)) (= n (vec-length neutral))
       (= read (KernelRead child id clause 5 (IndexMax (IndexConstant 0) (IndexSub (IndexValue (CollectiveValue id 90 0)) (IndexConstant 1))) n))
       (= pattern (KernelBindings id clause 5 n)) (= returns (KernelReturns id clause n))
       (= zero (KernelNeutral clause n)) (= previous (KernelResults child clause 5 n)))
      ((set (KernelPrefixRead id clause width) (vec-append read (vec-of
          (Let (CollectiveStatement id 111 1) (vec-of (BindValue (CollectiveValue id 91 0) (ScalarInfo (ScalarElement (Bool)))))
              (vec-of) (PrimOp "<" (vec-of (Var (CollectiveValue id 90 0)) (LiteralBits (U32) 1))))
          (Let (CollectiveStatement id 111 2) pattern (vec-of)
              (If (Var (CollectiveValue id 91 0)) returns (Block (vec-of) zero) (Block (vec-of) previous))))))) :ruleset kernel-memory-build)

(relation KernelFoldOutput (StatementId ParallelResult Pattern Indices Indices ValueName IndexExp))
(function KernelPrefixes (StatementId ParallelResult Pattern Indices i64) Stms :no-merge)
(function KernelTotals (StatementId ParallelResult Pattern Indices i64) Stms :no-merge)
(rule ((KernelFoldOutput id clause pattern indices outer active owner))
      ((set (KernelPrefixes id clause pattern indices 0) (vec-of))
       (set (KernelTotals id clause pattern outer 0) (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelFoldOutput id clause pattern indices outer active owner)
       (= clause (Fold kind (Reduction order neutral combine) values)) (= n (vec-length neutral))
       (FoldOutputs kind 0 role total))
      ((set (KernelPrefixes id clause pattern indices n) (vec-of))) :ruleset kernel-memory-build)
(rule ((KernelFoldOutput id clause pattern indices outer active owner)
       (= clause (Fold kind (Reduction order neutral combine) values)) (= n (vec-length neutral))
