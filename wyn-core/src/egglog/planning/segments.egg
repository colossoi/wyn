; A workgroup owns one rectangular map coordinate and streams its collective
; straight to that coordinate's output. No intermediate row is materialized.
(ruleset segment-shapes)
(ruleset segment-select)
(ruleset segment-approve)
(function SegmentCandidatePlan (SourceValue) FusionPlan :no-merge)
(function SegmentPlanBlocked (FusionPlan) bool :merge (or old new))
(rule ((RectangularDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasReductions plan) true))
      ((set (SegmentCandidatePlan value) plan)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasScans plan) true))
      ((set (SegmentCandidatePlan value) plan)) :ruleset rectangular-discover)
(rule ((= plan (SegmentCandidatePlan value))) ((set (SegmentPlanBlocked plan) false)) :ruleset rectangular-discover)
(rule ((= blocked (SegmentPlanBlocked plan)) (PlanMember plan op) (= body (SourceOperatorBody op))
       (= (SourceRegionDuplicable body) false))
      ((set (SegmentPlanBlocked plan) true)) :ruleset rectangular-discover)
(rule ((= plan (SegmentCandidatePlan value)) (PlanMember plan op) (= body (SourceOperatorBody op))
       (SourceCapture body formal actual))
      ((RectangularRequirement value (OutsidePlan) actual)) :ruleset rectangular-discover)
(rule ((= plan (SegmentCandidatePlan value)) (PlanMember plan op) (= input (SourceInput op i)) (= (PlanInternal plan input) false))
      ((RectangularRequirement value (OutsidePlan) input)) :ruleset rectangular-discover)
(rule ((= plan (SegmentCandidatePlan value)) (PlanMember plan op) (= neutral (SourceNeutral op)))
      ((RectangularRequirement value (OutsidePlan) neutral)) :ruleset rectangular-discover)

; Follow exactly the map axes already selected by rectangular scheduling.
(relation SegmentDemand (SourceValue i64))
(datatype SegmentRecipe (SegmentResult SourceValue OperationKey FusionPlan String i64))
(function SegmentTerminal (SourceValue i64) SegmentRecipe :no-merge)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element))
      ((SegmentDemand value rank)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (= actual (SourceAlias value)))
      ((SegmentDemand actual depth)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (= actual (SourceAlias value)) (= terminal (SegmentTerminal actual depth)))
      ((set (SegmentTerminal value depth) terminal)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (RectangularReady value) (= callee (PlanCallee value)) (= result (SourceResult callee)))
      ((SegmentDemand result depth)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (RectangularReady value) (= callee (PlanCallee value))
       (= result (SourceResult callee)) (= terminal (SegmentTerminal result depth)))
      ((set (SegmentTerminal value depth) terminal)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (> depth 0) (MapCandidate value plan op body) (RectangularReady value)
       (= result (SourceResult body)))
      ((SegmentDemand result (- depth 1))) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (> depth 0) (MapCandidate value plan op body) (RectangularReady value)
       (= result (SourceResult body)) (= terminal (SegmentTerminal result (- depth 1))))
      ((set (SegmentTerminal value depth) terminal)) :ruleset segment-shapes)
(rule ((SegmentDemand value 0) (= plan (SegmentCandidatePlan value)) (RectangularReady value)
       (= (SegmentPlanBlocked plan) false) (= owner (Owner plan)) (PlanResult plan "array" i value ty))
      ((set (SegmentTerminal value 0) (SegmentResult value owner plan "array" i))) :ruleset segment-shapes)
(rule ((SegmentDemand value 0) (= plan (SegmentCandidatePlan value)) (RectangularReady value)
       (= (SegmentPlanBlocked plan) false) (= owner (Owner plan)) (Accumulator owner slot ty "total" i value))
      ((set (SegmentTerminal value 0) (SegmentResult value owner plan "total" slot))) :ruleset segment-shapes)

(function SegmentExtent (SourceValue i64) Extent :no-merge)
(rule ((SegmentDemand value 0) (= plan (SegmentCandidatePlan value)) (= domain (PlanDomain plan))
       (= extent (RectangularExtent (SourceDomainExtent domain))))
      ((set (SegmentExtent value 0) extent)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (= actual (SourceAlias value)) (= extent (SegmentExtent actual depth)))
      ((set (SegmentExtent value depth) extent)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= extent (SegmentExtent result depth)))
      ((set (SegmentExtent value depth) (CallExtent value extent))) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (> depth 0) (MapCandidate value plan op body)
       (= result (SourceResult body)) (= extent (SegmentExtent result (- depth 1))))
      ((set (SegmentExtent value depth) extent)) :ruleset segment-shapes)
(rule ((= extent (SegmentExtent value depth))) ((set (ExtentUniform extent) true)) :ruleset extent-uniformity)

(sort SegmentOutputs (Set SourceValue))
(function SegmentRequiredOutputs (FusionPlan) SegmentOutputs :merge (set-union old new))
(function SegmentApprovedOutputs (FusionPlan) SegmentOutputs :merge (set-union old new))
(rule ((MapPlan plan owner extent))
      ((set (MapCooperative owner) false) (set (SegmentApprovedOutputs plan) (set-empty))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element))
      ((set (SegmentRequiredOutputs plan) (set-of value))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element) (= terminal (SegmentTerminal value rank))
       (= segment (SegmentExtent value rank)) (= (ExtentUniform segment) true))
      ((set (SegmentApprovedOutputs plan) (set-of value))) :ruleset segment-approve)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (= (SegmentRequiredOutputs plan) (SegmentApprovedOutputs plan)))
      ((set (MapCooperative owner) true)) :ruleset segment-select)
