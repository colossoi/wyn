; A workgroup owns one rectangular map coordinate and streams its collective
; straight to that coordinate's output. No intermediate row is materialized.
(ruleset segment-shapes)
(ruleset segment-select)
(relation SegmentCandidate (SourceValue FusionPlan))
(relation SegmentFixedDomain (FusionPlan))
(rule ((Current group plan) (= domain (PlanDomain plan)) (= input (SourceInput domain 0))
       (= ty (SourceType input)) (= (SourceArraySize ty) (FixedSize n)))
      ((SegmentFixedDomain plan)) :ruleset map-discover)
(rule ((Current group plan) (= domain (PlanDomain plan)) (= (SourceDomainExtent domain) (Fixed n)))
      ((SegmentFixedDomain plan)) :ruleset map-discover)
(function SegmentBlocked (SourceValue) bool :merge (or old new))
(rule ((MapDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasReductions plan) true))
      ((SegmentCandidate value plan)) :ruleset map-discover)
(rule ((MapDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasScans plan) true))
      ((SegmentCandidate value plan)) :ruleset map-discover)
(rule ((SegmentCandidate value plan)) ((set (SegmentBlocked value) false)) :ruleset map-discover)
(rule ((SegmentCandidate value plan) (PlanMember plan op) (= body (PlanCallback plan op))
       (= (SourceRegionDuplicable body) false))
      ((set (SegmentBlocked value) true)) :ruleset map-discover)
(rule ((SegmentCandidate value plan) (PlanMember plan op) (= body (PlanCallback plan op))
       (SourceCapture body formal actual))
      ((MapRequirement value (OutsidePlan) actual)) :ruleset map-discover)
(rule ((SegmentCandidate value plan) (= input (PlanRoute plan op i)) (= (PlanInternal plan input) false))
      ((MapRequirement value (OutsidePlan) input)) :ruleset map-discover)
(rule ((SegmentCandidate value plan) (PlanMember plan op) (= neutral (SourceNeutral op)))
      ((MapRequirement value (OutsidePlan) neutral)) :ruleset map-discover)

; Follow exactly the map axes already selected by rectangular scheduling.
(relation SegmentDemand (SourceValue i64))
(datatype SegmentRecipe (SegmentResult SourceValue OperationKey FusionPlan String i64))
(function SegmentTerminal (SourceValue i64) SegmentRecipe :no-merge)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= rank (MapLaunchRank owner))
       (PlanResult plan "array" i value element))
      ((SegmentDemand value rank)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (= actual (SourceAlias value)))
      ((SegmentDemand actual depth)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (= actual (SourceAlias value)) (= terminal (SegmentTerminal actual depth)))
      ((set (SegmentTerminal value depth) terminal)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (MapReady value) (= callee (PlanCallee value)) (= result (SourceResult callee)))
      ((SegmentDemand result depth)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (MapReady value) (= callee (PlanCallee value))
       (= result (SourceResult callee)) (= terminal (SegmentTerminal result depth)))
      ((set (SegmentTerminal value depth) terminal)) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (> depth 0) (MapCandidate value plan op body) (MapReady value)
       (= result (SourceResult body)))
      ((SegmentDemand result (- depth 1))) :ruleset segment-shapes)
(rule ((SegmentDemand value depth) (> depth 0) (MapCandidate value plan op body) (MapReady value)
       (= result (SourceResult body)) (= terminal (SegmentTerminal result (- depth 1))))
      ((set (SegmentTerminal value depth) terminal)) :ruleset segment-shapes)
; shortcut: runtime segment lengths need a workgroup-uniformity proof before barriers are introduced.
(rule ((SegmentDemand value 0) (SegmentCandidate value plan) (SegmentFixedDomain plan) (MapReady value)
       (= (SegmentBlocked value) false) (= owner (Owner plan)) (PlanResult plan "array" i value ty))
      ((set (SegmentTerminal value 0) (SegmentResult value owner plan "array" i))) :ruleset segment-shapes)
(rule ((SegmentDemand value 0) (SegmentCandidate value plan) (SegmentFixedDomain plan) (MapReady value)
       (= (SegmentBlocked value) false) (= owner (Owner plan)) (PlanResult plan "total" i value ty)
       (= scans (PlanScans plan)) (= count (ResultCount scans)))
      ((set (SegmentTerminal value 0) (SegmentResult value owner plan "total" (+ count i)))) :ruleset segment-shapes)

(sort SegmentOutputs (Set SourceValue))
(function SegmentRequired (FusionPlan) SegmentOutputs :merge (set-union old new))
(function SegmentApproved (FusionPlan) SegmentOutputs :merge (set-union old new))
(rule ((MapPlan plan owner extent))
      ((set (MapCooperative owner) false) (set (SegmentApproved plan) (set-empty))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element))
      ((set (SegmentRequired plan) (set-of value))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= rank (MapLaunchRank owner))
       (PlanResult plan "array" i value element) (= terminal (SegmentTerminal value rank)))
      ((set (SegmentApproved plan) (set-of value))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (= (SegmentRequired plan) (SegmentApproved plan)))
      ((set (MapCooperative owner) true)) :ruleset segment-select)
