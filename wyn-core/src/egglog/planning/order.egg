; Select a dependency order within each invocation before forming scalar groups.
(sort ScheduledOperations (Set OperationKey))
(function OrderPrerequisites (OperationKey) ScheduledOperations :merge (set-union old new))
(function OrderSatisfied (OperationKey) ScheduledOperations :merge (set-union old new))
(relation OrderReady (OperationKey RegionKey i64))
(relation OrderPending (OperationKey RegionKey i64))
(relation OrderRound (RegionKey i64))
(function OrderFirst (RegionKey i64) i64 :merge (min old new))
(ruleset order-import)
(ruleset order-select)
(ruleset order-emit)
(rule ((PlannedSourcePosition op r i))
      ((set (OrderPrerequisites op) (set-empty)) (set (OrderSatisfied op) (set-empty))
       (OrderPending op r i) (OrderRound r 0)) :ruleset order-import)
(rule ((SourceDependency after before) (PlannedSourcePosition after r i) (PlannedSourcePosition before r j))
      ((set (OrderPrerequisites after) (set-of before))) :ruleset order-import)
(rule ((EffectInput gate before) (EffectWait after gate)
       (PlannedSourcePosition after r i) (PlannedSourcePosition before r j))
      ((set (OrderPrerequisites after) (set-of before))) :ruleset order-import)
(rule ((= deps (OrderPrerequisites after)) (set-contains deps before)
       (SourcePosition before r n))
      ((set (OrderSatisfied after) (set-of before))) :ruleset order-select)
(rule ((OrderPending op r i) (= (OrderPrerequisites op) (OrderSatisfied op)))
      ((OrderReady op r i)) :ruleset order-select)
(rule ((OrderRound r n) (OrderReady op r i))
      ((set (OrderFirst r n) i)) :ruleset order-select)
(rule ((OrderRound r n) (= i (OrderFirst r n)) (OrderReady op r i))
      ((SourcePosition op r n) (delete (OrderReady op r i))
       (delete (OrderPending op r i)) (delete (OrderRound r n)) (OrderRound r (+ n 1))) :ruleset order-emit)
(rule ((SourcePosition before r i) (SourcePosition after r j) (= j (+ i 1)))
      ((Consecutive before after)) :ruleset order-emit)
(run-schedule (saturate order-import) (saturate (saturate order-select) order-emit))
