; Move closed, total array producers across a parallel parameter scope. The
; dependency walk includes captures; no index-expression pattern is required.
(ruleset invariant-discover)
(ruleset invariant-select)
(ruleset invariant-commit)
(relation ParallelParent (RegionKey RegionKey OperationKey))
(rule ((Current group plan) (= outer (PlanScope plan)) (= owner (Owner plan))
       (PlanMember plan map) (= (PlanMapping map) true) (= inner (SourceOperatorBody map)))
      ((ParallelParent inner outer owner)) :ruleset invariant-discover)
(relation InvariantCandidate (FusionGroup FusionPlan OperationKey RegionKey RegionKey SourceValue))
(relation InvariantUse (SourceValue SourceValue))
(function InvariantBlocked (SourceValue RegionKey) bool :merge (or old new))
(rule ((Current group plan) (= inner (PlanScope plan)) (= owner (Owner plan))
       (= (PlanBody plan) (ParallelLoop domain (NoResults) (NoResults) arrays (Publish)))
       (= source (SourceOperationValue owner)) (= (SourceSpeculatable source) true)
       (= (SourceReadOnly source) true) (ParallelParent inner outer parent))
      ((InvariantCandidate group plan owner inner outer source) (InvariantUse source source)) :ruleset invariant-discover)
(rule ((InvariantCandidate group plan owner child inner source) (ParallelParent inner outer parent))
      ((InvariantCandidate group plan owner inner outer source)) :ruleset invariant-discover)
(rule ((InvariantCandidate group plan owner inner outer source))
      ((set (InvariantBlocked source inner) false)) :ruleset invariant-discover)
(rule ((InvariantUse source value) (SourceUse value child)) ((InvariantUse source child)) :ruleset invariant-discover)
(rule ((InvariantUse source value) (= actual (SourceAlias value))) ((InvariantUse source actual)) :ruleset invariant-discover)
(rule ((InvariantUse source value) (= (SourceCapture region value) actual))
      ((InvariantUse source actual)) :ruleset invariant-discover)
(rule ((InvariantCandidate group plan owner inner outer source) (InvariantUse source value)
       (= value (SourceParameter inner i))) ((set (InvariantBlocked source inner) true)) :ruleset invariant-discover)
(rule ((InvariantCandidate group plan owner inner outer source) (InvariantUse source value) (SourceReadsBinding value set binding) (SourceMutableBinding set binding))
      ((set (InvariantBlocked source inner) true)) :ruleset invariant-discover)
(rule ((InvariantCandidate group plan owner inner outer source) (InvariantUse source value) (SourceSummaryEnters value region) (= (RegionRecursive region) true))
      ((set (InvariantBlocked source inner) true)) :ruleset invariant-discover)
(relation InvariantPath (FusionPlan RegionKey i64))
(function InvariantDistance (FusionPlan) i64 :merge (max old new))
(rule ((InvariantCandidate group plan owner inner outer source) (= start (PlanScope plan)))
      ((InvariantPath plan start 0)) :ruleset invariant-select)
(rule ((InvariantPath plan inner n) (InvariantCandidate group plan owner inner outer source)
       (= (InvariantBlocked source inner) false))
      ((InvariantPath plan outer (+ n 1)) (set (InvariantDistance plan) (+ n 1))) :ruleset invariant-select)
(ruleset invariant-replacement)
(rule ((InvariantPath plan outer n) (= n (InvariantDistance plan)) (= body (PlanBody plan)) (= owner (Owner plan)))
      ((set (PlanBody (Lifted plan outer)) body) (set (Owner (Lifted plan outer)) owner)
       (set (PlanScope (Lifted plan outer)) outer)) :ruleset invariant-replacement)
(rule ((= body (PlanBody (Lifted plan outer))) (PlanMember plan member))
      ((PlanMember (Lifted plan outer) member)) :ruleset invariant-replacement)
(rule ((Current group plan) (= body (PlanBody (Lifted plan outer))) (= owner (Owner plan)))
      ((delete (Current group plan)) (delete (SelectedPlan owner)) (Current group (Lifted plan outer))) :ruleset invariant-commit)

; Every crossed boundary captures the moved result. Normal reference planning
; owns allocation, kernel arguments, and producer/consumer ordering.
(rule ((Current group (Lifted plan outer)) (InvariantPath plan inner n) (< n (InvariantDistance plan))
       (ParallelParent inner parent-region parent) (= owner (Owner plan)) (!= owner parent)
       (PlanResult plan kind i value ty))
      ((Operand parent "environment" value) (OperationDependency parent owner)) :ruleset planning-import)
