; Storage demand names an array field, not every member of its containing tuple.
(datatype StoragePath (StorageRoot) (StorageField i64 StoragePath))
(relation AppendStorageDemand (StoragePath i64))
(function AppendStorageField (StoragePath i64) StoragePath :no-merge)
(relation StorageDemand (SourceValue StoragePath))
(relation ValueStorage (SourceValue ExecutionScope))
(ruleset local-storage)
(rule ((= (LocalExecution owner (WorkgroupScope)) (WorkgroupScope))
       (Current group plan) (= owner (Owner plan)) (PlanResult plan "array" i source ty))
      ((StorageDemand source (StorageRoot))) :ruleset local-storage)
(rule ((PlannedOperation original owner plan region)
       (= (LocalExecution owner (WorkgroupScope)) (WorkgroupScope))
       (SourceOperand original source) (= ty (SourceType source)) (SourceArrayType ty))
      ((StorageDemand source (StorageRoot))) :ruleset local-storage)
(rule ((PlannedOperation original owner plan region)
       (= (LocalExecution owner (WorkgroupScope)) (WorkgroupScope))
       (= body (SourceOperatorBody original)) (= (SourceCapture body formal) actual)
       (= ty (SourceType actual)) (SourceArrayType ty))
      ((StorageDemand actual (StorageRoot))) :ruleset local-storage)
(rule ((StorageDemand source (StorageRoot)))
      ((ValueStorage source (WorkgroupScope))) :ruleset local-storage)
(rule ((StorageDemand source path) (= (SourceAlias source) actual))
      ((StorageDemand actual path)) :ruleset local-storage)
(rule ((StorageDemand formal path) (= (SourceCapture region formal) actual))
      ((StorageDemand actual path)) :ruleset local-storage)
(rule ((StorageDemand source path) (= (SourceProjection source) (ProjectionInfo parent i)))
      ((StorageDemand parent (StorageField i path))) :ruleset local-storage)
(rule ((StorageDemand source (StorageField i path)) (SourceField source i field))
      ((StorageDemand field path)) :ruleset local-storage)
(rule ((StorageDemand field path) (SourceField source i field))
      ((StorageDemand source (StorageField i path))) :ruleset local-storage)
; Arrays needed by an array-producing expression remain available to its lanes.
; Scalar dependencies (indices, lengths, predicates) do not demand shared arrays.
(rule ((StorageDemand source (StorageRoot)) (= ty (SourceType source)) (SourceArrayType ty)
       (SourceDirectUse source input) (= input-ty (SourceType input)) (SourceArrayType input-ty))
      ((StorageDemand input (StorageRoot))) :ruleset local-storage)
(rule ((StorageDemand state path) (SourceLoopBackedge region state next))
      ((StorageDemand next path)) :ruleset local-storage)
(rule ((StorageDemand next path) (SourceLoopBackedge region state next))
      ((StorageDemand state path)) :ruleset local-storage)
(relation BoundaryMember (SourceValue SourceValue))
(rule ((= (SourceLoop source) (LoopInfo header iteration))
       (= (SourceLoopInitial header) (LoopInitialInfo state initial)))
      ((BoundaryMember source state) (BoundaryMember source initial)) :ruleset local-storage)
(rule ((= (SourceLoop source) (LoopInfo header iteration)) (= result (SourceResult iteration)))
      ((BoundaryMember source result)) :ruleset local-storage)
(rule ((= (SourceBranch source) (BranchInfo test yes no)) (= a (SourceResult yes)) (= b (SourceResult no)))
      ((BoundaryMember source a) (BoundaryMember source b)) :ruleset local-storage)
(rule ((BoundaryMember boundary member) (StorageDemand member path))
      ((StorageDemand boundary path)) :ruleset local-storage)
(rule ((BoundaryMember boundary member) (StorageDemand boundary path))
      ((StorageDemand member path)) :ruleset local-storage)

; Freeze a physical plan after storage demand reaches a fixed point. Rust only
; allocates the requested destinations and emits the selected transfers.
(sort BoundaryPlan)
(sort BoundaryPlans (Vec BoundaryPlan))
(constructor BoundaryValue (LocalLayout) BoundaryPlan)
(constructor BoundaryArray (LocalLayout) BoundaryPlan)
(constructor BoundaryTuple (LocalLayout BoundaryPlans) BoundaryPlan)
(relation BoundaryShape (SourceValue StoragePath LocalLayout))
(function BoundaryFields (SourceValue StoragePath i64) BoundaryPlans :no-merge)
(function BoundaryFieldPlan (SourceValue StoragePath) BoundaryPlan :no-merge)
(function BoundaryFieldShared (SourceValue StoragePath) bool :merge (or old new))
(function BoundaryTransfer (SourceValue) bool :no-merge)
(ruleset boundary-select)
(ruleset boundary-fields)
(rule ((BoundaryMember source member) (= layout (ValueRepresentation source)))
      ((BoundaryShape source (StorageRoot) layout)) :ruleset local-storage)
(rule ((BoundaryShape source path layout))
      ((set (BoundaryFieldShared source path) false)) :ruleset local-storage)
(rule ((BoundaryShape source path layout) (StorageDemand source path))
      ((set (BoundaryFieldShared source path) true)) :ruleset local-storage)
(rule ((BoundaryShape source path (TupleLayout ty fields)))
      ((set (BoundaryFields source path 0) (vec-of))) :ruleset local-storage)
; Generate all field paths without waiting for field plans.
(relation BoundaryIndex (SourceValue StoragePath i64))
(rule ((BoundaryShape source path (TupleLayout ty fields)))
      ((BoundaryIndex source path 0)) :ruleset local-storage)
(rule ((BoundaryIndex source path i) (BoundaryShape source path (TupleLayout ty fields)) (< i (vec-length fields)))
      ((AppendStorageDemand path i)
       (BoundaryIndex source path (+ i 1))) :ruleset local-storage)
(rule ((BoundaryIndex source path i) (BoundaryShape source path (TupleLayout ty fields)) (< i (vec-length fields))
       (= child (AppendStorageField path i)))
      ((BoundaryShape source child (vec-get fields i))) :ruleset local-storage)
(rule ((AppendStorageDemand (StorageRoot) i))
      ((set (AppendStorageField (StorageRoot) i) (StorageField i (StorageRoot)))) :ruleset local-storage)
(rule ((AppendStorageDemand path i) (= path (StorageField j tail)))
      ((AppendStorageDemand tail i)) :ruleset local-storage)
(rule ((AppendStorageDemand path i) (= path (StorageField j tail)) (= child (AppendStorageField tail i)))
      ((set (AppendStorageField path i) (StorageField j child))) :ruleset local-storage)
(rule ((BoundaryShape source path (ValueLayout ty)))
      ((set (BoundaryFieldPlan source path) (BoundaryValue (ValueLayout ty)))) :ruleset boundary-select)
(rule ((BoundaryShape source path layout) (= layout (ViewLayout resource element)))
      ((set (BoundaryFieldPlan source path) (BoundaryValue layout))) :ruleset boundary-select)
(rule ((BoundaryShape source path layout) (= layout (ArrayLayout n element))
       (= (BoundaryFieldShared source path) false))
      ((set (BoundaryFieldPlan source path) (BoundaryValue layout))) :ruleset boundary-select)
(rule ((BoundaryShape source path layout) (= layout (ArrayLayout n element))
       (= (BoundaryFieldShared source path) true))
      ((set (BoundaryFieldPlan source path) (BoundaryArray layout))) :ruleset boundary-select)
(rule ((BoundaryShape source path layout) (= layout (TupleLayout ty fields))
       (= plans (BoundaryFields source path i)) (< i (vec-length fields))
       (= child (AppendStorageField path i)) (= plan (BoundaryFieldPlan source child)))
      ((set (BoundaryFields source path (+ i 1)) (vec-push plans plan))) :ruleset boundary-fields)
(rule ((BoundaryShape source path layout) (= layout (TupleLayout ty fields))
       (= plans (BoundaryFields source path (vec-length fields))))
      ((set (BoundaryFieldPlan source path) (BoundaryTuple layout plans))) :ruleset boundary-fields)
; Loop destinations are reused: capture sources before parallel assignment.
; Branch destinations are fresh, so they cannot overwrite an incoming source.
(rule ((= (SourceLoop source) loop)) ((set (BoundaryTransfer source) true)) :ruleset boundary-select)
(rule ((= (SourceBranch source) branch)) ((set (BoundaryTransfer source) false)) :ruleset boundary-select)

(function BoundaryHasShared (BoundaryPlan) bool :merge (or old new))
(rule ((= plan (BoundaryValue layout))) ((set (BoundaryHasShared plan) false)) :ruleset boundary-fields)
(rule ((= plan (BoundaryArray layout))) ((set (BoundaryHasShared plan) true)) :ruleset boundary-fields)
(rule ((= plan (BoundaryTuple layout fields))) ((set (BoundaryHasShared plan) false)) :ruleset boundary-fields)
(relation BoundaryPlanIndex (BoundaryPlan i64))
(rule ((= plan (BoundaryTuple layout fields))) ((BoundaryPlanIndex plan 0)) :ruleset boundary-fields)
(rule ((BoundaryPlanIndex plan i) (= plan (BoundaryTuple layout fields)) (< i (vec-length fields)))
      ((BoundaryPlanIndex plan (+ i 1))) :ruleset boundary-fields)
(rule ((BoundaryPlanIndex plan i) (= plan (BoundaryTuple layout fields)) (< i (vec-length fields))
       (= (BoundaryHasShared (vec-get fields i)) true))
      ((set (BoundaryHasShared plan) true)) :ruleset boundary-fields)
