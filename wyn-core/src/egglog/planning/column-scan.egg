; Interchange a pointwise array combiner and a scan over rectangular rows.
(relation ColumnScanCandidate (OperationKey ValueName IndexExp RegionKey OperationKey))
(relation ColumnScanInput (OperationKey Name i64))
(function ColumnScanLoad (OperationKey OperationKey) i64 :no-merge)
(function ColumnScanStep (OperationKey OperationKey) bool :merge (or old new))
(function ColumnScanUse (OperationKey OperationKey) bool :merge (or old new))
(function ColumnScanSafe (OperationKey) bool :merge (and old new))
(datatype ColumnScanPlan (ScanColumns ValueName IndexExp OperationKey ValueName))
(function ColumnScan (OperationKey) ColumnScanPlan :no-merge)
(rule ((EmittedDispatch scan) (= (OperationExecution scan) (DeviceKernel (AutomaticGrid)))
       (= (ResultCount scan) 1) (= (OutputCount scan) 1) (= (ResultKindOf scan 0) (Folded (InclusiveScan)))
       (= (ResultNeutralCount scan 0) 1) (= (ResultNeutral scan 0 0) (ValueNameRef neutral))
       (= width (LogicalOuterCount neutral)) (= (KnownIndex width) false)
       (= domain (OperationDomain scan)) (= (DomainRank domain) 1)
       (= lane (ControlRegion scan 0)) (FirstOperation lane read) (LastOperation lane read)
       (IndexOperation read) (= (InputCount read) 2) (= (Input read 1) (ValueNameRef (DomainAxis domain 0)))
       (= (Input read 0) (ValueNameRef source)) (= (CollectionRank source) 2) (= (CollectionExtent source 1) width)
       (= (CollectionExtent source 0) (DomainExtent domain 0))
       (= (Output read 0) (ResultValue scan 0 0))
       (= reducer (ResultReducer scan 0)) (= (RegionParameterCount reducer) 2)
       (= (RegionYieldCount reducer) 1) (= (RegionYield reducer 0) result)
       (LastOperation reducer map) (= (Output map 0) result)
       (= (ResultCount map) 1) (= (ResultKindOf map 0) (Collected)) (= (ResultValueCount map 0) 1)
       (= (ResultValue map 0 0) (ValueNameRef element)) (= (ValueType element) (ScalarInfo scalar))
       (= columns (OperationDomain map)) (= (DomainRank columns) 1)
       (FirstOperation reducer length) (NextOperation length map) (LengthOperation length 0)
       (= (Input length 0) (ValueNameRef accumulator)) (= (RegionParameter reducer 0) (ValueNameRef accumulator))
       (CountLength (DomainExtent columns 0) accumulator))
      ((ColumnScanCandidate scan source width reducer map) (set (ColumnScanSafe scan) true)) :ruleset execution-features)
(rule ((ColumnScanCandidate scan source width reducer map) (= input (RegionParameter reducer slot)))
      ((ColumnScanInput scan input slot)) :ruleset execution-features)
(rule ((ColumnScanCandidate scan source width reducer map) (= body (ControlRegion map 0))
       (= body (OperationRegion load)) (IndexOperation load) (= (InputCount load) 2)
       (= operand (Input load 0)) (ColumnScanInput scan operand slot)
       (= columns (OperationDomain map)) (= (Input load 1) (ValueNameRef (DomainAxis columns 0))))
      ((set (ColumnScanLoad scan load) slot) (set (ColumnScanStep scan load) true)
       (set (ColumnScanUse scan load) true)) :ruleset execution-features)
(rule ((ColumnScanCandidate scan source width reducer map) (= body (ControlRegion map 0)) (= body (OperationRegion operation)))
      ((set (ColumnScanStep scan operation) false)) :ruleset execution-features)
(rule ((= flag (ColumnScanStep scan operation)) (= (PureOperation operation) true))
      ((set (ColumnScanStep scan operation) true)) :ruleset execution-features)
(rule ((ColumnScanCandidate scan source width reducer map) (= body (ControlRegion map 0))
       (= body (OperationRegion operation)) (OperationUse operation operand) (ColumnScanInput scan operand slot))
      ((set (ColumnScanUse scan operation) false)) :ruleset execution-features)
(rule ((ColumnScanCandidate scan source width reducer map) (InvocationDependent map))
      ((set (ColumnScanSafe scan) false)) :ruleset execution-features)
(rule ((= (ColumnScanStep scan operation) false))
      ((set (ColumnScanSafe scan) false)) :ruleset execution-policy)
(rule ((= (ColumnScanUse scan operation) false))
      ((set (ColumnScanSafe scan) false)) :ruleset execution-policy)
(rule ((ColumnScanCandidate scan source width reducer map) (= (ColumnScanSafe scan) true)
       (FirstOperation reducer length) (= (Output length 0) (ValueNameRef count)))
      ((set (ColumnScan scan) (ScanColumns source width map count))) :ruleset execution-select)
