; Allocation bounds are proofs, not replacements for device-side live lengths.
(ruleset capacity-types)
(ruleset integer-bounds)
(ruleset capacity-select)
(relation CapacityInteger (FlowValue))
(function IntegerLower (FlowValue) i64 :merge (max old new))
(function IntegerUpper (FlowValue) i64 :merge (min old new))

(rule ((LengthType t) (= t (SourceType s))) ((CapacityInteger (FlowValueOf s))) :ruleset capacity-types)

(rule ((= n (SourceInteger32 s)) (>= n -2147483648) (<= n 2147483647))
      ((set (IntegerLower (FlowValueOf s)) n) (set (IntegerUpper (FlowValueOf s)) n)) :ruleset integer-bounds)
(rule ((= a (SourceLength s)) (= t (SourceType a)) (= (SourceArraySize t) (FixedSize n)))
      ((set (IntegerLower (FlowValueOf s)) n) (set (IntegerUpper (FlowValueOf s)) n)) :ruleset integer-bounds)
(rule ((= a (SourceLength s)) (= (ValueRepresentation a) (ArrayLayout n element)))
      ((set (IntegerLower (FlowValueOf s)) 0) (set (IntegerUpper (FlowValueOf s)) n)) :ruleset integer-bounds)
(rule ((= a (SourceLength s)) (= n (StaticCapacityBound (Length a))))
      ((set (IntegerLower (FlowValueOf s)) 0) (set (IntegerUpper (FlowValueOf s)) n)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (FlowBinary s "+" a b) (= lo (+ (IntegerLower a) (IntegerLower b)))
       (= hi (+ (IntegerUpper a) (IntegerUpper b))) (>= lo -2147483648) (<= hi 2147483647))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (FlowBinary s "-" a b) (= lo (- (IntegerLower a) (IntegerUpper b)))
       (= hi (- (IntegerUpper a) (IntegerLower b))) (>= lo -2147483648) (<= hi 2147483647))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (FlowBinary s "*" a b) (= al (IntegerLower a)) (= bl (IntegerLower b)) (>= al 0) (>= bl 0)
       (= hi (* (IntegerUpper a) (IntegerUpper b))) (<= hi 2147483647))
      ((set (IntegerLower s) (* al bl)) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (FlowBinary s "/" a b) (= divisor (IntegerLower b)) (= divisor (IntegerUpper b)) (> divisor 0)
       (= lo (/ (IntegerLower a) divisor)) (= hi (/ (IntegerUpper a) divisor)))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((FlowBranch s a b) (= lo (min (IntegerLower a) (IntegerLower b)))
       (= hi (max (IntegerUpper a) (IntegerUpper b))))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((= r (SourceCallTarget call)) (= result (SourceResult r)) (= lo (IntegerLower (FlowValueOf result)))
       (= hi (IntegerUpper (FlowValueOf result))))
      ((set (IntegerLower (FlowValueOf call)) lo) (set (IntegerUpper (FlowValueOf call)) hi)) :ruleset integer-bounds)

; A narrowing loop's two endpoints start in a nonnegative, nonoverflowing
; interval. Under lo < hi, lo + (hi-lo)/k lies in [lo,hi-1] for k >= 2.
; The backedge must preserve both endpoints inside [lo,hi]. This proves an
; invariant independently of the data-dependent branch choosing the endpoint.
(relation NarrowingLoop (SourceValue FlowValue FlowValue FlowValue FlowValue i64 i64))
(relation NarrowingValue (SourceValue FlowValue i64))
(relation NarrowingField (SourceValue FlowValue i64))
(rule ((= (SourceLoop loop) (LoopInfo header body)) (= (SourceLoopForm loop) (WhileCondition condition))
       (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (FlowBinary (FlowValueOf condition) "<" lo hi) (CapacityInteger lo) (CapacityInteger hi)
       (FlowProject lo (FlowValueOf state) li) (FlowProject hi (FlowValueOf state) ui)
       (!= li ui) (FlowField (FlowValueOf initial) li a) (FlowField (FlowValueOf initial) ui b)
       (= lower (IntegerLower a)) (= upper (IntegerUpper b)) (>= lower 0) (<= (IntegerUpper a) (IntegerLower b)))
      ((NarrowingLoop loop lo hi (FlowValueOf initial) (FlowValueOf state) li ui)
       (NarrowingValue loop lo 0) (NarrowingValue loop hi 0)) :ruleset integer-bounds)
(rule ((NarrowingLoop loop lo hi initial state li ui)
       (FlowBinary difference "-" hi lo) (FlowBinary quotient "/" difference divisor)
       (= k (IntegerLower divisor)) (= k (IntegerUpper divisor)) (>= k 2)
       (FlowBinary middle "+" lo quotient))
      ((NarrowingValue loop middle -1) (NarrowingValue loop middle 0)) :ruleset integer-bounds)
(rule ((NarrowingValue loop value -1) (FlowBinary next "+" value one)
       (= (IntegerLower one) 1) (= (IntegerUpper one) 1))
      ((NarrowingValue loop next 0)) :ruleset integer-bounds)
(rule ((FlowField tuple i value) (NarrowingValue loop value 0))
      ((NarrowingField loop tuple i)) :ruleset integer-bounds)
(rule ((FlowBranch tuple a b) (NarrowingField loop a i) (NarrowingField loop b i))
      ((NarrowingField loop tuple i)) :ruleset integer-bounds)
(rule ((NarrowingLoop loop lo hi initial state li ui) (= (SourceLoop loop) (LoopInfo header body))
       (= result (SourceResult body)) (NarrowingField loop (FlowValueOf result) li)
       (NarrowingField loop (FlowValueOf result) ui) (FlowProject value (FlowValueOf loop) i)
       (FlowField initial li a) (FlowField initial ui b) (= lower (IntegerLower a)) (= upper (IntegerUpper b))
       (= i li))
      ((set (IntegerLower value) lower) (set (IntegerUpper value) upper)) :ruleset integer-bounds)
(rule ((NarrowingLoop loop lo hi initial state li ui) (= (SourceLoop loop) (LoopInfo header body))
       (= result (SourceResult body)) (NarrowingField loop (FlowValueOf result) li)
       (NarrowingField loop (FlowValueOf result) ui) (FlowProject value (FlowValueOf loop) ui)
       (FlowField initial li a) (FlowField initial ui b) (= lower (IntegerLower a)) (= upper (IntegerUpper b)))
      ((set (IntegerLower value) lower) (set (IntegerUpper value) upper)) :ruleset integer-bounds)

(rule ((= n (IntegerUpper (FlowValueOf source))))
      ((set (HostBound (Scalar source)) (Fixed n))) :ruleset capacity-select)

(rule ((Difference (Scalar end) (Scalar start)) (= hi (IntegerUpper (FlowValueOf end))) (= lo (IntegerLower (FlowValueOf start))))
      ((set (HostBound (Difference (Scalar end) (Scalar start))) (Fixed (max 0 (- hi lo))))) :ruleset capacity-select)

; Exact integer ranges also normalize equivalent logical shape expressions.
(rule ((Scalar source) (= n (IntegerLower (FlowValueOf source))) (= n (IntegerUpper (FlowValueOf source))))
      ((set (ConstantLogicalExtent (Scalar source)) n)) :ruleset representations)
(rule ((Length source) (= extent (ViewExtent source)) (= n (ConstantLogicalExtent extent)))
      ((set (ConstantLogicalExtent (Length source)) n)) :ruleset representations)
(rule ((Difference a b) (= x (ConstantLogicalExtent a)) (= y (ConstantLogicalExtent b)))
      ((set (ConstantLogicalExtent (Difference a b)) (- x y))) :ruleset representations)
(rule ((Sum a b) (= x (ConstantLogicalExtent a)) (= y (ConstantLogicalExtent b)))
      ((set (ConstantLogicalExtent (Sum a b)) (+ x y))) :ruleset representations)
