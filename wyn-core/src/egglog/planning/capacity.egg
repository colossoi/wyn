; Allocation bounds are proofs, not replacements for device-side live lengths.
(ruleset capacity-identities)
(ruleset integer-bounds)
(ruleset capacity-select)
(sort CapacityIdentity)
(constructor CapacitySource (SourceValue) CapacityIdentity)
(relation CapacityInteger (CapacityIdentity))
(relation CapacityBinary (CapacityIdentity String CapacityIdentity CapacityIdentity))
(relation CapacityField (CapacityIdentity i64 CapacityIdentity))
(relation CapacityProjection (CapacityIdentity CapacityIdentity i64))
(relation CapacityBranch (CapacityIdentity CapacityIdentity CapacityIdentity))
(function IntegerLower (CapacityIdentity) i64 :merge (max old new))
(function IntegerUpper (CapacityIdentity) i64 :merge (min old new))

(rule ((LengthType t) (= t (SourceType s))) ((CapacityInteger (CapacitySource s))) :ruleset capacity-identities)
(rule ((= t (SourceType s))) ((CapacitySource s)) :ruleset capacity-identities)
(rule ((= a (SourceAlias s))) ((union (CapacitySource s) (CapacitySource a))) :ruleset capacity-identities)
(rule ((= a (SourceCapture r s))) ((union (CapacitySource s) (CapacitySource a))) :ruleset capacity-identities)
(rule ((SourceField s i a)) ((CapacityField (CapacitySource s) i (CapacitySource a))) :ruleset capacity-identities)
(rule ((= (SourceProjection s) (ProjectionInfo a i)))
      ((CapacityProjection (CapacitySource s) (CapacitySource a) i)) :ruleset capacity-identities)
(rule ((CapacityProjection s a i) (CapacityField a i v)) ((union s v)) :ruleset capacity-identities)
(rule ((SourceBinary s op a b))
      ((CapacityBinary (CapacitySource s) op (CapacitySource a) (CapacitySource b))) :ruleset capacity-identities)
(rule ((= (SourceBranch s) (BranchInfo condition yes no)) (= a (SourceResult yes)) (= b (SourceResult no)))
      ((CapacityBranch (CapacitySource s) (CapacitySource a) (CapacitySource b))) :ruleset capacity-identities)

(rule ((= n (SourceInteger32 s)) (>= n -2147483648) (<= n 2147483647))
      ((set (IntegerLower (CapacitySource s)) n) (set (IntegerUpper (CapacitySource s)) n)) :ruleset integer-bounds)
(rule ((= a (SourceLength s)) (= t (SourceType a)) (= (SourceArraySize t) (FixedSize n)))
      ((set (IntegerLower (CapacitySource s)) n) (set (IntegerUpper (CapacitySource s)) n)) :ruleset integer-bounds)
(rule ((= a (SourceLength s)) (= (ValueRepresentation a) (ArrayLayout n element)))
      ((set (IntegerLower (CapacitySource s)) 0) (set (IntegerUpper (CapacitySource s)) n)) :ruleset integer-bounds)
(rule ((= a (SourceLength s)) (= n (StaticCapacityBound (Length a))))
      ((set (IntegerLower (CapacitySource s)) 0) (set (IntegerUpper (CapacitySource s)) n)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (CapacityBinary s "+" a b) (= lo (+ (IntegerLower a) (IntegerLower b)))
       (= hi (+ (IntegerUpper a) (IntegerUpper b))) (>= lo -2147483648) (<= hi 2147483647))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (CapacityBinary s "-" a b) (= lo (- (IntegerLower a) (IntegerUpper b)))
       (= hi (- (IntegerUpper a) (IntegerLower b))) (>= lo -2147483648) (<= hi 2147483647))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (CapacityBinary s "*" a b) (= al (IntegerLower a)) (= bl (IntegerLower b)) (>= al 0) (>= bl 0)
       (= hi (* (IntegerUpper a) (IntegerUpper b))) (<= hi 2147483647))
      ((set (IntegerLower s) (* al bl)) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityInteger s) (CapacityBinary s "/" a b) (= divisor (IntegerLower b)) (= divisor (IntegerUpper b)) (> divisor 0)
       (= lo (/ (IntegerLower a) divisor)) (= hi (/ (IntegerUpper a) divisor)))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((CapacityBranch s a b) (= lo (min (IntegerLower a) (IntegerLower b)))
       (= hi (max (IntegerUpper a) (IntegerUpper b))))
      ((set (IntegerLower s) lo) (set (IntegerUpper s) hi)) :ruleset integer-bounds)
(rule ((= r (PlanCallee call)) (= result (SourceResult r)) (= lo (IntegerLower (CapacitySource result)))
       (= hi (IntegerUpper (CapacitySource result))))
      ((set (IntegerLower (CapacitySource call)) lo) (set (IntegerUpper (CapacitySource call)) hi)) :ruleset integer-bounds)

; A narrowing loop's two endpoints start in a nonnegative, nonoverflowing
; interval. Under lo < hi, lo + (hi-lo)/k lies in [lo,hi-1] for k >= 2.
; The backedge must preserve both endpoints inside [lo,hi]. This proves an
; invariant independently of the data-dependent branch choosing the endpoint.
(relation NarrowingLoop (SourceValue CapacityIdentity CapacityIdentity CapacityIdentity CapacityIdentity i64 i64))
(relation NarrowingValue (SourceValue CapacityIdentity i64))
(relation NarrowingField (SourceValue CapacityIdentity i64))
(rule ((= (SourceLoop loop) (LoopInfo header body)) (= (SourceLoopForm loop) (WhileCondition condition))
       (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (CapacityBinary (CapacitySource condition) "<" lo hi) (CapacityInteger lo) (CapacityInteger hi)
       (CapacityProjection lo (CapacitySource state) li) (CapacityProjection hi (CapacitySource state) ui)
       (!= li ui) (CapacityField (CapacitySource initial) li a) (CapacityField (CapacitySource initial) ui b)
       (= lower (IntegerLower a)) (= upper (IntegerUpper b)) (>= lower 0) (<= (IntegerUpper a) (IntegerLower b)))
      ((NarrowingLoop loop lo hi (CapacitySource initial) (CapacitySource state) li ui)
       (NarrowingValue loop lo 0) (NarrowingValue loop hi 0)) :ruleset integer-bounds)
(rule ((NarrowingLoop loop lo hi initial state li ui)
       (CapacityBinary difference "-" hi lo) (CapacityBinary quotient "/" difference divisor)
       (= k (IntegerLower divisor)) (= k (IntegerUpper divisor)) (>= k 2)
       (CapacityBinary middle "+" lo quotient))
      ((NarrowingValue loop middle -1) (NarrowingValue loop middle 0)) :ruleset integer-bounds)
(rule ((NarrowingValue loop value -1) (CapacityBinary next "+" value one)
       (= (IntegerLower one) 1) (= (IntegerUpper one) 1))
      ((NarrowingValue loop next 0)) :ruleset integer-bounds)
(rule ((CapacityField tuple i value) (NarrowingValue loop value 0))
      ((NarrowingField loop tuple i)) :ruleset integer-bounds)
(rule ((CapacityBranch tuple a b) (NarrowingField loop a i) (NarrowingField loop b i))
      ((NarrowingField loop tuple i)) :ruleset integer-bounds)
(rule ((NarrowingLoop loop lo hi initial state li ui) (= (SourceLoop loop) (LoopInfo header body))
       (= result (SourceResult body)) (NarrowingField loop (CapacitySource result) li)
       (NarrowingField loop (CapacitySource result) ui) (CapacityProjection value (CapacitySource loop) i)
       (CapacityField initial li a) (CapacityField initial ui b) (= lower (IntegerLower a)) (= upper (IntegerUpper b))
       (= i li))
      ((set (IntegerLower value) lower) (set (IntegerUpper value) upper)) :ruleset integer-bounds)
(rule ((NarrowingLoop loop lo hi initial state li ui) (= (SourceLoop loop) (LoopInfo header body))
       (= result (SourceResult body)) (NarrowingField loop (CapacitySource result) li)
       (NarrowingField loop (CapacitySource result) ui) (CapacityProjection value (CapacitySource loop) ui)
       (CapacityField initial li a) (CapacityField initial ui b) (= lower (IntegerLower a)) (= upper (IntegerUpper b)))
      ((set (IntegerLower value) lower) (set (IntegerUpper value) upper)) :ruleset integer-bounds)

(rule ((= n (IntegerUpper (CapacitySource source))))
      ((set (HostBound (Scalar source)) (Fixed n))) :ruleset capacity-select)

(rule ((Difference (Scalar end) (Scalar start)) (= hi (IntegerUpper (CapacitySource end))) (= lo (IntegerLower (CapacitySource start))))
      ((set (HostBound (Difference (Scalar end) (Scalar start))) (Fixed (max 0 (- hi lo))))) :ruleset capacity-select)

; Exact integer ranges also normalize equivalent logical shape expressions.
(rule ((Scalar source) (= n (IntegerLower (CapacitySource source))) (= n (IntegerUpper (CapacitySource source))))
      ((set (ConstantLogicalExtent (Scalar source)) n)) :ruleset representations)
(rule ((Length source) (= extent (ViewExtent source)) (= n (ConstantLogicalExtent extent)))
      ((set (ConstantLogicalExtent (Length source)) n)) :ruleset representations)
(rule ((Difference a b) (= x (ConstantLogicalExtent a)) (= y (ConstantLogicalExtent b)))
      ((set (ConstantLogicalExtent (Difference a b)) (- x y))) :ruleset representations)
