; Structural scheduling only. Scalar instruction placement happens during SSA emission.
(run-schedule (seq
    (saturate shape-types) (saturate traversal-types) (saturate map-types)
    (saturate rectangular-discover)
    (saturate repeatability) (run traversal-proofs) (run traversal-ready)
    (saturate (seq (run extent-shapes) (run map-shapes)))
    (saturate extent-dependencies) (run extent-uniformity)
    (run map-blockers) (saturate map-select) (saturate map-launch)
    (saturate iteration-domains)
    (saturate segment-shapes)
    (saturate extent-dependencies) (run extent-uniformity)
    (run segment-approve) (run segment-select)
    (saturate execution-discover) (saturate execution-select) (run execution-finalize)
    (saturate map-bindings)
    (saturate storage-shapes)
    (saturate capacity-identities)
    (saturate type-layouts)
    (saturate (seq residency representations))
    ; Settle output mappings before schedule creates irreversible phase/demand facts.
    (saturate output-layouts)
    (saturate collective-costs)
    (saturate schedule)))

; Collect contributions in native sets; only arithmetic enters the cost primitive.
(ruleset launch-cost-inputs)
(ruleset launch-cost-requests)
(ruleset launch-cost-select)
(function CostMapItems (OperationKey) CostItems :merge (set-union old new))
(function CostCombineItems (OperationKey) CostItems :merge (set-union old new))
(function CostInputItems (OperationKey) CostItems :merge (set-union old new))
(function CostOutputItems (OperationKey) CostItems :merge (set-union old new))
(function CostStateBytes (OperationKey) i64 :merge (max old new))
(function CostBodyWork (RegionKey) i64 :merge (min old new))
(function CostHasElement (TypeKey) bool :merge (or old new))
(function CostElement (TypeKey) TypeKey :no-merge)
(function CostHasStride (TypeKey) bool :merge (or old new))
(function CostStride (TypeKey) BigInt :no-merge)
(function CostScan (OperationKey) bool :merge (or old new))
(function CostStatic (OperationKey) bool :merge (or old new))
(rule ((ParallelCollective op))
      ((set (CostMapItems op) (set-empty)) (set (CostCombineItems op) (set-empty))
       (set (CostInputItems op) (set-empty)) (set (CostOutputItems op) (set-empty))
       (set (CostStateBytes op) 4) (set (CostScan op) false) (set (CostStatic op) false)) :ruleset launch-cost-inputs)
(rule ((= (Plan op) (Prefixes))) ((set (CostScan op) true)) :ruleset launch-cost-inputs)
(rule ((ParallelCollective op) (= (OperationGrid op) (AutomaticGrid)) (= n (StaticCapacityBound (InputDomain op))))
      ((set (CostStatic op) true)) :ruleset launch-cost-inputs)
(rule ((= n (CollectiveStatePrefix op i))) ((set (CostStateBytes op) n)) :ruleset launch-cost-inputs)
(rule ((= body (SourceOperatorBody op))) ((set (CostBodyWork body) 65)) :ruleset launch-cost-inputs)
(rule ((= n (SourceRegionWork body))) ((set (CostBodyWork body) (min 65 (max 0 n)))) :ruleset launch-cost-inputs)
(rule ((ParallelCollective owner) (PlannedOperation op owner plan region) (= body (SourceOperatorBody op))
       (= (PlanMapping op) true))
      ((set (CostMapItems owner) (set-of (BodyCost op plan region)))) :ruleset launch-cost-inputs)
(rule ((ParallelCollective owner) (PlannedOperation op owner plan region) (= body (SourceOperatorBody op))
       (= (PlanMapping op) false))
      ((set (CostCombineItems owner) (set-of (BodyCost op plan region)))) :ruleset launch-cost-inputs)
(rule ((ParallelCollective owner) (PlannedOperation op owner plan region) (= n (SourceInputCount op))
       (= input (SourceInput op i)) (>= i 0) (< i n) (= (PlanInternal plan input) false))
      ((set (CostInputItems owner) (set-of (InputCost input)))) :ruleset launch-cost-inputs)
(rule ((ParallelCollective owner) (ArrayResult owner i ty))
      ((set (CostOutputItems owner) (set-of (OutputCost owner i ty)))) :ruleset launch-cost-inputs)
(rule ((TypeId id)) ((set (CostHasElement (TypeId id)) false) (set (CostHasStride (TypeId id)) false)) :ruleset launch-cost-inputs)
(rule ((SourceArrayElement ty element))
      ((set (CostHasElement ty) true) (set (CostElement ty) element)) :ruleset launch-cost-inputs)
(rule ((= n (SourceStorageStride ty))) ((set (CostHasStride ty) true)) :ruleset launch-cost-inputs)
(rule ((= (CostHasElement ty) false)) ((set (CostElement ty) ty)) :ruleset launch-cost-requests)
(rule ((= (CostHasStride ty) false)) ((set (CostStride ty) (bigint 4))) :ruleset launch-cost-requests)
(rule ((= n (SourceStorageStride ty))) ((set (CostStride ty) (bigint (max 0 n)))) :ruleset launch-cost-requests)
(rule ((= items (CostMapItems op))) ((CostRequest items)) :ruleset launch-cost-requests)
(rule ((= items (CostCombineItems op))) ((CostRequest items)) :ruleset launch-cost-requests)
(rule ((= items (CostInputItems op))) ((CostRequest items)) :ruleset launch-cost-requests)
(rule ((= items (CostOutputItems op))) ((CostRequest items)) :ruleset launch-cost-requests)
(rule ((BodyCost op plan region) (= body (SourceOperatorBody op)) (= n (CostBodyWork body)))
      ((set (CostValue (BodyCost op plan region)) (bigint n))) :ruleset cost-values)
(rule ((InputCost input) (= ty (SourceType input)) (= bytes (CostStride (CostElement ty))))
      ((set (CostValue (InputCost input)) bytes)) :ruleset cost-values)
(rule ((OutputCost op i ty) (= bytes (CostStride ty)))
      ((set (CostValue (OutputCost op i ty)) bytes)) :ruleset cost-values)
(rule ((ParallelCollective op) (= grid (OperationGrid op)) (= (CostStatic op) false))
      ((set (SelectedCollectiveGroups op) 256)) :ruleset launch-cost-select)
(rule ((ParallelCollective op) (= (CostStatic op) true) (= n (StaticCapacityBound (InputDomain op)))
       (= input (CostTotal (CostInputItems op))) (= output (CostTotal (CostOutputItems op)))
       (= map (CostTotal (CostMapItems op))) (= combine (CostTotal (CostCombineItems op)))
       (= bytes (CostStateBytes op)) (= scan (CostScan op)) (= width (CollectiveChunkWidth op)))
      ((set (SelectedCollectiveGroups op)
            (wyn-collective-groups (bigint (max n 0)) input output (bigint bytes) map (max (bigint 1) combine) scan width))) :ruleset launch-cost-select)
(rule ((= n (SelectedCollectiveGroups op)) (<= n 32))
      ((set (CollectiveCombineWidth op) 32)) :ruleset launch-cost-select)
(rule ((= n (SelectedCollectiveGroups op)) (> n 32))
      ((set (CollectiveCombineWidth op) (<< 1 (+ 1 (log2 (- n 1)))))) :ruleset launch-cost-select)
(run-schedule (saturate launch-cost-inputs) (saturate launch-cost-requests)
              (saturate cost-values) (saturate launch-cost-select))
