(ruleset representations)
(ruleset type-layouts)
; Control boundaries choose one representation before their arms are emitted.
; Fixed arrays cross by value; runtime views retain their declared descriptor.
(sort LocalLayout)
(sort LocalLayouts (Vec LocalLayout))
(constructor ValueLayout (TypeKey) LocalLayout)
(constructor ViewLayout (ValueKey TypeKey) LocalLayout)
(constructor ArrayLayout (i64 LocalLayout) LocalLayout)
(constructor TupleLayout (TypeKey LocalLayouts) LocalLayout)
(function PhysicalArrayCapacity (LocalLayout) i64 :no-merge)
(rule ((= layout (ArrayLayout n element)) (= minimum (MinimumArrayCapacity)))
      ((set (PhysicalArrayCapacity layout) (max n minimum))) :ruleset representations)
(function BoundaryLayout (TypeKey) LocalLayout :no-merge)
(function HasTypeLayout (TypeKey) bool :merge (or old new))
(rule ((TypeId id)) ((set (HasTypeLayout (TypeId id)) false)) :ruleset type-layouts)
(rule ((= layout (BoundaryLayout ty))) ((set (HasTypeLayout ty) true)) :ruleset type-layouts)
(function LayoutFields (TypeKey i64) LocalLayouts :no-merge)

(function ValueRepresentation (SourceValue) LocalLayout :no-merge)
(function HasValueRepresentation (SourceValue) bool :merge (or old new))
(relation ScalarControlRegion (RegionKey))
(rule ((= ty (SourceType value))) ((set (RuntimeArrayJoin value) false)) :ruleset type-layouts)
(rule ((= (SourceBranch value) branch) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= value (SourceTerm region ordinal)) (ScalarControlRegion region))
      ((set (RuntimeArrayJoin value) true)) :ruleset type-layouts)
(rule ((= ty (SourceType value))) ((set (HasValueRepresentation value) false)) :ruleset representations)
(rule ((= layout (ValueRepresentation value))) ((set (HasValueRepresentation value) true)) :ruleset representations)
(ruleset runtime-representations)
(function ArrayElementLayout (SourceValue) LocalLayout :no-merge)
(function LocalElementLayout (ValueKey) LocalLayout :no-merge)
(rule ((HostRoot owner region)) ((ScalarControlRegion region)) :ruleset type-layouts)
(rule ((= (RuntimeArrayJoin value) true) (= (SourceBranch value) (BranchInfo condition yes no)))
      ((ScalarControlRegion yes) (ScalarControlRegion no)) :ruleset type-layouts)
(rule ((ScalarControlRegion region) (= (SourceOperation op) (OperationInfo region "control"))
       (= (ContainsCollective op) false) (Enters op child))
      ((ScalarControlRegion child)) :ruleset type-layouts)
(function LoopOwnsView (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (LoopOwnsView value) false)) :ruleset type-layouts)
(rule ((= ty (SourceType value))) ((set (StoredLoopState value) false)) :ruleset type-layouts)
(rule ((= (LoopOwnsView value) true) (= (SourceLoop value) (LoopInfo header iteration))
       (= (SourceLoopInitial header) (LoopInitialInfo state initial)))
      ((set (StoredLoopState state) true)) :ruleset type-layouts)
(rule ((= (SourceLoop value) (LoopInfo header iteration)) (= value (SourceTerm region ordinal)) (ScalarControlRegion region)
       (= op (SourceValueOperation value)) (= (ContainsCollective op) false)
       (= ty (SourceType value)) (SourceOwnedArrayType ty) (= (SourceArraySize ty) (DynamicSize)))
      ((set (LoopOwnsView value) true)) :ruleset type-layouts)
(function LoopBoundaryLayout (SourceValue) LocalLayout :no-merge)
(rule ((= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= layout (ValueRepresentation initial)) (= (LoopOwnsView value) false))
      ((set (LoopBoundaryLayout value) layout)) :ruleset representations)
(rule ((= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= (LoopOwnsView value) true) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (LoopBoundaryLayout value) (ViewLayout (LoopStorage value) element))) :ruleset representations)
(datatype InstructionRepresentation (SemanticResult TypeKey) (OperandResult i64))
(function InstructionResult (SourceValue) InstructionRepresentation :no-merge)
(function HasOperandResult (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (HasOperandResult value) false)) :ruleset representations)
(rule ((SourceResultOperand value index source-result-value)) ((set (HasOperandResult value) true)) :ruleset representations)
(rule ((SourceResultOperand value index source-result-value))
      ((set (InstructionResult value) (OperandResult index))) :ruleset readout)
(rule ((= ty (SourceType value)) (= (HasOperandResult value) false))
      ((set (InstructionResult value) (SemanticResult ty))) :ruleset readout)
(function ValueLayoutPrefix (SourceValue i64) LocalLayouts :no-merge)
(rule ((= ty (SourceType value)) (= (RuntimeArrayJoin value) false) (= layout (BoundaryLayout ty)))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= original (SourceAlias value)) (= ty (SourceType value)) (= (HasTypeLayout ty) false) (= layout (ValueRepresentation original)))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= (SourceCapture region value) original) (= ty (SourceType value)) (= (HasTypeLayout ty) false)
       (= layout (ValueRepresentation original)))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= callee (PlanCallee value)) (= result (SourceResult callee))
       (= ty (SourceType value)) (= (HasTypeLayout ty) false) (= layout (ValueRepresentation result)))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((SourceResultOperand value source-result-index original) (= ty (SourceType value)) (= (HasTypeLayout ty) false) (= layout (ValueRepresentation original)))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= (SourceProjection value) (ProjectionInfo parent i)) (= ty (SourceType value)) (= (HasTypeLayout ty) false) (= (ValueRepresentation parent) (TupleLayout t fields)))
      ((set (ValueRepresentation value) (vec-get fields i))) :ruleset representations)
(rule ((= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= layout (LoopBoundaryLayout value))
       (= ty (SourceType state)) (= (HasTypeLayout ty) false))
      ((set (ValueRepresentation state) layout)) :ruleset representations)
(rule ((= (SourceLoop value) (LoopInfo header iteration)) (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (= ty (SourceType value)) (= (HasTypeLayout ty) false) (= layout (LoopBoundaryLayout value)))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= (SourceBranch value) (BranchInfo condition yes no)) (= a (SourceResult yes)) (= b (SourceResult no))
       (= layout (ValueRepresentation a)) (= layout (ValueRepresentation b)) (= ty (SourceType value)) (= (HasTypeLayout ty) false))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= ty (SourceType value)) (= fields (SourceTypeFields ty)) (= (HasTypeLayout ty) false))
      ((set (ValueLayoutPrefix value 0) (vec-of))) :ruleset representations)
(rule ((= layouts (ValueLayoutPrefix value i)) (SourceField value i child)
       (= layout (ValueRepresentation child)))
      ((set (ValueLayoutPrefix value (+ i 1)) (vec-push layouts layout))) :ruleset representations)
(rule ((= ty (SourceType value)) (= fields (SourceTypeFields ty))
       (= (HasTypeLayout ty) false) (= shape (SourceAggregateShape ty)) (= layouts (ValueLayoutPrefix value (vec-length fields))))
      ((set (ValueRepresentation value) (TupleLayout shape layouts))) :ruleset representations)
(rule ((= ty (SourceType value)) (SourceArrayElement ty element) (= layout (BoundaryLayout element)))
      ((set (ArrayElementLayout value) layout)) :ruleset representations)
; Inferred rows retain their element layout across map callback parameters.
(rule ((= (SourceOperation op) (OperationInfo region "map")) (= input (SourceInput op i))
       (= body (SourceOperatorBody op)) (= formal (SourceParameter body i))
       (= ty (SourceType formal)) (= (HasTypeLayout ty) false)
       (= layout (ArrayElementLayout input)))
      ((set (ValueRepresentation formal) layout)) :ruleset representations)
; A map's row layout comes from its callback result, even when row sizes were inferred.
(rule ((= (SourceOperation op) (OperationInfo region "map")) (= value (SourceOperationValue op))
       (= body (SourceOperatorBody op)) (= result (SourceResult body))
       (= ty (SourceType value)) (SourceArrayElement ty element) (= (HasTypeLayout element) false)
       (= layout (ValueRepresentation result)))
      ((set (ArrayElementLayout value) layout)) :ruleset representations)
(rule ((= ty (SourceType value)) (SourceOwnedArrayType ty) (= (HasTypeLayout ty) false)
       (= (RuntimeArrayJoin value) false)
       (= extent (ViewExtent value)) (= count (StaticCapacityBound extent))
       (= layout (ArrayElementLayout value)))
      ((set (ValueRepresentation value) (ArrayLayout count layout))) :ruleset representations)
; Components projected from a stored array share that array's logical length.
; An ordinary tuple of independently sized arrays has no ReadView for the tuple.
(rule ((Projection e array i) (= (ValueRead array) (ReadView value))
       (= ty (SourceType e)) (SourceArrayElement ty element) (= n (ViewExtent array)))
      ((set (ViewExtent e) n)) :ruleset residency)
; Element updates preserve their operand's length. A scalar loop retains its
; initial extent only when its backedge preserves the state descriptor's length.
(rule ((= loop (SourceLoop value)))
      ((set (LoopPreservesLength value) false)) :ruleset residency)
(rule ((SourceResultOperand value index original) (= ty (SourceType value))
       (= (SourceArraySize ty) (DynamicSize)) (= n (ViewExtent original)))
      ((set (ViewExtent value) n)) :ruleset residency)
(rule ((= (SourceLoop value) (LoopInfo header iteration))
       (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= op (SourceValueOperation value)) (= (ContainsCollective op) false)
       (= (SourceLoopInitial header) (LoopInitialInfo state initial))
       (SourceLoopBackedge header state next) (= n (ViewExtent state)) (= n (ViewExtent next))
       (= extent (ViewExtent initial)))
      ((set (LoopPreservesLength value) true)
       (set (ViewExtent value) extent)) :ruleset residency)
; A fixed logical dimension comes from its type. A dynamic dimension comes
; from the selected view, including slices and compacted live counts.
(function LogicalExtent (SourceValue) Extent :no-merge)
; A projected fixed-array value has the same length as its selected SSA
; representation. Runtime views keep their separately carried descriptor length.
(rule ((= (SourceProjection source) (ProjectionInfo parent i))
       (= (SourceLoop parent) (LoopInfo header iteration))
       (= ty (SourceType source)) (= (SourceArraySize ty) (DynamicSize))
       (= (ValueRepresentation source) (ArrayLayout count element)))
      ((set (ViewExtent source) (Fixed count))) :ruleset residency)
(rule ((= ty (SourceType source)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (LogicalExtent source) (Fixed n))) :ruleset readout)
(rule ((= ty (SourceType source)) (= (SourceArraySize ty) (DynamicSize))
       (= (ArrayView source) (ViewInfo resource offset length)))
      ((set (LogicalExtent source) length)) :ruleset readout)
(rule ((= ty (SourceType source)) (= (SourceArraySize ty) (DynamicSize))
       (= (HasArrayStorage source) false) (= length (ViewExtent source)))
      ((set (LogicalExtent source) length)) :ruleset readout)
(rule ((DirectResult source op i) (= (ResultRead op i) (ReadElement value))
       (= ty (SourceType source)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (ViewExtent source) (Fixed n))) :ruleset residency)
(function LocalExecution (OperationKey ExecutionScope) ExecutionScope :no-merge)
(relation LocalInitialize (OperationKey SourceValue))
; Captures belong to the enclosing execution scope, not each callback iteration.
; Only independent, read-only values outside the fused plan can be prepared here.
(sort LocalPrerequisiteValues (Set SourceValue))
(function LocalPrerequisites (OperationKey) LocalPrerequisiteValues :merge (set-union old new))
(rule ((PlannedOperation original owner plan region) (= execution (LocalExecution owner enclosing))
       (= body (SourceOperatorBody original)) (= (SourceCapture body formal) actual)
       (= (PlanInternal plan actual) false) (= (SourceReadOnly actual) true))
      ((set (LocalPrerequisites owner) (set-of actual))) :ruleset readout)
(rule ((PlannedOperation original owner plan region) (= execution (LocalExecution owner enclosing))
       (= actual (SourceInput original i)) (SourceOrigin actual producer)
       (= (PlanInternal plan actual) false) (= (SourceReadOnly actual) true))
      ((set (LocalPrerequisites owner) (set-of actual))) :ruleset readout)
; Select one boundary action after scheduling has settled. A local collective's
; result slots use local execution storage, not an inter-dispatch buffer.
(datatype BoundaryAccess (StoredRead StorageRead) (RunCollective OperationKey FusionPlan))
(function SelectedAccess (SourceValue) BoundaryAccess :no-merge)
(function IsLocalResult (SourceValue) bool :merge (or old new))
; Preserve stored descriptors after all possible fixed value layouts settle.
(rule ((= (HasValueRepresentation value) false) (= (IsLocalResult value) false)
       (= (RuntimeArrayJoin value) false) (= resource (ArrayStorage value))
       (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (ValueRepresentation value) (ViewLayout resource element))) :ruleset runtime-representations)
(rule ((= (RuntimeArrayJoin value) true) (= ty (SourceType value)) (SourceArrayElement ty element))
      ((set (ValueRepresentation value) (ViewLayout (Source value) element))) :ruleset representations)
(relation LocalResult (SourceValue OperationKey FusionPlan))
(function LocalStorageOwner (ValueKey) OperationKey :no-merge)
(rule ((= ordinal (SourceOrdinal value))) ((set (IsLocalResult value) false)) :ruleset residency)
(rule ((PlannedOperation original owner plan region) (= execution (LocalExecution owner enclosing))
       (= value (SourceOperationValue original)))
      ((LocalResult value owner plan)) :ruleset residency)
(rule ((ForwardValue key original) (LocalResult original owner plan))
      ((LocalResult key owner plan)) :ruleset residency)
(rule ((= (ValueRead key) (ReadElement (Result owner i))) (= execution (LocalExecution owner enclosing))
       (Current group plan) (= owner (Owner plan)))
      ((LocalResult key owner plan)) :ruleset residency)
(rule ((= (ValueRead key) (ReadView (Result owner i))) (= execution (LocalExecution owner enclosing))
       (Current group plan) (= owner (Owner plan)))
      ((LocalResult key owner plan)) :ruleset residency)
(rule ((LocalResult key owner plan)) ((set (IsLocalResult key) true)) :ruleset residency)
(rule ((LocalResult key owner plan))
      ((set (SelectedAccess key) (RunCollective owner plan))) :ruleset readout)
(rule ((= (IsLocalResult key) false) (= access (ValueRead key)))
      ((set (SelectedAccess key) (StoredRead access))) :ruleset readout)
(rule ((LocalBuffer owner role i ty extent) (= value (BufferSlot owner role i)))
      ((set (LocalStorageOwner value) owner)) :ruleset readout)
(rule ((LocalBuffer owner role i ty extent) (= value (BufferSlot owner role i)) (= layout (BoundaryLayout ty)))
      ((set (LocalElementLayout value) layout)) :ruleset readout)
(rule ((LocalBuffer owner role i ty extent) (= value (BufferSlot owner role i)) (= (HasTypeLayout ty) false)
       (= value (Result producer result)) (DirectResult source producer result)
       (= (ResultRead producer result) (ReadView value)) (= layout (ArrayElementLayout source)))
      ((set (LocalElementLayout value) layout)) :ruleset readout)
(rule ((LocalBuffer owner role i ty extent) (= value (BufferSlot owner role i)) (= (HasTypeLayout ty) false)
       (= value (Result producer result)) (DirectResult source producer result)
       (= (ResultRead producer result) (ReadElement value)) (= layout (ValueRepresentation source)))
      ((set (LocalElementLayout value) layout)) :ruleset readout)
(rule ((Fixed n)) ((set (StaticCapacityBound (Fixed n)) n)) :ruleset residency)
(rule ((= n (SourceInteger32 source)) (>= n 0))
      ((set (StaticCapacityBound (Scalar source)) n)) :ruleset residency)
(rule ((= ty (SourceType source)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (StaticCapacityBound (Length source)) n)) :ruleset residency)
; Inferred loop state retains the fixed capacity selected for its value layout.
(rule ((= (ValueRepresentation source) (ArrayLayout n element)))
      ((set (StaticCapacityBound (Length source)) n)) :ruleset residency)
(rule ((= n (StaticCapacityBound extent)) (= extent (ViewExtent key)))
      ((set (StaticCapacityBound (Length key)) n)) :ruleset residency)
(rule ((= n (StaticCapacityBound bound)) (= bound (HostBound extent)))
      ((set (StaticCapacityBound extent) n)) :ruleset residency)
(rule ((= a (StaticCapacityBound left)) (= b (StaticCapacityBound right)) (Product left right))
      ((set (StaticCapacityBound (Product left right)) (* a b))) :ruleset residency)
(function OrderedRecipe (OperationKey) String :no-merge)
(rule ((Current group plan) (= op (Owner plan)) (ScremaPlan plan))
      ((set (OrderedRecipe op) "screma")) :ruleset schedule)
(rule ((Current group plan) (= op (Owner plan)) (FilterPlan plan))
      ((set (OrderedRecipe op) "filter")) :ruleset schedule)
(rule ((IndexedWrite op false)) ((set (OrderedRecipe op) "indexed")) :ruleset schedule)
(rule ((IndexedReducer op safe update)) ((set (OrderedRecipe op) "indexed")) :ruleset schedule)
(rule ((BucketShape op known)) ((set (OrderedRecipe op) "buckets")) :ruleset schedule)
; Local recipes are selected for each calling scope. The same helper can be
; reached from a group-uniform call and an invocation-local element callback.
(rule ((DeviceOperation op) (= recipe (OrderedRecipe op)))
      ((set (LocalExecution op (InvocationScope)) (InvocationScope))) :ruleset schedule)
(rule ((DeviceOperation op) (= recipe (OrderedRecipe op)) (= (LocalSupportsWorkgroup op) true))
      ((set (LocalExecution op (WorkgroupScope)) (WorkgroupScope))) :ruleset schedule)
(rule ((DeviceOperation op) (= recipe (OrderedRecipe op)) (= (LocalSupportsWorkgroup op) false))
      ((set (LocalExecution op (WorkgroupScope)) (InvocationScope))) :ruleset schedule)
(rule ((DeviceOperation op) (InitializedResult op i t n) (= source (SourceDestination op)))
      ((LocalInitialize op source)) :ruleset schedule)
(rule ((SourceAtomicType t)) ((set (BoundaryLayout t) (ValueLayout t))) :ruleset type-layouts)
(rule ((SourceViewType t) (= (SourceArraySize t) (DynamicSize)))
      ((set (BoundaryLayout t) (ValueLayout t))) :ruleset type-layouts)
(rule ((SourceArrayType t) (= (SourceArraySize t) (FixedSize n)) (SourceArrayElement t element)
       (= layout (BoundaryLayout element)))
      ((set (BoundaryLayout t) (ArrayLayout n layout))) :ruleset type-layouts)
(rule ((= fields (SourceTypeFields t))) ((set (LayoutFields t 0) (vec-of))) :ruleset type-layouts)
(rule ((= fields (SourceTypeFields t)) (= layouts (LayoutFields t i)) (< i (vec-length fields))
       (= layout (BoundaryLayout (vec-get fields i))))
      ((set (LayoutFields t (+ i 1)) (vec-push layouts layout))) :ruleset type-layouts)
(rule ((= fields (SourceTypeFields t)) (= shape (SourceAggregateShape t)) (= layouts (LayoutFields t (vec-length fields))))
      ((set (BoundaryLayout t) (TupleLayout shape layouts))) :ruleset type-layouts)

; Local outputs survive when returned from a region or consumed by another plan.
(relation LocalObservedResult (SourceValue))
(rule ((SourceObserved op) (= value (SourceOperationValue op)))
      ((LocalObservedResult value)) :ruleset schedule)
(rule ((SourceDepends consumer producer role) (= a (SelectedPlan consumer)) (= b (SelectedPlan producer))
       (!= a b) (= value (SourceOperationValue producer)))
      ((LocalObservedResult value)) :ruleset schedule)
(rule ((LocalObservedResult source) (DirectResult source owner i))
      ((LocalObservedBuffer (Result owner i))) :ruleset schedule)

; A projection of an array/SoA stream follows indexing. Ordinary tuple fields,
; such as a loop state containing arrays and scalars, are projected first.
(relation ArrayStreamProjection (SourceValue))
(rule ((= (SourceProjection source) (ProjectionInfo parent i))
       (= ty (SourceType parent)) (= size (SourceArraySize ty)))
      ((ArrayStreamProjection source)) :ruleset readout)

; A collective's accumulator shape is established by its neutral value, even
; when inferred array dimensions have no type-wide representation.
(rule ((= neutral (SourceNeutral op)) (= layout (ValueRepresentation neutral))
       (= body (SourceOperatorBody op)) (= formal (SourceParameter body i))
       (= ty (SourceType formal)) (= (HasTypeLayout ty) false))
      ((set (ValueRepresentation formal) layout)) :ruleset representations)
(rule ((= neutral (SourceNeutral op)) (= layout (ValueRepresentation neutral))
       (= (SourceOperation op) (OperationInfo region "scan")) (= value (SourceOperationValue op)))
      ((set (ArrayElementLayout value) layout)) :ruleset representations)
(rule ((= neutral (SourceNeutral op)) (= layout (ValueRepresentation neutral))
       (= (SourceOperation op) (OperationInfo region "reduce")) (= value (SourceOperationValue op))
       (= ty (SourceType value)) (= (HasTypeLayout ty) false))
      ((set (ValueRepresentation value) layout)) :ruleset representations)
(rule ((= array (SourceIndexedArray value)) (= layout (ArrayElementLayout array))
       (= ty (SourceType value)) (= (HasTypeLayout ty) false))
      ((set (ValueRepresentation value) layout)) :ruleset representations)

; Buffer element representation belongs to the allocation, not to a possibly
; unresolved semantic type shared by several occurrences. Select it at readout,
; after rectangular storage and its HasStorageShape flag have settled.
(function BufferElementLayout (ValueKey) LocalLayout :no-merge)
(rule ((Allocation value extent) (ElementType value ty) (= (HasStorageShape value) false) (= layout (BoundaryLayout ty)))
      ((set (BufferElementLayout value) layout)) :ruleset readout)
(rule ((Allocation value extent) (= (StorageLayout value) (FlatStorage ty shape count)) (= layout (BoundaryLayout ty)))
      ((set (BufferElementLayout value) layout)) :ruleset readout)
(rule ((DirectResult source owner i) (Allocation (Result owner i) extent) (ElementType (Result owner i) ty)
       (= (HasTypeLayout ty) false) (= (HasStorageShape (Result owner i)) false)
       (= (ResultRead owner i) (ReadView (Result owner i))) (= layout (ArrayElementLayout source)))
      ((set (BufferElementLayout (Result owner i)) layout)) :ruleset readout)
(rule ((DirectResult source owner i) (Allocation (Result owner i) extent) (ElementType (Result owner i) ty)
       (= (HasTypeLayout ty) false) (= (HasStorageShape (Result owner i)) false)
       (= (ResultRead owner i) (ReadElement (Result owner i))) (= layout (ValueRepresentation source)))
      ((set (BufferElementLayout (Result owner i)) layout)) :ruleset readout)
(rule ((Accumulator owner i ty role slot source) (= op (SourceValueOperation source))
       (= neutral (SourceNeutral op)) (= layout (ValueRepresentation neutral))
       (= value (Temporary owner name i)) (Allocation value extent) (ElementType value ty) (= (HasTypeLayout ty) false))
      ((set (BufferElementLayout value) layout)) :ruleset readout)
(rule ((= call (SourceInvocation caller function args)) (= callee (PlanCallee call))
       (= formal (SourceParameter callee i)) (< i (vec-length args))
       (= ty (SourceType formal)) (= (HasTypeLayout ty) false)
       (= layout (ValueRepresentation (vec-get args i))))
      ((set (ValueRepresentation formal) layout)) :ruleset representations)
; Indexing a rectangular array exposes one fixed-size row. Equal branch
; lengths remain known without evaluating the branch predicate on the host.
(rule ((= array (SourceIndexedArray value)) (= (ArrayElementLayout array) (ArrayLayout count element)))
      ((set (ViewExtent value) (Fixed count))) :ruleset representations)
(rule ((= (SourceBranch value) (BranchInfo condition yes no))
       (= a (SourceResult yes)) (= b (SourceResult no))
       (= extent (ViewExtent a)) (= extent (ViewExtent b)))
      ((set (ViewExtent value) extent)) :ruleset representations)

(function ConstantLogicalExtent (Extent) i64 :no-merge)
(rule ((Fixed n)) ((set (ConstantLogicalExtent (Fixed n)) n)) :ruleset representations)
(rule ((Scalar value) (= n (SourceInteger32 value)))
      ((set (ConstantLogicalExtent (Scalar value)) n)) :ruleset representations)
(rule ((= (SourceBranch value) (BranchInfo condition yes no))
       (= a (SourceResult yes)) (= b (SourceResult no))
       (= ea (ViewExtent a)) (= eb (ViewExtent b)) (!= ea eb)
       (= n (ConstantLogicalExtent ea)) (= n (ConstantLogicalExtent eb)))
      ((set (ViewExtent value) (Fixed n))) :ruleset representations)

; Scheduling costs use materialized layouts, including inferred fixed-size rows.
(function LocalLayoutBytes (LocalLayout) i64 :no-merge)
(function LocalFieldsBytes (LocalLayouts i64) i64 :no-merge)
(rule ((= layout (ValueLayout ty)) (= bytes (SourceByteSize ty)))
      ((set (LocalLayoutBytes layout) bytes)) :ruleset collective-costs)
(rule ((= layout (ArrayLayout n element)) (= bytes (LocalLayoutBytes element)))
      ((set (LocalLayoutBytes layout) (* n bytes))) :ruleset collective-costs)
(rule ((TupleLayout ty fields))
      ((set (LocalFieldsBytes fields 0) 0)) :ruleset collective-costs)
(rule ((= bytes (LocalFieldsBytes fields i)) (< i (vec-length fields))
       (= next (LocalLayoutBytes (vec-get fields i))))
      ((set (LocalFieldsBytes fields (+ i 1)) (+ bytes next))) :ruleset collective-costs)
(rule ((= layout (TupleLayout ty fields)) (= bytes (LocalFieldsBytes fields (vec-length fields))))
      ((set (LocalLayoutBytes layout) bytes)) :ruleset collective-costs)
(function AccumulatorLayout (OperationKey i64) LocalLayout :no-merge)
(rule ((Accumulator owner i ty role slot source) (!= role "count")
       (= op (SourceValueOperation source)) (= neutral (SourceNeutral op))
       (= layout (ValueRepresentation neutral)))
      ((set (AccumulatorLayout owner i) layout)) :ruleset collective-costs)
(rule ((Accumulator owner i ty "count" slot source) (= layout (BoundaryLayout ty)))
      ((set (AccumulatorLayout owner i) layout)) :ruleset collective-costs)
(rule ((= layout (AccumulatorLayout op i)) (= bytes (LocalLayoutBytes layout))
       (= before (CollectiveStatePrefix op i)))
      ((set (CollectiveStatePrefix op (+ i 1)) (+ before bytes))) :ruleset collective-costs)

(rule ((CallExtent call extent) (= n (ConstantLogicalExtent extent)))
      ((set (ConstantLogicalExtent (CallExtent call extent)) n)) :ruleset representations)

(rule ((Length value) (= extent (SourceExtent value)) (!= extent (Length value))
       (= n (ConstantLogicalExtent extent)))
      ((set (ConstantLogicalExtent (Length value)) n)) :ruleset representations)
(rule ((Length value) (= ty (SourceType value)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (ConstantLogicalExtent (Length value)) n)) :ruleset representations)
(rule ((Length value) (= op (SourceValueOperation value)) (= (SourceOperation op) (OperationInfo region "map"))
       (= extent (SourceDomainExtent op)) (= n (ConstantLogicalExtent extent)))
      ((set (ConstantLogicalExtent (Length value)) n)) :ruleset representations)
