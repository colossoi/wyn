(rule ((= revision (AnalysisRevision)) (= bytes (LoopStateBytes operation (wyn-output-count operation))) (= body (wyn-control-region operation 0))
       (= work (RegionWork body)) (CountedLoopOperation operation) (= (wyn-local-loop work bytes false) true))
      ((set (LocalLoop operation) true)) :ruleset graph-loop-select)
(rule ((= revision (AnalysisRevision)) (= bytes (LoopStateBytes operation (wyn-output-count operation))) (= body (wyn-control-region operation 0))
       (= work (RegionWork body)) (WhileLoopOperation operation) (= (wyn-local-loop work bytes true) true))
      ((set (LocalLoop operation) true)) :ruleset graph-loop-select)
(rule ((= revision (AnalysisRevision)) (= (ResultNeutral consumer clause slot) (ValueNameRef name))
       (ResultOrigin (ValueNameRef name) producer output) (ParallelOperation producer)
       (= (ValueType name) (LogicalValue ty)) (= bytes (LogicalBytes ty)) (<= bytes (bigint 16384))
       (= (PureOperation producer) true))
      ((KernelPreparationCandidate producer) (OperationWorkDemand producer)) :ruleset graph-loop-select)
(rule ((= revision (AnalysisRevision)) (= (ResultNeutral consumer clause slot) (ValueNameRef name))
       (ResultOrigin (ValueNameRef name) producer output) (ParallelOperation producer)
       (= (ValueType name) (LogicalValue (ArrayType ownership extents element))) (= (vec-length extents) 1)
       (= capacity (OuterCapacity name)) (= bytes (LogicalBytes element)) (<= (* (bigint capacity) bytes) (bigint 16384))
       (= (PureOperation producer) true))
      ((KernelPreparationCandidate producer) (OperationWorkDemand producer)) :ruleset graph-loop-select)
(rule ((KernelPreparationCandidate producer) (= work (OperationWork producer))
       (= (wyn-local-loop work (bigint 0) false) true))
      ((set (KernelPreparation producer) true)) :ruleset graph-loop-select)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (DistributionPrefixComplete outer inner)
       (= count (wyn-output-count outer)) (= count (wyn-output-count inner)) (DistributionReturnPrefix outer inner count)
       (= (DistributionSafe outer inner) true))
      ((ReadyDistribution outer inner)) :ruleset distribution-select)
(rule ((= revision (TransformRevision)) (ReadyDistribution outer inner) (= outer-domain (OperationDomain outer)) (= inner-domain (OperationDomain inner))
       (> (DomainRank outer-domain) 0) (> (DomainRank inner-domain) 0)
       (= coordinates (EstimatedDomain outer-domain (DomainRank outer-domain)))
       (= elements (EstimatedDomain inner-domain (DomainRank inner-domain)))
       (= outer-body (wyn-control-region outer 0)) (= inner-body (wyn-control-region inner 0))
       (= prefix (- (RegionOperationCount outer-body) 1)) (= work (RegionOperationCount inner-body))
       (= fold (DistributionHasFold inner))
       (= (wyn-distribute coordinates (bigint prefix) (bigint work) elements fold) true))
      ((DistributeNest outer inner)) :ruleset distribution-select)
(rule ((= revision (TransformRevision)) (ReadyDistribution outer inner) (= (wyn-output outer 0) (ValueNameRef result)) (LoopReadsRowWidth result))
      ((DistributeNest outer inner)) :ruleset distribution-select)
(rule ((= revision (AnalysisRevision)) (CountedLoopOperation operation)) ((set (LocalLoop operation) false)) :ruleset graph-loop-select)
(rule ((= revision (AnalysisRevision)) (WhileLoopOperation operation)) ((set (LocalLoop operation) false)) :ruleset graph-loop-select)
(rule ((Operation operation)
       (= revision (AnalysisRevision)) (= bytes (LoopStateBytes operation (wyn-output-count operation)))
       (= body (wyn-control-region operation 0)))
      ((RegionWorkDemand body)) :ruleset graph-loop-select)
