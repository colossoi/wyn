; Lexical order already orders dependencies and effects. Scheduling annotates
; actual parallel statements; it never builds a second execution graph.
(relation DenseDomain (DomainAxes))
(function FreeShape (Shape i64) ExtShape :no-merge)
(function GeneratedDispatches () bool :no-merge)
(function InvocationEntry (FunctionName) bool :merge (or old new))
(function EntryGrid (FunctionName) Grid :no-merge)
(function SubgroupsEnabled () bool :merge (or old new))
(set (SubgroupsEnabled) false)
(function LaneDependentFunction (Function) bool :merge (or old new))
(relation LaneBuiltin (String))
(relation FunctionCalls (Function FunctionName))
(function HostScope (ScopeContext) bool :no-merge)
(function FunctionHost (Function) bool :no-merge)
(function BoundedLocals (Function ParallelBody) bool :merge (and old new))
(function EntryFunction (FunctionName) bool :merge (or old new))
(ruleset accumulator-atomic)
(function AtomicCombiner (Lambda) bool :merge (or old new))
(function ConcurrentAccInputs (Function AccInputs) bool :merge (and old new))
(rule ((ContainsAccPolicy (FunctionRoot function) (CombineWrites combine))) ((set (AtomicCombiner combine) false)) :ruleset accumulator-atomic)
(rule ((ContainsAccPolicy (FunctionRoot function) (CombineWrites combine))
       (= combine (FunctionBody vector-pattern-1
          vector-pattern-0 body))
       (= (EffectsLambda function combine) (set-empty))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (ReturnScalar (ScalarElement (I32))))
       (= (vec-length vector-pattern-1) 2)
       (= (vec-get vector-pattern-1 0) (Parameter (BindValue left (ScalarInfo (ScalarElement (I32)))) diet1))
       (= (vec-get vector-pattern-1 1) (Parameter (BindValue right (ScalarInfo (ScalarElement (I32)))) diet2)))
      ((set (AtomicCombiner combine) true)) :ruleset accumulator-atomic)
(rule ((ContainsAccPolicy (FunctionRoot function) (CombineWrites combine))
       (= combine (FunctionBody vector-pattern-1
          vector-pattern-0 body))
       (= (EffectsLambda function combine) (set-empty))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (ReturnScalar (ScalarElement (U32))))
       (= (vec-length vector-pattern-1) 2)
       (= (vec-get vector-pattern-1 0) (Parameter (BindValue left (ScalarInfo (ScalarElement (U32)))) diet1))
       (= (vec-get vector-pattern-1 1) (Parameter (BindValue right (ScalarInfo (ScalarElement (U32)))) diet2)))
      ((set (AtomicCombiner combine) true)) :ruleset accumulator-atomic)
(ruleset placement-context)
(rule ((ContainsExp (FunctionRoot function) (WithAcc inputs body))) ((set (ConcurrentAccInputs function inputs) true)) :ruleset placement-context)
(rule ((ContainsExp (FunctionRoot function) (WithAcc inputs body)) (WalkAccInputs inputs i) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (CombineWrites combine))) (= (AtomicCombiner combine) false))
      ((set (ConcurrentAccInputs function inputs) false)) :ruleset placement-context)
(rule ((ContainsExp (FunctionRoot function) (WithAcc inputs body)) (WalkAccInputs inputs i) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (IdenticalWrites))))
      ((set (ConcurrentAccInputs function inputs) false)) :ruleset placement-context)
(ruleset placement-scopes)
(ruleset placement-select)
(ruleset dispatch-shapes)
(ruleset dispatch-select)
(function DomainSize (DomainAxes i64) IndexExp :no-merge)
(relation InspectFold (ParallelResults))
(function DispatchGrid (Function Domain ParallelResults) Grid :no-merge)

(LaneBuiltin "_w_intrinsic_thread_id")
(LaneBuiltin "_w_intrinsic_thread_id_y")
(LaneBuiltin "_w_intrinsic_thread_id_z")
(LaneBuiltin "_w_intrinsic_local_id")
(LaneBuiltin "_w_intrinsic_num_workgroups")
(LaneBuiltin "_w_intrinsic_workgroup_id")
(rule ((ProgramFunction program function) (= function (DefineFunction name params returns body)))
      ((set (LaneDependentFunction function) false) (set (InvocationEntry name) false) (set (EntryFunction name) false)) :ruleset placement-context)
(function DispatchedScope (ScopeContext) bool :no-merge)
(rule ((CheckFunction function)) ((set (DispatchedScope (FunctionScope function)) false)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Launch grid body) available))
      ((set (DispatchedScope (NestedScope context id 0)) true)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Parallel (DeviceKernel grid) domain body) available))
      ((set (DispatchedScope (NestedScope context id 0)) true)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Parallel (Unscheduled) domain body) available) (= dispatched (DispatchedScope context)))
      ((set (DispatchedScope (NestedScope context id 0)) dispatched)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Parallel (InvocationLocal) domain body) available) (= dispatched (DispatchedScope context)))
      ((set (DispatchedScope (NestedScope context id 0)) dispatched)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (If condition returns yes no) available) (= dispatched (DispatchedScope context)))
      ((set (DispatchedScope (NestedScope context id 0)) dispatched) (set (DispatchedScope (NestedScope context id 1)) dispatched)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Loop merges form returns body) available) (= dispatched (DispatchedScope context)))
      ((set (DispatchedScope (NestedScope context id 0)) dispatched)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (WithAcc inputs body) available) (= dispatched (DispatchedScope context)))
      ((set (DispatchedScope (NestedScope context id 0)) dispatched)) :ruleset placement-context)
(rule ((= context (ReducerScope parent i)) (= dispatched (DispatchedScope parent)))
      ((set (DispatchedScope context) dispatched)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (PrimOp opcode arguments) available) (= (DispatchedScope context) false)
       (= function (ScopeRoot context)) (LaneBuiltin opcode))
      ((set (LaneDependentFunction function) true)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Call callee arguments signature) available) (= (DispatchedScope context) false)
       (= function (ScopeRoot context)))
      ((FunctionCalls function callee)) :ruleset placement-context)
(rule ((FunctionCalls caller callee) (ProgramFunction program caller)
       (ProgramFunction program target) (= target (DefineFunction callee params returns body))
       (= (LaneDependentFunction target) true))
      ((set (LaneDependentFunction caller) true)) :ruleset placement-context)
(rule ((FunctionCalls caller callee) (ProgramFunction program caller)
       (ProgramExternal program (DeclareExternal callee params returns behavior accesses)))
      ((set (LaneDependentFunction caller) true)) :ruleset placement-context)
(rule ((CurrentProgram program) (ContainsEntry (ProgramRoot program) (EntryPoint name identity)))
      ((set (EntryFunction name) true)) :ruleset placement-context)
(rule ((CheckFunction function) (= function (DefineFunction name params returns body))
       (= entry (EntryFunction name)) (= invocation (InvocationEntry name))
       (= generated (GeneratedDispatches)) (= lane (LaneDependentFunction function)))
      ((set (FunctionHost function) (and generated (and entry (not (or invocation lane)))))
       (set (HostScope (FunctionScope function)) (and generated (and entry (not (or invocation lane)))))) :ruleset placement-scopes)
(rule ((CheckStatement context id pattern (If condition returns yes no) available) (= host (HostScope context)))
      ((set (HostScope (NestedScope context id 0)) host) (set (HostScope (NestedScope context id 1)) host)) :ruleset placement-scopes)
(rule ((CheckStatement context id pattern expression available) (= expression (Loop merges form returns body))
       (= host (HostScope context)) (= function (ScopeRoot context)) (= local (LocalLoop function expression)))
      ((set (HostScope (NestedScope context id 0)) (and host (not local)))) :ruleset placement-scopes)
(rule ((CheckStatement context id pattern (WithAcc inputs body) available) (= host (HostScope context))
       (= function (ScopeRoot context)) (= concurrent (ConcurrentAccInputs function inputs)))
      ((set (HostScope (NestedScope context id 0)) (and host concurrent))) :ruleset placement-scopes)
(rule ((CheckStatement context id pattern (Parallel execution domain body) available))
      ((set (HostScope (NestedScope context id 0)) false)) :ruleset placement-scopes)
(rule ((= context (ReducerScope parent i))) ((set (HostScope context) false)) :ruleset placement-scopes)
(rule ((AccInputAt context id inputs available i) (< i (vec-length inputs))
       (= (vec-get inputs i) (AccumulatorInput arrays (CombineWrites combine))))
      ((set (HostScope (NestedScope context id (+ i 1))) false)) :ruleset placement-scopes)

(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (= (HostScope context) true) (= (BoundedLocals function body) true)
       (= function (DefineFunction name params returns function-body))
       (= grid (EntryGrid name))
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Parallel (Unscheduled) domain body))))
      ((set (PendingRewrite "placement" program) (set-of (Rename (map-empty) (map-empty) (map-empty) (map-empty)
        (map-insert (map-empty) id
          (vec-of (Let id pattern certs (Parallel (DeviceKernel grid) domain body))))))) (RewriteDemand "placement" program)) :ruleset placement-select)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (= (HostScope context) false)
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Parallel (Unscheduled) domain body))))
      ((set (PendingRewrite "placement" program) (set-of (Rename (map-empty) (map-empty) (map-empty) (map-empty)
        (map-insert (map-empty) id
          (vec-of (Let id pattern certs (Parallel (InvocationLocal) domain body))))))) (RewriteDemand "placement" program)) :ruleset placement-select)
(rule ((= domain (IterationSpace flat axes))) ((set (DomainSize axes 0) (IndexConstant 1))) :ruleset dispatch-shapes)
(rule ((= product (DomainSize axes i)) (< i (vec-length axes)) (= (vec-get axes i) (DenseAxis name size)))
      ((set (DomainSize axes (+ i 1)) (IndexMul product size))) :ruleset dispatch-shapes)
(rule ((= product (DomainSize axes i)) (< i (vec-length axes)) (= (vec-get axes i) (RaggedAxis name offsets parent)))
      ((set (DomainSize axes (+ i 1)) product)) :ruleset dispatch-shapes)
(rule ((= body (ParallelBlock statements results))) ((InspectFold results)) :ruleset dispatch-shapes)
(rule ((InspectFold results) (= (vec-length results) 0))
      ((set (HasFold results) false)) :ruleset dispatch-shapes)
(rule ((InspectFold results) (> (vec-length results) 0))
      ((InspectFold (vec-remove results 0))) :ruleset dispatch-shapes)
(rule ((InspectFold results) (> (vec-length results) 0) (= (vec-get results 0) (Fold kind reducer values)))
      ((set (HasFold results) true)) :ruleset dispatch-shapes)
(rule ((InspectFold results) (> (vec-length results) 0) (= (vec-get results 0) (Collect values)) (= tail (HasFold (vec-remove results 0))))
      ((set (HasFold results) tail)) :ruleset dispatch-shapes)
(rule ((InspectFold results) (> (vec-length results) 0) (= (vec-get results 0) (Contribute tokens)) (= tail (HasFold (vec-remove results 0))))
      ((set (HasFold results) tail)) :ruleset dispatch-shapes)
(rule ((InspectFold results) (> (vec-length results) 0) (= (vec-get results 0) (Concatenate mode source)) (= tail (HasFold (vec-remove results 0))))
      ((set (HasFold results) tail)) :ruleset dispatch-shapes)
; Each segment is owned by one cooperative workgroup. Width selection and
; group count are independent, so segment shape never changes the reduction.
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements results)))
       (= domain (IterationSpace flat axes)) (= (HasFold results) true) (> (vec-length axes) 0)
       (= groups (DomainSize axes (- (vec-length axes) 1)))
       (= width (SelectedWidth function domain results)))
      ((set (DispatchGrid function domain results) (Grid3D (vec-of groups (IndexConstant 1) (IndexConstant 1))
         (vec-of (IndexConstant width) (IndexConstant 1) (IndexConstant 1))))) :ruleset dispatch-select)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution domain (ParallelBlock statements results)))
       (= domain (IterationSpace flat axes)) (= size (DomainSize axes (vec-length axes))) (= (HasFold results) false)
       (= width (SelectedWidth function domain results)))
      ((set (DispatchGrid function domain results) (Grid3D
         (vec-of (IndexDiv (IndexAdd size (IndexConstant (- width 1))) (IndexConstant width)) (IndexConstant 1) (IndexConstant 1))
         (vec-of (IndexConstant width) (IndexConstant 1) (IndexConstant 1))))) :ruleset dispatch-select)
(rule ((CurrentProgram program) (ProgramFunction program function) (ContainsStm (FunctionRoot function)
         (Let id pattern certs (Parallel (DeviceKernel (AutomaticGrid)) domain body)))
       (= body (ParallelBlock statements results)) (= grid (DispatchGrid function domain results)))
      ((set (PendingRewrite "placement" program) (set-of (Rename (map-empty) (map-empty) (map-empty) (map-empty)
        (map-insert (map-empty) id
          (vec-of (Let id pattern certs (Parallel (DeviceKernel grid) domain body))))))) (RewriteDemand "placement" program)) :ruleset dispatch-select)

; Native subgroup addition is one implementation of the ordinary reducer.
; Other associative combiners retain the portable workgroup implementation.
(function NativeAddition (Lambda) bool :merge (or old new))
(rule ((ContainsLambda root lambda)) ((set (NativeAddition lambda) false)) :ruleset dispatch-shapes)
(rule ((ContainsLambda root lambda)
       (= lambda (FunctionBody
          vector-pattern-5
          vector-pattern-4
          (Block vector-pattern-1
                 vector-pattern-0)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Yield proofs (ValueOperand (Var sum))))
       (= (vec-length vector-pattern-1) 1)
       (= (vec-length vector-pattern-2) 2)
       (= (vec-get vector-pattern-2 0) (Var left))
       (= (vec-get vector-pattern-2 1) (Var right))
       (= (vec-length vector-pattern-3) 1)
       (= (vec-get vector-pattern-3 0) (BindValue sum (ScalarInfo (ScalarElement (I32)))))
       (= (vec-get vector-pattern-1 0) (Let id vector-pattern-3 certs (PrimOp "+" vector-pattern-2)))
       (= (vec-length vector-pattern-4) 1)
       (= (vec-get vector-pattern-4 0) (ReturnScalar (ScalarElement (I32))))
       (= (vec-length vector-pattern-5) 2)
       (= (vec-get vector-pattern-5 0) (Parameter (BindValue left (ScalarInfo (ScalarElement (I32)))) dl))
       (= (vec-get vector-pattern-5 1) (Parameter (BindValue right (ScalarInfo (ScalarElement (I32)))) dr)))
      ((set (NativeAddition lambda) true)) :ruleset dispatch-shapes)
(rule ((ContainsLambda root lambda)
       (= lambda (FunctionBody
          vector-pattern-5
          vector-pattern-4
          (Block vector-pattern-1
                 vector-pattern-0)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Yield proofs (ValueOperand (Var sum))))
       (= (vec-length vector-pattern-1) 1)
       (= (vec-length vector-pattern-2) 2)
       (= (vec-get vector-pattern-2 0) (Var left))
       (= (vec-get vector-pattern-2 1) (Var right))
       (= (vec-length vector-pattern-3) 1)
       (= (vec-get vector-pattern-3 0) (BindValue sum (ScalarInfo (ScalarElement (U32)))))
       (= (vec-get vector-pattern-1 0) (Let id vector-pattern-3 certs (PrimOp "+" vector-pattern-2)))
       (= (vec-length vector-pattern-4) 1)
       (= (vec-get vector-pattern-4 0) (ReturnScalar (ScalarElement (U32))))
       (= (vec-length vector-pattern-5) 2)
       (= (vec-get vector-pattern-5 0) (Parameter (BindValue left (ScalarInfo (ScalarElement (U32)))) dl))
       (= (vec-get vector-pattern-5 1) (Parameter (BindValue right (ScalarInfo (ScalarElement (U32)))) dr)))
      ((set (NativeAddition lambda) true)) :ruleset dispatch-shapes)

; Collapse a uniform map nest by composing its actual domains and results.
; Prefixes may be repeated only when total and cheap enough; no row buffer or
; auxiliary traversal tree survives the contraction.
(ruleset distribution-analysis)
(ruleset distribution-select)
(relation DistributionCandidate (Program Function Stm Stm Stms Names))
(function DistributionSafe (Program Stm) bool :merge (and old new))
(relation ReturnedPattern (Pattern Results i64))
(relation RepeatablePrefix (Function Stms i64))
(function EstimatedDomain (Function DomainAxes i64) BigInt :no-merge)
(function DomainOrdinal (DomainAxes i64) IndexExp :no-merge)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution (IterationSpace flat axes) body)))
      ((set (EstimatedDomain function axes 0) (bigint 1))
       (set (DomainOrdinal axes 0) (IndexConstant 0))) :ruleset distribution-analysis)
(rule ((= n (EstimatedDomain function axes i)) (< i (vec-length axes))
       (= (vec-get axes i) (DenseAxis name size)) (= size-n (StaticIndex function size)))
      ((set (EstimatedDomain function axes (+ i 1)) (* n (bigint (max 0 size-n))))) :ruleset distribution-analysis)
(rule ((= n (EstimatedDomain function axes i)) (< i (vec-length axes))
       (= (vec-get axes i) (DenseAxis name size)) (= (KnownSize function size) false))
      ((set (EstimatedDomain function axes (+ i 1)) (* n (bigint 1024)))) :ruleset distribution-analysis)
(rule ((= ordinal (DomainOrdinal axes i)) (< i (vec-length axes))
       (= (vec-get axes i) (DenseAxis index size)))
      ((set (DomainOrdinal axes (+ i 1)) (IndexAdd (IndexMul ordinal size) (IndexValue index)))) :ruleset distribution-analysis)
(rule ((ContainsParallelBody (FunctionRoot function) (ParallelBlock statements clauses)))
      ((RepeatablePrefix function statements 0)) :ruleset distribution-analysis)
(rule ((RepeatablePrefix function statements i) (< i (vec-length statements))
       (= statement (vec-get statements i)) (= statement (Let id pattern certs expression))
       (= (EffectsStm function statement) (set-empty)) (TotalScalarForm expression))
      ((RepeatablePrefix function statements (+ i 1))) :ruleset distribution-analysis)
(rule ((RepeatablePrefix function statements i) (< i (vec-length statements))
       (= statement (vec-get statements i)) (= statement (Let id pattern certs (Load array indices)))
       (= effects (EffectsStm function statement)) (ReadOnlyEffects effects))
      ((RepeatablePrefix function statements (+ i 1))) :ruleset distribution-analysis)
(rule ((RepeatablePrefix function statements i) (< i (vec-length statements))
       (= statement (vec-get statements i)) (= statement (Let id pattern certs (View array slices)))
       (= (EffectsStm function statement) (set-empty)))
      ((RepeatablePrefix function statements (+ i 1))) :ruleset distribution-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (CheckStatement context id pattern (Parallel execution outer body) available) (= function (ScopeRoot context))
       (= body (ParallelBlock statements clauses)) (= results (ForwardedResults clauses))
       (= last (- (vec-length statements) 1)) (>= last 0)
       (RepeatablePrefix function statements last)
       (= inner (vec-get statements last))
       (= inner (Let iid ipattern proofs (Parallel inner-execution domain inner-body)))
       (= outer (IterationSpace oflat outer-axes)) (DenseDomain outer-axes)
       (= domain (IterationSpace iflat inner-axes)) (DenseDomain inner-axes)
       (= free (set-diff (NamesDomain domain) (BindersDomain domain)))
       (= (set-diff free available) (set-empty))
       (= (set-diff (NamesCertificates proofs) available) (set-empty))
       (= (vec-length ipattern) (vec-length results))
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel execution outer body))))
      ((ReturnedPattern ipattern results 0)
       (DistributionCandidate program function statement inner (vec-remove statements last) available)
       (set (DistributionSafe program statement) true)) :ruleset distribution-analysis)
(rule ((ReturnedPattern pattern results i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindValue name info))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var name)))) (= proofs (vec-of)))
      ((ReturnedPattern pattern results (+ i 1))) :ruleset distribution-analysis)
(rule ((DistributionCandidate program function outer inner prefix available)
       (= inner (Let id pattern certs (Parallel execution domain (ParallelBlock statements results))))
       (WalkParallelResults results i) (< i (vec-length results))
       (= (vec-get results i) (Fold kind reducer values))
       (= free (set-diff (NamesReducer reducer) (BindersReducer reducer)))
       (!= (set-diff free available) (set-empty)))
      ((set (DistributionSafe program outer) false)) :ruleset distribution-analysis)
; Selection is supplied by the calibrated numeric cost primitive. Its inputs
; contain no graph handles and cannot reconstruct another semantic plan.
(relation DistributeNest (Program Function Stm Stm Stms))
(rule ((DistributeNest program function outer inner prefix)
       (= outer (Let id pattern certs (Parallel execution (IterationSpace oflat outer-axes)
          (ParallelBlock statements outer-results))))
       (= inner (Let iid ipattern proofs (Parallel inner-execution (IterationSpace iflat inner-axes)
          (ParallelBlock body results))))
       (= outer-ordinal (DomainOrdinal outer-axes (vec-length outer-axes)))
       (= inner-ordinal (DomainOrdinal inner-axes (vec-length inner-axes))))
      ((let flat (ScheduleValue iid 40 0))
       (let coordinates (vec-of
          (Let (ScheduleStatement iid 40 0) (vec-of (BindValue oflat (ScalarInfo (ScalarElement (I32))))) (vec-of)
              (IndexOp outer-ordinal))
          (Let (ScheduleStatement iid 40 1) (vec-of (BindValue iflat (ScalarInfo (ScalarElement (I32))))) (vec-of)
              (IndexOp inner-ordinal))))
       (set (PendingRewrite "distribution" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of
                  (Let id pattern (vec-append certs proofs)
                      (Parallel execution (IterationSpace flat (vec-append outer-axes inner-axes))
                          (ParallelBlock (vec-append coordinates (vec-append prefix body)) results))))))))
       (RewriteDemand "distribution" program)) :ruleset distribution-select)

; A conditional with equally shaped map arms becomes a map with a guarded
; lane body. Only total prefixes may repeat, including for an empty domain.
(ruleset conditional-select)
(function BranchCode (Function Body) Stms :no-merge)
(function BranchResult (Function Body i64) Result :no-merge)
(relation BranchMap (Function Body Stm))
(function BranchSafe (Function Body) bool :merge (and old new))
(relation ConditionalPair (Program Function Stm Domain Domain Body Body Names))
(relation ConditionalMap (Program Function Stm Domain Body Body Renaming Names))
(relation ConditionalAt (Program Function Stm Domain Body Body Renaming i64 Stms Pattern Pattern ReturnInfos Results Results Results))
(function LaneInfo (Function Operand) ValueInfo :no-merge)
(function LaneReturn (ValueInfo) ReturnInfo :no-merge)
(rule ((ContainsBody (FunctionRoot function) (Block statements results)))
      ((RepeatablePrefix function statements 0)) :ruleset distribution-analysis)
(rule ((ContainsBody (FunctionRoot function) branch) (= branch (Block statements results))
       (= last (- (vec-length statements) 1)) (>= last 0) (RepeatablePrefix function statements last)
       (= tail (vec-get statements last))
       (= tail (Let id pattern certs (Parallel execution domain (ParallelBlock body clauses))))
       (= values (ForwardedResults clauses)))
      ((BranchMap function branch tail) (set (BranchSafe function branch) true)
       (set (BranchCode function branch) (vec-append (vec-remove statements last) body))) :ruleset distribution-analysis)
(rule ((BranchMap function branch (Let id pattern certs (Parallel execution domain (ParallelBlock body clauses))))
       (= branch (Block statements results)) (= values (ForwardedResults clauses))
       (WalkResults results i) (< i (vec-length results))
       (= (vec-get results i) (Yield proofs (ValueOperand (Var name))))
       (WalkPattern pattern j) (< j (vec-length pattern))
       (= (vec-get pattern j) (BindValue name info)) (= value (vec-get values j))
       (= value (Yield certificates operand)))
      ((set (BranchResult function branch i) (Yield (vec-append proofs certificates) operand))) :ruleset distribution-analysis)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (If condition returns yes no) available)
       (ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs (If condition returns yes no)))
       (BranchMap function yes (Let yi yp yc (Parallel ye left yb)))
       (BranchMap function no (Let ni np nc (Parallel ne right nb)))
       (= left (IterationSpace x xs)) (= right (IterationSpace y ys))
       (DenseDomain xs) (DenseDomain ys) (= (vec-length xs) (vec-length ys))
       (= (set-diff (set-diff (NamesDomain left) (BindersDomain left)) available) (set-empty))
       (= (set-diff (set-diff (NamesDomain right) (BindersDomain right)) available) (set-empty))
       (= (set-diff (set-union (NamesCertificates yc) (NamesCertificates nc)) available) (set-empty)))
      ((ConditionalPair program function statement left right yes no available)
       (MatchDomainAt left right 0 (map-insert (map-empty) y x))) :ruleset distribution-analysis)
(rule ((ConditionalPair program function statement left right yes no available)
       (= env (DomainRenaming left right)))
      ((ConditionalMap program function statement left yes no env available)
       (ConditionalAt program function statement left yes no env 0 (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of))) :ruleset distribution-analysis)
(rule ((= result (BranchResult function branch i)) (= result (Yield proofs operand))
       (= (OperandSlot function operand) (ScalarSlot element)))
      ((set (LaneInfo function operand) (ScalarInfo element))) :ruleset distribution-analysis)
(rule ((= result (BranchResult function branch i)) (= result (Yield proofs (ValueOperand (Var name))))
       (= info (BindingInfo function name)) (= info (ArrayValue element shape)))
      ((set (LaneInfo function (ValueOperand (Var name))) info)) :ruleset distribution-analysis)
(rule ((= info (ScalarInfo element))) ((set (LaneReturn info) (ReturnScalar element))) :ruleset distribution-analysis)
(rule ((= info (ArrayValue element shape)) (= ext (FreeShape shape (vec-length shape))))
      ((set (LaneReturn info) (ReturnArrayValue element ext))) :ruleset distribution-analysis)
(rule ((ConditionalAt program function statement domain yes no env i prefix outputs lanes returns yr nr values)
       (= statement (Let id pattern certs (If condition signature yes no))) (< i (vec-length pattern))
       (= binding (vec-get pattern i)) (= binding (BindValue name (ScalarInfo element)))
       (= yes (Block ycode yresults)) (= no (Block ncode nresults))
       (= result (vec-get yresults i)) (= result (vec-get nresults i)) (= result (Yield proofs operand))
       (ConditionalMap program function statement domain yes no env available)
       (= (set-diff (NamesResult result) available) (set-empty)))
      ((ConditionalAt program function statement domain yes no env (+ i 1)
          (vec-push prefix (Let (ScheduleStatement id 50 i) (vec-of binding) proofs (Use operand)))
          outputs lanes returns yr nr values)) :ruleset distribution-analysis)
(rule ((ConditionalAt program function statement domain yes no env i prefix outputs lanes returns yr nr values)
       (= statement (Let id pattern certs (If condition signature yes no))) (< i (vec-length pattern))
       (= binding (vec-get pattern i)) (= binding (BindValue name (ArrayValue element shape)))
       (= y (BranchResult function yes i)) (= y (Yield proofs operand))
       (= n (BranchResult function no i)) (= n (Yield other-proofs other))
       (= info (LaneInfo function operand)) (= info (LaneInfo function other))
       (= ret (LaneReturn info))
       (ConditionalMap program function statement domain yes no env available)
       (= (set-diff (NamesValueInfo info) available) (set-empty)))
      ((let lane (ScheduleValue id 50 i))
       (ConditionalAt program function statement domain yes no env (+ i 1) prefix
          (vec-push outputs binding) (vec-push lanes (BindValue lane info)) (vec-push returns ret)
          (vec-push yr y) (vec-push nr n) (vec-push values (Yield (vec-of) (ValueOperand (Var lane)))))) :ruleset distribution-analysis)
(rule ((ConditionalAt program function statement domain yes no env i prefix outputs lanes returns yr nr values)
       (= statement (Let id pattern certs expression)) (= i (vec-length pattern))
       (= code (BranchCode function no)))
      ((RenameBodyDemand env (Block code nr))) :ruleset distribution-analysis)
(rule ((ConditionalAt program function statement domain yes no env i prefix outputs lanes returns yr nr values)
       (= statement (Let id pattern certs (If condition signature yes no))) (= i (vec-length pattern))
       (> (vec-length outputs) 0) (= ycode (BranchCode function yes)) (= ncode (BranchCode function no))
       (BranchMap function yes (Let yi yp yc (Parallel execution domain yb)))
       (BranchMap function no (Let ni np nc (Parallel execution right nb)))
       (= no-body (RenameBody env (Block ncode nr)))
       (= (BranchSafe function yes) true) (= (BranchSafe function no) true))
      ((set (PendingRewrite "distribution" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append prefix (vec-of
                  (Let id outputs (vec-append certs (vec-append yc nc)) (Parallel execution domain
                      (ParallelBlock (vec-of
                          (Let (ScheduleStatement id 51 0) lanes (vec-of)
                              (If condition returns (Block ycode yr) no-body)))
                          (vec-of (Collect values)))))))))))
       (RewriteDemand "distribution" program)) :ruleset conditional-select)

; Keep concatenation abstract until inlining and shape motion expose uniform
; rows. Replacing one clause preserves the evaluation of every fused lane body.
(ruleset collection-analysis)
(ruleset collection-select)
(function UniformCollection (Program Stm) i64 :merge (min old new))
(relation CollectionPatternAt (Stm i64 i64 Pattern))
(rule ((CurrentProgram program) (ProgramFunction program function)
       (CheckStatement context id pattern (Parallel execution domain body) available) (= function (ScopeRoot context))
       (= body (ParallelBlock statements clauses)) (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Concatenate (Elements) source))
       (= (BindingInfo function source) (ArrayValue element shape)) (> (vec-length shape) 0)
       (= (set-diff (NamesShape shape) available) (set-empty))
       (ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs (Parallel execution domain body))))
      ((set (UniformCollection program statement) i)) :ruleset collection-analysis)
(rule ((= selected (UniformCollection program statement)))
      ((CollectionPatternAt statement selected 0 (vec-of))) :ruleset collection-select)
(rule ((CollectionPatternAt statement selected i prefix)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses selected)) (< i offset))
      ((CollectionPatternAt statement selected (+ i 1) (vec-push prefix (vec-get pattern i)))) :ruleset collection-select)
(rule ((CollectionPatternAt statement selected i prefix)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses selected)) (> i (+ offset 2)) (< i (vec-length pattern)))
      ((CollectionPatternAt statement selected (+ i 1) (vec-push prefix (vec-get pattern i)))) :ruleset collection-select)
(rule ((= selected (UniformCollection program statement)) (CollectionPatternAt statement selected offset prefix)
       (= statement (Let id pattern certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses selected)) (= (vec-get clauses selected) (Concatenate (Elements) source))
       (= function (ScopeRoot context)) (CheckStatement context id pattern (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses)) available)
       (= (BindingInfo function source) (ArrayValue element shape)) (= count (DomainSize axes (vec-length axes))))
      ((CollectionPatternAt statement selected (+ offset 3)
          (vec-push prefix (BindValue (ScheduleValue (ScheduleStatement id 60 selected) 0 0)
              (ArrayValue element (vec-append (vec-of count) shape)))))) :ruleset collection-select)
(rule ((CurrentProgram program) (= selected (UniformCollection program statement))
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= domain (IterationSpace flat axes)) (= count (DomainSize axes (vec-length axes)))
       (= offset (ClauseOffset clauses selected))
       (CollectionPatternAt statement selected n next-pattern) (= n (vec-length pattern))
       (= (vec-get clauses selected) (Concatenate (Elements) source))
       (CheckStatement context id pattern (Parallel execution domain (ParallelBlock statements clauses)) available)
       (= function (ScopeRoot context)) (= (BindingInfo function source) (ArrayValue element shape))
       (= width (vec-get shape 0)) (= key (ScheduleStatement id 60 selected))
       (= (vec-get pattern offset) (BindValue offsets offset-info))
       (= (vec-get pattern (+ offset 1)) (BindValue size size-info))
       (= (vec-get pattern (+ offset 2)) (BindValue data data-info))
       (= data-info (ArrayValue element result-shape)))
      ((let total (Let (ScheduleStatement key 0 0) (vec-of (BindValue size size-info)) (vec-of) (IndexOp (IndexMul count width))))
       (let collected (Collect (vec-of (Yield (vec-of) (ValueOperand (Var source))))))
       (let mapped (Let id next-pattern certs (Parallel execution domain
          (ParallelBlock statements (vec-set clauses selected collected)))))
       (let flattened (Let (ScheduleStatement key 0 1) (vec-of (BindValue data data-info)) (vec-of)
          (Reshape (ScheduleValue key 0 0) result-shape)))
       (let offset-body (ParallelBlock
          (vec-of (Let (ScheduleStatement key 1 0) (vec-of (BindValue (ScheduleValue key 1 0) (ScalarInfo (ScalarElement (I32)))))
              (vec-of) (IndexOp (IndexMul (IndexValue (ScheduleValue key 1 1)) width))))
          (vec-of (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue key 1 0)))))))))
       (let offsets-stm (Let (ScheduleStatement key 0 2) (vec-of (BindValue offsets offset-info)) (vec-of)
          (Parallel (Unscheduled) (IterationSpace (ScheduleValue key 1 2)
              (vec-of (DenseAxis (ScheduleValue key 1 1) (IndexAdd count (IndexConstant 1))))) offset-body)))
       (set (PendingRewrite "collection" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of total mapped flattened offsets-stm)))))
       (RewriteDemand "collection" program)) :ruleset collection-select)

(ruleset collection-effects)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsParallelBody (FunctionRoot function) body) (= body (ParallelBlock statements clauses))
       (WalkParallelResults clauses i) (< i (vec-length clauses)) (= (vec-get clauses i) (Concatenate (OffsetSequences) source))
       (= reads (ArrayReads function source)) (= effects (EffectsStms function statements)))
      ((CompareEffects reads effects)) :ruleset collection-effects)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (CheckStatement context id pattern (Parallel execution domain body) available) (= function (ScopeRoot context))
       (= body (ParallelBlock statements clauses)) (WalkParallelResults clauses i) (< i (vec-length clauses))
       (= (vec-get clauses i) (Concatenate (OffsetSequences) source))
       (= (BindingInfo function source) (ArrayValue element shape)) (= (vec-length shape) 1)
       (= reads (ArrayReads function source)) (= effects (EffectsStms function statements)) (= (Commutes reads effects) true)
       (= (set-diff (set-insert (NamesShape shape) (ValueNameRef source)) available) (set-empty))
       (ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs (Parallel execution domain body))))
      ((set (UniformCollection program statement) i)) :ruleset collection-analysis)
(rule ((= selected (UniformCollection program statement)) (CollectionPatternAt statement selected offset prefix)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses selected)) (= (vec-get clauses selected) (Concatenate (OffsetSequences) source)))
      ((CollectionPatternAt statement selected (+ offset 3) prefix)) :ruleset collection-select)
(rule ((CurrentProgram program) (= selected (UniformCollection program statement))
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= domain (IterationSpace flat axes)) (= count (DomainSize axes (vec-length axes)))
       (= offset (ClauseOffset clauses selected))
       (CollectionPatternAt statement selected n next-pattern) (= n (vec-length pattern))
       (= (vec-get clauses selected) (Concatenate (OffsetSequences) source))
       (CheckStatement context id pattern (Parallel execution domain (ParallelBlock statements clauses)) available)
       (= function (ScopeRoot context)) (= (BindingInfo function source) (ArrayValue element shape))
       (= (vec-get pattern offset) (BindValue offsets offset-info))
       (= (vec-get pattern (+ offset 1)) (BindValue size size-info))
       (= (vec-get pattern (+ offset 2)) (BindValue data data-info)))
      ((let width (IndexSub (vec-get shape 0) (IndexConstant 1)))
       (let key (ScheduleStatement id 61 selected))
       (let scalar (ScalarInfo (ScalarElement (I32))))
       (let end (IndexMul count width))
       (let total (Let (ScheduleStatement key 0 0) (vec-of (BindValue size size-info)) (vec-of) (IndexOp (IndexAdd end (IndexConstant 1)))))
       (let original (Let id next-pattern certs (Parallel execution domain
          (ParallelBlock statements (vec-remove clauses selected)))))
       (let offset-body (ParallelBlock
          (vec-of (Let (ScheduleStatement key 1 0) (vec-of (BindValue (ScheduleValue key 1 0) scalar)) (vec-of)
              (IndexOp (IndexMul (IndexValue (ScheduleValue key 1 1)) width))))
          (vec-of (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue key 1 0)))))))))
       (let offsets-stm (Let (ScheduleStatement key 0 2) (vec-of (BindValue offsets offset-info)) (vec-of)
          (Parallel (Unscheduled) (IterationSpace (ScheduleValue key 1 2)
              (vec-of (DenseAxis (ScheduleValue key 1 1) (IndexAdd count (IndexConstant 1))))) offset-body)))
       (let base (Let (ScheduleStatement key 2 0) (vec-of (BindValue (ScheduleValue key 2 0) scalar)) (vec-of)
          (Load source (vec-of width))))
       (let limit (Let (ScheduleStatement key 2 1) (vec-of (BindValue (ScheduleValue key 2 1) scalar)) (vec-of) (IndexOp end)))
       (let condition (Let (ScheduleStatement key 2 2)
          (vec-of (BindValue (ScheduleValue key 2 2) (ScalarInfo (ScalarElement (Bool))))) (vec-of)
          (PrimOp "<" (vec-of (Var (ScheduleValue key 2 3)) (Var (ScheduleValue key 2 1))))))
       (let item (Let (ScheduleStatement key 3 0) (vec-of (BindValue (ScheduleValue key 3 0) scalar)) (vec-of)
          (Load source (vec-of (IndexMod (IndexValue (ScheduleValue key 2 3)) width)))))
       (let shifted (Let (ScheduleStatement key 3 1) (vec-of (BindValue (ScheduleValue key 3 1) scalar)) (vec-of)
          (IndexOp (IndexAdd (IndexValue (ScheduleValue key 3 0))
              (IndexMul (IndexDiv (IndexValue (ScheduleValue key 2 3)) width) (IndexValue (ScheduleValue key 2 0)))))))
       (let last (Let (ScheduleStatement key 4 0) (vec-of (BindValue (ScheduleValue key 4 0) scalar)) (vec-of)
          (IndexOp (IndexMul count (IndexValue (ScheduleValue key 2 0))))))
       (let choose (Let (ScheduleStatement key 2 4) (vec-of (BindValue (ScheduleValue key 2 4) scalar)) (vec-of)
          (If (Var (ScheduleValue key 2 2)) (vec-of (ReturnScalar (ScalarElement (I32))))
              (Block (vec-of item shifted) (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue key 3 1))))))
              (Block (vec-of last) (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue key 4 0)))))))))
       (let payload-body (ParallelBlock (vec-of base limit condition choose)
          (vec-of (Collect (vec-of (Yield (vec-of) (ValueOperand (Var (ScheduleValue key 2 4)))))))))
       (let payload (Let (ScheduleStatement key 0 3) (vec-of (BindValue data data-info)) (vec-of)
          (Parallel (Unscheduled) (IterationSpace (ScheduleValue key 2 5)
              (vec-of (DenseAxis (ScheduleValue key 2 3) (IndexValue size)))) payload-body)))
       (set (PendingRewrite "collection" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of total original offsets-stm payload)))))
       (RewriteDemand "collection" program)) :ruleset collection-select)

; Collection materializes row values, so a row reshape can move to the dense
; collected array. This exposes nested domains and eliminates per-row copies.
(function DomainExtents (DomainAxes i64) Shape :no-merge)
(rule ((= domain (IterationSpace flat axes))) ((set (DomainExtents axes 0) (vec-of))) :ruleset dispatch-shapes)
(rule ((= prefix (DomainExtents axes i)) (< i (vec-length axes)) (= (vec-get axes i) (DenseAxis index length)))
      ((set (DomainExtents axes (+ i 1)) (vec-push prefix length))) :ruleset dispatch-shapes)
(relation CollectView (Program Stm i64 i64 i64 ValueName Shape))
(function CollectViewSlot (Program Stm) i64 :merge (min old new))
(rule ((CurrentProgram program) (ProgramFunction program function)
       (CheckStatement context id pattern (Parallel execution domain body) available) (= function (ScopeRoot context))
       (= body (ParallelBlock statements clauses)) (= domain (IterationSpace flat axes))
       (= outer (DomainExtents axes (vec-length axes)))
       (WalkParallelResults clauses c) (< c (vec-length clauses)) (= (vec-get clauses c) (Collect results))
       (WalkResults results i) (< i (vec-length results)) (= (vec-get results i) (Yield proofs (ValueOperand (Var row))))
       (WalkStms statements j) (< j (vec-length statements))
       (= (vec-get statements j) (Let view-id view-pattern view-proofs (Reshape source row-shape)))
       (= view-proofs (vec-of)) (= (vec-length view-pattern) 1) (= (vec-get view-pattern 0) (BindValue row info))
       (= (BindingInfo function source) (ArrayValue element source-shape))
       (= (set-diff (NamesShape source-shape) available) (set-empty))
       (= slot (+ (ClauseOffset clauses c) i))
       (ContainsStm (FunctionRoot function) statement) (= statement (Let id pattern certs (Parallel execution domain body))))
      ((CollectView program statement c i slot source (vec-append outer source-shape))
       (set (CollectViewSlot program statement) slot)) :ruleset collection-analysis)
(rule ((CurrentProgram program) (CollectView program statement c i slot source shape)
       (= slot (CollectViewSlot program statement))
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= (vec-get pattern slot) (BindValue output (ArrayValue element result-shape)))
       (= (vec-get clauses c) (Collect results)) (= (vec-get results i) (Yield proofs operand)))
      ((let key (ScheduleStatement id 62 slot))
       (let value (ScheduleValue key 0 0))
       (let pattern2 (vec-set pattern slot (BindValue value (ArrayValue element shape))))
       (let results2 (vec-set results i (Yield proofs (ValueOperand (Var source)))))
       (let clauses2 (vec-set clauses c (Collect results2)))
       (let mapped (Let id pattern2 certs (Parallel execution domain (ParallelBlock statements clauses2))))
       (let reshaped (Let key (vec-of (vec-get pattern slot)) (vec-of) (Reshape value result-shape)))
       (set (PendingRewrite "collection" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of mapped reshaped)))))
       (RewriteDemand "collection" program)) :ruleset collection-select)

(rule ((CheckStatement context id pattern (Launch grid body) available))
      ((set (HostScope (NestedScope context id 0)) false)) :ruleset placement-scopes)

(rule ((ReturnedPattern pattern results i) (< i (vec-length pattern))
       (= (vec-get pattern i) (BindAccumulator name info))
       (= (vec-get results i) (Yield proofs (AccOperand name))) (= proofs (vec-of)))
      ((ReturnedPattern pattern results (+ i 1))) :ruleset distribution-analysis)
; Repeating a bounded prefix read must not interleave it with a consuming write.
(rule ((DistributionCandidate program function outer inner prefix available)
       (WalkStms prefix i) (< i (vec-length prefix))
       (= a (EffectsStm function (vec-get prefix i))) (= b (EffectsStm function inner)))
      ((CompareEffects a b)) :ruleset distribution-analysis)
(rule ((DistributionCandidate program function outer inner prefix available)
       (WalkStms prefix i) (< i (vec-length prefix))
       (= a (EffectsStm function (vec-get prefix i))) (= b (EffectsStm function inner)) (= (Commutes a b) false))
      ((set (DistributionSafe program outer) false)) :ruleset distribution-analysis)

(rule ((BranchMap function branch tail) (= branch (Block statements results))
       (WalkStms statements i) (< i (- (vec-length statements) 1))
       (= a (EffectsStm function (vec-get statements i))) (= b (EffectsStm function tail)))
      ((CompareEffects a b)) :ruleset distribution-analysis)
(rule ((BranchMap function branch tail) (= branch (Block statements results))
       (WalkStms statements i) (< i (- (vec-length statements) 1))
       (= a (EffectsStm function (vec-get statements i))) (= b (EffectsStm function tail)) (= (Commutes a b) false))
      ((set (BranchSafe function branch) false)) :ruleset distribution-analysis)
