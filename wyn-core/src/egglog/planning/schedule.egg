(function ElementPhase (OperationKey) String :no-merge)
; Select an execution recipe from collective structure and sidecar effect proofs.
; No scalar expressions or lambda implementation enter this pass.
; Result indices include preceding totals; the destination's output buffer slot is 0.
(rule ((= r (OperationRegion op))) ((set (ElideElements op) false)) :ruleset structure)
; Parallel callbacks may read arrays and contain control flow. They must not
; write shared state or call unknown effects. This is weaker than movability.
(rule ((= r (OperationRegion op))) ((set (ParallelSafe op) true) (set (ParallelBodySafe op) true)) :ruleset structure)
(rule ((Enters op r) (= r (OperationRegion child)) (= (ParallelSafe child) false))
      ((set (ParallelSafe op) false) (set (ParallelBodySafe op) false)) :ruleset structure)
(rule ((Callback op r) (= r (OperationRegion child)) (= (ParallelSafe child) false))
      ((set (ParallelSafe op) false) (set (ParallelBodySafe op) false)) :ruleset structure)
; Read the selected fusion plan's flags after callback effects have settled.
(rule ((Current group plan) (= op (Owner plan)) (ScremaPlan plan)
       (= (HasScans plan) false) (= (HasReductions plan) false) (= (ParallelBodySafe op) true))
      ((set (Plan op) (Elements))) :ruleset schedule)
(rule ((Current group plan) (= op (Owner plan)) (ScremaPlan plan)
       (= (FinalOutputPass plan) false) (= (HasReductions plan) true) (= (ParallelBodySafe op) true))
      ((set (Plan op) (Totals))) :ruleset schedule)
(rule ((Current group plan) (= op (Owner plan)) (ScremaPlan plan)
       (= (FinalOutputPass plan) true) (= (ParallelBodySafe op) true))
      ((set (Plan op) (Prefixes))) :ruleset schedule)
(rule ((Current group plan) (= op (Owner plan)) (ScremaPlan plan) (= (ParallelBodySafe op) false))
      ((set (Plan op) (Serial))) :ruleset schedule)
(rule ((FilterShape op) (= (ParallelBodySafe op) true)) ((set (Plan op) (Compact))) :ruleset schedule)
(rule ((FilterShape op) (= (ParallelBodySafe op) false)) ((set (Plan op) (Serial))) :ruleset schedule)

; Recipes declare logical phases before any kernel body is built. Widths match
; the current emitters; PhaseDomain counts invocations, not rounded workgroups.
; Iteration axes describe logical coordinates, before cooperative width expansion.
(rule ((= r (OperationRegion op)) (OwnedRegion entry r) (= grid (EntryGrid entry)))
      ((set (OperationGrid op) grid)) :ruleset schedule)
; One choice supplies the chunk launch, scratch capacity, and carry count.
; The default bounds the carry scan to one workgroup.
; Estimate per-lane accumulator storage before selecting a launch. Keep the
; chunk bank near 8 KiB, with power-of-two widths between 32 and 256 lanes.
(function CollectiveChunkWidth (OperationKey) i64 :merge (min old new))
(rule ((Accumulator op i ty output source))
      ((set (CollectiveStatePrefix op 0) 0)
       (set (CollectiveChunkWidth op) 256)) :ruleset collective-costs)
(rule ((= bytes (CollectiveStatePrefix op i)) (= width (CollectiveChunkWidth op))
       (> width 32) (> (* bytes width) 8192))
      ((set (CollectiveChunkWidth op) (/ width 2))) :ruleset collective-costs)
; Ordinary maps select a width by the scope owning each logical coordinate.
(function MapScopeWidth (ExecutionScope) i64 :no-merge)
(set (MapScopeWidth (InvocationScope)) 64)
(set (MapScopeWidth (WorkgroupScope)) 32)
(rule ((= (Plan op) (Totals))) ((ParallelCollective op)) :ruleset schedule)
(rule ((= (Plan op) (Prefixes))) ((ParallelCollective op)) :ruleset schedule)
(function CollectiveGrid (OperationKey) DispatchGrid :no-merge)
(rule ((ParallelCollective op) (= (OperationGrid op) (AutomaticGrid))
       (= groups (SelectedCollectiveGroups op)))
      ((set (CollectiveGrid op) (FixedGrid groups 1 1))) :ruleset schedule)
(rule ((ParallelCollective op) (= grid (OperationGrid op)) (= grid (FixedGrid x y z)))
      ((set (CollectiveGrid op) grid)) :ruleset schedule)
(rule ((= (CollectiveGrid op) (FixedGrid x y z)))
      ((set (CollectiveGroups op) (* x (* y z)))) :ruleset schedule)
; A scalar execution crossing dispatches runs once and publishes its value.
; Its called regions belong to that invocation, not the host launch graph.
(rule ((InvocationValue op) (DispatchGroupLeader op leader) (= r (OperationRegion leader)) (RegionContainsCollective r))
      ((KernelPhase leader "scalar" (Fixed 1) 1 (FixedGrid 1 1 1)) (PhaseEnds leader "scalar" "scalar")) :ruleset schedule)
(rule ((InvocationValue op) (DispatchGroupLeader op leader) (Phase (Stage leader "scalar") r))
      ((Produces (Stage leader "scalar") (Result op 0))
       (FirstPhase op (Stage leader "scalar")) (LastPhase op (Stage leader "scalar"))
       (PhaseInput (Stage leader "scalar") op "environment")) :ruleset schedule)
(rule ((= (Plan op) (Elements)) (= (ElideElements op) false) (= (MapSegmented op) false)
       (= (MapExecution op) (InvocationScope)) (= width (MapScopeWidth (InvocationScope)))
       (= n (IterationExtent op)) (= grid (OperationGrid op)))
      ((KernelPhase op "elements" n width grid) (ParallelPhaseEnds op "elements" "elements")) :ruleset schedule)
(rule ((= (Plan op) (Elements)) (= (ElideElements op) false) (= (MapSegmented op) false)
       (= (MapExecution op) (WorkgroupScope)) (= width (MapScopeWidth (WorkgroupScope)))
       (= n (IterationExtent op)) (= grid (OperationGrid op)))
      ((KernelPhase op "elements" (Product n (Fixed width)) width grid)
       (ParallelPhaseEnds op "elements" "elements")) :ruleset schedule)
(rule ((= (Plan op) (Elements)) (= (ElideElements op) false) (= (MapSegmented op) true) (= width (SegmentWidth op))
       (= n (IterationExtent op)) (= grid (OperationGrid op)))
      ((KernelPhase op "segments" (Product n (Fixed width)) width grid)
       (ParallelPhaseEnds op "segments" "segments")) :ruleset schedule)
(function CollectiveCombineWidth (OperationKey) i64 :no-merge)
(rule ((ParallelCollective op) (= grid (CollectiveGrid op)) (= groups (CollectiveGroups op))
       (= width (CollectiveChunkWidth op)) (= combine-width (CollectiveCombineWidth op)))
      ((KernelPhase op "chunks" (Fixed (* groups width)) width grid)
       (KernelPhase op "combine" (Fixed combine-width) combine-width (FixedGrid 1 1 1))
       (PhaseLink op "chunks" "combine")) :ruleset schedule)
(rule ((= (Plan op) (Totals))) ((ParallelPhaseEnds op "chunks" "combine")) :ruleset schedule)
(rule ((= (Plan op) (Prefixes)) (= n (InputDomain op)) (= grid (OperationGrid op)))
      ((KernelPhase op "offsets" n 64 grid)
       (PhaseInput (Stage op "offsets") op "input")
       (ParallelPhaseEnds op "chunks" "offsets")
       (PhaseLink op "combine" "offsets")) :ruleset schedule)
; Stable compaction runs in one workgroup, looping over the input in tiles.
(rule ((= (Plan op) (Compact)))
      ((KernelPhase op "compact" (Fixed 64) 64 (FixedGrid 1 1 1))
       (PhaseEnds op "compact" "compact")) :ruleset schedule)
(rule ((= (Plan op) (Serial)))
      ((KernelPhase op "ordered" (Fixed 1) 1 (FixedGrid 1 1 1)) (PhaseEnds op "ordered" "ordered")) :ruleset schedule)
(rule ((KernelPhase op name n width grid) (= r (OperationRegion op)) (HostRegion r))
      ((Phase (Stage op name) r) (PhaseDomain (Stage op name) n width)
       (set (PhaseGrid (Stage op name)) grid)) :ruleset schedule)
(rule ((Phase (Stage op name) r) (!= name "combine") (!= name "chunks"))
      ((PhaseInput (Stage op name) op "environment")) :ruleset schedule)
(rule ((Phase (Stage op "chunks") r))
      ((PhaseInput (Stage op "chunks") op "early-environment")) :ruleset schedule)
(rule ((Phase (Stage op "chunks") r) (= (Plan op) (Totals)))
      ((PhaseInput (Stage op "chunks") op "environment")) :ruleset schedule)
(rule ((PhaseEnds op first last) (Phase (Stage op first) r) (Phase (Stage op last) r))
      ((FirstPhase op (Stage op first)) (LastPhase op (Stage op last))) :ruleset schedule)
(rule ((PhaseLink op a b) (Phase (Stage op a) r) (Phase (Stage op b) r))
      ((OrderEdge (At (Stage op a)) (At (Stage op b)))) :ruleset schedule)
(rule ((FirstPhase op first)) ((PhaseInput first op "input")) :ruleset schedule)

; Record the phase that actually writes each result, not just the recipe's last phase.
(rule ((ArrayResult op i t) (= phase (ElementPhase op)) (Phase (Stage op phase) r))
      ((Produces (Stage op phase) (Result op i))) :ruleset schedule)
(rule ((TotalResult op i t) (Phase (Stage op "combine") r))
      ((Produces (Stage op "combine") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Serial)) (ResultSlot op i) (Phase (Stage op "ordered") r))
      ((Produces (Stage op "ordered") (Result op i))) :ruleset schedule)
(rule ((= (Plan op) (Compact)) (Phase (Stage op "compact") r))
      ((Produces (Stage op "compact") (Result op 0))
       (Produces (Stage op "compact") (Result op 1))) :ruleset schedule)

(rule ((= op (Owner plan)) (PlanUpdateArray plan i initial mode) (= base (DestinationSlot op))
       (ParallelPhaseEnds op first last) (= phase (ElementPhase op)) (Phase (Stage op phase) r))
      ((Produces (Stage op phase) (Result op (+ base i)))) :ruleset schedule)

; Temporary recipe results have ordinary producers, consumers, and capacity.
(rule ((Accumulator op i t output source) (= groups (CollectiveGroups op)) (Phase (Stage op "chunks") r))
      ((set (StorageDeclaration (Temporary op "partial" i)) (AllocateResult (StoredArray t (Fixed groups) (Fixed groups)) (NoContents)))
       (Produces (Stage op "chunks") (Temporary op "partial" i))
       (Needs (Stage op "combine") (Temporary op "partial" i))) :ruleset schedule)
(rule ((Accumulator op state t (PrefixOutput i) source) (= n (InputDomain op)) (= groups (CollectiveGroups op)) (Phase (Stage op "offsets") r))
      ((set (StorageDeclaration (Temporary op "prefix" i)) (AllocateResult (StoredArray t n n) (NoContents)))
       (set (StorageDeclaration (Temporary op "offset" i)) (AllocateResult (StoredArray t (Fixed groups) (Fixed groups)) (NoContents)))
       (Produces (Stage op "chunks") (Temporary op "prefix" i))
       (Produces (Stage op "combine") (Temporary op "offset" i))
       (Needs (Stage op "offsets") (Temporary op "prefix" i))
       (Needs (Stage op "offsets") (Temporary op "offset" i))) :ruleset schedule)

; Device-local recipes retain only observed outputs; fused intermediates stream
; through the recipe without requiring a local allocation.
(rule ((= r (OperationRegion op)) (DeviceRegion r)) ((DeviceOperation op)) :ruleset schedule)
(rule ((DeviceOperation op) (Enters op r)) ((DeviceRegion r)) :ruleset schedule)
(rule ((Phase (Stage op "scalar") r)) ((DeviceOperation op)) :ruleset schedule)
(rule ((DeviceOperation op) (= recipe (Plan op)) (= value (BufferSlot op name i)) (!= name "output") (ElementType value t) (= n (CapacityExtent value)))
      ((LocalBuffer op name i t n)) :ruleset schedule)
(rule ((DeviceOperation op) (= recipe (Plan op)) (= value (BufferSlot op "output" i))
       (LocalObservedBuffer value) (ElementType value t) (= n (CapacityExtent value)))
      ((LocalBuffer op "output" i t n)) :ruleset schedule)



(rule ((DeviceOperation op) (= source (SourceOperationValue op)) (SourceScratch source n)
       (= (StorageDeclaration (Result op 0)) (AllocateResult (StoredArray t n live) (NoContents))))
      ((set (BufferSlot op "output" 0) (Result op 0)) (LocalBuffer op "output" 0 t n)) :ruleset schedule)

(rule ((Phase (Stage leader phase) r) (PlannedOperation op leader plan r)
       (= callback (SourceOperatorBody op)) (= (SourceOperation op) (OperationInfo origin kind))
       (!= phase "initialize") (!= phase "loop_enter") (!= phase "loop_exit")
       (!= phase "combine") (!= phase "chunks"))
      ((PhaseCallback (Stage leader phase) callback)) :ruleset schedule)
(rule ((Phase (Stage leader "chunks") r) (PlannedOperation op leader plan r)
       (= (PlanEarly plan op) true) (= callback (SourceOperatorBody op)))
      ((PhaseCallback (Stage leader "chunks") callback)) :ruleset schedule)
(rule ((Phase (Stage leader "chunks") r) (PlannedOperation op leader plan r)
       (= (FinalOutputPass plan) false) (= callback (SourceOperatorBody op)))
      ((PhaseCallback (Stage leader "chunks") callback)) :ruleset schedule)
; Combination consumes reducer callbacks, not the producer maps' environments.
(rule ((Phase (Stage leader "combine") r) (PlannedOperation op leader plan r)
       (= callback (SourceOperatorBody op)) (= (SourceOperation op) (OperationInfo origin kind))
       (!= kind "map") (!= kind "filter") (!= kind "scatter") (!= kind "bucket-scatter"))
      ((PhaseCallback (Stage leader "combine") callback)) :ruleset schedule)
(rule ((PhaseCallback stage region) (SourceRegionEnters region child))
      ((PhaseCallback stage child)) :ruleset schedule)
(rule ((PhaseCallback stage region) (= (SourceCapture region formal) source))
      ((Demand (InStage stage) source)) :ruleset schedule)
; Combine phases also evaluate the neutral values.
(rule ((Phase (Stage leader "combine") region) (PlannedOperation op leader plan region)
       (= neutral (SourceNeutral op)))
      ((Demand (InStage (Stage leader "combine")) neutral)) :ruleset schedule)

; Initialization is a fold over the result declarations. Copy and zero fills
; share one completed phase; scopes without initializers create no extra launch.
(rule ((= (StorageDeclaration value) (ExistingResult source)))
      ((set (ArrayInitialization value) (NoInitialization))) :ruleset allocation)
(rule ((= (StorageDeclaration value) (AllocateResult layout (NoContents))))
      ((set (ArrayInitialization value) (NoInitialization))) :ruleset allocation)
(rule ((= (StorageDeclaration value) (AllocateResult layout (CopyFrom source))) (= n (CapacityExtent value)))
      ((set (ArrayInitialization value) (Initialize n))) :ruleset allocation)
(rule ((= (StorageDeclaration value) (AllocateResult layout (ZeroContents))) (= n (CapacityExtent value)))
      ((set (ArrayInitialization value) (Initialize n))) :ruleset allocation)
(rule ((= op (Owner plan)) (= (PlanUpdates plan) (WithUpdates arrays blocks)))
      ((set (UpdateInitialization op 0) (NoInitialization))) :ruleset allocation)
(rule ((= op (Owner plan)) (PlanUpdateArray plan i initial mode) (= base (DestinationSlot op))
       (= previous (UpdateInitialization op i)) (= (ArrayInitialization (Result op (+ base i))) (NoInitialization)))
      ((set (UpdateInitialization op (+ i 1)) previous)) :ruleset allocation)
(rule ((= op (Owner plan)) (PlanUpdateArray plan i initial mode) (= base (DestinationSlot op))
       (= (UpdateInitialization op i) (NoInitialization)) (= next (ArrayInitialization (Result op (+ base i)))))
      ((set (UpdateInitialization op (+ i 1)) next)) :ruleset allocation)
(rule ((= op (Owner plan)) (PlanUpdateArray plan i initial mode) (= base (DestinationSlot op))
       (= (UpdateInitialization op i) (Initialize a)) (= (ArrayInitialization (Result op (+ base i))) (Initialize b)))
      ((set (UpdateInitialization op (+ i 1)) (Initialize (Sum a b)))) :ruleset allocation)
(rule ((Current group plan) (= (PlanAction plan) (Publish)) (= op (Owner plan)))
      ((set (InitializationOf op) (NoInitialization))) :ruleset allocation)
(rule ((Current group plan) (= (PlanUpdates plan) (WithUpdates arrays blocks)) (= op (Owner plan))
       (= initialization (UpdateInitialization op (vec-length arrays))))
      ((set (InitializationOf op) initialization)) :ruleset allocation)
(rule ((ParallelPhaseEnds op first last) (= (InitializationOf op) (NoInitialization)))
      ((PhaseEnds op first last)) :ruleset schedule)
(rule ((ParallelPhaseEnds op first last) (= (InitializationOf op) (Initialize n)) (= grid (OperationGrid op)))
      ((KernelPhase op "initialize" n 64 grid) (PhaseEnds op "initialize" last)
       (PhaseLink op "initialize" first) (PhaseInput (Stage op first) op "input")) :ruleset schedule)
(rule ((ParallelPhaseEnds op first last) (= (Plan op) (Totals))) ((set (ElementPhase op) first)) :ruleset schedule)
(rule ((ParallelPhaseEnds op first last) (= (Plan op) (Elements))) ((set (ElementPhase op) last)) :ruleset schedule)
(rule ((ParallelPhaseEnds op first last) (= (Plan op) (Prefixes))) ((set (ElementPhase op) last)) :ruleset schedule)
