(ruleset storage-shapes)
; Runtime rows have one flat allocation and an explicit row-major view shape.
(relation RectangularStorageShape (SourceValue i64 TypeKey RectangularShape Extent))
(rule ((RectangularStorageShape value axis ty shape count) (SourceArrayElement ty element)
       (= extent (RectangularAxis value axis)) (= (ExtentUniform extent) true))
      ((RectangularStorageShape value (+ axis 1) element (vec-push shape extent) (Product count extent))) :ruleset storage-shapes)
(rule ((DirectResult value owner i)
       (RectangularStorageShape value rank leaf shape count) (= ty (SourceType value)) (= rank (ArrayTypeRank ty)))
      ((set (StorageShape (Result owner i)) shape)
       (set (StorageElement (Result owner i)) leaf)
       (set (StorageExtent (Result owner i)) count)) :ruleset storage-shapes)

(rule ((ExtentDemand stage extent) (= extent (CallExtent call inner)) (ExtentDependency extent input))
      ((ExtentDemand stage input)) :ruleset residency)
(rule ((Needs stage value) (= extent (StorageExtent value)))
      ((ExtentDemand stage extent)) :ruleset residency)

; Projected result fields retain the same rectangular domain and a leaf field type.
(relation RectangularView (SourceValue TypeKey RectangularShape Extent))
(rule ((ValueRef source buffer) (= shape (StorageShape buffer))
       (= leaf (StorageElement buffer)) (= count (StorageExtent buffer)))
      ((RectangularView source leaf shape count)) :ruleset residency)
(rule ((RectangularView source leaf shape count) (SourceProjection value source i)
       (= fields (SourceTypeFields leaf)))
      ((RectangularView value (vec-get fields i) shape count)) :ruleset residency)
(rule ((RectangularView source leaf shape count) (= source (SourceAlias value)))
      ((RectangularView value leaf shape count)) :ruleset residency)
(rule ((ReturnArray output value) (RectangularView value leaf shape count))
      ((set (StorageShape (Output output)) shape) (set (StorageElement (Output output)) leaf)
       (set (StorageExtent (Output output)) count)) :ruleset residency)
