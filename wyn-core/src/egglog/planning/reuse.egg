; Permission to reuse a consumed input; the physical prepass checks layout and claims it once.
(ruleset reuse-reads)
(ruleset reuse-legality)
(ruleset reuse-select)
(relation ConsumedScalarArray (FunctionName ValueName))
(relation ReuseDomainInput (OperationKey ValueName))
(relation ReuseCandidate (OperationKey ValueName))
(function ReuseReadSafe (OperationKey ValueName OperationKey) bool :merge (or old new))
(function ReuseLegal (OperationKey ValueName) bool :merge (and old new))
(relation ReuseSnapshot (OperationKey ValueName OperationKey))
(relation ReuseClauses (OperationKey i64))
(relation ReusableParallelOutput (ResultRole))
(ReusableParallelOutput (CollectedOutput))
(ReusableParallelOutput (PrefixOutput))
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation))
      ((ReuseClauses operation 0)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseClauses operation clause) (< clause (ResultCount operation))
       (= (ResultKindOf operation clause) (Collected)))
      ((ReuseClauses operation (+ clause 1))) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseClauses operation clause) (< clause (ResultCount operation))
       (= (ResultKindOf operation clause) (Folded kind)))
      ((ReuseClauses operation (+ clause 1))) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (RootFunction root function)
       (= (wyn-parameter root slot) (ValueNameRef input)) (= (ParameterDiet root slot) (Consume))
       (= (ValueType input) (LogicalValue (ArrayType ownership extents (ElementValue element)))) (= (vec-length extents) 1))
      ((ConsumedScalarArray function input)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ConsumedScalarArray function input) (LiveOperation operation)
       (= parent (wyn-region-of operation)) (RootFunction root function) (FlowScopeAncestor root parent)
       (ParallelOperation operation) (= (OperationExecution operation) (DeviceKernel grid))
       (= (MovableOperation operation) true) (ReuseClauses operation (ResultCount operation)) (ReuseDomainInput operation input))
      ((ReuseCandidate operation input)) :ruleset reuse-reads)
; A full-length map may reuse a consumed backing even if it never loads an element.
(rule ((= revision (AnalysisRevision)) (= domain (OperationDomain operation)) (= (DomainRank domain) 1)
       (= extent (DomainExtent domain 0)) (CountLength extent input))
      ((ReuseDomainInput operation input)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ConsumedScalarArray function input)
       (= length (StaticIndex (LogicalOuterCount input)))
       (= domain (OperationDomain operation)) (= (DomainRank domain) 1)
       (= length (StaticIndex (DomainExtent domain 0)))
       (= body (wyn-control-region operation 0)) (= child (wyn-region-of read))
       (FlowScopeAncestor body child) (TotalIndex read) (= (wyn-input read 0) (ValueNameRef input)))
      ((ReuseDomainInput operation input)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ConsumedScalarArray function input) (LiveOperation operation)
       (= parent (wyn-region-of operation)) (RootFunction root function) (FlowScopeAncestor root parent)
       (MaterializedCopyOperation operation) (= (wyn-input operation 0) (ValueNameRef input)))
      ((ReuseCandidate operation input) (set (ReuseReadSafe operation input operation) true)) :ruleset reuse-reads)
; A copy made for mutation can take over a fresh backing after the last reader.
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (MaterializedCopyOperation operation)
       (= (wyn-input operation 0) (ValueNameRef input)) (FreshArray input))
      ((ReuseCandidate operation input) (set (ReuseReadSafe operation input operation) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input) (DirectOperationUse user (ValueNameRef input)))
      ((set (ReuseReadSafe operation input user) false)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input) (LengthOperation user axis) (= (wyn-input user 0) (ValueNameRef input)))
      ((set (ReuseReadSafe operation input user) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input) (ParallelOperation operation)
       (= body (wyn-control-region operation 0)) (FlowScopeAncestor body child) (= child (wyn-region-of user))
       (IndexOperation user) (= (wyn-input user 0) (ValueNameRef input)) (= domain (OperationDomain operation))
       (= (DomainRank domain) 1) (= (wyn-input-count user) 2) (= axis (DomainAxis domain 0))
       (= (wyn-input user 1) (ValueNameRef axis)))
      ((set (ReuseReadSafe operation input user) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input) (= parent (wyn-region-of operation))
       (= parent (wyn-region-of user)) (= before (wyn-operation-position user)) (= after (wyn-operation-position operation)) (< before after)
       (IndexOperation user) (DirectOperationUse user (ValueNameRef input))
       (= (wyn-input user 0) (ValueNameRef input)) (= (wyn-output-count user) 1)
       (ResultOrigin (ValueNameRef output) user 0) (= (ValueType output) (ScalarInfo element)))
      ((set (ReuseReadSafe operation input user) true) (ReuseSnapshot operation input user)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input))
      ((set (ReuseLegal operation input) true)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (= (ReuseReadSafe operation input user) false))
      ((set (ReuseLegal operation input) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input) (EndDemand region (ValueNameRef input)))
      ((set (ReuseLegal operation input) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (ReuseCandidate operation input) (ReuseCandidate other input) (!= operation other))
      ((set (ReuseLegal operation input) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (= (ReuseLegal operation input) true) (ParallelOperation operation)
       (ReusableParallelOutput (OutputRole operation slot)) (= (wyn-output operation slot) (ValueNameRef output)))
      ((CanReuse output input)) :ruleset reuse-select)
(rule ((= revision (AnalysisRevision)) (= (ReuseLegal operation input) true) (MaterializedCopyOperation operation)
       (= (wyn-output operation 0) (ValueNameRef output)))
      ((CanReuse output input)) :ruleset reuse-select)
(rule ((= revision (AnalysisRevision)) (= (ReuseLegal operation input) true) (ReuseSnapshot operation input user))
      ((RequiresSnapshot operation)) :ruleset reuse-select)

; Inline value copies can remain SSA snapshots when only element updates consume them.
(relation SnapshotCopy (ValueName))
(relation SnapshotUpdate (ValueName))
(function SnapshotUseSafe (ValueName OperationKey) bool :merge (or old new))
(function SnapshotCopySafe (ValueName) bool :merge (and old new))
(relation CanSnapshotCopy (ValueName))
(rule ((= revision (AnalysisRevision)) (MaterializedCopyOperation operation) (LiveOperation operation)
       (= (wyn-output operation 0) (ValueNameRef value)))
      ((SnapshotCopy value) (set (SnapshotCopySafe value) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value)
       (OperationUse user (ValueNameRef value)) (LiveOperation user))
      ((set (SnapshotUseSafe value user) false)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value) (IndexOperation user)
       (OperationUse user (ValueNameRef value)))
      ((set (SnapshotUseSafe value user) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value) (LengthOperation user axis)
       (OperationUse user (ValueNameRef value)))
      ((set (SnapshotUseSafe value user) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value) (WritesInput user 0)
       (= (wyn-input user 0) (ValueNameRef value)) (= slices (wyn-operation-slices user))
       (= (vec-length slices) 1) (= (vec-get slices 0) (At index)))
      ((SnapshotUpdate value) (set (SnapshotUseSafe value user) true)) :ruleset reuse-reads)
(rule ((= revision (AnalysisRevision)) (= (SnapshotUseSafe value user) false))
      ((set (SnapshotCopySafe value) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value) (= (wyn-is-yielded (ValueNameRef value)) true))
      ((set (SnapshotCopySafe value) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value) (CollectiveLaneUse operation clause (ValueNameRef value)))
      ((set (SnapshotCopySafe value) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (SnapshotCopy value) (FoldSeedUse operation (ValueNameRef value)))
      ((set (SnapshotCopySafe value) false)) :ruleset reuse-legality)
(rule ((= revision (AnalysisRevision)) (SnapshotUpdate value) (= (SnapshotCopySafe value) true))
      ((CanSnapshotCopy value)) :ruleset reuse-select)
