; Admission proves the external requirements of a closed parallel plan once.
; Every result shares the proof; maps and folds differ only in their output traversal.
(ruleset rectangular-discover)
(ruleset traversal-types)
(ruleset repeatability)
(ruleset traversal-proofs)
(ruleset traversal-ready)
(function CallHasCallee (SourceValue) bool :merge (or old new))
(function MappingCallbackIsScalar (OperationKey) bool :merge (or old new))
(rule ((= value (SourceInvocation scope function args))) ((set (CallHasCallee value) false)) :ruleset traversal-types)
(rule ((= callee (SourceCallTarget value))) ((set (CallHasCallee value) true)) :ruleset traversal-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping op) true))
      ((set (MappingCallbackIsScalar op) false)) :ruleset traversal-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping op) true) (= body (SourceOperatorBody op))
       (= result (SourceResult body)) (= ty (SourceType result)) (= source-layout-bytes (SourceByteSize ty)) (> source-layout-bytes 0))
      ((set (MappingCallbackIsScalar op) true)) :ruleset traversal-types)

(relation RectangularDemand (SourceValue))
(datatype RepeatContext (OutsidePlan) (InsidePlan FusionPlan))
(relation RectangularRequirement (SourceValue RepeatContext SourceValue))
(datatype RepeatCheck (Repeat RepeatContext SourceValue))
(sort RepeatChecks (Set RepeatCheck))
(function RectangularRequired (SourceValue) RepeatChecks :merge (set-union old new))
(function RectangularApproved (SourceValue) RepeatChecks :merge (set-union old new))
(relation RepeatDemand (RepeatContext SourceValue))
(rule ((RectangularDemand value)) ((set (RectangularRequired value) (set-empty)) (set (RectangularApproved value) (set-empty))) :ruleset rectangular-discover)
(rule ((RectangularRequirement value context input))
      ((set (RectangularRequired value) (set-of (Repeat context input))) (RepeatDemand context input)) :ruleset rectangular-discover)

; shortcut: all legal repetitions have equal cost until cost-based scheduling is added.
(function RepeatMapping (RepeatContext SourceValue) bool :no-merge)
(function RepeatBoundary (SourceValue) bool :merge (or old new))
(function RepeatEvaluation (RepeatContext SourceValue) bool :no-merge)
(rule ((= ty (SourceType value))) ((set (RepeatBoundary value) false)) :ruleset traversal-types)
(rule ((= op (SourceValueOperation value)) (= plan (SelectedPlan op)) (= region (PlanScope plan))
       (HostRegion region) (PlanResult plan role i value element)
       (= (PlanBody plan) (ParallelLoop domain totals scans arrays action)))
      ((set (RepeatBoundary value) true)) :ruleset traversal-types)
(rule ((= op (SourceValueOperation value)) (= (DispatchLoopSelected op) true))
      ((set (RepeatBoundary value) true)) :ruleset traversal-types)
(rule ((= actual (SourceAlias value)) (= (RepeatBoundary actual) true))
      ((set (RepeatBoundary value) true)) :ruleset traversal-types)
(rule ((= actual (SourceCapture region value)) (= (RepeatBoundary actual) true))
      ((set (RepeatBoundary value) true)) :ruleset traversal-types)
(rule ((= mapping (RepeatMapping context value)) (= boundary (RepeatBoundary value)))
      ((set (RepeatEvaluation context value) (or mapping (not boundary)))) :ruleset repeatability)
(relation RepeatEdge (RepeatContext SourceValue SourceValue))
(function Repeatable (RepeatContext SourceValue) bool :merge (and old new))
(rule ((RepeatDemand context formal) (= (SourceCapture region formal) actual))
      ((RepeatEdge context formal actual)) :ruleset repeatability)
; Flattening can remove a repeated evaluation when an inner domain is empty.
(rule ((RepeatDemand context value) (= (RepeatEvaluation context value) true) (= (SourceSpeculatable value) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((= mapping (RepeatMapping context value)))
      ((set (Repeatable context value) true)) :ruleset repeatability)
(rule ((RepeatDemand (OutsidePlan) value)) ((set (RepeatMapping (OutsidePlan) value) false)) :ruleset repeatability)
(rule ((RepeatDemand (InsidePlan plan) value) (= (SourceHasOperation value) false))
      ((set (RepeatMapping (InsidePlan plan) value) false)) :ruleset repeatability)
(rule ((RepeatDemand (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= other (SelectedPlan op)) (!= plan other))
      ((set (RepeatMapping (InsidePlan plan) value) false)) :ruleset repeatability)
(rule ((RepeatDemand (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= mapping (PlanMapping op)))
      ((set (RepeatMapping (InsidePlan plan) value) mapping)) :ruleset repeatability)
(rule ((= (RepeatEvaluation context value) true) (= (RepeatMapping context value) false) (SourceDirectUse value child))
      ((RepeatEdge context value child)) :ruleset repeatability)
(rule ((= (RepeatEvaluation context value) true) (= (RepeatMapping context value) false) (= (SourceBranch value) (BranchInfo test yes no))
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((RepeatEdge context value a) (RepeatEdge context value b)) :ruleset repeatability)
(rule ((RepeatDemand context value) (= argument (SourceCallArgument value i)))
      ((RepeatEdge context value argument)) :ruleset repeatability)
(rule ((= (RepeatEvaluation context value) true) (= (RepeatMapping context value) false) (= op (SourceValueOperation value))
       (= (SourceDuplicable value) false)) ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((RepeatDemand context value) (= (CallHasCallee value) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((RepeatDemand context value) (= callee (SourceCallTarget value)) (= (SourceDuplicable (FlowRegion callee)) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= (MappingCallbackIsScalar op) false))
      ((set (Repeatable (InsidePlan plan) value) false)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (SourceOperatorBody op)) (= result (SourceResult body)))
      ((RepeatEdge (InsidePlan plan) value result)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (SourceOperatorBody op)) (= (SourceCapture body formal) actual))
      ((RepeatEdge (InsidePlan plan) value actual)) :ruleset repeatability)
(rule ((= (RepeatMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value)) (= input (SourceInput op i)))
      ((RepeatEdge (InsidePlan plan) value input)) :ruleset repeatability)
(rule ((RepeatEdge context value child)) ((RepeatDemand context child)) :ruleset repeatability)
(rule ((RepeatEdge context value child) (= (Repeatable context child) false))
      ((set (Repeatable context value) false)) :ruleset repeatability)
(rule ((RectangularRequirement value context input) (= (Repeatable context input) true))
      ((set (RectangularApproved value) (set-of (Repeat context input)))) :ruleset traversal-proofs)
(relation RectangularReady (SourceValue))
(rule ((RectangularDemand value) (= (RectangularRequired value) (RectangularApproved value))) ((RectangularReady value)) :ruleset traversal-ready)

(rule ((RectangularDemand value) (= actual (SourceAlias value))) ((RectangularDemand actual)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= callee (SourceCallTarget value)) (= result (SourceResult callee)))
      ((RectangularDemand result)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= argument (SourceCallArgument value i)))
      ((RectangularRequirement value (OutsidePlan) argument)) :ruleset rectangular-discover)

(rule ((RectangularDemand value) (= (SourceBranch value) (BranchInfo condition yes no))
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((RectangularDemand a) (RectangularDemand b)
       (RectangularRequirement value (OutsidePlan) condition)) :ruleset rectangular-discover)

; One rectangular schedule per selected SCREMA. All policy precedes SSA emission.
(ruleset map-types)
(ruleset map-shapes)
(ruleset map-select)
(ruleset map-launch)
(function MapHost (FusionPlan) bool :merge (or old new))
(rule ((Current group plan)) ((set (MapHost plan) false)) :ruleset map-types)
(rule ((Current group plan) (= scope (PlanScope plan)) (HostRegion scope)) ((set (MapHost plan) true)) :ruleset map-types)
(relation MapPlan (FusionPlan OperationKey Extent))
(relation MapCandidate (SourceValue FusionPlan OperationKey RegionKey))
(rule ((Current group plan) (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= owner (Owner plan)) (= domain (PlanDomain plan)) (= extent (ShapeExtent domain)))
      ((MapPlan plan owner extent)) :ruleset rectangular-discover)
(rule ((Current group plan) (= (MapHost plan) true)
       (PlanResult plan "array" i value element))
      ((RectangularDemand value)) :ruleset rectangular-discover)
(relation TraversalPlan (SourceValue FusionPlan))
(function TraversalPlanBlocked (FusionPlan) bool :merge (or old new))
(function HasFolds (FusionPlan) bool :merge (or old new))
(rule ((Current group plan))
      ((set (TraversalPlanBlocked plan) false) (set (HasFolds plan) false)) :ruleset traversal-types)
(rule ((= fold (PlanFold plan source))) ((set (HasFolds plan) true)) :ruleset traversal-types)
(rule ((RectangularDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (= body (SourceOperatorBody op)) (= domain (PlanDomain plan)) (= (SourceReadOnly value) true))
      ((TraversalPlan value plan)) :ruleset rectangular-discover)
(rule ((TraversalPlan value plan) (= op (SourceValueOperation value))
       (= (PlanMapping op) true) (= body (SourceOperatorBody op))
       (= (HasFolds plan) false) (= (SourceReadOnly value) true) (= result (SourceResult body)))
      ((MapCandidate value plan op body) (RectangularDemand result)) :ruleset rectangular-discover)
(rule ((TraversalPlan value plan) (PlanMember plan op) (= body (SourceOperatorBody op))
       (= (SourceCapture body formal) actual))
      ((RectangularRequirement value (OutsidePlan) actual)) :ruleset rectangular-discover)
(rule ((TraversalPlan value plan) (PlanMember plan op) (= input (SourceInput op i)) (= (PlanInternal plan input) false))
      ((RectangularRequirement value (OutsidePlan) input)) :ruleset rectangular-discover)
(rule ((TraversalPlan value plan) (PlanMember plan op) (= input (SourceInput op i))
       (= (PlanInternal plan input) true) (= producer (SourceValueOperation input)) (= (PlanMapping producer) true))
      ((RectangularRequirement value (InsidePlan plan) input)) :ruleset rectangular-discover)
(rule ((TraversalPlan value plan) (PlanMember plan op) (= neutral (SourceNeutral op)))
      ((RectangularRequirement value (OutsidePlan) neutral)) :ruleset rectangular-discover)
(rule ((TraversalPlan value plan) (= (HasFolds plan) true) (PlanMember plan op)
       (= body (SourceOperatorBody op)) (= (SourceDuplicable (FlowRegion body)) false))
      ((set (TraversalPlanBlocked plan) true)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= (SourceHasFixedAxis value 0) false)
       (= op (SourceValueOperation value)) (= plan (SelectedPlan op)) (ScremaPlan plan)
       (PlanResult plan "array" i value element) (= domain (PlanDomain plan))
       (= extent (RectangularExtent (ShapeExtent domain))))
      ((set (RectangularAxis value 0) extent)) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (RectangularReady value) (= result (SourceResult body))
       (= ty (SourceType value)) (= rank (ArrayTypeRank ty)) (< (+ axis 1) rank)
       (= (SourceHasFixedAxis value (+ axis 1)) false) (= extent (RectangularAxis result axis)))
      ((set (RectangularAxis value (+ axis 1)) extent)) :ruleset map-shapes)

; Depth is bounded by the result type, including through recursive call links.
(function MapDepth (SourceValue) i64 :merge (max old new))
(rule ((RectangularDemand value)) ((set (MapDepth value) 0)) :ruleset map-shapes)
(rule ((RectangularDemand value) (= actual (SourceAlias value)) (= depth (MapDepth actual))
       (= ty (SourceType value)) (= rank (ArrayTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((RectangularDemand value) (RectangularReady value) (= callee (SourceCallTarget value)) (= result (SourceResult callee))
       (= (TraversalPrefixSpeculatable value) true)
       (= depth (MapDepth result)) (= ty (SourceType value)) (= rank (ArrayTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (RectangularReady value))
      ((set (MapDepth value) 1)) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (RectangularReady value) (= result (SourceResult body))
       (= (TraversalPrefixSpeculatable value) true)
       (= depth (MapDepth result)) (= prefix (RectangularPrefix result))
       (= output (SourceType value)) (= rank (ArrayTypeRank output)))
      ((set (MapDepth value) (min rank (+ 1 (min depth prefix))))) :ruleset map-shapes)

; Distribution keeps the branch inside the outer coordinates. Its condition
; must be safe even when an empty inner domain removes all repeated evaluations.
(rule ((RectangularDemand value) (RectangularReady value)
       (= (SourceBranch value) (BranchInfo condition yes no))
       (= (SourceReadOnly value) true)
       (= a (SourceResult yes)) (= b (SourceResult no)) (= x (MapDepth a)) (= y (MapDepth b)))
      ((set (MapDepth value) (min x y))) :ruleset map-shapes)
(rule ((RectangularDemand value) (= (SourceBranch value) (BranchInfo condition yes no))
       (= a (SourceResult yes)) (= b (SourceResult no)) (= (SourceHasFixedAxis value axis) false) (= extent (RectangularAxis a axis))
       (= extent (RectangularAxis b axis)))
      ((set (RectangularAxis value axis) extent)) :ruleset map-shapes)

(rule ((RectangularDemand value) (= (SourceView value) (ReindexedArray base extent indices))
       (= outer (RectangularExtent extent)) (= (SourceHasFixedAxis value 0) false))
      ((set (RectangularAxis value 0) outer)) :ruleset map-shapes)
(rule ((RectangularDemand value) (= view (SourceView value)) (RectangularReady value)
       (= ty (SourceType value)) (ArrayTypeAxis ty axis (DynamicSize)) (> axis 0)
       (= (SourceOutput output) (OutputInfo entry exported output-ty true))
       (= (FlowValueOf value) (FlowValueOf exported))
       (= depth (SourceTraversalDepth value)) (= prefix (RectangularPrefix value)))
      ((set (MapDepth value) (min depth prefix))) :ruleset map-shapes)
(rule ((Current group plan) (= (MapHost plan) true)
       (PlanResult plan "array" i value element) (= ty (SourceType value))
       (ArrayTypeAxis ty axis (DynamicSize)) (> axis 0) (SourceArrayElement ty first)
       (= outer (RectangularAxis value 0)) (= (ExtentUniform outer) true))
      ((RectangularStorageShape value 1 first (OneAxis outer))) :ruleset storage-shapes)

; Each output carries its own domain. Shared coordinates do not require equal
; inner shapes, and update effects retain the plan's original domain.
(function OutputShape (OperationKey i64 i64) DomainShape :no-merge)
(function OutputRank (OperationKey i64) i64 :merge (max old new))
(function RectangularOutputDomain (OperationKey i64) DomainShape :no-merge)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" slot value element)
       (= domain (PlanDomain plan)) (= rank (ShapeRank domain)))
      ((set (OutputShape owner slot rank) domain) (set (OutputRank owner slot) rank)) :ruleset map-select)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= (PlanAction plan) (Publish))
       (PlanResult plan "array" slot value element) (= depth (MapDepth value))
       (= prefix (OutputShape owner slot axis)) (< axis depth)
       (= n (RectangularAxis value axis)) (= (ExtentUniform n) true))
      ((set (OutputShape owner slot (+ axis 1)) (AppendAxis prefix n))
       (set (OutputRank owner slot) (+ axis 1))) :ruleset map-select)
(rule ((= rank (OutputRank owner slot)) (= shape (OutputShape owner slot rank)))
      ((set (RectangularOutputDomain owner slot) shape)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= (PlanAction plan) (Publish))
       (= totals (PlanTotals plan)) (= slot (ResultCount totals))
       (= shape (RectangularOutputDomain owner slot)))
      ((set (IterationShape owner) shape)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= (PlanAction plan) (PerformUpdates operations))
       (= domain (PlanDomain plan)))
      ((set (IterationShape owner) domain)) :ruleset map-launch)
