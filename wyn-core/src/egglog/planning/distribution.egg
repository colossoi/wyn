; Compose rectangular domains using the existing prefix/cost admission policy.
(ruleset distribution-index)
(function TransformRevision () i64 :no-merge)
(set (TransformRevision) 0)
(ruleset transform-availability)
(ruleset distribution-prefix)
(ruleset distribution-legality)
(ruleset distribution-select)
(ruleset row-width-legality)
(ruleset row-width-select)
(relation DistributionPair (OperationKey OperationKey))
(relation DistributionReturnPrefix (OperationKey OperationKey i64))
(relation DistributionPrefixAt (OperationKey OperationKey OperationKey))
(relation DistributionPrefixComplete (OperationKey OperationKey))
(relation DistributionPrefixOperation (OperationKey OperationKey OperationKey))
(relation TransformRequirement (OperationKey Name))
(function TransformAvailable (OperationKey Name) bool :merge (or old new))
(function DistributionLaneDependent (OperationKey) bool :merge (or old new))
(function DistributionSafe (OperationKey OperationKey) bool :merge (and old new))
(function DistributionHasFold (OperationKey) bool :merge (or old new))
(function KnownIndex (IndexExp) bool :merge (or old new))
(function EstimatedDomain (Domain i64) BigInt :no-merge)
(relation DistributeNest (OperationKey OperationKey))
(relation ReadyDistribution (OperationKey OperationKey))
(rule ((= revision (TransformRevision)) (LiveOperation outer) (ParallelOperation outer) (= body (ControlRegion outer 0))
       (LastOperation body inner) (ParallelOperation inner))
      ((DistributionPair outer inner) (DistributionReturnPrefix outer inner 0)
       (set (DistributionSafe outer inner) true) (set (DistributionHasFold inner) false)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= body (ControlRegion outer 0)) (FirstOperation body first))
      ((DistributionPrefixAt outer inner first)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= body (ControlRegion outer 0)) (= body (OperationRegion operation))
       (= order (OperationOrder operation)) (= last (OperationOrder inner)) (< order last))
      ((DistributionPrefixOperation outer inner operation) (set (DistributionLaneDependent operation) false)
       (EffectCompare operation inner)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPrefixOperation outer inner operation) (LaneDependentOperation operation))
      ((set (DistributionLaneDependent operation) true)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionReturnPrefix outer inner slot) (< slot (OutputCount outer))
       (= clause (OutputClause outer slot)) (= field (OutputField outer slot))
       (= (OutputRole outer slot) (CollectedOutput))
       (= name (Output inner slot)) (= name (ResultValue outer clause field)))
      ((DistributionReturnPrefix outer inner (+ slot 1))) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= (ResultKindOf inner clause) (Compacted)))
      ((set (DistributionSafe outer inner) false)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= (ResultKindOf inner clause) (Folded kind)))
      ((set (DistributionHasFold inner) true)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= domain (OperationDomain inner)) (= bound (DomainExtent domain slot)) (IndexUse bound value))
      ((TransformRequirement outer (ValueNameRef value))) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= reducer (ResultReducer inner clause)) (RegionCapture reducer name))
      ((TransformRequirement outer name)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= name (ResultNeutral inner clause slot)))
      ((TransformRequirement outer name)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (OperationCertificate inner value))
      ((TransformRequirement outer (ValueNameRef value))) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (DistributionPair outer inner) (= (TransformAvailable outer name) false))
      ((set (DistributionSafe outer inner) false)) :ruleset distribution-legality)
(rule ((= revision (TransformRevision)) (DistributionPrefixOperation outer inner operation) (OperationsConflict operation inner))
      ((set (DistributionSafe outer inner) false)) :ruleset distribution-legality)
(rule ((= revision (TransformRevision)) (DistributionPrefixAt outer inner operation) (!= operation inner)
       (RepeatableOperation operation) (DiscardableOperation operation) (= (DistributionLaneDependent operation) false)
       (NextOperation operation next))
      ((DistributionPrefixAt outer inner next)) :ruleset distribution-prefix)
(rule ((= revision (TransformRevision)) (DistributionPrefixAt outer inner operation) (!= operation inner) (TotalIndex operation)
       (NextOperation operation next))
      ((DistributionPrefixAt outer inner next)) :ruleset distribution-prefix)
; A statically in-bounds contiguous view is safe to repeat for each lane.
(rule ((= revision (TransformRevision)) (DistributionPrefixAt outer inner operation) (!= operation inner)
       (ViewOperation operation) (= (Input operation 0) (ValueNameRef array))
       (= n (StaticIndex (LogicalOuterCount array))) (= slices (OperationSlices operation))
       (= (vec-length slices) 1) (= (vec-get slices 0) (Slice start count (IndexConstant 1)))
       (= offset (StaticIndex start)) (= size (StaticIndex count))
       (>= offset 0) (>= size 0) (<= offset n) (<= size (- n offset))
       (NextOperation operation next))
      ((DistributionPrefixAt outer inner next)) :ruleset distribution-prefix)
(rule ((= revision (TransformRevision)) (DistributionPrefixAt outer inner inner))
      ((DistributionPrefixComplete outer inner)) :ruleset distribution-prefix)
(rule ((= revision (ShapeRevision)) (= domain (OperationDomain operation)) (= bound (DomainExtent domain slot)))
      ((set (KnownIndex bound) false)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= n (StaticIndex bound))) ((set (KnownIndex bound) true)) :ruleset graph-sizes)
(rule ((= revision (TransformRevision)) (= domain (OperationDomain operation)))
      ((set (EstimatedDomain domain 0) (bigint 1))) :ruleset distribution-prefix)
(rule ((= revision (TransformRevision)) (= prefix (EstimatedDomain domain slot)) (< slot (DomainRank domain)) (= bound (DomainExtent domain slot)) (= n (StaticIndex bound)))
      ((set (EstimatedDomain domain (+ slot 1)) (* prefix (bigint (max 0 n))))) :ruleset distribution-prefix)
(rule ((= revision (TransformRevision)) (= prefix (EstimatedDomain domain slot)) (< slot (DomainRank domain)) (= bound (DomainExtent domain slot)) (= (KnownIndex bound) false))
      ((set (EstimatedDomain domain (+ slot 1)) (* prefix (bigint 1024)))) :ruleset distribution-prefix)
