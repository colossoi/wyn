; Shared array type dimensions and symbolic extent proofs.
(ruleset shape-types)
(ruleset extent-shapes)
(function RectangularPrefix (SourceValue) i64 :merge (max old new))
(function RectangularAxis (SourceValue i64) Extent :no-merge)
(rule ((RectangularDemand value)) ((set (RectangularPrefix value) 0)) :ruleset extent-shapes)
(function ArrayTypeRank (TypeKey) i64 :merge (max old new))
(relation ArrayTypeAxis (TypeKey i64 ArraySize))
(rule ((= ty (TypeId id))) ((set (ArrayTypeRank ty) 0)) :ruleset shape-types)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (= n (ArrayTypeRank element)))
      ((set (ArrayTypeRank ty) (+ n 1))) :ruleset shape-types)
(rule ((= size (SourceArraySize ty))) ((ArrayTypeAxis ty 0 size)) :ruleset shape-types)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (ArrayTypeAxis element i size))
      ((ArrayTypeAxis ty (+ i 1) size)) :ruleset shape-types)
; Dimension expressions stay symbolic through helper calls. The dependency proof
; runs to completion before any uniformity decision is consumed.
(ruleset extent-dependencies)
(ruleset extent-uniformity)
(function RectangularExtent (Extent) Extent :no-merge)
(function ExtentKnownFormal (SourceValue) bool :merge (or old new))
(function ExtentIsLengthQuery (SourceValue) bool :merge (or old new))
(function ExtentKnownLength (SourceValue) bool :merge (or old new))
(rule ((= value (SourceFormal region i))) ((set (ExtentKnownFormal value) false)) :ruleset extent-shapes)
(rule ((= value (SourceParameter region i))) ((set (ExtentKnownFormal value) true)) :ruleset extent-shapes)
(rule ((= (SourceCapture region formal) actual)) ((set (ExtentKnownFormal formal) true)) :ruleset extent-shapes)
(rule ((= ty (SourceType value))) ((set (ExtentIsLengthQuery value) false)) :ruleset extent-shapes)
(rule ((= array (SourceLength value))) ((set (ExtentIsLengthQuery value) true)) :ruleset extent-shapes)
(rule ((Length value)) ((set (ExtentKnownLength value) false)) :ruleset extent-shapes)
(rule ((= extent (RectangularExtent (Length value)))) ((set (ExtentKnownLength value) true)) :ruleset extent-shapes)
(rule ((= ty (SourceType value)) (= size (SourceArraySize ty))) ((Length value)) :ruleset extent-shapes)
(rule ((Fixed n)) ((set (RectangularExtent (Fixed n)) (Fixed n))) :ruleset extent-shapes)
(rule ((Scalar value)) ((set (RectangularExtent (Scalar value)) (Scalar value))) :ruleset extent-shapes)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (RectangularExtent (Length value)) (Fixed n))) :ruleset extent-shapes)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= source (SourceAlias value)) (= extent (RectangularExtent (Length source))))
      ((set (RectangularExtent (Length value)) extent)) :ruleset extent-shapes)
(rule ((= (SourceCapture region formal) actual) (= extent (RectangularExtent (Length actual))))
      ((set (RectangularExtent (Length formal)) extent)) :ruleset extent-shapes)
(rule ((= value (SourceParameter region i)) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (RectangularExtent (Length value)) (Length value))) :ruleset extent-shapes)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= original (SourceExtent value)) (!= original (Length value)) (= extent (RectangularExtent original)))
      ((set (RectangularExtent (Length value)) extent)) :ruleset extent-shapes)
(rule ((Product a b) (= left (RectangularExtent a)) (= right (RectangularExtent b)))
      ((set (RectangularExtent (Product a b)) (Product left right))) :ruleset extent-shapes)
(rule ((Difference a b) (= left (RectangularExtent a)) (= right (RectangularExtent b)))
      ((set (RectangularExtent (Difference a b)) (Difference left right))) :ruleset extent-shapes)

(relation ExtentDependency (Extent Extent))
(relation ExtentBinding (Extent Extent Extent))
(relation ExtentSource (Extent SourceValue))
(relation ExtentEdge (Extent Extent))
(function ExtentUnsafe (Extent) bool :merge (or old new))
(function ExtentUniform (Extent) bool :merge (and old new))
(rule ((= extent (RectangularAxis value axis))) ((set (ExtentUniform extent) true)) :ruleset extent-uniformity)
(function ExtentInputUniform (Extent) bool :merge (or old new))
(rule ((Scalar value)) ((ExtentSource (Scalar value) value)) :ruleset extent-dependencies)
(rule ((Length value)) ((ExtentSource (Length value) value)) :ruleset extent-dependencies)
(rule ((ExtentSource extent value)) ((set (ExtentInputUniform extent) false)) :ruleset extent-dependencies)
(rule ((SourceOriginalEntry owner region source-entry-compute) (= value (SourceParameter region i))
       (= ty (SourceType value)) (= source-layout-bytes (SourceByteSize ty)) (> source-layout-bytes 0))
      ((set (ExtentInputUniform (Scalar value)) true)) :ruleset extent-dependencies)
(rule ((SourceOriginalEntry owner region source-entry-compute) (= value (SourceParameter region i))
       (= ty (SourceType value)) (= size (SourceArraySize ty)))
      ((set (ExtentInputUniform (Length value)) true)) :ruleset extent-dependencies)
(rule ((Scalar value) (= value (SourceParameter region i)))
      ((ExtentDependency (Scalar value) (Scalar value))) :ruleset extent-dependencies)
(rule ((Length value) (= value (SourceParameter region i)))
      ((ExtentDependency (Length value) (Length value))) :ruleset extent-dependencies)
(rule ((Scalar value) (= (ExtentIsLengthQuery value) false) (SourceDirectUse value child))
      ((ExtentEdge (Scalar value) (Scalar child))) :ruleset extent-dependencies)
(rule ((Scalar value) (= array (SourceLength value)))
      ((ExtentEdge (Scalar value) (Length array))) :ruleset extent-dependencies)
(rule ((Scalar value) (SourceNestedUse value child))
      ((ExtentEdge (Scalar value) (Scalar child))) :ruleset extent-dependencies)
(rule ((Scalar formal) (= (SourceCapture region formal) actual))
      ((ExtentEdge (Scalar formal) (Scalar actual))) :ruleset extent-dependencies)
(rule ((Length formal) (= (SourceCapture region formal) actual))
      ((ExtentEdge (Length formal) (Length actual))) :ruleset extent-dependencies)
(rule ((Scalar value) (= actual (SourceAlias value)))
      ((ExtentEdge (Scalar value) (Scalar actual))) :ruleset extent-dependencies)
(rule ((Length value) (= actual (SourceAlias value)))
      ((ExtentEdge (Length value) (Length actual))) :ruleset extent-dependencies)
(rule ((= extent (RectangularExtent (Length value))) (!= extent (Length value)))
      ((ExtentEdge (Length value) extent)) :ruleset extent-dependencies)
(rule ((Product a b)) ((ExtentEdge (Product a b) a) (ExtentEdge (Product a b) b)) :ruleset extent-dependencies)
(rule ((Difference a b)) ((ExtentEdge (Difference a b) a) (ExtentEdge (Difference a b) b)) :ruleset extent-dependencies)
(rule ((ExtentEdge extent child) (ExtentDependency child input))
      ((ExtentDependency extent input)) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= callee (PlanCallee call))
       (ExtentDependency inner (Scalar formal)) (= formal (SourceParameter callee i)) (= actual (PlanCallArgument call i)))
      ((ExtentBinding extent (Scalar formal) (Scalar actual)) (ExtentEdge extent (Scalar actual))) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= callee (PlanCallee call))
       (ExtentDependency inner (Length formal)) (= formal (SourceParameter callee i)) (= actual (PlanCallArgument call i)))
      ((ExtentBinding extent (Length formal) (Length actual)) (ExtentEdge extent (Length actual))) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= callee (PlanCallee call))
       (ExtentDependency inner input) (ExtentSource input formal) (= region (SourceParameterRegion formal)) (!= region callee))
      ((ExtentDependency extent input)) :ruleset extent-dependencies)
(rule ((ExtentSource extent value) (= (ExtentKnownFormal value) false))
      ((set (ExtentUnsafe extent) true)) :ruleset extent-dependencies)
(rule ((Length source) (= (ExtentKnownLength source) false)) ((set (ExtentUnsafe (Length source)) true)) :ruleset extent-dependencies)
(rule ((Scalar source) (= (SourceRequiresDevice source) true) (= (ExtentIsLengthQuery source) false))
      ((set (ExtentUnsafe (Scalar source)) true)) :ruleset extent-dependencies)
(rule ((Scalar source) (= (SourceDuplicable source) false)) ((set (ExtentUnsafe (Scalar source)) true)) :ruleset extent-dependencies)
(rule ((ExtentEdge extent child) (= (ExtentUnsafe child) true)) ((set (ExtentUnsafe extent) true)) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= (ExtentUnsafe inner) true)) ((set (ExtentUnsafe extent) true)) :ruleset extent-dependencies)
(rule ((= (ExtentUnsafe extent) true)) ((set (ExtentUniform extent) false)) :ruleset extent-uniformity)
(rule ((ExtentDependency extent input) (= (ExtentInputUniform input) false))
      ((set (ExtentUniform extent) false)) :ruleset extent-uniformity)

(rule ((RectangularDemand value) (= ty (SourceType value)) (ArrayTypeAxis ty i (FixedSize n)))
      ((set (RectangularAxis value i) (Fixed n))) :ruleset extent-shapes)
(rule ((RectangularDemand value) (= actual (SourceAlias value)) (= extent (RectangularAxis actual axis)))
      ((set (RectangularAxis value axis) extent)) :ruleset extent-shapes)
(rule ((RectangularDemand value) (RectangularReady value) (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= ty (SourceType value)) (ArrayTypeAxis ty axis (DynamicSize))
       (= extent (RectangularAxis result axis)))
      ((set (RectangularAxis value axis) (CallExtent value extent))) :ruleset extent-shapes)
(rule ((= n (RectangularPrefix value)) (= extent (RectangularAxis value n)))
      ((set (RectangularPrefix value) (+ n 1))) :ruleset extent-shapes)
