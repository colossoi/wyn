; Logical length witnesses and allocation bounds are separate proofs.
(function IndexUpper (IndexExp) i64 :merge (min old new))
(relation CountLength (IndexExp ValueName))
(relation LengthWitness (ValueName ValueName))
(datatype LogicalPath (RootPath) (FieldPath LogicalPath i64))
(relation ProductField (ValueName i64 ValueName))
(relation ProductComponent (ValueName LogicalPath ValueName))
(relation ProjectionPath (ValueName ValueName LogicalPath))
(relation LoopValueCarry (OperationKey i64 ValueName ValueName ValueName))
(relation LoopArrayComponent (OperationKey i64 LogicalPath ValueName ValueName ValueName))
(relation LoopPreservesComponentLength (OperationKey i64 LogicalPath))
(function IntegerLower (Name) i64 :merge (max old new))
(function IntegerUpper (Name) i64 :merge (min old new))
(rule ((= revision (AnalysisRevision)) (= info (ValueType value)))
      ((ProductComponent value (RootPath) value) (ProjectionPath value value (RootPath))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ProductOperation operation) (= (Output operation 0) (ValueNameRef product))
       (= (Input operation slot) (ValueNameRef field)))
      ((ProductField product slot field)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ProductComponent product path value) (ProductField value slot field))
      ((ProductComponent product (FieldPath path slot) field)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ProjectionOperation operation slot) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)) (ProjectionPath source root path))
      ((ProjectionPath value root (FieldPath path slot))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ProjectionOperation operation slot) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)) (ProductComponent source (FieldPath (RootPath) slot) field))
      ((OuterShapeSource value field)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (OuterShapeSource value source) (ProductComponent source path field))
      ((ProductComponent value path field)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (BranchOperation operation) (= a (ControlRegion operation 0)) (= b (ControlRegion operation 1))
       (= (RegionYield a slot) (ValueNameRef yes)) (= (RegionYield b slot) (ValueNameRef no))
       (= (Output operation slot) (ValueNameRef result))
       (ProductComponent yes path field) (ProductComponent no path field))
      ((ProductComponent result path field)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (AccumulatorOperation operation) (= (AccumulatorGroupCount operation) 1)
       (= (AccumulatorArrayCount operation 0) 1) (= (OutputCount operation) 1)
       (= (Output operation 0) (ValueNameRef result)) (ArrayValue result)
       (= source (AccumulatorArray operation 0 0)))
      ((OuterShapeSource result source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= body (ControlRegion operation 0))
       (= (EdgeArgument operation 0 slot) (ValueNameRef initial)) (= (RegionParameter body slot) (ValueNameRef carried))
       (= (RegionYield body slot) (ValueNameRef next)))
      ((LoopValueCarry operation slot carried initial next)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry operation slot carried initial next)
       (ProjectionPath array carried path) (ArrayValue array)
       (ProductComponent initial path first) (ProductComponent next path last))
      ((LoopArrayComponent operation slot path array first last) (LengthWitness array array)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry operation slot carried initial next) (ArrayValue carried))
      ((LengthWitness carried carried)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (OuterShapeSource next previous) (LengthWitness previous carried))
      ((LengthWitness next carried)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ProjectionPath left root path) (ProjectionPath right root path))
      ((OuterShapeSource left right)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (BranchOperation operation) (= a (ControlRegion operation 0)) (= b (ControlRegion operation 1))
       (= (RegionYield a slot) (ValueNameRef yes)) (= (RegionYield b slot) (ValueNameRef no))
       (= (Output operation slot) (ValueNameRef result)) (LengthWitness yes carried) (LengthWitness no carried))
      ((LengthWitness result carried)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopArrayComponent operation slot path array first last) (LengthWitness last array))
      ((LoopPreservesComponentLength operation slot path)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopArrayComponent operation slot path array first last)
       (LoopPreservesComponentLength operation slot path) (= bound (OuterCapacity first)))
      ((set (OuterCapacity array) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry operation slot carried initial next)
       (LoopPreservesComponentLength operation slot path) (= (Output operation slot) (ValueNameRef result))
       (ProjectionPath array result path) (ProductComponent initial path first))
      ((OuterShapeSource array first)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry operation slot carried initial next)
       (LengthWitness next carried) (ArrayValue carried))
      ((LoopPreservesOuterLength operation slot)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry operation slot carried initial next)
       (LoopPreservesOuterLength operation slot) (= bound (OuterCapacity initial)))
      ((set (OuterCapacity carried) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopValueCarry operation slot carried initial next)
       (LoopPreservesOuterLength operation slot) (= (Output operation slot) (ValueNameRef output)))
      ((OuterShapeSource output initial)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LengthOperation operation 0) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)))
      ((CountLength (IndexValue value) source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexCalculationOperation operation) (= index (OperationIndex operation 0))
       (= (Output operation 0) (ValueNameRef value)) (CountLength index source))
      ((CountLength (IndexValue value) source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexMax (IndexConstant 0) count)) (CountLength count source))
      ((CountLength index source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= count (LogicalOuterCount value)) (CountLength count source))
      ((OuterShapeSource value source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (MaterializedCopyOperation operation) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)))
      ((OuterShapeSource value source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= domain (OperationDomain operation)) (= (DomainRank domain) 1)
       (= (OutputRole operation slot) (TotalOutput)) (= clause (OutputClause operation slot)) (= field (OutputField operation slot))
       (= reducer (ResultReducer operation clause)) (ReducerPreservesOuterLength reducer field)
       (= (ResultNeutral operation clause field) (ValueNameRef source)) (= (Output operation slot) (ValueNameRef value)))
      ((OuterShapeSource value source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= domain (OperationDomain operation)) (> (DomainRank domain) 1)
       (= (OutputRole operation slot) (TotalOutput)) (= (Output operation slot) (ValueNameRef value)) (ArrayValue value)
       (= count (DomainExtent domain 0)))
      ((set (LogicalOuterCount value) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ViewOperation operation) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)) (= slices (OperationSlices operation)) (= (vec-length slices) 1)
       (= (vec-get slices 0) (Slice start count (IndexConstant stride))) (!= stride 0))
      ((set (LogicalOuterCount value) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ViewOperation operation) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)) (= slices (OperationSlices operation)) (= (vec-length slices) 1)
       (= (vec-get slices 0) (Slice start count (IndexConstant stride))) (!= stride 0) (= bound (OuterCapacity source)))
      ((set (OuterCapacity value) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= bound (StaticIndex index))) ((set (IndexUpper index) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= count (LogicalOuterCount value)) (= bound (OuterCapacity value)))
      ((set (IndexUpper count) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LengthOperation operation 0) (= (Input operation 0) (ValueNameRef source))
       (= (Output operation 0) (ValueNameRef value)) (= bound (OuterCapacity source)))
      ((set (IndexUpper (IndexValue value)) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexCalculationOperation operation) (= index (OperationIndex operation 0))
       (= (Output operation 0) (ValueNameRef value)) (= bound (IndexUpper index)))
      ((set (IndexUpper (IndexValue value)) bound)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ForwardLength operation count) (= n (StaticIndex count))
       (= (Output operation 0) (ValueNameRef value)))
      ((set (StaticIndex (IndexValue value)) n)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (FreshOutput operation slot)
       (= shape (OperationShape operation)) (= (vec-length shape) 1)
       (= (Output operation slot) (ValueNameRef value)))
      ((set (LogicalOuterCount value) (vec-get shape 0))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (RangeOperation operation) (= count (OperationIndex operation 0))
       (= (Output operation 0) (ValueNameRef value)))
      ((set (LogicalOuterCount value) (IndexMax (IndexConstant 0) count))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ArrayLiteralOperation operation) (= count (InputCount operation))
       (= (Output operation 0) (ValueNameRef value)))
      ((set (OuterCapacity value) count) (set (LogicalOuterCount value) (IndexConstant count))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= domain (OperationDomain operation))
       (= count (DomainExtent domain 0)) (= bound (IndexUpper count)) (= (Output operation slot) (ValueNameRef value))
       (= (OutputRole operation slot) (CollectedOutput)))
      ((set (OuterCapacity value) (max 0 bound))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= domain (OperationDomain operation))
       (= count (DomainExtent domain 0)) (= bound (IndexUpper count)) (= (Output operation slot) (ValueNameRef value))
       (= (OutputRole operation slot) (CompactedOutput)))
      ((set (OuterCapacity value) (max 0 bound))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= count (LogicalOuterCount value)) (= bound (IndexUpper count)))
      ((set (OuterCapacity value) (max 0 bound))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexMax left right)) (= a (StaticIndex left)) (= b (StaticIndex right)))
      ((set (StaticIndex index) (max a b))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexMin left right)) (= a (StaticIndex left)) (= b (StaticIndex right)))
      ((set (StaticIndex index) (min a b))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexMax left right)) (= a (IndexUpper left)) (= b (IndexUpper right)))
      ((set (IndexUpper index) (max a b))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexMin left right)) (= a (IndexUpper left)) (= b (IndexUpper right)))
      ((set (IndexUpper index) (min a b))) :ruleset graph-sizes)
; Integer sum bounds use the same nonnegative, nonoverflowing i32 policy as emission.
(rule ((= revision (AnalysisRevision)) (= bits (ConstantValue name)) (= (ValuePrimitive name) (I32))
       (>= bits -2147483648) (<= bits 2147483647))
      ((set (IntegerLower name) bits) (set (IntegerUpper name) bits)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (SelectPayload payload)
       (= a (Input operation 0)) (= b (Input operation 1)) (= output (Output operation 0))
       (= (ValuePrimitive output) (I32)) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b)))
      ((set (IntegerLower output) (min la lb)) (set (IntegerUpper output) (max ha hb))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (BranchOperation operation) (= a (ControlRegion operation 0)) (= b (ControlRegion operation 1))
       (= av (RegionYield a slot)) (= bv (RegionYield b slot)) (= output (Output operation slot))
       (= (ValuePrimitive output) (I32)) (= la (IntegerLower av)) (= lb (IntegerLower bv))
       (= ha (IntegerUpper av)) (= hb (IntegerUpper bv)))
      ((set (IntegerLower output) (min la lb)) (set (IntegerUpper output) (max ha hb))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (ValueType value) (ScalarInfo (ScalarElement (I32))))
       (= high (IntegerUpper (ValueNameRef value))))
      ((set (IndexUpper (IndexValue value)) high)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= domain (OperationDomain operation)) (= (DomainRank domain) 1)
       (= n (IndexUpper (DomainExtent domain 0))) (>= n 0) (<= n 2147483647)
       (= reducer (ResultReducer operation clause)) (= payload (NativeBinaryReducer reducer)) (AdditionPayload payload)
       (= (ResultNeutralCount operation clause) 1) (= neutral (ResultNeutral operation clause 0))
       (= (ConstantValue neutral) 0) (= (ValuePrimitive neutral) (I32))
       (= contribution (ResultValue operation clause 0)) (= low (IntegerLower contribution)) (>= low 0)
       (= high (IntegerUpper contribution)) (<= high 2147483647) (= bound (* n high)) (<= bound 2147483647)
       (= (OutputClause operation slot) clause) (= (OutputRole operation slot) (TotalOutput))
       (= output (Output operation slot)))
      ((set (IntegerLower output) 0) (set (IntegerUpper output) bound)) :ruleset graph-sizes)

; An indexed literal has a bound only after every element has been proved bounded.
(relation ArrayElementRange (ValueName i64 i64))
(relation LiteralRangePrefix (OperationKey i64 i64 i64))
(rule ((= revision (AnalysisRevision)) (ArrayLiteralOperation operation)
       (= first (Input operation 0)) (= low (IntegerLower first)) (= high (IntegerUpper first)))
      ((LiteralRangePrefix operation 1 low high)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LiteralRangePrefix operation slot low high)
       (< slot (InputCount operation)) (= value (Input operation slot))
       (= next-low (IntegerLower value)) (= next-high (IntegerUpper value)))
      ((LiteralRangePrefix operation (+ slot 1) (min low next-low) (max high next-high))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LiteralRangePrefix operation count low high)
       (= count (InputCount operation)) (= (Output operation 0) (ValueNameRef array)))
      ((ArrayElementRange array low high)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexOperation operation) (= (Input operation 0) (ValueNameRef array))
       (ArrayElementRange array low high) (= value (Output operation 0)) (= (ValuePrimitive value) (I32)))
      ((set (IntegerLower value) low) (set (IntegerUpper value) high)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (RangeOperation operation) (= start (Input operation 0))
       (= step (Input operation 1)) (= stride (IntegerLower step)) (= stride (IntegerUpper step))
       (= low (IntegerLower start)) (= high (IntegerUpper start))
       (= count (IndexUpper (OperationIndex operation 0))) (> count 0) (<= count 2147483647)
       (= delta (* (- count 1) stride)) (= lower (+ low (min 0 delta))) (= upper (+ high (max 0 delta)))
       (>= lower -2147483648) (<= upper 2147483647) (= (Output operation 0) (ValueNameRef array)))
      ((ArrayElementRange array lower upper)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (AdditionPayload payload)
       (= a (Input operation 0)) (= b (Input operation 1)) (= output (Output operation 0))
       (= (ValuePrimitive output) (I32)) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b))
       (= low (+ la lb)) (= high (+ ha hb)) (>= low -2147483648) (<= high 2147483647))
      ((set (IntegerLower output) low) (set (IntegerUpper output) high)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= payload (ScalarPayload operation)) (SubtractionPayload payload)
       (= a (Input operation 0)) (= b (Input operation 1)) (= output (Output operation 0))
       (= (ValuePrimitive output) (I32)) (= la (IntegerLower a)) (= lb (IntegerLower b))
       (= ha (IntegerUpper a)) (= hb (IntegerUpper b))
       (= low (- la hb)) (= high (- ha lb)) (>= low -2147483648) (<= high 2147483647))
      ((set (IntegerLower output) low) (set (IntegerUpper output) high)) :ruleset graph-sizes)

; Collection shape proofs are independent of allocation and dispatch placement.
(function CollectionRank (ValueName) i64 :no-merge)
(function CollectionExtent (ValueName i64) IndexExp :no-merge)
(function CollectionElement (ValueName) ValueName :merge old)
(relation CollectionRole (ResultRole))
(CollectionRole (CollectedOutput))
(CollectionRole (CompactedOutput))
(CollectionRole (PrefixOutput))
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef value)) (= role (OutputRole operation slot))
       (CollectionRole role)
       (= domain (OperationDomain operation)) (= rank (DomainRank domain)))
      ((set (CollectionRank value) rank)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (ParallelOperation operation)
       (= (Output operation slot) (ValueNameRef value)) (= (OutputRole operation slot) (TotalOutput))
       (= domain (OperationDomain operation)) (= rank (DomainRank domain)))
      ((set (CollectionRank value) (max 0 (- rank 1)))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (Output operation slot) (ValueNameRef value))
       (= rank (CollectionRank value)) (= domain (OperationDomain operation))
       (= extent (DomainExtent domain axis)) (< axis rank))
      ((set (CollectionExtent value axis) extent)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= rank (CollectionRank value))
       (= (Output operation slot) (ValueNameRef value)) (= clause (OutputClause operation slot))
       (= field (OutputField operation slot)) (= (ResultValue operation clause field) (ValueNameRef source))
       (= (ResultKindOf operation clause) (Collected)))
      ((set (CollectionElement value) source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= rank (CollectionRank value))
       (= (Output operation slot) (ValueNameRef value)) (= clause (OutputClause operation slot))
       (= field (OutputField operation slot)) (= (ResultKindOf operation clause) (Compacted))
       (= (ResultValue operation clause field) (ValueNameRef source)))
      ((set (CollectionElement value) source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= rank (CollectionRank value))
       (= (Output operation slot) (ValueNameRef value)) (= clause (OutputClause operation slot))
       (= field (OutputField operation slot)) (= reducer (ResultReducer operation clause))
       (ReducerPreservesOuterLength reducer field)
       (= (ResultNeutral operation clause field) (ValueNameRef source)))
      ((set (CollectionElement value) source)) :ruleset graph-sizes)

; Indexing a collection of equally sized rows preserves that proven row length.
(rule ((= revision (AnalysisRevision)) (IndexOperation operation) (= (InputCount operation) 2)
       (= (Input operation 0) (ValueNameRef source)) (= (CollectionRank source) 1)
       (= element (CollectionElement source)) (= count (LogicalOuterCount element)) (= size (StaticIndex count))
       (= (Output operation 0) (ValueNameRef result)))
      ((set (LogicalOuterCount result) (IndexConstant size))) :ruleset graph-sizes)
