(rule ((= revision (ShapeRevision)) (LengthMeasure operation 0 source value))
      ((CountLength (IndexValue value) source)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (IndexCalculationOperation operation) (= index (wyn-index-expression operation))
