(rule ((= revision (ShapeRevision)) (ParallelOperation operation) (= domain (wyn-iteration-domain operation)) (= (wyn-domain-rank domain) 1)
       (= (wyn-output-role operation slot) (TotalOutput)) (= clause (wyn-output-clause operation slot)) (= field (wyn-output-field operation slot))
       (ReducerBody operation clause reducer) (ReducerPreservesOuterLength reducer field)
       (FoldSeedUse operation (ValueNameRef source)) (= (wyn-fold-seed operation clause field) (ValueNameRef source)) (ResultOrigin (ValueNameRef value) operation slot))
      ((OuterShapeSource value source)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (ParallelOperation operation) (= domain (wyn-iteration-domain operation)) (> (wyn-domain-rank domain) 1)
       (= (wyn-output-role operation slot) (TotalOutput)) (ResultOrigin (ValueNameRef value) operation slot) (ArrayValue value)
