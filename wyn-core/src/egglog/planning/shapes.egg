(rule ((= revision (ShapeRevision)) (= count (LogicalOuterCount value)) (= bound (IndexUpper count)))
      ((set (OuterCapacity value) (max 0 bound))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= index (IndexMax left right)) (= a (StaticIndex left)) (= b (StaticIndex right)))
      ((set (StaticIndex index) (max a b))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= index (IndexMin left right)) (= a (StaticIndex left)) (= b (StaticIndex right)))
      ((set (StaticIndex index) (min a b))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= index (IndexMax left right)) (= a (IndexUpper left)) (= b (IndexUpper right)))
      ((set (IndexUpper index) (max a b))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= index (IndexMin left right)) (= a (IndexUpper left)) (= b (IndexUpper right)))
      ((set (IndexUpper index) (min a b))) :ruleset graph-sizes)
; Shape planning also consumes scalar ranges.
(rule ((= revision (ShapeRevision)) (= bits (ConstantValue name)) (= (ValuePrimitive name) (I32))
       (>= bits -2147483648) (<= bits 2147483647))
      ((set (IntegerLower name) bits) (set (IntegerUpper name) bits)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= index (IndexValue value)))
      ((IntegerBoundsDemand (ValueNameRef value))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (ParallelOperation operation) (FoldClause operation clause callback-kind) (ReducerBody operation clause reducer)
       (= payload (NativeBinaryReducer reducer)) (AdditionPayload payload) (= value (wyn-contribution operation clause 0)))
      ((IntegerBoundsDemand value)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (ArrayLiteralOperation operation)
       (= arity (wyn-input-count operation)) (AritySlot arity slot) (= value (wyn-input operation slot)))
      ((IntegerBoundsDemand value)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (RangeOperation operation) (= start (wyn-input operation 0)) (= step (wyn-input operation 1)))
      ((IntegerBoundsDemand start) (IntegerBoundsDemand step)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= (ValueType value) (ScalarInfo (ScalarElement (I32))))
       (= high (IntegerUpper (ValueNameRef value))))
      ((set (IndexUpper (IndexValue value)) high)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (ReductionBoundOperands output reducer extent neutral contribution)
       (= n (IndexUpper extent)) (>= n 0) (<= n 2147483647)
       (= payload (NativeBinaryReducer reducer)) (AdditionPayload payload)
       (= (ConstantValue neutral) 0) (= (ValuePrimitive neutral) (I32))
       (= low (IntegerLower contribution)) (>= low 0)
       (= high (IntegerUpper contribution)) (<= high 2147483647)
       (= bound (* n high)) (<= bound 2147483647))
      ((set (IntegerLower output) 0) (set (IntegerUpper output) bound)) :ruleset graph-sizes)

; An indexed literal has a bound only after every element has been proved bounded.
(relation ArrayElementRange (ValueName i64 i64))
(relation LiteralRangePrefix (OperationKey i64 i64 i64))
(rule ((= revision (ShapeRevision)) (ArrayLiteralOperation operation)
       (DirectOperationUse operation first) (= first (wyn-input operation 0)) (= low (IntegerLower first)) (= high (IntegerUpper first)))
      ((LiteralRangePrefix operation 1 low high)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (LiteralRangePrefix operation slot low high)
       (< slot (wyn-input-count operation)) (DirectOperationUse operation value) (= value (wyn-input operation slot))
       (= next-low (IntegerLower value)) (= next-high (IntegerUpper value)))
      ((LiteralRangePrefix operation (+ slot 1) (min low next-low) (max high next-high))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (LiteralRangePrefix operation count low high)
       (= count (wyn-input-count operation)) (ResultOrigin (ValueNameRef array) operation 0))
      ((ArrayElementRange array low high)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (IndexOperation operation) (DirectOperationUse operation (ValueNameRef array)) (= (wyn-input operation 0) (ValueNameRef array))
       (ArrayElementRange array low high) (ResultOrigin value operation 0) (= (ValuePrimitive value) (I32)))
      ((set (IntegerLower value) low) (set (IntegerUpper value) high)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (RangeOperation operation) (DirectOperationUse operation start) (= start (wyn-input operation 0))
       (DirectOperationUse operation step) (= step (wyn-input operation 1)) (= stride (IntegerLower step)) (= stride (IntegerUpper step))
       (= low (IntegerLower start)) (= high (IntegerUpper start))
       (= count (IndexUpper (wyn-index-expression operation))) (> count 0) (<= count 2147483647)
       (= delta (* (- count 1) stride)) (= lower (+ low (min 0 delta))) (= upper (+ high (max 0 delta)))
       (>= lower -2147483648) (<= upper 2147483647) (ResultOrigin (ValueNameRef array) operation 0))
      ((ArrayElementRange array lower upper)) :ruleset graph-sizes)

; Collection shape proofs are independent of allocation and dispatch placement.
(function CollectionRank (ValueName) i64 :no-merge)
(function CollectionExtent (ValueName i64) IndexExp :no-merge)
(function CollectionElement (ValueName) ValueName :merge old)
(relation LoopCapturedRow (ValueName ValueName))
(function LoopInitialRow (ValueName) ValueName :merge old)
(relation RankedLoopCollection (ValueName))
(relation LoopReadsRowWidth (ValueName))
(relation CollectionRole (ResultRole))
(CollectionRole (CollectedOutput))
(CollectionRole (CompactedOutput))
(CollectionRole (PrefixOutput))
(rule ((= revision (ShapeRevision)) (LiveOperation operation) (ParallelOperation operation)
       (ResultOrigin (ValueNameRef value) operation slot) (= role (wyn-output-role operation slot))
       (CollectionRole role)
       (= domain (wyn-iteration-domain operation)) (= rank (wyn-domain-rank domain)))
      ((set (CollectionRank value) rank)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (LiveOperation operation) (ParallelOperation operation)
       (ResultOrigin (ValueNameRef value) operation slot) (= (wyn-output-role operation slot) (TotalOutput))
       (= domain (wyn-iteration-domain operation)) (= rank (wyn-domain-rank domain)))
      ((set (CollectionRank value) (max 0 (- rank 1)))) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (ResultOrigin (ValueNameRef value) operation slot)
       (= rank (CollectionRank value)) (= domain (wyn-iteration-domain operation))
       (IterationAxis domain axis) (= extent (wyn-domain-extent domain axis)) (< axis rank))
      ((set (CollectionExtent value axis) extent)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (LengthOperation operation axis) (> axis 0)
       (DirectOperationUse operation (ValueNameRef source)) (= (wyn-input operation 0) (ValueNameRef source)) (= extent (CollectionExtent source axis)))
      ((ForwardLength operation extent)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= rank (CollectionRank value))
       (ResultOrigin (ValueNameRef value) operation slot) (= clause (wyn-output-clause operation slot))
       (= field (wyn-output-field operation slot)) (CollectiveLaneUse operation clause (ValueNameRef source)) (= (wyn-contribution operation clause field) (ValueNameRef source))
       (CollectedClause operation clause))
      ((set (CollectionElement value) source)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= rank (CollectionRank value))
       (ResultOrigin (ValueNameRef value) operation slot) (= clause (wyn-output-clause operation slot))
       (= field (wyn-output-field operation slot)) (CompactedClause operation clause)
       (CollectiveLaneUse operation clause (ValueNameRef source)) (= (wyn-contribution operation clause field) (ValueNameRef source)))
      ((set (CollectionElement value) source)) :ruleset graph-sizes)
(rule ((= revision (ShapeRevision)) (= rank (CollectionRank value))
       (ResultOrigin (ValueNameRef value) operation slot) (= clause (wyn-output-clause operation slot))
       (= field (wyn-output-field operation slot)) (ReducerBody operation clause reducer)
       (ReducerPreservesOuterLength reducer field)
       (FoldSeedUse operation (ValueNameRef source)) (= (wyn-fold-seed operation clause field) (ValueNameRef source)))
      ((set (CollectionElement value) source)) :ruleset graph-sizes)

(rule ((LoopValueCarry loop slot carry initial next) (= (CollectionRank initial) 1)
       (= row (CollectionElement initial)) (ArrayValue row)
       (ResultOrigin (ValueNameRef initial) operation output) (= lane (wyn-control-region operation 0))
       (RegionCapture lane (ValueNameRef row)))
      ((LoopCapturedRow initial row)) :ruleset graph-sizes)
; Both sides of a loop that reads the row width carry a ranked descriptor.
(rule ((LoopValueCarry loop slot carry initial next) (LengthOperation length 1)
       (DirectOperationUse length (ValueNameRef carry)) (= (wyn-input length 0) (ValueNameRef carry)))
      ((LoopReadsRowWidth next)) :ruleset graph-sizes)
(rule ((LoopValueCarry loop slot carry initial next) (LoopReadsRowWidth next) (= width (CollectionExtent next 1)))
      ((RankedLoopCollection initial) (RankedLoopCollection next)) :ruleset graph-sizes)
(rule ((RankedLoopCollection initial) (LoopCapturedRow initial row))
      ((set (LoopInitialRow initial) row)) :ruleset graph-sizes)

; Indexing a collection of equally sized rows preserves that proven row length.
(rule ((= revision (ShapeRevision)) (IndexOperation operation) (= (wyn-input-count operation) 2)
       (DirectOperationUse operation (ValueNameRef source)) (= (wyn-input operation 0) (ValueNameRef source)) (= (CollectionRank source) 1)
       (= element (CollectionElement source)) (= count (LogicalOuterCount element)) (= size (StaticIndex count))
       (ResultOrigin (ValueNameRef result) operation 0))
      ((set (LogicalOuterCount result) (IndexConstant size))) :ruleset graph-sizes)

; A loop carries rectangular rows if the initial rows are rectangular and the
; next width depends only on values outside the map and on the carried width.
(relation RectangularRows (ValueName))
(relation RowWidthLoop (OperationKey ValueName IndexExp))
(relation RowWidthLength (OperationKey ValueName OperationKey Name))
(relation RowWidthPreparation (OperationKey))
(relation RowWidthInput (OperationKey ValueName Name))
(function RowWidthInputReady (OperationKey ValueName Name) bool :merge (or old new))
(function RowWidthLegal (OperationKey ValueName) bool :merge (and old new))
(relation LiftUniformRowLength (OperationKey OperationKey Name))
(rule ((= revision (TransformRevision)) (LoopValueCarry loop slot carry initial next) (= width (CollectionExtent initial 1)))
      ((RectangularRows initial)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (LoopCapturedRow array row))
      ((RectangularRows array)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (LoopValueCarry loop slot carry initial next) (RectangularRows initial) (= (GeneratedDispatches) true)
       (DistributionPair outer inner) (ResultOrigin (ValueNameRef next) outer 0) (= (wyn-output-count outer) 1)
       (DistributionReturnPrefix outer inner 1) (= (wyn-result-count inner) 1) (CollectedClause inner 0)
       (CollectiveLaneUse inner 0 (ValueNameRef element)) (= (wyn-contribution inner 0 0) (ValueNameRef element)) (= (ValueType element) (ScalarInfo scalar))
       (= domain (wyn-iteration-domain inner)) (= (wyn-domain-rank domain) 1) (= width (wyn-domain-extent domain 0)))
      ((RowWidthLoop outer carry width) (set (RowWidthLegal outer carry) true)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (RowWidthLoop outer carry width) (TransformRequirement outer name))
      ((RowWidthInput outer carry name)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthLoop outer carry width) (= lane (wyn-control-region outer 0)) (= lane (wyn-region-of length))
       (LengthOperation length 0) (DirectOperationUse length row) (= (wyn-input length 0) row) (ResultOrigin output length 0)
       (ResultOrigin row index 0) (TotalIndex index) (= (wyn-input-count index) 2)
       (DirectOperationUse index (ValueNameRef carry)) (= (wyn-input index 0) (ValueNameRef carry)))
      ((RowWidthLength outer carry length output)) :ruleset distribution-index)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name) (ResultOrigin name operation slot) (= payload (ScalarPayload operation)))
      ((RowWidthPreparation operation)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name) (ResultOrigin name operation slot) (IndexCalculationOperation operation))
      ((RowWidthPreparation operation)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name) (ResultOrigin name operation slot) (ConstantOperation operation))
      ((RowWidthPreparation operation)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name))
      ((set (RowWidthInputReady outer carry name) false)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name) (RowWidthLength outer carry length name))
      ((set (RowWidthInputReady outer carry name) true)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name) (ResultOrigin name operation slot)
       (= lane (wyn-control-region outer 0)) (= lane (wyn-region-of operation)) (RowWidthPreparation operation)
       (= (PureOperation operation) true) (= (MovableOperation operation) true))
      ((set (RowWidthInputReady outer carry name) true)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (RowWidthInput outer carry name) (ResultOrigin name operation slot)
       (= lane (wyn-control-region outer 0)) (= lane (wyn-region-of operation)) (RowWidthPreparation operation)
       (OperationUse operation input))
      ((RowWidthInput outer carry input)) :ruleset transform-availability)
(rule ((= revision (TransformRevision)) (= (RowWidthInputReady outer carry name) false))
      ((set (RowWidthLegal outer carry) false)) :ruleset row-width-legality)
(rule ((= revision (TransformRevision)) (RowWidthLoop outer carry width) (DistributionPrefixOperation outer inner operation) (OperationsConflict operation inner))
      ((set (RowWidthLegal outer carry) false)) :ruleset row-width-legality)
(rule ((= revision (TransformRevision)) (= (RowWidthLegal outer carry) true) (RowWidthLength outer carry length name) (RowWidthInput outer carry name)
       (DistributionPrefixComplete outer inner))
      ((LiftUniformRowLength length outer (ValueNameRef carry))) :ruleset row-width-select)

(relation LoopFieldType (OperationKey i64 LogicalPath LogicalType))
(function LoopFieldBytes (OperationKey i64 LogicalPath) BigInt :no-merge)
(function LoopProductBytes (OperationKey i64 LogicalPath i64) BigInt :no-merge)

; A fixed carried length gives a dynamic array type a local storage size.
(rule ((= revision (AnalysisRevision)) (CountedLoopOperation loop))
      ((set (LoopStateBytes loop 0) (bigint 0))) :ruleset graph-loop-layout)
(rule ((= revision (AnalysisRevision)) (WhileLoopOperation loop))
      ((set (LoopStateBytes loop 0) (bigint 0))) :ruleset graph-loop-layout)
(rule ((= bytes (LoopStateBytes loop slot)) (< slot (wyn-output-count loop)) (LoopValueCarry loop slot carried initial next)
       (= (ValueType carried) (ScalarInfo element)))
      ((set (LoopStateBytes loop (+ slot 1)) bytes)) :ruleset graph-loop-layout)
(rule ((= bytes (LoopStateBytes loop slot)) (< slot (wyn-output-count loop)) (LoopValueCarry loop slot carried initial next)
       (= (ValueType carried) (LogicalValue type)))
      ((LoopFieldType loop slot (RootPath) type)) :ruleset graph-loop-layout)
(rule ((LoopFieldType loop slot path type) (= size (LogicalBytes type)))
      ((set (LoopFieldBytes loop slot path) size)) :ruleset graph-loop-layout)
(rule ((LoopFieldType loop slot path (ArrayType ownership extents element))
       (= (vec-length extents) 1) (= (vec-get extents 0) (UnspecifiedExtent))
       (LoopArrayComponent loop slot path array initial) (LoopPreservesComponentLength loop slot path)
       (= n (StaticIndex (LogicalOuterCount initial))) (= size (LogicalBytes element)))
      ((set (LoopFieldBytes loop slot path) (* (bigint (max n 0)) size))) :ruleset graph-loop-layout)
(rule ((LoopFieldType loop slot path (ProductType fields)))
      ((set (LoopProductBytes loop slot path 0) (bigint 0))) :ruleset graph-loop-layout)
(rule ((LoopFieldType loop slot path (ProductType fields)) (= prefix (LoopProductBytes loop slot path i))
       (< i (vec-length fields)))
      ((LoopFieldType loop slot (FieldPath path i) (vec-get fields i))) :ruleset graph-loop-layout)
(rule ((LoopFieldType loop slot path (ProductType fields)) (= prefix (LoopProductBytes loop slot path i))
       (< i (vec-length fields)) (= next (LoopFieldBytes loop slot (FieldPath path i))))
      ((set (LoopProductBytes loop slot path (+ i 1)) (+ prefix next))) :ruleset graph-loop-layout)
(rule ((LoopFieldType loop slot path (ProductType fields)) (= size (LoopProductBytes loop slot path (vec-length fields))))
      ((set (LoopFieldBytes loop slot path) size)) :ruleset graph-loop-layout)
(rule ((= bytes (LoopStateBytes loop slot)) (= next (LoopFieldBytes loop slot (RootPath)))
       (<= (+ bytes next) (bigint 16384)))
      ((set (LoopStateBytes loop (+ slot 1)) (+ bytes next))) :ruleset graph-loop-layout)
