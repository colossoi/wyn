; Total pointwise maps may precede packing; reductions mask their callbacks.
(ruleset compact-index)
(ruleset compact-legality)
(ruleset compact-select)
(relation CompactPath (OperationKey OperationKey))
(relation CompactPair (OperationKey OperationKey i64))
(function CompactSafe (OperationKey OperationKey) bool :merge (and old new))
(relation CompactMaskPrefix (OperationKey OperationKey i64))
(relation CompactCandidate (OperationKey OperationKey i64))
(rule ((= revision (AnalysisRevision)) (NextOperation first next) (ParallelOperation first)
       (= (ResultKindOf first clause) (Compacted)))
      ((CompactPath first next)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPath first middle) (DiscardableOperation middle)
       (RepeatableOperation middle) (= (PureOperation middle) true) (NextOperation middle next))
      ((CompactPath first next)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPath first second) (ParallelOperation second)
       (= execution (OperationExecution first)) (= execution (OperationExecution second))
       (= (Output first output) (ValueNameRef array)) (= (OutputClause first output) clause)
       (= (ResultKindOf first clause) (Compacted)) (= domain (OperationDomain second)) (= (DomainRank domain) 1)
       (= (DomainRank (OperationDomain first)) 1) (CountLength (DomainExtent domain 0) array) (= (ResultCount second) 1))
      ((CompactPair first second clause) (PointwisePair first second)
       (set (CompactSafe first second) true) (set (PointwiseLegal first second) true)
       (CompactMaskPrefix first second 0)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= (OutputClause first output) clause))
      ((PointwiseSource first second output)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= body (ControlRegion second 0))
       (RegionCapture body name) (Defines name (OperationSite producer slot)) (!= producer first))
      ((TransformRequirement first name)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (OperationCertificate second name))
      ((TransformRequirement first (ValueNameRef name))) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= reducer (ResultReducer second 0)) (RegionCapture reducer name))
      ((TransformRequirement first name)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= name (ResultNeutral second 0 slot)))
      ((TransformRequirement first name)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (OperationRead first resource) (OperationWrite second resource))
      ((set (CompactSafe first second) false)) :ruleset compact-legality)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (OperationWrite first resource) (OperationRead second resource))
      ((set (CompactSafe first second) false)) :ruleset compact-legality)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (OperationWrite first resource) (OperationWrite second resource))
      ((set (CompactSafe first second) false)) :ruleset compact-legality)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= (TransformAvailable first name) false))
      ((set (CompactSafe first second) false)) :ruleset compact-legality)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (EpilogueRequiresCompletedTotal first second))
      ((set (CompactSafe first second) false)) :ruleset compact-legality)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= body (ControlRegion second 0))
       (FlowScopeAncestor body child) (= child (OperationRegion user)) (DirectOperationUse user (ValueNameRef index))
       (= domain (OperationDomain second)) (= index (DomainOrdinal domain)))
      ((set (PointwiseHandledUse first second user (ValueNameRef index)) false)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= body (ControlRegion second 0))
       (FlowScopeAncestor body child) (= child (OperationRegion user)) (DirectOperationUse user (ValueNameRef index))
       (= domain (OperationDomain second)) (= index (DomainAxis domain 0)))
      ((set (PointwiseHandledUse first second user (ValueNameRef index)) false)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= body (ControlRegion second 0))
       (= domain (OperationDomain second)) (EndDemand body (ValueNameRef index)) (= index (DomainAxis domain 0)))
      ((set (CompactSafe first second) false)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= body (ControlRegion second 0))
       (= domain (OperationDomain second)) (EndDemand body (ValueNameRef index)) (= index (DomainOrdinal domain)))
      ((set (CompactSafe first second) false)) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (CompactMaskPrefix first second slot)
       (< slot (ResultNeutralCount second 0)) (= reducer (ResultReducer second 0))
       (= (RegionParameter reducer slot) (ValueNameRef state)) (= (ValueType state) (ScalarInfo element))
       (= bytes (ElementBytes element)) (> bytes (bigint 0))
       (= (ResultValue second 0 slot) (ValueNameRef contribution)) (= (ValueType contribution) (ScalarInfo element)))
      ((CompactMaskPrefix first second (+ slot 1))) :ruleset compact-index)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= (CompactSafe first second) true)
       (= (PointwiseLegal first second) true) (PointwiseLoad first second load)
       (= (ResultKindOf second 0) (Collected)) (= body (ControlRegion second 0)) (PointwiseSafeRegion first second body))
      ((CompactCandidate first second clause)) :ruleset compact-select)
(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= (CompactSafe first second) true)
       (= (PointwiseLegal first second) true) (PointwiseLoad first second load)
       (= (ResultKindOf second 0) (Folded kind)) (= count (ResultNeutralCount second 0))
       (= count (ResultValueCount second 0)) (CompactMaskPrefix first second count))
      ((CompactCandidate first second clause)) :ruleset compact-select)

(rule ((= revision (AnalysisRevision)) (CompactPair first second clause) (= (CompactSafe first second) true)
       (= (PointwiseLegal first second) true) (PointwiseLoad first second load)
       (= (ResultKindOf second 0) (Contributed)))
      ((CompactCandidate first second clause)) :ruleset compact-select)
