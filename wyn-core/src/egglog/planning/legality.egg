; Eligibility proofs are complete before physical preparation reads them.
(ruleset physical-legality)
(relation SelectPrimitive (PrimType))
(SelectPrimitive (Bool)) (SelectPrimitive (I32)) (SelectPrimitive (U32))
(SelectPrimitive (F16)) (SelectPrimitive (F32))
(relation SelectElement (ElementType))
(rule ((SelectPrimitive primitive)) ((SelectElement (ScalarElement primitive))) :ruleset physical-legality)
(rule ((= element (VectorElement primitive width)) (SelectPrimitive primitive) (>= width 2) (<= width 4))
      ((SelectElement element)) :ruleset physical-legality)
(relation SelectOutputPrefix (OperationKey i64))
(relation CanSpeculate (OperationKey))
(rule ((LiveOperation operation) (BranchOperation operation))
      ((SelectOutputPrefix operation 0)) :ruleset physical-legality)
(rule ((SelectOutputPrefix operation slot) (ResultOrigin (ValueNameRef value) operation slot)
       (= (ValueType value) (ScalarInfo element)) (SelectElement element))
      ((SelectOutputPrefix operation (+ slot 1))) :ruleset physical-legality)
(rule ((SelectOutputPrefix operation slot) (ResultOrigin (ValueNameRef value) operation slot)
       (= (ValueType value) (LogicalValue (ElementValue element))) (SelectElement element))
      ((SelectOutputPrefix operation (+ slot 1))) :ruleset physical-legality)
(rule ((SelectOutputPrefix operation slot) (ResultOrigin (AccNameRef token) operation slot))
      ((SelectOutputPrefix operation (+ slot 1))) :ruleset physical-legality)
(rule ((SelectOutputPrefix operation (wyn-output-count operation)) (= (PureOperation operation) true)
       (BranchArm slot) (= arm (wyn-control-region operation slot)))
      ((RegionWorkDemand arm)) :ruleset physical-legality)
(rule ((SelectOutputPrefix operation (wyn-output-count operation)) (= (PureOperation operation) true)
       (= yes (wyn-control-region operation 0)) (= no (wyn-control-region operation 1))
       (= a (RegionWork yes)) (= b (RegionWork no)) (>= a (bigint 0)) (>= b (bigint 0))
       (<= a (bigint 4)) (<= b (bigint 4)))
      ((CanSpeculate operation)) :ruleset physical-legality)

; Reads are permitted, but retries and chunking must not repeat writes or traps.
(function RetrySafe (RegionKey) bool :merge (and old new))
(rule ((LiveRegion region)) ((set (RetrySafe region) true)) :ruleset physical-legality)
(rule ((RegionWrite region resource)) ((set (RetrySafe region) false)) :ruleset physical-legality)
(rule ((RegionTrap region)) ((set (RetrySafe region) false)) :ruleset physical-legality)

(relation AtomicElement (LogicalType))
(AtomicElement (ElementValue (ScalarElement (I32)))) (AtomicElement (ElementValue (ScalarElement (U32))))
(relation AtomicAccumulatorArray (OperationKey i64 ValueName))
(rule ((= (AccumulatorArrayCount owner group) 1) (= array (AccumulatorArray owner group 0)) (FreshArray array)
       (= (ValueType array) (LogicalValue (ArrayType ownership extents element))) (AtomicElement element))
      ((AtomicAccumulatorArray owner group array)) :ruleset physical-legality)

(function LoopComponentPreserved (OperationKey i64 LogicalPath) bool :merge (or old new))
(relation LoopHasArrayComponents (OperationKey i64))
(rule ((LoopArrayComponent operation slot path array first))
      ((set (LoopComponentPreserved operation slot path) false) (LoopHasArrayComponents operation slot)) :ruleset physical-legality)
(rule ((LoopPreservesComponentLength operation slot path))
      ((set (LoopComponentPreserved operation slot path) true)) :ruleset physical-legality)
