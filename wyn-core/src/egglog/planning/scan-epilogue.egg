; A pointwise consumer can share the final prefix dispatch, but not its reduction.
; These facts select an execution group; they never rewrite a scan as an ordinary map.
(ruleset epilogue-analysis)
(ruleset epilogue-reads)
(ruleset epilogue-select)
(relation EpiloguePair (Program Function Stm Stm ParallelBody))
(function EpilogueReads (Stm ParallelBody) StatementEdits :merge (set-union old new))
(relation EpilogueClause (ParallelResult Results))
(relation EpilogueClauses (ParallelResults i64))
(relation ScanEpilogue (Function Stm Stm))
(rule ((= body (ParallelBlock statements clauses))) ((EpilogueClauses clauses 0)) :ruleset epilogue-analysis)
(rule ((EpilogueClauses clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Collect values)))
      ((EpilogueClauses clauses (+ i 1))) :ruleset epilogue-analysis)
(rule ((EpilogueClauses clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind reducer values)))
      ((EpilogueClauses clauses (+ i 1))) :ruleset epilogue-analysis)
(rule ((= clause (Collect values))) ((EpilogueClause clause values)) :ruleset epilogue-analysis)
(rule ((= clause (Fold kind reducer values)) (FoldSlots kind 1 total))
      ((EpilogueClause clause values)) :ruleset epilogue-analysis)
(rule ((RenamedPair program function first second body)
       (= first (Let id pattern certs (Parallel execution (IterationSpace flat axes) (ParallelBlock statements clauses))))
       (= (vec-size axes) 1)
       (= second (Let sid output proofs (Parallel execution domain original)))
       (EpilogueClauses clauses (vec-size clauses))
       (= body (ParallelBlock consumer indexed_vector_0))
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Fold kind reducer contributions))
       (FoldSlots kind 1 total)
       (= (vec-size indexed_vector_0) 1)
       (= (ParallelResultsAt indexed_vector_0 0) (Collect values)))
      ((EpiloguePair program function first second body)
       (set (EpilogueReads first body) (set-empty))) :ruleset epilogue-analysis)
(rule ((EpiloguePair program function first second body)
       (= first (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses i))
       (< i (vec-size clauses))
       (EpilogueClause (ParallelResultsAt clauses i) values)
       (WalkResults values j)
       (< j (vec-size values))
       (= (PatternAt pattern (+ offset j)) (BindValue array info))
       (= (ResultsAt values j) (Yield proofs value))
       (= indices (DomainIndices domain))
       (ContainsStm (ParallelRoot body) (Let load output checks (Index array atoms))))
      ((MatchingIndices atoms indices 0)) :ruleset epilogue-reads)
(rule ((EpiloguePair program function first second body)
       (= first (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= offset (ClauseOffset clauses i))
       (< i (vec-size clauses))
       (EpilogueClause (ParallelResultsAt clauses i) values)
       (WalkResults values j)
       (< j (vec-size values))
       (= (PatternAt pattern (+ offset j)) (BindValue array info))
       (= (ResultsAt values j) (Yield proofs value))
       (= indices (DomainIndices domain))
       (ContainsStm (ParallelRoot body) (Let load output checks (Index array atoms)))
       (= (vec-size atoms) (vec-size indices))
       (MatchingIndices atoms indices (vec-size atoms)))
      ((set (EpilogueReads first body) (set-of (ReplaceStatement load (Let load output checks (Use value)))))) :ruleset epilogue-reads)
(rule ((EpiloguePair program function first second body) (= edits (EpilogueReads first body)))
      ((ReplacementMapDemand edits)) :ruleset epilogue-reads)
(rule ((EpiloguePair program function first second body) (= edits (EpilogueReads first body))
       (= map (ReplacementMap edits)))
      ((RenameParallelBodyDemand (Rename (map-empty) (map-empty) (map-empty) (map-empty) map) body)) :ruleset epilogue-reads)
(rule ((EpiloguePair program function first second body)
       (= first (Let id pattern certs (Parallel execution domain producer)))
       (= second (Let sid output proofs (Parallel execution other original)))
       (= edits (EpilogueReads first body)) (= map (ReplacementMap edits))
       (= checked (RenameParallelBody (Rename (map-empty) (map-empty) (map-empty) (map-empty) map) body)))
      ((EffectsStmDemand function (Let sid output proofs (Parallel execution domain checked)))) :ruleset epilogue-reads)
(rule ((EpiloguePair program function first second body)
       (= first (Let id pattern certs (Parallel execution domain producer)))
       (= second (Let sid output proofs (Parallel execution other original)))
       (= edits (EpilogueReads first body)) (> (set-size edits) 0) (= map (ReplacementMap edits))
       (= checked (RenameParallelBody (Rename (map-empty) (map-empty) (map-empty) (map-empty) map) body))
       (= free (set-union (set-diff (NamesParallelBody checked) (BindersParallelBody checked))
                         (set-union (NamesPattern output) (NamesCertificates proofs))))
       (= (set-intersect free (BindersPattern pattern)) (set-empty))
       (= (EffectsStm function (Let sid output proofs (Parallel execution domain checked))) (set-empty)))
      ((ScanEpilogue function first second)) :ruleset epilogue-select)
