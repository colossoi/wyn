; Facts describe sizes and work; missing bounds cannot justify local storage.
(ruleset graph-sizes)
(ruleset graph-work)
(ruleset type-sizes)
(ruleset reducer-state)
(ruleset graph-loop-select)
(ruleset graph-loop-layout)
(ruleset graph-placement)
(ruleset entry-invocations)
(ruleset graph-placement-select)
(ruleset graph-host)
(function StaticIndex (IndexExp) i64 :no-merge)
; Exact type, producer, and preserved-source proofs may name the same length
; differently. Retain a witness without equating their mutable source values.
(function LogicalOuterCount (ValueName) IndexExp :merge old)
(function OuterCapacity (ValueName) i64 :merge (min old new))
(relation OuterShapeSource (ValueName ValueName))
(relation LoopPreservesOuterLength (OperationKey i64))
(relation ReducerPreservesOuterLength (RegionKey i64))
(relation FreshArray (ValueName))
(function LocalLoop (OperationKey) bool :merge (or old new))
(function LoopStateBytes (OperationKey i64) BigInt :no-merge)
(relation RegionWorkDemand (RegionKey))
(function RegionWorkPrefix (RegionKey OperationKey) BigInt :no-merge)
(function RegionWork (RegionKey) BigInt :no-merge)
(function DomainWork (Domain i64) BigInt :no-merge)
(function LaneDependentFunction (FunctionName) bool :merge (or old new))
(function HostRegion (RegionKey) bool :merge (or old new))
(relation KernelPreparationCandidate (OperationKey))
(function KernelPreparation (OperationKey) bool :merge (or old new))
(function SelectedExecution (OperationKey) Execution :no-merge)
(relation ScanEpilogue (OperationKey OperationKey))
(function NativeBinaryReducer (RegionKey) InstructionPayload :no-merge)
(relation NativeAddition (RegionKey))
(relation ReducerState (OperationKey i64 i64 RegionKey Name Name))
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (ParallelOperation operation)
       (= reducer (ResultReducer operation clause)) (= neutral (ResultNeutral operation clause slot))
       (< slot (ResultNeutralCount operation clause)) (= parameter (RegionParameter reducer slot)))
      ((ReducerState operation clause slot reducer neutral parameter)) :ruleset reducer-state)
(relation RequiresSnapshot (OperationKey))
(relation CanReuse (ValueName ValueName))
(relation ForwardLength (OperationKey IndexExp))
(rule ((= revision (AnalysisRevision)) (= index (IndexConstant n))) ((set (StaticIndex index) n)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexValue value)) (= n (ConstantValue (ValueNameRef value)))
       (= primitive (ValuePrimitive (ValueNameRef value))) (IntegerScalar primitive))
      ((set (StaticIndex index) n)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexCalculationOperation operation) (= index (OperationIndex operation 0))
       (= n (StaticIndex index)) (= (Output operation 0) (ValueNameRef value)))
      ((set (StaticIndex (IndexValue value)) n)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (ValueType value) (LogicalValue (ArrayType ownership extents element)))
       (> (vec-length extents) 0) (= (vec-get extents 0) (FixedExtent n)))
      ((set (LogicalOuterCount value) (IndexConstant n)) (set (OuterCapacity value) (max 0 n))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (ValueType value) (LogicalValue (ArrayType ownership extents element))))
      ((OuterShapeSource value value)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (SourceAlias (FlowNamed value)) (FlowNamed source)))
      ((OuterShapeSource value source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (PreservesInputShape operation output input) (= (Output operation output) (ValueNameRef result))
       (= (Input operation input) (ValueNameRef source)))
      ((OuterShapeSource result source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (OuterShapeSource result middle) (OuterShapeSource middle source))
      ((OuterShapeSource result source)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (OuterShapeSource result source) (!= result source) (= count (LogicalOuterCount source)))
      ((set (LogicalOuterCount result) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (OuterShapeSource result source) (!= result source) (= count (OuterCapacity source)))
      ((set (OuterCapacity result) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (FreshOutput operation slot) (= (Output operation slot) (ValueNameRef value)))
      ((FreshArray value)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= (Output operation slot) (ValueNameRef value))
       (= (OutputRole operation slot) (CollectedOutput)) (= domain (OperationDomain operation))
       (= count (DomainExtent domain 0)))
      ((FreshArray value) (set (LogicalOuterCount value) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= (Output operation slot) (ValueNameRef value))
       (= (OutputRole operation slot) (PrefixOutput)) (= domain (OperationDomain operation))
       (= count (DomainExtent domain 0)))
      ((FreshArray value) (set (LogicalOuterCount value) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= count (LogicalOuterCount value)) (= n (StaticIndex count)))
      ((set (OuterCapacity value) (max 0 n))) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LengthOperation operation 0) (= (Input operation 0) (ValueNameRef source))
       (= count (LogicalOuterCount source)))
      ((ForwardLength operation count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= region (ControlRegion operation 0)) (= (EdgeArgument operation 0 slot) (ValueNameRef initial))
       (= (RegionParameter region slot) (ValueNameRef parameter)) (= (RegionYield region slot) (ValueNameRef backedge))
       (OuterShapeSource backedge parameter))
      ((LoopPreservesOuterLength operation slot)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (LoopPreservesOuterLength operation slot) (= region (ControlRegion operation 0))
       (= (EdgeArgument operation 0 slot) (ValueNameRef initial)) (= count (LogicalOuterCount initial))
       (= (RegionParameter region slot) (ValueNameRef parameter)) (= (Output operation slot) (ValueNameRef output)))
      ((set (LogicalOuterCount parameter) count) (set (LogicalOuterCount output) count)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (RegionParameter region slot) (ValueNameRef parameter)) (= (RegionYield region slot) (ValueNameRef result))
       (OuterShapeSource result parameter))
      ((ReducerPreservesOuterLength region slot)) :ruleset graph-sizes)
(relation BinaryReducer (RegionKey InstructionPayload))
; A native combiner is a single binary occurrence over its two formal operands.
(rule ((= revision (AnalysisRevision)) (= (RegionParameterCount region) 2) (= (RegionYieldCount region) 1)
       (FirstOperation region operation) (LastOperation region operation) (= (InputCount operation) 2) (= (OutputCount operation) 1)
       (= payload (ScalarPayload operation)) (= (RegionParameter region 0) a) (= (RegionParameter region 1) b)
       (= (Input operation 0) a) (= (Input operation 1) b) (= (Output operation 0) output) (= (RegionYield region 0) output))
      ((BinaryReducer region payload)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= (RegionParameterCount region) 2) (= (RegionYieldCount region) 1)
       (FirstOperation region operation) (LastOperation region operation) (= (InputCount operation) 2) (= (OutputCount operation) 1)
       (= payload (ScalarPayload operation)) (= (RegionParameter region 1) a) (= (RegionParameter region 0) b)
       (= (Input operation 0) a) (= (Input operation 1) b) (= (Output operation 0) output) (= (RegionYield region 0) output))
      ((BinaryReducer region payload)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (BinaryReducer region payload) (NativeIntegerOpcode payload)
       (= (RegionParameter region 0) (ValueNameRef name)) (= (ValueType name) (ScalarInfo (ScalarElement (I32)))))
      ((set (NativeBinaryReducer region) payload)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (BinaryReducer region payload) (NativeIntegerOpcode payload)
       (= (RegionParameter region 0) (ValueNameRef name)) (= (ValueType name) (ScalarInfo (ScalarElement (U32)))))
      ((set (NativeBinaryReducer region) payload)) :ruleset graph-sizes)
(rule ((RegionWorkDemand region) (= region (OperationRegion operation)) (Operation operation))
      ((OperationWorkDemand operation)) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (BranchOperation operation) (= body (ControlRegion operation slot)))
      ((RegionWorkDemand body)) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (CountedLoopOperation operation) (= n (StaticIndex (LoopCount operation)))
       (= body (ControlRegion operation 0)))
      ((RegionWorkDemand body)) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (ParallelOperation operation) (= domain (OperationDomain operation))
       (= n (DomainWork domain (DomainRank domain))) (= body (ControlRegion operation 0)))
      ((RegionWorkDemand body)) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (CallOperation operation) (= target (CallTarget operation))
       (= (RecursiveFunction target) false) (= root (FunctionRoot target)))
      ((RegionWorkDemand root)) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (CallOperation operation) (= target (CallTarget operation))
       (= (RecursiveFunction target) false) (= root (FunctionRoot target)) (= work (RegionWork root)))
      ((set (OperationWork operation) (+ (bigint 1) work))) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (= work (InstructionWork operation)))
      ((set (OperationWork operation) (bigint work))) :ruleset graph-work)
(rule ((RegionWorkDemand region) (EmptyRegion region)) ((set (RegionWork region) (bigint 0))) :ruleset graph-work)
(rule ((RegionWorkDemand region) (FirstOperation region operation)) ((set (RegionWorkPrefix region operation) (bigint 0))) :ruleset graph-work)
(rule ((= prefix (RegionWorkPrefix region operation)) (= work (OperationWork operation)) (NextOperation operation next))
      ((set (RegionWorkPrefix region next) (+ prefix work))) :ruleset graph-work)
(rule ((LastOperation region operation) (= prefix (RegionWorkPrefix region operation)) (= work (OperationWork operation)))
      ((set (RegionWork region) (+ prefix work))) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (BranchOperation operation) (= yes (ControlRegion operation 0)) (= no (ControlRegion operation 1))
       (= a (RegionWork yes)) (= b (RegionWork no)))
      ((set (OperationWork operation) (+ (bigint 1) (max a b)))) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (CountedLoopOperation operation) (= body (ControlRegion operation 0)) (= n (StaticIndex (LoopCount operation)))
       (= work (RegionWork body)))
      ((set (OperationWork operation) (* (bigint (max 0 n)) work))) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (ParallelOperation operation) (= domain (OperationDomain operation)))
      ((set (DomainWork domain 0) (bigint 1))) :ruleset graph-work)
(rule ((= prefix (DomainWork domain slot)) (< slot (DomainRank domain)) (= n (StaticIndex (DomainExtent domain slot))))
      ((set (DomainWork domain (+ slot 1)) (* prefix (bigint (max 0 n))))) :ruleset graph-work)
(rule ((OperationWorkDemand operation) (ParallelOperation operation) (= domain (OperationDomain operation)) (= n (DomainWork domain (DomainRank domain)))
       (= region (ControlRegion operation 0)) (= work (RegionWork region)))
      ((set (OperationWork operation) (* n (+ (bigint 1) work)))) :ruleset graph-work)
(function LogicalBytes (LogicalType) BigInt :no-merge)
(function ExtentProduct (Extents i64) BigInt :no-merge)
(function ProductBytes (LogicalTypes i64) BigInt :no-merge)
(function ElementBytes (ElementType) BigInt :no-merge)
(function PrimitiveBytes (PrimType) BigInt :no-merge)
(function ElementProductBytes (ElementTypes i64) BigInt :no-merge)
(set (PrimitiveBytes (I8)) (bigint 1))
(set (PrimitiveBytes (U8)) (bigint 1))
(set (PrimitiveBytes (I16)) (bigint 2))
(set (PrimitiveBytes (U16)) (bigint 2))
(set (PrimitiveBytes (F16)) (bigint 2))
(set (PrimitiveBytes (I32)) (bigint 4))
(set (PrimitiveBytes (U32)) (bigint 4))
(set (PrimitiveBytes (F32)) (bigint 4))
(set (PrimitiveBytes (Bool)) (bigint 4))
(set (PrimitiveBytes (I64)) (bigint 8))
(set (PrimitiveBytes (U64)) (bigint 8))
(set (PrimitiveBytes (F64)) (bigint 8))
(set (PrimitiveBytes (UnitType)) (bigint 0))
; These sizes are cost estimates on logical types, not selected layouts or allocations.
(rule ((= type (ScalarElement primitive)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementBytes type) bytes)) :ruleset type-sizes)
(rule ((= type (VectorElement primitive lanes)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementBytes type) (* bytes (bigint lanes)))) :ruleset type-sizes)
(rule ((= type (MatrixElement primitive rows columns)) (= bytes (PrimitiveBytes primitive)))
      ((set (ElementBytes type) (* bytes (bigint (* rows columns))))) :ruleset type-sizes)
(rule ((= type (ProductElement fields))) ((set (ElementProductBytes fields 0) (bigint 0))) :ruleset type-sizes)
(rule ((= prefix (ElementProductBytes fields i))
       (< i (vec-length fields))
       (= bytes (ElementBytes (vec-get fields i))))
      ((set (ElementProductBytes fields (+ i 1)) (+ prefix bytes))) :ruleset type-sizes)
(rule ((= type (ProductElement fields)) (= bytes (ElementProductBytes fields (vec-length fields))))
      ((set (ElementBytes type) bytes)) :ruleset type-sizes)
(rule ((= type (ElementValue element)) (= bytes (ElementBytes element)))
      ((set (LogicalBytes type) bytes)) :ruleset type-sizes)
(rule ((= type (ArrayType ownership extents element))) ((set (ExtentProduct extents 0) (bigint 1))) :ruleset type-sizes)
(rule ((= prefix (ExtentProduct extents i))
       (< i (vec-length extents))
       (= (vec-get extents i) (FixedExtent n)))
      ((set (ExtentProduct extents (+ i 1)) (* prefix (bigint (max 0 n))))) :ruleset type-sizes)
(rule ((= type (ArrayType ownership extents element)) (= n (ExtentProduct extents (vec-length extents)))
       (= bytes (LogicalBytes element))) ((set (LogicalBytes type) (* n bytes))) :ruleset type-sizes)
(rule ((= type (ProductType fields))) ((set (ProductBytes fields 0) (bigint 0))) :ruleset type-sizes)
(rule ((= prefix (ProductBytes fields i))
       (< i (vec-length fields))
       (= bytes (LogicalBytes (vec-get fields i))))
      ((set (ProductBytes fields (+ i 1)) (+ prefix bytes))) :ruleset type-sizes)
(rule ((= type (ProductType fields)) (= bytes (ProductBytes fields (vec-length fields))))
      ((set (LogicalBytes type) bytes)) :ruleset type-sizes)

(rule ((= revision (AnalysisRevision)) (Function function)) ((set (LaneDependentFunction function) false)) :ruleset entry-invocations)
(rule ((= revision (AnalysisRevision)) (Function function) (= root (FunctionRoot function)) (FlowScopeAncestor root region)
       (= region (OperationRegion operation)) (LaneDependentOperation operation))
      ((set (LaneDependentFunction function) true)) :ruleset entry-invocations)
(rule ((= revision (AnalysisRevision)) (Function function) (= root (FunctionRoot function)) (FlowScopeAncestor root region)
       (= region (OperationRegion operation)) (= target (CallTarget operation)) (= (LaneDependentFunction target) true))
      ((set (LaneDependentFunction function) true)) :ruleset entry-invocations)
(rule ((= revision (AnalysisRevision)) (= order (EntryOrder function)) (= root (FunctionRoot function)) (= (GeneratedDispatches) true)
       (= (InvocationEntry function) false) (= (LaneDependentFunction function) false))
      ((set (HostRegion root) true)) :ruleset graph-host)
(rule ((= revision (AnalysisRevision)) (LiveRegion region)) ((set (HostRegion region) false)) :ruleset graph-placement)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (ParallelOperation operation)) ((set (KernelPreparation operation) false)) :ruleset graph-placement)
(rule ((= revision (AnalysisRevision)) (= (HostRegion parent) true) (= parent (OperationRegion operation)) (BranchOperation operation)
       (= child (ControlRegion operation edge)))
      ((set (HostRegion child) true)) :ruleset graph-host)
(rule ((= revision (AnalysisRevision)) (= (HostRegion parent) true) (= parent (OperationRegion operation)) (AccumulatorOperation operation)
       (= child (ControlRegion operation 0)))
      ((set (HostRegion child) true)) :ruleset graph-host)
(rule ((= revision (AnalysisRevision)) (= (HostRegion parent) true) (= parent (OperationRegion operation)) (= (LocalLoop operation) false)
       (= child (ControlRegion operation 0)))
      ((set (HostRegion child) true)) :ruleset graph-host)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= region (OperationRegion operation)) (= (HostRegion region) false))
      ((set (SelectedExecution operation) (InvocationLocal))) :ruleset graph-placement-select)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= region (OperationRegion operation)) (= (HostRegion region) true)
       (FlowScopeAncestor root region) (RootFunction root function) (= grid (EntryGrid function))
       (= (KernelPreparation operation) false))
      ((set (SelectedExecution operation) (DeviceKernel grid))) :ruleset graph-placement-select)
(rule ((= revision (AnalysisRevision)) (ParallelOperation operation) (= region (OperationRegion operation)) (= (HostRegion region) true)
       (= (KernelPreparation operation) true))
      ((set (SelectedExecution operation) (InvocationLocal))) :ruleset graph-placement-select)

; Fold only arithmetic whose result agrees with the emitted i32 index operation.
(relation IndexArithmetic (IndexExp String IndexExp IndexExp))
(rule ((= revision (AnalysisRevision)) (= index (IndexAdd left right))) ((IndexArithmetic index "+" left right)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexSub left right))) ((IndexArithmetic index "-" left right)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (= index (IndexMul left right))) ((IndexArithmetic index "*" left right)) :ruleset graph-sizes)
(relation IndexArithmeticOperands (IndexExp String i64 i64))
(rule ((= revision (AnalysisRevision)) (IndexArithmetic index op left right)
       (= a (StaticIndex left)) (= b (StaticIndex right))
       (>= a -2147483648) (<= a 2147483647) (>= b -2147483648) (<= b 2147483647))
      ((IndexArithmeticOperands index op a b)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexArithmeticOperands index "+" a b) (= n (+ a b))
       (>= n -2147483648) (<= n 2147483647))
      ((set (StaticIndex index) n)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexArithmeticOperands index "-" a b) (= n (- a b))
       (>= n -2147483648) (<= n 2147483647))
      ((set (StaticIndex index) n)) :ruleset graph-sizes)
(rule ((= revision (AnalysisRevision)) (IndexArithmeticOperands index "*" a b) (= n (* a b))
       (>= n -2147483648) (<= n 2147483647))
      ((set (StaticIndex index) n)) :ruleset graph-sizes)



(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (IndexCalculationOperation operation)
       (= (OperationIndex operation 0) (IndexValue source)) (= output (Output operation 0)))
      ((ForwardCandidate output (ValueNameRef source))) :ruleset scalar-analysis)
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (IndexCalculationOperation operation)
       (= index (OperationIndex operation 0)) (= bits (StaticIndex index)))
      ((FoldedConstant operation bits)) :ruleset scalar-analysis)
