; One dispatch-loop representation, independent of control form and carry arity.
(rule ((= ty (SourceType value))) ((set (DispatchLoopValue value) false)) :ruleset type-layouts)
(rule ((= (DispatchLoopSelected op) true) (= source (SourceOperationValue op))
       (SourceLoopCarry source slot initial state next output array))
      ((set (DispatchLoopValue state) true) (set (DispatchLoopValue output) true)) :ruleset type-layouts)
(rule ((= (DispatchLoopSelected op) true) (= source (SourceOperationValue op)) (SourceLoopAggregate source value))
      ((set (DispatchLoopValue value) true)) :ruleset type-layouts)
(rule ((ForwardValue value original) (= (DispatchLoopValue original) true))
      ((set (DispatchLoopValue value) true)) :ruleset type-layouts)
(rule ((Projection value tuple index) (SourceField tuple index child) (= (DispatchLoopValue child) true))
      ((set (DispatchLoopValue value) true)) :ruleset type-layouts)
(rule ((SourceDispatchLoop source) (= source (SourceOperationValue op)))
      ((set (HostLoopCandidate op) true)) :ruleset planning-import)
(rule ((= (LoopDispatchProfitable op) false))
      ((set (InvocationBoundary op) true)) :ruleset classify)
(rule ((HostRegion parent) (= parent (OperationRegion op)) (= (LoopDispatchProfitable op) false)
       (InvocationResult value op) (= (HasViewStage value) false))
      ((InvocationValue op)) :ruleset residency)
(rule ((HostRegion parent) (= parent (OperationRegion op))
       (= (HostLoopCandidate op) true) (= (ContainsCollective op) true) (= (LoopDispatchProfitable op) true))
      ((set (DispatchLoopSelected op) true)) :ruleset host-regions)
(rule ((= (DispatchLoopSelected op) true) (HostRegion parent) (= parent (OperationRegion op))
       (= source (SourceOperationValue op)) (= (SourceLoop source) (LoopInfo header body)))
      ((HostLoop op header body)) :ruleset residency)
(rule ((HostLoop op header body) (= source (SourceOperationValue op))
       (SourceLoopCarry source slot initial state next output array))
      ((LoopCarry op slot initial state next output array)) :ruleset residency)
(rule ((HostLoop op header body) (= source (SourceOperationValue op)) (SourceLoopAggregate source value))
      ((HostLoopAggregate value)) :ruleset residency)
(rule ((= (DispatchLoopSelected op) true) (= source (SourceOperationValue op))
       (SourceLoopCarry source slot initial state next output array))
      ((set (StoredLoopState state) true)) :ruleset type-layouts)
(rule ((= (DispatchLoopSelected op) true) (= source (SourceOperationValue op)) (SourceLoopAggregate source value))
      ((set (StoredLoopState value) true)) :ruleset type-layouts)
(rule ((= (DispatchLoopSelected op) true) (= source (SourceOperationValue op))
       (SourceLoopField source parent index child))
      ((SourceField parent index child)) :ruleset type-layouts)
(rule ((ForwardValue value state) (= (StoredLoopState state) true))
      ((set (StoredLoopState value) true)) :ruleset type-layouts)
(rule ((Projection value tuple index) (SourceField tuple index state) (= (StoredLoopState state) true))
      ((set (StoredLoopState value) true)) :ruleset type-layouts)
(rule ((HostLoopAggregate value) (ReferenceDemand value) (SourceField value index child))
      ((ReferenceDemand child)) :ruleset residency)
(rule ((HostLoopAggregate value) (ReferenceDemand value) (SourceField value index child) (References child resource))
      ((References value resource)) :ruleset residency)
; A structure-of-arrays state also has a stream extent. Its components have
; already been split into independent bindings, so retain that extent explicitly.
(rule ((HostLoopAggregate value) (= ty (SourceType value)) (= size (SourceArraySize ty))
       (SourceField value 0 first) (= extent (ViewExtent first)))
      ((set (ViewExtent value) extent)) :ruleset residency)

; State components have independent, stable storage identities. Product values
; are reconstructed from these views, never stored as giant invocation arrays.
(rule ((LoopCarry op slot initial state next output array))
      ((set (ValueRef state) (Source state))
       (set (ValueRef output) (LoopResult op slot))
       (FreshValue (Source state)) (Materialize (Source state))
       (set (Backing (Source state)) (Source state))
       (set (Backing (LoopResult op slot)) (Source state))) :ruleset residency)
(rule ((LoopCarry op slot initial state next output true) (= ty (SourceType state)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (LoopCarryExtent op slot) (Fixed n))) :ruleset allocation)
(rule ((LoopCarry op slot initial state next output true) (= ty (SourceType state)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (LoopCarryExtent op slot) (Length initial))) :ruleset allocation)
(rule ((LoopCarry op slot initial state next output true) (= ty (SourceType state)) (SourceArrayElement ty element)
       (= extent (LoopCarryExtent op slot)))
      ((ElementType (Source state) element) (ElementType (LoopResult op slot) element)
       (set (HostBound (Length state)) (Length initial))
       (set (ViewExtent state) extent) (set (ViewExtent output) extent)
       (set (CapacityExtent (Source state)) extent) (set (LiveLength (Source state)) extent)
       (set (CapacityExtent (LoopResult op slot)) extent)
       (set (LiveLength (LoopResult op slot)) extent)
       (set (ValueRead state) (ReadView (Source state)))
       (set (ValueRead output) (ReadView (LoopResult op slot)))) :ruleset allocation)
(rule ((LoopCarry op slot initial state next output false) (= ty (SourceType state)))
      ((ElementType (Source state) ty) (ElementType (LoopResult op slot) ty)
       (set (CapacityExtent (Source state)) (Fixed 1)) (set (LiveLength (Source state)) (Fixed 1))
       (set (CapacityExtent (LoopResult op slot)) (Fixed 1))
       (set (LiveLength (LoopResult op slot)) (Fixed 1))
       (set (ValueRead state) (ReadElement (Source state)))
       (set (ValueRead output) (ReadElement (LoopResult op slot)))) :ruleset allocation)
(rule ((LoopCarry op slot initial state next output array) (= source (SourceOperationValue op))
       (= (SourceLoopDirectCarry source) true) (= value (ValueRef next)))
      ((set (LoopNext op slot) value)) :ruleset residency)
(rule ((LoopCarry op slot initial state next output array) (= source (SourceOperationValue op))
       (= (SourceLoopDirectCarry source) false))
      ((set (LoopNext op slot) (Temporary op "loop_next" slot))
       (FreshValue (Temporary op "loop_next" slot)) (Materialize (Temporary op "loop_next" slot))) :ruleset residency)
(rule ((LoopCarry op slot initial state next output array) (= (LoopNext op slot) (Temporary op "loop_next" slot))
       (ElementType (Source state) element) (= extent (CapacityExtent (Source state))))
      ((ElementType (Temporary op "loop_next" slot) element)
       (set (CapacityExtent (Temporary op "loop_next" slot)) extent)
       (set (LiveLength (Temporary op "loop_next" slot)) extent)) :ruleset allocation)

; Counted and conditional control differ only in their test/index contracts.
(rule ((HostLoop op header body) (= source (SourceOperationValue op)) (= (SourceLoopForm source) (ForCount count ty))
       (= index (SourceIterationValue body)))
      ((FreshValue (Source index)) (Materialize (Source index))
       (set (Backing (Source index)) (Source index)) (ElementType (Source index) ty)
       (set (CapacityExtent (Source index)) (Fixed 1)) (set (LiveLength (Source index)) (Fixed 1))
       (set (ValueRead index) (ReadElement (Source index)))
       (Demand (InStage (Stage op "loop_enter")) count)) :ruleset allocation)
(rule ((HostLoop op header body) (= source (SourceOperationValue op)) (= (SourceLoopForm source) (WhileCondition condition))
       (= ty (SourceType condition)))
      ((FreshValue (Temporary op "loop_condition" 0)) (Materialize (Temporary op "loop_condition" 0))
       (ElementType (Temporary op "loop_condition" 0) ty)
       (set (CapacityExtent (Temporary op "loop_condition" 0)) (Fixed 1))
       (set (LiveLength (Temporary op "loop_condition" 0)) (Fixed 1))) :ruleset allocation)

(rule ((HostLoop op header body) (= source (SourceOperationValue op))
       (= extent (SourceLoopDomain source)) (= grid (OperationGrid op)))
      ((KernelPhase op "loop_enter" extent 64 grid)
       (KernelPhase op "loop_exit" (Fixed 1) 1 (FixedGrid 1 1 1))
       (PhaseEnds op "loop_enter" "loop_exit")) :ruleset schedule)
(rule ((LoopCarry op slot initial state next output array))
      ((Produces (Stage op "loop_enter") (Source state))
       (Produces (Stage op "loop_exit") (LoopResult op slot))
       (Demand (InStage (Stage op "loop_enter")) initial)
       (Needs (Stage op "loop_exit") (Source state))) :ruleset schedule)
(rule ((HostLoop op header body) (= source (SourceOperationValue op)) (= (SourceLoopDirectCarry source) false)
       (= extent (SourceLoopDomain source)) (= grid (OperationGrid op)))
      ((KernelPhase op "loop_step" extent 64 grid) (LoopStage op (Stage op "loop_step"))) :ruleset schedule)
(rule ((LoopCarry op slot initial state next output array) (= (LoopNext op slot) (Temporary op "loop_next" slot)))
      ((Produces (Stage op "loop_step") (Temporary op "loop_next" slot))
       (Demand (InStage (Stage op "loop_step")) next)) :ruleset schedule)
(rule ((HostLoop op header body) (= source (SourceOperationValue op)) (= (SourceLoopForm source) (WhileCondition condition)))
      ((KernelPhase op "loop_test" (Fixed 1) 1 (FixedGrid 1 1 1))
       (LoopTestStage op (Stage op "loop_test"))
       (Produces (Stage op "loop_test") (Temporary op "loop_condition" 0))
       (Demand (InStage (Stage op "loop_test")) condition)) :ruleset schedule)

; Static edges order one iteration; host control repeats it without adding DAG cycles.
(rule ((HostLoop op header body) (Phase stage body)) ((LoopStage op stage)) :ruleset dispatch)
(rule ((HostLoop op header body) (Phase stage header))
      ((LoopTestStage op stage) (DispatchDependency stage (Stage op "loop_test"))) :ruleset dispatch)
(rule ((LoopTestStage op stage))
      ((DispatchDependency (Stage op "loop_enter") stage)
       (DispatchDependency stage (Stage op "loop_exit"))) :ruleset dispatch)
(rule ((LoopTestStage op test) (LoopStage op stage)) ((DispatchDependency test stage)) :ruleset dispatch)
(rule ((LoopStage op stage))
      ((DispatchDependency (Stage op "loop_enter") stage)
       (DispatchDependency stage (Stage op "loop_exit"))) :ruleset dispatch)
(rule ((HostLoop op header body) (Phase stage body) (Phase (Stage op "loop_step") parent))
      ((DispatchDependency stage (Stage op "loop_step"))) :ruleset dispatch)
(rule ((HostLoop op header body))
      ((DispatchDependency (Stage op "loop_enter") (Stage op "loop_exit"))) :ruleset dispatch)

; Swapping must preserve capacities and publish every carried binding, including
; a counter or state component not otherwise read by a shader.
(rule ((LoopCarry op slot initial state next output array) (= current (Backing (Source state)))
       (= target (LoopNext op slot)) (= following (Backing target))
       (= a (CapacityExtent current)) (= b (CapacityExtent following))
       (= na (StaticCapacityBound a)) (= nb (StaticCapacityBound b)) (= bound (Fixed (max na nb))))
      ((set (AllocationBounds current) (set-of bound))
       (set (AllocationBounds following) (set-of bound))) :ruleset capacity-bounds)
(rule ((LoopCarry op slot initial state next output array) (= parent (OperationRegion op)) (OwnedRegion owner parent))
      ((set (AllocationOwner (Source state)) owner)
       (set (RootResource (KernelRoot (Stage op "loop_exit")) (Source state)) 0)) :ruleset physical-abi)
(rule ((HostLoop op header body) (= index (SourceIterationValue body)) (= parent (OperationRegion op)) (OwnedRegion owner parent))
      ((set (AllocationOwner (Source index)) owner)
       (set (RootResource (KernelRoot (Stage op "loop_exit")) (Source index)) 0)) :ruleset physical-abi)
