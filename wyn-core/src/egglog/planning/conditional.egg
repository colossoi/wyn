(ruleset conditional-analysis)
(ruleset conditional-select)
; Factor equal map domains out of a conditional. Scalar evaluation preceding
; the conditional stays outside the traversal, including for empty domains.
(relation ConditionalMaps (Program Function Stm Stm Stm))
(function ConditionalResultInfo (Function Result) ValueInfo :no-merge)
(function ConditionalReturn (ValueInfo) ReturnInfo :no-merge)
(function ConditionalPattern (Function StatementId Results i64) Pattern :no-merge)
(function ConditionalReturns (Function StatementId Results i64) ReturnInfos :no-merge)
(function ConditionalResults (StatementId i64) Results :no-merge)
(function SingleStatement (Body) Stm :no-merge)
(function SingleClause (ParallelBody) ParallelResult :no-merge)
(rule ((= body (Block statements results)) (= (vec-size statements) 1))
      ((set (SingleStatement body) (vec-at statements 0))) :ruleset conditional-analysis)
(rule ((= body (ParallelBlock statements clauses)) (= (vec-size clauses) 1))
      ((set (SingleClause body) (vec-at clauses 0))) :ruleset conditional-analysis)
(rule ((= result (Yield proofs (ValueOperand (Var name)))) (= info (BindingInfo function name)))
      ((set (ConditionalResultInfo function result) info)) :ruleset conditional-analysis)
(rule ((ContainsResult (FunctionRoot function) result)
       (= result (Yield proofs (ValueOperand (LiteralBits type bits)))))
      ((set (ConditionalResultInfo function result) (ScalarInfo (ScalarElement type)))) :ruleset conditional-analysis)
(rule ((ContainsResult (FunctionRoot function) result) (= result (Yield proofs (IndexOperand value))))
      ((set (ConditionalResultInfo function result) (ScalarInfo (ScalarElement (I32))))) :ruleset conditional-analysis)
(rule ((= info (ScalarInfo element))) ((set (ConditionalReturn info) (ReturnScalar element))) :ruleset conditional-analysis)
(rule ((= info (LogicalValue type))) ((set (ConditionalReturn info) (LogicalReturn type))) :ruleset conditional-analysis)
(rule ((= info (ResourceInfo type))) ((set (ConditionalReturn info) (ReturnResource type))) :ruleset conditional-analysis)

(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (If condition returns yes-body no-body)))
       (= yes-body (Block yes-statements yes-results)) (= no-body (Block no-statements no-results))
       (= yes (SingleStatement yes-body)) (= no (SingleStatement no-body))
       (= yes (Let yid yp yc (Parallel execution yd yes-parallel)))
       (= no (Let nid np nc (Parallel execution nd no-parallel)))
       (= (SingleClause yes-parallel) (Collect yvalues)) (= (SingleClause no-parallel) (Collect nvalues))
       (= yd (IterationSpace yf ya)) (= nd (IterationSpace nf na))
       (= (vec-size ya) (vec-size na))
       (= (vec-size pattern) (vec-size yvalues)) (= (vec-size yvalues) (vec-size nvalues)))
      ((ConditionalMaps program function statement yes no)
       (ReturnedPattern yp yes-results 0) (ReturnedPattern np no-results 0)
       (MatchDomainAt function yd nd 0 (map-insert (map-empty) nf yf))
       (set (ConditionalPattern function id yvalues 0) (vec-of))
       (set (ConditionalReturns function id yvalues 0) (vec-of))
       (set (ConditionalResults id 0) (vec-of))) :ruleset conditional-analysis)
(rule ((= pattern (ConditionalPattern function id values i))
       (= returns (ConditionalReturns function id values i))
       (= results (ConditionalResults id i))
       (< i (vec-size values))
       (= info (ConditionalResultInfo function (ResultsAt values i)))
       (= result-info (ConditionalReturn info)))
      ((set (ConditionalPattern function id values (+ i 1)) (vec-push pattern (BindValue (ScheduleValue id 61 i) info)))
       (set (ConditionalReturns function id values (+ i 1)) (vec-push returns result-info))
       (set (ConditionalResults id (+ i 1)) (vec-push results (Yield (vec-of) (ValueOperand (Var (ScheduleValue id 61 i))))))) :ruleset conditional-analysis)
(rule ((ConditionalMaps program function statement yes no)
       (= yes (Let yid yp yc (Parallel execution yd body)))
       (= no (Let nid np nc (Parallel other nd next))) (= env (DomainRenaming function yd nd)))
      ((RenameParallelBodyDemand env next)) :ruleset conditional-analysis)
(rule ((ConditionalMaps program function statement yes no)
       (= statement (Let id pattern certs (If condition returns (Block ystms yr) (Block nstms nr))))
       (= yes (Let yid yp yc (Parallel execution yd yes-body)))
       (= yes-body (ParallelBlock ys yes-clauses)) (= (SingleClause yes-body) (Collect yvalues))
       (= no (Let nid np nc (Parallel other nd original)))
       (ReturnedPattern yp yr (vec-size yp)) (ReturnedPattern np nr (vec-size np))
       (= env (DomainRenaming function yd nd))
       (= next (RenameParallelBody env original)) (= next (ParallelBlock ns next-clauses))
       (= (SingleClause next) (Collect nvalues))
       (CheckStatement context id pattern (If condition returns (Block ystms yr) (Block nstms nr)) available)
       (= free (set-diff (NamesDomain yd) (BindersDomain yd)))
       (= (set-diff (set-union free (set-union (NamesCertificates yc) (NamesCertificates nc))) available) (set-empty))
       (= size (vec-size yvalues)) (= lanes (ConditionalPattern function id yvalues size))
       (= lane-returns (ConditionalReturns function id yvalues size)) (= values (ConditionalResults id size)))
      ((let branch (Let (ScheduleStatement id 61 0) lanes (vec-of)
          (If condition lane-returns (Block ys yvalues) (Block ns nvalues))))
       (set (PendingRewrite "conditional" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of (Let id pattern
                  (vec-append certs (vec-append yc nc))
                  (Parallel execution yd (ParallelBlock (vec-of branch) (vec-of (Collect values))))))))))
       (RewriteDemand "conditional" program)) :ruleset conditional-select)
