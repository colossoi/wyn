; Equal map domains may surround a conditional without moving its scalar prefix.
(ruleset conditional-index)
(ruleset conditional-legality)
(ruleset conditional-select)
(relation ConditionalPair (OperationKey OperationKey OperationKey))
(relation ConditionalPrefix (OperationKey OperationKey OperationKey))
(relation ConditionalDomainPrefix (OperationKey i64))
(relation ConditionalReturnPrefix (OperationKey i64))
(relation ConditionalTypePrefix (OperationKey i64))
(relation ConditionalElement (ValueInfo))
(function ConditionalSafe (OperationKey) bool :merge (and old new))
(relation FactorConditional (OperationKey OperationKey OperationKey))
; Factoring makes each arm produce one element in invocation-local storage.
(rule ((= info (ScalarInfo element))) ((ConditionalElement info)) :ruleset conditional-index)
(rule ((= info (ResourceInfo resource))) ((ConditionalElement info)) :ruleset conditional-index)
(rule ((= info (LogicalValue ty)) (= bytes (LogicalBytes ty)))
      ((ConditionalElement info)) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (LiveOperation branch) (BranchOperation branch)
       (= a (wyn-control-region branch 0)) (= b (wyn-control-region branch 1))
       (FirstOperation a first-a) (LastOperation a yes)
       (FirstOperation b first-b) (LastOperation b no)
       (ParallelOperation yes) (ParallelOperation no) (= execution (OperationExecution yes)) (= execution (OperationExecution no))
       (= (wyn-result-count yes) 1) (= (wyn-result-count no) 1)
       (CollectedClause yes 0) (CollectedClause no 0))
      ((ConditionalPair branch yes no) (ConditionalPrefix branch yes first-a) (ConditionalPrefix branch no first-b)
       (ConditionalDomainPrefix branch 0)
       (ConditionalReturnPrefix branch 0) (ConditionalTypePrefix branch 0) (set (ConditionalSafe branch) true)) :ruleset conditional-index)
; Setup stays inside its original arm. It may be skipped for an empty domain
; or repeated across lanes only when both operations preserve its semantics.
(rule ((= revision (TransformRevision)) (ConditionalPrefix branch last operation) (!= operation last)
       (DiscardableOperation operation) (RepeatableOperation operation) (NextOperation operation next))
      ((ConditionalPrefix branch last next) (EffectCompare operation last)) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPrefix branch last operation)
       (!= last operation) (InvocationDependent operation))
      ((set (ConditionalSafe branch) false)) :ruleset conditional-legality)
(rule ((= revision (TransformRevision)) (ConditionalPrefix branch last operation)
       (!= last operation) (OperationsConflict operation last))
      ((set (ConditionalSafe branch) false)) :ruleset conditional-legality)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (ConditionalDomainPrefix branch slot)
       (= a (wyn-iteration-domain yes)) (= b (wyn-iteration-domain no)) (< slot (wyn-domain-rank a))
       (= extent (wyn-domain-extent a slot)) (= extent (wyn-domain-extent b slot)))
      ((ConditionalDomainPrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (ConditionalDomainPrefix branch slot)
       (= a (wyn-iteration-domain yes)) (= b (wyn-iteration-domain no)) (< slot (wyn-domain-rank a))
       (= left (wyn-domain-extent a slot)) (= right (wyn-domain-extent b slot))
       (= n (StaticIndex left)) (= n (StaticIndex right)))
      ((ConditionalDomainPrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (ConditionalReturnPrefix branch slot) (< slot (wyn-output-count branch))
       (= a (wyn-control-region branch 0)) (= b (wyn-control-region branch 1))
       (= ay (wyn-output yes slot)) (= by (wyn-output no slot)) (= ay (wyn-yield a slot)) (= by (wyn-yield b slot)))
      ((ConditionalReturnPrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (ConditionalTypePrefix branch slot) (< slot (wyn-output-count branch))
       (CollectiveLaneUse yes 0 (ValueNameRef a)) (= (wyn-contribution yes 0 slot) (ValueNameRef a)) (CollectiveLaneUse no 0 (ValueNameRef b)) (= (wyn-contribution no 0 slot) (ValueNameRef b))
       (= info (ValueType a)) (= info (ValueType b)) (ConditionalElement info)
       (= (wyn-output branch slot) (ValueNameRef output)))
      ((ConditionalTypePrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (= domain (wyn-iteration-domain yes)) (IterationAxis domain slot) (= extent (wyn-domain-extent domain slot)) (IndexUse extent name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (= domain (wyn-iteration-domain no)) (IterationAxis domain slot) (= extent (wyn-domain-extent domain slot)) (IndexUse extent name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (OperationCertificate yes name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (OperationCertificate no name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (BranchArm edge) (= arm (wyn-control-region branch edge)) (YieldCertificate arm slot name))
      ((set (ConditionalSafe branch) false)) :ruleset conditional-index)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (= (TransformAvailable branch name) false))
      ((set (ConditionalSafe branch) false)) :ruleset conditional-legality)
(rule ((= revision (TransformRevision)) (ConditionalPair branch yes no) (= count (wyn-output-count branch))
       (= count (wyn-output-count yes)) (= count (wyn-output-count no))
       (= count (wyn-contribution-count yes 0)) (= count (wyn-contribution-count no 0))
       (ConditionalReturnPrefix branch count) (ConditionalTypePrefix branch count)
       (ConditionalPrefix branch yes yes) (ConditionalPrefix branch no no)
       (= a (wyn-iteration-domain yes)) (= b (wyn-iteration-domain no)) (= rank (wyn-domain-rank a)) (= rank (wyn-domain-rank b))
       (ConditionalDomainPrefix branch rank) (= (ConditionalSafe branch) true))
      ((FactorConditional branch yes no)) :ruleset conditional-select)
