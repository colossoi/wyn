; Equal map domains may surround a conditional without moving its scalar prefix.
(ruleset conditional-index)
(ruleset conditional-legality)
(ruleset conditional-select)
(relation ConditionalPair (OperationKey OperationKey OperationKey))
(relation ConditionalDomainPrefix (OperationKey i64))
(relation ConditionalReturnPrefix (OperationKey i64))
(relation ConditionalTypePrefix (OperationKey i64))
(function ConditionalSafe (OperationKey) bool :merge (and old new))
(relation FactorConditional (OperationKey OperationKey OperationKey))
(rule ((= revision (AnalysisRevision)) (LiveOperation branch) (BranchOperation branch)
       (= a (ControlRegion branch 0)) (= b (ControlRegion branch 1))
       (FirstOperation a yes) (LastOperation a yes) (FirstOperation b no) (LastOperation b no)
       (ParallelOperation yes) (ParallelOperation no) (= execution (OperationExecution yes)) (= execution (OperationExecution no))
       (= (ResultCount yes) 1) (= (ResultCount no) 1)
       (= (ResultKindOf yes 0) (Collected)) (= (ResultKindOf no 0) (Collected)))
      ((ConditionalPair branch yes no) (ConditionalDomainPrefix branch 0)
       (ConditionalReturnPrefix branch 0) (ConditionalTypePrefix branch 0) (set (ConditionalSafe branch) true)) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (ConditionalDomainPrefix branch slot)
       (= a (OperationDomain yes)) (= b (OperationDomain no)) (< slot (DomainRank a))
       (= extent (DomainExtent a slot)) (= extent (DomainExtent b slot)))
      ((ConditionalDomainPrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (ConditionalDomainPrefix branch slot)
       (= a (OperationDomain yes)) (= b (OperationDomain no)) (< slot (DomainRank a))
       (= left (DomainExtent a slot)) (= right (DomainExtent b slot))
       (= n (StaticIndex left)) (= n (StaticIndex right)))
      ((ConditionalDomainPrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (ConditionalReturnPrefix branch slot) (< slot (OutputCount branch))
       (= a (ControlRegion branch 0)) (= b (ControlRegion branch 1))
       (= ay (Output yes slot)) (= by (Output no slot)) (= ay (RegionYield a slot)) (= by (RegionYield b slot)))
      ((ConditionalReturnPrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (ConditionalTypePrefix branch slot) (< slot (OutputCount branch))
       (= (ResultValue yes 0 slot) (ValueNameRef a)) (= (ResultValue no 0 slot) (ValueNameRef b))
       (= info (ValueType a)) (= info (ValueType b)) (= (Output branch slot) (ValueNameRef output)))
      ((ConditionalTypePrefix branch (+ slot 1))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (= domain (OperationDomain yes)) (= extent (DomainExtent domain slot)) (IndexUse extent name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (= domain (OperationDomain no)) (= extent (DomainExtent domain slot)) (IndexUse extent name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (OperationCertificate yes name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (OperationCertificate no name))
      ((TransformRequirement branch (ValueNameRef name))) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (= arm (ControlRegion branch edge)) (YieldCertificate arm slot name))
      ((set (ConditionalSafe branch) false)) :ruleset conditional-index)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (= (TransformAvailable branch name) false))
      ((set (ConditionalSafe branch) false)) :ruleset conditional-legality)
(rule ((= revision (AnalysisRevision)) (ConditionalPair branch yes no) (= count (OutputCount branch))
       (= count (OutputCount yes)) (= count (OutputCount no))
       (= count (ResultValueCount yes 0)) (= count (ResultValueCount no 0))
       (ConditionalReturnPrefix branch count) (ConditionalTypePrefix branch count)
       (= a (OperationDomain yes)) (= b (OperationDomain no)) (= rank (DomainRank a)) (= rank (DomainRank b))
       (ConditionalDomainPrefix branch rank) (= (ConditionalSafe branch) true))
      ((FactorConditional branch yes no)) :ruleset conditional-select)
