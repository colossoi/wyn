; One rectangular schedule per selected SCREMA. All policy precedes SSA emission.
(ruleset map-types)
(ruleset map-discover)
(ruleset map-repeatability)
(ruleset map-proofs)
(ruleset map-shapes)
(ruleset map-blockers)
(ruleset map-select)
(ruleset map-launch)
(ruleset storage-shapes)
(function MapTypeRank (TypeKey) i64 :merge (max old new))
(relation MapTypeAxis (TypeKey i64 ArraySize))
(function MapHasOperation (SourceValue) bool :merge (or old new))
(function MapHasCallee (SourceValue) bool :merge (or old new))
(function MapScalarCallback (FusionPlan OperationKey) bool :merge (or old new))
(function MapHost (FusionPlan) bool :merge (or old new))
(rule ((Current group plan)) ((set (MapHost plan) false)) :ruleset map-types)
(rule ((Current group plan) (= scope (Scope plan)) (HostRegion scope)) ((set (MapHost plan) true)) :ruleset map-types)
(rule ((= ty (TypeId id))) ((set (MapTypeRank ty) 0)) :ruleset map-types)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (= n (MapTypeRank element)))
      ((set (MapTypeRank ty) (+ n 1))) :ruleset map-types)
(rule ((= size (SourceArraySize ty))) ((MapTypeAxis ty 0 size)) :ruleset map-types)
(rule ((= array-size (SourceArraySize ty)) (SourceArrayElement ty element) (MapTypeAxis element i size))
      ((MapTypeAxis ty (+ i 1) size)) :ruleset map-types)
(rule ((= ty (SourceType value))) ((set (MapHasOperation value) false)) :ruleset map-types)
(rule ((= op (SourceValueOperation value))) ((set (MapHasOperation value) true)) :ruleset map-types)
(rule ((= value (SourceInvocation scope function args))) ((set (MapHasCallee value) false)) :ruleset map-types)
(rule ((= callee (PlanCallee value))) ((set (MapHasCallee value) true)) :ruleset map-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping plan op) true))
      ((set (MapScalarCallback plan op) false)) :ruleset map-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping plan op) true) (= body (PlanCallback plan op))
       (= result (SourceResult body)) (= ty (SourceType result)) (SourceScalarLayout ty))
      ((set (MapScalarCallback plan op) true)) :ruleset map-types)

(relation MapPlan (FusionPlan OperationKey Extent))
(relation MapDemand (SourceValue))
(relation MapCandidate (SourceValue FusionPlan OperationKey RegionKey))
(datatype MapContext (OutsidePlan) (InsidePlan FusionPlan))
(relation MapRequirement (SourceValue MapContext SourceValue))
(datatype MapCheck (Repeat MapContext SourceValue))
(sort MapChecks (Set MapCheck))
(function MapRequired (SourceValue) MapChecks :merge (set-union old new))
(function MapApproved (SourceValue) MapChecks :merge (set-union old new))
(relation MapCheckNeeded (MapContext SourceValue))
(rule ((Current group plan) (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= owner (Owner plan)) (= domain (PlanDomain plan)) (= extent (SourceDomainExtent domain)))
      ((MapPlan plan owner extent)) :ruleset map-discover)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (PlanResult plan "array" i value element))
      ((MapDemand value)) :ruleset map-discover)
(rule ((MapDemand value)) ((set (MapRequired value) (set-empty)) (set (MapApproved value) (set-empty))) :ruleset map-discover)
(rule ((MapDemand value) (= actual (SourceAlias value))) ((MapDemand actual)) :ruleset map-discover)
(rule ((MapDemand value) (= callee (PlanCallee value)) (= result (SourceResult callee)))
      ((MapDemand result)) :ruleset map-discover)
(rule ((MapDemand value) (= argument (PlanCallArgument value i)))
      ((MapRequirement value (OutsidePlan) argument)) :ruleset map-discover)
(rule ((MapDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= (PlanMapping plan op) true) (= (SourceReadOnly value) true)
       (= ty (SourceType value)) (= array-size (SourceArraySize ty)) (= body (PlanCallback plan op)))
      ((MapCandidate value plan op body)) :ruleset map-discover)
(rule ((MapCandidate value plan op body) (= result (SourceResult body))) ((MapDemand result)) :ruleset map-discover)
(rule ((MapCandidate value plan op body) (SourceCapture body formal actual))
      ((MapRequirement value (OutsidePlan) actual)) :ruleset map-discover)
(rule ((MapCandidate value plan op body) (= input (PlanRoute plan op i)))
      ((MapRequirement value (InsidePlan plan) input)) :ruleset map-discover)
(rule ((MapRequirement value context input))
      ((set (MapRequired value) (set-of (Repeat context input))) (MapCheckNeeded context input)) :ruleset map-discover)

; shortcut: all legal repetitions have equal cost until cost-based scheduling is added.
(function MapCheckMapping (MapContext SourceValue) bool :no-merge)
(relation MapCheckEdge (MapContext SourceValue SourceValue))
(function MapRepeatable (MapContext SourceValue) bool :merge (and old new))
(rule ((= mapping (MapCheckMapping context value)))
      ((set (MapRepeatable context value) true)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (OutsidePlan) value)) ((set (MapCheckMapping (OutsidePlan) value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (InsidePlan plan) value) (= (MapHasOperation value) false))
      ((set (MapCheckMapping (InsidePlan plan) value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= other (SelectedPlan op)) (!= plan other))
      ((set (MapCheckMapping (InsidePlan plan) value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= mapping (PlanMapping plan op)))
      ((set (MapCheckMapping (InsidePlan plan) value) mapping)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping context value) false) (SourceDirectUse value child))
      ((MapCheckEdge context value child)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping context value) false) (SourceBranch value test yes no)
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((MapCheckEdge context value a) (MapCheckEdge context value b)) :ruleset map-repeatability)
(rule ((MapCheckNeeded context value) (= argument (PlanCallArgument value i)))
      ((MapCheckEdge context value argument)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping context value) false) (= op (SourceValueOperation value))
       (= (SourceDuplicable value) false)) ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded context value) (= (MapHasCallee value) false))
      ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded context value) (= callee (PlanCallee value)) (= (SourceRegionDuplicable callee) false))
      ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= (MapScalarCallback plan op) false))
      ((set (MapRepeatable (InsidePlan plan) value) false)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (PlanCallback plan op)) (= result (SourceResult body)))
      ((MapCheckEdge (InsidePlan plan) value result)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (PlanCallback plan op)) (SourceCapture body formal actual))
      ((MapCheckEdge (InsidePlan plan) value actual)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value)) (= input (PlanRoute plan op i)))
      ((MapCheckEdge (InsidePlan plan) value input)) :ruleset map-repeatability)
(rule ((MapCheckEdge context value child)) ((MapCheckNeeded context child)) :ruleset map-repeatability)
(rule ((MapCheckEdge context value child) (= (MapRepeatable context child) false))
      ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((MapRequirement value context input) (= (MapRepeatable context input) true))
      ((set (MapApproved value) (set-of (Repeat context input)))) :ruleset map-proofs)
(relation MapReady (SourceValue))
(rule ((MapDemand value) (= (MapRequired value) (MapApproved value))) ((MapReady value)) :ruleset map-shapes)

; Dimension expressions stay symbolic through helper calls. The dependency proof
; runs to completion before any uniformity decision is consumed.
(function MapShapeAxis (SourceValue i64) Extent :no-merge)
(ruleset extent-dependencies)
(ruleset extent-uniformity)
(function RectangularExtent (Extent) Extent :no-merge)
(function ExtentKnownFormal (SourceValue) bool :merge (or old new))
(function ExtentHasLength (SourceValue) bool :merge (or old new))
(function ExtentKnownLength (SourceValue) bool :merge (or old new))
(rule ((= value (SourceFormal region i))) ((set (ExtentKnownFormal value) false)) :ruleset map-shapes)
(rule ((= value (SourceParameter region i))) ((set (ExtentKnownFormal value) true)) :ruleset map-shapes)
(rule ((SourceCapture region formal actual)) ((set (ExtentKnownFormal formal) true)) :ruleset map-shapes)
(rule ((= ty (SourceType value))) ((set (ExtentHasLength value) false)) :ruleset map-shapes)
(rule ((= array (SourceLength value))) ((set (ExtentHasLength value) true)) :ruleset map-shapes)
(rule ((Length value)) ((set (ExtentKnownLength value) false)) :ruleset map-shapes)
(rule ((= extent (RectangularExtent (Length value)))) ((set (ExtentKnownLength value) true)) :ruleset map-shapes)
(rule ((= ty (SourceType value)) (= size (SourceArraySize ty))) ((Length value)) :ruleset map-shapes)
(rule ((Fixed n)) ((set (RectangularExtent (Fixed n)) (Fixed n))) :ruleset map-shapes)
(rule ((Scalar value)) ((set (RectangularExtent (Scalar value)) (Scalar value))) :ruleset map-shapes)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (FixedSize n)))
      ((set (RectangularExtent (Length value)) (Fixed n))) :ruleset map-shapes)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= source (SourceAlias value)) (= extent (RectangularExtent (Length source))))
      ((set (RectangularExtent (Length value)) extent)) :ruleset map-shapes)
(rule ((SourceCapture region formal actual) (= extent (RectangularExtent (Length actual))))
      ((set (RectangularExtent (Length formal)) extent)) :ruleset map-shapes)
(rule ((= value (SourceParameter region i)) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize)))
      ((set (RectangularExtent (Length value)) (Length value))) :ruleset map-shapes)
(rule ((= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= original (SourceExtent value)) (!= original (Length value)) (= extent (RectangularExtent original)))
      ((set (RectangularExtent (Length value)) extent)) :ruleset map-shapes)
(rule ((Product a b) (= left (RectangularExtent a)) (= right (RectangularExtent b)))
      ((set (RectangularExtent (Product a b)) (Product left right))) :ruleset map-shapes)
(rule ((Difference a b) (= left (RectangularExtent a)) (= right (RectangularExtent b)))
      ((set (RectangularExtent (Difference a b)) (Difference left right))) :ruleset map-shapes)

(relation ExtentDependency (Extent Extent))
(relation ExtentBinding (Extent Extent Extent))
(relation ExtentSource (Extent SourceValue))
(relation ExtentEdge (Extent Extent))
(function ExtentUnsafe (Extent) bool :merge (or old new))
(function ExtentUniform (Extent) bool :merge (and old new))
(function ExtentInputUniform (Extent) bool :merge (or old new))
(rule ((Scalar value)) ((ExtentSource (Scalar value) value)) :ruleset extent-dependencies)
(rule ((Length value)) ((ExtentSource (Length value) value)) :ruleset extent-dependencies)
(rule ((ExtentSource extent value)) ((set (ExtentInputUniform extent) false)) :ruleset extent-dependencies)
(rule ((SourceEntryPoint owner region) (= value (SourceParameter region i))
       (= ty (SourceType value)) (SourceScalarLayout ty))
      ((set (ExtentInputUniform (Scalar value)) true)) :ruleset extent-dependencies)
(rule ((SourceEntryPoint owner region) (= value (SourceParameter region i))
       (= ty (SourceType value)) (= size (SourceArraySize ty)))
      ((set (ExtentInputUniform (Length value)) true)) :ruleset extent-dependencies)
(rule ((Scalar value) (= value (SourceParameter region i)))
      ((ExtentDependency (Scalar value) (Scalar value))) :ruleset extent-dependencies)
(rule ((Length value) (= value (SourceParameter region i)))
      ((ExtentDependency (Length value) (Length value))) :ruleset extent-dependencies)
(rule ((Scalar value) (= (ExtentHasLength value) false) (SourceDirectUse value child))
      ((ExtentEdge (Scalar value) (Scalar child))) :ruleset extent-dependencies)
(rule ((Scalar value) (= array (SourceLength value)))
      ((ExtentEdge (Scalar value) (Length array))) :ruleset extent-dependencies)
(rule ((Scalar value) (SourceNestedUse value child))
      ((ExtentEdge (Scalar value) (Scalar child))) :ruleset extent-dependencies)
(rule ((Scalar formal) (SourceCapture region formal actual))
      ((ExtentEdge (Scalar formal) (Scalar actual))) :ruleset extent-dependencies)
(rule ((Length formal) (SourceCapture region formal actual))
      ((ExtentEdge (Length formal) (Length actual))) :ruleset extent-dependencies)
(rule ((Scalar value) (= actual (SourceAlias value)))
      ((ExtentEdge (Scalar value) (Scalar actual))) :ruleset extent-dependencies)
(rule ((Length value) (= actual (SourceAlias value)))
      ((ExtentEdge (Length value) (Length actual))) :ruleset extent-dependencies)
(rule ((= extent (RectangularExtent (Length value))) (!= extent (Length value)))
      ((ExtentEdge (Length value) extent)) :ruleset extent-dependencies)
(rule ((Product a b)) ((ExtentEdge (Product a b) a) (ExtentEdge (Product a b) b)) :ruleset extent-dependencies)
(rule ((Difference a b)) ((ExtentEdge (Difference a b) a) (ExtentEdge (Difference a b) b)) :ruleset extent-dependencies)
(rule ((ExtentEdge extent child) (ExtentDependency child input))
      ((ExtentDependency extent input)) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= callee (PlanCallee call))
       (ExtentDependency inner (Scalar formal)) (= formal (SourceParameter callee i)) (= actual (PlanCallArgument call i)))
      ((ExtentBinding extent (Scalar formal) (Scalar actual)) (ExtentEdge extent (Scalar actual))) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= callee (PlanCallee call))
       (ExtentDependency inner (Length formal)) (= formal (SourceParameter callee i)) (= actual (PlanCallArgument call i)))
      ((ExtentBinding extent (Length formal) (Length actual)) (ExtentEdge extent (Length actual))) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= callee (PlanCallee call))
       (ExtentDependency inner input) (ExtentSource input formal) (= region (SourceParameterRegion formal)) (!= region callee))
      ((ExtentDependency extent input)) :ruleset extent-dependencies)
(rule ((ExtentSource extent value) (= (ExtentKnownFormal value) false))
      ((set (ExtentUnsafe extent) true)) :ruleset extent-dependencies)
(rule ((Length source) (= (ExtentKnownLength source) false)) ((set (ExtentUnsafe (Length source)) true)) :ruleset extent-dependencies)
(rule ((Scalar source) (= (SourceDevice source) true) (= (ExtentHasLength source) false))
      ((set (ExtentUnsafe (Scalar source)) true)) :ruleset extent-dependencies)
(rule ((Scalar source) (= (SourceDuplicable source) false)) ((set (ExtentUnsafe (Scalar source)) true)) :ruleset extent-dependencies)
(rule ((ExtentEdge extent child) (= (ExtentUnsafe child) true)) ((set (ExtentUnsafe extent) true)) :ruleset extent-dependencies)
(rule ((= extent (CallExtent call inner)) (= (ExtentUnsafe inner) true)) ((set (ExtentUnsafe extent) true)) :ruleset extent-dependencies)
(rule ((= (ExtentUnsafe extent) true)) ((set (ExtentUniform extent) false)) :ruleset extent-uniformity)
(rule ((= extent (MapShapeAxis value axis))) ((set (ExtentUniform extent) true)) :ruleset extent-uniformity)
(rule ((ExtentDependency extent input) (= (ExtentInputUniform input) false))
      ((set (ExtentUniform extent) false)) :ruleset extent-uniformity)

(function MapShapePrefix (SourceValue) i64 :merge (max old new))
(rule ((MapDemand value)) ((set (MapShapePrefix value) 0)) :ruleset map-shapes)
(rule ((MapDemand value) (= ty (SourceType value)) (MapTypeAxis ty i (FixedSize n)))
      ((set (MapShapeAxis value i) (Fixed n))) :ruleset map-shapes)
(rule ((MapDemand value) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= op (SourceValueOperation value)) (= plan (SelectedPlan op)) (ScremaPlan plan)
       (PlanResult plan "array" i value element) (= domain (PlanDomain plan))
       (= extent (RectangularExtent (SourceDomainExtent domain))))
      ((set (MapShapeAxis value 0) extent)) :ruleset map-shapes)
(rule ((MapDemand value) (= actual (SourceAlias value)) (= extent (MapShapeAxis actual axis)))
      ((set (MapShapeAxis value axis) extent)) :ruleset map-shapes)
(rule ((MapDemand value) (MapReady value) (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= ty (SourceType value)) (MapTypeAxis ty axis (DynamicSize))
       (= extent (MapShapeAxis result axis)))
      ((set (MapShapeAxis value axis) (CallExtent value extent))) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (MapReady value) (= result (SourceResult body))
       (= ty (SourceType value)) (= rank (MapTypeRank ty)) (< (+ axis 1) rank)
       (= extent (MapShapeAxis result axis)))
      ((set (MapShapeAxis value (+ axis 1)) extent)) :ruleset map-shapes)
(rule ((= n (MapShapePrefix value)) (= extent (MapShapeAxis value n)))
      ((set (MapShapePrefix value) (+ n 1))) :ruleset map-shapes)

; Depth is bounded by the result type, including through recursive call links.
(function MapDepth (SourceValue) i64 :merge (max old new))
(rule ((MapDemand value)) ((set (MapDepth value) 0)) :ruleset map-shapes)
(rule ((MapDemand value) (= actual (SourceAlias value)) (= depth (MapDepth actual))
       (= ty (SourceType value)) (= rank (MapTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((MapDemand value) (MapReady value) (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= depth (MapDepth result)) (= ty (SourceType value)) (= rank (MapTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (MapReady value) (= result (SourceResult body))
       (= depth (MapDepth result)) (= prefix (MapShapePrefix result))
       (= output (SourceType value)) (= rank (MapTypeRank output)))
      ((set (MapDepth value) (min rank (+ 1 (min depth prefix))))) :ruleset map-shapes)

; Compare each output with one anchor, rather than forming all output pairs.
(function MapFirstOutput (FusionPlan) i64 :merge (min old new))
(relation MapAnchor (FusionPlan SourceValue))
(function MapBlocked (FusionPlan) bool :merge (or old new))
(rule ((MapPlan plan owner extent)) ((set (MapBlocked plan) false)) :ruleset map-blockers)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element))
      ((set (MapFirstOutput plan) i)) :ruleset map-blockers)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element) (= (MapTypeRank element) 0))
      ((set (MapBlocked plan) true)) :ruleset map-blockers)
(rule ((= i (MapFirstOutput plan)) (PlanResult plan "array" i value element)) ((MapAnchor plan value)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= depth (MapDepth anchor))
       (PlanResult plan "array" i value element) (= other (MapDepth value)) (!= depth other))
      ((set (MapBlocked plan) true)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= depth (MapDepth anchor))
       (PlanResult plan "array" i value element)
       (= a (MapShapeAxis anchor axis)) (> axis 0) (< axis depth)
       (= b (MapShapeAxis value axis)) (!= a b))
      ((set (MapBlocked plan) true)) :ruleset map-select)
(function MapSelectedRank (FusionPlan) i64 :no-merge)
(rule ((MapAnchor plan anchor) (= extent (MapShapeAxis anchor axis)) (> axis 0)
       (= (ExtentUniform extent) false)) ((set (MapBlocked plan) true)) :ruleset map-select)
(rule ((MapPlan plan owner extent) (= (MapBlocked plan) true)) ((set (MapSelectedRank plan) 1)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= (MapHost plan) false))
      ((set (MapSelectedRank plan) 1)) :ruleset map-launch)
(rule ((MapAnchor plan anchor) (= (MapHost plan) true) (= (MapBlocked plan) false) (= depth (MapDepth anchor)))
      ((set (MapSelectedRank plan) (max 1 depth))) :ruleset map-launch)
(relation MapLaunchProduct (OperationKey i64 Extent))
(rule ((MapPlan plan owner extent) (= rank (MapSelectedRank plan)))
      ((set (MapLaunchRank owner) rank) (set (MapLaunchAxis owner 0) extent) (MapLaunchProduct owner 1 extent)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= rank (MapSelectedRank plan)) (MapAnchor plan anchor)
       (= n (MapShapeAxis anchor axis)) (> axis 0) (< axis rank))
      ((set (MapLaunchAxis owner axis) n)) :ruleset map-launch)
(rule ((MapLaunchProduct owner axis product) (= rank (MapLaunchRank owner)) (< axis rank)
       (= extent (MapLaunchAxis owner axis)))
      ((MapLaunchProduct owner (+ axis 1) (Product product extent))) :ruleset map-launch)
(rule ((= rank (MapLaunchRank owner)) (MapLaunchProduct owner rank extent))
      ((set (MapLaunch owner) extent)) :ruleset map-launch)

; Runtime rows have one flat allocation and an explicit row-major view shape.
(function MapDynamicRows (TypeKey) bool :merge (or old new))
(rule ((= rank (MapTypeRank ty))) ((set (MapDynamicRows ty) false)) :ruleset map-types)
(rule ((MapTypeAxis ty axis (DynamicSize)) (> axis 0))
      ((set (MapDynamicRows ty) true)) :ruleset map-types)
(relation MapStorageShape (SourceValue i64 TypeKey RectangularShape Extent))
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (PlanResult plan "array" i value element) (= ty (SourceType value)) (= (MapDynamicRows ty) true))
      ((MapStorageShape value 0 ty (vec-of) (Fixed 1))) :ruleset storage-shapes)
(rule ((MapStorageShape value axis ty shape count) (SourceArrayElement ty element)
       (= extent (MapShapeAxis value axis)) (= (ExtentUniform extent) true))
      ((MapStorageShape value (+ axis 1) element (vec-push shape extent) (Product count extent))) :ruleset storage-shapes)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element)
       (MapStorageShape value rank leaf shape count) (= ty (SourceType value)) (= rank (MapTypeRank ty)))
      ((set (StorageShape (Result owner i)) shape)
       (set (StorageElement (Result owner i)) leaf)
       (set (StorageExtent (Result owner i)) count)) :ruleset storage-shapes)

(rule ((ExtentDemand stage extent) (= extent (CallExtent call inner)) (ExtentDependency extent input))
      ((ExtentDemand stage input)) :ruleset residency)
(rule ((Needs stage value) (= extent (StorageExtent value)))
      ((ExtentDemand stage extent)) :ruleset residency)

; Projected result fields retain the same rectangular domain and a leaf field type.
(relation RectangularView (SourceValue TypeKey RectangularShape Extent))
(rule ((ValueRef source buffer) (= shape (StorageShape buffer))
       (= leaf (StorageElement buffer)) (= count (StorageExtent buffer)))
      ((RectangularView source leaf shape count)) :ruleset residency)
(rule ((RectangularView source leaf shape count) (SourceProjection value source i)
       (= fields (SourceTypeFields leaf)))
      ((RectangularView value (vec-get fields i) shape count)) :ruleset residency)
(rule ((RectangularView source leaf shape count) (= source (SourceAlias value)))
      ((RectangularView value leaf shape count)) :ruleset residency)
(rule ((ReturnArray output value) (RectangularView value leaf shape count))
      ((set (StorageShape (Output output)) shape) (set (StorageElement (Output output)) leaf)
       (set (StorageExtent (Output output)) count)) :ruleset residency)
