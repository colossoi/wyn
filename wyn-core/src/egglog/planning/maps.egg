; One rectangular schedule per selected SCREMA. All policy precedes SSA emission.
(ruleset map-types)
(ruleset map-shapes)
(ruleset map-blockers)
(ruleset map-select)
(ruleset map-launch)
(function MapHost (FusionPlan) bool :merge (or old new))
(rule ((Current group plan)) ((set (MapHost plan) false)) :ruleset map-types)
(rule ((Current group plan) (= scope (Scope plan)) (HostRegion scope)) ((set (MapHost plan) true)) :ruleset map-types)
(relation MapPlan (FusionPlan OperationKey Extent))
(relation MapCandidate (SourceValue FusionPlan OperationKey RegionKey))
(rule ((Current group plan) (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= owner (Owner plan)) (= domain (PlanDomain plan)) (= extent (SourceDomainExtent domain)))
      ((MapPlan plan owner extent)) :ruleset rectangular-discover)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (PlanResult plan "array" i value element))
      ((RectangularDemand value)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= (PlanMapping plan op) true) (= (SourceReadOnly value) true)
       (= ty (SourceType value)) (= array-size (SourceArraySize ty)) (= body (PlanCallback plan op)))
      ((MapCandidate value plan op body)) :ruleset rectangular-discover)
(rule ((MapCandidate value plan op body) (= result (SourceResult body))) ((RectangularDemand result)) :ruleset rectangular-discover)
(rule ((MapCandidate value plan op body) (SourceCapture body formal actual))
      ((RectangularRequirement value (OutsidePlan) actual)) :ruleset rectangular-discover)
(rule ((MapCandidate value plan op body) (= input (PlanRoute plan op i)))
      ((RectangularRequirement value (InsidePlan plan) input)) :ruleset rectangular-discover)
(rule ((RectangularDemand value) (= ty (SourceType value)) (= (SourceArraySize ty) (DynamicSize))
       (= op (SourceValueOperation value)) (= plan (SelectedPlan op)) (ScremaPlan plan)
       (PlanResult plan "array" i value element) (= domain (PlanDomain plan))
       (= extent (RectangularExtent (SourceDomainExtent domain))))
      ((set (RectangularAxis value 0) extent)) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (RectangularReady value) (= result (SourceResult body))
       (= ty (SourceType value)) (= rank (ArrayTypeRank ty)) (< (+ axis 1) rank)
       (= extent (RectangularAxis result axis)))
      ((set (RectangularAxis value (+ axis 1)) extent)) :ruleset map-shapes)

; Depth is bounded by the result type, including through recursive call links.
(function MapDepth (SourceValue) i64 :merge (max old new))
(rule ((RectangularDemand value)) ((set (MapDepth value) 0)) :ruleset map-shapes)
(rule ((RectangularDemand value) (= actual (SourceAlias value)) (= depth (MapDepth actual))
       (= ty (SourceType value)) (= rank (ArrayTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((RectangularDemand value) (RectangularReady value) (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= depth (MapDepth result)) (= ty (SourceType value)) (= rank (ArrayTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (RectangularReady value) (= result (SourceResult body))
       (= depth (MapDepth result)) (= prefix (RectangularPrefix result))
       (= output (SourceType value)) (= rank (ArrayTypeRank output)))
      ((set (MapDepth value) (min rank (+ 1 (min depth prefix))))) :ruleset map-shapes)

; Compare each output with one anchor, rather than forming all output pairs.
(relation MapAnchor (FusionPlan SourceValue))
(function MapBlocked (FusionPlan) bool :merge (or old new))
(rule ((MapPlan plan owner extent)) ((set (MapBlocked plan) false)) :ruleset map-blockers)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element) (= (ArrayTypeRank element) 0))
      ((set (MapBlocked plan) true)) :ruleset map-blockers)
(rule ((MapPlan plan owner extent) (= totals (PlanTotals plan)) (= i (ResultCount totals))
       (PlanResult plan "array" i value element)) ((MapAnchor plan value)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= depth (MapDepth anchor))
       (PlanResult plan "array" i value element) (= other (MapDepth value)) (!= depth other))
      ((set (MapBlocked plan) true)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= depth (MapDepth anchor))
       (PlanResult plan "array" i value element)
       (= a (RectangularAxis anchor axis)) (> axis 0) (< axis depth)
       (= b (RectangularAxis value axis)) (!= a b))
      ((set (MapBlocked plan) true)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= extent (RectangularAxis anchor axis)) (> axis 0)
       (= (ExtentUniform extent) false)) ((set (MapBlocked plan) true)) :ruleset map-select)
(rule ((MapPlan plan owner extent) (= (MapBlocked plan) true)) ((set (IterationRank owner) 1)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= (MapHost plan) false))
      ((set (IterationRank owner) 1)) :ruleset map-launch)
(rule ((MapAnchor plan anchor) (= owner (Owner plan)) (= (MapHost plan) true) (= (MapBlocked plan) false) (= depth (MapDepth anchor)))
      ((set (IterationRank owner) (max 1 depth))) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= rank (IterationRank owner)))
      ((set (IterationAxis owner 0) extent)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= rank (IterationRank owner)) (MapAnchor plan anchor)
       (= n (RectangularAxis anchor axis)) (> axis 0) (< axis rank))
      ((set (IterationAxis owner axis) n)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (PlanResult plan "array" i value element) (= ty (SourceType value))
       (ArrayTypeAxis ty axis (DynamicSize)) (> axis 0))
      ((RectangularStorageShape value 0 ty (vec-of) (Fixed 1))) :ruleset storage-shapes)
