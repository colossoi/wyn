; One rectangular schedule per selected SCREMA. All policy precedes SSA emission.
(ruleset map-types)
(ruleset map-discover)
(ruleset map-repeatability)
(ruleset map-proofs)
(ruleset map-shapes)
(ruleset map-blockers)
(ruleset map-select)
(ruleset map-launch)
(function MapTypeRank (TypeKey) i64 :merge (max old new))
; shortcut: inner axes require fixed sizes until callback extent substitution is supported.
(function MapFixedPrefix (TypeKey) i64 :merge (max old new))
(relation MapTypeAxis (TypeKey i64 ArraySize))
(function MapHasOperation (SourceValue) bool :merge (or old new))
(function MapHasCallee (SourceValue) bool :merge (or old new))
(function MapScalarCallback (FusionPlan OperationKey) bool :merge (or old new))
(function MapHost (FusionPlan) bool :merge (or old new))
(rule ((Current group plan)) ((set (MapHost plan) false)) :ruleset map-types)
(rule ((Current group plan) (= scope (Scope plan)) (HostRegion scope)) ((set (MapHost plan) true)) :ruleset map-types)
(rule ((= ty (TypeId id))) ((set (MapTypeRank ty) 0) (set (MapFixedPrefix ty) 0)) :ruleset map-types)
(rule ((SourceArrayType ty) (SourceArrayElement ty element) (= n (MapTypeRank element)))
      ((set (MapTypeRank ty) (+ n 1))) :ruleset map-types)
(rule ((SourceArrayType ty) (= (SourceArraySize ty) (FixedSize size))
       (SourceArrayElement ty element) (= n (MapFixedPrefix element)))
      ((set (MapFixedPrefix ty) (+ n 1))) :ruleset map-types)
(rule ((SourceArrayType ty) (= size (SourceArraySize ty))) ((MapTypeAxis ty 0 size)) :ruleset map-types)
(rule ((SourceArrayType ty) (SourceArrayElement ty element) (MapTypeAxis element i size))
      ((MapTypeAxis ty (+ i 1) size)) :ruleset map-types)
(rule ((= ty (SourceType value))) ((set (MapHasOperation value) false)) :ruleset map-types)
(rule ((= op (SourceValueOperation value))) ((set (MapHasOperation value) true)) :ruleset map-types)
(rule ((= value (SourceInvocation scope function args))) ((set (MapHasCallee value) false)) :ruleset map-types)
(rule ((= callee (PlanCallee value))) ((set (MapHasCallee value) true)) :ruleset map-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping plan op) true))
      ((set (MapScalarCallback plan op) false)) :ruleset map-types)
(rule ((= plan (SelectedPlan op)) (= (PlanMapping plan op) true) (= body (PlanCallback plan op))
       (= result (SourceResult body)) (= ty (SourceType result)) (SourceScalarLayout ty))
      ((set (MapScalarCallback plan op) true)) :ruleset map-types)

(relation MapPlan (FusionPlan OperationKey Extent))
(relation MapDemand (SourceValue))
(relation MapCandidate (SourceValue FusionPlan OperationKey RegionKey))
(datatype MapContext (OutsidePlan) (InsidePlan FusionPlan))
(relation MapRequirement (SourceValue MapContext SourceValue))
(datatype MapCheck (Repeat MapContext SourceValue))
(sort MapChecks (Set MapCheck))
(function MapRequired (SourceValue) MapChecks :merge (set-union old new))
(function MapApproved (SourceValue) MapChecks :merge (set-union old new))
(relation MapCheckNeeded (MapContext SourceValue))
(rule ((Current group plan) (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= owner (Owner plan)) (= domain (PlanDomain plan)) (= extent (SourceDomainExtent domain)))
      ((MapPlan plan owner extent)) :ruleset map-discover)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true)
       (PlanResult plan "array" i value element) (SourceArrayType element))
      ((MapDemand value)) :ruleset map-discover)
(rule ((MapDemand value)) ((set (MapRequired value) (set-empty)) (set (MapApproved value) (set-empty))) :ruleset map-discover)
(rule ((MapDemand value) (= actual (SourceAlias value))) ((MapDemand actual)) :ruleset map-discover)
(rule ((MapDemand value) (= callee (PlanCallee value)) (= result (SourceResult callee)))
      ((MapDemand result)) :ruleset map-discover)
(rule ((MapDemand value) (= argument (PlanCallArgument value i)))
      ((MapRequirement value (OutsidePlan) argument)) :ruleset map-discover)
(rule ((MapDemand value) (= op (SourceValueOperation value)) (= plan (SelectedPlan op))
       (ScremaPlan plan) (= (HasScans plan) false) (= (HasReductions plan) false)
       (= (PlanMapping plan op) true) (= (SourceReadOnly value) true)
       (= ty (SourceType value)) (SourceArrayType ty) (= body (PlanCallback plan op)))
      ((MapCandidate value plan op body)) :ruleset map-discover)
(rule ((MapCandidate value plan op body) (= result (SourceResult body))) ((MapDemand result)) :ruleset map-discover)
(rule ((MapCandidate value plan op body) (SourceCapture body formal actual))
      ((MapRequirement value (OutsidePlan) actual)) :ruleset map-discover)
(rule ((MapCandidate value plan op body) (= input (PlanRoute plan op i)))
      ((MapRequirement value (InsidePlan plan) input)) :ruleset map-discover)
(rule ((MapRequirement value context input))
      ((set (MapRequired value) (set-of (Repeat context input))) (MapCheckNeeded context input)) :ruleset map-discover)

; shortcut: all legal repetitions have equal cost until cost-based scheduling is added.
(function MapCheckMapping (MapContext SourceValue) bool :no-merge)
(relation MapCheckEdge (MapContext SourceValue SourceValue))
(function MapRepeatable (MapContext SourceValue) bool :merge (and old new))
(rule ((= mapping (MapCheckMapping context value)))
      ((set (MapRepeatable context value) true)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (OutsidePlan) value)) ((set (MapCheckMapping (OutsidePlan) value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (InsidePlan plan) value) (= (MapHasOperation value) false))
      ((set (MapCheckMapping (InsidePlan plan) value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= other (SelectedPlan op)) (!= plan other))
      ((set (MapCheckMapping (InsidePlan plan) value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded (InsidePlan plan) value) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= mapping (PlanMapping plan op)))
      ((set (MapCheckMapping (InsidePlan plan) value) mapping)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping context value) false) (SourceDirectUse value child))
      ((MapCheckEdge context value child)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping context value) false) (SourceBranch value test yes no)
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((MapCheckEdge context value a) (MapCheckEdge context value b)) :ruleset map-repeatability)
(rule ((MapCheckNeeded context value) (= argument (PlanCallArgument value i)))
      ((MapCheckEdge context value argument)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping context value) false) (= op (SourceValueOperation value))
       (= (SourceDuplicable value) false)) ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded context value) (= (MapHasCallee value) false))
      ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((MapCheckNeeded context value) (= callee (PlanCallee value)) (= (SourceRegionDuplicable callee) false))
      ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= (MapScalarCallback plan op) false))
      ((set (MapRepeatable (InsidePlan plan) value) false)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (PlanCallback plan op)) (= result (SourceResult body)))
      ((MapCheckEdge (InsidePlan plan) value result)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value))
       (= body (PlanCallback plan op)) (SourceCapture body formal actual))
      ((MapCheckEdge (InsidePlan plan) value actual)) :ruleset map-repeatability)
(rule ((= (MapCheckMapping (InsidePlan plan) value) true) (= op (SourceValueOperation value)) (= input (PlanRoute plan op i)))
      ((MapCheckEdge (InsidePlan plan) value input)) :ruleset map-repeatability)
(rule ((MapCheckEdge context value child)) ((MapCheckNeeded context child)) :ruleset map-repeatability)
(rule ((MapCheckEdge context value child) (= (MapRepeatable context child) false))
      ((set (MapRepeatable context value) false)) :ruleset map-repeatability)
(rule ((MapRequirement value context input) (= (MapRepeatable context input) true))
      ((set (MapApproved value) (set-of (Repeat context input)))) :ruleset map-proofs)
(relation MapReady (SourceValue))
(rule ((MapDemand value) (= (MapRequired value) (MapApproved value))) ((MapReady value)) :ruleset map-shapes)

; Depth is bounded by the result type, including through recursive call links.
(function MapDepth (SourceValue) i64 :merge (max old new))
(rule ((MapDemand value)) ((set (MapDepth value) 0)) :ruleset map-shapes)
(rule ((MapDemand value) (= actual (SourceAlias value)) (= depth (MapDepth actual))
       (= ty (SourceType value)) (= rank (MapTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((MapDemand value) (MapReady value) (= callee (PlanCallee value)) (= result (SourceResult callee))
       (= depth (MapDepth result)) (= ty (SourceType value)) (= rank (MapTypeRank ty)))
      ((set (MapDepth value) (min rank depth))) :ruleset map-shapes)
(rule ((MapCandidate value plan op body) (MapReady value) (= result (SourceResult body))
       (= depth (MapDepth result)) (= ty (SourceType result)) (= fixed (MapFixedPrefix ty))
       (= output (SourceType value)) (= rank (MapTypeRank output)))
      ((set (MapDepth value) (min rank (+ 1 (min depth fixed))))) :ruleset map-shapes)

; Compare each output with one anchor, rather than forming all output pairs.
(function MapFirstOutput (FusionPlan) i64 :merge (min old new))
(relation MapAnchor (FusionPlan SourceValue))
(function MapBlocked (FusionPlan) bool :merge (or old new))
(rule ((MapPlan plan owner extent)) ((set (MapBlocked plan) false)) :ruleset map-blockers)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element))
      ((set (MapFirstOutput plan) i)) :ruleset map-blockers)
(rule ((MapPlan plan owner extent) (PlanResult plan "array" i value element) (= (MapTypeRank element) 0))
      ((set (MapBlocked plan) true)) :ruleset map-blockers)
(rule ((= i (MapFirstOutput plan)) (PlanResult plan "array" i value element)) ((MapAnchor plan value)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= depth (MapDepth anchor))
       (PlanResult plan "array" i value element) (= other (MapDepth value)) (!= depth other))
      ((set (MapBlocked plan) true)) :ruleset map-select)
(rule ((MapAnchor plan anchor) (= depth (MapDepth anchor)) (= ty (SourceType anchor))
       (PlanResult plan "array" i value element) (= other (SourceType value))
       (MapTypeAxis ty axis (FixedSize a)) (> axis 0) (< axis depth)
       (MapTypeAxis other axis (FixedSize b)) (!= a b))
      ((set (MapBlocked plan) true)) :ruleset map-select)
(function MapSelectedRank (FusionPlan) i64 :no-merge)
(rule ((MapPlan plan owner extent) (= (MapBlocked plan) true)) ((set (MapSelectedRank plan) 1)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= (MapHost plan) false))
      ((set (MapSelectedRank plan) 1)) :ruleset map-launch)
(rule ((MapAnchor plan anchor) (= (MapHost plan) true) (= (MapBlocked plan) false) (= depth (MapDepth anchor)))
      ((set (MapSelectedRank plan) (max 1 depth))) :ruleset map-launch)
(relation MapLaunchProduct (OperationKey i64 Extent))
(rule ((MapPlan plan owner extent) (= rank (MapSelectedRank plan)))
      ((set (MapLaunchRank owner) rank) (set (MapLaunchAxis owner 0) extent) (MapLaunchProduct owner 1 extent)) :ruleset map-launch)
(rule ((MapPlan plan owner extent) (= rank (MapSelectedRank plan)) (MapAnchor plan anchor) (= ty (SourceType anchor))
       (MapTypeAxis ty axis (FixedSize n)) (> axis 0) (< axis rank))
      ((set (MapLaunchAxis owner axis) (Fixed n))) :ruleset map-launch)
(rule ((MapLaunchProduct owner axis product) (= rank (MapLaunchRank owner)) (< axis rank)
       (= extent (MapLaunchAxis owner axis)))
      ((MapLaunchProduct owner (+ axis 1) (Product product extent))) :ruleset map-launch)
(rule ((= rank (MapLaunchRank owner)) (MapLaunchProduct owner rank extent))
      ((set (MapLaunch owner) extent)) :ruleset map-launch)
