(ruleset segment-shapes)
(ruleset segment-select)
(ruleset segment-approve)
(function SegmentCandidatePlan (SourceValue) FusionPlan :no-merge)
(function SegmentPlanBlocked (FusionPlan) bool :merge (or old new))

(datatype TraversalLeaf (EvaluateLeaf) (CollectiveLeaf))
(datatype OutputPort (TotalPort i64) (ArrayPort i64))
(datatype ParallelTraversal
  (TraversalValue SourceValue)
  (TraversalResult SourceValue OperationKey FusionPlan OutputPort Extent)
  (TraversalCall SourceValue RegionKey RegionKey SourceArguments ParallelTraversal)
  (TraversalFor RegionKey RegionKey FusionPlan SourceArguments ParallelTraversal))
(relation TraversalDemand (SourceValue i64 TraversalLeaf))
(relation TraversalContinue (SourceValue i64 TraversalLeaf))
(relation TraversalAdmitted (SourceValue TraversalLeaf))
(function Traversal (SourceValue i64 TraversalLeaf) ParallelTraversal :no-merge)
(function ElementTraversal (SourceValue i64) ParallelTraversal :no-merge)
(function MapOutputTraversal (OperationKey i64) ParallelTraversal :no-merge)

(function TraversalExtent (ParallelTraversal) Extent :no-merge)

; One executable traversal is also the witness used to admit nested collectives.
; Each For consumes one coordinate; leaves determine their own output addressing.
(ruleset map-bindings)

(rule ((Current group plan) (PlanMember plan op) (= (PlanMapping op) true)
       (= value (SourceOperationValue op)))
      ((TraversalDemand value 1 (EvaluateLeaf))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (= rank (IterationRank owner)) (PlanResult plan "array" i value element))
      ((TraversalDemand value rank (EvaluateLeaf))) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (= (MapHost plan) true) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element))
      ((TraversalDemand value rank (CollectiveLeaf))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth (EvaluateLeaf)))
      ((TraversalAdmitted value (EvaluateLeaf))) :ruleset segment-shapes)
(rule ((RectangularReady value)) ((TraversalAdmitted value (CollectiveLeaf))) :ruleset segment-shapes)
(rule ((TraversalDemand value 0 (EvaluateLeaf)))
      ((set (Traversal value 0 (EvaluateLeaf)) (TraversalValue value))) :ruleset segment-shapes)
(rule ((TraversalDemand value 0 (CollectiveLeaf)) (= plan (SegmentCandidatePlan value))
       (RectangularReady value) (= (SegmentPlanBlocked plan) false) (= owner (Owner plan))
       (= extent (RectangularExtent (SourceDomainExtent (PlanDomain plan))))
       (PlanResult plan "array" i value ty) (= totals (ResultCount (PlanTotals plan))))
      ((set (Traversal value 0 (CollectiveLeaf)) (TraversalResult value owner plan (ArrayPort (- i totals)) extent))) :ruleset segment-shapes)
(rule ((TraversalDemand value 0 (CollectiveLeaf)) (= plan (SegmentCandidatePlan value))
       (RectangularReady value) (= (SegmentPlanBlocked plan) false) (= owner (Owner plan))
       (= extent (RectangularExtent (SourceDomainExtent (PlanDomain plan))))
       (PlanResult plan "total" i value ty))
      ((set (Traversal value 0 (CollectiveLeaf)) (TraversalResult value owner plan (TotalPort i) extent))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth leaf) (> depth 0))
      ((TraversalContinue value depth leaf)) :ruleset segment-shapes)
(rule ((TraversalDemand value 0 (CollectiveLeaf)))
      ((TraversalContinue value 0 (CollectiveLeaf))) :ruleset segment-shapes)
(rule ((TraversalContinue value depth leaf) (= actual (SourceAlias value)))
      ((TraversalDemand actual depth leaf)) :ruleset segment-shapes)
(rule ((TraversalContinue value depth leaf) (= actual (SourceAlias value)) (= next (Traversal actual depth leaf)))
      ((set (Traversal value depth leaf) next)) :ruleset segment-shapes)
(rule ((TraversalContinue value depth leaf) (TraversalAdmitted value leaf)
       (= callee (SourceCallTarget value)) (= result (SourceResult callee)))
      ((TraversalDemand result depth leaf)) :ruleset segment-shapes)
(rule ((TraversalContinue value depth leaf) (TraversalAdmitted value leaf)
       (= value (SourceInvocation caller function args)) (= callee (SourceCallTarget value))
       (= next (Traversal (SourceResult callee) depth leaf)))
      ((set (Traversal value depth leaf) (TraversalCall value caller callee args next))) :ruleset segment-shapes)
(relation TraversalMap (SourceValue TraversalLeaf FusionPlan OperationKey RegionKey))
(rule ((TraversalDemand value depth (EvaluateLeaf)) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= (PlanMapping op) true) (= body (SourceOperatorBody op)))
      ((TraversalMap value (EvaluateLeaf) plan op body)) :ruleset segment-shapes)
(rule ((MapCandidate value plan op body) (RectangularReady value))
      ((TraversalMap value (CollectiveLeaf) plan op body)) :ruleset segment-shapes)
(rule ((TraversalContinue value depth leaf) (> depth 0) (TraversalMap value leaf plan op body) (= result (SourceResult body)))
      ((TraversalDemand result (- depth 1) leaf)) :ruleset segment-shapes)
(rule ((TraversalContinue value depth leaf) (> depth 0) (TraversalMap value leaf plan op body)
       (= caller (PlanScope plan))
       (= args (OperatorInputs op)) (= next (Traversal (SourceResult body) (- depth 1) leaf)))
      ((set (Traversal value depth leaf) (TraversalFor caller body plan args next))) :ruleset segment-shapes)

(relation WorkgroupOutputTraversal (ParallelTraversal))

; Extents are a fold over the admitted program, including call substitution.
(rule ((= t (TraversalResult value owner plan port extent))) ((set (TraversalExtent t) extent)) :ruleset segment-shapes)
(rule ((= t (TraversalCall value caller callee args next)) (= extent (TraversalExtent next)))
      ((set (TraversalExtent t) (CallExtent value extent))) :ruleset segment-shapes)
(rule ((= t (TraversalFor caller callee plan args next)) (= extent (TraversalExtent next)))
      ((set (TraversalExtent t) extent)) :ruleset segment-shapes)
(rule ((= extent (TraversalExtent t))) ((set (ExtentUniform extent) true)) :ruleset extent-uniformity)

(rule ((= traversal (Traversal value depth (EvaluateLeaf))))
      ((set (ElementTraversal value depth) traversal)) :ruleset map-bindings)
(rule ((MapPlan plan owner extent) (= (MapSegmented owner) false) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element) (= traversal (Traversal value rank (EvaluateLeaf))))
      ((set (MapOutputTraversal owner i) traversal)) :ruleset map-bindings)
(rule ((MapPlan plan owner extent) (= (MapSegmented owner) true) (= rank (IterationRank owner))
       (PlanResult plan "array" i value element) (= traversal (Traversal value rank (CollectiveLeaf))))
      ((set (MapOutputTraversal owner i) traversal)) :ruleset map-bindings)

(rule ((WorkgroupOutputTraversal (TraversalResult value owner plan port extent)) (= ty (SourceType value)) (SourceArrayType ty))
      ((StorageDemand value (StorageRoot))) :ruleset local-storage)

(rule ((= (MapExecution owner) (WorkgroupScope)) (= traversal (MapOutputTraversal owner i)))
      ((WorkgroupOutputTraversal traversal)) :ruleset local-storage)
(rule ((WorkgroupOutputTraversal (TraversalCall value caller callee args next)))
      ((WorkgroupOutputTraversal next)) :ruleset local-storage)
(rule ((WorkgroupOutputTraversal (TraversalFor caller callee plan args next)))
      ((WorkgroupOutputTraversal next)) :ruleset local-storage)
(rule ((WorkgroupOutputTraversal (TraversalValue value)) (= ty (SourceType value)) (SourceArrayType ty))
      ((StorageDemand value (StorageRoot))) :ruleset local-storage)
