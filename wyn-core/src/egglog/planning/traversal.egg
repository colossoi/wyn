(ruleset segment-shapes)

(datatype OutputPort (TotalPort i64) (ArrayPort i64))
(datatype ParallelTraversal
  (TraversalElement SourceValue i64)
  (TraversalField i64 ParallelTraversal)
  (TraversalReindex ParallelTraversal CoordinateFormulas)
  (TraversalChoice SourceValue RegionKey ParallelTraversal RegionKey ParallelTraversal)
  (TraversalValue SourceValue)
  (TraversalIndex SourceValue i64)
  (TraversalResult SourceValue OperationKey FusionPlan OutputPort Extent)
  (TraversalCall SourceValue RegionKey RegionKey SourceArguments ParallelTraversal)
  (TraversalFor RegionKey RegionKey FusionPlan SourceArguments ParallelTraversal))
(relation TraversalDemand (SourceValue i64))
(function Traversal (SourceValue i64) ParallelTraversal :no-merge)
(function ElementTraversal (SourceValue i64) ParallelTraversal :no-merge)
(function MapOutputTraversal (OperationKey i64) ParallelTraversal :no-merge)
(relation OutputTraversal (OperationKey i64 DomainShape ParallelTraversal))
(function TraversalExtent (ParallelTraversal) Extent :no-merge)

; The same region traversal can yield a value or write into a bound output.
; Establish direct-result forwarding before selecting a fallback value leaf.
(ruleset direct-outputs)
(ruleset traversal-leaves)
(ruleset map-bindings)
(function DirectOutput (SourceValue) ParallelTraversal :no-merge)
(function HasDirectOutput (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (HasDirectOutput value) false)) :ruleset direct-outputs)
(rule ((= traversal (DirectOutput value))) ((set (HasDirectOutput value) true)) :ruleset direct-outputs)
(rule ((TraversalPlan value plan) (RectangularReady value)
       (= (TraversalPlanBlocked plan) false) (= owner (Owner plan))
       (= extent (RectangularExtent (ShapeExtent (PlanDomain plan))))
       (PlanResult plan "array" i value ty) (= totals (ResultCount (PlanTotals plan))))
      ((set (DirectOutput value) (TraversalResult value owner plan (ArrayPort (- i totals)) extent))) :ruleset direct-outputs)
(rule ((TraversalPlan value plan)
       (= (TraversalPlanBlocked plan) false) (= owner (Owner plan))
       (= extent (RectangularExtent (ShapeExtent (PlanDomain plan))))
       (PlanResult plan "total" i value ty))
      ((set (DirectOutput value) (TraversalResult value owner plan (TotalPort i) extent))) :ruleset direct-outputs)
(rule ((= actual (SourceAlias value)) (= next (DirectOutput actual)))
      ((set (DirectOutput value) next)) :ruleset direct-outputs)
(rule ((RectangularReady value) (= value (SourceInvocation caller function args))
       (= callee (SourceCallTarget value)) (= next (DirectOutput (SourceResult callee))))
      ((set (DirectOutput value) (TraversalCall value caller callee args next))) :ruleset direct-outputs)
; A choice retains its active region and writes into the selected result view.
(rule ((= (SourceBranch value) (BranchInfo condition yes no))
       (= a (DirectOutput (SourceResult yes))) (= b (DirectOutput (SourceResult no))))
      ((set (DirectOutput value) (TraversalChoice condition yes a no b))) :ruleset direct-outputs)
(rule ((= ty (SourceType value)) (= (HasDirectOutput value) false))
      ((set (Traversal value 0) (TraversalValue value))) :ruleset traversal-leaves)
(rule ((= next (DirectOutput value))) ((set (Traversal value 0) next)) :ruleset traversal-leaves)

(rule ((SourceLoopCarry owner slot initial state next output true))
      ((TraversalDemand initial 1) (TraversalDemand next 1)) :ruleset segment-shapes)

(rule ((ElementAt value axes)) ((TraversalDemand value (vec-length axes))) :ruleset segment-shapes)

(rule ((Current group plan) (PlanMember plan op) (= (PlanMapping op) true)
       (= value (SourceOperationValue op))) ((TraversalDemand value 1)) :ruleset segment-shapes)
(rule ((MapPlan plan owner extent) (OutputDomain owner i shape) (= rank (ShapeRank shape)) (PlanResult plan "array" i value element))
      ((TraversalDemand value rank)) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= actual (SourceAlias value)))
      ((TraversalDemand actual depth)) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= actual (SourceAlias value)) (= next (Traversal actual depth)))
      ((set (Traversal value depth) next)) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= callee (SourceCallTarget value)) (= result (SourceResult callee)))
      ((TraversalDemand result depth)) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= value (SourceInvocation caller function args))
       (= callee (SourceCallTarget value)) (= next (Traversal (SourceResult callee) depth)))
      ((set (Traversal value depth) (TraversalCall value caller callee args next))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= (PlanMapping op) true) (= body (SourceOperatorBody op)) (= result (SourceResult body)))
      ((TraversalDemand result (- depth 1))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= op (SourceValueOperation value))
       (= plan (SelectedPlan op)) (= (PlanMapping op) true) (= body (SourceOperatorBody op))
       (= caller (PlanScope plan)) (= args (OperatorInputs op)) (= next (Traversal (SourceResult body) (- depth 1))))
      ((set (Traversal value depth) (TraversalFor caller body plan args next))) :ruleset segment-shapes)

(rule ((TraversalDemand value depth) (> depth 0) (= (SourceBranch value) (BranchInfo condition yes no))
       (= a (SourceResult yes)) (= b (SourceResult no)))
      ((TraversalDemand a depth) (TraversalDemand b depth)) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= (SourceBranch value) (BranchInfo condition yes no))
       (= a (Traversal (SourceResult yes) depth)) (= b (Traversal (SourceResult no) depth)))
      ((set (Traversal value depth) (TraversalChoice condition yes a no b))) :ruleset segment-shapes)

(relation WorkgroupOutputTraversal (ParallelTraversal))

; Extents are a fold over the admitted program, including call substitution.
(rule ((= t (TraversalResult value owner plan port extent))) ((set (TraversalExtent t) extent)) :ruleset segment-shapes)
(rule ((= t (TraversalCall value caller callee args next)) (= extent (TraversalExtent next)))
      ((set (TraversalExtent t) (CallExtent value extent))) :ruleset segment-shapes)
(rule ((= t (TraversalFor caller callee plan args next)) (= extent (TraversalExtent next))
       (= t (Traversal value depth)) (MapCandidate value plan op callee) (RectangularReady value))
      ((set (TraversalExtent t) extent)) :ruleset segment-shapes)
(rule ((= extent (TraversalExtent t))) ((set (ExtentUniform extent) true)) :ruleset extent-uniformity)

(rule ((= traversal (Traversal value depth)))
      ((set (ElementTraversal value depth) traversal)) :ruleset map-bindings)
(rule ((MapPlan plan owner extent) (OutputDomain owner i shape) (= rank (ShapeRank shape))
       (PlanResult plan "array" i value element) (= traversal (Traversal value rank)))
      ((OutputTraversal owner i shape traversal)) :ruleset map-bindings)

(rule ((WorkgroupOutputTraversal (TraversalResult value owner plan port extent)) (= ty (SourceType value)) (SourceArrayType ty))
      ((StorageDemand value (StorageRoot))) :ruleset local-storage)

(rule ((= (MapExecution owner) (WorkgroupScope)) (= traversal (MapOutputTraversal owner i)))
      ((WorkgroupOutputTraversal traversal)) :ruleset local-storage)
(rule ((WorkgroupOutputTraversal (TraversalCall value caller callee args next)))
      ((WorkgroupOutputTraversal next)) :ruleset local-storage)
(rule ((WorkgroupOutputTraversal (TraversalFor caller callee plan args next)))
      ((WorkgroupOutputTraversal next)) :ruleset local-storage)
(rule ((WorkgroupOutputTraversal (TraversalValue value)) (= ty (SourceType value)) (SourceArrayType ty))
      ((StorageDemand value (StorageRoot))) :ruleset local-storage)

(rule ((WorkgroupOutputTraversal (TraversalChoice condition yes a no b)))
      ((WorkgroupOutputTraversal a) (WorkgroupOutputTraversal b)) :ruleset local-storage)

(rule ((SegmentedOutput value owner i rank) (= parents (SegmentedPrefix (Result owner i) axis)) (< axis rank))
      ((TraversalDemand value axis)) :ruleset segment-shapes)

(rule ((TraversalDemand value depth) (> depth 0) (IndexTraversalBase value))
      ((set (Traversal value depth) (TraversalIndex value depth))) :ruleset segment-shapes)

(rule ((TraversalDemand value depth) (> depth 0) (= (SourceView value) (ReindexedArray base extent indices)))
      ((set (Traversal value depth) (TraversalReindex (TraversalIndex base depth) indices))) :ruleset segment-shapes)

; Structural element access uses the same coordinate/region interpreter as
; output distribution. TraversalElement respects the consuming plan's boundary.
(function StreamTraversal (SourceValue i64) ParallelTraversal :no-merge)
(function TraversalForwarded (SourceValue) bool :merge (or old new))
(rule ((= ty (SourceType value))) ((set (TraversalForwarded value) false)) :ruleset flow-structure)
(rule ((FlowForward value actual)) ((set (TraversalForwarded value) true)) :ruleset flow-structure)
(rule ((= t (TraversalFor caller callee plan args next)) (= input (SourceInput op i)) (= callee (SourceOperatorBody op)))
      ((TraversalDemand input 1)) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (FlowForward value actual))
      ((TraversalDemand actual depth) (set (StreamTraversal value depth) (TraversalElement actual depth))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0) (= (SourceView value) (ReindexedArray base extent indices)))
      ((TraversalDemand base depth)
       (set (StreamTraversal value depth) (TraversalReindex (TraversalElement base depth) indices))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0)
       (= (SourceProjection value) (ProjectionInfo parent i)) (= size (SourceArraySize (SourceType parent)))
       (= (TraversalForwarded value) false))
      ((TraversalDemand parent depth)
       (set (StreamTraversal value depth) (TraversalField i (TraversalElement parent depth)))) :ruleset segment-shapes)
(rule ((TraversalDemand value depth) (> depth 0)
       (= (RuntimeArrayJoin value) false) (= (HasViewStage value) false)
       (= (SourceBranch value) (BranchInfo condition yes no)) (= a (SourceResult yes)) (= b (SourceResult no)))
      ((set (StreamTraversal value depth) (TraversalChoice condition yes (TraversalElement a depth)
                                                                    no (TraversalElement b depth)))) :ruleset segment-shapes)

(rule ((= (SourceOutput output) (OutputInfo entry value ty true)))
      ((TraversalDemand value 1)) :ruleset segment-shapes)
