(relation ReadRowDemand (StatementId Binding ValueName Indices))
(function ReadRow (StatementId Binding ValueName Indices) Stms :no-merge)
(function FixedInfo (Function ValueInfo) ValueInfo :no-merge)
(function RowElement (ValueInfo) ElementType :no-merge)
(function RowShape (ValueInfo) Shape :no-merge)

; Strip-mine scalar and array reductions in the same Parallel/Fold language. The
; partial array is an ordinary binding, so allocation and host transport need
; no collective-specific representation or Rust reconstruction.
(ruleset collective-discover)
(ruleset collective-build)
(set (PrimitiveEffects "<" (ScalarElement (Bool))) (set-empty))
(function CollectiveGroups (Function Stm) i64 :merge (min old new))
(relation SplitReduction (Program Function Stm IndexExp IndexExp i64)) ; groups, chunk, width
(relation ReductionComponents (Stm IndexExp i64 Pattern Pattern ReturnInfos Results Results Stms Results))
(rule ((ContainsIndexExp (FunctionRoot function) size))
      ((set (KnownSize function size) false)) :ruleset schedule-cost)
(rule ((= n (StaticIndex function size))) ((set (KnownSize function size) true)) :ruleset schedule-cost)
(function CollectiveElements (Function Stm) BigInt :no-merge)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (DeviceKernel (AutomaticGrid))
           (IterationSpace flat vector-pattern-0) body)))
       (= (KnownSize function size) false)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((set (CollectiveElements function statement) (bigint 65536))) :ruleset collective-discover)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (DeviceKernel (AutomaticGrid))
           (IterationSpace flat vector-pattern-0) body)))
       (= (KnownSize function size) true) (= n (StaticIndex function size)) (>= n 0)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((set (CollectiveElements function statement) (bigint n))) :ruleset collective-discover)
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (DeviceKernel (AutomaticGrid))
           (IterationSpace flat vector-pattern-3)
           (ParallelBlock statements vector-pattern-2))))
       (= maximum (CollectiveGroups function statement)) (> maximum 1)
       (= width (SelectedWidth function (IterationSpace flat vector-pattern-1)
           vector-pattern-0))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind (Reduction commutative neutral combine) results))
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (DenseAxis index size))
       (= (vec-length vector-pattern-2) 1)
       (= (vec-get vector-pattern-2 0) (Fold kind (Reduction commutative neutral combine) results))
       (= (vec-length vector-pattern-3) 1)
       (= (vec-get vector-pattern-3 0) (DenseAxis index size)))
      ((let groups (IndexMax (IndexConstant 1) (IndexMin (IndexConstant maximum)
          (IndexDiv (IndexAdd size (IndexConstant (- width 1))) (IndexConstant width)))))
       (let chunk (IndexMax (IndexConstant 1)
          (IndexDiv (IndexAdd size (IndexSub groups (IndexConstant 1))) groups)))
       (SplitReduction program function statement groups chunk width)
       (CloneLambdaDemand (CollectiveStatement id 2 0) combine)) :ruleset collective-discover)
(rule ((SplitReduction program function statement groups chunk width))
      ((ReductionComponents statement groups 0 (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of) (vec-of))) :ruleset collective-build)
(relation ReductionComponent (Stm IndexExp i64 ValueInfo))
(rule ((ReductionComponents statement groups i partials pattern returns neutrals values loads loaded)
       (SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= (vec-get clauses 0) (Fold kind (Reduction order neutral (FunctionBody params signature body)) results))
       (< i (vec-length neutral)) (= (vec-get params i) (Parameter (BindValue name info) diet))
       (= fixed (FixedInfo function info)))
      ((ReductionComponent statement groups i fixed)
       (ReadRowDemand (CollectiveStatement id 3 i) (BindValue (CollectiveValue id 2 i) fixed)
          (CollectiveValue id 0 i) (vec-of (IndexValue (CollectiveValue id 3 0))))) :ruleset collective-build)
(rule ((ReductionComponents statement groups i partials pattern returns neutrals values loads loaded)
       (ReductionComponent statement groups i info) (= element (RowElement info)) (= shape (RowShape info)) (= ret (LaneReturn info))
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= (vec-get clauses 0) (Fold kind (Reduction order neutral combine) results))
       (= read (ReadRow (CollectiveStatement id 3 i) (BindValue (CollectiveValue id 2 i) info)
          (CollectiveValue id 0 i) (vec-of (IndexValue (CollectiveValue id 3 0))))))
      ((ReductionComponents statement groups (+ i 1)
          (vec-push partials (BindValue (CollectiveValue id 0 i) (ArrayValue element (vec-append (vec-of groups) shape))))
          (vec-push pattern (BindValue (CollectiveValue id 1 i) info)) (vec-push returns ret)
          (vec-push neutrals (Yield (vec-of) (ValueOperand (vec-get neutral i))))
          (vec-push values (Yield (vec-of) (ValueOperand (Var (CollectiveValue id 1 i)))))
          (vec-append loads read)
          (vec-push loaded (Yield (vec-of) (ValueOperand (Var (CollectiveValue id 2 i))))))) :ruleset collective-build)

; Totals and prefixes share the guarded first stage. Padded lanes contribute
; the identity without evaluating the mapped body or any of its effects.
(function ChunkBody (Stm IndexExp IndexExp) ParallelBody :no-merge)
(function ScanWork (FoldKind) bool :no-merge)
(set (ScanWork (Total)) false)
(set (ScanWork (InclusiveScan)) true)
(set (ScanWork (ExclusiveScan)) true)
(set (ScanWork (InclusiveScanAndTotal)) true)
(set (ScanWork (ExclusiveScanAndTotal)) true)
(function ChunkFold (FoldKind) FoldKind :no-merge)
(set (ChunkFold (Total)) (Total))
(set (ChunkFold (InclusiveScan)) (InclusiveScanAndTotal))
(set (ChunkFold (ExclusiveScan)) (ExclusiveScanAndTotal))
(set (ChunkFold (InclusiveScanAndTotal)) (InclusiveScanAndTotal))
(set (ChunkFold (ExclusiveScanAndTotal)) (ExclusiveScanAndTotal))
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat vector-pattern-1)
           (ParallelBlock statements vector-pattern-0))))
       (ReductionComponents statement groups i partials pattern returns neutrals values loads loaded)
       (= i (vec-length neutral)) (= i (vec-length results)) (= local-kind (ChunkFold kind))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind (Reduction commutative neutral combine) results))
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (DenseAxis index size)))
      ((set (ChunkBody statement groups chunk)
          (ParallelBlock (vec-of
              (Let (CollectiveStatement id 0 1) (vec-of (BindValue index (ScalarInfo (ScalarElement (I32))))) (vec-of)
                  (IndexOp (IndexAdd (IndexMul (IndexValue (CollectiveValue id 4 1)) chunk) (IndexValue (CollectiveValue id 4 2)))))
              (Let (CollectiveStatement id 0 2) (vec-of (BindValue flat (ScalarInfo (ScalarElement (I32))))) (vec-of) (Use (ValueOperand (Var index))))
              (Let (CollectiveStatement id 0 3) (vec-of (BindValue (CollectiveValue id 5 0) (ScalarInfo (ScalarElement (I32))))) (vec-of) (IndexOp size))
              (Let (CollectiveStatement id 0 4) (vec-of (BindValue (CollectiveValue id 5 1) (ScalarInfo (ScalarElement (Bool))))) (vec-of)
                  (PrimOp "<" (vec-of (Var index) (Var (CollectiveValue id 5 0)))))
              (Let (CollectiveStatement id 0 5) pattern (vec-of)
                  (If (Var (CollectiveValue id 5 1)) returns (Block statements results) (Block (vec-of) neutrals))))
              (vec-of (Fold local-kind (Reduction commutative neutral combine) values))))) :ruleset collective-build)
(function ChunkGrid (IndexExp i64) Grid :no-merge)
(function ChunkDomain (StatementId IndexExp IndexExp) Domain :no-merge)
(rule ((SplitReduction program function (Let id outputs certs expression) groups chunk width))
      ((set (ChunkGrid groups width) (Grid3D (vec-of groups (IndexConstant 1) (IndexConstant 1))
          (vec-of (IndexConstant width) (IndexConstant 1) (IndexConstant 1))))
       (set (ChunkGrid (IndexConstant 1) width) (Grid3D (vec-of (IndexConstant 1) (IndexConstant 1) (IndexConstant 1))
          (vec-of (IndexConstant width) (IndexConstant 1) (IndexConstant 1))))
       (set (ChunkDomain id groups chunk) (IterationSpace (CollectiveValue id 4 0) (vec-of
          (DenseAxis (CollectiveValue id 4 1) groups) (DenseAxis (CollectiveValue id 4 2) chunk))))) :ruleset collective-build)
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution domain
           (ParallelBlock statements vector-pattern-0))))
       (ReductionComponents statement groups i partials pattern returns neutrals values loads loaded)
       (= i (vec-length outputs)) (= i (vec-length neutral)) (= i (vec-length results))
       (= chunk-body (ChunkBody statement groups chunk)) (= grid (ChunkGrid groups width))
       (= chunk-domain (ChunkDomain id groups chunk)) (= final-grid (ChunkGrid (IndexConstant 1) width))
       (= next-combine (CloneLambda (CollectiveStatement id 2 0) combine))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold (Total) (Reduction commutative neutral combine) results)))
      ((set (PendingRewrite "collectives" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of
                  (Let (CollectiveStatement id 0 0) partials certs (Parallel (DeviceKernel grid) chunk-domain chunk-body))
                  (Let (CollectiveStatement id 1 0) outputs certs
                      (Parallel (DeviceKernel final-grid)
                          (IterationSpace (CollectiveValue id 3 1) (vec-of (DenseAxis (CollectiveValue id 3 0) groups)))
                          (ParallelBlock loads (vec-of (Fold (Total) (Reduction commutative neutral next-combine) loaded))))))))))
       (RewriteDemand "collectives" program)) :ruleset collective-build)

; Scan carries are an ordinary exclusive scan of group totals. The last map
; applies each carry on the left, preserving ordered, noncommutative reducers.
(relation ScanMode (FoldKind FoldKind bool)) ; original, carry stage, expose total
(ScanMode (InclusiveScan) (ExclusiveScan) false)
(ScanMode (ExclusiveScan) (ExclusiveScan) false)
(ScanMode (InclusiveScanAndTotal) (ExclusiveScanAndTotal) true)
(ScanMode (ExclusiveScanAndTotal) (ExclusiveScanAndTotal) true)
(function ScanTotal (Stm i64) Pattern :no-merge)
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution domain
           (ParallelBlock statements vector-pattern-0))))
       (ScanMode kind carry-kind false) (WalkAtoms neutral i) (< i (vec-length neutral))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind (Reduction order neutral combine) values)))
      ((set (ScanTotal statement i) (vec-of))) :ruleset collective-build)
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution domain
           (ParallelBlock statements vector-pattern-0))))
       (ScanMode kind carry-kind true) (WalkAtoms neutral i) (< i (vec-length neutral))
       (< (+ i (vec-length neutral)) (vec-length outputs))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind (Reduction order neutral combine) values)))
      ((set (ScanTotal statement i) (vec-of (vec-get outputs (+ i (vec-length neutral)))))) :ruleset collective-build)
(relation ScanComponents (Stm IndexExp IndexExp i64 Pattern Pattern Pattern Pattern Stms Pattern Arguments Arguments Results))
; local prefixes, group carries, published prefixes/totals, final loads,
; combiner outputs/left args/right args, final collected results
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution domain
           (ParallelBlock statements vector-pattern-0)))) (ScanMode kind carry-kind totals)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind reducer values)))
      ((ScanComponents statement groups chunk 0 (vec-of) (vec-of) (vec-of) (vec-of) (vec-of)
          (vec-of) (vec-of) (vec-of) (vec-of))) :ruleset collective-build)
(rule ((ScanComponents statement groups chunk i prefixes carries published totals reads applied left right results)
       (ReductionComponent statement groups i info)
       (= statement (Let id outputs certs expression)))
      ((ReadRowDemand (CollectiveStatement id 6 i) (BindValue (CollectiveValue id 8 i) info) (CollectiveValue id 6 i)
          (vec-of (IndexDiv (IndexValue (CollectiveValue id 11 0)) chunk) (IndexMod (IndexValue (CollectiveValue id 11 0)) chunk)))
       (ReadRowDemand (CollectiveStatement id 7 i) (BindValue (CollectiveValue id 9 i) info) (CollectiveValue id 7 i)
          (vec-of (IndexDiv (IndexValue (CollectiveValue id 11 0)) chunk)))) :ruleset collective-build)
(rule ((ScanComponents statement groups chunk i prefixes carries published totals reads applied left right results)
       (ReductionComponent statement groups i info) (= element (RowElement info)) (= shape (RowShape info))
       (= statement (Let id outputs certs expression)) (= total (ScanTotal statement i)) (< i (vec-length outputs))
       (= prefix-read (ReadRow (CollectiveStatement id 6 i) (BindValue (CollectiveValue id 8 i) info) (CollectiveValue id 6 i)
          (vec-of (IndexDiv (IndexValue (CollectiveValue id 11 0)) chunk) (IndexMod (IndexValue (CollectiveValue id 11 0)) chunk))))
       (= carry-read (ReadRow (CollectiveStatement id 7 i) (BindValue (CollectiveValue id 9 i) info) (CollectiveValue id 7 i)
          (vec-of (IndexDiv (IndexValue (CollectiveValue id 11 0)) chunk)))))
      ((ScanComponents statement groups chunk (+ i 1)
          (vec-push prefixes (BindValue (CollectiveValue id 6 i) (ArrayValue element (vec-append (vec-of groups chunk) shape))))
          (vec-push carries (BindValue (CollectiveValue id 7 i) (ArrayValue element (vec-append (vec-of groups) shape))))
          (vec-push published (vec-get outputs i)) (vec-append totals total)
          (vec-append reads (vec-append prefix-read carry-read))
          (vec-push applied (BindValue (CollectiveValue id 10 i) info))
          (vec-push left (Pass (ValueOperand (Var (CollectiveValue id 9 i))) (Observe)))
          (vec-push right (Pass (ValueOperand (Var (CollectiveValue id 8 i))) (Observe)))
          (vec-push results (Yield (vec-of) (ValueOperand (Var (CollectiveValue id 10 i))))))) :ruleset collective-build)
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution domain
           (ParallelBlock statements vector-pattern-0))))
       (ScanComponents statement groups chunk i prefixes carries published totals reads applied left right results)
       (= i (vec-length neutral)) (= i (vec-length values))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind (Reduction order neutral combine) values)))
      ((ApplyLambdaDemand (CollectiveStatement id 8 0) applied certs combine (vec-append left right))) :ruleset collective-build)
(rule ((SplitReduction program function statement groups chunk width)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat vector-pattern-1)
           (ParallelBlock statements vector-pattern-0))))
       (ScanMode kind carry-kind expose-total)
       (ReductionComponents statement groups i partials pattern returns neutrals guarded loads loaded)
       (ScanComponents statement groups chunk i prefixes carries published totals reads applied left right results)
       (= i (vec-length neutral)) (= i (vec-length values)) (= (+ (vec-length published) (vec-length totals)) (vec-length outputs))
       (= chunk-body (ChunkBody statement groups chunk)) (= grid (ChunkGrid groups width))
       (= chunk-domain (ChunkDomain id groups chunk)) (= carry-grid (ChunkGrid (IndexConstant 1) width))
       (= next-combine (CloneLambda (CollectiveStatement id 2 0) combine))
       (= application (ApplyLambda (CollectiveStatement id 8 0) applied certs combine (vec-append left right)))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (Fold kind (Reduction order neutral combine) values))
       (= (vec-length vector-pattern-1) 1)
       (= (vec-get vector-pattern-1 0) (DenseAxis index size)))
      ((set (PendingRewrite "collectives" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of
                  (Let (CollectiveStatement id 0 0) (vec-append prefixes partials) certs
                      (Parallel (DeviceKernel grid) chunk-domain chunk-body))
                  (Let (CollectiveStatement id 1 0) (vec-append carries totals) certs
                      (Parallel (DeviceKernel carry-grid)
                          (IterationSpace (CollectiveValue id 3 1) (vec-of (DenseAxis (CollectiveValue id 3 0) groups)))
                          (ParallelBlock loads (vec-of (Fold carry-kind (Reduction order neutral next-combine) loaded)))))
                  (Let (CollectiveStatement id 9 0) published certs
                      (Parallel (DeviceKernel (AutomaticGrid))
                          (IterationSpace (CollectiveValue id 11 1) (vec-of (DenseAxis (CollectiveValue id 11 0) size)))
                          (ParallelBlock (vec-append reads application) (vec-of (Collect results))))))))))
       (RewriteDemand "collectives" program)) :ruleset collective-build)

; A large fused body is evaluated once into ordinary arrays before splitting
; its result clauses. Each fold then uses the same scan/reduction decomposition.
; Small fused bodies keep the single cooperative kernel.
(relation SeparateClauses (Program Function Stm))
(relation SeparatePrefix (Stm i64 Pattern ParallelResults Stms))
(function ClausePattern (Pattern ParallelResults i64 i64) Pattern :no-merge)
(relation FoldInputs (Stm i64 i64 Pattern Stms Results))
(rule ((CurrentProgram program) (ProgramFunction program function)
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id outputs certs (Parallel (DeviceKernel (AutomaticGrid)) domain (ParallelBlock statements clauses))))
       (= domain (IterationSpace flat vector-pattern-0)) (> (vec-length clauses) 1)
       (= maximum (CollectiveGroups function statement)) (> maximum 1)
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((SeparateClauses program function statement) (SeparatePrefix statement 0 (vec-of) (vec-of) (vec-of))) :ruleset collective-discover)
(rule ((SeparatePrefix statement i mapped clauses tail)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements original))))
       (< i (vec-length original)))
      ((set (ClausePattern outputs original i 0) (vec-of))) :ruleset collective-build)
(rule ((= prefix (ClausePattern outputs clauses i j)) (= offset (ClauseOffset clauses i))
       (= arity (ClauseArity (vec-get clauses i))) (< j arity) (< (+ offset j) (vec-length outputs)))
      ((set (ClausePattern outputs clauses i (+ j 1)) (vec-push prefix (vec-get outputs (+ offset j))))) :ruleset collective-build)
(rule ((SeparatePrefix statement i mapped clauses tail)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements original))))
       (< i (vec-length original)) (= clause (vec-get original i)) (= clause (Collect values))
       (= arity (ClauseArity clause)) (= pattern (ClausePattern outputs original i arity)))
      ((SeparatePrefix statement (+ i 1) (vec-append mapped pattern) (vec-push clauses clause) tail)) :ruleset collective-build)
(rule ((SeparatePrefix statement i mapped clauses tail)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements original))))
       (< i (vec-length original)) (= clause (vec-get original i)) (= clause (Contribute tokens))
       (= arity (ClauseArity clause)) (= pattern (ClausePattern outputs original i arity)))
      ((SeparatePrefix statement (+ i 1) (vec-append mapped pattern) (vec-push clauses clause) tail)) :ruleset collective-build)
(rule ((SeparatePrefix statement i mapped clauses tail)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements original))))
       (< i (vec-length original)) (= (vec-get original i) (Fold kind reducer values)))
      ((FoldInputs statement i 0 (vec-of) (vec-of) (vec-of))) :ruleset collective-build)
(relation MaterializedFoldInput (Stm i64 i64 ValueInfo))
(rule ((FoldInputs statement i j arrays loads loaded) (SeparateClauses program function statement)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements clauses))))
       (= (vec-get clauses i) (Fold kind (Reduction order neutral (FunctionBody params returns body)) values))
       (< j (vec-length neutral)) (= (vec-get params j) (Parameter (BindValue name info) diet)) (= fixed (FixedInfo function info)))
      ((let stage (CollectiveStatement id 20 i))
       (MaterializedFoldInput statement i j fixed)
       (ReadRowDemand (CollectiveStatement stage 0 j) (BindValue (CollectiveValue stage 2 j) fixed)
          (CollectiveValue stage 1 j) (vec-of (IndexValue (CollectiveValue stage 0 0))))) :ruleset collective-build)
(rule ((FoldInputs statement i j arrays loads loaded) (MaterializedFoldInput statement i j info)
       (= element (RowElement info)) (= shape (RowShape info))
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat axes) body)))
       (= (vec-length axes) 1) (= (vec-get axes 0) (DenseAxis index size))
       (= stage (CollectiveStatement id 20 i))
       (= read (ReadRow (CollectiveStatement stage 0 j) (BindValue (CollectiveValue stage 2 j) info)
          (CollectiveValue stage 1 j) (vec-of (IndexValue (CollectiveValue stage 0 0))))))
      ((FoldInputs statement i (+ j 1)
          (vec-push arrays (BindValue (CollectiveValue stage 1 j) (ArrayValue element (vec-append (vec-of size) shape))))
          (vec-append loads read) (vec-push loaded (Yield (vec-of) (ValueOperand (Var (CollectiveValue stage 2 j))))))) :ruleset collective-build)
(rule ((SeparatePrefix statement i mapped clauses tail)
       (= statement (Let id outputs certs (Parallel execution (IterationSpace flat vector-pattern-0)
           (ParallelBlock statements original))))
       (< i (vec-length original)) (= clause (vec-get original i)) (= clause (Fold kind (Reduction order neutral combine) values))
       (= arity (ClauseArity clause)) (= pattern (ClausePattern outputs original i arity))
       (FoldInputs statement i j arrays loads loaded) (= j (vec-length neutral)) (= j (vec-length values))
       (= (vec-length vector-pattern-0) 1)
       (= (vec-get vector-pattern-0 0) (DenseAxis index size)))
      ((let stage (CollectiveStatement id 20 i))
       (SeparatePrefix statement (+ i 1) (vec-append mapped arrays) (vec-push clauses (Collect values))
          (vec-push tail (Let (CollectiveStatement stage 3 0) pattern certs
              (Parallel (DeviceKernel (AutomaticGrid))
                  (IterationSpace (CollectiveValue stage 0 1) (vec-of (DenseAxis (CollectiveValue stage 0 0) size)))
                  (ParallelBlock loads (vec-of (Fold kind (Reduction order neutral combine) loaded)))))))) :ruleset collective-build)
(rule ((SeparateClauses program function statement)
       (= statement (Let id outputs certs (Parallel execution domain (ParallelBlock statements original))))
       (SeparatePrefix statement i mapped clauses tail) (= i (vec-length original)))
      ((set (PendingRewrite "collectives" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-append
                  (vec-of (Let (CollectiveStatement id 21 0) mapped certs
                      (Parallel (DeviceKernel (AutomaticGrid)) domain (ParallelBlock statements clauses)))) tail)))))
       (RewriteDemand "collectives" program)) :ruleset collective-build)

; Materialized state determines the cooperative footprint. Shape witnesses
; proven invariant do not consume the accumulator's working-set budget.
(ruleset collective-memory-analysis)
(ruleset collective-memory-build)
(function FoldStateBytes (Function ParallelResult i64) i64 :no-merge)
(function FoldWorkingBytes (Function ParallelResult i64) i64 :no-merge)
(function FoldSlotBytes (Function ParallelResult i64) i64 :no-merge)
(function FoldSlotInvariant (Function ParallelResult i64) bool :merge (or old new))
(function ShapeElements (Function Shape i64) i64 :no-merge)
(function CooperativeFold (Function ParallelResult) bool :merge (or old new))
(function FoldWidth (Function ParallelResult) i64 :no-merge)
