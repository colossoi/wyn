(ruleset layout-fusion)
(ruleset layout-fusion-select)
(relation LayoutRead (OperationKey OperationKey ValueName))
(relation ForwardLayoutExtent (OperationKey IndexExp))
(relation LayoutProducer (OperationKey OperationKey OperationKey ValueName))
(function LayoutLegal (OperationKey) bool :merge (and old new))
(relation FuseLayout (OperationKey OperationKey OperationKey))
; The transform's imported read carries its source coordinates explicitly.
(rule ((= transform (wyn-array-layout layout)) (LiveOperation layout)
       (= (ResultCount layout) 1) (= (wyn-contribution-count layout 0) 1)
       (= value (wyn-contribution layout 0 0)) (ResultOrigin value read 0)
       (IndexOperation read) (= (wyn-input-count read) 3) (ProvenTotalOperation read)
       (= (wyn-region-of read) (wyn-control-region layout 0))
       (= (wyn-input read 0) (ValueNameRef source)))
      ((LayoutRead layout read source)) :ruleset layout-fusion)
; A composed domain can supply the extents without reading the original collection.
(rule ((LayoutRead layout read source) (ForwardLength operation extent)
       (= (wyn-input operation 0) (ValueNameRef source)))
      ((ForwardLayoutExtent operation extent)) :ruleset layout-fusion)
(rule ((LayoutRead layout read source)
       (ResultOrigin (ValueNameRef source) producer 0) (= parent (wyn-region-of producer))
       (= parent (wyn-region-of layout))
       (< (wyn-operation-position producer) (wyn-operation-position layout))
       (ParallelOperation producer) (= (DomainRank (OperationDomain producer)) 2)
       (= (ResultCount producer) 1) (= (wyn-contribution-count producer 0) 1)
       (= (wyn-output-count producer) 1) (= (ResultKindOf producer 0) (Collected)))
      ((LayoutProducer producer layout read source) (set (LayoutLegal layout) true)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (OperationWrite producer resource))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (= parent (wyn-region-of producer))
       (= parent (wyn-region-of between)) (OperationWrite between resource)
       (< (wyn-operation-position producer) (wyn-operation-position between)) (< (wyn-operation-position between) (wyn-operation-position layout)))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (OperationTrap producer))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (InvocationDependent producer))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (DirectOperationUse user (ValueNameRef source)) (!= user read))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (EndDemand region (ValueNameRef source)))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
; Distributed map bodies use the coordinate parameters in place of the ordinal.
(relation LayoutOrdinal (OperationKey Name))
(rule ((LayoutProducer producer layout read source) (= ordinal (DomainOrdinal (OperationDomain producer))))
      ((LayoutOrdinal layout (ValueNameRef ordinal))) :ruleset layout-fusion)
(rule ((LayoutOrdinal layout name) (DirectOperationUse operation name))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutOrdinal layout name) (EndDemand region name))
      ((set (LayoutLegal layout) false)) :ruleset layout-fusion)
(rule ((LayoutProducer producer layout read source) (= (LayoutLegal layout) true))
      ((FuseLayout producer layout read)) :ruleset layout-fusion-select)
