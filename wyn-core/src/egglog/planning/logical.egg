; Choose execution strategies while arrays retain their logical structure.
(ruleset placement-context)
(ruleset placement-select)
(function HostScope (ScopeContext) bool :no-merge)
(function EntryFunction (FunctionName) bool :merge (or old new))
(relation DenseDomain (DomainAxes))
(function KernelPreparation (Function Exp) bool :merge (or old new))
(relation NeutralPreparation (Function Exp))
(rule ((ContainsExp (FunctionRoot function) expression) (= expression (Parallel execution domain body)))
      ((set (KernelPreparation function expression) false)) :ruleset placement-context)
; Small total neutral constructions can execute in the consuming invocation.
(rule ((ContainsReducer (FunctionRoot function) (Reduction order neutral combine))
       (WalkAtoms neutral i)
       (< i (vec-size neutral))
       (= (AtomsAt neutral i) (Var value))
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern proofs expression))
       (= expression (Parallel execution domain body))
       (= pattern indexed_vector_0)
       (= count (LogicalOuterCount function value))
       (= n (StaticIndex function count))
       (>= n 0)
       (= element-bytes (LogicalBytes element))
       (<= (* (bigint n) element-bytes) (bigint 16384))
       (= (MovableEffects function statement) (set-empty))
       (= (vec-size indexed_vector_0) 1)
       (= (PatternAt indexed_vector_0 0) (BindValue value (LogicalValue (ArrayType ownership extents element)))))
      ((NeutralPreparation function expression)) :ruleset schedule-cost)
(function DenseAxes (DomainAxes i64) bool :no-merge)
(rule ((= domain (IterationSpace flat axes))) ((set (DenseAxes axes 0) true)) :ruleset placement-context)
(rule ((= (DenseAxes axes i) true)
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis name size)))
      ((set (DenseAxes axes (+ i 1)) true)) :ruleset placement-context)
(rule ((= (DenseAxes axes (vec-size axes)) true)) ((DenseDomain axes)) :ruleset placement-context)
(rule ((ProgramFunction program (DefineFunction name params returns body)))
      ((set (EntryFunction name) false) (set (InvocationEntry name) false)) :ruleset placement-context)
(rule ((ContainsEntry (ProgramRoot program) (EntryPoint name identity)))
      ((set (EntryFunction name) true)) :ruleset placement-context)
(rule ((CheckFunction function) (= function (DefineFunction name params returns body))
       (= entry (EntryFunction name)) (= invocation (InvocationEntry name))
       (= generated (GeneratedDispatches)) (= lane (LaneDependentFunction function)))
      ((set (HostScope (FunctionScope function)) (and generated (and entry (not (or invocation lane)))))) :ruleset placement-context)
(rule ((CheckStatement context id pattern (If condition returns yes no) available) (= host (HostScope context)))
      ((set (HostScope (NestedScope context id 0)) host) (set (HostScope (NestedScope context id 1)) host)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Loop merges form returns body) available)
       (= host (HostScope context)) (= function (ScopeRoot context))
       (= local (LocalLoop function (Loop merges form returns body))))
      ((set (HostScope (NestedScope context id 0))
          (and host (not local)))) :ruleset placement-context)
(rule ((CheckStatement context id pattern (WithAcc inputs body) available) (= host (HostScope context)))
      ((set (HostScope (NestedScope context id 0)) host)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (Parallel execution domain body) available))
      ((set (HostScope (NestedScope context id 0)) false)) :ruleset placement-context)
(rule ((= context (ReducerScope parent i))) ((set (HostScope context) false)) :ruleset placement-context)
(rule ((CheckStatement context id pattern (BucketScatter destination lambda sources mappings rank) available))
      ((set (HostScope (NestedScope context id 0)) false)) :ruleset placement-context)
(rule ((AccInputAt context id inputs available i)
       (< i (vec-size inputs))
       (= (AccInputsAt inputs i) (AccumulatorInput arrays (CombineWrites combine))))
      ((set (HostScope (NestedScope context id (+ i 1))) false)) :ruleset placement-context)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (= (HostScope context) true) (= function (DefineFunction name params returns function-body))
       (= (KernelPreparation function (Parallel (Unscheduled) domain body)) false)
       (= grid (EntryGrid name))
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Parallel (Unscheduled) domain body))))
      ((set (LocalRewriteCandidates "placement" program function) (set-of (set-of
        (ReplaceStatement id (Let id pattern certs (Parallel (DeviceKernel grid) domain body))))))) :ruleset placement-select)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern expression available)
       (= expression (Parallel (Unscheduled) domain body))
       (= (HostScope context) true) (= (KernelPreparation function expression) true)
       (ContainsStm (FunctionRoot function) (Let id pattern certs expression)))
      ((set (LocalRewriteCandidates "placement" program function) (set-of (set-of
        (ReplaceStatement id (Let id pattern certs (Parallel (InvocationLocal) domain body))))))) :ruleset placement-select)
(rule ((CurrentProgram program) (ProgramFunction program function) (= function (ScopeRoot context))
       (CheckStatement context id pattern (Parallel (Unscheduled) domain body) available)
       (= (HostScope context) false)
       (ContainsStm (FunctionRoot function) (Let id pattern certs (Parallel (Unscheduled) domain body))))
      ((set (LocalRewriteCandidates "placement" program function) (set-of (set-of
        (ReplaceStatement id (Let id pattern certs (Parallel (InvocationLocal) domain body))))))) :ruleset placement-select)

; Collapse a uniform map nest by composing its actual domains and results.
; Prefixes may be repeated only when total and cheap enough; no row buffer or
; auxiliary traversal tree survives the contraction.
(ruleset distribution-analysis)
(ruleset distribution-select)
(relation DistributionCandidate (Program Function Stm Stm Stms Names))
(function DistributionSafe (Program Stm) bool :merge (and old new))
(rule ((DistributionCandidate program function outer inner prefix available)
       (= inner (Let id pattern proofs (Parallel execution domain (ParallelBlock statements results))))
       (WalkParallelResults results i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Compact predicate values)))
      ((set (DistributionSafe program outer) false)) :ruleset distribution-analysis)
(relation ReturnedPattern (Pattern Results i64))
(relation RepeatablePrefix (Function Domain Stms i64))
(function CanonicalAxes (Function DomainAxes i64) DomainAxes :no-merge)
(relation CanonicalDomain (Function Domain Domain))
(function EstimatedDomain (Function DomainAxes i64) BigInt :no-merge)
; Dense-domain coordinates are derived relationally; constructor rebuilds may alias equivalent prefixes.
(relation DomainOrdinal (DomainAxes i64 IndexExp))
(function ParallelClauses (ParallelBody) ParallelResults :no-merge)
(function HasFold (ParallelResults) bool :merge (or old new))
(rule ((= body (ParallelBlock statements results)))
      ((set (ParallelClauses body) results) (set (HasFold results) false)) :ruleset distribution-analysis)
(rule ((WalkParallelResults results i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Fold kind reducer values)))
      ((set (HasFold results) true)) :ruleset distribution-analysis)
(rule ((ContainsExp (FunctionRoot function) (Parallel execution (IterationSpace flat axes) body)))
      ((set (EstimatedDomain function axes 0) (bigint 1))
       (DomainOrdinal axes 0 (IndexConstant 0))) :ruleset distribution-analysis)
(rule ((= n (EstimatedDomain function axes i))
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis name size))
       (= size-n (StaticIndex function size)))
      ((set (EstimatedDomain function axes (+ i 1)) (* n (bigint (max 0 size-n))))) :ruleset distribution-analysis)
(rule ((= n (EstimatedDomain function axes i))
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis name size))
       (= (KnownSize function size) false))
      ((set (EstimatedDomain function axes (+ i 1)) (* n (bigint 1024)))) :ruleset distribution-analysis)
(rule ((DomainOrdinal axes i ordinal)
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis index size)))
      ((DomainOrdinal axes (+ i 1) (IndexAdd (IndexMul ordinal size) (IndexValue index)))) :ruleset distribution-analysis)
(rule ((ContainsExp (FunctionRoot function)
          (Parallel execution domain (ParallelBlock statements clauses))))
      ((RepeatablePrefix function domain statements 0)) :ruleset distribution-analysis)
(rule ((RepeatablePrefix function domain statements i)
       (< i (vec-size statements))
       (= statement (StmsAt statements i))
       (= statement (Let id pattern certs expression))
       (= (EffectsStm function statement) (set-empty))
       (TotalScalarForm expression))
      ((RepeatablePrefix function domain statements (+ i 1))) :ruleset distribution-analysis)
(rule ((RepeatablePrefix function domain statements i)
       (< i (vec-size statements))
       (= (StmsAt statements i) (Let id pattern certs expression))
       (DomainRead function domain expression))
      ((RepeatablePrefix function domain statements (+ i 1))) :ruleset distribution-analysis)

; Substitute proven dimensions before testing whether a nested extent is uniform.
; A row's fixed type can prove its length even when its value is lane-dependent.
(rule ((ContainsDomain (FunctionRoot function) (IterationSpace flat axes)))
      ((set (CanonicalAxes function axes 0) (vec-of))) :ruleset distribution-analysis)
(rule ((= prefix (CanonicalAxes function axes i))
       (< i (vec-size axes))
       (= (DomainAxesAt axes i) (DenseAxis index size))
       (= n (StaticIndex function size)))
      ((set (CanonicalAxes function axes (+ i 1)) (vec-push prefix (DenseAxis index (IndexConstant n))))
       (set (StaticIndex function (IndexConstant n)) n)) :ruleset distribution-analysis)
(rule ((= prefix (CanonicalAxes function axes i))
       (< i (vec-size axes))
       (= axis (DomainAxesAt axes i))
       (= axis (DenseAxis index size))
       (= (KnownSize function size) false))
      ((set (CanonicalAxes function axes (+ i 1)) (vec-push prefix axis))) :ruleset distribution-analysis)
(rule ((ContainsDomain (FunctionRoot function) domain) (= domain (IterationSpace flat axes))
       (= canonical (CanonicalAxes function axes (vec-size axes))))
      ((CanonicalDomain function domain (IterationSpace flat canonical))
       (set (EstimatedDomain function canonical 0) (bigint 1))
       (DomainOrdinal canonical 0 (IndexConstant 0))) :ruleset distribution-analysis)


(rule ((CurrentProgram program)
       (ProgramFunction program function)
       (CheckStatement context id pattern (Parallel execution outer body) available)
       (= function (ScopeRoot context))
       (= body (ParallelBlock statements clauses))
       (= results (ForwardedResults clauses))
       (= last (- (vec-size statements) 1))
       (>= last 0)
       (RepeatablePrefix function outer statements last)
       (= inner (StmsAt statements last))
       (= inner (Let iid ipattern proofs (Parallel inner-execution old-domain inner-body)))
       (CanonicalDomain function old-domain domain)
       (= outer (IterationSpace oflat outer-axes))
       (DenseDomain outer-axes)
       (= domain (IterationSpace iflat inner-axes))
       (DenseDomain inner-axes)
       (= free (set-diff (NamesDomain domain) (BindersDomain domain)))
       (= (set-diff free available) (set-empty))
       (= (set-diff (NamesCertificates proofs) available) (set-empty))
       (= (vec-size ipattern) (vec-size results))
       (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel execution outer body))))
      ((ReturnedPattern ipattern results 0)
       (DistributionCandidate program function statement (Let iid ipattern proofs (Parallel inner-execution domain inner-body)) (vec-remove statements last) available)
       (set (DistributionSafe program statement) true)) :ruleset distribution-analysis)
(rule ((ReturnedPattern pattern results i)
       (< i (vec-size pattern))
       (= (PatternAt pattern i) (BindValue name info))
       (= (ResultsAt results i) (Yield proofs (ValueOperand (Var name))))
       (= proofs (vec-of)))
      ((ReturnedPattern pattern results (+ i 1))) :ruleset distribution-analysis)
(rule ((DistributionCandidate program function outer inner prefix available)
       (= inner (Let id pattern certs (Parallel execution domain (ParallelBlock statements results))))
       (WalkParallelResults results i)
       (< i (vec-size results))
       (= (ParallelResultsAt results i) (Fold kind reducer values))
       (= free (set-diff (NamesReducer reducer) (BindersReducer reducer)))
       (!= (set-diff free available) (set-empty)))
      ((set (DistributionSafe program outer) false)) :ruleset distribution-analysis)
; Selection is supplied by the calibrated numeric cost primitive. Its inputs
; contain no graph handles and cannot reconstruct another semantic plan.
(relation DistributeNest (Program Function Stm Stm Stms))
(rule ((DistributeNest program function outer inner prefix)
       (= outer (Let id pattern certs (Parallel execution (IterationSpace oflat outer-axes)
          (ParallelBlock statements outer-results))))
       (= inner (Let iid ipattern proofs (Parallel inner-execution (IterationSpace iflat inner-axes)
          (ParallelBlock body results))))
       (DomainOrdinal outer-axes (vec-size outer-axes) outer-ordinal)
       (DomainOrdinal inner-axes (vec-size inner-axes) inner-ordinal))
      ((let flat (ScheduleValue iid 40 0))
       (let coordinates (vec-of
          (Let (ScheduleStatement iid 40 0) (vec-of (BindValue oflat (ScalarInfo (ScalarElement (I32))))) (vec-of)
              (IndexOp outer-ordinal))
          (Let (ScheduleStatement iid 40 1) (vec-of (BindValue iflat (ScalarInfo (ScalarElement (I32))))) (vec-of)
              (IndexOp inner-ordinal))))
       (set (PendingRewrite "distribution" program) (set-of
          (Rename (map-empty) (map-empty) (map-empty) (map-empty)
              (map-insert (map-empty) id (vec-of
                  (Let id pattern (vec-append certs proofs)
                      (Parallel execution (IterationSpace flat (vec-append outer-axes inner-axes))
                          (ParallelBlock (vec-append coordinates (vec-append prefix body)) results))))))))
       (RewriteDemand "distribution" program)) :ruleset distribution-select)

; Reuse is permission on logical values. SSA still checks concrete storage types
; and claims each backing buffer at most once for a region's live outputs.
(ruleset reuse-reads)
(ruleset reuse-legality)
(ruleset reuse-select)
(relation ReuseCandidate (Function Stm ValueName))
(function ReuseReadSafe (Function Stm ValueName Exp) bool :merge (or old new))
(function ReuseLegal (Function Stm ValueName) bool :merge (and old new))
(relation CanReuse (Function ValueName ValueName))
(relation ReuseSnapshot (Function Stm ValueName Exp))
(relation RequiresSnapshot (Function Stm))
(relation ConsumedScalarArray (Function ValueName))
(rule ((ProgramFunction program function)
       (= function (DefineFunction name params returns body))
       (WalkParams params i)
       (< i (vec-size params))
       (= (ParamsAt params i) (Parameter (BindValue input (LogicalValue (ArrayType ownership extents (ElementValue element)))) (Consume)))
       (= (vec-size extents) 1))
      ((ConsumedScalarArray function input)) :ruleset reuse-reads)
(rule ((ConsumedScalarArray function input) (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Parallel (DeviceKernel grid) domain (ParallelBlock statements results))))
       (DiscardableClauses results (vec-size results))
       (ContainsExp (ParallelRoot (ParallelBlock statements results)) expression)
       (= expression (Index input indices)) (DomainRead function domain expression))
      ((ReuseCandidate function statement input)) :ruleset reuse-reads)
(rule ((ConsumedScalarArray function input) (ContainsStm (FunctionRoot function) statement)
       (= statement (Let id pattern certs (Copy input))))
      ((ReuseCandidate function statement input)
       (set (ReuseReadSafe function statement input (Copy input)) true)) :ruleset reuse-reads)
(rule ((ReuseCandidate function statement input)
       (ContainsExp (FunctionRoot function) expression)
       (= used (DirectNamesExp expression)) (set-includes used (ValueNameRef input)))
      ((set (ReuseReadSafe function statement input expression) false)) :ruleset reuse-reads)
(rule ((ReuseCandidate function statement input) (ContainsExp (FunctionRoot function) expression)
       (= expression (Length input dimension)))
      ((set (ReuseReadSafe function statement input expression) true)) :ruleset reuse-reads)
(rule ((ReuseCandidate function statement input)
       (= statement (Let id pattern certs (Parallel execution domain body)))
       (ContainsExp (ParallelRoot body) expression) (= expression (Index input indices))
       (DomainRead function domain expression))
      ((set (ReuseReadSafe function statement input expression) true)) :ruleset reuse-reads)
(rule ((ReuseCandidate function statement input)
       (= statement (Let id pattern certs expression))
       (StatementOccurrence id context after)
       (= function (ScopeRoot context))
       (CheckStatement context read-id bindings proofs available)
       (= proofs (Index input indices))
       (StatementOccurrence read-id context before)
       (< before after)
       (= (vec-size bindings) 1)
       (= (PatternAt bindings 0) (BindValue name (ScalarInfo element))))
      ((set (ReuseReadSafe function statement input proofs) true)
       (ReuseSnapshot function statement input proofs)) :ruleset reuse-reads)
(rule ((ReuseCandidate function statement input))
      ((set (ReuseLegal function statement input) true)) :ruleset reuse-legality)
(rule ((ReuseCandidate function statement input) (= (ReuseReadSafe function statement input expression) false))
      ((set (ReuseLegal function statement input) false)) :ruleset reuse-legality)
(rule ((ReuseCandidate function statement input)
       (ContainsResult (FunctionRoot function) (Yield proofs (ValueOperand (Var input)))))
      ((set (ReuseLegal function statement input) false)) :ruleset reuse-legality)
(rule ((ReuseCandidate function statement input) (= statement (Let id pattern certs (Copy input)))
       (ContainsStm (FunctionRoot function) (Let other outputs proofs (Copy input))) (!= id other))
      ((set (ReuseLegal function statement input) false)) :ruleset reuse-legality)
(rule ((= (ReuseLegal function statement input) true)
       (= statement (Let id pattern certs (Parallel execution domain (ParallelBlock statements clauses))))
       (WalkParallelResults clauses i)
       (< i (vec-size clauses))
       (= (ParallelResultsAt clauses i) (Collect results))
       (= offset (ClauseOffset clauses i))
       (WalkResults results j)
       (< j (vec-size results))
       (< (+ offset j) (vec-size pattern))
       (= (PatternAt pattern (+ offset j)) (BindValue output info)))
      ((CanReuse function output input)) :ruleset reuse-select)
(rule ((= (ReuseLegal function statement input) true) (ReuseSnapshot function statement input expression))
      ((RequiresSnapshot function statement)) :ruleset reuse-select)
(rule ((= (ReuseLegal function statement input) true)
       (= statement (Let id pattern certs (Copy input)))
       (= (vec-size pattern) 1)
       (= (PatternAt pattern 0) (BindValue output info)))
      ((CanReuse function output input)) :ruleset reuse-select)
