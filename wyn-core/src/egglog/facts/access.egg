; Keyed read access to selected facts. This ruleset runs once after optimization.
(ruleset ssa-access)

(sort CapturedFormals (Set SourceValue))
(function SourceCapturedFormals (RegionKey) CapturedFormals :merge (set-union old new))
(rule ((= (SourceCapture r p) v)) ((set (SourceCapturedFormals r) (set-of p))) :ruleset ssa-access)
(function SourceDefinitionSymbol (RegionKey) i64 :no-merge)
(rule ((= (SourceDefinition s) r)) ((set (SourceDefinitionSymbol r) s)) :ruleset ssa-access)

(sort DispatchGroupOperations (Set OperationKey))
(sort DispatchStages (Set StageKey))
(function PlanFilterOperation (FusionPlan) OperationKey :no-merge)
(rule ((FilterPlan plan) (PlanMember plan op) (= (SourceOperation op) (OperationInfo region "filter")))
      ((set (PlanFilterOperation plan) op)) :ruleset ssa-access)
(function DispatchGroupMembers (OperationKey) DispatchGroupOperations :merge (set-union old new))
(rule ((DispatchGroupLeader o owner)) ((set (DispatchGroupMembers owner) (set-of o))) :ruleset ssa-access)
(function DispatchPredecessors (StageKey) DispatchStages :merge (set-union old new))
(rule ((DispatchDependency before after)) ((set (DispatchPredecessors after) (set-of before))) :ruleset ssa-access)
(run-schedule (run ssa-access))
