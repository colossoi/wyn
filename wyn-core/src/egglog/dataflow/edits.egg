(ruleset graph-candidates)
(ruleset graph-apply)
(ruleset graph-substitution-index)
(ruleset graph-substitution)
(relation ForwardCandidate (Name Name))
(function ValueReplacement (Name) Name :no-merge)
(relation BranchCandidate (OperationKey RegionKey))

; Forward proven product projections through the graph editor.
(rule ((LiveOperation operation) (ResultOrigin (ValueNameRef output) operation 0)
       (= (ProjectionAlias (ValueNameRef output)) (ValueNameRef input)) (!= input output))
      ((ForwardCandidate (ValueNameRef output) (ValueNameRef input))) :ruleset graph-candidates)
; Rewire keyed cells in place; immutable index proofs are rebuilt independently.
(function RewrittenIndex (IndexExp) IndexExp :no-merge)
(function IndexReplacement (IndexExp) bool :merge (or old new))
(rule ((IndexUse index name) (= (ValueReplacement (ValueNameRef name)) replacement))
      ((set (IndexReplacement index) true)) :ruleset graph-substitution-index)
(rule ((= (IndexReplacement index) true) (IndexChild index child))
      ((set (IndexReplacement child) false)) :ruleset graph-substitution-index)
(rule ((= (IndexReplacement index) false))
      ((set (RewrittenIndex index) index)) :ruleset graph-substitution)
(rule ((= index (IndexValue value)) (= (ValueReplacement (ValueNameRef value)) (ValueNameRef replacement)))
      ((set (RewrittenIndex index) (IndexValue replacement))) :ruleset graph-substitution)
(rule ((= index (IndexAdd a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexAdd x y))) :ruleset graph-substitution)
(rule ((= index (IndexSub a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexSub x y))) :ruleset graph-substitution)
(rule ((= index (IndexMul a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMul x y))) :ruleset graph-substitution)
(rule ((= index (IndexDiv a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexDiv x y))) :ruleset graph-substitution)
(rule ((= index (IndexMod a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMod x y))) :ruleset graph-substitution)
(rule ((= index (IndexMin a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMin x y))) :ruleset graph-substitution)
(rule ((= index (IndexMax a b)) (= (IndexReplacement index) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMax x y))) :ruleset graph-substitution)
(function RewrittenShapePrefix (Shape i64) Shape :no-merge)
(function RewrittenShape (Shape) Shape :no-merge)
(function RewrittenSlice (DimIndex) DimIndex :no-merge)
(function RewrittenSlicesPrefix (Slices i64) Slices :no-merge)
(function RewrittenSlices (Slices) Slices :no-merge)
(relation ChangedShape (Shape))
(relation ChangedSlices (Slices))
(function SliceReplacement (DimIndex) bool :merge (or old new))
(rule ((= index (ShapeAt shape slot)) (= (IndexReplacement index) true))
      ((ChangedShape shape)) :ruleset graph-substitution-index)
(rule ((ChangedShape shape) (= index (ShapeAt shape slot)))
      ((set (IndexReplacement index) false)) :ruleset graph-substitution-index)
(rule ((ChangedShape shape))
      ((set (RewrittenShapePrefix shape 0) (vec-of))) :ruleset graph-substitution)
(rule ((= prefix (RewrittenShapePrefix shape slot)) (< slot (vec-length shape))
       (= value (RewrittenIndex (vec-get shape slot))))
      ((set (RewrittenShapePrefix shape (+ slot 1)) (vec-push prefix value))) :ruleset graph-substitution)
(rule ((= shape (RewrittenShapePrefix source (vec-length source))))
      ((set (RewrittenShape source) shape)) :ruleset graph-substitution)
(rule ((= slice (At index)) (= (IndexReplacement index) true))
      ((set (SliceReplacement slice) true)) :ruleset graph-substitution-index)
(rule ((= slice (Slice a b c)) (= (IndexReplacement a) true))
      ((set (SliceReplacement slice) true)) :ruleset graph-substitution-index)
(rule ((= slice (Slice a b c)) (= (IndexReplacement b) true))
      ((set (SliceReplacement slice) true)) :ruleset graph-substitution-index)
(rule ((= slice (Slice a b c)) (= (IndexReplacement c) true))
      ((set (SliceReplacement slice) true)) :ruleset graph-substitution-index)
(rule ((= slice (Slice a b c)) (= (SliceReplacement slice) true))
      ((set (IndexReplacement a) false) (set (IndexReplacement b) false) (set (IndexReplacement c) false)) :ruleset graph-substitution-index)
(rule ((= slice (SliceAt slices slot)) (= (SliceReplacement slice) true))
      ((ChangedSlices slices)) :ruleset graph-substitution-index)
(rule ((ChangedSlices slices) (= slice (SliceAt slices slot)))
      ((set (SliceReplacement slice) false)) :ruleset graph-substitution-index)
(rule ((= (SliceReplacement slice) false))
      ((set (RewrittenSlice slice) slice)) :ruleset graph-substitution)
(rule ((= slice (At index)) (= (SliceReplacement slice) true) (= value (RewrittenIndex index)))
      ((set (RewrittenSlice slice) (At value))) :ruleset graph-substitution)
(rule ((= slice (Slice a b c)) (= (SliceReplacement slice) true) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)) (= z (RewrittenIndex c)))
      ((set (RewrittenSlice slice) (Slice x y z))) :ruleset graph-substitution)
(rule ((ChangedSlices slices))
      ((set (RewrittenSlicesPrefix slices 0) (vec-of))) :ruleset graph-substitution)
(rule ((= prefix (RewrittenSlicesPrefix slices slot)) (< slot (vec-length slices))
       (= value (RewrittenSlice (vec-get slices slot))))
      ((set (RewrittenSlicesPrefix slices (+ slot 1)) (vec-push prefix value))) :ruleset graph-substitution)
(rule ((= slices (RewrittenSlicesPrefix source (vec-length source))))
      ((set (RewrittenSlices source) slices)) :ruleset graph-substitution)
(function RewrittenAccumulatorInfo (AccInfo) AccInfo :no-merge)
(rule ((= info (AccumulatorInfo shape elements)) (= replacement (RewrittenShape shape)))
      ((set (RewrittenAccumulatorInfo info) (AccumulatorInfo replacement elements))) :ruleset graph-substitution)
(rule ((= old (AccumulatorType token)) (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (AccumulatorType token)) (set (AccumulatorType token) replacement)) :ruleset graph-apply)
(rule ((= (RegionReturnType region slot) (ReturnAccumulator old))
       (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (RegionReturnType region slot)) (set (RegionReturnType region slot) (ReturnAccumulator replacement))) :ruleset graph-apply)
(rule ((= (FunctionResultType function slot) (ReturnAccumulator old))
       (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (FunctionResultType function slot)) (set (FunctionResultType function slot) (ReturnAccumulator replacement))) :ruleset graph-apply)
(rule ((= (CallReturnType operation slot) (ReturnAccumulator old))
       (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (CallReturnType operation slot)) (set (CallReturnType operation slot) (ReturnAccumulator replacement))) :ruleset graph-apply)
