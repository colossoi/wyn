(ruleset graph-candidates)
(ruleset graph-apply)
(ruleset graph-operands)
(ruleset graph-substitution-index)
(ruleset graph-substitution)
(relation ForwardCandidate (Name Name))
(function ValueReplacement (Name) Name :no-merge)
(function InlineAll () bool :no-merge)
(set (InlineAll) false)
(relation InlineCall (FunctionName OperationKey FunctionName))
(relation InlineParallel (FunctionName))
(relation InlineCandidate (RegionKey OperationKey RegionKey))
(relation BranchCandidate (OperationKey RegionKey))
(function InlineRequired (FunctionName) bool :merge (or old new))
(ruleset graph-inline-required)
(ruleset graph-inline)
(rule ((= revision (AnalysisRevision)) (Function function))
      ((set (InlineRequired function) false)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (Function function) (= (InlineAll) true))
      ((set (InlineRequired function) true)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (Function function) (= root (FunctionRoot function))
       (= (RegionParameter root slot) (ValueNameRef value)) (= (ValueType value) (LogicalValue ty)))
      ((set (InlineRequired function) true)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (Function function) (= (FunctionResultType function slot) (LogicalReturn ty)))
      ((set (InlineRequired function) true)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (Function function) (= root (FunctionRoot function))
       (FlowScopeAncestor root region) (= region (wyn-region-of operation)) (ParallelOperation operation))
      ((InlineParallel function)) :ruleset graph-inline-required)
; A nonrecursive callee with parallel work will expose that work in its caller.
(rule ((= revision (AnalysisRevision)) (InlineCall caller operation callee)
       (= (RecursiveFunction callee) false) (InlineParallel callee))
      ((InlineParallel caller)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (InlineParallel function))
      ((set (InlineRequired function) true)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (InlineCall caller operation callee)
       (= (RecursiveFunction callee) false) (= (InlineRequired callee) true)
       (= caller-root (FunctionRoot caller)) (= callee-root (FunctionRoot callee)))
      ((InlineCandidate caller-root operation callee-root)) :ruleset graph-inline)

; The shared forwarding analysis resolves copies and product projections.
(rule ((= revision (AnalysisRevision)) (LiveOperation operation) (= (Output operation 0) (ValueNameRef output))
       (= (SourceAlias (FlowNamed output)) (FlowNamed input)) (!= input output))
      ((ForwardCandidate (ValueNameRef output) (ValueNameRef input))) :ruleset graph-candidates)
; Rewire keyed cells in place; immutable index proofs are rebuilt independently.
(function RewrittenIndex (IndexExp) IndexExp :no-merge)
(function IndexReplacement (IndexExp) bool :merge (or old new))
(rule ((= revision (AnalysisRevision)) (= index (IndexConstant n))) ((set (RewrittenIndex index) index)) :ruleset graph-substitution-index)
(rule ((= revision (AnalysisRevision)) (= index (IndexValue value))) ((set (IndexReplacement index) false)) :ruleset graph-substitution-index)
(rule ((= revision (AnalysisRevision)) (= index (IndexValue value)) (= (ValueReplacement (ValueNameRef value)) replacement))
      ((set (IndexReplacement index) true)) :ruleset graph-substitution-index)
(rule ((= revision (AnalysisRevision)) (= index (IndexValue value)) (= (IndexReplacement index) false))
      ((set (RewrittenIndex index) index)) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexValue value)) (= (ValueReplacement (ValueNameRef value)) (ValueNameRef replacement)))
      ((set (RewrittenIndex index) (IndexValue replacement))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexAdd a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexAdd x y))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexSub a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexSub x y))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexMul a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMul x y))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexDiv a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexDiv x y))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexMod a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMod x y))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexMin a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMin x y))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= index (IndexMax a b)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)))
      ((set (RewrittenIndex index) (IndexMax x y))) :ruleset graph-substitution)
(function RewrittenShapePrefix (Shape i64) Shape :no-merge)
(function RewrittenShape (Shape) Shape :no-merge)
(function RewrittenSlice (DimIndex) DimIndex :no-merge)
(function RewrittenSlicesPrefix (Slices i64) Slices :no-merge)
(function RewrittenSlices (Slices) Slices :no-merge)
(rule ((= revision (AnalysisRevision)) (ShapeDemand shape)) ((set (RewrittenShapePrefix shape 0) (vec-of))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= prefix (RewrittenShapePrefix shape slot)) (< slot (vec-length shape))
       (= value (RewrittenIndex (vec-get shape slot))))
      ((set (RewrittenShapePrefix shape (+ slot 1)) (vec-push prefix value))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= shape (RewrittenShapePrefix source (vec-length source))))
      ((set (RewrittenShape source) shape)) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= slice (At index)) (= value (RewrittenIndex index)))
      ((set (RewrittenSlice slice) (At value))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= slice (Slice a b c)) (= x (RewrittenIndex a)) (= y (RewrittenIndex b)) (= z (RewrittenIndex c)))
      ((set (RewrittenSlice slice) (Slice x y z))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (SliceDemand slices)) ((set (RewrittenSlicesPrefix slices 0) (vec-of))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= prefix (RewrittenSlicesPrefix slices slot)) (< slot (vec-length slices))
       (= value (RewrittenSlice (vec-get slices slot))))
      ((set (RewrittenSlicesPrefix slices (+ slot 1)) (vec-push prefix value))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= slices (RewrittenSlicesPrefix source (vec-length source))))
      ((set (RewrittenSlices source) slices)) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= old (Input operation slot)) (= replacement (ValueReplacement old)) (!= old replacement))
      ((delete (Input operation slot)) (set (Input operation slot) replacement)) :ruleset graph-operands)
(rule ((= revision (AnalysisRevision)) (= old (EdgeArgument operation edge slot)) (= replacement (ValueReplacement old)) (!= old replacement))
      ((delete (EdgeArgument operation edge slot)) (set (EdgeArgument operation edge slot) replacement)) :ruleset graph-operands)
(rule ((= revision (AnalysisRevision)) (= old (RegionYield region slot)) (= replacement (ValueReplacement old)) (!= old replacement))
      ((delete (RegionYield region slot)) (set (RegionYield region slot) replacement)) :ruleset graph-operands)
(rule ((= revision (AnalysisRevision)) (= old (ResultNeutral operation clause slot)) (= replacement (ValueReplacement old)) (!= old replacement))
      ((delete (ResultNeutral operation clause slot)) (set (ResultNeutral operation clause slot) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (ResultValue operation clause slot)) (= replacement (ValueReplacement old)) (!= old replacement))
      ((delete (ResultValue operation clause slot)) (set (ResultValue operation clause slot) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (ResultPredicate operation clause)) (= (ValueReplacement (ValueNameRef old)) (ValueNameRef replacement)) (!= old replacement))
      ((delete (ResultPredicate operation clause)) (set (ResultPredicate operation clause) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (AccumulatorArray operation group slot)) (= (ValueReplacement (ValueNameRef old)) (ValueNameRef replacement)) (!= old replacement))
      ((delete (AccumulatorArray operation group slot)) (set (AccumulatorArray operation group slot) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (OperationIndex operation slot)) (= replacement (RewrittenIndex old)) (!= old replacement))
      ((delete (OperationIndex operation slot)) (set (OperationIndex operation slot) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (LoopStart operation)) (= replacement (RewrittenIndex old)) (!= old replacement))
      ((delete (LoopStart operation)) (set (LoopStart operation) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (LoopCount operation)) (= replacement (RewrittenIndex old)) (!= old replacement))
      ((delete (LoopCount operation)) (set (LoopCount operation) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (LoopStep operation)) (= replacement (RewrittenIndex old)) (!= old replacement))
      ((delete (LoopStep operation)) (set (LoopStep operation) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (DomainExtent domain slot)) (= replacement (RewrittenIndex old)) (!= old replacement))
      ((delete (DomainExtent domain slot)) (set (DomainExtent domain slot) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (OperationShape operation)) (= replacement (RewrittenShape old)) (!= old replacement))
      ((delete (OperationShape operation)) (set (OperationShape operation) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (OperationSlices operation)) (= replacement (RewrittenSlices old)) (!= old replacement))
      ((delete (OperationSlices operation)) (set (OperationSlices operation) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (OperationCertificate operation old) (= (ValueReplacement (ValueNameRef old)) (ValueNameRef replacement)) (!= old replacement))
      ((delete (OperationCertificate operation old)) (OperationCertificate operation replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (YieldCertificate region slot old) (= (ValueReplacement (ValueNameRef old)) (ValueNameRef replacement)) (!= old replacement))
      ((delete (YieldCertificate region slot old)) (YieldCertificate region slot replacement)) :ruleset graph-apply)

(rule ((= revision (AnalysisRevision)) (Function function) (= root (FunctionRoot function))
       (= (RegionParameter root slot) (AccNameRef token)))
      ((set (InlineRequired function) true)) :ruleset graph-inline-required)
(rule ((= revision (AnalysisRevision)) (Function function) (= (FunctionResultType function slot) (ReturnAccumulator info)))
      ((set (InlineRequired function) true)) :ruleset graph-inline-required)

(function RewrittenAccumulatorInfo (AccInfo) AccInfo :no-merge)
(rule ((= revision (AnalysisRevision)) (= info (LogicalAccumulator ty)))
      ((set (RewrittenAccumulatorInfo info) info)) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= info (AccumulatorInfo shape elements)) (= replacement (RewrittenShape shape)))
      ((set (RewrittenAccumulatorInfo info) (AccumulatorInfo replacement elements))) :ruleset graph-substitution)
(rule ((= revision (AnalysisRevision)) (= old (AccumulatorType token)) (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (AccumulatorType token)) (set (AccumulatorType token) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= old (LoopCondition operation)) (= (ValueReplacement (ValueNameRef old)) (ValueNameRef replacement)) (!= old replacement))
      ((delete (LoopCondition operation)) (set (LoopCondition operation) replacement)) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= (RegionReturnType region slot) (ReturnAccumulator old))
       (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (RegionReturnType region slot)) (set (RegionReturnType region slot) (ReturnAccumulator replacement))) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= (FunctionResultType function slot) (ReturnAccumulator old))
       (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (FunctionResultType function slot)) (set (FunctionResultType function slot) (ReturnAccumulator replacement))) :ruleset graph-apply)
(rule ((= revision (AnalysisRevision)) (= (CallReturnType operation slot) (ReturnAccumulator old))
       (= replacement (RewrittenAccumulatorInfo old)) (!= old replacement))
      ((delete (CallReturnType operation slot)) (set (CallReturnType operation slot) (ReturnAccumulator replacement))) :ruleset graph-apply)
