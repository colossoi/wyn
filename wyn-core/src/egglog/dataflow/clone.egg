; Clone graph identities and keyed edges. Captures remain references to outer values.
(ruleset clone-index)
(ruleset clone-names)
(ruleset clone-edges)
(relation CloneRequest (OperationKey RegionKey))
(relation CloneMember (OperationKey RegionKey))
(relation CloneOperation (OperationKey OperationKey))
(relation CloneLocal (OperationKey Name))
(relation CloneNameDemand (OperationKey Name))
(function CloneSubstitute (OperationKey Name) Name :no-merge)
(function CloneIsLocal (OperationKey Name) bool :merge (or old new))
(function CloneIsSubstituted (OperationKey Name) bool :merge (or old new))
(function CloneName (OperationKey Name) Name :no-merge)
(relation CloneIndexDemand (OperationKey IndexExp))
(function CloneIndex (OperationKey IndexExp) IndexExp :no-merge)
(relation CloneShapeDemand (OperationKey Shape))
(relation CloneShapeSlot (OperationKey Shape i64))
(function CloneShapePrefix (OperationKey Shape i64) Shape :no-merge)
(function CloneShape (OperationKey Shape) Shape :no-merge)
(relation CloneSliceDemand (OperationKey Slices))
(relation CloneSliceSlot (OperationKey Slices i64))
(function CloneSlicePrefix (OperationKey Slices i64) Slices :no-merge)
(function CloneSlices (OperationKey Slices) Slices :no-merge)
(relation CloneDimDemand (OperationKey DimIndex))
(function CloneDim (OperationKey DimIndex) DimIndex :no-merge)
(function CloneAccInfo (OperationKey AccInfo) AccInfo :no-merge)
(relation CloneAccInfoDemand (OperationKey AccInfo))
(relation CloneReturnDemand (OperationKey ReturnInfo))
(function CloneReturn (OperationKey ReturnInfo) ReturnInfo :no-merge)
(relation CloneDomain (OperationKey Domain))
(rule ((= revision (AnalysisRevision)) (CloneRequest context root)) ((CloneMember context root)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= child (ControlRegion operation slot))) ((CloneMember context child)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= child (ResultReducer operation slot))) ((CloneMember context child)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= child (AccumulatorCombiner operation slot))) ((CloneMember context child)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneMember context region))
      ((Region (ClonedRegion context region)) (FlowScope (ClonedRegion context region))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= region (OperationRegion operation)) (Operation operation))
      ((CloneOperation context operation) (Operation (ClonedOperation context operation))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= name (RegionParameter region slot)))
      ((CloneLocal context name) (CloneNameDemand context name)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= name (Output operation slot)))
      ((CloneLocal context name) (CloneNameDemand context name)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneNameDemand context name))
      ((set (CloneIsLocal context name) false) (set (CloneIsSubstituted context name) false)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneLocal context name)) ((set (CloneIsLocal context name) true)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (= replacement (CloneSubstitute context name)))
      ((set (CloneIsSubstituted context name) true)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneNameDemand context name) (= replacement (CloneSubstitute context name)))
      ((set (CloneName context name) replacement)) :ruleset clone-names)
(rule ((= revision (AnalysisRevision)) (CloneNameDemand context name) (= (CloneIsLocal context name) false)
       (= (CloneIsSubstituted context name) false))
      ((set (CloneName context name) name)) :ruleset clone-names)
(rule ((= revision (AnalysisRevision)) (CloneNameDemand context (ValueNameRef name)) (= (CloneIsLocal context (ValueNameRef name)) true)
       (= (CloneIsSubstituted context (ValueNameRef name)) false))
      ((set (CloneName context (ValueNameRef name)) (ValueNameRef (ClonedValue context name)))) :ruleset clone-names)
(rule ((= revision (AnalysisRevision)) (CloneNameDemand context (AccNameRef name)) (= (CloneIsLocal context (AccNameRef name)) true)
       (= (CloneIsSubstituted context (AccNameRef name)) false))
      ((set (CloneName context (AccNameRef name)) (AccNameRef (ClonedAccumulator context name)))) :ruleset clone-names)
; Substituted arguments keep their caller's shape and storage type.
(rule ((= revision (AnalysisRevision)) (CloneLocal context (ValueNameRef name)) (= (CloneName context (ValueNameRef name)) (ValueNameRef replacement))
       (= (CloneIsSubstituted context (ValueNameRef name)) false) (= info (ValueType name)))
      ((set (ValueType replacement) info)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneLocal context (AccNameRef name)) (= info (AccumulatorType name)))
      ((CloneAccInfoDemand context info)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneAccInfoDemand context info) (= info (LogicalAccumulator ty)))
      ((set (CloneAccInfo context info) info)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneAccInfoDemand context (AccumulatorInfo shape elements)))
      ((CloneShapeDemand context shape)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneAccInfoDemand context info) (= info (AccumulatorInfo shape elements)) (= replacement (CloneShape context shape)))
      ((set (CloneAccInfo context info) (AccumulatorInfo replacement elements))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneLocal context (AccNameRef name)) (= (CloneName context (AccNameRef name)) (AccNameRef replacement))
       (= info (AccumulatorType name)) (= info2 (CloneAccInfo context info)))
      ((set (AccumulatorType replacement) info2)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexConstant n)))
      ((set (CloneIndex context index) index)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexValue name)))
      ((CloneNameDemand context (ValueNameRef name))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexValue name))
       (= (CloneName context (ValueNameRef name)) (ValueNameRef replacement)))
      ((set (CloneIndex context index) (IndexValue replacement))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexAdd a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexAdd a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexAdd x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexSub a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexSub a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexSub x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexMul a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexMul a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMul x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexDiv a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexDiv a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexDiv x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexMod a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexMod a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMod x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexMin a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexMin a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMin x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context (IndexMax a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneIndexDemand context index) (= index (IndexMax a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMax x y))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneShapeDemand context shape)) ((set (CloneShapePrefix context shape 0) (vec-of))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneShapeDemand context shape)) ((CloneShapeSlot context shape 0)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneShapeSlot context shape slot) (< slot (vec-length shape)))
      ((CloneIndexDemand context (vec-get shape slot)) (CloneShapeSlot context shape (+ slot 1))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (= prefix (CloneShapePrefix context shape slot)) (< slot (vec-length shape))
       (= value (CloneIndex context (vec-get shape slot))))
      ((set (CloneShapePrefix context shape (+ slot 1)) (vec-push prefix value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneShapeDemand context shape) (= replacement (CloneShapePrefix context shape (vec-length shape))))
      ((set (CloneShape context shape) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneSliceDemand context slices)) ((CloneSliceSlot context slices 0)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneSliceSlot context slices slot) (< slot (vec-length slices)))
      ((CloneDimDemand context (vec-get slices slot)) (CloneSliceSlot context slices (+ slot 1))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneDimDemand context (At index))) ((CloneIndexDemand context index)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneDimDemand context (Slice a b c)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b) (CloneIndexDemand context c)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneDimDemand context item) (= item (At index)) (= replacement (CloneIndex context index)))
      ((set (CloneDim context item) (At replacement))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneDimDemand context item) (= item (Slice a b c))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)) (= z (CloneIndex context c)))
      ((set (CloneDim context item) (Slice x y z))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneSliceDemand context slices)) ((set (CloneSlicePrefix context slices 0) (vec-of))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (= prefix (CloneSlicePrefix context slices slot)) (< slot (vec-length slices))
       (= value (CloneDim context (vec-get slices slot))))
      ((set (CloneSlicePrefix context slices (+ slot 1)) (vec-push prefix value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneSliceDemand context slices) (= replacement (CloneSlicePrefix context slices (vec-length slices))))
      ((set (CloneSlices context slices) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationPayload operation)) ) ((set (OperationPayload (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationRegion operation)) ) ((set (OperationRegion (ClonedOperation context operation)) (ClonedRegion context value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationOrder operation)) ) ((set (OperationOrder (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (Input operation k0))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (Input operation k0)) (= replacement (CloneName context value))) ((set (Input (ClonedOperation context operation) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (InputCount operation)) ) ((set (InputCount (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (InputDiet operation k0)) ) ((set (InputDiet (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (Output operation k0))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (Output operation k0)) (= replacement (CloneName context value))) ((set (Output (ClonedOperation context operation) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OutputCount operation)) ) ((set (OutputCount (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ControlRegion operation k0)) ) ((set (ControlRegion (ClonedOperation context operation) k0) (ClonedRegion context value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ControlRole operation k0)) ) ((set (ControlRole (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (EdgeArgument operation k0 k1))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (EdgeArgument operation k0 k1)) (= replacement (CloneName context value))) ((set (EdgeArgument (ClonedOperation context operation) k0 k1) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopIndex operation))) ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopIndex operation)) (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement))) ((set (LoopIndex (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopStart operation))) ((CloneIndexDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopStart operation)) (= replacement (CloneIndex context value))) ((set (LoopStart (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopCount operation))) ((CloneIndexDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopCount operation)) (= replacement (CloneIndex context value))) ((set (LoopCount (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopStep operation))) ((CloneIndexDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopStep operation)) (= replacement (CloneIndex context value))) ((set (LoopStep (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopCondition operation))) ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (LoopCondition operation)) (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement))) ((set (LoopCondition (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationIndex operation k0))) ((CloneIndexDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationIndex operation k0)) (= replacement (CloneIndex context value))) ((set (OperationIndex (ClonedOperation context operation) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationSlices operation))) ((CloneSliceDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationSlices operation)) (= replacement (CloneSlices context value))) ((set (OperationSlices (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationShape operation))) ((CloneShapeDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationShape operation)) (= replacement (CloneShape context value))) ((set (OperationShape (ClonedOperation context operation)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationDomain operation))) ((CloneDomain context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationDomain operation)) ) ((set (OperationDomain (ClonedOperation context operation)) (ClonedDomain context value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OperationExecution operation)) ) ((set (OperationExecution (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultKindOf operation k0)) ) ((set (ResultKindOf (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultCount operation)) ) ((set (ResultCount (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultValueCount operation k0)) ) ((set (ResultValueCount (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultValue operation k0 k1))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultValue operation k0 k1)) (= replacement (CloneName context value))) ((set (ResultValue (ClonedOperation context operation) k0 k1) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultPredicate operation k0))) ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultPredicate operation k0)) (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement))) ((set (ResultPredicate (ClonedOperation context operation) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultReducer operation k0)) ) ((set (ResultReducer (ClonedOperation context operation) k0) (ClonedRegion context value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultNeutral operation k0 k1))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultNeutral operation k0 k1)) (= replacement (CloneName context value))) ((set (ResultNeutral (ClonedOperation context operation) k0 k1) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultNeutralCount operation k0)) ) ((set (ResultNeutralCount (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ResultCommutative operation k0)) ) ((set (ResultCommutative (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OutputClause operation k0)) ) ((set (OutputClause (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OutputField operation k0)) ) ((set (OutputField (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (OutputRole operation k0)) ) ((set (OutputRole (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (AccumulatorPolicy operation k0)) ) ((set (AccumulatorPolicy (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (AccumulatorGroupCount operation)) ) ((set (AccumulatorGroupCount (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (AccumulatorArrayCount operation k0)) ) ((set (AccumulatorArrayCount (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (AccumulatorArray operation k0 k1))) ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (AccumulatorArray operation k0 k1)) (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement))) ((set (AccumulatorArray (ClonedOperation context operation) k0 k1) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (AccumulatorCombiner operation k0)) ) ((set (AccumulatorCombiner (ClonedOperation context operation) k0) (ClonedRegion context value))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (CallTarget operation)) ) ((set (CallTarget (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (CallReturnType operation k0)) (= replacement (CloneReturn context value))) ((set (CallReturnType (ClonedOperation context operation) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (ScalarPayload operation)) ) ((set (ScalarPayload (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionParameter region k0))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionParameter region k0)) (= replacement (CloneName context value))) ((set (RegionParameter (ClonedRegion context region) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionParameterCount region)) ) ((set (RegionParameterCount (ClonedRegion context region)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (ParameterDiet region k0)) ) ((set (ParameterDiet (ClonedRegion context region) k0) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionReturnType region k0)) (= replacement (CloneReturn context value))) ((set (RegionReturnType (ClonedRegion context region) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionYield region k0))) ((CloneNameDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionYield region k0)) (= replacement (CloneName context value))) ((set (RegionYield (ClonedRegion context region) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionYieldCount region)) ) ((set (RegionYieldCount (ClonedRegion context region)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainRank domain)) ) ((set (DomainRank (ClonedDomain context domain)) value)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainOrdinal domain))) ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainOrdinal domain)) (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement))) ((set (DomainOrdinal (ClonedDomain context domain)) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainAxis domain k0))) ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainAxis domain k0)) (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement))) ((set (DomainAxis (ClonedDomain context domain) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainExtent domain k0))) ((CloneIndexDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneDomain context domain) (= value (DomainExtent domain k0)) (= replacement (CloneIndex context value))) ((set (DomainExtent (ClonedDomain context domain) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (OperationCertificate operation v0)) ((CloneNameDemand context (ValueNameRef v0))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (OperationCertificate operation v0) (= (CloneName context (ValueNameRef v0)) (ValueNameRef rv0))) ((OperationCertificate (ClonedOperation context operation) rv0)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (CopyOperation operation) ) ((CopyOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ConstantOperation operation) ) ((ConstantOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ProductOperation operation) ) ((ProductOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ProjectionOperation operation v0) ) ((ProjectionOperation (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (LengthOperation operation v0) ) ((LengthOperation (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (IndexOperation operation) ) ((IndexOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (CallOperation operation) ) ((CallOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (BranchOperation operation) ) ((BranchOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (CountedLoopOperation operation) ) ((CountedLoopOperation (ClonedOperation context operation))) :ruleset clone-edges)
