; Clone graph identities and keyed edges. Captures remain references to outer values.
(ruleset clone-index)
(ruleset clone-names)
(ruleset clone-edges)
(relation CloneMember (OperationKey RegionKey))
(relation CloneOperation (OperationKey OperationKey))
(relation CloneLocal (OperationKey Name))
(relation CloneNameDemand (OperationKey Name))
(function CloneSubstitute (OperationKey Name) Name :no-merge)
(function CloneIsLocal (OperationKey Name) bool :merge (or old new))
(function CloneIsSubstituted (OperationKey Name) bool :merge (or old new))
(function CloneName (OperationKey Name) Name :no-merge)
(relation CloneIndexDemand (OperationKey IndexExp))
(function CloneIndex (OperationKey IndexExp) IndexExp :no-merge)
(relation CloneShapeDemand (OperationKey Shape))
(relation CloneShapeSlot (OperationKey Shape i64))
(function CloneShapePrefix (OperationKey Shape i64) Shape :no-merge)
(function CloneShape (OperationKey Shape) Shape :no-merge)
(relation CloneSliceDemand (OperationKey Slices))
(relation CloneSliceSlot (OperationKey Slices i64))
(function CloneSlicePrefix (OperationKey Slices i64) Slices :no-merge)
(function CloneSlices (OperationKey Slices) Slices :no-merge)
(relation CloneDimDemand (OperationKey DimIndex))
(function CloneDim (OperationKey DimIndex) DimIndex :no-merge)
(function CloneAccInfo (OperationKey AccInfo) AccInfo :no-merge)
(relation CloneAccInfoDemand (OperationKey AccInfo))
(relation CloneReturnDemand (OperationKey ReturnInfo))
(function CloneReturn (OperationKey ReturnInfo) ReturnInfo :no-merge)
(rule ((= revision (RewriteRevision)) (CloneMember context region))
      ((FlowScope (ClonedRegion context region))) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneNameDemand context name))
      ((set (CloneIsLocal context name) false) (set (CloneIsSubstituted context name) false)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneLocal context name)) ((set (CloneIsLocal context name) true)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (= replacement (CloneSubstitute context name)))
      ((set (CloneIsSubstituted context name) true)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneNameDemand context name) (= replacement (CloneSubstitute context name)))
      ((set (CloneName context name) replacement)) :ruleset clone-names)
(rule ((= revision (RewriteRevision)) (CloneNameDemand context name) (= (CloneIsLocal context name) false)
       (= (CloneIsSubstituted context name) false))
      ((set (CloneName context name) name)) :ruleset clone-names)
(rule ((= revision (RewriteRevision)) (CloneNameDemand context (ValueNameRef name)) (= (CloneIsLocal context (ValueNameRef name)) true)
       (= (CloneIsSubstituted context (ValueNameRef name)) false))
      ((set (CloneName context (ValueNameRef name)) (ValueNameRef (ClonedValue context name)))) :ruleset clone-names)
(rule ((= revision (RewriteRevision)) (CloneNameDemand context (AccNameRef name)) (= (CloneIsLocal context (AccNameRef name)) true)
       (= (CloneIsSubstituted context (AccNameRef name)) false))
      ((set (CloneName context (AccNameRef name)) (AccNameRef (ClonedAccumulator context name)))) :ruleset clone-names)
; Substituted arguments keep their caller's shape and storage type.
(rule ((= revision (RewriteRevision)) (CloneLocal context (ValueNameRef name)) (= (CloneName context (ValueNameRef name)) (ValueNameRef replacement))
       (= (CloneIsSubstituted context (ValueNameRef name)) false) (= info (ValueType name)))
      ((set (ValueType replacement) info)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneLocal context (AccNameRef name)) (= info (AccumulatorType name)))
      ((CloneAccInfoDemand context info)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneAccInfoDemand context info) (= info (LogicalAccumulator ty)))
      ((set (CloneAccInfo context info) info)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneAccInfoDemand context (AccumulatorInfo shape elements)))
      ((CloneShapeDemand context shape)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneAccInfoDemand context info) (= info (AccumulatorInfo shape elements)) (= replacement (CloneShape context shape)))
      ((set (CloneAccInfo context info) (AccumulatorInfo replacement elements))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneLocal context (AccNameRef name)) (= (CloneName context (AccNameRef name)) (AccNameRef replacement))
       (= info (AccumulatorType name)) (= info2 (CloneAccInfo context info)))
      ((set (AccumulatorType replacement) info2)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexConstant n)))
      ((set (CloneIndex context index) index)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexValue name)))
      ((CloneNameDemand context (ValueNameRef name))) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexValue name))
       (= (CloneName context (ValueNameRef name)) (ValueNameRef replacement)))
      ((set (CloneIndex context index) (IndexValue replacement))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexAdd a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexAdd a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexAdd x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexSub a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexSub a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexSub x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexMul a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexMul a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMul x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexDiv a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexDiv a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexDiv x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexMod a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexMod a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMod x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexMin a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexMin a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMin x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context (IndexMax a b)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneIndexDemand context index) (= index (IndexMax a b))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)))
      ((set (CloneIndex context index) (IndexMax x y))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneShapeDemand context shape)) ((set (CloneShapePrefix context shape 0) (vec-of))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneShapeDemand context shape)) ((CloneShapeSlot context shape 0)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneShapeSlot context shape slot) (< slot (vec-length shape)))
      ((CloneIndexDemand context (vec-get shape slot)) (CloneShapeSlot context shape (+ slot 1))) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (= prefix (CloneShapePrefix context shape slot)) (< slot (vec-length shape))
       (= value (CloneIndex context (vec-get shape slot))))
      ((set (CloneShapePrefix context shape (+ slot 1)) (vec-push prefix value))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneShapeDemand context shape) (= replacement (CloneShapePrefix context shape (vec-length shape))))
      ((set (CloneShape context shape) replacement)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneSliceDemand context slices)) ((CloneSliceSlot context slices 0)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneSliceSlot context slices slot) (< slot (vec-length slices)))
      ((CloneDimDemand context (vec-get slices slot)) (CloneSliceSlot context slices (+ slot 1))) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneDimDemand context (At index))) ((CloneIndexDemand context index)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneDimDemand context (Slice a b c)))
      ((CloneIndexDemand context a) (CloneIndexDemand context b) (CloneIndexDemand context c)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneDimDemand context item) (= item (At index)) (= replacement (CloneIndex context index)))
      ((set (CloneDim context item) (At replacement))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneDimDemand context item) (= item (Slice a b c))
       (= x (CloneIndex context a)) (= y (CloneIndex context b)) (= z (CloneIndex context c)))
      ((set (CloneDim context item) (Slice x y z))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneSliceDemand context slices)) ((set (CloneSlicePrefix context slices 0) (vec-of))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (= prefix (CloneSlicePrefix context slices slot)) (< slot (vec-length slices))
       (= value (CloneDim context (vec-get slices slot))))
      ((set (CloneSlicePrefix context slices (+ slot 1)) (vec-push prefix value))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneSliceDemand context slices) (= replacement (CloneSlicePrefix context slices (vec-length slices))))
      ((set (CloneSlices context slices) replacement)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= value (InputDiet operation k0)) ) ((set (InputDiet (ClonedOperation context operation) k0) value)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= value (OperationExecution operation)) ) ((set (OperationExecution (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= value (CallReturnType operation k0)) (= replacement (CloneReturn context value))) ((set (CallReturnType (ClonedOperation context operation) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= value (ScalarPayload operation)) ) ((set (ScalarPayload (ClonedOperation context operation)) value)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneMember context region) (= value (ParameterDiet region k0)) ) ((set (ParameterDiet (ClonedRegion context region) k0) value)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneMember context region) (= value (RegionReturnType region k0)) (= replacement (CloneReturn context value))) ((set (RegionReturnType (ClonedRegion context region) k0) replacement)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ConstantOperation operation) ) ((ConstantOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ProductOperation operation) ) ((ProductOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ProjectionOperation operation v0) ) ((ProjectionOperation (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (LengthOperation operation v0) ) ((LengthOperation (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (IndexOperation operation) ) ((IndexOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (CallOperation operation) ) ((CallOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (BranchOperation operation) ) ((BranchOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (CountedLoopOperation operation) ) ((CountedLoopOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (WhileLoopOperation operation) ) ((WhileLoopOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ParallelOperation operation) ) ((ParallelOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (AccumulatorOperation operation) ) ((AccumulatorOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (DiscardableOperation operation) ) ((DiscardableOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (RepeatableOperation operation) ) ((RepeatableOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (OrderedOperation operation) ) ((OrderedOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (LaneDependentOperation operation) ) ((LaneDependentOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ReadsInput operation v0) ) ((ReadsInput (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (WritesInput operation v0) ) ((WritesInput (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (AliasesInput operation v0 v1) ) ((AliasesInput (ClonedOperation context operation) v0 v1)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (FreshOutput operation v0) ) ((FreshOutput (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ScratchAllocation operation))
      ((ScratchAllocation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ProvenTotalOperation operation) ) ((ProvenTotalOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= bits (LiteralBits operation)))
      ((set (LiteralBits (ClonedOperation context operation)) bits)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= work (InstructionWork operation)))
      ((set (InstructionWork (ClonedOperation context operation)) work)) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= width (OperationWidth operation)))
      ((set (OperationWidth (ClonedOperation context operation)) width)) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ConsumesInput operation slot))
      ((ConsumesInput (ClonedOperation context operation) slot)) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (IndexCalculationOperation operation))
      ((IndexCalculationOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneMember context region) (= value (RegionReturnType region slot))) ((CloneReturnDemand context value)) :ruleset clone-index)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (= value (CallReturnType operation k0))) ((CloneReturnDemand context value)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneReturnDemand context info) (= info (ReturnScalar value)))
      ((set (CloneReturn context info) info)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneReturnDemand context info) (= info (ReturnResource value)))
      ((set (CloneReturn context info) info)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneReturnDemand context info) (= info (LogicalReturn value)))
      ((set (CloneReturn context info) info)) :ruleset clone-edges)
(rule ((= revision (RewriteRevision)) (CloneReturnDemand context (ReturnAccumulator info)))
      ((CloneAccInfoDemand context info)) :ruleset clone-index)
(rule ((= revision (RewriteRevision)) (CloneReturnDemand context result) (= result (ReturnAccumulator info))
       (= replacement (CloneAccInfo context info)))
      ((set (CloneReturn context result) (ReturnAccumulator replacement))) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (MaterializedCopyOperation operation)) ((MaterializedCopyOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ViewOperation operation)) ((ViewOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (ArrayLiteralOperation operation)) ((ArrayLiteralOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (RangeOperation operation)) ((RangeOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (RewriteRevision)) (CloneOperation context operation) (PreservesInputShape operation v0 v1)) ((PreservesInputShape (ClonedOperation context operation) v0 v1)) :ruleset clone-edges)
