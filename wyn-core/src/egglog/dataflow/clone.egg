(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (OrderedOperation operation) ) ((OrderedOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (LaneDependentOperation operation) ) ((LaneDependentOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ReadsInput operation v0) ) ((ReadsInput (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (WritesInput operation v0) ) ((WritesInput (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (AliasesInput operation v0 v1) ) ((AliasesInput (ClonedOperation context operation) v0 v1)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (FreshOutput operation v0) ) ((FreshOutput (ClonedOperation context operation) v0)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ProvenTotalOperation operation) ) ((ProvenTotalOperation (ClonedOperation context operation))) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= bits (LiteralBits operation)))
      ((set (LiteralBits (ClonedOperation context operation)) bits)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (YieldCertificate region slot value))
      ((CloneNameDemand context (ValueNameRef value))) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneMember context region) (YieldCertificate region slot value)
       (= (CloneName context (ValueNameRef value)) (ValueNameRef replacement)))
      ((YieldCertificate (ClonedRegion context region) slot replacement)) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= work (InstructionWork operation)))
      ((set (InstructionWork (ClonedOperation context operation)) work)) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= width (OperationWidth operation)))
      ((set (OperationWidth (ClonedOperation context operation)) width)) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ConsumesInput operation slot))
      ((ConsumesInput (ClonedOperation context operation) slot)) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (IndexCalculationOperation operation))
      ((IndexCalculationOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneMember context region) (= value (RegionReturnType region slot))) ((CloneReturnDemand context value)) :ruleset clone-index)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= value (CallReturnType operation k0))) ((CloneReturnDemand context value)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneReturnDemand context info) (= info (ReturnScalar value)))
      ((set (CloneReturn context info) info)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneReturnDemand context info) (= info (ReturnResource value)))
      ((set (CloneReturn context info) info)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneReturnDemand context info) (= info (LogicalReturn value)))
      ((set (CloneReturn context info) info)) :ruleset clone-edges)
(rule ((= revision (AnalysisRevision)) (CloneReturnDemand context (ReturnAccumulator info)))
      ((CloneAccInfoDemand context info)) :ruleset clone-index)
(rule ((= revision (AnalysisRevision)) (CloneReturnDemand context result) (= result (ReturnAccumulator info))
       (= replacement (CloneAccInfo context info)))
      ((set (CloneReturn context result) (ReturnAccumulator replacement))) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (MaterializedCopyOperation operation)) ((MaterializedCopyOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ViewOperation operation)) ((ViewOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (ArrayLiteralOperation operation)) ((ArrayLiteralOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (RangeOperation operation)) ((RangeOperation (ClonedOperation context operation))) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (PreservesInputShape operation v0 v1)) ((PreservesInputShape (ClonedOperation context operation) v0 v1)) :ruleset clone-edges)

(rule ((= revision (AnalysisRevision)) (CloneOperation context operation) (= span (OperationSpan operation)))
      ((set (OperationSpan (ClonedOperation context operation)) span)) :ruleset clone-edges)
