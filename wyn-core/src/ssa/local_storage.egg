; Rust imports local SSA values, instruction points, and CFG edges. These rules
; compute version webs, edge-translated liveness, interference, and allocation
; reuse. Each stratum settles before a negative (false) proof is consumed.
(relation Array (i64))
(relation Link (i64 i64))
(function Web (i64) i64 :merge (min old new))
(relation Updated (i64))
(relation Origin (i64))
(relation Escape (i64))
(relation Parameter (i64 i64))
(relation NonParameter (i64))
(relation Argument (i64 i64 i64))
(relation Edge (i64 i64 i64))
(relation Step (i64 i64))
(relation Define (i64 i64 i64))
(relation Write (i64 i64))
(relation Use (i64 i64))
(relation Live (i64 i64))
(function Blocked (i64) bool :merge (or old new))
(function MultipleOrigins (i64) bool :merge (or old new))
(relation Reuse (i64))
(relation Flow (i64 i64))
(relation Allocation (i64))
(relation PlaceIndex (i64 i64))
(relation PlaceAlias (i64 i64))
(relation PlaceUse (i64 i64))
(relation OriginLoad (i64 i64 i64))
(relation AfterOrigin (i64 i64))
(function AccessedLater (i64) bool :merge (or old new))
(function Existing (i64) i64 :no-merge)
(ruleset storage-webs)
(ruleset storage-liveness)
(ruleset storage-select)
(ruleset storage-allocation)
(rule ((Array v)) ((set (Web v) v)) :ruleset storage-webs)
(rule ((Link a b) (= root (Web a))) ((set (Web b) root)) :ruleset storage-webs)
(rule ((Link a b) (= root (Web b))) ((set (Web a) root)) :ruleset storage-webs)

(rule ((= root (Web v))) ((set (Blocked root) false) (set (MultipleOrigins root) false)) :ruleset storage-liveness)
(rule ((Escape v) (= root (Web v))) ((set (Blocked root) true)) :ruleset storage-liveness)
(rule ((Use point v)) ((Live point v)) :ruleset storage-liveness)
(rule ((Step before after) (Live after v)) ((Live before v)) :ruleset storage-liveness)
(rule ((Define before after defined) (Live after v) (!= defined v)) ((Live before v)) :ruleset storage-liveness)
; Phi operands are simultaneous edge moves, not ordinary instruction reads.
(rule ((Edge edge before after) (Live after v) (NonParameter v)) ((Live before v)) :ruleset storage-liveness)
(rule ((Edge edge before after) (Live after v) (Parameter home v) (!= home after)) ((Live before v)) :ruleset storage-liveness)
(rule ((Edge edge before after) (Live after v) (Parameter after v) (Argument edge v arg)) ((Live before arg)) :ruleset storage-liveness)
(rule ((Write after v) (Live after old) (!= old v) (= root (Web v)) (= root (Web old)))
      ((set (Blocked root) true)) :ruleset storage-liveness)
(rule ((Parameter point a) (Parameter point b) (!= a b) (Live point a) (Live point b)
       (= root (Web a)) (= root (Web b))) ((set (Blocked root) true)) :ruleset storage-liveness)
(rule ((Origin a) (Origin b) (!= a b) (= root (Web a)) (= root (Web b)))
      ((set (MultipleOrigins root) true)) :ruleset storage-liveness)

; An initializer's place is reusable only if no subsequent reachable access
; (including derived element pointers and backedges) can observe its mutation.
(rule ((OriginLoad v place after))
      ((AfterOrigin v after) (PlaceAlias place place) (set (AccessedLater v) false)) :ruleset storage-liveness)
(rule ((PlaceAlias base p) (PlaceIndex p child)) ((PlaceAlias base child)) :ruleset storage-liveness)
(rule ((AfterOrigin v before) (Flow before after)) ((AfterOrigin v after)) :ruleset storage-liveness)
(rule ((OriginLoad v base start) (AfterOrigin v point) (PlaceUse point p) (PlaceAlias base p))
      ((set (AccessedLater v) true)) :ruleset storage-liveness)
(rule ((Updated v) (= root (Web v)) (Origin origin) (= root (Web origin)) (= false (Blocked root)))
      ((Reuse root)) :ruleset storage-select)
(rule ((Reuse root) (OriginLoad v p after) (= root (Web v))
       (= false (MultipleOrigins root)) (= false (AccessedLater v)) (Allocation p))
      ((set (Existing root) p)) :ruleset storage-allocation)
