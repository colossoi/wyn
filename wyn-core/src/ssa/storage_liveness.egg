; Shared edge-aware liveness for logical array versions and physical buffers.
(relation Use (i64 i64))
(relation Live (i64 i64))
(relation Step (i64 i64))
(relation Define (i64 i64 i64))
(relation Parameter (i64 i64))
(relation NonParameter (i64))
(relation Argument (i64 i64 i64))
(relation Edge (i64 i64 i64))
(ruleset storage-liveness)
(rule ((Use point v)) ((Live point v)) :ruleset storage-liveness)
(rule ((Step before after) (Live after v)) ((Live before v)) :ruleset storage-liveness)
(rule ((Define before after defined) (Live after v) (!= defined v)) ((Live before v)) :ruleset storage-liveness)
; Phi operands are simultaneous edge moves, not ordinary instruction reads.
(rule ((Edge edge before after) (Live after v) (NonParameter v)) ((Live before v)) :ruleset storage-liveness)
(rule ((Edge edge before after) (Live after v) (Parameter home v) (!= home after)) ((Live before v)) :ruleset storage-liveness)
(rule ((Edge edge before after) (Live after v) (Parameter after v) (Argument edge v arg)) ((Live before arg)) :ruleset storage-liveness)
