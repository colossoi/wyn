; SSA identities and provenance share the same value and execution graph.
(constructor SsaValue (i64) SourceValue)
(constructor SsaPlace (i64) SourceValue)
(constructor SsaInstruction (i64) SourceValue)
(constructor SsaReturn (i64) SourceValue)
(datatype MemoryRoot (MemoryAllocation i64) (MemoryWorkgroup i64) (MemoryExternal) (MemoryUnknown))
(relation MemoryObject (SourceValue))
(relation MemoryOrigin (SourceValue MemoryRoot))
(function MemoryKnown (SourceValue) bool :merge (or old new))
(ruleset memory-origins)
(ruleset memory-unknown)
(rule ((MemoryObject value)) ((set (MemoryKnown value) false)) :ruleset memory-origins)
(rule ((MemoryOrigin value root)) ((set (MemoryKnown value) true)) :ruleset memory-origins)
(rule ((FlowFrom value parent) (MemoryOrigin parent root)) ((MemoryOrigin value root)) :ruleset memory-origins)
; Only after known origins settle do unresolved descriptors become unknown.
(rule ((= (MemoryKnown value) false)) ((MemoryOrigin value (MemoryUnknown))) :ruleset memory-unknown)

(relation MemoryUse (SourceValue SourceValue bool))
(relation MemoryAccess (SourceValue MemoryRoot bool))
(relation MemoryEscapes (SourceValue))
(relation MemoryEscaped (MemoryRoot))
(relation MemorySharedInstruction (i64))
(relation MemorySharedAccess (bool))
(ruleset memory-access)
(rule ((MemoryUse point value write) (MemoryOrigin value root)) ((MemoryAccess point root write)) :ruleset memory-access)
(rule ((MemoryAccess point (MemoryWorkgroup id) write)) ((MemorySharedAccess write)) :ruleset memory-access)
(rule ((MemoryAccess point (MemoryUnknown) write)) ((MemorySharedAccess write)) :ruleset memory-access)
(rule ((MemoryEscapes value) (MemoryOrigin value root)) ((MemoryEscaped root)) :ruleset memory-access)

(relation MemoryLoaded (SourceValue))
(relation MemoryStoragePlace (i64))
(ruleset memory-loaded)
(rule ((MemoryLoaded (SsaPlace base)) (MemoryOrigin (SsaPlace base) (MemoryAllocation base))
       (MemoryOrigin (SsaPlace place) (MemoryAllocation base)))
      ((MemoryStoragePlace place)) :ruleset memory-loaded)

(rule ((MemoryAccess (SsaInstruction inst) (MemoryWorkgroup id) write)) ((MemorySharedInstruction inst)) :ruleset memory-access)
(rule ((MemoryAccess (SsaInstruction inst) (MemoryUnknown) write)) ((MemorySharedInstruction inst)) :ruleset memory-access)

(relation MemoryEscapedWorkgroup (i64))
(rule ((MemoryEscaped (MemoryWorkgroup id))) ((MemoryEscapedWorkgroup id)) :ruleset memory-access)
(rule ((MemoryEscaped (MemoryUnknown)) (MemoryOrigin value (MemoryWorkgroup id))) ((MemoryEscapedWorkgroup id)) :ruleset memory-access)
