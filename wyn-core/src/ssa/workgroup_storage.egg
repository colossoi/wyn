; A dead buffer stays occupied until all lanes have passed a barrier.
(relation TransferStep (SourceValue SourceValue i64))
(relation Pending (SourceValue i64))
(relation PoolPair (i64 i64))
(relation Interference (i64 i64))
(ruleset storage-interference)
(function WorkgroupOrdered (SourceValue) bool :merge (or old new))

(rule ((FlowUse point v)) ((Pending point v)) :ruleset storage-interference)
(rule ((FlowNext before after) (= (WorkgroupOrdered before) false) (Pending before v)) ((Pending after v)) :ruleset storage-interference)
; A full identity transfer reads each lane's element before writing it. Other
; buffers' pending accesses still cross the transfer unchanged.
(rule ((TransferStep before after source) (Pending before v) (!= source v)) ((Pending after v)) :ruleset storage-interference)
(rule ((PoolPair a b) (FlowLive point a) (FlowLive point b)) ((Interference a b)) :ruleset storage-interference)
(rule ((PoolPair a b) (Pending point a) (FlowLive point b)) ((Interference a b)) :ruleset storage-interference)
(rule ((PoolPair a b) (FlowLive point a) (Pending point b)) ((Interference a b)) :ruleset storage-interference)
(rule ((PoolPair a b) (Pending point a) (Pending point b)) ((Interference a b)) :ruleset storage-interference)

; Access facts serve both transfer legality and liveness, without a Rust readback.
(relation WorkgroupDefine (SourceValue i64))
(relation WorkgroupAccess (SourceValue i64 bool))
(relation WorkgroupUnknown (SourceValue bool))
(relation WorkgroupCopy (SourceValue SourceValue i64 i64))
(relation WorkgroupPrior (SourceValue SourceValue))
(relation TransferStepAt (SourceValue))
(function WorkgroupCopyBlocked (SourceValue) bool :merge (or old new))
(ruleset workgroup-access)
(ruleset workgroup-prior)
(ruleset workgroup-transfers)
(ruleset workgroup-uses)
(rule ((FlowNext before after))
      ((set (WorkgroupOrdered before) false)) :ruleset workgroup-access)
(rule ((WorkgroupUnknown point write) (WorkgroupDefine definition id))
      ((WorkgroupAccess point id write)) :ruleset workgroup-access)
(rule ((WorkgroupCopy before after source destination))
      ((set (WorkgroupCopyBlocked before) false)) :ruleset workgroup-access)
(rule ((WorkgroupCopy before after source destination) (FlowNext previous before) (= (WorkgroupOrdered previous) false))
      ((WorkgroupPrior before previous)) :ruleset workgroup-prior)
(rule ((WorkgroupPrior copy point) (FlowNext previous point) (= (WorkgroupOrdered previous) false))
      ((WorkgroupPrior copy previous)) :ruleset workgroup-prior)
(rule ((WorkgroupCopy before after source destination) (WorkgroupPrior before point) (WorkgroupAccess point source write))
      ((set (WorkgroupCopyBlocked before) true)) :ruleset workgroup-prior)
(rule ((WorkgroupCopy before after source destination) (WorkgroupPrior before point) (WorkgroupAccess point destination write))
      ((set (WorkgroupCopyBlocked before) true)) :ruleset workgroup-prior)
(rule ((WorkgroupCopy before after source destination) (= (WorkgroupCopyBlocked before) false))
      ((TransferStepAt before) (set (WorkgroupOrdered before) true)
       (set (FlowKilled before destination) true) (FlowUse before source) (FlowUse after destination)
       (TransferStep before after source)) :ruleset workgroup-transfers)
(rule ((WorkgroupDefine point id)) ((set (FlowKilled point id) true)) :ruleset workgroup-access)
(rule ((WorkgroupAccess point id write) (= (WorkgroupOrdered point) false))
      ((FlowUse point id)) :ruleset workgroup-uses)

(relation WorkgroupBarrier (SourceValue))
(sort WorkgroupBuffers (Set i64))
(function WorkgroupAccesses (SourceValue bool) WorkgroupBuffers :merge (set-union old new))
(rule ((WorkgroupBarrier point)) ((set (WorkgroupOrdered point) true)) :ruleset workgroup-access)
(rule ((WorkgroupAccess point id write)) ((set (WorkgroupAccesses point write) (set-of id))) :ruleset workgroup-access)
