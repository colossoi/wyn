--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"projected_tuple_2_kept\""]

entry projected_tuple_2_kept(projected_tuple_2_xs:[]i32) []i32=map(|(x,y)|x+y,filter(|(x,y)|x>0,map(|x|(x,x+1),projected_tuple_2_xs)))
