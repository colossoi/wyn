--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_index_4_main\""]

entry tuple_index_4_main(tuple_index_4_xs:[1]i32,tuple_index_4_ys:[4]i32,tuple_index_4_zs:[4]i32,flag:bool,i:i32) i32 =
         let arrays=if flag then (tuple_index_4_xs,tuple_index_4_ys) else (tuple_index_4_xs,tuple_index_4_zs) in
         let (_,right)=arrays in right[i]


-- nested_tuple_array_operations_reach_both_backends
