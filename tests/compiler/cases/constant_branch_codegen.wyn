--! math = { Sin = 1 }



def ACONST_0:i32=8
entry constant_branch_0(xs:[]f32) []f32=map(|x|if ACONST_0 < 7 then loop v = x for k < 8 do f32.sin(v) else x,xs)

def ACONST_1:i32=8
entry constant_branch_1(xs:[]f32) []f32=map(|x|if ACONST_1 >= 7 then x else loop v = x for k < 8 do f32.sin(v),xs)

def ACONST_2:i32=8
entry constant_branch_2(xs:[]f32) []f32=map(|x|if (if x < 0.0 then ACONST_2 < 7 else ACONST_2 < 6) then loop v = x for k < 8 do f32.sin(v) else x,xs)

def ACONST_3:i32=8
entry constant_branch_3(xs:[]f32) []f32=map(|x|loop a = x for j < 3 do if ACONST_3 < 7 then loop v = a for k < 8 do f32.sin(v) else a + 1.0,xs)

def ACONST_4:i32=8
entry constant_branch_4(xs:[]f32) []f32=map(|x|if ACONST_4 >= 7 then loop v = x for k < 8 do f32.sin(v) else x,xs)

def ACONST_5:i32=8
entry constant_branch_5(xs:[]f32) []f32=map(|x|if x < 7.0 then loop v = x for k < 8 do f32.sin(v) else x,xs)
