--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"permuted_digits\"", ":source-name \"overlapping_digits\"", ":source-name \"incomplete_digits\""]

entry permuted_digits() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=4*(a%2)+2*((a/4)%2)+a/8 in if r<8 then rows[r][(a/2)%2] else -1,iota(16))
entry overlapping_digits() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=a%8 in if r<8 then rows[r][a%2] else -1,iota(16))
entry incomplete_digits() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=(a/2)%4+4*(a/3) in if r<8 then rows[r][a%2] else -1,iota(16))
