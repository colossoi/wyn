--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_index_0_main\""]

entry tuple_index_0_main(tuple_index_0_xs:[4]i32,i:i32) (i32,(i32,i32)) =
         let tuple_index_0_ys=map(|x|(x,(x+1,x+2)),tuple_index_0_xs) in tuple_index_0_ys[i]
