--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_helper_5_main\""]

def tuple_helper_5_firsts<[tuple_helper_5_n], A, B>(tuple_helper_5_xs:[tuple_helper_5_n](A,B)) [tuple_helper_5_n]A=map(|(a,b)|a,tuple_helper_5_xs)
entry tuple_helper_5_main(tuple_helper_5_xs:[4]i32) []i32=tuple_helper_5_firsts(filter(|(a,b)|a>0,map(|x|(x,x+1),tuple_helper_5_xs)))


-- runtime_indexing_a_tuple_valued_map_preserves_storage_layout
