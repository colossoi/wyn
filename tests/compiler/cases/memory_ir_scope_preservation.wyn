--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"repeated_helpers\"", ":source-name \"dead_middle\"", ":source-name \"sibling_extents\""]
--! [[host]]
--! entry = "repeated_helpers"
--! calls = { "gpu-dispatch" = 1 }
--! [[host]]
--! entry = "dead_middle"
--! calls = { "gpu-dispatch" = 1 }

-- Inlining must freshen binders and keep each call's captured argument.
def shifted(xs:[4]i32,k:i32) [4]i32 = map(|x|x+k,xs)
entry repeated_helpers(xs:[4]i32,k:i32) [4]i32 = shifted(shifted(xs,k),k+1)

-- Removing a dead producer must retain the live body's bindings and one dispatch.
entry dead_middle(xs:[4]i32) [4]i32 = let _unused=map(|x|x+9,xs) in map(|x|x*2,xs)

-- Shape computations defined in sibling branches must remain in their own scope.
entry sibling_extents(n:i32,b:bool) []i32 =
  if b then (let count=n+1 in iota(count)) else (let count=n+2 in iota(count))
