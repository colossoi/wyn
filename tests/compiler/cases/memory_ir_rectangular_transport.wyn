--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"runtime_rows\""]
--! [[host]]
--! entry = "runtime_rows"
--! inputs = {xs=[10,20,30],n=[4]}
--! dispatches = 4
--! result_layouts = ["(:array :length :dynamic :stride 4 :range :caller :element :i32)", ":i32"]
--! no_device_reads = true

entry runtime_rows(xs:[]i32,n:i32) ([][]i32,i32)=let ys=map(|x|map(|y|x+y,iota(n+1)),xs) let total=reduce((+),0,xs) in (ys,total)
