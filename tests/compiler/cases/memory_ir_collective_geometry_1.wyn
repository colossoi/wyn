--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scan_values\""]
--! [[shader]]
--! entry = "scan_values"
--! entry_count = 1
--! workgroup_size = [256, 1, 1]
--! workgroup_storage = true
--! barrier = true
--! [[host]]
--! entry = "scan_values"
--! result_bytes = 4
--! dispatches = 1
--! no_device_reads = true

entry scan_values(xs:[1]i32) [1]i32=scan((+),0,xs)
