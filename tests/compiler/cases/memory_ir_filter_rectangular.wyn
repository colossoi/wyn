--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"filtered_rows\""]
--! [[shader]]
--! entry = "filtered_rows"
--! targets = ["wgsl"]
--! parallel = true

-- Filtering complete rows must remain parallel and preserve row width.
entry filtered_rows(xs:[][4]i32) [][4]i32 = filter(|row|row[0]>0,xs)
