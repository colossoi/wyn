--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_index_1_main\""]

entry tuple_index_1_main(tuple_index_1_xs:[]i32,i:i32) (i32,(bool,i32)) =
         let tuple_index_1_ys=map(|x|(x,(x>0,x+2)),tuple_index_1_xs) in tuple_index_1_ys[i]
