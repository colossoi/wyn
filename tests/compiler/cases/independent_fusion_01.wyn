--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"choice_rows\"", ":source-name \"choice_empty\"", ":source-name \"choice_totals\""]

entry choice_rows() [3][4]i32=map(|x|if x>0 then map(|y|100/(x+y),iota(4)) else map(|y|x+y,iota(4)),[0,1,-1])
entry choice_empty() [3][0]i32=map(|x|if x>0 then map(|y|1/x+y,iota(0)) else map(|y|x-y,iota(0)),[0,1,-1])
entry choice_totals() [3]i32=map(|n|if n>0 then reduce((+),0,map(|i|100/(i+n),iota(4))) else reduce((+),0,map(|i|i+n,iota(3))),[0,1,-1])
