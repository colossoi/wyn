--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"indexed\"", ":source-name \"vectors\"", ":source-name \"ordinary\""]
--! [[shader]]
--! entry = "indexed"
--! atomic = "Add"

-- Independent entries reuse descriptor slots with different element types.
entry indexed(dest:*[3]i32,xs:[5]i32) [3]i32 =
  reduce_by_index(dest,(+),0i32,map(|x|x%3,xs),xs)
entry vectors(xs:[2]vec4f32) vec4f32 = xs[0]
entry ordinary(xs:[4]i32) i32 = xs[0]
