--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"runtime_rows\""]
--! [[host]]
--! entry = "runtime_rows"
--! inputs = {xs=[10,20,30],n=[4]}
--! result_bytes = 60
--! no_device_reads = true

def row_count(n:i32,x:i32) []i32=map(|y|x+y,iota(n+1))
entry runtime_rows(xs:[]i32,n:i32) [][]i32=map(|x|row_count(n,x),xs)
