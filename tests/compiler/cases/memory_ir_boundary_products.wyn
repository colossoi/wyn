--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"nested_products\""]

-- Public results must pack product elements inside nested array layouts.
entry nested_products(xs:[]i32) [][](i32,bool) =
  map(|x|map(|i|(x+i,i%2==0),iota(x)),xs)
