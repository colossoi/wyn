--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"main\""]
--! [[shader]]
--! entry = "main"
--! forbidden_local_array_lengths = [32]

-- A backedge can increase lo to 17, so the final scan can have 34 values.
-- It must not inherit the initial interval's 32-element capacity.
-- Regression: allocation must use a proven search-interval bound instead of
-- trying to evaluate the GPU-dependent loop on the host. Both backends compile.
entry main(xs:[16]i32, needle:i32) []i32 =
  let (lo,hi) = loop (lo,hi) = (0i32,length(xs)) while lo < hi do
    let mid = lo+(hi-lo)/2 in
    if xs[mid] < needle then (hi+1,hi) else (lo,mid) in
  scan((+),0i32,map(|i| i*i,iota(lo*2)))
