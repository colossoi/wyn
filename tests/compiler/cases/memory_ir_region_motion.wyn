--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"closed_reduction\"", ":source-name \"guarded_division\""]
--! [[host]]
--! entry = "closed_reduction"
--! calls = { "gpu-dispatch" = 2 }
--! [[host]]
--! entry = "guarded_division"
--! calls = { "gpu-dispatch" = 1 }

-- The invariant reduction is computed once before the map.
entry closed_reduction(xs:[4]i32) [4]i32 =
  map(|p|reduce((+),0i32,xs)+p,xs)
-- Division must remain inside the map: an empty input must not evaluate it.
entry guarded_division(xs:[]i32,d:i32) []i32 = map(|x|1/d+x,xs)
