--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"fresh_scratch\""]
--! [[host]]
--! entry = "fresh_scratch"
--! minimum_calls = { "gpu-alloc" = 1 }

entry fresh_scratch(xs:[]i32) ([]i32,[]i32) =
  (xs,scatter(duplicate_scratch(xs),iota(length(xs)),map(|x|x+1,xs)))
