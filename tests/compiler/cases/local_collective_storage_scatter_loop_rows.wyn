--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scatter_loop_rows\""]
--! [[shader]]
--! entry = "scatter_loop_rows"
--! targets = ["wgsl"]
--! parallel = true

entry scatter_loop_rows(xs:[]i32) [][4]i32=map(|x|loop a=replicate(4,0i32) for i<3 do scatter(a,[i],[x+i]),xs)
-- Whole-row state copies can use short loops; the scan must remain cooperative.
