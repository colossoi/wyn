--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"chain\"", ":source-name \"independent\"", ":source-name \"product_input\""]
--! [[host]]
--! entry = "chain"
--! result_aliases = ["input-xs"]
--! allocations = []
--! dispatches = 1
--! [[host]]
--! entry = "independent"
--! result_aliases = ["input-xs", "input-ys"]
--! allocations = []
--! dispatches = 1
--! [[host]]
--! entry = "product_input"
--! result_aliases = ["input-xs-0", "input-xs-1"]
--! allocations = []

entry chain(xs:*[4]i32) [4]i32 = map(|x|x*2,map(|x|x+1,xs))
entry independent(xs:*[4]i32,ys:*[4]i32) ([4]i32,[4]i32) =
  (map(|x|x+1,ys),map(|x|x*2,xs))
entry product_input(xs:([]i32,[]i32)) ([]i32,[]i32) = xs
