--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"constructed\""]

-- Nested construction must retain empty rows and varying lengths.
entry constructed(n:i32) [][]i32 = [iota(n),iota(0),iota(n+1)]
