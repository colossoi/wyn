--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"lookup\"", ":source-name \"lookup3\""]
--! [[spirv]]
--! entry = "lookup"
--! array_traffic = [0, 0, 0]
--! [[spirv]]
--! entry = "lookup3"
--! array_traffic = [0, 0, 0]
--! [[shader]]
--! entry = "lookup"
--! targets = ["wgsl"]
--! local_array_traffic = [0, 0, 0]
--! [[shader]]
--! entry = "lookup3"
--! targets = ["wgsl"]
--! local_array_traffic = [0, 0, 0]

-- Read a single element without copying intermediate rows into private arrays.
entry lookup(xs: [][64]i32, indices: []vec2i32) []i32 =
  map(|i| xs[i.x][i.y],indices)

entry lookup3(xs: [][4][64]i32, indices: []vec3i32) []i32 =
  map(|i| xs[i.x][i.y][i.z],indices)
