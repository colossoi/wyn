--! command = "build"
--! exit = 0
--! targets = ["spirv"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"linked_slice\""]
--! [[spirv]]
--! entry = "linked_slice"
--! present = ["FunctionCall"]

#[linked("slice_identity")]
extern slice_identity(xs:[4]i32) [4]i32
entry linked_slice(xs:[7]i32) [4]i32=slice_identity(xs[1..5])
