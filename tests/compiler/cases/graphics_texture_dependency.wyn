--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! rust_host = true
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"texture_dependency_0_reproduce\"", ":source-name \"texture_dependency_1_reproduce\""]
--! [[host]]
--! entry = "texture_dependency_0_reproduce"
--! texture_draw_chain = true
--! [[host]]
--! entry = "texture_dependency_1_reproduce"
--! texture_draw_chain = true



-- texture_consumers_wait_for_draws_with_delayed_vertex_inputs
-- A texture consumer must wait for the whole draw, including its texture_dependency_0_filtered vertices.
def texture_dependency_0_filtered(texture_dependency_0_values: []vec4f32) []vec4f32 =
  let selected = filter(|v: vec4f32| v.w > 0.0, texture_dependency_0_values) in
  map(|v| v, selected)

def texture_dependency_0_replace_state: fragment_state = {
  depth_test = #disabled, depth_write = false,
  blend = #replace, color_write = true,
}

entry texture_dependency_0_reproduce(texture_dependency_0_values: []vec4f32, coords: []vec2i32,
                scene: render_target<f32>, surface: render_target<vec4f32>)
    ([]f32, render_target<f32>, render_target<vec4f32>) =
  let visible = texture_dependency_0_filtered(texture_dependency_0_values)
  let ground_raster = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32| vertex_output(texture_dependency_0_values[i32(index)], 0.2))
  let ground = shade_with(texture_dependency_0_replace_state, scene, ground_raster,
    |value, _, _, _, _| value)
  let prop_raster = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32| vertex_output(visible[i32(index)], 0.8))
  let scene_image = shade_with(texture_dependency_0_replace_state, ground, prop_raster,
    |value, _, _, _, _| value)
  let sampled = map(|coord: vec2i32| target_load(scene_image, coord, 0u32), coords)
  let resolve_raster = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32| vertex_output(texture_dependency_0_values[i32(index)], 0.0))
  let image = shade(surface, resolve_raster,
    |_, position, _, _, _|
      @[sampled[i32(position.x) % length(sampled)], 0.0, 0.0, 1.0]) in
  (sampled, scene_image, image)


-- A texture consumer must wait for the whole draw, including its texture_dependency_1_filtered vertices.
def texture_dependency_1_filtered(texture_dependency_1_values: []vec4f32) []vec4f32 =
  map(|v| v, texture_dependency_1_values)

def texture_dependency_1_replace_state: fragment_state = {
  depth_test = #disabled, depth_write = false,
  blend = #replace, color_write = true,
}

entry texture_dependency_1_reproduce(texture_dependency_1_values: []vec4f32, control_coords: []vec2i32,
                control_scene: render_target<f32>, control_surface: render_target<vec4f32>)
    ([]f32, render_target<f32>, render_target<vec4f32>) =
  let visible = texture_dependency_1_filtered(texture_dependency_1_values)
  let ground_raster = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32| vertex_output(texture_dependency_1_values[i32(index)], 0.2))
  let ground = shade_with(texture_dependency_1_replace_state, control_scene, ground_raster,
    |value, _, _, _, _| value)
  let prop_raster = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32| vertex_output(visible[i32(index)], 0.8))
  let scene_image = shade_with(texture_dependency_1_replace_state, ground, prop_raster,
    |value, _, _, _, _| value)
  let sampled = map(|coord: vec2i32| target_load(scene_image, coord, 0u32), control_coords)
  let resolve_raster = rasterize_triangles(direct_draw(3u32, 1u32),
    |index: u32, _: u32, _: u32| vertex_output(texture_dependency_1_values[i32(index)], 0.0))
  let image = shade(control_surface, resolve_raster,
    |_, position, _, _, _|
      @[sampled[i32(position.x) % length(sampled)], 0.0, 0.0, 1.0]) in
  (sampled, scene_image, image)
