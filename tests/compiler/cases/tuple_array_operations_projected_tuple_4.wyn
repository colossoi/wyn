--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"projected_tuple_4_kept\""]

entry projected_tuple_4_kept(projected_tuple_4_xs:[]i32) ([]i32,[]i32)=(projected_tuple_4_xs,map(|(x,y)|y,filter(|(x,y)|x>0,map(|x|(x,x+1),projected_tuple_4_xs))))
