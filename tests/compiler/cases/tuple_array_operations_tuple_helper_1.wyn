--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_helper_1_main\""]

entry tuple_helper_1_main(tuple_helper_1_xs:[]i32) []i32=
         let (a,b)=unzip(map(|x|(x,(x,x+1)),tuple_helper_1_xs)) in map(|(c,d)|c+d,b)
