--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"branch_backings\""]

-- Known gap: reconcile nested descriptors referring to different payload buffers.
entry branch_backings(xs:[]i32,b:bool) [][]i32 =
  if b then [map(|x| x+1,xs)] else [map(|x| x+2,xs)]
