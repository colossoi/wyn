--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! spirv_round_trip = true
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"packed\""]
--! excludes = ["gpu-read-scalar"]
--! [[artifacts]]
--! path = "output.wgsl"
--! targets = ["wgsl"]
--! contains = ["atomicAdd("]

entry packed(arena: *[8]i32, row: []i32) [4]i32 =
  let (values, rows) = Segmented.flatmap(arena,
    |n| if n <= 0 then (row[0..0],n+1) else (row[0..min(n,length(row))],n+1), iota(4)) in
  map(|(r, side)| if !Segmented.fits(r) then -1i32 else
    if Segmented.size(r) == 0 then side else Segmented.get(values,r,0)+side, rows)
