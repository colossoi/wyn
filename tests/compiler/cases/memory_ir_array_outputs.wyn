--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"mapped\"", ":source-name \"literal\"", ":source-name \"pair\"", ":source-name \"prefixes\"", ":source-name \"map_chain\"", ":source-name \"mapped_rows\""]

entry mapped(xs:[]i32) []i32 = map(|x|x+1,xs)
entry literal() [3]i32 = [2,4,8]
entry pair(x:i32) (i32,bool) = (x+1,x>0)
entry prefixes(xs:[]i32) []i32 = scan((+),0i32,xs)
entry map_chain(xs:[]i32) []i32 = map(|x|x*2,map(|x|x+1,xs))
entry mapped_rows(xs:[][4]i32) [][4]i32 = map(|row|map(|x|x+1,row),xs)
