--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"projected_tuple_0_kept\""]

entry projected_tuple_0_kept(projected_tuple_0_xs:[]i32) [](i32,i32)=filter(|(x,y)|x>0,map(|x|(x,x+1),projected_tuple_0_xs))
