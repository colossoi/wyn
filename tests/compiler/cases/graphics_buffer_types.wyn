--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"draw_0\"", ":source-name \"compute_0\"", ":source-name \"draw_1\"", ":source-name \"compute_1\"", ":source-name \"draw_2\"", ":source-name \"compute_2\"", ":source-name \"draw_3\"", ":source-name \"compute_3\""]

def pick(xs: []f32) f32 = let first = xs[0] let last = xs[length(xs) - 1] in if first > last then first else last
entry draw_0(weights_0: []f32, target: render_target<vec4f32>) render_target<vec4f32> =
  let fragments = rasterize_triangles(direct_draw(3u32, 1u32),
    |_, _, _| vertex_output(@[0.0, 0.0, 0.0, 1.0], ())) in
  shade(target, fragments, |_, _, _, _, _| @[weights_0[0], 0.0, 0.0, 1.0])
entry compute_0(values_0: []vec4f32) []vec4f32 = map(|v| v * 2.0, values_0)

entry draw_1(weights_1: []f32, target: render_target<vec4f32>) render_target<vec4f32> =
  let fragments = rasterize_triangles(direct_draw(3u32, 1u32),
    |_, _, _| vertex_output(@[0.0, 0.0, 0.0, 1.0], ())) in
  shade(target, fragments, |_, _, _, _, _| @[weights_1[length(weights_1) - 1], 0.0, 0.0, 1.0])
entry compute_1(values_1: []vec4f32) []vec4f32 = map(|v| v * 2.0, values_1)

entry draw_2(weights_2: []vec4f32, target: render_target<vec4f32>) render_target<vec4f32> =
  let fragments = rasterize_triangles(direct_draw(3u32, 1u32),
    |_, _, _| vertex_output(@[0.0, 0.0, 0.0, 1.0], ())) in
  shade(target, fragments, |_, _, _, _, _| @[weights_2[0].x, 0.0, 0.0, 1.0])
entry compute_2(values_2: []f32) []f32 = map(|v| v * 2.0, values_2)

entry draw_3(weights_3: []f32, target: render_target<vec4f32>) render_target<vec4f32> =
  let fragments = rasterize_triangles(direct_draw(3u32, 1u32),
    |_, _, _| vertex_output(@[0.0, 0.0, 0.0, 1.0], ())) in
  shade(target, fragments, |_, _, _, _, _| @[pick(weights_3), 0.0, 0.0, 1.0])
entry compute_3(values_3: []vec4f32) []vec4f32 = map(|v| v * 2.0, values_3)
