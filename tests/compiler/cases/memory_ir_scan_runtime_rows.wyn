--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"runtime_rows\""]
--! [[shader]]
--! entry = "runtime_rows"
--! targets = ["wgsl"]
--! parallel = true

-- Runtime-uniform row widths must not force a serial outer scan.
entry runtime_rows(xs:[]i32,n:i32) [][]i32 =
  scan(|a,b|map2((+),a,b),replicate(n,0i32),map(|x|replicate(n,x),xs))
