-- Migrated from test_array_function_call
def array_function_call_process(arr: [4]i32) [4]i32 = arr


entry array_function_call_vertex_main() vec4f32 =
    let h = array_function_call_process([1i32, 2i32, 3i32, 4i32]) in
    @[f32.i32(h[0]), f32.i32(h[3]), 0.0f32, 1.0f32]

-- Migrated from test_array_param_stack_overflow
def array_param_stack_overflow_first(arr: [4]i32) i32 = arr[0]


entry array_param_stack_overflow_fragment_main(pos: vec4f32) vec4f32 =
    let x = array_param_stack_overflow_first([1, 2, 3, 4]) in
    @[f32.i32(x), 0.0f32, 0.0f32, 1.0f32]

-- Migrated from test_view_array_param_stack_overflow
def view_array_param_stack_overflow_first(arr: []i32) i32 = arr[0]

entry view_array_param_stack_overflow_main(data: []i32) []i32 = [view_array_param_stack_overflow_first(data)]

-- vector_input_and_runtime_gather_after_scan_reach_wgsl
-- Gather over a scan of a computed array. The producer map fuses into the
-- scan (vec4f32 -> i32), which is then materialized into a buffer the
-- consumer indexes at a runtime position.
entry vector_input_and_runtime_gather_after_scan_reach_wgsl_0_gen(bh: []vec4f32) []i32 =
  let counts = map(|h: vec4f32| 4 + 5 * (if h.x > 4.0 then 3 else 1), bh)
  let offsets = scan(|a: i32, b: i32| a + b, 0, counts) in
  map(|i: i32| offsets[i % 256], iota(6144))

-- shared_fused_helpers_reach_valid_wgsl
def shared_fused_helpers_reach_valid_wgsl_0_pass<[n]>(xs: [n]i32, bias: i32) [n]i32 =
  let a = map(|x| x + bias,xs) in
  map(|x| x * 2,a)

def shared_fused_helpers_reach_valid_wgsl_0_twice<[n]>(xs: [n]i32, bias: i32) [n]i32 =
  shared_fused_helpers_reach_valid_wgsl_0_pass(shared_fused_helpers_reach_valid_wgsl_0_pass(xs,bias),bias)

entry shared_fused_helpers_reach_valid_wgsl_0_main(xs: [4]i32) ([4]i32,[4]i32,[4]i32) =
  let a = shared_fused_helpers_reach_valid_wgsl_0_pass(xs,1) in
  let b = shared_fused_helpers_reach_valid_wgsl_0_pass(xs,3) in
  (a,b,shared_fused_helpers_reach_valid_wgsl_0_twice(a,2))

-- shared_producer_matrix_reaches_both_backends
entry shared_producer_matrix_reaches_both_backends_0_diamond(xs: []i32) []i32 =
  let a = map(|x| x*x+17, xs) in
  let b = map(|x| x*3, a) in
  map2(|x,y| x+y, a, b)

entry shared_producer_matrix_reaches_both_backends_0_retained(xs: []i32) []i32 =
  let a = map(|x| x*x+17, xs) in
  let total = reduce((+), 0, a) in
  map(|x| x+total, a)

entry shared_producer_matrix_reaches_both_backends_0_reductions(xs: []i32) (i32,i32) =
  let a = map(|x| x*x+17, xs) in
  (reduce((+), 0, a), reduce(|x,y| if x>y then x else y, 0, a))

entry shared_producer_matrix_reaches_both_backends_0_sliced(xs: []i32) [4]i32 =
  let a = map(|x| x+17, xs) in
  map(|x| x*3, a[2..6])

entry shared_producer_matrix_reaches_both_backends_0_nested(xs: []i32) []i32 =
  loop state=xs for i<2 do
    let a = map(|x| x+17, state) in
    let total = reduce((+), 0, a) in
    map(|x| x+total, a)

entry shared_producer_matrix_reaches_both_backends_0_action(xs: []i32) []i32 =
  let a = map(|x| x+17, xs) in
  let offsets = scan((+), 0, map(|x| 1, xs)) in
  scatter((#[scratch] copy(xs)), map(|x| x-1, offsets), a)

entry shared_producer_matrix_reaches_both_backends_0_observed_action(xs: []i32) ([]i32,[]i32) =
  let offsets = scan((+), 0, map(|x| 1, xs)) in
  (offsets, scatter((#[scratch] copy(xs)), map(|x| x-1, offsets), xs))

entry shared_producer_matrix_reaches_both_backends_0_dead_output(xs: []i32) []i32 =
  let dead = map(|x| x*x, xs) in
  let live = map(|x| x+17, xs) in
  scatter((#[scratch] dead), iota(length(xs)), live)
