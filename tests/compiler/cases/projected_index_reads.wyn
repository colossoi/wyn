--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_read\"", ":source-name \"captured_read\"", ":source-name \"snapshot_read\""]
--! [[shader]]
--! entry = "tuple_read"
--! local_array_traffic = [0, 0, 0]
--! [[shader]]
--! entry = "captured_read"
--! forbidden_local_array_lengths = [64]

-- A scalar read through a tuple field must not load the entire fixed array.
entry tuple_read(rows: []([64]i32,i32), indices: []vec2i32) []i32 =
  map(|i| let (row,_) = rows[i.x] in row[i.y],indices)

-- The same projection is captured by a nested callback.
entry captured_read(rows: []([64]i32,i32), indices: [][4]vec2i32) [][4]i32 =
  map(|is| map(|i| let (row,_) = rows[i.x] in row[i.y],is),indices)

-- Taking an old row before an update must retain the old value.
entry snapshot_read(rows: [][64]i32, indices: []vec2i32) []vec2i32 =
  map(|i| let old = rows[i.x] in
          let next = old with [i.y]=old[i.y]+1 in
          @[old[i.y],next[i.y]],indices)
