--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"inline_implicit_literal\"", ":source-name \"inline_implicit_named\"", ":source-name \"inline_implicit_borrowed\"", ":source-name \"inline_explicit_literal\"", ":source-name \"inline_explicit_named\"", ":source-name \"inline_explicit_borrowed\""]
--! [[host]]
--! entry = "inline_implicit_literal"
--! parameters = 2
--! allocations = [12]
--! draws = ["(:indexed allocation-12-0 :u32 3 2 0 0 0)"]
--! [[host]]
--! entry = "inline_implicit_named"
--! parameters = 2
--! allocations = [12]
--! draws = ["(:indexed allocation-12-0 :u32 3 2 0 0 0)"]
--! [[host]]
--! entry = "inline_implicit_borrowed"
--! scalar_arguments = [3]
--! allocations = []
--! draws = ["(:indexed input-indices :u32 3 2 0 0 0)"]
--! inputs = {"indices" = [0, 1, 2]}
--! [[host]]
--! entry = "inline_explicit_literal"
--! parameters = 2
--! allocations = [12]
--! draws = ["(:indexed allocation-12-0 :u32 3 2 0 0 0)"]
--! [[host]]
--! entry = "inline_explicit_named"
--! parameters = 2
--! allocations = [12]
--! draws = ["(:indexed allocation-12-0 :u32 3 2 0 0 0)"]
--! [[host]]
--! entry = "inline_explicit_borrowed"
--! allocations = []
--! draws = ["(:indexed input-indices :u32 3 2 0 0 0)"]
--! inputs = {"indices" = [0, 1, 2]}

entry inline_implicit_literal(screen:render_target<vec4f32>) render_target<vec4f32> =
     let covered=rasterize_triangles(indexed_draw([0u32,1u32,2u32], 2u32),
      |vi,ii,_|vertex_output(@[f32.u32(vi)*0.5,f32.u32(ii)*0.5,0.5,1.0],0.0)) in
    shade_with({depth_test=#less_equal,depth_write=true,blend=#replace,color_write=true},
      screen,covered,|_,_,_,_,_|@[1.0,0.0,0.0,1.0])

entry inline_implicit_named(screen:render_target<vec4f32>) render_target<vec4f32> =
    let indices=[0u32,1u32,2u32] in let covered=rasterize_triangles(indexed_draw(indices, 2u32),
      |vi,ii,_|vertex_output(@[f32.u32(vi)*0.5,f32.u32(ii)*0.5,0.5,1.0],0.0)) in
    shade_with({depth_test=#less_equal,depth_write=true,blend=#replace,color_write=true},
      screen,covered,|_,_,_,_,_|@[1.0,0.0,0.0,1.0])

entry inline_implicit_borrowed(indices:[]u32,screen:render_target<vec4f32>) render_target<vec4f32> =
     let covered=rasterize_triangles(indexed_draw(indices, 2u32),
      |vi,ii,_|vertex_output(@[f32.u32(vi)*0.5,f32.u32(ii)*0.5,0.5,1.0],0.0)) in
    shade_with({depth_test=#less_equal,depth_write=true,blend=#replace,color_write=true},
      screen,covered,|_,_,_,_,_|@[1.0,0.0,0.0,1.0])

entry inline_explicit_literal(screen:render_target<vec4f32>) render_target<vec4f32> =
     let covered=rasterize_triangles(indexed_draw_from([0u32,1u32,2u32], 3u32, 2u32, 0u32, 0i32, 0u32),
      |vi,ii,_|vertex_output(@[f32.u32(vi)*0.5,f32.u32(ii)*0.5,0.5,1.0],0.0)) in
    shade_with({depth_test=#less_equal,depth_write=true,blend=#replace,color_write=true},
      screen,covered,|_,_,_,_,_|@[1.0,0.0,0.0,1.0])

entry inline_explicit_named(screen:render_target<vec4f32>) render_target<vec4f32> =
    let indices=[0u32,1u32,2u32] in let covered=rasterize_triangles(indexed_draw_from(indices, 3u32, 2u32, 0u32, 0i32, 0u32),
      |vi,ii,_|vertex_output(@[f32.u32(vi)*0.5,f32.u32(ii)*0.5,0.5,1.0],0.0)) in
    shade_with({depth_test=#less_equal,depth_write=true,blend=#replace,color_write=true},
      screen,covered,|_,_,_,_,_|@[1.0,0.0,0.0,1.0])

entry inline_explicit_borrowed(indices:[]u32,screen:render_target<vec4f32>) render_target<vec4f32> =
     let covered=rasterize_triangles(indexed_draw_from(indices, 3u32, 2u32, 0u32, 0i32, 0u32),
      |vi,ii,_|vertex_output(@[f32.u32(vi)*0.5,f32.u32(ii)*0.5,0.5,1.0],0.0)) in
    shade_with({depth_test=#less_equal,depth_write=true,blend=#replace,color_write=true},
      screen,covered,|_,_,_,_,_|@[1.0,0.0,0.0,1.0])
