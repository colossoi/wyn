--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scatter_rows\"", ":source-name \"scatter_loop_rows\"", ":source-name \"scan_rows\""]
--! [[shader]]
--! entry = "scatter_rows"
--! targets = ["wgsl"]
--! parallel = true
--! [[shader]]
--! entry = "scatter_loop_rows"
--! targets = ["wgsl"]
--! parallel = true
--! [[shader]]
--! entry = "scan_rows"
--! targets = ["wgsl"]
--! workgroup_arrays_scalar = true
--! maximum_entry_loops = 1
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"nested_device_collectives_reach_wgsl_0_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"nested_reduction_stays_inside_the_map_invocation_0_sums\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"fused_local_slice_reductions_do_not_allocate_unused_producer_arrays_0_bounds\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"local_scatter_keeps_updates_inside_each_invocation_0_result\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"local_filter_preserves_its_live_length_0_result\""]

entry scatter_rows(xs:[]i32) [][4]i32=map(|x|scatter(replicate(4,0i32),[x%4],[x]),xs)
entry scatter_loop_rows(xs:[]i32) [][4]i32=map(|x|loop a=replicate(4,0i32) for i<3 do scatter(a,[i],[x+i]),xs)
entry scan_rows(xs:[][4]i32) [][4]i32=scan(|a,b|map2((+),a,b),replicate(4,0i32),xs)

-- nested_device_collectives_reach_wgsl
entry nested_device_collectives_reach_wgsl_0_main(xs: []i32) []i32 = map(|x: i32| reduce(|a: i32, b: i32| a + b, 0, map(|y: i32| y + x, iota(5))), xs)

-- nested_reduction_stays_inside_the_map_invocation
entry nested_reduction_stays_inside_the_map_invocation_0_sums(xs:[]i32) []i32=map(|x:i32|reduce(|a:i32,b:i32|a+b,0,map(|y:i32|y+x,iota(5))),xs)

-- fused_local_slice_reductions_do_not_allocate_unused_producer_arrays
entry fused_local_slice_reductions_do_not_allocate_unused_producer_arrays_0_bounds(xs:[][8]f32) []f32 = map(|row|
      let values=map(|x|x+1.0,row[1..i32(row[0])]) in
      reduce(|a,b|min(a,b),f32.highest,values)+reduce(|a,b|max(a,b),f32.lowest,values),xs)

-- local_scatter_keeps_updates_inside_each_invocation
entry local_scatter_keeps_updates_inside_each_invocation_0_result(xs:[]i32) []i32=map(|x:i32|let a=scatter([1,2,3],[0,1],[x,x+1]) in a[0]+a[1],xs)

-- local_filter_preserves_its_live_length
entry local_filter_preserves_its_live_length_0_result(xs:[]i32) []i32=map(|x:i32|length(filter(|y:i32|y>x,[1,2,3])),xs)
