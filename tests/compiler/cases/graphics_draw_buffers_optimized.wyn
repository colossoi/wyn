--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics", "-O"]
--! rust_host = true
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"literal\"", ":source-name \"range\"", ":source-name \"implicit_count\"", ":source-name \"mapped\"", ":source-name \"named\"", ":source-name \"borrowed\"", ":source-name \"slice\"", ":source-name \"indirect\"", ":source-name \"nonindexed_command\"", ":source-name \"nonindexed_commands\"", ":source-name \"uniform_command\"", ":source-name \"named_command\"", ":source-name \"commands\"", ":source-name \"offset\"", ":source-name \"dynamic\"", ":source-name \"inline_implicit_literal\"", ":source-name \"inline_implicit_named\"", ":source-name \"inline_implicit_borrowed\"", ":source-name \"inline_explicit_literal\"", ":source-name \"inline_explicit_named\"", ":source-name \"inline_explicit_borrowed\""]
