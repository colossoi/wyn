--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"runtime_rows\""]
--! [[host]]
--! entry = "runtime_rows"
--! inputs = {xs=[10,20,30],n=[4],b=[1]}
--! result_bytes = 60
--! no_device_reads = true
--! [[host]]
--! entry = "runtime_rows"
--! inputs = {xs=[10,20,30],n=[4],b=[0]}
--! result_bytes = 72
--! no_device_reads = true

entry runtime_rows(xs:[]i32,n:i32,b:bool) [][]i32=if b then map(|x|map(|y|x+y,iota(n+1)),xs) else map(|x|map(|y|x+y,iota(n+2)),xs)
