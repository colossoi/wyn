--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"handoff_loop_map\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"zipped_runtime_loop_retains_its_domain_0_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"compiler_repro_array_loop_0_check\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"cooperative_loop_parallel_assignment_preserves_array_sources_0_swaps\""]

entry handoff_loop_map(loop_map_input: [4]i32, n: i32) [4]i32 = loop acc = loop_map_input for k < n do map(|x: i32| x + k, acc)

-- zipped_runtime_loop_retains_its_domain
entry zipped_runtime_loop_retains_its_domain_0_main(xs:[]i32) []i32 =
      let pairs=zip(xs,iota(length(xs))) in
      let count=if length(xs)==0 then 0 else 3 in
      let ys=loop ys=pairs for i<count do map(|(x,j)| (x+j,j),ys) in
      map(|(x,j)| x,ys)

-- compiler_repro_array_loop
entry compiler_repro_array_loop_0_check(xs: []f32) []f32 =
  map(|x: f32|
    let result = loop values = replicate(3, x) for step < 2 do
      map(|v: f32| v * 0.5, values) in
    result[0], xs)

-- cooperative_loop_parallel_assignment_preserves_array_sources
-- Expected [[1,2,11,21],[3,4,11,21]] on both GPU backends.
-- Cooperative loop arrays must preserve parallel assignment: copying one
-- field must not overwrite another field's still-live source.
entry cooperative_loop_parallel_assignment_preserves_array_sources_0_swaps() [2][4]i32 =
  map(|row|
    let (a,b,_i) = loop (a,b,i) = (row,[10i32,20i32],0i32) while i<2 do
      let c = map(|x| x+1i32,a) in (b,c,i+1) in
    [a[0],a[1],b[0],b[1]],[[0i32,1i32],[2i32,3i32]])
