--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"counted\"", ":source-name \"varying\"", ":source-name \"packed_prefix\""]

entry counted() (i32,i32)=let ys=filter(|x|x<20,map(|x|x+1,filter(|x|x>0,[-1,0,1,2,18,19,20]))) in (length(ys),reduce((+),0,ys))
entry varying() [4]i32=map(|n|reduce((+),0,iota(n)),[0,1,7,65])
entry packed_prefix() []i32=map(|x|x*2,scan((+),0,map(|x|100/x,filter(|x|x!=0,[0,1,2,0,4]))))
