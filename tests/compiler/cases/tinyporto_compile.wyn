--! command = "build"
--! exit = 0
--! targets = ["spirv"]
--! args = ["--graphics", "-O", "--target-double", "rust-wgpu"]
--! shader_entries = 24
--! [[artifacts]]
--! path = "output.rs"
--! contains = [
--!   "pub fn host_camera_00(",
--!   "pub fn host_camera_01(",
--!   "pub fn host_camera_02(",
--!   "pub fn host_camera_03(",
--!   "pub fn host_camera_04(",
--!   "pub fn host_camera_05(",
--!   "pub fn host_camera_06(",
--!   "pub fn host_camera_07(",
--!   "pub fn host_camera_08(",
--!   "pub fn host_camera_09(",
--!   "pub fn host_camera_10(",
--!   "pub fn host_camera_11(",
--! ]

-- Reduced TinyPorto workload for timing repeated helper inlining and graph analysis.
-- Camera math is reused from testfiles/tinyporto_camera_prepass.wyn.
-- Twelve independent camera draws retain record-taking helper calls and 24 stages.

def FOV: f32 = 20.0
def CLIP_NEAR: f32 = 0.1
def CLIP_FAR: f32 = 1000.0

type orbit = { target: vec3f32, az: f32, elev: f32, dist: f32 }

-- Column-major rotation. angle = (elevation, azimuth).
def rotation(angle: vec2f32) mat3f32 =
  let c = @[f32.cos(angle.x), f32.cos(angle.y)]
  let s = @[f32.sin(angle.x), f32.sin(angle.y)] in
  @[[c.y,       0.0,       0.0 - s.y],
    [s.y * s.x, c.x,       c.y * s.x],
    [s.y * c.x, 0.0 - s.x, c.y * c.x]]

def cam_eye(o: orbit) vec3f32 =
  o.target + rotation(@[o.elev, o.az]) * @[0.0, 0.0, o.dist]

def perspective(fovy_deg: f32, aspect: f32, near: f32, far: f32) mat4f32 =
  let f = 1.0 / f32.tan(f32.radians(fovy_deg) * 0.5)
  let nf = 1.0 / (near - far) in
  @[[f / aspect, 0.0, 0.0,         0.0],
    [0.0,        f,   0.0,         0.0],
    [0.0,        0.0, far * nf,    0.0 - 1.0],
    [0.0,        0.0, far * near * nf, 0.0]]

def look_at(eye: vec3f32, center: vec3f32, up: vec3f32) mat4f32 =
  let f = normalize(center - eye)
  let s = normalize(cross(f, up))
  let u = cross(s, f) in
  @[[s.x,                u.x,                0.0 - f.x,     0.0],
    [s.y,                u.y,                0.0 - f.y,     0.0],
    [s.z,                u.z,                0.0 - f.z,     0.0],
    [0.0 - dot(s, eye),  0.0 - dot(u, eye),  dot(f, eye),   1.0]]

-- This is the actual Tinyporto implementation.
def world_to_clip(p: vec3f32, resolution: vec3f32, o: orbit) vec4f32 =
  let aspect = resolution.x / resolution.y
  let eye = cam_eye(o)
  let vm = look_at(eye, o.target, @[0.0, 1.0, 0.0])
  let proj = perspective(FOV, aspect, CLIP_NEAR, CLIP_FAR) in
  proj * (vm * @[p.x, p.y, p.z, 1.0])

def render_camera(target: *render_target<vec4f32>, az: f32, elev: f32, dist: f32,
                  resolution: vec3f32) render_target<vec4f32> =
  let o = { target = @[0.0, 0.0, 0.0], az = az, elev = elev, dist = dist }
  let covered = rasterize_triangles(direct_draw(1024u32, 1u32),
    |vi, _, _| vertex_output(world_to_clip(@[f32(vi), 0.0, 0.0], resolution, o), ())) in
  shade(target, covered, |_, _, _, _, _| @[1.0, 1.0, 1.0, 1.0])

-- Distinct entries retain independent shader stages calling the same helpers.
entry camera_00(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 0.0, angles.y, angles.z, resolution)

entry camera_01(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 1.0, angles.y, angles.z, resolution)

entry camera_02(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 2.0, angles.y, angles.z, resolution)

entry camera_03(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 3.0, angles.y, angles.z, resolution)

entry camera_04(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 4.0, angles.y, angles.z, resolution)

entry camera_05(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 5.0, angles.y, angles.z, resolution)

entry camera_06(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 6.0, angles.y, angles.z, resolution)

entry camera_07(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 7.0, angles.y, angles.z, resolution)

entry camera_08(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 8.0, angles.y, angles.z, resolution)

entry camera_09(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 9.0, angles.y, angles.z, resolution)

entry camera_10(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 10.0, angles.y, angles.z, resolution)

entry camera_11(target:render_target<vec4f32>, angles:vec3f32, resolution:vec3f32) render_target<vec4f32> =
  render_camera(target, angles.x + 11.0, angles.y, angles.z, resolution)
