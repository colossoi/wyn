--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"handoff_scatter_radix_bit\"", ":source-name \"handoff_scatter_loop\"", ":source-name \"handoff_scatter_replicated\"", ":source-name \"handoff_scatter_dynamic\"", ":source-name \"handoff_scatter_literal\"", ":source-name \"handoff_spread\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"local_scatter_0_main\"", ":source-name \"local_scatter_1_main\"", ":source-name \"local_scatter_2_main\"", ":source-name \"local_scatter_3_main\"", ":source-name \"local_scatter_4_main\"", ":source-name \"local_scatter_5_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scratch_0_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
