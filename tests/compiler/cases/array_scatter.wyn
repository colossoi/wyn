--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scratch_2_main\""]

-- A stable radix partition with a compiler-allocated destination.
def radix_bit<[n]>(pairs: [n]vec2u32, ids: [n]i32, bit: u32) [n]vec2u32 =
  let zero = map(|p| if ((p.x >> bit) & 1u32) == 0u32 then 1i32 else 0i32, pairs) in
  let prefix = scan(|a,b| a+b, 0i32, zero) in
  let total = prefix[length(pairs)-1] in
  let destinations = map(|i| if zero[i] == 1 then prefix[i]-1 else total+i-prefix[i], ids) in
  scatter(replicate(length(pairs), @[0u32,0u32]), destinations, pairs)

entry handoff_scatter_radix_bit(pairs: []vec2u32) []vec2u32 =
  radix_bit(pairs, 0i32..<length(pairs), 0u32)


entry handoff_scatter_loop(n: i32) [4]i32 = loop acc = [7, 7, 7, 7] for k < n do scatter(acc, [k], [k+10])

entry handoff_scatter_replicated() [4]i32 = scatter(replicate(4, 7i32), [2i32, 0i32], [30i32, 10i32])

entry handoff_scatter_dynamic(scatter_dynamic_input: []i32) []i32 = scatter(replicate(length(scatter_dynamic_input), 7i32), [2i32, 0i32], [30i32, 10i32])

entry handoff_scatter_literal() [4]i32 = scatter([7i32, 7i32, 7i32, 7i32], [2i32, 0i32], [30i32, 10i32])

entry handoff_spread() [4]i32 = spread(4, 7i32, [2i32, 0i32], [30i32, 10i32])


-- scatter_local_destinations_reach_wgsl
-- A stable radix partition with a compiler-allocated destination.
def local_scatter_0_radix_bit<[local_scatter_0_n]>(pairs: [local_scatter_0_n]vec2u32, ids: [local_scatter_0_n]i32, bit: u32) [local_scatter_0_n]vec2u32 =
  let zero = map(|p| if ((p.x >> bit) & 1u32) == 0u32 then 1i32 else 0i32, pairs) in
  let prefix = scan(|a,b| a+b, 0i32, zero) in
  let total = prefix[length(pairs)-1] in
  let destinations = map(|i| if zero[i] == 1 then prefix[i]-1 else total+i-prefix[i], ids) in
  scatter(replicate(length(pairs), @[0u32,0u32]), destinations, pairs)

entry local_scatter_0_main(pairs: []vec2u32) []vec2u32 =
  local_scatter_0_radix_bit(pairs, 0i32..<length(pairs), 0u32)


entry local_scatter_1_main(local_scatter_1_n: i32) [4]i32 = loop acc = [7, 7, 7, 7] for k < local_scatter_1_n do scatter(acc, [k], [k+10])

entry local_scatter_2_main() [4]i32 = scatter(replicate(4, 7i32), [2i32, 0i32], [30i32, 10i32])

entry local_scatter_3_main(local_scatter_3_xs: []i32) []i32 = scatter(replicate(length(local_scatter_3_xs), 7i32), [2i32, 0i32], [30i32, 10i32])

entry local_scatter_4_main() [4]i32 = scatter([7i32, 7i32, 7i32, 7i32], [2i32, 0i32], [30i32, 10i32])

entry local_scatter_5_main() [4]i32 = spread(4, 7i32, [2i32, 0i32], [30i32, 10i32])

entry scratch_0_main(xs:[]i32) []i32 = scatter(duplicate_scratch(xs),iota(length(xs)),xs)

entry scratch_1_main(xs:[]i32) []i32 = scatter(scratch(length(xs)),iota(length(xs)),xs)

entry scratch_2_main(xs:[4]vec2u32) [4]vec2u32 = scatter(duplicate_scratch(xs),[3,2,1,0],xs)
