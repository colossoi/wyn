--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"deep_choice\"", ":source-name \"deep_loop\"", ":source-name \"total_map\""]

entry deep_choice() [2][3]i32=map(|i|map(|j|if (i+j)%2==0 then reduce((+),0,map(|k|k+i*10+j,iota(17))) else -1,iota(3)),iota(2))
entry deep_loop() [2][3]i32=map(|i|map(|j|loop a=0 for n<j+1 do a+reduce((+),0,map(|k|k+i*10+j,iota(17))),iota(3)),iota(2))
entry total_map() [4]i32=let xs=[1,2,3,4] let t=reduce((+),0,xs) in map(|x|x+t,xs)
