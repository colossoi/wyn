--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_helper_4_main\""]

def tuple_helper_4_firsts<[tuple_helper_4_n], A, B>(tuple_helper_4_xs:[tuple_helper_4_n](A,B)) [tuple_helper_4_n]A=map(|(a,b)|a,tuple_helper_4_xs)
entry tuple_helper_4_main(tuple_helper_4_xs:[](i32,i32)) []i32=tuple_helper_4_firsts(tuple_helper_4_xs)
