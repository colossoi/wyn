--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"filtered_nested\""]

-- A single compaction path must handle variable-width and empty rows.
entry filtered_nested(xs:[]i32) [][]i32 = filter(|row|length(row)>0,map(|x|iota(x),xs))
