--! command = "build"
--! exit = 1
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! errors = ["egglog output: map callback results must have the same array shape"]
--! contains = ["map callback results must have the same array shape"]

-- Filtering the result cannot make a varying-row map valid.
entry filtered_nested(xs:[]i32) [][]i32 = filter(|row|length(row)>0,map(|x|iota(x),xs))
