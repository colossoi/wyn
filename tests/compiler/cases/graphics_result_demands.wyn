--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! rust_host = true
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"result_demand_0_reproduce\"", ":source-name \"result_demand_1_reproduce\"", ":source-name \"result_demand_2_reproduce\""]
--! [[host]]
--! entry = "result_demand_0_reproduce"
--! result_ownership = [":borrowed", ":borrowed"]
--! calls = { "gpu-alloc" = 0, "gpu-draw" = 1, "gpu-dispatch" = 0 }
--! minimum_calls = {  }
--! [[host]]
--! entry = "result_demand_1_reproduce"
--! result_ownership = [":owned", ":borrowed"]
--! calls = { "gpu-alloc" = 1, "gpu-draw" = 1 }
--! minimum_calls = { "gpu-dispatch" = 1 }
--! [[host]]
--! entry = "result_demand_2_reproduce"
--! result_ownership = [":owned", ":borrowed"]
--! calls = { "gpu-alloc" = 2, "gpu-draw" = 1 }
--! minimum_calls = { "gpu-dispatch" = 1 }



-- graphics_result_demands_reuse_inputs_or_materialize_virtual_arrays
def result_demand_0_draw(screen: *render_target<vec4f32>) render_target<vec4f32> =
  let triangles = rasterize_triangles(direct_draw(3u32,1u32),|vi,_,_|
    vertex_output(if vi == 0u32 then @[-1.0,-1.0,0.0,1.0]
      else if vi == 1u32 then @[3.0,-1.0,0.0,1.0] else @[-1.0,3.0,0.0,1.0],0.0)) in
  let background = shade(screen,triangles,|_,_,_,_,_| @[0.0,0.0,0.0,1.0]) in
  background

entry result_demand_0_reproduce(result_demand_0_values: []i32, screen: render_target<vec4f32>) ([]i32,render_target<vec4f32>) =
  let image = result_demand_0_draw(screen) in
  (result_demand_0_values,image)


def result_demand_1_draw(screen: *render_target<vec4f32>) render_target<vec4f32> =
  let triangles = rasterize_triangles(direct_draw(3u32,1u32),|vi,_,_|
    vertex_output(if vi == 0u32 then @[-1.0,-1.0,0.0,1.0]
      else if vi == 1u32 then @[3.0,-1.0,0.0,1.0] else @[-1.0,3.0,0.0,1.0],0.0)) in
  let background = shade(screen,triangles,|_,_,_,_,_| @[0.0,0.0,0.0,1.0]) in
  background

entry result_demand_1_reproduce(result_demand_1_values: []i32, screen: render_target<vec4f32>) ([]i32,render_target<vec4f32>) =
  let image = result_demand_1_draw(screen) in
  (0i32..<2i32,image)


def result_demand_2_draw(screen: *render_target<vec4f32>) render_target<vec4f32> =
  let triangles = rasterize_triangles(direct_draw(3u32,1u32),|vi,_,_|
    vertex_output(if vi == 0u32 then @[-1.0,-1.0,0.0,1.0]
      else if vi == 1u32 then @[3.0,-1.0,0.0,1.0] else @[-1.0,3.0,0.0,1.0],0.0)) in
  let background = shade(screen,triangles,|_,_,_,_,_| @[0.0,0.0,0.0,1.0]) in
  background

entry result_demand_2_reproduce(result_demand_2_values: []i32, screen: render_target<vec4f32>) ([]i32,render_target<vec4f32>) =
  let image = result_demand_2_draw(screen) in
  (map(|x|x+1i32,result_demand_2_values),image)
