--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics", "--max-warnings", "0"]
--! source_path = "source files/scene.wyn"
--! output_path = "generated shaders/compiled graphics.shader"
--! [[artifacts]]
--! path = "generated shaders/compiled graphics.shader"
--! targets = ["wgsl"]
--! contains = ["@compute", "@vertex", "@fragment"]
--! [[artifacts]]
--! path = "generated shaders/compiled graphics.wynhost"
--! starts_with = "(define-host-program :version 1)"
--! contains = ["(define-host-entry ", ":source-name \"reproduce\""]
--! [[artifacts]]
--! path = "generated shaders/compiled graphics.wynhost"
--! targets = ["spirv"]
--! contains = ["(define-gpu-module 'shaders :format :spirv :path \"compiled graphics.shader\")"]
--! [[artifacts]]
--! path = "generated shaders/compiled graphics.wynhost"
--! targets = ["wgsl"]
--! contains = ["(define-gpu-module 'shaders :format :wgsl :path \"compiled graphics.shader\")"]

def draw(screen: *render_target<vec4f32>) render_target<vec4f32> =
  let triangles = rasterize_triangles(direct_draw(3u32,1u32),|vi,_,_|
    vertex_output(if vi == 0u32 then @[-1.0,-1.0,0.0,1.0]
      else if vi == 1u32 then @[3.0,-1.0,0.0,1.0] else @[-1.0,3.0,0.0,1.0],0.0)) in
  let background = shade(screen,triangles,|_,_,_,_,_| @[0.0,0.0,0.0,1.0]) in
  background

entry reproduce(screen: render_target<vec4f32>) ([]i32,render_target<vec4f32>) =
  let image = draw(screen) in
  ([1i32,2i32],image)
