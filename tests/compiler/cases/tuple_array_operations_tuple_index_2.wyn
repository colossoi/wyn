--! command = "build"
--! exit = 0
--! args = ["--graphics"]
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"tuple_index_2_main\""]

entry tuple_index_2_main(tuple_index_2_xs:[4]i32,i:i32) (i32,i32) =
         let (_,tuple_index_2_ys)=unzip(map(|x|(x,(x+1,x+2)),tuple_index_2_xs)) in tuple_index_2_ys[i]
