--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"array_reads\"", ":source-name \"row_read\""]

entry array_reads(xs:[]i32) i32 =
  let constants = [3i32,7i32] in
  if length(xs)>0 then xs[0]+constants[1] else length(constants)

entry row_read(xs:[][4]i32) i32 = if length(xs)>0 then xs[0][3] else 0
