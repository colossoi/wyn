--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"array_case_0\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scatter_capture_0_reproduce\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"texture_load_sample_pixels\"", ":source-name \"texture_sample_sample_pixels\"", ":source-name \"texture_multiple_sample_pixels\""]

def prepare(xs: [4]i32) ([4]i32,[4]i32,bool) =
  let a = map(|x| x + 1,xs) in
  let b = map(|x| x * 2,a) in
  let flag = reduce(|a,b| a || b,false,map(|x| x > 0,b)) in
  (a,b,flag)

entry array_case_0(xs: [4]i32, target: render_target<vec4f32>)
    ([4]i32,[4]i32,render_target<vec4f32>) =
  let (a,b,flag) = prepare(xs) in
  let left = map(|x| if flag then x else 0,a) in
  let right = map(|x| if flag then x else 1,b) in
  let raster = rasterize_triangles(direct_draw(3u32,1u32),
    |_vertex,_instance,_draw| vertex_output(@[0.0,0.0,0.0,1.0],())) in
  let image = shade(target,raster,|_v,_p,_f,_i,_s|
    if flag then @[1.0,0.0,0.0,1.0] else @[0.0,0.0,0.0,1.0]) in
  (left,right,image)


-- render_helper_preserves_scatter_capture
-- Helper-local scatter must hand its destination between compute stages.
def scatter_capture_0_draw<[scatter_capture_0_n]>(ids: [scatter_capture_0_n]i32, screen: *render_target<vec4f32>) render_target<vec4f32> =
  let compacted = scatter(replicate(length(ids),-1i32),ids,ids) in
  let triangles = rasterize_triangles(direct_draw(3u32,2u32),|vi,ii,_|
    vertex_output(@[f32.u32(vi)*0.1,f32(compacted[i32.u32(ii)])*0.1,0.5,1.0],0.0)) in
  shade(screen,triangles,|_,_,_,_,_| @[1.0,0.0,0.0,1.0])
entry scatter_capture_0_reproduce(screen: render_target<vec4f32>) render_target<vec4f32> =
  scatter_capture_0_draw(0i32..<2,screen)



-- compute_texture_parameters_validate_in_both_backends
entry texture_load_sample_pixels(texture_load_image: texture2d, texture_load_pixels: []vec2i32) []vec4f32 =
  map(|pixel| texture_load(texture_load_image, pixel, 0i32), texture_load_pixels)


entry texture_sample_sample_pixels(texture_sample_image: texture2d, texture_sample_samp: sampler, texture_sample_pixels: []vec2f32) []vec4f32 =
        map(|pixel| texture_sample(texture_sample_image, texture_sample_samp, pixel, 0.0), texture_sample_pixels)

entry texture_multiple_sample_pixels(texture_multiple_a: texture2d, texture_multiple_pixels: []vec2i32, texture_multiple_b: texture2d) []vec4f32 =
        map(|pixel| texture_load(texture_multiple_a, pixel, 0i32) + texture_load(texture_multiple_b, pixel, 0i32), texture_multiple_pixels)
