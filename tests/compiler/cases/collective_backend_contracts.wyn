--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"conditional_array\"", ":source-name \"fixed_array\"", ":source-name \"tuple_branch\"", ":source-name \"zip_branch\"", ":source-name \"unsigned_range\"", ":source-name \"filter_length\"", ":source-name \"ints\"", ":source-name \"floats\"", ":source-name \"prefix_scan\"", ":source-name \"compact_filter\""]
--! [[shader]]
--! entry = "prefix_scan"
--! entry_count = 3
--! [[shader]]
--! entry = "compact_filter"
--! entry_count = 1

entry conditional_array(xs:[]i32,flag:bool) ([]i32,[1]i32)=let n=xs[0] in (map(|x|x+n,xs),if flag then [n] else [n+1])
entry fixed_array(xs:[]i32) ([]i32,[1]i32)=let n=xs[0] in (map(|x|x+n,xs),[n])
entry tuple_branch(xs:[4]i32,ys:[4]i32,flag:bool) [4](i32,i32)=if flag then map(|x|(x,x+1),xs) else map(|y|(y,y+2),ys)
entry zip_branch(xs:[4]i32,ys:[4]i32,flag:bool) [4]i32=if flag then map(|(x,y)|x+y,zip(xs,ys)) else map(|(y,x)|y-x,zip(ys,xs))
entry unsigned_range(n:u32) []u32=map(|i:u32|i+1u32,0u32..<n)
entry filter_length(xs:[]i32) i32=length(filter(|x:i32|x>0,xs))
entry ints(xs:[]i32) i32=reduce(|a:i32,b:i32|a+b,0,xs)
entry floats(xs:[]f32) f32=reduce(|a:f32,b:f32|a+b,0.0,xs)
entry prefix_scan(xs:[]i32) []i32=scan(|a:i32,b:i32|a+b,0,xs)
entry compact_filter(xs:[]i32) ?k.[k]i32=filter(|x:i32|x%3==1,xs)
