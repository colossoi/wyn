--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"uniform\"", ":source-name \"identity\"", ":source-name \"consumed\""]

entry uniform(xs:[]i32,n:i32) [][]i32=map(|x|map(|j|x+j,iota(n)),xs)
entry identity(xs:[][3]i32) [][3]i32=map(|row|row,xs)
entry consumed(xs:[]i32) []i32=map(|x|reduce((+),0,iota(x)),xs)
entry same_shape(xs:[]i32,n:i32) [][]i32=map(|x|if x>0 then map(|j|x+j,iota(n)) else map(|j|x-j,iota(n)),xs)
