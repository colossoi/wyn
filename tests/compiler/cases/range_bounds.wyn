--! command = "check"
--! exit = 0
--! args = ["--graphics"]

-- Migrated from test_simple_range
entry simple_range_vertex_main() vec4f32 =
    let range = 0..<4 in
    @[f32.i32(range[0]), f32.i32(range[1]), f32.i32(range[2]), 1.0f32]

-- Migrated from test_range_with_start
entry range_with_start_vertex_main() vec4f32 =
    let range = 1..<5 in
    @[f32.i32(range[0]), f32.i32(range[1]), f32.i32(range[2]), 1.0f32]

-- Migrated from test_inclusive_range
entry inclusive_range_vertex_main() vec4f32 =
    let range = 0..=3 in
    @[f32.i32(range[0]), f32.i32(range[1]), f32.i32(range[2]), f32.i32(range[3])]

-- inclusive_range_preserves_exclusive_ranges_and_slices
let inclusive_literal: [4]i32 = 0..=3
let exclusive_literal: [3]i32 = 0..3
let explicit_exclusive_literal: [3]i32 = 0..<3
let strided_inclusive_literal: [3]i32 = 0..2..=4
