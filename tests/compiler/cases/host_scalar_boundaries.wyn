entry arithmetic_0(input_0:i32) i32 = if input_0>0 then input_0-1 else input_0+1
entry arithmetic_1(input_1:i32) i32 = if input_1>0 then input_1-1 else input_1*input_1
entry arithmetic_2(input_2:i32) i32 = if input_2<0 then input_2+1 else input_2-1
entry arithmetic_3(input_3:i32) i32 = input_3+1
entry arithmetic_4(input_4:i32) i32 = input_4*input_4
entry arithmetic_5(input_5:f32) f32 = if input_5>0.0 then input_5 else input_5+input_5
entry arithmetic_6(input_6:f32) f32 = input_6+input_6
entry arithmetic_7(input_7:f32) f32 = input_7*input_7
entry get_bit(bit:i32,value:i32) i32=i32.get_bit(bit,value)
