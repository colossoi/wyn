--! command = "check"
--! exit = 0
--! args = ["--graphics"]

-- name_pattern_in_let_binds
def name_pattern_in_let_binds(n: i32) i32 = let x = n in x + 1

-- wildcard_pattern_in_let_binds
def wildcard_pattern_in_let_binds(n: i32) i32 = let _ = n in 0

-- tuple_pattern_in_let_destructures
def tuple_pattern_in_let_destructures(p: (i32, i32)) i32 = let (a, b) = p in a + b

-- typed_name_pattern_in_let_binds
def typed_name_pattern_in_let_binds(n: i32) i32 = let x: i32 = n in x + 1

-- lambda_param_with_tuple_pattern
def lambda_param_with_tuple_pattern(arr: [3](i32, i32)) [3]i32 = map((|(a, b)| a + b), arr)

-- single_variant_constructor_in_let_is_accepted
def single_variant_constructor_in_let_is_accepted(b: #boxed(i32)) i32 = let #boxed(x) = b in x + 1

-- match_arm_with_literal_is_accepted
def match_arm_with_literal_is_accepted(n: i32) i32 =
  match n
  case 0 -> 1
  case _ -> 0

-- match_arm_with_single_variant_constructor_is_accepted
def match_arm_with_single_variant_constructor_is_accepted(b: #boxed(i32)) i32 =
  match b
  case #boxed(x) -> x

-- match_arm_with_wildcard_is_accepted
def match_arm_with_wildcard_is_accepted(t: #a | #b | #c) i32 =
  match t
  case #a -> 1
  case _  -> 0

-- vec_pattern_in_let_destructures_vec2
def vec_pattern_in_let_destructures_vec2(v: vec2f32) f32 = let @[a, b] = v in a + b

-- vec_pattern_in_let_destructures_vec4
def vec_pattern_in_let_destructures_vec4(v: vec4f32) f32 = let @[a, b, c, d] = v in a + b + c + d

-- vec_pattern_supports_wildcards
def vec_pattern_supports_wildcards(v: vec3f32) f32 = let @[a, _, c] = v in a + c

-- Nested/unit/integer-vector cases from accepts_irrefutable_patterns.
def nested_tuple_pattern(p: (i32, (i32, i32))) i32 = let (x, (y, z)) = p in x + y + z
def integer_vector_pattern(v: vec2i32) i32 = let @[x, y] = v in x + y
def unit_pattern(u: ()) i32 = let () = u in 0
def nested_single_constructor_pattern(p: #boxed(#inner(i32))) i32 = let #boxed(#inner(_)) = p in 0
