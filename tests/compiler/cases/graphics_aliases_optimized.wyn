--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics", "-O"]
--! compare_host = "inputs/graphics_aliases.wyn"
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = ["(gpu-dispatch ", ":source-name \"projection\"", ":source-name \"map_input\""]

entry projection(values:[]vec4f32,target:render_target<vec4f32>) render_target<vec4f32> =
  let produced=(map(|v|v+@[1.0,0.0,0.0,0.0],values),map(|v|v*2.0,values)) let selected=produced.0

  let fragments=rasterize_triangles(direct_draw(3u32,1u32),
    |_,_,_|vertex_output(selected[0],())) in
  shade(target,fragments,|_,_,_,_,_|selected[0])

entry map_input(values:[]vec4f32,target:render_target<vec4f32>) render_target<vec4f32> =
  let produced=(map(|v|v+@[1.0,0.0,0.0,0.0],values),map(|v|v*2.0,values)) let selected=produced.0
  let mapped=map(|v|v*3.0,selected)
  let fragments=rasterize_triangles(direct_draw(3u32,1u32),
    |_,_,_|vertex_output(mapped[0],())) in
  shade(target,fragments,|_,_,_,_,_|mapped[0])
