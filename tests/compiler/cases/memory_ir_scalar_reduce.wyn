--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scalar_reduce\"", ":source-name \"scalar_max\""]

entry scalar_reduce(xs:[]i32) i32 = reduce((+),0i32,xs)

entry scalar_max(xs:[]i32) i32 = reduce(|a,b|if a>b then a else b,-2147483648i32,xs)
