--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"aggregate_forwarding\"", ":source-name \"select_lowering\"", ":source-name \"nested_tuple_index\"", ":source-name \"captured_count\"", ":source-name \"captured_input\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"shared_scalar_loop_0_check\"", ":source-name \"shared_scalar_loop_1_check\""]

-- A camera-style field subset plus loop-carried aggregate state. Negative and
-- zero inputs exercise the empty loop and guarded division paths.
type full = { position: vec2i32, scale: i32, bias: i32, unused: i32 }
type small = { position: vec2i32, scale: i32, bias: i32 }

def subset(c: full) small = {
  position = c.position,
  scale = c.scale,
  bias = c.bias,
}

entry aggregate_forwarding(xs: []i32) []i32 =
  map(|x: i32|
    let s = subset({ position = @[x, x + 1], scale = 3, bias = 2, unused = x - 7 })
    let n = if x < 0 then 0 else x % 5
    let state = loop state = (s.position.x, s.position.y) for i < n do
      (state.1, state.0 + 1)
    let quotient = if x != 0 then 120 / x else 7
    in state.0 * s.scale + state.1 + s.bias + quotient,
    xs)

-- Cheap value choices become select; division remains guarded at zero.
entry select_lowering(xs: []i32) []i32 =
  map(|x: i32|
    let chosen = if x < 0 then -x else x + 10
    let guarded = if x != 0 then 120 / x else 7
    let a = x + 1
    let b = x - 1
    let correlated = (if x < 0 then a else b) + (if x < 0 then b else a)
    let n = if x < 0 then 4 else 8
    let dead = if n == 0 then loop v = x for i < 4 do v * 3 + 1 else 0
    in chosen + guarded + correlated + dead,
    xs)

entry nested_tuple_index(xs:[4]i32,i:i32) (i32,(i32,i32)) =
    let ys=map(|x|(x,(x+1,x+2)),xs) in ys[i]
def row_count(n:i32,x:i32) []i32=map(|y|x+y,iota(n+1))
entry captured_count(xs:[]i32,n:i32) [][]i32=map(|x|row_count(n,x),xs)
def row_input(ys:[]i32,x:i32) []i32=map(|y|x+y,iota(length(ys)+1))
entry captured_input(xs:[]i32,ys:[]i32) [][]i32=map(|x|row_input(ys,x),xs)



-- compiler_repro_shared_scalar_loop
entry shared_scalar_loop_0_check(shared_scalar_loop_0_xs: []f32, x: f32) f32 =
  let initial = x * 2.0 in
  let can_stop = reduce(|a: bool, b: bool| a && b, true, map(|v: f32| v > initial, shared_scalar_loop_0_xs)) in
  if can_stop then initial else
    loop p = initial for iteration < 2 do p * 0.5


entry shared_scalar_loop_1_check(shared_scalar_loop_1_xs: []f32, x: f32) f32 =
  let initial = x * 2.0 in
  let can_stop = reduce(|a: bool, b: bool| a && b, true, map(|v: f32| v > initial, shared_scalar_loop_1_xs)) in
  if can_stop then initial else
    let (p, iteration) = loop (p, iteration) = (initial, 0i32) while iteration < 2 do (p * 0.5, iteration + 1) in p
