--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"array_updates\""]
--! [[host]]
--! entry = "array_updates"
--! result_min_bytes = [16, 16, 16, 16, 16]

def handoff_updated_return: [4]i32 =
  let updated_return_input = [-1i32,-1i32,-1i32,-1i32] in
  updated_return_input with [3] = 2i32


def handoff_updated_loop(n: i32) [4]i32 =
  let (output,_i) = loop (output,i) = (replicate(4,-1i32),0i32)
    while i < n do (output with [i % 4] = i,i+1) in
  output


-- Updated and unchanged arms must carry the same composite array type.
def handoff_updated_branch(n: i32) [4]i32 =
  let (a,_i) = loop (a,i) = (replicate(4,-1i32),0i32)
    while i < n do
      (if i % 2 == 0 then a with [i % 4] = i else a,i+1)
  in a


-- The internal queue's size is inferred from its producer, not the result.
-- Its initial update and nested loop must retain that size and representation.
def handoff_nested_queue(n: i32) [4]i32 =
  let empty = replicate(4,-1i32) in
  if n < 0 then empty with [0] = -1i32 else
  let q0 = replicate(8,@[0u32,0u32]) with [0] = @[1u32,2u32] in
  let (_q,a,_i) = loop (q,a,i) = (q0,empty,0i32)
    while i < n do
      if q[i%8].x == 0u32 then (q,a with [i%4] = i,i+1) else
      let (r,_j) = loop (r,j) = (q,0i32) while j < 2 do
        (r with [(i+j)%8] = @[u32(i),u32(j)],j+1) in
      (r,a,i+1)
  in a


def handoff_while_capacity(n: i32) [4]i32 =
            let (_, output) = loop (i, output) = (0i32, replicate(4, -1i32))
                while i < n do (i+1, output with [i % 4] = i) in output


entry array_updates(n:i32) ([4]i32, [4]i32, [4]i32, [4]i32, [4]i32) =
  (handoff_updated_return,
   handoff_updated_loop(n),
   handoff_updated_branch(n),
   handoff_nested_queue(n),
   handoff_while_capacity(n))
