--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"branch_transport\""]

entry branch_transport(xs:[]i32,b:bool) []i32 =
  if b then map(|x| x+1,xs) else map(|x| x-1,xs)
entry loop_transport(xs:[]i32,n:i32) []i32 =
  loop out=xs for i<n do map(|x|x+i,out)
