             entry bool_u64_callable(xs: [4]i32) [4]u64 = map(u64.bool, map(|x| x > 0, xs))

def bits_i8_bits(xs:[4]i8, f:i32 -> i8 -> i32, bit:i32) [4]i32 =
                map(|x|f(bit,x),xs)
             entry bits_i8_main(xs:[4]i32,bit:i32) [4]i32 =
                bits_i8_bits(map(|x|i8(x),xs),i8.get_bit,bit)

