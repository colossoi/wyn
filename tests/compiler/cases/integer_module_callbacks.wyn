entry bool_i8_scalar(x: i32) i8 = i8.bool(x > 0)
             entry bool_i8_captured(xs: [4]i32) [4]i8 = map(|x| i8.bool(x > 0), xs)
             entry bool_i8_callable(xs: [4]i32) [4]i8 = map(i8.bool, map(|x| x > 0, xs))

entry bool_i16_scalar(x: i32) i16 = i16.bool(x > 0)
             entry bool_i16_captured(xs: [4]i32) [4]i16 = map(|x| i16.bool(x > 0), xs)
             entry bool_i16_callable(xs: [4]i32) [4]i16 = map(i16.bool, map(|x| x > 0, xs))

entry bool_i32_scalar(x: i32) i32 = i32.bool(x > 0)
             entry bool_i32_captured(xs: [4]i32) [4]i32 = map(|x| i32.bool(x > 0), xs)
             entry bool_i32_callable(xs: [4]i32) [4]i32 = map(i32.bool, map(|x| x > 0, xs))

entry bool_i64_scalar(x: i32) i64 = i64.bool(x > 0)
             entry bool_i64_captured(xs: [4]i32) [4]i64 = map(|x| i64.bool(x > 0), xs)
             entry bool_i64_callable(xs: [4]i32) [4]i64 = map(i64.bool, map(|x| x > 0, xs))

