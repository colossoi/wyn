             entry bool_u32_captured(xs: [4]i32) [4]u32 = map(|x| u32.bool(x > 0), xs)
             entry bool_u32_callable(xs: [4]i32) [4]u32 = map(u32.bool, map(|x| x > 0, xs))

entry bool_u64_scalar(x: i32) u64 = u64.bool(x > 0)
