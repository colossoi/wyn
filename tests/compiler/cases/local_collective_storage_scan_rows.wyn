--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scan_rows\""]
--! [[shader]]
--! entry = "scan_rows"
--! targets = ["wgsl"]
--! parallel = true
--! workgroup_storage = true
--! barrier = true

entry scan_rows(xs:[][4]i32) [][4]i32=scan(|a,b|map2((+),a,b),replicate(4,0i32),xs)

-- nested_device_collectives_reach_wgsl
