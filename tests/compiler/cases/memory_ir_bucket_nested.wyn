--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"nested_buckets\""]

-- Bucket items themselves may have variable-width payloads.
entry nested_buckets(n:i32) ([][][]i32,[]u32,u32) =
  bucket_scatter_1d([[iota(0),iota(1)],[iota(2),iota(0)]],[(0,iota(n)),(1,iota(n+1))])
