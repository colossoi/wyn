--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"scatter_rows\""]
--! [[shader]]
--! entry = "scatter_rows"
--! targets = ["wgsl"]
--! parallel = true

entry scatter_rows(xs:[]i32) [][4]i32=map(|x|scatter(replicate(4,0i32),[x%4],[x]),xs)
