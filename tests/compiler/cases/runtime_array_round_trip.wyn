--! command = "build"
--! exit = 0
--! spirv_round_trip = true
--! targets = ["spirv"]
--! args = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"roundtrip_0_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"roundtrip_1_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"roundtrip_2_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"roundtrip_3_main\""]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"length_queries_lower_without_materializing_array_elements_0_input_length\"", ":source-name \"length_queries_lower_without_materializing_array_elements_0_mapped_length\"", ":source-name \"length_queries_lower_without_materializing_array_elements_0_mapped_slice_length\"", ":source-name \"length_queries_lower_without_materializing_array_elements_0_filtered_length\""]



-- Runtime array state retains its input extent across element updates.
-- Expected roundtrip_0_main([3, 7, -2]) = [4, 8, -1], and roundtrip_0_main([]) = [].
entry roundtrip_0_main(xs: []i32) []i32 =
  loop out = xs for i < length(xs) do out with [i] = xs[i] + 1

-- Compiler handoff: returning branches with different runtime array extents.
-- Expected: inputs of length <= 10 are unchanged; longer inputs return [].
entry roundtrip_1_main(xs: []i32) []i32 =
  if length(xs)>10 then replicate(0,0i32) else xs

-- Compiler handoff: runtime-sized loop state allocated by replicate.
-- For n >= 0, expected roundtrip_2_main(3) = [0,1,2] and roundtrip_2_main(0) = [].
entry roundtrip_2_main(n: i32) []i32 =
  loop out = replicate(n,0i32) for i < n do out with [i] = i

entry roundtrip_3_main(n: i32) []i32 =
  loop out = iota(n) for _i < 2 do
    let start = if length(out)>0 then 1 else 0
    in out[start..length(out)]

-- length_queries_lower_without_materializing_array_elements
-- Lengths observe logical view metadata, even when elements are never stored.
entry length_queries_lower_without_materializing_array_elements_0_input_length(xs: []i32) []i32 =
    let n = length(xs) in map(|i| i + n, iota(n))

entry length_queries_lower_without_materializing_array_elements_0_mapped_length(xs: []i32) []i32 =
    let ys = map(|x:i32| x + 1, xs) in
    map(|i| i, iota(length(ys)))

entry length_queries_lower_without_materializing_array_elements_0_mapped_slice_length(xs: []i32) []i32 =
    let ys = map(|x:i32| x + 1, xs) in
    let view = ys[0..length(ys)] in
    map(|i| i, iota(length(view)))

entry length_queries_lower_without_materializing_array_elements_0_filtered_length(xs: []i32) []i32 =
    let ys = filter(|x:i32| x > 0, xs) in
    map(|i| ys[i] + length(ys), iota(length(ys)))
