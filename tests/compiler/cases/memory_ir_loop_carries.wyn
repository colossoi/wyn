--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"carried_rows\""]

-- Branches and source-loop carries must share nested-value decomposition.
def make_rows(n:i32) [][]i32 = [iota(n),iota(0)]
entry carried_rows(n:i32,b:bool) [][]i32 =
  loop rows=make_rows(1) for i<n do
    if b then scatter(rows,[0],[iota(i)]) else make_rows(i)
