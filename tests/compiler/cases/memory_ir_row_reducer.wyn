--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"row_accumulation\""]

-- Each indexed reduction must invoke the combiner on a whole row.
entry row_accumulation(xs:[][4]i32) [2][4]i32 =
  reduce_by_index(replicate(2,replicate(4,0i32)),|a,b|map2((+),a,b),replicate(4,0i32),
    map(|i|i%2,iota(length(xs))),xs)
