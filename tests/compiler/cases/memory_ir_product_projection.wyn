--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"computed_field\"", ":source-name \"selected_field\""]
--! [[shader]]
--! entry = "computed_field"
--! targets = ["spirv"]
--! binary = { "Add" = 2 }
--! [[shader]]
--! entry = "computed_field"
--! targets = ["wgsl"]
--! binary = { "Add" = 1 }

entry computed_field(x:i32) i32 = let pair=(7,x+1) in pair.1
entry selected_field(x:i32,b:bool) i32 =
  let pair=if b then (7,x+1) else (9,x+2) in pair.1
