--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"captured_total_updates\"", ":source-name \"local_total_map\"", ":source-name \"prefix_updates\""]

entry captured_total_updates() [3]i32=let xs=[1,2,3,4] let t=reduce((+),0,xs) let dest=[0,0,0] in reduce_by_index(dest,(+),0,map(|x|x%3,xs),map(|x|x+t,xs))
entry local_total_map() [2][4]i32=map(|k|let xs=map(|x|x+k,[1,2,3,4]) let t=reduce((+),0,xs) in map(|x|x+t,xs),[0,1])
entry prefix_updates() ([4]i32,[3]i32,[3]i32)=let p=scan((+),0,[1,2,3,4]) let da=[1,1,1] let db=[2,2,2] let a=reduce_by_index(da,(+),0,map(|x|x%3,p),p) let b=reduce_by_index(db,|a,b|a+b+1,0,map(|x|x%3,p),p) in (p,map(|x|2*x,a),b)
