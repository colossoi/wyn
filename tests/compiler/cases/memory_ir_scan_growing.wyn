--! command = "build"
--! exit = 1
--! targets = ["spirv", "wgsl"]
--! warnings = []
--! errors = ["egglog output: map callback results must have the same array shape"]
--! contains = ["map callback results must have the same array shape"]

-- Scanning the result cannot make a varying-row map valid.
def join_rows(a:[]i32,b:[]i32) []i32 =
  map(|i|if i<length(a) then a[i] else b[i-length(a)],iota(length(a)+length(b)))
entry growing_rows(xs:[]i32) [][]i32 =
  scan(join_rows,replicate(0,0i32),map(|x|map(|i|i,iota(x)),xs))
