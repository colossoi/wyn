--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"selected_array\"", ":source-name \"updated_array\"", ":source-name \"updated_slice\""]
--! [[host]]
--! entry = "selected_array"
--! result_layouts = ["(:array :length :dynamic :stride 4 :range :caller :element :i32)"]
--! [[host]]
--! entry = "updated_array"
--! result_layouts = ["(:array :length :dynamic :stride 4 :range :caller :element :i32)"]
--! [[host]]
--! entry = "updated_slice"
--! result_layouts = ["(:array :length :dynamic :stride 4 :range :caller :element :i32)"]

entry selected_array(xs:[]i32) []i32 =
  if length(xs)>10 then replicate(0,0i32) else xs
entry updated_array(xs:[]i32) []i32 =
  loop out=xs for i<length(xs) do out with [i]=xs[i]+1
entry updated_slice(xs:[]i32) []i32 =
  let out=if length(xs)>10 then replicate(0,0i32) else xs in
  let start=if length(out)>0 then 1 else 0 in
  out[start..length(out)] with [0]=99i32
