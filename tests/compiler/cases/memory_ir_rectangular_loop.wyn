--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"runtime_rows\""]
--! [[host]]
--! entry = "runtime_rows"
--! minimum_calls = {"gpu-read-scalar"=1}
--! result_layouts = ["(:array :length :dynamic :stride 4 :range :caller :element :i32)"]

entry runtime_rows(xs:[]i32,n:i32) [][]i32=let ys=map(|x|map(|y|x+y,iota(n+1)),xs) in loop out=ys for _i<2 do out[0..length(out)]
