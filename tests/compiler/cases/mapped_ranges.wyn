--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! args = ["--graphics"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"range_combined_with_map_vertex_main\"", ":source-name \"map_range_simple_main\"", ":source-name \"map_range_with_index_main\"", ":source-name \"map_simple_array_main\"", ":source-name \"map_with_named_function_vertex_main\"", ":source-name \"map_single_input\"", ":source-name \"map_zip2_inputs\"", ":source-name \"map_zip3_inputs\"", ":source-name \"map_zip4_inputs\"", ":source-name \"map_zip5_inputs\"", ":source-name \"signed_range_minimum\"", ":source-name \"unsigned_range_minimum\"", ":source-name \"powers\""]

-- Migrated from test_range_combined_with_map
entry range_combined_with_map_vertex_main() vec4f32 =
    let doubled = map(|x| x * 2, 0..<4) in
    @[f32.i32(doubled[0]), f32.i32(doubled[1]), f32.i32(doubled[2]), 1.0f32]

-- Migrated from test_map_range_simple
def map_range_simple_test: [4]i32 = map(|x| x * 2, 0..<4)

entry map_range_simple_main() [4]i32 = map_range_simple_test

-- Migrated from test_map_range_with_index
def map_range_with_index_test: i32 =
    let doubled = map(|x| x * 2, 0..<4) in
    doubled[0]

entry map_range_with_index_main() i32 = map_range_with_index_test

-- Migrated from test_map_simple_array
def map_simple_array_double(x: i32) i32 = x * 2

def map_simple_array_test(arr: [4]i32) [4]i32 = map(map_simple_array_double, arr)

entry map_simple_array_main(xs: [4]i32) [4]i32 = map_simple_array_test(xs)

-- Migrated from test_map_with_named_function
def map_with_named_function_double(x: i32) i32 = x * 2


entry map_with_named_function_vertex_main() vec4f32 =
    let doubled = map(map_with_named_function_double, 0..<4) in
    @[f32.i32(doubled[0]), f32.i32(doubled[1]), f32.i32(doubled[2]), 1.0f32]

-- Zipped-map lowering, formerly test_map_variants.
def map_variants_double(x: i32) i32 = x * 2

entry map_single_input(arr: [3]i32) [3]i32 = map(map_variants_double, arr)
entry map_zip2_inputs(xs: [3]i32, ys: [3]i32) [3]i32 = map(|(x, y)| x + y, zip(xs, ys))
entry map_zip3_inputs(xs: [3]i32, ys: [3]i32, zs: [3]i32) [3]i32 = map(|(x, y, z)| x + y + z, zip3(xs, ys, zs))
entry map_zip4_inputs(a: [3]i32, b: [3]i32, c: [3]i32, d: [3]i32) [3]i32 = map(|(a, b, c, d)| a + b + c + d, zip4(a, b, c, d))
entry map_zip5_inputs(a: [3]i32, b: [3]i32, c: [3]i32, d: [3]i32, e: [3]i32) [3]i32 = map(|(a, b, c, d, e)| a + b + c + d + e, zip5(a, b, c, d, e))

-- wgsl_i32_range_reduce_validates
entry signed_range_minimum(n: i32) i32 =
  reduce(|a: i32, b: i32| if a < b then a else b, 2147483647, 0..<n)

-- wgsl_u32_range_reduce_validates
entry unsigned_range_minimum(n: u32) u32 =
  reduce(|a: u32, b: u32| if a < b then a else b, 4294967295u32, 0u32..<n)

-- float_powers_coerce_constant_and_dynamic_integer_exponents
entry powers(xs: []f32, exponent: i32) []f32 =
    map(|x: f32| x ** 5 + x ** exponent, xs)
