--! command = "build"
--! exit = 0
--! targets = ["spirv", "wgsl"]
--! [[artifacts]]
--! path = "output.wynhost"
--! contains = [":source-name \"bool_collective_0_check\"", ":source-name \"bool_collective_1_check\"", ":source-name \"bool_collective_2_check\""]
--! [[shader]]
--! entry = "bool_collective_0_check"
--! targets = ["wgsl"]
--! workgroup_array_scalar = "u32"

entry bool_collective_0_check(x: f32) []i32 =
  let positive = reduce(|a: bool, b: bool| a && b, true,
    map(|v: f32| v > 0.0, [x])) in
  [if positive then 1 else 0]


entry bool_collective_1_check(xs: []bool) []bool = scan(|a: bool,b: bool| a && b, true, xs)


entry bool_collective_2_check(xs: []i32) (bool,i32) =
         reduce(|(a,n),(b,m)| (a && b,n+m), (true,0), map(|x| (x>0,1),xs))
