-- Wide results must share storage without changing their source slots.
entry repro(input:[]f32) (f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32,f32) =
 (input[0]+1.0,input[1]+2.0,input[2]+3.0,input[3]+4.0,input[4]+5.0,input[5]+6.0,input[6]+7.0,input[7]+8.0,input[8]+9.0,input[9]+10.0,input[10]+11.0,input[11]+12.0,input[12]+13.0,input[13]+14.0,input[14]+15.0,input[15]+16.0,input[16]+17.0,input[17]+18.0,input[18]+19.0,input[19]+20.0,input[20]+21.0,input[21]+22.0,input[22]+23.0,input[23]+24.0,input[24]+25.0,input[25]+26.0,input[26]+27.0,input[27]+28.0,input[28]+29.0,input[29]+30.0)

entry small(input:[]f32) (f32,f32) = (input[0],input[1])

-- Mixed groups preserve their independent element alignment and scalar kinds.
entry mixed(input:[]f32) (f32,i32,vec3f32,f32,i32,vec3f32,f32,i32,vec3f32) =
 (input[0]+1.0,i32(input[1]),@[input[2],input[3],input[4]],
  input[5]+2.0,i32(input[6]),@[input[7],input[8],input[9]],
  input[10]+3.0,i32(input[11]),@[input[12],input[13],input[14]])

-- Borrowed arrays remain caller buffers even alongside a packed result record.
entry aliases(input:[]f32) (f32,f32,f32,f32,f32,f32,f32,f32,[]f32,[]f32) =
 (input[0]+1.0,input[1]+2.0,input[2]+3.0,input[3]+4.0,
  input[4]+5.0,input[5]+6.0,input[6]+7.0,input[7]+8.0,input,input)

-- A reduction produces a value consumed by both compute and graphics stages.
entry staged(input:[]f32,target:render_target<vec4f32>)
 (f32,f32,f32,f32,f32,f32,f32,f32,render_target<vec4f32>) =
 let total = reduce((+),0.0,input) in
 let a=total+1.0 in let b=total+2.0 in let c=total+3.0 in let d=total+4.0 in
 let e=total+5.0 in let f=total+6.0 in let g=total+7.0 in let h=total+8.0 in
 let covered=rasterize_triangles(direct_draw(3u32,1u32),
   |i,_,_|vertex_output(@[if i==1u32 then 3.0 else -1.0,if i==2u32 then 3.0 else -1.0,0.0,1.0],())) in
 let image=shade_with({depth_test=#disabled,depth_write=false,blend=#replace,color_write=true},
   target,covered,|_,_,_,_,_|@[a+b,c+d,e+f,g+h]/1000.0) in
 (a,b,c,d,e,f,g,h,image)

-- Scalar carries retain independent allocations across device-array loops.
entry carried(input:[]i32,limit:i32) ([]i32,i32,i32,i32,i32,i32,i32,i32,i32) =
  loop (xs,x0,x1,x2,x3,x4,x5,x6,x7) = (map(|x|x+1,input),0,1,2,3,4,5,6,7) for step < limit do
   (map(|x|x+step,xs),x0+step+1,x1+step+1,x2+step+1,x3+step+1,x4+step+1,x5+step+1,x6+step+1,x7+step+1)


-- Boolean fields share u32 storage representation but retain boolean results.
entry flags(input:[]f32) (bool,u32,bool,u32,bool,u32,bool,u32) =
 (input[0]>1.0,u32(input[1]),input[2]>1.0,u32(input[3]),
  input[4]>1.0,u32(input[5]),input[6]>1.0,u32(input[7]))
