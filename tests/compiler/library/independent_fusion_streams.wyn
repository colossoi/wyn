entry choice_rows() [3][4]i32=map(|x|if x>0 then map(|y|100/(x+y),iota(4)) else map(|y|x+y,iota(4)),[0,1,-1])
entry choice_empty() [3][0]i32=map(|x|if x>0 then map(|y|1/x+y,iota(0)) else map(|y|x-y,iota(0)),[0,1,-1])
entry choice_totals() [3]i32=map(|n|if n>0 then reduce((+),0,map(|i|100/(i+n),iota(4))) else reduce((+),0,map(|i|i+n,iota(3))),[0,1,-1])
entry choice_prefixes() [3][4]i32=map(|n|if n>0 then scan((+),0,map(|i|100/(i+n),iota(4))) else scan((+),0,map(|i|i+n,iota(4))),[0,1,-1])
entry noncomm_scan() []i32=map(|p|p.1,scan(|a,b|(a.0*b.0,a.1*b.0+b.1),(1,0),map(|i|(if i%5==0 then 0 else 1,i),iota(257))))
entry noncomm_reduce() i32=(reduce(|a,b|(a.0*b.0,a.1*b.0+b.1),(1,0),map(|i|(if i%5==0 then 0 else 1,i),iota(257)))).1
entry deep_choice() [2][3]i32=map(|i|map(|j|if (i+j)%2==0 then reduce((+),0,map(|k|k+i*10+j,iota(17))) else -1,iota(3)),iota(2))
entry deep_loop() [2][3]i32=map(|i|map(|j|loop a=0 for n<j+1 do a+reduce((+),0,map(|k|k+i*10+j,iota(17))),iota(3)),iota(2))
entry total_map() [4]i32=let xs=[1,2,3,4] let t=reduce((+),0,xs) in map(|x|x+t,xs)
entry captured_total_updates() [3]i32=let xs=[1,2,3,4] let t=reduce((+),0,xs) let dest=[0,0,0] in reduce_by_index(dest,(+),0,map(|x|x%3,xs),map(|x|x+t,xs))
entry local_total_map() [2][4]i32=map(|k|let xs=map(|x|x+k,[1,2,3,4]) let t=reduce((+),0,xs) in map(|x|x+t,xs),[0,1])
entry prefix_updates() ([4]i32,[3]i32,[3]i32)=let p=scan((+),0,[1,2,3,4]) let da=[1,1,1] let db=[2,2,2] let a=reduce_by_index(da,(+),0,map(|x|x%3,p),p) let b=reduce_by_index(db,|a,b|a+b+1,0,map(|x|x%3,p),p) in (p,map(|x|2*x,a),b)
entry total_updates() (i32,[3]i32)=let xs=[1,2,3,4] let da=[1,1,1] let a=reduce_by_index(da,(+),0,map(|x|x%3,xs),xs) in (reduce((+),0,xs),a)
entry independent_indexed() ([3]i32,[5]i32)=let xs=[2,3,4,5] let da=[0,0,0] let db=[1,1,1,1,1] let a=reduce_by_index(da,(+),0,map(|x|x%3,xs),xs) let b=reduce_by_index(db,|a,b|a+b+1,0,map(|x|x%5,xs),xs) in (a,b)
entry independent_buckets() ([2]u32,u32,[2]u32,u32)=let da=[[-1,-1],[-1,-1]] let db=[[-2],[-2]] let (a,ac,ao)=bucket_scatter_2d(da,[[(0,10),(0,11),(1,20)]]) let (b,bc,bo)=bucket_scatter_2d(db,[[(0,30),(0,31),(1,40)]]) in (ac,ao,bc,bo)
entry mixed_updates() ([4]i32,[2]i32)=let xs=[2,3,4,5] let da=[-1,-1,-1,-1] let db=[1,1] let a=scatter(da,iota(4),xs) let b=reduce_by_index(db,(+),0,map(|x|x%2,xs),xs) in (a,b)
entry nested_updates() [2]i32=map(|k|let xs=map(|x|x+k,[2,3,4,5]) let da=[0,0,0] let db=[1,1,1,1,1] let a=reduce_by_index(da,(+),0,map(|x|x%3,xs),xs) let b=reduce_by_index(db,|a,b|a+b+1,0,map(|x|x%5,xs),xs) in a[0]+b[0],[0,1])
entry clipped_permutation() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=a%8 in if r<4 then rows[r][a/8] else -1,iota(16))
entry row_major() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=a/2 in if r<8 then rows[r][a%2] else -1,iota(16))
entry transpose() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=a%8 in if r<8 then rows[r][a/8] else -1,iota(16))
entry tiled_commuted() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=4*(a/8)+a%4 in if r<8 then rows[r][(a/4)%2] else -1,iota(16))
entry permuted_digits() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=4*(a%2)+2*((a/4)%2)+a/8 in if r<8 then rows[r][(a/2)%2] else -1,iota(16))
entry overlapping_digits() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=a%8 in if r<8 then rows[r][a%2] else -1,iota(16))
entry incomplete_digits() [16]i32=let rows=map(|i|[10*i,10*i+1],iota(8)) in map(|a|let r=(a/2)%4+4*(a/3) in if r<8 then rows[r][a%2] else -1,iota(16))
entry guarded_write() [3]i32=let ys=filter(|x|x!=0,[0,1,2,0]) let dest=[-1,-1,-1] in scatter(dest,map(|x|x-1,ys),map(|x|100/x,ys))
entry local_indexed() [2][3]i32=map(|n|let dest=[0,0,0] in reduce_by_index(dest,|a,b|a+b+n,0,[0,1,0,2,1],[2,3,4,5,6]),[1,2])
entry indexed() [3]i32=let dest=[0,0,0] in reduce_by_index(dest,|a,b|a+b+1,0,[0,1,0,2,1],[2,3,4,5,6])
entry buckets() ([2]u32,u32)=let dest=[[-1,-1],[-1,-1]] in let (ys,counts,overflow)=bucket_scatter_2d(dest,[[(-1,9),(0,10),(0,11)],[(0,12),(1,20),(2,9)]]) in (counts,overflow)
entry chain() []i32=filter(|x|x<50,map(|x|100/x,filter(|x|x!=0,[0,1,2,4,-2,5,0,10])))
entry observed() (i32,i32)=let a=filter(|x|x>0,[-1,0,1,2,18,19,20]) let b=filter(|x|x<20,map(|x|x+1,a)) in (length(a),length(b))
entry counted() (i32,i32)=let ys=filter(|x|x<20,map(|x|x+1,filter(|x|x>0,[-1,0,1,2,18,19,20]))) in (length(ys),reduce((+),0,ys))
entry varying() [4]i32=map(|n|reduce((+),0,iota(n)),[0,1,7,65])
entry packed_prefix() []i32=map(|x|x*2,scan((+),0,map(|x|100/x,filter(|x|x!=0,[0,1,2,0,4]))))
entry packed_prefix_tiles() []i32=scan((+),0,filter(|x|x%3==0,iota(257)))
entry packed_tiles() []i32=filter(|x|x%3==0,iota(257))
entry empty_pack() []i32=filter(|x|x<0,iota(65))
entry wide_scan() []i32=scan((+),0,iota(1025))
entry scanmap() [5]i32=map(|x|x*2,scan((+),0,[1,2,3,4,5]))
