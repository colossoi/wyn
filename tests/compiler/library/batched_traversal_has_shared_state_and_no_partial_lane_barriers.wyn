entry ranked_local(bias: []i32) [2][24][1]i32 =
          map(|b|
            let items: [2][3][4](i32,i32) =
              map(|i|map(|j|map(|k|
                ((i*3+j)*4+k,100*i+10*j+k+b),iota(4)),iota(3)),iota(2))
            in let (values,_,_)=bucket_scatter_3d(replicate(24,[0]),items) in values,
            bias[0..2])
