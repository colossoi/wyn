def row(i: i32) [3]i32 = [i, i+1, i+2]

def tiled<[n]>(rows: [n][3]i32) [16]i32 =
  map(|a| let i = (a/8)*4 + a%4 in
    if i < length(rows) then rows[i][(a%8)/4] else -1, iota(16))

def metadata<[n]>(rows: [n][3]i32) [n]i32 = map(|r| r[2], rows)

entry tiled_mapped_8() ([16]i32, [8]i32) =
  let rows = map(row, iota(8)) in
  (tiled(rows), metadata(rows))

entry tiled_mapped_8_kept() ([16]i32, [8]i32, [8][3]i32) =
  let rows = map(row, iota(8)) in
  (tiled(rows), metadata(rows), rows)

entry tiled_reduced_8() ([16]i32, i32) =
  let rows = map(row, iota(8)) in
  (tiled(rows), reduce((+), 0, metadata(rows)))

entry tiled_reduced_8_kept() ([16]i32, i32, [8][3]i32) =
  let rows = map(row, iota(8)) in
  (tiled(rows), reduce((+), 0, metadata(rows)), rows)

entry tiled_mapped_7() ([16]i32, [7]i32) =
  let rows = map(row, iota(7)) in
  (tiled(rows), metadata(rows))

entry tiled_mapped_7_kept() ([16]i32, [7]i32, [7][3]i32) =
  let rows = map(row, iota(7)) in
  (tiled(rows), metadata(rows), rows)

entry tiled_reduced_7() ([16]i32, i32) =
  let rows = map(row, iota(7)) in
  (tiled(rows), reduce((+), 0, metadata(rows)))

entry tiled_reduced_7_kept() ([16]i32, i32, [7][3]i32) =
  let rows = map(row, iota(7)) in
  (tiled(rows), reduce((+), 0, metadata(rows)), rows)

entry scratch_scatter_after_update(xs: [2][4]i32) ([8]i32, [2]i32) =
  let (rows, tags) = unzip(map(|row|
    let result = scatter(duplicate_scratch(row), [3,0,2,1], row) in
    (result, result[1] + row[2]), xs)) in
  (flatten(rows), tags)
