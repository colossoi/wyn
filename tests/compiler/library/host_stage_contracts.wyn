entry consuming_map(xs:*[]i32) []i32=map(|x:i32|x+7,xs)
entry consuming_scan(xs:*[]i32) []i32=scan(|a:i32,b:i32|a+b,0,xs)
entry observed_scatter(xs:[]i32) ([]i32,[]i32)=let ys=map(|x:i32|x+1,xs) in (scatter(ys,[0],[7]),ys)
entry captured_scatter(xs:[]i32) ([]i32,[]i32)=let ys=map(|x:i32|x+1,xs) in (scatter(ys,[0,1],map(|i|ys[1-i],[0,1])),xs)
entry buffer_domain(xs:[]i32) []i32=map(|x:i32|x+1,xs)
entry scalar_domain(n:i32) []i32=map(|i|i+1,iota(n))
entry partial_whole(xs:[8]i32) [8]i32=map(|x|x+1,map(|x|12/x,xs))
entry partial_slice(xs:[8]i32) []i32=let ys=map(|x|12/x,xs) in map(|x|x+1,ys[0..4])
entry large_fixed(xs:[25000000]i32) [25000000]i32=map(|x:i32|x+1,xs)
entry scalar_loop(xs: []i32, n: i32) []i32 =
        let bias = loop acc = 0 for i < n do acc + i in
        map(|x: i32| x + bias, xs)
