entry captured(xs: [2]i32) [2][4]i32 =
  let seed = [10,20,30,40] in map(|x|scatter(seed,[1],[x]),xs)
entry counted(xs: [2]i32) [2][4]i32 =
  map(|x|loop ys=[10,20,30,40] for i<2 do
    if i==0 then scatter(ys,[1],[x])
    else reduce_by_index(ys,(+),0,[2],[x]),xs)
entry expression(xs: [2]i32) [2][4]i32 =
  map(|x|reduce_by_index(replicate(4,0),(+),0,[1,1],[x,x+1]),xs)
